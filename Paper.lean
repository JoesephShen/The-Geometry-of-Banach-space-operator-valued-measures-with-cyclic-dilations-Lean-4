abbrev MeasSet (Ω : Type*) [MeasurableSpace Ω] := {E : Set Ω // MeasurableSet E}

namespace MeasSet

variable {Ω : Type*} [MeasurableSpace Ω]

def empty : MeasSet Ω := ⟨∅, MeasurableSet.empty⟩
def whole : MeasSet Ω := ⟨univ, MeasurableSet.univ⟩
def inter (A B : MeasSet Ω) : MeasSet Ω := ⟨A.1 ∩ B.1, A.2.inter B.2⟩
def union (A B : MeasSet Ω) : MeasSet Ω := ⟨A.1 ∪ B.1, A.2.union B.2⟩
def diff (A B : MeasSet Ω) : MeasSet Ω := ⟨A.1 \ B.1, A.2.diff B.2⟩
def iUnion (A : ℕ → MeasSet Ω) : MeasSet Ω :=
  ⟨⋃ n, (A n).1, MeasurableSet.iUnion fun n => (A n).2⟩

def DisjointSeq (A : ℕ → MeasSet Ω) : Prop :=
  Pairwise fun i j => Disjoint (A i).1 (A j).1

end MeasSet

variable {Ω X Z : Type*} [MeasurableSpace Ω]
  [NormedAddCommGroup X] [NormedSpace ℝ X]
  [NormedAddCommGroup Z] [NormedSpace ℝ Z]

abbrev Dual (X : Type*) [NormedAddCommGroup X] [NormedSpace ℝ X] := X →L[ℝ] ℝ
abbrev Bidual (X : Type*) [NormedAddCommGroup X] [NormedSpace ℝ X] := Dual X →L[ℝ] ℝ

def adjoint (L : X →L[ℝ] Z) (f : Dual Z) : Dual X := f.comp L

/-- Canonical evaluation in the norm bidual. -/
noncomputable def J (x : X) : Bidual X :=
  LinearMap.mkContinuous
    { toFun := fun f => f x
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl } ‖x‖
    (fun f => by
      simpa [mul_comm] using f.le_opNorm x)

@[simp] theorem J_apply (x : X) (f : Dual X) : J x f = f x := rfl

/-- Manuscript §2. The sum in each orbit is in the norm topology. -/
structure OVM (Ω X : Type*) [MeasurableSpace Ω]
    [NormedAddCommGroup X] [NormedSpace ℝ X] where
  val : MeasSet Ω → X →L[ℝ] X
  empty_eq : val MeasSet.empty = 0
  countably_additive : ∀ A : ℕ → MeasSet Ω, MeasSet.DisjointSeq A →
    ∀ x : X, HasSum (fun n => val (A n) x) (val (MeasSet.iUnion A) x)

def OVM.Normalized (μ : OVM Ω X) : Prop := μ.val MeasSet.whole = ContinuousLinearMap.id ℝ X

structure PVM (Ω X : Type*) [MeasurableSpace Ω]
    [NormedAddCommGroup X] [NormedSpace ℝ X] extends OVM Ω X where
  normalized : toOVM.Normalized
  mul_eq : ∀ A B, (toOVM.val A).comp (toOVM.val B) = toOVM.val (A.inter B)

def OVM.Normal (μ : OVM Ω X) (ξ : Bidual X) : Prop :=
  ∀ A : ℕ → MeasSet Ω, MeasSet.DisjointSeq A → ∀ f : Dual X,
    HasSum (fun n => ξ (adjoint (μ.val (A n)) f))
      (ξ (adjoint (μ.val (MeasSet.iUnion A)) f))

def OVM.Shrinking (μ : OVM Ω X) : Prop :=
  ∀ A : ℕ → MeasSet Ω, MeasSet.DisjointSeq A → ∀ f : Dual X,
    HasSum (fun n => adjoint (μ.val (A n)) f)
      (adjoint (μ.val (MeasSet.iUnion A)) f)

/-- Manuscript, eq:localization. Pointwise dual equalities express membership in J(X). -/
def PVM.Localizes (P : PVM Ω X) : Prop :=
  ∀ ξ : Bidual X, P.toOVM.Normal ξ →
    ∃ A : ℕ → MeasSet Ω, Monotone (fun n => (A n).1) ∧
      MeasSet.iUnion A = MeasSet.whole ∧
      ∀ n, ∃ x : X, ∀ f : Dual X, ξ (adjoint (P.val (A n)) f) = f x

def PVM.BoundedlyComplete (P : PVM Ω X) : Prop :=
  ∀ (A : ℕ → MeasSet Ω) (z : ℕ → X), MeasSet.DisjointSeq A →
    (∀ n, P.val (A n) (z n) = z n) →
    (∃ C : ℝ, ∀ N : ℕ, ‖∑ n ∈ Finset.range N, z n‖ ≤ C) →
    ∃ x : X, Tendsto (fun N => ∑ n ∈ Finset.range N, z n) atTop (𝓝 x)

def PVM.CyclicVector (P : PVM Ω X) (u : X) : Prop :=
  Dense (Submodule.span ℝ (Set.range fun E => P.val E u) : Set X)

def PVM.Cyclic (P : PVM Ω X) : Prop := ∃ u, P.CyclicVector u

theorem OVM.normal_J (μ : OVM Ω X) (x : X) : μ.Normal (J x) := by
  intro A hA f
  exact (μ.countably_additive A hA x).map f f.continuous

theorem OVM.normal_of_shrinking (μ : OVM Ω X) (hμ : μ.Shrinking) (ξ : Bidual X) :
    μ.Normal ξ := by
  intro A hA f
  exact (hμ A hA f).map ξ ξ.continuous

/-- Manuscript, prop:cyclic-normal. Nullity implication after obtaining
the scalar control measure for the cyclic vector measure. -/
theorem PVM.zero_of_cyclic_orbit (P : PVM Ω X) {u : X} (hu : P.CyclicVector u)
    (E : MeasSet Ω) (h : ∀ F : MeasSet Ω, P.val (E.inter F) u = 0) :
    P.val E = 0 := by
  ext x
  have hspan : ∀ y ∈ Submodule.span ℝ (Set.range fun F => P.val F u), P.val E y = 0 := by
    intro y hy
    induction hy using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨F, rfl⟩ := hy
      exact (congrArg (fun L : X →L[ℝ] X => L u) (P.mul_eq E F)).trans (h F)
    | zero => exact map_zero _
    | add y z _ _ hy hz => simp [map_add, hy, hz]
    | smul c y _ hy => simp [map_smul, hy]
  change P.val E x = 0
  have hz : IsClosed {y : X | P.val E y = 0} :=
    isClosed_eq (P.val E).continuous continuous_const
  exact closure_minimal (fun _ hy => hspan _ hy) hz (hu x)

theorem PVM.projection_idempotent (P : PVM Ω X) (A : MeasSet Ω) :
    (P.val A).comp (P.val A) = P.val A := by
  have h : A.inter A = A := Subtype.ext (inter_self A.1)
  rw [P.mul_eq, h]

theorem PVM.disjoint_product (P : PVM Ω X) (A B : MeasSet Ω)
    (h : Disjoint A.1 B.1) : (P.val A).comp (P.val B) = 0 := by
  have hAB : A.inter B = MeasSet.empty := Subtype.ext (Set.disjoint_iff_inter_eq_empty.mp h)
  rw [P.mul_eq, hAB, P.empty_eq]

/-- Manuscript §4.1. All operators have their ambient norm topologies. -/
structure Dilation (μ : OVM Ω X) (Z : Type*) [NormedAddCommGroup Z] [NormedSpace ℝ Z] where
  P : PVM Ω Z
  S : Z →L[ℝ] X
  T : X →L[ℝ] Z
  split : S.comp T = ContinuousLinearMap.id ℝ X
  compress : ∀ E, (S.comp (P.val E)).comp T = μ.val E

theorem Dilation.analysis_injective {μ : OVM Ω X} (D : Dilation μ Z) :
    Function.Injective D.T := by
  intro x y h
  have hsplit (w : X) : D.S (D.T w) = w := congrArg (fun L : X →L[ℝ] X => L w) D.split
  rw [← hsplit x, ← hsplit y, h]

theorem Dilation.complemented_projection {μ : OVM Ω X} (D : Dilation μ Z) :
    (D.T.comp D.S).comp (D.T.comp D.S) = D.T.comp D.S ∧
      Set.range (D.T.comp D.S) = Set.range D.T := by
  have hsplit (w : X) : D.S (D.T w) = w := congrArg (fun L : X →L[ℝ] X => L w) D.split
  constructor
  · ext z
    change D.T (D.S (D.T (D.S z))) = D.T (D.S z)
    rw [hsplit]
  · ext z
    constructor
    · rintro ⟨w, rfl⟩
      exact ⟨D.S w, rfl⟩
    · rintro ⟨x, rfl⟩
      exact ⟨D.T x, by simp only [ContinuousLinearMap.comp_apply, hsplit]⟩

/-- Manuscript, prop:ovm-normal, the exact coefficient identity. -/
theorem Dilation.coefficient {μ : OVM Ω X} (D : Dilation μ Z) (E : MeasSet Ω)
    (ξ : Bidual X) (f : Dual X) :
    ξ (adjoint (μ.val E) f) = ξ (adjoint D.T (adjoint (D.P.val E) (adjoint D.S f))) := by
  congr 1
  ext x
  exact congrArg f (congrArg (fun L : X →L[ℝ] X => L x) (D.compress E)).symm

/-- The second adjoint acts by precomposition on bidual vectors. -/
noncomputable def secondAdjoint (A : X →L[ℝ] Z) (ξ : Bidual X) : Bidual Z :=
  ξ.comp (ContinuousLinearMap.compL ℝ X Z ℝ |>.flip A)

@[simp] theorem secondAdjoint_apply (A : X →L[ℝ] Z) (ξ : Bidual X) (g : Dual Z) :
    secondAdjoint A ξ g = ξ (adjoint A g) := rfl

/-- The weak-star sequential closure used in §2. -/
def BaireOne (ξ : Bidual X) : Prop :=
  ∃ x : ℕ → X, ∀ f : Dual X, Tendsto (fun n => f (x n)) atTop (𝓝 (ξ f))

theorem BaireOne.second_adjoint {ξ : Bidual X} (h : BaireOne ξ) (A : X →L[ℝ] Z) :
    BaireOne (secondAdjoint A ξ) := by
  obtain ⟨x, hx⟩ := h
  exact ⟨fun n => A (x n), fun g => hx (adjoint A g)⟩

/-- Coefficient normality is preserved by intertwining, as in
the coefficient calculation of lemma lem:normal-restriction. -/
theorem PVM.normal_of_intertwining (P : PVM Ω X) (R : PVM Ω Z) (A : X →L[ℝ] Z)
    (hA : ∀ E, A.comp (P.val E) = (R.val E).comp A)
    {ξ : Bidual X} (hξ : P.toOVM.Normal ξ) : R.toOVM.Normal (secondAdjoint A ξ) := by
  have hcoeff (E : MeasSet Ω) (g : Dual Z) :
      adjoint A (adjoint (R.val E) g) = adjoint (P.val E) (adjoint A g) := by
    ext x
    exact congrArg g (congrArg (fun L : X →L[ℝ] Z => L x) (hA E)).symm
  intro E hE g
  simpa only [secondAdjoint_apply, hcoeff] using hξ E hE (adjoint A g)

/-- Normality of the analyzed bidual vector implies normality before dilation. -/
theorem Dilation.normal_of_analysis_normal {μ : OVM Ω X} (D : Dilation μ Z)
    {ξ : Bidual X} (hξ : D.P.toOVM.Normal (secondAdjoint D.T ξ)) : μ.Normal ξ := by
  intro A hA f
  simpa only [secondAdjoint_apply, D.coefficient] using hξ A hA (adjoint D.S f)

omit [MeasurableSpace Ω] in
/-- A finite initial union of the disjoint increments agrees with
the corresponding member of the increasing exhaustion. -/
theorem disjointed_initial_union (A : ℕ → Set Ω) (hA : Monotone A) (N : ℕ) :
    (⋃ n ∈ Finset.range (N + 1), disjointed A n) = A N := by
  rw [biUnion_range_succ_disjointed, hA.partialSups_eq]

/-- An invariant subspace in the sense of the manuscript, §2. -/
def PVM.Invariant (P : PVM Ω X) (Y : Submodule ℝ X) : Prop :=
  ∀ E : MeasSet Ω, ∀ y ∈ Y, P.val E y ∈ Y

/-- Restriction of a PVM to an invariant normed subspace. -/
def PVM.restrict (P : PVM Ω X) (Y : Submodule ℝ X) (hY : P.Invariant Y) : PVM Ω Y where
  val E := (P.val E).restrict (hY E)
  empty_eq := by
    ext y
    change P.val MeasSet.empty (y : X) = 0
    rw [P.empty_eq]
    rfl
  countably_additive E hE y := by
    unfold HasSum
    apply tendsto_subtype_rng.mpr
    have ht := P.countably_additive E hE (y : X)
    unfold HasSum at ht
    simpa only [Submodule.coe_sum, ContinuousLinearMap.restrict_apply] using ht
  normalized := by
    ext y
    change P.val MeasSet.whole (y : X) = (y : X)
    exact congrArg (fun A : X →L[ℝ] X => A (y : X)) P.normalized
  mul_eq E F := by
    ext y
    exact congrArg (fun A : X →L[ℝ] X => A (y : X)) (P.mul_eq E F)

/-- The induced operator on the measurable quotient. -/
def PVM.quotientOperator (P : PVM Ω X) (Y : Submodule ℝ X)
    (hY : P.Invariant Y) (E : MeasSet Ω) : X ⧸ Y →L[ℝ] X ⧸ Y :=
  Y.liftQL (Y.mkQL.comp (P.val E)) (fun y hy =>
    (Submodule.Quotient.mk_eq_zero Y).mpr (hY E y hy))

@[simp] theorem PVM.quotientOperator_mk (P : PVM Ω X) (Y : Submodule ℝ X)
    (hY : P.Invariant Y) (E : MeasSet Ω) (x : X) :
    P.quotientOperator Y hY E (Y.mkQL x) = Y.mkQL (P.val E x) := rfl

/-- The quotient PVM in the manuscript, §2. -/
def PVM.quotient (P : PVM Ω X) (Y : Submodule ℝ X)
    [IsClosed (Y : Set X)] (hY : P.Invariant Y) : PVM Ω (X ⧸ Y) where
  val := P.quotientOperator Y hY
  empty_eq := by
    ext z
    obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective Y z
    change Y.mkQL (P.val MeasSet.empty x) = 0
    rw [P.empty_eq]
    exact map_zero _
  countably_additive E hE z := by
    obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective Y z
    exact (P.countably_additive E hE x).map Y.mkQL Y.mkQL.continuous
  normalized := by
    ext z
    obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective Y z
    change Y.mkQL (P.val MeasSet.whole x) = Y.mkQL x
    have he : P.val MeasSet.whole = ContinuousLinearMap.id ℝ X := P.normalized
    rw [he]
    rfl
  mul_eq E F := by
    ext z
    obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective Y z
    change Y.mkQL (P.val E (P.val F x)) = Y.mkQL (P.val (E.inter F) x)
    exact congrArg Y.mkQL (congrArg (fun T : X →L[ℝ] X => T x) (P.mul_eq E F))

theorem PVM.quotient_intertwines (P : PVM Ω X) (Y : Submodule ℝ X)
    [IsClosed (Y : Set X)] (hY : P.Invariant Y) (E : MeasSet Ω) :
    Y.mkQL.comp (P.val E) = ((P.quotient Y hY).val E).comp Y.mkQL := by
  ext x
  rfl

theorem PVM.restrict_intertwines (P : PVM Ω X) (Y : Submodule ℝ X) (hY : P.Invariant Y)
    (E : MeasSet Ω) :
    Y.subtypeL.comp ((P.restrict Y hY).val E) = (P.val E).comp Y.subtypeL := by
  ext y
  rfl

/-- Manuscript, eq:normal-restriction, pointwise in the invariant bidual. -/
theorem PVM.normal_restrict_iff (P : PVM Ω X) (Y : Submodule ℝ X) (hY : P.Invariant Y)
    (η : Bidual Y) :
    (P.restrict Y hY).toOVM.Normal η ↔ P.toOVM.Normal (secondAdjoint Y.subtypeL η) := by
  constructor
  · apply PVM.normal_of_intertwining (P.restrict Y hY) P Y.subtypeL
    exact P.restrict_intertwines Y hY
  · intro hη E hE f
    obtain ⟨g, hg, _⟩ := exists_extension_norm_eq Y f
    have heval (A : MeasSet Ω) :
        secondAdjoint Y.subtypeL η (adjoint (P.val A) g) =
          η (adjoint ((P.restrict Y hY).val A) f) := by
      rw [secondAdjoint_apply]
      congr 1
      ext y
      exact hg ((P.restrict Y hY).val A y)
    simpa only [heval] using hη E hE g

theorem PVM.normal_inter_bidual_range (P : PVM Ω X) (Y : Submodule ℝ X) (hY : P.Invariant Y) :
    {ξ : Bidual X | P.toOVM.Normal ξ} ∩ Set.range (secondAdjoint Y.subtypeL) =
      secondAdjoint Y.subtypeL '' {η : Bidual Y | (P.restrict Y hY).toOVM.Normal η} := by
  ext ξ
  constructor
  · rintro ⟨hξ, ⟨η, rfl⟩⟩
    exact ⟨η, (P.normal_restrict_iff Y hY η).mpr hξ, rfl⟩
  · rintro ⟨η, hη, rfl⟩
    exact ⟨(P.normal_restrict_iff Y hY η).mp hη, ⟨η, rfl⟩⟩

theorem exists_secondAdjoint_subtype_of_extensional (Y : Submodule ℝ X) (ξ : Bidual X)
    (hξ : ∀ g f : Dual X, (∀ y : Y, g (y : X) = f (y : X)) → ξ g = ξ f) :
    ∃ η : Bidual Y, secondAdjoint Y.subtypeL η = ξ := by
  classical
  choose extend hext hnorm using fun f : Dual Y => exists_extension_norm_eq Y f
  let L : Dual Y →ₗ[ℝ] ℝ :=
    { toFun := fun f => ξ (extend f)
      map_add' := fun f g => by
        change ξ (extend (f + g)) = ξ (extend f) + ξ (extend g)
        rw [← map_add]
        apply hξ
        intro z
        rw [hext]
        change f z + g z = extend f (z : X) + extend g (z : X)
        rw [hext, hext]
      map_smul' := fun a f => by
        change ξ (extend (a • f)) = a • ξ (extend f)
        rw [← map_smul]
        apply hξ
        intro z
        rw [hext]
        change a • f z = a • extend f (z : X)
        rw [hext] }
  let η : Bidual Y := L.mkContinuous ‖ξ‖ (fun f => by
    change ‖ξ (extend f)‖ ≤ ‖ξ‖ * ‖f‖
    rw [← hnorm f]
    exact ξ.le_opNorm _)
  refine ⟨η, ?_⟩
  ext g
  change ξ (extend (adjoint Y.subtypeL g)) = ξ g
  exact hξ _ _ (fun y => hext _ y)

/-- A weak-star limit of canonical evaluations from a subspace comes
from its bidual, with Hahn–Banach providing the extensions. -/
theorem exists_baireOne_restrict_of_sequence (Y : Submodule ℝ X) (ξ : Bidual X)
    (y : ℕ → Y) (hy : ∀ f : Dual X, Tendsto (fun n => f (y n : X)) atTop (𝓝 (ξ f))) :
    ∃ η : Bidual Y, BaireOne η ∧ secondAdjoint Y.subtypeL η = ξ := by
  have hξ (g f : Dual X) (hgf : ∀ z : Y, g (z : X) = f (z : X)) : ξ g = ξ f := by
    have he : (fun n => g (y n : X)) = fun n => f (y n : X) := funext fun n => hgf (y n)
    exact tendsto_nhds_unique (he ▸ hy g) (hy f)
  obtain ⟨η, hη⟩ := exists_secondAdjoint_subtype_of_extensional Y ξ hξ
  refine ⟨η, ⟨y, fun f => ?_⟩, hη⟩
  obtain ⟨g, hg, _⟩ := exists_extension_norm_eq Y f
  have he : adjoint Y.subtypeL g = f := by ext z; exact hg z
  have ht := hy g
  rw [← hη, secondAdjoint_apply, he] at ht
  simpa only [hg] using ht

/-- The algebraic exactness at \(X^{**}\) used in the proof of the
normal-parts exact sequence. -/
theorem secondAdjoint_quotient_eq_zero_iff (Y : Submodule ℝ X) [IsClosed (Y : Set X)]
    (ξ : Bidual X) :
    secondAdjoint Y.mkQL ξ = 0 ↔ ∃ η : Bidual Y, secondAdjoint Y.subtypeL η = ξ := by
  constructor
  · intro hξ
    apply exists_secondAdjoint_subtype_of_extensional
    intro g f hgf
    have hker : Y ≤ (g - f).toLinearMap.ker := by
      intro y hy
      change g y - f y = 0
      rw [hgf ⟨y, hy⟩, sub_self]
    let F := Y.liftQL (g - f) hker
    have he : adjoint Y.mkQL F = g - f := by ext y; rfl
    have hn := congrArg (fun ξ : Bidual (X ⧸ Y) => ξ F) hξ
    rw [secondAdjoint_apply, he, map_sub] at hn
    exact sub_eq_zero.mp hn
  · rintro ⟨η, rfl⟩
    ext f
    have he : adjoint Y.subtypeL (adjoint Y.mkQL f) = 0 := by
      ext y
      change f (Submodule.Quotient.mk (y : X)) = 0
      rw [(Submodule.Quotient.mk_eq_zero Y).mpr y.2, map_zero]
    rw [secondAdjoint_apply, secondAdjoint_apply, he, map_zero]
    rfl

/-- The canonical inclusion of the quotient dual preserves the norm. -/
theorem norm_adjoint_quotient_eq (Y : Submodule ℝ X) [IsClosed (Y : Set X)]
    (f : Dual (X ⧸ Y)) : ‖adjoint Y.mkQL f‖ = ‖f‖ := by
  let g := adjoint Y.mkQL f
  change ‖g‖ = ‖f‖
  apply le_antisymm
  · refine g.opNorm_le_bound (norm_nonneg f) fun x => ?_
    change ‖f (Submodule.Quotient.mk x)‖ ≤ ‖f‖ * ‖x‖
    exact (f.le_opNorm _).trans
      (mul_le_mul_of_nonneg_left (Submodule.Quotient.norm_mk_le Y x) (norm_nonneg f))
  · refine f.opNorm_le_bound (norm_nonneg g) fun w => ?_
    have hb (n : ℕ) : ‖f w‖ ≤ ‖g‖ * (‖w‖ + 1 / ((n : ℝ) + 1)) := by
      have hp : 0 < 1 / ((n : ℝ) + 1) := by positivity
      obtain ⟨x, hx, hn⟩ := Submodule.Quotient.norm_mk_lt w hp
      have he : g x = f w := by
        change f (Submodule.Quotient.mk x) = f w
        rw [hx]
      rw [← he]
      exact (g.le_opNorm _).trans (mul_le_mul_of_nonneg_left hn.le (norm_nonneg g))
    have ht : Tendsto (fun n : ℕ => ‖g‖ * (‖w‖ + 1 / ((n : ℝ) + 1))) atTop
        (𝓝 (‖g‖ * ‖w‖)) := by
      simpa only [add_zero] using (tendsto_const_nhds (x := ‖g‖)).mul
        ((tendsto_const_nhds (x := ‖w‖)).add (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ)))
    exact ge_of_tendsto ht (Eventually.of_forall hb)

/-- The bidual of the quotient map is onto by Hahn–Banach. -/
theorem secondAdjoint_quotient_surjective (Y : Submodule ℝ X) [IsClosed (Y : Set X)] :
    Function.Surjective (secondAdjoint Y.mkQL) := by
  let L : Dual (X ⧸ Y) →L[ℝ] Dual X :=
    (ContinuousLinearMap.compL ℝ X (X ⧸ Y) ℝ).flip Y.mkQL
  let I : Dual (X ⧸ Y) →ₗᵢ[ℝ] Dual X :=
    ⟨L.toLinearMap, norm_adjoint_quotient_eq Y⟩
  intro η
  let g : Dual I.toLinearMap.range := η.comp I.equivRange.symm.toContinuousLinearEquiv.toContinuousLinearMap
  obtain ⟨ξ, hξ, _⟩ := exists_extension_norm_eq I.toLinearMap.range g
  refine ⟨ξ, ?_⟩
  ext f
  have h := hξ (I.equivRange f)
  change ξ (adjoint Y.mkQL f) = η f
  change ξ (adjoint Y.mkQL f) = η (I.equivRange.symm (I.equivRange f)) at h
  simpa only [LinearIsometryEquiv.symm_apply_apply] using h

/-- Exactness at the middle term of the normal-parts sequence. -/
theorem PVM.normal_quotient_kernel_iff (P : PVM Ω X) (Y : Submodule ℝ X)
    [IsClosed (Y : Set X)] (hY : P.Invariant Y) {ξ : Bidual X} (hξ : P.toOVM.Normal ξ) :
    secondAdjoint Y.mkQL ξ = 0 ↔ ∃ η : Bidual Y,
      (P.restrict Y hY).toOVM.Normal η ∧ secondAdjoint Y.subtypeL η = ξ := by
  constructor
  · intro h
    obtain ⟨η, hη⟩ := (secondAdjoint_quotient_eq_zero_iff Y ξ).mp h
    exact ⟨η, (P.normal_restrict_iff Y hY η).mpr (hη ▸ hξ), hη⟩
  · rintro ⟨η, _, hη⟩
    exact (secondAdjoint_quotient_eq_zero_iff Y ξ).mpr ⟨η, hη⟩

/-- Mazur's theorem in the tail form needed for hereditary Baire one. -/
theorem zero_mem_closure_convexHull_weak_null (x : ℕ → X)
    (hx : ∀ f : Dual X, Tendsto (fun n => f (x n)) atTop (𝓝 0)) (k : ℕ) :
    (0 : X) ∈ closure (convexHull ℝ (x '' Ici k)) := by
  by_contra h
  obtain ⟨f, c, hc, hsep⟩ := geometric_hahn_banach_point_closed
    (convex_convexHull ℝ _).closure isClosed_closure h
  have hc' : 0 < c := by simpa only [map_zero] using hc
  obtain ⟨n, hn, hn'⟩ := ((eventually_ge_atTop k).and ((tendsto_order.mp (hx f)).2 c hc')).exists
  exact (not_lt_of_ge (hsep (x n) (subset_closure (subset_convexHull ℝ _ ⟨n, hn, rfl⟩))).le) hn'

/-- Convex combinations of tails have the same scalar limit. -/
theorem tendsto_dual_of_convex_tail (x v : ℕ → X)
    (hv : ∀ n, v n ∈ convexHull ℝ (x '' Ici n)) (f : Dual X) (l : ℝ)
    (hx : Tendsto (fun n => f (x n)) atTop (𝓝 l)) :
    Tendsto (fun n => f (v n)) atTop (𝓝 l) := by
  refine Metric.tendsto_atTop.mpr fun ε hε => ?_
  obtain ⟨N, hN⟩ := Metric.tendsto_atTop.mp hx (ε / 2) (by linarith)
  refine ⟨N, fun n hn => ?_⟩
  have hconv : f (v n) ∈ convexHull ℝ (f '' (x '' Ici n)) := by
    have hm : f (v n) ∈ f.toLinearMap '' (convexHull ℝ (x '' Ici n)) := ⟨v n, hv n, rfl⟩
    rw [f.toLinearMap.image_convexHull] at hm
    exact hm
  have hs : f '' (x '' Ici n) ⊆ Icc (l - ε / 2) (l + ε / 2) := by
    rintro _ ⟨_, ⟨j, hj, rfl⟩, rfl⟩
    have h := hN j (hn.trans hj)
    rw [Real.dist_eq, abs_lt] at h
    exact ⟨by linarith [h.1], by linarith [h.2]⟩
  have hb := convexHull_min hs (convex_Icc _ _) hconv
  rw [Real.dist_eq, abs_lt]
  exact ⟨by linarith [hb.1], by linarith [hb.2]⟩

/-- Manuscript, eq:baire-hereditary. Approximate convex combinations of
quotient tails by vectors in the subspace, as in the manuscript. -/
theorem baireOne_subspace_iff (Y : Submodule ℝ X) (hY : IsClosed (Y : Set X)) (η : Bidual Y) :
    BaireOne (secondAdjoint Y.subtypeL η) ↔ BaireOne η := by
  constructor
  · rintro ⟨x, hx⟩
    let _ : IsClosed (Y : Set X) := hY
    let q := Y.mkQL
    let δ (n : ℕ) : ℝ := 1 / ((n : ℝ) + 1)
    have hδ (n : ℕ) : 0 < δ n := by dsimp [δ]; positivity
    have hq (f : Dual (X ⧸ Y)) : Tendsto (fun n => f (q (x n))) atTop (𝓝 0) := by
      have hn := hx (adjoint q f)
      have hz : adjoint Y.subtypeL (adjoint q f) = 0 := by
        ext y
        change f (q (y : X)) = 0
        have he : q (y : X) = 0 := (Submodule.Quotient.mk_eq_zero Y).mpr y.2
        rw [he, map_zero]
      change Tendsto (fun n => f (q (x n))) atTop (𝓝 (secondAdjoint Y.subtypeL η (adjoint q f))) at hn
      simpa only [secondAdjoint_apply, hz, map_zero] using hn
    have happrox (n : ℕ) : ∃ v ∈ convexHull ℝ (x '' Ici n), ‖q v‖ < δ n := by
      have hc := zero_mem_closure_convexHull_weak_null (fun j => q (x j)) hq n
      obtain ⟨w, hw, hdist⟩ := Metric.mem_closure_iff.mp hc (δ n) (hδ n)
      have he : (fun j => q (x j)) '' Ici n = q.toLinearMap '' (x '' Ici n) := by
        rw [Set.image_image]; rfl
      rw [he, ← q.toLinearMap.image_convexHull] at hw
      obtain ⟨v, hv, rfl⟩ := hw
      change dist (0 : X ⧸ Y) (q v) < δ n at hdist
      rw [dist_comm, dist_zero_right] at hdist
      exact ⟨v, hv, hdist⟩
    choose v hv hqv using happrox
    have hnear (n : ℕ) : ∃ y : Y, ‖v n - (y : X)‖ < 2 * δ n := by
      obtain ⟨m, hm, hmNorm⟩ := Submodule.Quotient.norm_mk_lt (q (v n)) (hδ n)
      refine ⟨⟨v n - m, (Submodule.Quotient.eq Y).mp hm.symm⟩, ?_⟩
      change ‖v n - (v n - m)‖ < 2 * δ n
      rw [sub_sub_cancel]
      linarith [hqv n]
    choose y hy using hnear
    refine ⟨y, fun f => ?_⟩
    obtain ⟨g, hg, _⟩ := exists_extension_norm_eq Y f
    have he : adjoint Y.subtypeL g = f := by ext z; exact hg z
    have hvg := tendsto_dual_of_convex_tail x v hv g (secondAdjoint Y.subtypeL η g) (hx g)
    rw [secondAdjoint_apply, he] at hvg
    have hdiff : Tendsto (fun n => g (v n) - f (y n)) atTop (𝓝 0) := by
      apply tendsto_zero_iff_norm_tendsto_zero.mpr
      have ht : Tendsto (fun n => ‖g‖ * (2 * δ n)) atTop (𝓝 (0 : ℝ)) := by
        have h := (tendsto_const_nhds (x := ‖g‖)).mul
          ((tendsto_const_nhds (x := (2 : ℝ))).mul (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ)))
        simpa only [mul_zero] using h
      refine squeeze_zero (fun _ => norm_nonneg _) (fun n => ?_) ht
      rw [← hg (y n), ← map_sub]
      exact (g.le_opNorm _).trans (mul_le_mul_of_nonneg_left (hy n).le (norm_nonneg g))
    have h := hvg.sub hdiff
    simpa only [sub_sub_cancel, sub_zero] using h
  · exact fun h => BaireOne.second_adjoint h Y.subtypeL

/-- A finite measurable union indexed by natural numbers. -/
def MeasSet.finiteUnion (B : ℕ → MeasSet Ω) (I : Finset ℕ) : MeasSet Ω :=
  ⟨⋃ n ∈ I, (B n).1, MeasurableSet.iUnion fun n => MeasurableSet.iUnion fun _ => (B n).2⟩

/-- Finite additivity follows by padding a disjoint family with empty sets. -/
theorem MeasSet.finite_additivity {V : Type*} [AddCommMonoid V] [TopologicalSpace V]
    [T2Space V] (φ : MeasSet Ω → V) (h0 : φ MeasSet.empty = 0)
    (hφ : ∀ B : ℕ → MeasSet Ω, MeasSet.DisjointSeq B →
      HasSum (fun n => φ (B n)) (φ (MeasSet.iUnion B)))
    (B : ℕ → MeasSet Ω) (hB : MeasSet.DisjointSeq B) (I : Finset ℕ) :
    φ (MeasSet.finiteUnion B I) = ∑ n ∈ I, φ (B n) := by
  let C (n : ℕ) := if n ∈ I then B n else MeasSet.empty
  have hC : MeasSet.DisjointSeq C := by
    intro i j hij
    by_cases hi : i ∈ I <;> by_cases hj : j ∈ I
    · simpa [C, hi, hj] using hB hij
    · simp [C, hj, MeasSet.empty]
    · simp [C, hi, MeasSet.empty]
    · simp [C, hi, MeasSet.empty]
  have hUnion : (MeasSet.iUnion C).1 = ⋃ n ∈ I, (B n).1 := by
    ext x
    simp only [MeasSet.iUnion, mem_iUnion]
    constructor
    · rintro ⟨n, hn⟩
      by_cases h : n ∈ I
      · exact ⟨n, h, by simpa [C, h] using hn⟩
      · simp [C, h, MeasSet.empty] at hn
    · rintro ⟨n, h, hn⟩
      exact ⟨n, by simpa [C, h] using hn⟩
  have hs := hφ C hC
  have hs' : HasSum (fun n => φ (C n))
      (∑ n ∈ I, φ (B n)) := by
    have hsum : (∑ n ∈ I, φ (C n)) =
        ∑ n ∈ I, φ (B n) := by
      apply Finset.sum_congr rfl
      intro n hn
      simp [C, hn]
    rw [← hsum]
    apply hasSum_sum_of_ne_finset_zero
    intro n hn
    simp [C, hn, h0]
  have hMeas : MeasSet.iUnion C = MeasSet.finiteUnion B I := Subtype.ext hUnion
  rw [← hMeas]
  exact hs.unique hs'

/-- Finite additivity of a scalar coefficient of a normal vector. -/
theorem OVM.normal_finite_union (μ : OVM Ω X) {ξ : Bidual X} (hξ : μ.Normal ξ)
    (B : ℕ → MeasSet Ω) (hB : MeasSet.DisjointSeq B) (N : ℕ) (f : Dual X) :
    ξ (adjoint (μ.val (MeasSet.finiteUnion B (Finset.range N))) f) =
      ∑ n ∈ Finset.range N, ξ (adjoint (μ.val (B n)) f) :=
  MeasSet.finite_additivity (fun E => ξ (adjoint (μ.val E) f))
    (by simp [μ.empty_eq, adjoint]) (fun E hE => hξ E hE f) B hB _

theorem OVM.apply_finite_union (μ : OVM Ω X) (B : ℕ → MeasSet Ω)
    (hB : MeasSet.DisjointSeq B) (I : Finset ℕ) (x : X) :
    μ.val (MeasSet.finiteUnion B I) x = ∑ n ∈ I, μ.val (B n) x :=
  MeasSet.finite_additivity (fun E => μ.val E x)
    (by rw [μ.empty_eq]; rfl) (fun E hE => μ.countably_additive E hE x) B hB I

theorem OVM.apply_union (μ : OVM Ω X) (A B : MeasSet Ω)
    (h : Disjoint A.1 B.1) (x : X) :
    μ.val (A.union B) x = μ.val A x + μ.val B x := by
  let E : ℕ → MeasSet Ω := fun n => if n = 0 then A else if n = 1 then B else MeasSet.empty
  have hE : MeasSet.DisjointSeq E := by
    intro i j hij
    by_cases hi : i = 0 <;> by_cases hj : j = 0
    · exact (hij (hi.trans hj.symm)).elim
    · by_cases hj' : j = 1
      · simpa [E, hi, hj, hj'] using h
      · simp [E, hj, hj', MeasSet.empty]
    · by_cases hi' : i = 1
      · simpa [E, hi, hi', hj] using h.symm
      · simp [E, hi, hi', MeasSet.empty]
    · by_cases hi' : i = 1 <;> by_cases hj' : j = 1
      · exact (hij (hi'.trans hj'.symm)).elim
      · simp [E, hj, hj', MeasSet.empty]
      · simp [E, hi, hi', MeasSet.empty]
      · simp [E, hi, hi', MeasSet.empty]
  have hu : MeasSet.finiteUnion E {0, 1} = A.union B := by
    apply Subtype.ext
    ext ω
    simp [MeasSet.finiteUnion, MeasSet.union, E]
  rw [← hu, μ.apply_finite_union E hE]
  simp [E]

/-- Strong continuity from below, proved by disjoint increments. -/
theorem OVM.tendsto_apply_of_increasing (μ : OVM Ω X) (A : ℕ → MeasSet Ω)
    (hA : Monotone (fun n => (A n).1)) (x : X) :
    Tendsto (fun n => μ.val (A n) x) atTop (𝓝 (μ.val (MeasSet.iUnion A) x)) := by
  let B (n : ℕ) : MeasSet Ω :=
    ⟨disjointed (fun k => (A k).1) n, MeasurableSet.disjointed (fun k => (A k).2) n⟩
  have hB : MeasSet.DisjointSeq B := disjoint_disjointed _
  have hcover : MeasSet.iUnion B = MeasSet.iUnion A := Subtype.ext iUnion_disjointed
  have ht := (μ.countably_additive B hB x).tendsto_sum_nat.comp (tendsto_add_atTop_nat 1)
  have he : (fun N => (∑ n ∈ Finset.range N, μ.val (B n) x)) ∘ (fun N => N + 1) =
      fun N => μ.val (A N) x := by
    funext N
    change (∑ n ∈ Finset.range (N + 1), μ.val (B n) x) = μ.val (A N) x
    rw [← μ.apply_finite_union B hB]
    exact congrArg (fun E : MeasSet Ω => μ.val E x) (Subtype.ext (disjointed_initial_union _ hA N))
  rw [he, hcover] at ht
  exact ht

/-- Uniform vanishing on subsets of a decreasing sequence with empty
intersection. The gliding-hump proof produces disjoint large orbit terms
if the uniform estimate fails. -/
theorem OVM.uniform_orbit_on_decreasing_empty (μ : OVM Ω X) (x : X)
    (A : ℕ → MeasSet Ω) (hA : Antitone (fun n => (A n).1))
    (hzero : (⋂ n, (A n).1) = ∅) (ε : ℝ) (hε : 0 < ε) :
    ∃ N : ℕ, ∀ E : MeasSet Ω, E.1 ⊆ (A N).1 → ‖μ.val E x‖ < ε := by
  classical
  by_contra h
  push Not at h
  have step (n : ℕ) : ∃ j : ℕ, ∃ D : MeasSet Ω,
      n < j ∧ D.1 ⊆ (A n).1 ∧ Disjoint D.1 (A j).1 ∧ ε / 2 < ‖μ.val D x‖ := by
    obtain ⟨E, hE, hElarge⟩ := h n
    let F (k : ℕ) := E.diff (A k)
    have hm : Monotone (fun k => (F k).1) := fun i j hij _ hf =>
      ⟨hf.1, fun hj => hf.2 (hA hij hj)⟩
    have hu : MeasSet.iUnion F = E := by
      apply Subtype.ext
      change (⋃ k, E.1 \ (A k).1) = E.1
      rw [← Set.sdiff_iInter, hzero, sdiff_empty]
    have ht := μ.tendsto_apply_of_increasing F hm x
    rw [hu] at ht
    have hl : ε / 2 < ‖μ.val E x‖ := by linarith
    obtain ⟨j, hj, hF⟩ := ((eventually_ge_atTop (n + 1)).and
      ((tendsto_order.mp ht.norm).1 (ε / 2) hl)).exists
    refine ⟨j, F j, Nat.lt_of_succ_le hj, sdiff_subset.trans hE, ?_, hF⟩
    exact Set.disjoint_left.mpr fun _ hD hAj => hD.2 hAj
  let indices : ℕ → ℕ := Nat.rec 0 (fun _ n => (step n).choose)
  let D (n : ℕ) := (step (indices n)).choose_spec.choose
  have hstep (n : ℕ) :
      indices n < indices (n + 1) ∧ (D n).1 ⊆ (A (indices n)).1 ∧
        Disjoint (D n).1 (A (indices (n + 1))).1 ∧ ε / 2 < ‖μ.val (D n) x‖ :=
    (step (indices n)).choose_spec.choose_spec
  have hmono : Monotone indices := monotone_nat_of_le_succ fun n => (hstep n).1.le
  have hdis : MeasSet.DisjointSeq D := by
    apply Pairwise.of_lt
    intro n m hnm
    exact Disjoint.mono_right ((hstep m).2.1.trans (hA (hmono hnm))) (hstep n).2.2.1
  have ht := (μ.countably_additive D hdis x).summable.tendsto_atTop_zero
  have hn : Tendsto (fun n => ‖μ.val (D n) x‖) atTop (𝓝 (0 : ℝ)) := by
    simpa only [norm_zero] using ht.norm
  obtain ⟨n, hn⟩ := ((tendsto_order.mp hn).2 (ε / 2) (by linarith)).exists
  exact (not_lt_of_ge (hstep n).2.2.2.le) hn

/-- The range of each vector orbit is bounded. An unbounded orbit would
give a disjoint sequence on which the orbit values stay away from zero. -/
theorem OVM.orbit_norm_bounded (μ : OVM Ω X) (x : X) :
    ∃ C : ℝ, ∀ E : MeasSet Ω, ‖μ.val E x‖ ≤ C := by
  classical
  by_contra h
  push Not at h
  let Unbounded (A : MeasSet Ω) : Prop :=
    ∀ C : ℝ, ∃ E : MeasSet Ω, E.1 ⊆ A.1 ∧ C < ‖μ.val E x‖
  have hsplit (A : MeasSet Ω) (hA : Unbounded A) :
      ∃ B D : MeasSet Ω, B.1 ⊆ A.1 ∧ D.1 ⊆ A.1 ∧ Unbounded B ∧
        Disjoint D.1 B.1 ∧ 1 < ‖μ.val D x‖ := by
    obtain ⟨E, hEA, hE⟩ := hA (‖μ.val A x‖ + 1)
    let F := A.diff E
    have hFA : F.1 ⊆ A.1 := sdiff_subset
    have hEF : Disjoint E.1 F.1 := Set.disjoint_left.mpr fun _ hw hw' => hw'.2 hw
    have hu (H : MeasSet Ω) (hHA : H.1 ⊆ A.1) :
        (H.inter E).union (H.inter F) = H := by
      apply Subtype.ext
      ext ω
      change (ω ∈ H.1 ∩ E.1 ∪ H.1 ∩ (A.1 \ E.1)) ↔ ω ∈ H.1
      constructor
      · exact fun h => h.elim And.left And.left
      · intro hw
        by_cases he : ω ∈ E.1
        · exact Or.inl ⟨hw, he⟩
        · exact Or.inr ⟨hw, hHA hw, he⟩
    have hadd (H : MeasSet Ω) (hHA : H.1 ⊆ A.1) :
        μ.val H x = μ.val (H.inter E) x + μ.val (H.inter F) x := by
      rw [← μ.apply_union _ _ (hEF.mono inter_subset_right inter_subset_right), hu H hHA]
    have hAeq : μ.val A x = μ.val E x + μ.val F x := by
      have hAE : A.inter E = E := Subtype.ext (inter_eq_right.mpr hEA)
      have hAF : A.inter F = F := Subtype.ext (inter_eq_right.mpr hFA)
      simpa only [hAE, hAF] using hadd A Subset.rfl
    have hF : 1 < ‖μ.val F x‖ := by
      have heq : μ.val E x = μ.val A x - μ.val F x := eq_sub_of_add_eq hAeq.symm
      have hb : ‖μ.val E x‖ ≤ ‖μ.val A x‖ + ‖μ.val F x‖ := by
        rw [heq]
        exact norm_sub_le _ _
      linarith
    by_cases hEU : Unbounded E
    · exact ⟨E, F, hEA, hFA, hEU, hEF.symm, hF⟩
    · have hFU : Unbounded F := by
        by_contra hFU
        unfold Unbounded at hEU hFU
        push Not at hEU hFU
        obtain ⟨C, hC⟩ := hEU
        obtain ⟨K, hK⟩ := hFU
        obtain ⟨H, hHA, hH⟩ := hA (C + K)
        have hb : ‖μ.val H x‖ ≤ C + K := by
          rw [hadd H hHA]
          exact (norm_add_le _ _).trans (add_le_add (hC _ inter_subset_right)
            (hK _ inter_subset_right))
        exact (not_lt_of_ge hb) hH
      exact ⟨F, E, hFA, hEA, hFU, hEF, by linarith [norm_nonneg (μ.val A x)]⟩
  let T := {A : MeasSet Ω // Unbounded A}
  let next (A : T) : T := ⟨(hsplit A.1 A.2).choose, (hsplit A.1 A.2).choose_spec.choose_spec.2.2.1⟩
  let kept : ℕ → T := Nat.rec
    ⟨MeasSet.whole, fun C => let ⟨E, hE⟩ := h C; ⟨E, subset_univ _, hE⟩⟩
    (fun _ A => next A)
  let discarded (n : ℕ) := (hsplit (kept n).1 (kept n).2).choose_spec.choose
  have hdetails (n : ℕ) :
      (kept (n + 1)).1.1 ⊆ (kept n).1.1 ∧
        (discarded n).1 ⊆ (kept n).1.1 ∧
        Disjoint (discarded n).1 (kept (n + 1)).1.1 ∧
        1 < ‖μ.val (discarded n) x‖ := by
    have hs := (hsplit (kept n).1 (kept n).2).choose_spec.choose_spec
    exact ⟨hs.1, hs.2.1, hs.2.2.2⟩
  have hanti : Antitone (fun n => (kept n).1.1) :=
    antitone_nat_of_succ_le fun n => (hdetails n).1
  have hdis : MeasSet.DisjointSeq discarded := by
    apply Pairwise.of_lt
    · intro n m hnm
      exact Disjoint.mono_right ((hdetails m).2.1.trans (hanti hnm)) (hdetails n).2.2.1
  have ht := (μ.countably_additive discarded hdis x).summable.tendsto_atTop_zero
  have hn : Tendsto (fun n => ‖μ.val (discarded n) x‖) atTop (𝓝 (0 : ℝ)) := by
    simpa only [norm_zero] using ht.norm
  have he := (tendsto_order.mp hn).2 1 zero_lt_one
  obtain ⟨n, hn⟩ := he.exists
  exact (not_lt_of_ge (hdetails n).2.2.2.le) hn

/-- Manuscript, Remark 2.2: the operator norm is uniformly bounded. -/
theorem OVM.opNorm_bounded [CompleteSpace X] (μ : OVM Ω X) :
    ∃ C : ℝ, ∀ E : MeasSet Ω, ‖μ.val E‖ ≤ C :=
  banach_steinhaus (g := μ.val) μ.orbit_norm_bounded

/-- The constant \(M_\mu\) used in the manuscript. -/
noncomputable def OVM.uniformNorm (μ : OVM Ω X) : ℝ :=
  sSup (Set.range fun E => ‖μ.val E‖)

theorem OVM.opNorm_le_uniformNorm [CompleteSpace X] (μ : OVM Ω X) (E : MeasSet Ω) :
    ‖μ.val E‖ ≤ μ.uniformNorm := by
  obtain ⟨C, hC⟩ := μ.opNorm_bounded
  exact le_csSup ⟨C, by rintro _ ⟨E, rfl⟩; exact hC E⟩ ⟨E, rfl⟩

theorem OVM.uniformNorm_nonneg [CompleteSpace X] (μ : OVM Ω X) : 0 ≤ μ.uniformNorm :=
  (norm_nonneg _).trans (μ.opNorm_le_uniformNorm MeasSet.empty)

theorem norm_secondAdjoint_le (A : X →L[ℝ] Z) (ξ : Bidual X) :
    ‖secondAdjoint A ξ‖ ≤ ‖A‖ * ‖ξ‖ := by
  refine (secondAdjoint A ξ).opNorm_le_bound (mul_nonneg (norm_nonneg A) (norm_nonneg ξ)) ?_
  intro f
  change ‖ξ (adjoint A f)‖ ≤ ‖A‖ * ‖ξ‖ * ‖f‖
  calc
    ‖ξ (adjoint A f)‖ ≤ ‖ξ‖ * ‖adjoint A f‖ := ξ.le_opNorm _
    _ ≤ ‖ξ‖ * (‖f‖ * ‖A‖) :=
      mul_le_mul_of_nonneg_left (f.opNorm_comp_le A) (norm_nonneg ξ)
    _ = ‖A‖ * ‖ξ‖ * ‖f‖ := by ring

private theorem exists_finite_mask_cylinder {U : Set (ℕ → Bool)} {b : ℕ → Bool}
    (hU : U ∈ 𝓝 b) :
    ∃ I : Finset ℕ, ∀ c : ℕ → Bool, (∀ n ∈ I, c n = b n) → c ∈ U := by
  rw [nhds_pi, Filter.mem_pi'] at hU
  obtain ⟨I, t, ht, hsub⟩ := hU
  refine ⟨I, fun c hc => hsub ?_⟩
  intro i hi
  rw [hc i (Finset.mem_coe.mp hi)]
  exact mem_of_mem_nhds (ht i)

private noncomputable def maskedSum (a : ℕ → ℝ) (b : ℕ → Bool) : ℝ :=
  ∑' n, if b n then a n else 0

private theorem hasSum_masked (a : ℕ → ℝ) (ha : Summable (fun n => |a n|)) (b : ℕ → Bool) :
    HasSum (fun n => if b n then a n else 0) (maskedSum a b) := by
  apply Summable.hasSum
  apply Summable.of_norm
  apply ha.of_nonneg_of_le (fun _ => norm_nonneg _)
  intro n
  cases b n <;> simp [Real.norm_eq_abs]

private theorem continuous_maskedSum (a : ℕ → ℝ) (ha : Summable (fun n => |a n|)) :
    Continuous (maskedSum a) := by
  unfold maskedSum
  refine continuous_tsum (fun n => ?_) ha (fun n b => ?_)
  · exact (continuous_of_discreteTopology (f := fun b : Bool => if b then a n else 0)).comp
      (continuous_apply n)
  · cases b n <;> simp [Real.norm_eq_abs]

/-- The countable-partition form of the scalar pointwise-limit theorem.
Baire's theorem on the space of masks yields uniform control on tails. -/
theorem hasSum_of_pointwise_limits_on_masks (a : ℕ → ℕ → ℝ) (v : ℕ → ℝ) (L : ℝ)
    (ha : ∀ k, Summable fun n => |a k n|)
    (hv : ∀ n, Tendsto (fun k => a k n) atTop (𝓝 (v n)))
    (hb : ∀ b : ℕ → Bool, ∃ l : ℝ, Tendsto (fun k => maskedSum (a k) b) atTop (𝓝 l))
    (hL : Tendsto (fun k => maskedSum (a k) (fun _ => true)) atTop (𝓝 L)) :
    HasSum v L := by
  classical
  unfold HasSum
  change Tendsto (fun I : Finset ℕ => ∑ n ∈ I, v n) atTop (𝓝 L)
  refine Metric.tendsto_atTop.mpr fun ε hε => ?_
  let δ := ε / 4
  have hδ : 0 < δ := by dsimp [δ]; linarith
  let C (K : ℕ) : Set (ℕ → Bool) :=
    {b | ∀ k ≥ K, ∀ j ≥ K, |maskedSum (a k) b - maskedSum (a j) b| ≤ δ}
  have hclosed (K : ℕ) : IsClosed (C K) := by
    have he : C K = ⋂ (k : ℕ) (_ : K ≤ k) (j : ℕ) (_ : K ≤ j),
        {b | |maskedSum (a k) b - maskedSum (a j) b| ≤ δ} := by
      ext b
      simp [C]
    rw [he]
    exact isClosed_iInter fun k => isClosed_iInter fun _ => isClosed_iInter fun j =>
      isClosed_iInter fun _ => isClosed_le
        (((continuous_maskedSum _ (ha k)).sub (continuous_maskedSum _ (ha j))).abs)
        continuous_const
  have hcover : ⋃ K, C K = Set.univ := by
    apply Set.eq_univ_of_forall
    intro b
    obtain ⟨l, hl⟩ := hb b
    obtain ⟨K, hK⟩ := Metric.cauchySeq_iff.mp hl.cauchySeq δ hδ
    exact mem_iUnion.mpr ⟨K, fun k hk j hj => by simpa only [Real.dist_eq] using (hK k hk j hj).le⟩
  obtain ⟨K, b, hbC⟩ := nonempty_interior_of_iUnion_of_closed hclosed hcover
  obtain ⟨I, hI⟩ := exists_finite_mask_cylinder (mem_interior_iff_mem_nhds.mp hbC)
  let b₀ (n : ℕ) : Bool := if n ∈ I then b n else false
  have hb₀ : b₀ ∈ C K := hI b₀ (fun n hn => ite_eq_left hn)
  have htailPair (d : ℕ → Bool) (hd : ∀ n ∈ I, d n = false) (k : ℕ) (hk : K ≤ k) :
      |maskedSum (a k) d - maskedSum (a K) d| ≤ 2 * δ := by
    let e (n : ℕ) : Bool := if n ∈ I then b n else d n
    have he : e ∈ C K := hI e (fun n hn => ite_eq_left hn)
    have hadd (j : ℕ) : maskedSum (a j) e = maskedSum (a j) b₀ + maskedSum (a j) d := by
      have hh := (hasSum_masked _ (ha j) b₀).add (hasSum_masked _ (ha j) d)
      have hfun : (fun n => (if b₀ n then a j n else 0) + (if d n then a j n else 0)) =
          fun n => if e n then a j n else 0 := by
        funext n
        by_cases hn : n ∈ I
        · simp [e, b₀, hn, hd n hn]
        · simp [e, b₀, hn]
      rw [hfun] at hh
      exact (hasSum_masked _ (ha j) e).unique hh
    have h1 := he k hk K le_rfl
    have h0 := hb₀ k hk K le_rfl
    rw [hadd k, hadd K] at h1
    apply abs_le.mpr
    constructor <;> linarith [(abs_le.mp h1).1, (abs_le.mp h1).2,
      (abs_le.mp h0).1, (abs_le.mp h0).2]
  have hz : maskedSum (a K) (fun _ => false) = 0 := by simp [maskedSum]
  have hnear : {d : ℕ → Bool | |maskedSum (a K) d| < δ} ∈ 𝓝 (fun _ => false) := by
    have hpre := (continuous_maskedSum _ (ha K)).continuousAt
      (Metric.ball_mem_nhds (maskedSum (a K) (fun _ => false)) hδ)
    change {d : ℕ → Bool | dist (maskedSum (a K) d) (maskedSum (a K) (fun _ => false)) < δ} ∈
      𝓝 (fun _ => false) at hpre
    simpa only [hz, Real.dist_eq, sub_zero] using hpre
  obtain ⟨J, hJ⟩ := exists_finite_mask_cylinder hnear
  refine ⟨I ∪ J, fun F hF => ?_⟩
  let d (n : ℕ) : Bool := if n ∈ F then false else true
  have hdI (n : ℕ) (hn : n ∈ I) : d n = false := by simp [d, hF (Finset.mem_union_left _ hn)]
  have hdJ (n : ℕ) (hn : n ∈ J) : d n = false := by simp [d, hF (Finset.mem_union_right _ hn)]
  have hsmall : |maskedSum (a K) d| < δ := hJ d hdJ
  have htail (k : ℕ) (hk : K ≤ k) : |maskedSum (a k) d| ≤ 3 * δ := by
    have h := htailPair d hdI k hk
    apply abs_le.mpr
    constructor <;> linarith [(abs_le.mp h).1, (abs_le.mp h).2,
      (abs_lt.mp hsmall).1, (abs_lt.mp hsmall).2]
  have hsplit (k : ℕ) : maskedSum (a k) (fun _ => true) =
      (∑ n ∈ F, a k n) + maskedSum (a k) d := by
    have hf : HasSum (fun n => if n ∈ F then a k n else 0) (∑ n ∈ F, a k n) := by
      have he : (∑ n ∈ F, if n ∈ F then a k n else 0) = ∑ n ∈ F, a k n :=
        Finset.sum_congr rfl fun n hn => ite_eq_left hn
      rw [← he]
      exact hasSum_sum_of_ne_finset_zero fun n hn => ite_eq_right hn
    have hh := hf.add (hasSum_masked _ (ha k) d)
    have he : (fun n => (if n ∈ F then a k n else 0) + (if d n then a k n else 0)) = a k := by
      funext n
      by_cases hn : n ∈ F <;> simp [d, hn]
    rw [he] at hh
    exact ((by simpa only [Bool.true_eq, ite_true] using (hasSum_masked _ (ha k) (fun _ => true))) :
      HasSum (a k) (maskedSum (a k) (fun _ => true))).unique hh
  have hlimit : Tendsto (fun k => maskedSum (a k) d) atTop (𝓝 (L - ∑ n ∈ F, v n)) := by
    have heq : (fun k => maskedSum (a k) d) =
        fun k => maskedSum (a k) (fun _ => true) - ∑ n ∈ F, a k n := by
      funext k
      rw [hsplit k, add_sub_cancel_left]
    rw [heq]
    exact hL.sub (tendsto_finsetSum _ fun n _ => hv n)
  have hbnd : |L - ∑ n ∈ F, v n| ≤ 3 * δ :=
    le_of_tendsto hlimit.abs ((eventually_ge_atTop K).mono htail)
  rw [Real.dist_eq, abs_sub_comm]
  exact hbnd.trans_lt (by dsimp [δ]; linarith)

/-- Manuscript, lem:normal-restriction. The relevant scalar pointwise-limit
theorem is proved on each countable partition. -/
theorem OVM.normal_of_baireOne_by_baire (μ : OVM Ω X) (ξ : Bidual X) (hξ : BaireOne ξ) :
    μ.Normal ξ := by
  obtain ⟨x, hx⟩ := hξ
  intro B hB f
  let a (k n : ℕ) := f (μ.val (B n) (x k))
  let v (n : ℕ) := ξ (adjoint (μ.val (B n)) f)
  let L := ξ (adjoint (μ.val (MeasSet.iUnion B)) f)
  change HasSum v L
  have ha (k : ℕ) : Summable (fun n => |a k n|) :=
    ((μ.normal_J (x k) B hB f).summable).abs
  have hv (n : ℕ) : Tendsto (fun k => a k n) atTop (𝓝 (v n)) :=
    hx (adjoint (μ.val (B n)) f)
  have hmask (b : ℕ → Bool) : ∃ E : MeasSet Ω,
      ∀ k, maskedSum (a k) b = f (μ.val E (x k)) := by
    let D (n : ℕ) := if b n then B n else MeasSet.empty
    have hD : MeasSet.DisjointSeq D := by
      intro i j hij
      cases hi : b i <;> cases hj : b j <;> simp [D, hi, hj, MeasSet.empty]
      exact hB hij
    refine ⟨MeasSet.iUnion D, fun k => ?_⟩
    have hsum := μ.normal_J (x k) D hD f
    change HasSum (fun n => f (μ.val (D n) (x k))) (f (μ.val (MeasSet.iUnion D) (x k))) at hsum
    have he : (fun n => f (μ.val (D n) (x k))) = fun n => if b n then a k n else 0 := by
      funext n
      cases hn : b n <;> simp [D, hn, a, μ.empty_eq]
    rw [he] at hsum
    exact (hasSum_masked _ (ha k) b).unique hsum
  have hpoint (b : ℕ → Bool) : ∃ l : ℝ, Tendsto (fun k => maskedSum (a k) b) atTop (𝓝 l) := by
    obtain ⟨E, hE⟩ := hmask b
    exact ⟨ξ (adjoint (μ.val E) f), (funext hE).symm ▸ hx (adjoint (μ.val E) f)⟩
  refine hasSum_of_pointwise_limits_on_masks a v L ha hv hpoint ?_
  have he (k : ℕ) : maskedSum (a k) (fun _ => true) = f (μ.val (MeasSet.iUnion B) (x k)) := by
    have hs := hasSum_masked _ (ha k) (fun _ => true)
    have ht := μ.normal_J (x k) B hB f
    change HasSum (a k) (f (μ.val (MeasSet.iUnion B) (x k))) at ht
    have hh : HasSum (a k) (maskedSum (a k) (fun _ => true)) := by simpa using hs
    exact hh.unique ht
  exact (funext he).symm ▸ hx (adjoint (μ.val (MeasSet.iUnion B)) f)

theorem MeasSet.finite_add_of_pair {V : Type*} [AddCommMonoid V]
    (φ : MeasSet Ω → V) (hzero : φ MeasSet.empty = 0)
    (hadd : ∀ E F : MeasSet Ω, Disjoint E.1 F.1 → φ (E.union F) = φ E + φ F)
    (E : ℕ → MeasSet Ω) (hE : MeasSet.DisjointSeq E)
    (I : Finset ℕ) : φ (MeasSet.finiteUnion E I) = ∑ n ∈ I, φ (E n) := by
  classical
  induction I using Finset.induction_on with
  | empty =>
    have he : MeasSet.finiteUnion E ∅ = MeasSet.empty := by
      apply Subtype.ext
      simp [MeasSet.finiteUnion, MeasSet.empty]
    rw [he, hzero, Finset.sum_empty]
  | insert n I hn ih =>
    have he : MeasSet.finiteUnion E (insert n I) = (E n).union (MeasSet.finiteUnion E I) := by
      apply Subtype.ext
      ext ω
      change (ω ∈ ⋃ i ∈ insert n I, (E i).1) ↔ ω ∈ (E n).1 ∪ ⋃ i ∈ I, (E i).1
      simp only [mem_iUnion, mem_union, Finset.mem_insert]
      constructor
      · rintro ⟨j, hj | hj, hjω⟩
        · subst j; exact Or.inl hjω
        · exact Or.inr ⟨j, hj, hjω⟩
      · rintro (h | ⟨j, hj, h⟩)
        · exact ⟨n, Or.inl rfl, h⟩
        · exact ⟨j, Or.inr hj, h⟩
    have hd : Disjoint (E n).1 (MeasSet.finiteUnion E I).1 := Set.disjoint_left.mpr (by
      intro ω hω hω'
      obtain ⟨j, hj, hjω⟩ := mem_iUnion₂.mp hω'
      exact (Set.disjoint_left.mp (hE (fun heq : n = j => hn (heq.symm ▸ hj))) hω) hjω)
    rw [he, hadd _ _ hd, ih, Finset.sum_insert hn]



/-- A bounded finitely additive real measure. This is the scalar object
on which the Yosida–Hewitt projection in §2 acts. -/
structure ScalarCharge (Ω : Type*) [MeasurableSpace Ω] where
  val : MeasSet Ω → ℝ
  empty_eq : val MeasSet.empty = 0
  add_union : ∀ A B : MeasSet Ω, Disjoint A.1 B.1 →
    val (A.union B) = val A + val B
  bounded : ∃ C : ℝ, ∀ E : MeasSet Ω, |val E| ≤ C

namespace ScalarCharge

def Positive (m : ScalarCharge Ω) : Prop := ∀ E : MeasSet Ω, 0 ≤ m.val E

def CountablyAdditive (m : ScalarCharge Ω) : Prop :=
  ∀ B : ℕ → MeasSet Ω, MeasSet.DisjointSeq B → HasSum (fun n => m.val (B n)) (m.val (MeasSet.iUnion B))

theorem union_diff_of_subset (A B : MeasSet Ω) (hBA : B.1 ⊆ A.1) :
    B.union (A.diff B) = A := by
  apply Subtype.ext
  ext ω
  change (ω ∈ B.1 ∪ A.1 \ B.1) ↔ ω ∈ A.1
  constructor
  · rintro (h | h)
    · exact hBA h
    · exact h.1
  · intro h
    by_cases hB : ω ∈ B.1
    · exact Or.inl hB
    · exact Or.inr ⟨h, hB⟩

theorem add_diff (m : ScalarCharge Ω) (A B : MeasSet Ω) (hBA : B.1 ⊆ A.1) :
    m.val A = m.val B + m.val (A.diff B) := by
  have hdis : Disjoint B.1 (A.diff B).1 := Set.disjoint_left.mpr fun _ hb h => h.2 hb
  rw [← m.add_union B (A.diff B) hdis, union_diff_of_subset A B hBA]

theorem val_mono (m : ScalarCharge Ω) (hm : m.Positive) {A B : MeasSet Ω}
    (hAB : A.1 ⊆ B.1) : m.val A ≤ m.val B := by
  rw [m.add_diff B A hAB]
  exact le_add_of_nonneg_right (hm _)

private def subvalues (m : ScalarCharge Ω) (A : MeasSet Ω) : Set ℝ :=
  {r | ∃ B : MeasSet Ω, B.1 ⊆ A.1 ∧ m.val B = r}

private theorem subvalues_nonempty (m : ScalarCharge Ω) (A : MeasSet Ω) :
    (m.subvalues A).Nonempty :=
  ⟨0, MeasSet.empty, empty_subset _, m.empty_eq⟩

private theorem subvalues_bddAbove (m : ScalarCharge Ω) (A : MeasSet Ω) :
    BddAbove (m.subvalues A) := by
  obtain ⟨C, hC⟩ := m.bounded
  refine ⟨C, ?_⟩
  rintro r ⟨B, _, rfl⟩
  exact (le_abs_self _).trans (hC B)

noncomputable def upperVariation (m : ScalarCharge Ω) (A : MeasSet Ω) : ℝ :=
  sSup (m.subvalues A)

theorem val_le_upperVariation (m : ScalarCharge Ω) {A B : MeasSet Ω} (hBA : B.1 ⊆ A.1) :
    m.val B ≤ m.upperVariation A :=
  le_csSup (m.subvalues_bddAbove A) ⟨B, hBA, rfl⟩

theorem upperVariation_le (m : ScalarCharge Ω) (A : MeasSet Ω) (C : ℝ)
    (h : ∀ B : MeasSet Ω, B.1 ⊆ A.1 → m.val B ≤ C) : m.upperVariation A ≤ C := by
  apply csSup_le (m.subvalues_nonempty A)
  rintro r ⟨B, hB, rfl⟩
  exact h B hB

theorem upperVariation_nonneg (m : ScalarCharge Ω) (A : MeasSet Ω) : 0 ≤ m.upperVariation A := by
  rw [← m.empty_eq]
  exact m.val_le_upperVariation (empty_subset A.1)

theorem upperVariation_empty (m : ScalarCharge Ω) : m.upperVariation MeasSet.empty = 0 := by
  refine le_antisymm (m.upperVariation_le _ 0 ?_) (m.upperVariation_nonneg _)
  intro B hB
  have h : B = MeasSet.empty := Subtype.ext (subset_empty_iff.mp hB)
  rw [h, m.empty_eq]

theorem upperVariation_union (m : ScalarCharge Ω) (A B : MeasSet Ω) (hAB : Disjoint A.1 B.1) :
    m.upperVariation (A.union B) = m.upperVariation A + m.upperVariation B := by
  apply le_antisymm
  · apply m.upperVariation_le
    intro E hE
    have hu : (E.inter A).union (E.inter B) = E := by
      apply Subtype.ext
      change E.1 ∩ A.1 ∪ E.1 ∩ B.1 = E.1
      rw [← Set.inter_union_distrib_left, inter_eq_left.mpr (show E.1 ⊆ A.1 ∪ B.1 from hE)]
    have hd : Disjoint (E.inter A).1 (E.inter B).1 :=
      hAB.mono inter_subset_right inter_subset_right
    rw [← hu, m.add_union _ _ hd]
    exact add_le_add (m.val_le_upperVariation inter_subset_right)
      (m.val_le_upperVariation inter_subset_right)
  · have hsum (E F : MeasSet Ω) (hE : E.1 ⊆ A.1) (hF : F.1 ⊆ B.1) :
        m.val E + m.val F ≤ m.upperVariation (A.union B) := by
      rw [← m.add_union E F (hAB.mono hE hF)]
      exact m.val_le_upperVariation (union_subset_union hE hF)
    have hA (F : MeasSet Ω) (hF : F.1 ⊆ B.1) :
        m.upperVariation A ≤ m.upperVariation (A.union B) - m.val F :=
      m.upperVariation_le A _ fun E hE => le_sub_iff_add_le.mpr (hsum E F hE hF)
    have hB : m.upperVariation B ≤ m.upperVariation (A.union B) - m.upperVariation A :=
      m.upperVariation_le B _ fun F hF => by linarith [hA F hF]
    linarith

/-- The positive part of a bounded real charge. -/
noncomputable def positivePart (m : ScalarCharge Ω) : ScalarCharge Ω where
  val := m.upperVariation
  empty_eq := m.upperVariation_empty
  add_union := m.upperVariation_union
  bounded := by
    obtain ⟨C, hC⟩ := m.bounded
    refine ⟨C, fun A => ?_⟩
    rw [abs_of_nonneg (m.upperVariation_nonneg A)]
    exact m.upperVariation_le A C fun B _ => (le_abs_self _).trans (hC B)

def neg (m : ScalarCharge Ω) : ScalarCharge Ω where
  val E := -m.val E
  empty_eq := by rw [m.empty_eq, neg_zero]
  add_union A B hd := by rw [m.add_union A B hd, neg_add]
  bounded := by
    obtain ⟨C, hC⟩ := m.bounded
    exact ⟨C, fun E => by rw [abs_neg]; exact hC E⟩

/-- Jordan decomposition on the algebra of measurable sets. -/
theorem val_eq_positive_sub_negative (m : ScalarCharge Ω) (A : MeasSet Ω) :
    m.val A = m.positivePart.val A - m.neg.positivePart.val A := by
  change m.val A = m.upperVariation A - m.neg.upperVariation A
  have h : m.neg.upperVariation A = m.upperVariation A - m.val A := by
    apply le_antisymm
    · apply m.neg.upperVariation_le
      intro B hB
      have hb : m.val (A.diff B) ≤ m.upperVariation A :=
        m.val_le_upperVariation sdiff_subset
      change -m.val B ≤ m.upperVariation A - m.val A
      linarith [m.add_diff A B hB]
    · have hh : m.upperVariation A ≤ m.neg.upperVariation A + m.val A := by
        apply m.upperVariation_le
        intro B hB
        have hb := m.neg.val_le_upperVariation (B := A.diff B) (A := A) sdiff_subset
        change -m.val (A.diff B) ≤ m.neg.upperVariation A at hb
        linarith [m.add_diff A B hB]
      linarith
  linarith

open MeasureTheory
open scoped ENNReal

private noncomputable def outerCost (m : ScalarCharge Ω) (E : Set Ω) : ℝ≥0∞ := by
  classical
  exact if h : MeasurableSet E then ENNReal.ofReal (m.val ⟨E, h⟩) else ∞

@[simp] private theorem outerCost_measurable (m : ScalarCharge Ω) (E : MeasSet Ω) :
    m.outerCost E.1 = ENNReal.ofReal (m.val E) := by
  classical
  simp [outerCost, E.2]

private theorem outerCost_unmeasurable (m : ScalarCharge Ω) (E : Set Ω)
    (h : ¬MeasurableSet E) : m.outerCost E = ∞ := by
  classical
  simp [outerCost, h]

private noncomputable def outerEnvelope (m : ScalarCharge Ω) : OuterMeasure Ω :=
  OuterMeasure.ofFunction m.outerCost (by rw [show (∅ : Set Ω) = (MeasSet.empty : MeasSet Ω).1
    from rfl, outerCost_measurable, m.empty_eq, ENNReal.ofReal_zero])

private theorem outerEnvelope_le (m : ScalarCharge Ω) (E : MeasSet Ω) :
    m.outerEnvelope E.1 ≤ ENNReal.ofReal (m.val E) := by
  rw [← outerCost_measurable]
  exact OuterMeasure.ofFunction_le E.1

private theorem outerEnvelope_ne_top (m : ScalarCharge Ω) (E : Set Ω) :
    m.outerEnvelope E ≠ ∞ :=
  ((m.outerEnvelope.mono (subset_univ E)).trans_lt
    ((m.outerEnvelope_le MeasSet.whole).trans_lt ENNReal.ofReal_lt_top)).ne

/-- Measurable sets satisfy Carathéodory's criterion for the countable
cover envelope of a positive finitely additive charge. -/
private theorem outerEnvelope_caratheodory (m : ScalarCharge Ω) (hm : m.Positive)
    (E : MeasSet Ω) : m.outerEnvelope.IsCaratheodory E.1 := by
  apply (OuterMeasure.isCaratheodory_iff_le' _).mpr
  intro U
  conv_rhs => rw [outerEnvelope, OuterMeasure.ofFunction_apply]
  refine le_iInf fun C => le_iInf fun hC => ?_
  by_cases hc : ∀ n, MeasurableSet (C n)
  · let A (n : ℕ) : MeasSet Ω := ⟨C n, hc n⟩
    have hint : U ∩ E.1 ⊆ ⋃ n, ((A n).inter E).1 := by
      intro ω hw
      obtain ⟨n, hn⟩ := mem_iUnion.mp (hC hw.1)
      exact mem_iUnion.mpr ⟨n, hn, hw.2⟩
    have hdiff : U \ E.1 ⊆ ⋃ n, ((A n).diff E).1 := by
      intro ω hw
      obtain ⟨n, hn⟩ := mem_iUnion.mp (hC hw.1)
      exact mem_iUnion.mpr ⟨n, hn, hw.2⟩
    have hl : m.outerEnvelope (U ∩ E.1) ≤ ∑' n, m.outerCost ((A n).inter E).1 := by
      rw [outerEnvelope, OuterMeasure.ofFunction_apply]
      exact iInf_le_of_le _ (iInf_le _ hint)
    have hr : m.outerEnvelope (U \ E.1) ≤ ∑' n, m.outerCost ((A n).diff E).1 := by
      rw [outerEnvelope, OuterMeasure.ofFunction_apply]
      exact iInf_le_of_le _ (iInf_le _ hdiff)
    refine (add_le_add hl hr).trans_eq ?_
    rw [← tsum_add]
    apply tsum_congr
    intro n
    have he : m.val (A n) = m.val ((A n).inter E) + m.val ((A n).diff E) := by
      have hA : ((A n).inter E).union ((A n).diff E) = A n := by
        apply Subtype.ext
        ext ω
        change (ω ∈ C n ∧ ω ∈ E.1) ∨ (ω ∈ C n ∧ ω ∉ E.1) ↔ ω ∈ C n
        tauto
      exact (congrArg m.val hA.symm).trans (m.add_union ((A n).inter E) ((A n).diff E)
        (Set.disjoint_left.mpr fun _ h h' => h'.2 h.2))
    rw [outerCost_measurable, outerCost_measurable,
      show m.outerCost (C n) = ENNReal.ofReal (m.val (A n)) from outerCost_measurable m (A n),
      he, ENNReal.ofReal_add (hm _) (hm _)]
  · push Not at hc
    obtain ⟨n, hn⟩ := hc
    have htop : (∑' n, m.outerCost (C n)) = ∞ :=
      tsum_eq_top_of_eq_top ⟨n, m.outerCost_unmeasurable _ hn⟩
    rw [htop]
    exact le_top

/-- The countably additive envelope of a positive charge. -/
noncomputable def positiveEnvelope (m : ScalarCharge Ω) (hm : m.Positive) : ScalarCharge Ω where
  val E := (m.outerEnvelope E.1).toReal
  empty_eq := by
    change (m.outerEnvelope ∅).toReal = 0
    rw [show m.outerEnvelope (∅ : Set Ω) = 0 from m.outerEnvelope.empty, ENNReal.toReal_zero]
  add_union A B hd := by
    have hc := m.outerEnvelope_caratheodory hm A (A.1 ∪ B.1)
    have hi : (A.1 ∪ B.1) ∩ A.1 = A.1 := inter_eq_right.mpr subset_union_left
    have hs : (A.1 ∪ B.1) \ A.1 = B.1 := by
      ext x
      change ((x ∈ A.1 ∨ x ∈ B.1) ∧ x ∉ A.1) ↔ x ∈ B.1
      constructor
      · rintro ⟨h | h, ha⟩
        · exact (ha h).elim
        · exact h
      · intro hb
        exact ⟨Or.inr hb, fun ha => (Set.disjoint_left.mp hd ha) hb⟩
    change (m.outerEnvelope (A.1 ∪ B.1)).toReal =
      (m.outerEnvelope A.1).toReal + (m.outerEnvelope B.1).toReal
    rw [hc, hi, hs, ENNReal.toReal_add (m.outerEnvelope_ne_top _) (m.outerEnvelope_ne_top _)]
  bounded := by
    refine ⟨m.val MeasSet.whole, fun E => ?_⟩
    rw [abs_of_nonneg ENNReal.toReal_nonneg]
    have h := (ENNReal.toReal_le_toReal (m.outerEnvelope_ne_top E.1)
      (ENNReal.ofReal_lt_top.ne)).mpr (m.outerEnvelope_le E)
    rw [ENNReal.toReal_ofReal (hm E)] at h
    exact h.trans (m.val_mono hm (subset_univ E.1))

theorem positiveEnvelope_positive (m : ScalarCharge Ω) (hm : m.Positive) :
    (m.positiveEnvelope hm).Positive := fun _ => ENNReal.toReal_nonneg

theorem positiveEnvelope_le (m : ScalarCharge Ω) (hm : m.Positive) (E : MeasSet Ω) :
    (m.positiveEnvelope hm).val E ≤ m.val E := by
  change (m.outerEnvelope E.1).toReal ≤ m.val E
  rw [← ENNReal.toReal_ofReal (hm E)]
  exact (ENNReal.toReal_le_toReal (m.outerEnvelope_ne_top _) (ENNReal.ofReal_lt_top.ne)).mpr
    (m.outerEnvelope_le E)

theorem positiveEnvelope_countablyAdditive (m : ScalarCharge Ω) (hm : m.Positive) :
    (m.positiveEnvelope hm).CountablyAdditive := by
  intro A hA
  have h := m.outerEnvelope.f_iUnion (fun n => m.outerEnvelope_caratheodory hm (A n)) hA
  have hfinite : (∑' n, m.outerEnvelope (A n).1) ≠ ∞ := by
    rw [← h]
    exact m.outerEnvelope_ne_top _
  change HasSum (fun n => (m.outerEnvelope (A n).1).toReal)
    (m.outerEnvelope (⋃ n, (A n).1)).toReal
  rw [h]
  rw [ENNReal.tsum_toReal_eq (fun n => m.outerEnvelope_ne_top (A n).1)]
  exact ENNReal.hasSum_toReal hfinite

def add (m n : ScalarCharge Ω) : ScalarCharge Ω where
  val E := m.val E + n.val E
  empty_eq := by rw [m.empty_eq, n.empty_eq, add_zero]
  add_union A B hd := by rw [m.add_union A B hd, n.add_union A B hd]; ring
  bounded := by
    obtain ⟨C, hC⟩ := m.bounded
    obtain ⟨K, hK⟩ := n.bounded
    exact ⟨C + K, fun E => (abs_add_le _ _).trans (add_le_add (hC E) (hK E))⟩

def sub (m n : ScalarCharge Ω) : ScalarCharge Ω := m.add n.neg

theorem add_positive {m n : ScalarCharge Ω} (hm : m.Positive) (hn : n.Positive) :
    (m.add n).Positive := fun E => add_nonneg (hm E) (hn E)

theorem sub_positive_of_le {m n : ScalarCharge Ω} (h : ∀ E, n.val E ≤ m.val E) :
    (m.sub n).Positive := fun E => sub_nonneg.mpr (h E)

theorem add_countablyAdditive {m n : ScalarCharge Ω} (hm : m.CountablyAdditive)
    (hn : n.CountablyAdditive) : (m.add n).CountablyAdditive := fun E hE =>
  (hm E hE).add (hn E hE)

theorem sub_countablyAdditive {m n : ScalarCharge Ω} (hm : m.CountablyAdditive)
    (hn : n.CountablyAdditive) : (m.sub n).CountablyAdditive := fun E hE => by
  change HasSum (fun n' => m.val (E n') - n.val (E n'))
    (m.val (MeasSet.iUnion E) - n.val (MeasSet.iUnion E))
  exact (hm E hE).sub (hn E hE)

theorem finite_add (m : ScalarCharge Ω) (E : ℕ → MeasSet Ω) (hE : MeasSet.DisjointSeq E)
    (I : Finset ℕ) : m.val (MeasSet.finiteUnion E I) = ∑ n ∈ I, m.val (E n) :=
  MeasSet.finite_add_of_pair m.val m.empty_eq m.add_union E hE I

/-- Countable additivity passes to positive charges dominated by a
countably additive positive charge. -/
theorem countablyAdditive_of_le_positive {m n : ScalarCharge Ω} (hm : m.Positive)
    (h : ∀ E, m.val E ≤ n.val E) (hn : n.CountablyAdditive) : m.CountablyAdditive := by
  intro E hE
  let U := MeasSet.iUnion E
  let F (k : ℕ) := MeasSet.finiteUnion E (Finset.range k)
  have hsub (k : ℕ) : (F k).1 ⊆ U.1 := by
    intro ω hω
    obtain ⟨j, _, hj⟩ := mem_iUnion₂.mp hω
    exact mem_iUnion.mpr ⟨j, hj⟩
  have hsum : Summable (fun k => m.val (E k)) := by
    apply summable_of_sum_range_le (fun k => hm (E k)) (c := m.val U)
    intro k
    rw [← m.finite_add E hE]
    exact m.val_mono hm (hsub k)
  have ht : Tendsto (fun k => n.val (U.diff (F k))) atTop (𝓝 0) := by
    have hv : (fun k => n.val (U.diff (F k))) = fun k => n.val U - ∑ j ∈ Finset.range k, n.val (E j) := by
      funext k
      rw [← n.finite_add E hE, n.add_diff U (F k) (hsub k)]
      ring
    rw [hv]
    have hlim := tendsto_const_nhds (x := n.val U) |>.sub (hn E hE).tendsto_sum_nat
    simpa only [U, sub_self] using hlim
  have hmt : Tendsto (fun k => m.val (U.diff (F k))) atTop (𝓝 0) :=
    squeeze_zero (fun _ => hm _) (fun _ => h _) ht
  have hlim : Tendsto (fun k => ∑ j ∈ Finset.range k, m.val (E j)) atTop (𝓝 (m.val U)) := by
    have he : (fun k => ∑ j ∈ Finset.range k, m.val (E j)) =
        fun k => m.val U - m.val (U.diff (F k)) := by
      funext k
      rw [← m.finite_add E hE, m.add_diff U (F k) (hsub k)]
      ring
    rw [he]
    simpa only [sub_zero] using (tendsto_const_nhds (x := m.val U)).sub hmt
  exact (tendsto_nhds_unique hsum.hasSum.tendsto_sum_nat hlim) ▸ hsum.hasSum

theorem ext_val {m n : ScalarCharge Ω} (h : ∀ E, m.val E = n.val E) : m = n := by
  cases m
  cases n
  congr
  exact funext h

/-- The countably additive envelope is the greatest positive countably
additive charge dominated by the original charge. -/
theorem positiveEnvelope_greatest (m n : ScalarCharge Ω) (hm : m.Positive) (hn : n.Positive)
    (hca : n.CountablyAdditive) (hle : ∀ E, n.val E ≤ m.val E) (E : MeasSet Ω) :
    n.val E ≤ (m.positiveEnvelope hm).val E := by
  change n.val E ≤ (m.outerEnvelope E.1).toReal
  rw [← ENNReal.toReal_ofReal (hn E)]
  apply (ENNReal.toReal_le_toReal ENNReal.ofReal_lt_top.ne (m.outerEnvelope_ne_top _)).mpr
  rw [outerEnvelope, OuterMeasure.ofFunction_apply]
  refine le_iInf fun C => le_iInf fun hC => ?_
  by_cases hc : ∀ n, MeasurableSet (C n)
  · let D (k : ℕ) : MeasSet Ω := ⟨disjointed C k, MeasurableSet.disjointed hc k⟩
    let B (k : ℕ) : MeasSet Ω := E.inter (D k)
    have hB : MeasSet.DisjointSeq B := fun i j hij =>
      ((disjoint_disjointed C) hij).mono inter_subset_right inter_subset_right
    have hu : MeasSet.iUnion B = E := by
      apply Subtype.ext
      change (⋃ k, E.1 ∩ disjointed C k) = E.1
      rw [← inter_iUnion, iUnion_disjointed, inter_eq_left.mpr hC]
    have hs := hca B hB
    rw [hu] at hs
    rw [← hs.tsum_eq, ENNReal.ofReal_tsum_of_nonneg (fun k => hn (B k)) hs.summable]
    apply tsum_le_tsum
    intro k
    change ENNReal.ofReal (n.val (B k)) ≤ m.outerCost (C k)
    rw [show m.outerCost (C k) = ENNReal.ofReal (m.val ⟨C k, hc k⟩)
      from m.outerCost_measurable ⟨C k, hc k⟩]
    exact ENNReal.ofReal_le_ofReal ((hle (B k)).trans (m.val_mono hm
      (inter_subset_right.trans (disjointed_subset C k))))
  · push Not at hc
    obtain ⟨k, hk⟩ := hc
    rw [tsum_eq_top_of_eq_top (f := fun k => m.outerCost (C k))
      ⟨k, m.outerCost_unmeasurable _ hk⟩]
    exact le_top

theorem positiveEnvelope_eq_of_countablyAdditive (m : ScalarCharge Ω) (hm : m.Positive)
    (hc : m.CountablyAdditive) : m.positiveEnvelope hm = m :=
  ext_val fun E => le_antisymm (m.positiveEnvelope_le hm E)
    (m.positiveEnvelope_greatest m hm hm hc (fun _ => le_rfl) E)

/-- Additivity of the positive envelope. A dominated countably additive
charge splits into two positive countably additive charges by the
positive-part formula. -/
theorem positiveEnvelope_add (m n : ScalarCharge Ω) (hm : m.Positive) (hn : n.Positive) :
    (m.add n).positiveEnvelope (add_positive hm hn) =
      (m.positiveEnvelope hm).add (n.positiveEnvelope hn) := by
  let r := (m.add n).positiveEnvelope (add_positive hm hn)
  have hr : r.Positive := positiveEnvelope_positive _ _
  have hrc : r.CountablyAdditive := positiveEnvelope_countablyAdditive _ _
  let r₂ := (r.sub m).positivePart
  let r₁ := r.sub r₂
  have h₂ : r₂.Positive := fun E => upperVariation_nonneg _ E
  have h₂r (E : MeasSet Ω) : r₂.val E ≤ r.val E := by
    apply upperVariation_le
    intro F hF
    change r.val F - m.val F ≤ r.val E
    exact (sub_le_self _ (hm F)).trans (r.val_mono hr hF)
  have h₂n (E : MeasSet Ω) : r₂.val E ≤ n.val E := by
    apply upperVariation_le
    intro F hF
    have hh := (m.add n).positiveEnvelope_le (add_positive hm hn) F
    change r.val F ≤ m.val F + n.val F at hh
    change r.val F - m.val F ≤ n.val E
    exact (by linarith : r.val F - m.val F ≤ n.val F).trans (n.val_mono hn hF)
  have h₁ : r₁.Positive := sub_positive_of_le h₂r
  have h₁m (E : MeasSet Ω) : r₁.val E ≤ m.val E := by
    have hh := (r.sub m).val_le_upperVariation (B := E) (A := E) Subset.rfl
    change r.val E - m.val E ≤ r₂.val E at hh
    change r.val E - r₂.val E ≤ m.val E
    linarith
  have h₁c : r₁.CountablyAdditive :=
    countablyAdditive_of_le_positive h₁ (fun E => sub_le_self _ (h₂ E)) hrc
  have h₂c : r₂.CountablyAdditive := countablyAdditive_of_le_positive h₂ h₂r hrc
  apply ext_val
  intro E
  apply le_antisymm
  · have h₁' := m.positiveEnvelope_greatest r₁ hm h₁ h₁c h₁m E
    have h₂' := n.positiveEnvelope_greatest r₂ hn h₂ h₂c h₂n E
    change r.val E - r₂.val E ≤ (m.positiveEnvelope hm).val E at h₁'
    change r.val E ≤ (m.positiveEnvelope hm).val E + (n.positiveEnvelope hn).val E
    linarith
  · exact (m.add n).positiveEnvelope_greatest _ (add_positive hm hn)
      (add_positive (m.positiveEnvelope_positive hm) (n.positiveEnvelope_positive hn))
      (add_countablyAdditive (m.positiveEnvelope_countablyAdditive hm) (n.positiveEnvelope_countablyAdditive hn))
      (fun F => add_le_add (m.positiveEnvelope_le hm F) (n.positiveEnvelope_le hn F)) E

theorem positivePart_positive (m : ScalarCharge Ω) : m.positivePart.Positive :=
  m.upperVariation_nonneg

theorem positivePart_countablyAdditive (m : ScalarCharge Ω) (hm : m.CountablyAdditive) :
    m.positivePart.CountablyAdditive := by
  intro B hB
  let U := MeasSet.iUnion B
  let p := m.positivePart
  have hp : p.Positive := m.positivePart_positive
  have hsum : Summable (fun n => p.val (B n)) := by
    refine summable_of_sum_le (fun n => hp (B n)) (c := p.val U) fun I => ?_
    rw [← p.finite_add B hB]
    apply p.val_mono hp
    intro ω hω
    obtain ⟨n, _, hn⟩ := mem_iUnion₂.mp hω
    exact mem_iUnion.mpr ⟨n, hn⟩
  have hupper : p.val U ≤ ∑' n, p.val (B n) := by
    apply upperVariation_le
    intro A hA
    let E (n : ℕ) := A.inter (B n)
    have hE : MeasSet.DisjointSeq E := fun i j hij =>
      (hB hij).mono inter_subset_right inter_subset_right
    have hcover : MeasSet.iUnion E = A := by
      apply Subtype.ext
      change (⋃ n, A.1 ∩ (B n).1) = A.1
      rw [← inter_iUnion, inter_eq_left.mpr (show A.1 ⊆ ⋃ n, (B n).1 from hA)]
    have ha := hm E hE
    rw [hcover] at ha
    rw [← ha.tsum_eq]
    exact ha.summable.tsum_le_tsum (fun n => val_le_upperVariation m inter_subset_right) hsum
  have hlower : (∑' n, p.val (B n)) ≤ p.val U := by
    apply hsum.tsum_le_of_sum_le
    intro I
    rw [← p.finite_add B hB]
    apply p.val_mono hp
    intro ω hω
    obtain ⟨n, _, hn⟩ := mem_iUnion₂.mp hω
    exact mem_iUnion.mpr ⟨n, hn⟩
  exact (le_antisymm hlower hupper) ▸ hsum.hasSum

theorem neg_countablyAdditive (m : ScalarCharge Ω) (hm : m.CountablyAdditive) :
    m.neg.CountablyAdditive := fun A hA => (hm A hA).neg

def scale (a : ℝ) (m : ScalarCharge Ω) : ScalarCharge Ω where
  val E := a * m.val E
  empty_eq := by rw [m.empty_eq, mul_zero]
  add_union A B hd := by rw [m.add_union A B hd, mul_add]
  bounded := by
    obtain ⟨C, hC⟩ := m.bounded
    refine ⟨|a| * C, fun E => ?_⟩
    rw [abs_mul]
    exact mul_le_mul_of_nonneg_left (hC E) (abs_nonneg _)

theorem scale_positive {m : ScalarCharge Ω} (hm : m.Positive) {a : ℝ} (ha : 0 ≤ a) :
    (m.scale a).Positive := fun E => mul_nonneg ha (hm E)

theorem scale_countablyAdditive {m : ScalarCharge Ω} (hm : m.CountablyAdditive) (a : ℝ) :
    (m.scale a).CountablyAdditive := fun A hA => (hm A hA).mul_left a

theorem positiveEnvelope_scale (m : ScalarCharge Ω) (hm : m.Positive) (a : ℝ) (ha : 0 ≤ a) :
    (m.scale a).positiveEnvelope (scale_positive hm ha) =
      (m.positiveEnvelope hm).scale a := by
  let p := m.positiveEnvelope hm
  let r := (m.scale a).positiveEnvelope (scale_positive hm ha)
  have hp : p.Positive := m.positiveEnvelope_positive hm
  have hr : r.Positive := (m.scale a).positiveEnvelope_positive _
  have hpc : p.CountablyAdditive := m.positiveEnvelope_countablyAdditive hm
  have hrc : r.CountablyAdditive := (m.scale a).positiveEnvelope_countablyAdditive _
  apply ext_val
  intro E
  apply le_antisymm
  · change r.val E ≤ a * p.val E
    by_cases hzero : a = 0
    · have hr' := (m.scale a).positiveEnvelope_le (scale_positive hm ha) E
      change r.val E ≤ a * m.val E at hr'
      simpa only [hzero, zero_mul] using hr'
    · have hai : 0 ≤ a⁻¹ := inv_nonneg.mpr ha
      have hle (F : MeasSet Ω) : (r.scale a⁻¹).val F ≤ m.val F := by
        have h := mul_le_mul_of_nonneg_left
          ((m.scale a).positiveEnvelope_le (scale_positive hm ha) F) hai
        change a⁻¹ * r.val F ≤ a⁻¹ * (a * m.val F) at h
        rw [← mul_assoc, inv_mul_cancel₀ hzero, one_mul] at h
        exact h
      have h := m.positiveEnvelope_greatest (r.scale a⁻¹) hm (scale_positive hr hai)
        (scale_countablyAdditive hrc a⁻¹) hle E
      change a⁻¹ * r.val E ≤ p.val E at h
      have h' := mul_le_mul_of_nonneg_left h ha
      rwa [← mul_assoc, mul_inv_cancel₀ hzero, one_mul] at h'
  · exact (m.scale a).positiveEnvelope_greatest (p.scale a) (scale_positive hm ha)
      (scale_positive hp ha) (scale_countablyAdditive hpc a)
      (fun F => mul_le_mul_of_nonneg_left (m.positiveEnvelope_le hm F) ha) E

/-- The signed countably additive part in the Yosida–Hewitt decomposition. -/
noncomputable def countablyAdditivePart (m : ScalarCharge Ω) : ScalarCharge Ω :=
  (m.positivePart.positiveEnvelope m.positivePart_positive).sub
    (m.neg.positivePart.positiveEnvelope m.neg.positivePart_positive)

theorem countablyAdditivePart_countablyAdditive (m : ScalarCharge Ω) :
    m.countablyAdditivePart.CountablyAdditive :=
  sub_countablyAdditive (positiveEnvelope_countablyAdditive _ _) (positiveEnvelope_countablyAdditive _ _)

theorem countablyAdditivePart_eq_of_countablyAdditive (m : ScalarCharge Ω) (hm : m.CountablyAdditive) :
    m.countablyAdditivePart = m := by
  unfold countablyAdditivePart
  rw [m.positivePart.positiveEnvelope_eq_of_countablyAdditive _ (m.positivePart_countablyAdditive hm),
    m.neg.positivePart.positiveEnvelope_eq_of_countablyAdditive _
      (m.neg.positivePart_countablyAdditive (m.neg_countablyAdditive hm))]
  exact ext_val fun E => (m.val_eq_positive_sub_negative E).symm

theorem countablyAdditivePart_of_decomposition (m p q : ScalarCharge Ω)
    (hp : p.Positive) (hq : q.Positive) (h : ∀ E, m.val E = p.val E - q.val E) :
    m.countablyAdditivePart = (p.positiveEnvelope hp).sub (q.positiveEnvelope hq) := by
  have he : m.positivePart.add q = m.neg.positivePart.add p := by
    apply ext_val
    intro E
    change m.positivePart.val E + q.val E = m.neg.positivePart.val E + p.val E
    linarith [m.val_eq_positive_sub_negative E, h E]
  have hh : (m.positivePart.positiveEnvelope m.positivePart_positive).add (q.positiveEnvelope hq) =
      (m.neg.positivePart.positiveEnvelope m.neg.positivePart_positive).add (p.positiveEnvelope hp) := by
    rw [← positiveEnvelope_add, ← positiveEnvelope_add]
    congr 1
  apply ext_val
  intro E
  have hE := congrArg (fun m : ScalarCharge Ω => m.val E) hh
  change (m.positivePart.positiveEnvelope m.positivePart_positive).val E +
      (q.positiveEnvelope hq).val E =
    (m.neg.positivePart.positiveEnvelope m.neg.positivePart_positive).val E +
      (p.positiveEnvelope hp).val E at hE
  change (m.positivePart.positiveEnvelope m.positivePart_positive).val E -
      (m.neg.positivePart.positiveEnvelope m.neg.positivePart_positive).val E =
    (p.positiveEnvelope hp).val E - (q.positiveEnvelope hq).val E
  linarith

theorem countablyAdditivePart_add (m n : ScalarCharge Ω) :
    (m.add n).countablyAdditivePart = m.countablyAdditivePart.add n.countablyAdditivePart := by
  rw [countablyAdditivePart_of_decomposition (m.add n)
    (m.positivePart.add n.positivePart) (m.neg.positivePart.add n.neg.positivePart)
    (add_positive m.positivePart_positive n.positivePart_positive)
    (add_positive m.neg.positivePart_positive n.neg.positivePart_positive)]
  · rw [positiveEnvelope_add m.positivePart n.positivePart m.positivePart_positive n.positivePart_positive,
      positiveEnvelope_add m.neg.positivePart n.neg.positivePart
        m.neg.positivePart_positive n.neg.positivePart_positive]
    apply ext_val
    intro E
    simp only [countablyAdditivePart, ScalarCharge.sub, ScalarCharge.add, ScalarCharge.neg]
    ring
  · intro E
    change m.val E + n.val E = (m.positivePart.val E + n.positivePart.val E) -
      (m.neg.positivePart.val E + n.neg.positivePart.val E)
    linarith [m.val_eq_positive_sub_negative E, n.val_eq_positive_sub_negative E]

theorem countablyAdditivePart_scale (m : ScalarCharge Ω) (a : ℝ) :
    (m.scale a).countablyAdditivePart = m.countablyAdditivePart.scale a := by
  by_cases ha : 0 ≤ a
  · rw [countablyAdditivePart_of_decomposition (m.scale a) (m.positivePart.scale a)
      (m.neg.positivePart.scale a) (scale_positive m.positivePart_positive ha)
      (scale_positive m.neg.positivePart_positive ha)]
    · rw [positiveEnvelope_scale m.positivePart m.positivePart_positive a ha,
        positiveEnvelope_scale m.neg.positivePart m.neg.positivePart_positive a ha]
      apply ext_val
      intro E
      simp only [countablyAdditivePart, ScalarCharge.sub, ScalarCharge.add, ScalarCharge.neg, ScalarCharge.scale]
      ring
    · intro E
      change a * m.val E = a * m.positivePart.val E - a * m.neg.positivePart.val E
      rw [m.val_eq_positive_sub_negative, mul_sub]
  · have ha' : 0 ≤ -a := neg_nonneg.mpr (le_of_not_ge ha)
    rw [countablyAdditivePart_of_decomposition (m.scale a) (m.neg.positivePart.scale (-a))
      (m.positivePart.scale (-a)) (scale_positive m.neg.positivePart_positive ha')
      (scale_positive m.positivePart_positive ha')]
    · rw [positiveEnvelope_scale m.neg.positivePart m.neg.positivePart_positive (-a) ha',
        positiveEnvelope_scale m.positivePart m.positivePart_positive (-a) ha']
      apply ext_val
      intro E
      simp only [countablyAdditivePart, ScalarCharge.sub, ScalarCharge.add, ScalarCharge.neg, ScalarCharge.scale]
      ring
    · intro E
      change a * m.val E = (-a) * m.neg.positivePart.val E - (-a) * m.positivePart.val E
      rw [m.val_eq_positive_sub_negative]
      ring

def restrict (m : ScalarCharge Ω) (E : MeasSet Ω) : ScalarCharge Ω where
  val A := m.val (A.inter E)
  empty_eq := by
    rw [show (MeasSet.empty : MeasSet Ω).inter E = MeasSet.empty from Subtype.ext (empty_inter _),
      m.empty_eq]
  add_union A B hd := by
    have he : (A.union B).inter E = (A.inter E).union (B.inter E) :=
      Subtype.ext (Set.union_inter_distrib_right _ _ _)
    rw [he, m.add_union _ _ (hd.mono inter_subset_left inter_subset_left)]
  bounded := by
    obtain ⟨C, hC⟩ := m.bounded
    exact ⟨C, fun A => hC (A.inter E)⟩

theorem restrict_positive {m : ScalarCharge Ω} (hm : m.Positive) (E : MeasSet Ω) :
    (m.restrict E).Positive := fun A => hm (A.inter E)

theorem restrict_countablyAdditive {m : ScalarCharge Ω} (hm : m.CountablyAdditive) (E : MeasSet Ω) :
    (m.restrict E).CountablyAdditive := by
  intro B hB
  let C (n : ℕ) := (B n).inter E
  have hC : MeasSet.DisjointSeq C := fun i j hij =>
    (hB hij).mono inter_subset_left inter_subset_left
  have he : MeasSet.iUnion C = (MeasSet.iUnion B).inter E :=
    Subtype.ext (Set.iUnion_inter _ _).symm
  change HasSum (fun n => m.val (C n)) (m.val ((MeasSet.iUnion B).inter E))
  rw [← he]
  exact hm C hC

theorem positiveEnvelope_restrict (m : ScalarCharge Ω) (hm : m.Positive) (E : MeasSet Ω) :
    (m.restrict E).positiveEnvelope (restrict_positive hm E) =
      (m.positiveEnvelope hm).restrict E := by
  let p := m.positiveEnvelope hm
  let r := (m.restrict E).positiveEnvelope (restrict_positive hm E)
  have hrc : r.CountablyAdditive := (m.restrict E).positiveEnvelope_countablyAdditive _
  have hr : r.Positive := (m.restrict E).positiveEnvelope_positive _
  have hrE (A : MeasSet Ω) : r.val A ≤ m.val (A.inter E) :=
    (m.restrict E).positiveEnvelope_le _ A
  apply ext_val
  intro A
  apply le_antisymm
  · change r.val A ≤ p.val (A.inter E)
    have hz : r.val (A.diff E) = 0 := by
      have hh := hrE (A.diff E)
      have ha : (A.diff E).inter E = MeasSet.empty := by
        apply Subtype.ext
        ext ω
        change (ω ∈ A.1 \ E.1 ∩ E.1) ↔ ω ∈ (∅ : Set Ω)
        simp
      rw [ha, m.empty_eq] at hh
      exact le_antisymm hh (hr _)
    have he : A.diff (A.inter E) = A.diff E := by
      apply Subtype.ext
      ext ω
      change (ω ∈ A.1 \ (A.1 ∩ E.1)) ↔ ω ∈ A.1 \ E.1
      simp only [Set.mem_sdiff, mem_inter_iff]
      tauto
    rw [r.add_diff A (A.inter E) inter_subset_left, he, hz, add_zero]
    exact m.positiveEnvelope_greatest r hm hr hrc
      (fun B => (hrE B).trans (m.val_mono hm inter_subset_left)) (A.inter E)
  · exact (m.restrict E).positiveEnvelope_greatest (p.restrict E) (restrict_positive hm E)
      (restrict_positive (m.positiveEnvelope_positive hm) E)
      (restrict_countablyAdditive (m.positiveEnvelope_countablyAdditive hm) E)
      (fun B => m.positiveEnvelope_le hm (B.inter E)) A

theorem countablyAdditivePart_restrict (m : ScalarCharge Ω) (E : MeasSet Ω) :
    (m.restrict E).countablyAdditivePart = m.countablyAdditivePart.restrict E := by
  rw [countablyAdditivePart_of_decomposition (m.restrict E) (m.positivePart.restrict E)
    (m.neg.positivePart.restrict E) (restrict_positive m.positivePart_positive E)
    (restrict_positive m.neg.positivePart_positive E)]
  · rw [positiveEnvelope_restrict m.positivePart m.positivePart_positive E,
      positiveEnvelope_restrict m.neg.positivePart m.neg.positivePart_positive E]
    rfl
  · intro A
    exact m.val_eq_positive_sub_negative (A.inter E)

theorem abs_countablyAdditivePart_le (m : ScalarCharge Ω) (C : ℝ)
    (hC : ∀ A : MeasSet Ω, |m.val A| ≤ C) (E : MeasSet Ω) :
    |m.countablyAdditivePart.val E| ≤ 2 * C := by
  let p := m.positivePart.positiveEnvelope m.positivePart_positive
  let n := m.neg.positivePart.positiveEnvelope m.neg.positivePart_positive
  have hp : p.val E ≤ C :=
    (m.positivePart.positiveEnvelope_le _ E).trans
      (m.upperVariation_le E C fun B _ => (le_abs_self _).trans (hC B))
  have hn : n.val E ≤ C :=
    (m.neg.positivePart.positiveEnvelope_le _ E).trans
      (m.neg.upperVariation_le E C fun B _ => (neg_le_abs _).trans (hC B))
  have hp₀ : 0 ≤ p.val E := positiveEnvelope_positive _ _ E
  have hn₀ : 0 ≤ n.val E := positiveEnvelope_positive _ _ E
  change |p.val E - n.val E| ≤ 2 * C
  rw [abs_le]
  constructor <;> linarith

/-- Total variation on the whole space, expressed through the positive
and negative parts of a bounded real charge. -/
noncomputable def totalVariationMass (m : ScalarCharge Ω) : ℝ :=
  m.upperVariation MeasSet.whole + m.neg.upperVariation MeasSet.whole

theorem totalVariationMass_countablyAdditivePart_le (m : ScalarCharge Ω) :
    m.countablyAdditivePart.totalVariationMass ≤ m.totalVariationMass := by
  let p := m.positivePart
  let q := m.neg.positivePart
  let r := m.countablyAdditivePart
  have hp (E : MeasSet Ω) : r.val E ≤ p.val E := by
    change (p.positiveEnvelope m.positivePart_positive).val E -
      (q.positiveEnvelope m.neg.positivePart_positive).val E ≤ p.val E
    exact (sub_le_self _ (positiveEnvelope_positive _ _ E)).trans (p.positiveEnvelope_le _ E)
  have hq (E : MeasSet Ω) : r.neg.val E ≤ q.val E := by
    change -((p.positiveEnvelope m.positivePart_positive).val E -
      (q.positiveEnvelope m.neg.positivePart_positive).val E) ≤ q.val E
    rw [neg_sub]
    exact (sub_le_self _ (positiveEnvelope_positive _ _ E)).trans (q.positiveEnvelope_le _ E)
  exact add_le_add
    (r.upperVariation_le _ _ fun E hE => (hp E).trans (p.val_mono m.positivePart_positive hE))
    (r.neg.upperVariation_le _ _ fun E hE => (hq E).trans (q.val_mono m.neg.positivePart_positive hE))

private theorem caratheodory_le (m : ScalarCharge Ω) (hm : m.Positive) :
    (inferInstance : MeasurableSpace Ω) ≤ m.outerEnvelope.caratheodory :=
  fun E hE => m.outerEnvelope_caratheodory hm ⟨E, hE⟩

/-- A positive countably additive charge as a finite positive measure. -/
noncomputable def toMeasure (m : ScalarCharge Ω) (hm : m.Positive) : Measure Ω :=
  m.outerEnvelope.toMeasure (m.caratheodory_le hm)

theorem toMeasure_apply_charge (m : ScalarCharge Ω) (hm : m.Positive)
    (hc : m.CountablyAdditive) (E : MeasSet Ω) :
    m.toMeasure hm E.1 = ENNReal.ofReal (m.val E) := by
  rw [toMeasure, MeasureTheory.toMeasure_apply _ _ E.2]
  have he := congrArg (fun q : ScalarCharge Ω => q.val E) (m.positiveEnvelope_eq_of_countablyAdditive hm hc)
  change (m.outerEnvelope E.1).toReal = m.val E at he
  rw [← he, ENNReal.ofReal_toReal (m.outerEnvelope_ne_top _)]

instance finite_toMeasure (m : ScalarCharge Ω) (hm : m.Positive) :
    IsFiniteMeasure (m.toMeasure hm) := by
  apply (MeasureTheory.isFiniteMeasure_iff (m.toMeasure hm)).2
  rw [toMeasure, MeasureTheory.toMeasure_apply _ _ MeasurableSet.univ]
  exact lt_of_le_of_lt (m.outerEnvelope_le MeasSet.whole) ENNReal.ofReal_lt_top

/-- A measurable Hahn decomposition for the real coefficient charge. -/
theorem exists_hahn (m : ScalarCharge Ω) (hm : m.CountablyAdditive) :
    ∃ A : MeasSet Ω, (∀ E : MeasSet Ω, E.1 ⊆ A.1 → 0 ≤ m.val E) ∧
      (∀ E : MeasSet Ω, E.1 ⊆ A.1ᶜ → m.val E ≤ 0) := by
  let p := m.positivePart
  let n := m.neg.positivePart
  have hp := m.positivePart_positive
  have hn := m.neg.positivePart_positive
  have hpc := m.positivePart_countablyAdditive hm
  have hnc := m.neg.positivePart_countablyAdditive (m.neg_countablyAdditive hm)
  obtain ⟨A, hA⟩ := exists_isHahnDecomposition (n.toMeasure hn) (p.toMeasure hp)
  refine ⟨⟨A, hA.measurableSet⟩, ?_, ?_⟩
  · intro E hE
    have he := Measure.le_iff.mp hA.le_on E.1 E.2
    rw [Measure.restrict_apply E.2, Measure.restrict_apply E.2,
      inter_eq_left.mpr (show E.1 ⊆ A from hE), n.toMeasure_apply_charge hn hnc E,
      p.toMeasure_apply_charge hp hpc E] at he
    have hb := (ENNReal.ofReal_le_ofReal_iff (hp E)).mp he
    rw [m.val_eq_positive_sub_negative]
    exact sub_nonneg.mpr hb
  · intro E hE
    have he := Measure.le_iff.mp hA.ge_on_compl E.1 E.2
    rw [Measure.restrict_apply E.2, Measure.restrict_apply E.2,
      inter_eq_left.mpr (show E.1 ⊆ Aᶜ from hE), n.toMeasure_apply_charge hn hnc E,
      p.toMeasure_apply_charge hp hpc E] at he
    have hb := (ENNReal.ofReal_le_ofReal_iff (hn E)).mp he
    rw [m.val_eq_positive_sub_negative]
    exact sub_nonpos.mpr hb

/-- The scalar Radon–Nikodym step, expressed through the two positive
densities of a bounded real charge. -/
theorem exists_rnDensities (m : ScalarCharge Ω) (hm : m.CountablyAdditive) (ρ : Measure Ω)
    [IsFiniteMeasure ρ] (hnull : ∀ E : MeasSet Ω, ρ E.1 = 0 → m.val E = 0) :
    ∃ a b : Ω → ℝ≥0∞, Measurable a ∧ Measurable b ∧
      (∀ E : MeasSet Ω, (∫⁻ t in E.1, a t ∂ρ) ≠ ∞ ∧ (∫⁻ t in E.1, b t ∂ρ) ≠ ∞) ∧
      ∀ E : MeasSet Ω, m.val E =
        (∫⁻ t in E.1, a t ∂ρ).toReal - (∫⁻ t in E.1, b t ∂ρ).toReal := by
  let p := m.positivePart
  let q := m.neg.positivePart
  have hp : p.Positive := m.positivePart_positive
  have hq : q.Positive := m.neg.positivePart_positive
  have hpc : p.CountablyAdditive := m.positivePart_countablyAdditive hm
  have hqc : q.CountablyAdditive := m.neg.positivePart_countablyAdditive (m.neg_countablyAdditive hm)
  let P := p.toMeasure hp
  let Q := q.toMeasure hq
  let _ : IsFiniteMeasure P := finite_toMeasure p hp
  let _ : IsFiniteMeasure Q := finite_toMeasure q hq
  have hpnull : P ≪ ρ := by
    apply Measure.AbsolutelyContinuous.mk
    intro E hE hρ
    let A : MeasSet Ω := ⟨E, hE⟩
    change p.toMeasure hp A.1 = 0
    rw [p.toMeasure_apply_charge hp hpc A, ENNReal.ofReal_eq_zero]
    apply m.upperVariation_le
    intro B hB
    exact (hnull B (measure_mono_null hB hρ)).le
  have hqnull : Q ≪ ρ := by
    apply Measure.AbsolutelyContinuous.mk
    intro E hE hρ
    let A : MeasSet Ω := ⟨E, hE⟩
    change q.toMeasure hq A.1 = 0
    rw [q.toMeasure_apply_charge hq hqc A, ENNReal.ofReal_eq_zero]
    apply m.neg.upperVariation_le
    intro B hB
    change -m.val B ≤ 0
    rw [hnull B (measure_mono_null hB hρ), neg_zero]
  let a := P.rnDeriv ρ
  let b := Q.rnDeriv ρ
  have ha (E : MeasSet Ω) : (∫⁻ t in E.1, a t ∂ρ) = P E.1 := by
    rw [← withDensity_apply a E.2]
    exact congrArg (fun r : Measure Ω => r E.1) (P.withDensity_rnDeriv_eq ρ hpnull)
  have hb (E : MeasSet Ω) : (∫⁻ t in E.1, b t ∂ρ) = Q E.1 := by
    rw [← withDensity_apply b E.2]
    exact congrArg (fun r : Measure Ω => r E.1) (Q.withDensity_rnDeriv_eq ρ hqnull)
  refine ⟨a, b, P.measurable_rnDeriv ρ, Q.measurable_rnDeriv ρ, fun E => ?_, fun E => ?_⟩
  · rw [ha E, hb E]
    exact ⟨(measure_lt_top P _).ne, (measure_lt_top Q _).ne⟩
  · rw [ha E, hb E]
    change m.val E = (p.toMeasure hp E.1).toReal - (q.toMeasure hq E.1).toReal
    rw [p.toMeasure_apply_charge hp hpc E, q.toMeasure_apply_charge hq hqc E,
      ENNReal.toReal_ofReal (hp E), ENNReal.toReal_ofReal (hq E)]
    exact m.val_eq_positive_sub_negative E

/-- A real integrable Radon–Nikodym derivative for the signed charge. -/
theorem exists_rnDensity (m : ScalarCharge Ω) (hm : m.CountablyAdditive) (ρ : Measure Ω)
    [IsFiniteMeasure ρ] (hnull : ∀ E : MeasSet Ω, ρ E.1 = 0 → m.val E = 0) :
    ∃ h : Ω → ℝ, Measurable h ∧ Integrable h ρ ∧
      ∀ E : MeasSet Ω, m.val E = ∫ t in E.1, h t ∂ρ := by
  obtain ⟨a, b, ha, hb, hfin, hval⟩ := m.exists_rnDensities hm ρ hnull
  let p (t : Ω) := (a t).toReal
  let q (t : Ω) := (b t).toReal
  have ha0 : (∫⁻ t, a t ∂ρ) ≠ ∞ := by
    have h := (hfin MeasSet.whole).1
    change (∫⁻ t in (Set.univ : Set Ω), a t ∂ρ) ≠ ∞ at h
    simpa only [Measure.restrict_univ] using h
  have hb0 : (∫⁻ t, b t ∂ρ) ≠ ∞ := by
    have h := (hfin MeasSet.whole).2
    change (∫⁻ t in (Set.univ : Set Ω), b t ∂ρ) ≠ ∞ at h
    simpa only [Measure.restrict_univ] using h
  have hp : Integrable p ρ := integrable_toReal_of_lintegral_ne_top ha.aemeasurable ha0
  have hq : Integrable q ρ := integrable_toReal_of_lintegral_ne_top hb.aemeasurable hb0
  refine ⟨fun t => p t - q t, ha.ennreal_toReal.sub hb.ennreal_toReal, hp.sub hq, fun E => ?_⟩
  rw [integral_sub hp.restrict hq.restrict]
  have hpa : (∫ t in E.1, p t ∂ρ) = (∫⁻ t in E.1, a t ∂ρ).toReal :=
    integral_toReal ha.aemeasurable (ae_restrict_le (ae_lt_top ha ha0))
  have hqb : (∫ t in E.1, q t ∂ρ) = (∫⁻ t in E.1, b t ∂ρ).toReal :=
    integral_toReal hb.aemeasurable (ae_restrict_le (ae_lt_top hb hb0))
  rw [hpa, hqb]
  exact hval E

end ScalarCharge


section VitaliHahnSaks

open MeasureTheory
open scoped ENNReal

/-- The variation of a countably additive signed coefficient, obtained
from its two Jordan parts. -/
noncomputable def ScalarCharge.variationMeasure (ν : ScalarCharge Ω) : Measure Ω :=
  ν.positivePart.toMeasure ν.positivePart_positive +
    ν.neg.positivePart.toMeasure ν.neg.positivePart_positive

instance ScalarCharge.finite_variationMeasure (ν : ScalarCharge Ω) :
    IsFiniteMeasure ν.variationMeasure := by
  unfold ScalarCharge.variationMeasure
  infer_instance

theorem ScalarCharge.variationMeasure_apply (ν : ScalarCharge Ω)
    (hν : ν.CountablyAdditive) (E : MeasSet Ω) :
    ν.variationMeasure E.1 = ENNReal.ofReal
      (ν.positivePart.val E + ν.neg.positivePart.val E) := by
  rw [ScalarCharge.variationMeasure, add_apply,
    ν.positivePart.toMeasure_apply_charge ν.positivePart_positive
      (ν.positivePart_countablyAdditive hν) E,
    ν.neg.positivePart.toMeasure_apply_charge ν.neg.positivePart_positive
      (ν.neg.positivePart_countablyAdditive (ν.neg_countablyAdditive hν)) E,
    ENNReal.ofReal_add (ν.positivePart_positive E) (ν.neg.positivePart_positive E)]

/-- The control measure in the proof of lem:normal-restriction. -/
noncomputable def ScalarCharge.sequenceControl (ν : ℕ → ScalarCharge Ω) : Measure Ω :=
  Measure.sum fun n => ENNReal.ofReal
    ((1 / 2 : ℝ) ^ (n + 1) / (1 + ((ν n).variationMeasure univ).toReal)) •
      (ν n).variationMeasure

theorem ScalarCharge.sequenceControl_univ_le_one (ν : ℕ → ScalarCharge Ω) :
    ScalarCharge.sequenceControl ν univ ≤ 1 := by
  let w (n : ℕ) : ℝ := (1 / 2) ^ (n + 1)
  have hw (n : ℕ) : 0 ≤ w n := by dsimp [w]; positivity
  have hsum : HasSum w 1 := by
    have h := (hasSum_geometric_of_abs_lt_one (r := (1 / 2 : ℝ)) (by norm_num)).mul_right
      (1 / 2 : ℝ)
    simpa only [w, pow_succ] using (show HasSum (fun n : ℕ => (1 / 2 : ℝ)^n * (1 / 2))
      1 from by convert h using 1; norm_num)
  have hterm (n : ℕ) :
      (ENNReal.ofReal (w n / (1 + ((ν n).variationMeasure univ).toReal)) •
        (ν n).variationMeasure : Measure Ω) univ ≤ ENNReal.ofReal (w n) := by
    let t := (ν n).variationMeasure univ
    have ht : t ≠ ⊤ := (measure_lt_top _ _).ne
    have ht₀ : 0 ≤ t.toReal := ENNReal.toReal_nonneg
    have hdenom : 0 < 1 + t.toReal := by positivity
    have hnum : 0 ≤ w n / (1 + t.toReal) := div_nonneg (hw n) hdenom.le
    have hle : w n / (1 + t.toReal) * t.toReal ≤ w n := by
      calc
        _ ≤ w n / (1 + t.toReal) * (1 + t.toReal) :=
          mul_le_mul_of_nonneg_left (by linarith) hnum
        _ = w n := div_mul_cancel₀ _ hdenom.ne'
    rw [smul_apply, smul_eq_mul]
    change ENNReal.ofReal (w n / (1 + t.toReal)) * t ≤ _
    calc
      _ = ENNReal.ofReal (w n / (1 + t.toReal)) * ENNReal.ofReal t.toReal :=
        congrArg (fun r => ENNReal.ofReal (w n / (1 + t.toReal)) * r)
          (ENNReal.ofReal_toReal ht).symm
      _ = ENNReal.ofReal (w n / (1 + t.toReal) * t.toReal) :=
        (ENNReal.ofReal_mul hnum).symm
      _ ≤ ENNReal.ofReal (w n) := ENNReal.ofReal_le_ofReal hle
  unfold ScalarCharge.sequenceControl
  rw [Measure.sum_apply _ MeasurableSet.univ]
  refine (tsum_le_tsum hterm).trans ?_
  rw [← ENNReal.ofReal_tsum_of_nonneg hw hsum.summable, hsum.tsum_eq, ENNReal.ofReal_one]

instance ScalarCharge.finite_sequenceControl (ν : ℕ → ScalarCharge Ω) :
    IsFiniteMeasure (ScalarCharge.sequenceControl ν) :=
  ⟨(ScalarCharge.sequenceControl_univ_le_one ν).trans_lt ENNReal.one_lt_top⟩

theorem ScalarCharge.variationMeasure_absolutelyContinuous_sequenceControl
    (ν : ℕ → ScalarCharge Ω) (n : ℕ) :
    (ν n).variationMeasure ≪ ScalarCharge.sequenceControl ν := by
  intro E hE
  let c := ENNReal.ofReal ((1 / 2 : ℝ) ^ (n + 1) /
    (1 + ((ν n).variationMeasure univ).toReal))
  have hc : c ≠ 0 := ne_of_gt (ENNReal.ofReal_pos.mpr (by positivity))
  have hb : (c • (ν n).variationMeasure : Measure Ω) ≤ ScalarCharge.sequenceControl ν :=
    Measure.le_sum
      (fun i : ℕ => ENNReal.ofReal ((1 / 2 : ℝ) ^ (i + 1) /
        (1 + ((ν i).variationMeasure univ).toReal)) • (ν i).variationMeasure) n
  have h0 : (c • (ν n).variationMeasure : Measure Ω) E = 0 :=
    le_antisymm ((hb E).trans hE.le) bot_le
  rw [smul_apply, smul_eq_mul] at h0
  exact (mul_eq_zero.mp h0).resolve_left hc

/-- Diestel–Uhl, *Vector Measures*, Chapter I. The scalar Vitali–Hahn–Saks
theorem in its finite-control-measure form, applied to real signed measures. -/
axiom citeVitaliHahnSaks1977 (ρ : Measure Ω) [IsFiniteMeasure ρ]
    (ν : ℕ → ScalarCharge Ω) (hν : ∀ n, (ν n).CountablyAdditive)
    (hAC : ∀ n, (ν n).variationMeasure ≪ ρ) (g : MeasSet Ω → ℝ)
    (hg : ∀ E, Tendsto (fun n => (ν n).val E) atTop (𝓝 (g E))) :
    ∀ B : ℕ → MeasSet Ω, MeasSet.DisjointSeq B → HasSum (fun n => g (B n)) (g (MeasSet.iUnion B))

/-- The actual orbit coefficient of a vector. No uniform bound on the
whole operator family is needed here. -/
noncomputable def OVM.orbitCharge (μ : OVM Ω X) (x : X) (f : Dual X) :
    ScalarCharge Ω where
  val E := f (μ.val E x)
  empty_eq := by simp [μ.empty_eq]
  add_union E F h := by rw [μ.apply_union E F h, map_add]
  bounded := by
    obtain ⟨C, hC⟩ := μ.orbit_norm_bounded x
    exact ⟨‖f‖ * C, fun E => (by
      rw [← Real.norm_eq_abs]
      exact (f.le_opNorm _).trans (mul_le_mul_of_nonneg_left (hC E) (norm_nonneg f)))⟩

/-- Manuscript, lem:normal-restriction. Pointwise limits of the scalar
coefficients are countably additive by Vitali–Hahn–Saks, with the explicit
finite dominating measure constructed in the manuscript. -/
theorem OVM.normal_of_baireOne (μ : OVM Ω X) (ξ : Bidual X) (hξ : BaireOne ξ) :
    μ.Normal ξ := by
  obtain ⟨x, hx⟩ := hξ
  intro B hB f
  let ν (n : ℕ) := μ.orbitCharge (x n) f
  have hν (n : ℕ) : (ν n).CountablyAdditive :=
    fun E hE => μ.normal_J (x n) E hE f
  let ρ := ScalarCharge.sequenceControl ν
  exact citeVitaliHahnSaks1977 ρ ν hν
    (ScalarCharge.variationMeasure_absolutelyContinuous_sequenceControl ν)
    (fun E => ξ (adjoint (μ.val E) f))
    (fun E => hx (adjoint (μ.val E) f)) B hB

#print axioms ScalarCharge.variationMeasure_apply
#print axioms ScalarCharge.sequenceControl_univ_le_one
#print axioms ScalarCharge.variationMeasure_absolutelyContinuous_sequenceControl

end VitaliHahnSaks


theorem eq_of_dual_eval {x y : X} (h : ∀ f : Dual X, f x = f y) : x = y := by
  by_contra hne
  have hn : ‖x - y‖ ≠ 0 := fun hz => hne (sub_eq_zero.mp (norm_eq_zero.mp hz))
  obtain ⟨f, _, hf⟩ := exists_dual_vector ℝ (x - y) hn
  apply hn
  calc
    ‖x - y‖ = f (x - y) := hf.symm
    _ = 0 := by rw [map_sub, h f, sub_self]

theorem secondAdjoint_subtype_injective (Y : Submodule ℝ X) :
    Function.Injective (secondAdjoint Y.subtypeL) := by
  intro η₁ η₂ h
  ext f
  obtain ⟨g, hg, _⟩ := exists_extension_norm_eq Y f
  have he : adjoint Y.subtypeL g = f := by ext y; exact hg y
  have ht := congrArg (fun ξ : Bidual X => ξ g) h
  simpa only [secondAdjoint_apply, he] using ht

theorem secondAdjoint_canonical (T : X →L[ℝ] Z) (x : X) :
    secondAdjoint T (J x) = J (T x) := by
  ext f
  rfl

theorem secondAdjoint_subtype_J_mem (Y : Submodule ℝ X) (hY : IsClosed (Y : Set X))
    (η : Bidual Y) {x : X} (h : secondAdjoint Y.subtypeL η = J x) : x ∈ Y := by
  let _ : IsClosed (Y : Set X) := hY
  apply (Submodule.Quotient.mk_eq_zero Y).mp
  apply eq_of_dual_eval
  intro f
  have hz : adjoint Y.subtypeL (adjoint Y.mkQL f) = 0 := by
    ext y
    change f (Submodule.Quotient.mk (y : X)) = 0
    rw [(Submodule.Quotient.mk_eq_zero Y).mpr y.2, map_zero]
  have he := congrArg (fun ξ : Bidual X => ξ (adjoint Y.mkQL f)) h
  rw [secondAdjoint_apply, hz, map_zero] at he
  exact he.symm.trans (map_zero f).symm

/-- Manuscript, prop:normal-coverage: localization descends to a closed
invariant subspace. -/
theorem PVM.localizes_restrict (P : PVM Ω X) (Y : Submodule ℝ X)
    (hY : IsClosed (Y : Set X)) (hInv : P.Invariant Y) (hP : P.Localizes) :
    (P.restrict Y hInv).Localizes := by
  intro η hη
  let ξ := secondAdjoint Y.subtypeL η
  obtain ⟨A, hmono, hcover, hcut⟩ := hP ξ ((P.normal_restrict_iff Y hInv η).mp hη)
  refine ⟨A, hmono, hcover, fun n => ?_⟩
  obtain ⟨x, hx⟩ := hcut n
  let θ := secondAdjoint ((P.restrict Y hInv).val (A n)) η
  have he : secondAdjoint Y.subtypeL θ = J x := by
    ext f
    have hf : adjoint ((P.restrict Y hInv).val (A n)) (adjoint Y.subtypeL f) =
        adjoint Y.subtypeL (adjoint (P.val (A n)) f) := by ext y; rfl
    change η (adjoint ((P.restrict Y hInv).val (A n)) (adjoint Y.subtypeL f)) = f x
    rw [hf]
    exact hx f
  let y : Y := ⟨x, secondAdjoint_subtype_J_mem Y hY θ he⟩
  have he' : θ = J y := secondAdjoint_subtype_injective Y
    (he.trans (secondAdjoint_canonical Y.subtypeL y).symm)
  exact ⟨y, fun f => congrArg (fun ξ : Bidual Y => ξ f) he'⟩

/-- The Orlicz–Pettis argument used in §2–3. All subseries weakly
converge, so a Baire cylinder gives small finite subsums on the tail. -/
theorem hasSum_of_weak_subseries [CompleteSpace X] (u : ℕ → X) (F : (ℕ → Bool) → X)
    (h : ∀ (b : ℕ → Bool) (f : Dual X), HasSum (fun n => if b n then f (u n) else 0) (f (F b))) :
    HasSum u (F (fun _ => true)) := by
  classical
  let Y := (Submodule.span ℝ (Set.range u)).topologicalClosure
  let _ : IsClosed (Y : Set X) := Submodule.isClosed_topologicalClosure _
  have huY (n : ℕ) : u n ∈ Y := subset_closure (Submodule.subset_span ⟨n, rfl⟩)
  have hFY (b : ℕ → Bool) : F b ∈ Y := by
    apply (Submodule.Quotient.mk_eq_zero Y).mp
    apply eq_of_dual_eval
    intro f
    let g := adjoint Y.mkQL f
    have hg (n : ℕ) : g (u n) = 0 := by
      change f (Submodule.Quotient.mk (u n)) = 0
      rw [(Submodule.Quotient.mk_eq_zero Y).mpr (huY n), map_zero]
    have hh := h b g
    have he : (fun n => if b n then g (u n) else 0) = fun _ : ℕ => (0 : ℝ) := by
      funext n
      simp [hg]
    rw [he] at hh
    exact hh.unique (by simp)
  have hs : TopologicalSpace.IsSeparable (Y : Set X) :=
    (Set.countable_range u).isSeparable.span.closure
  let _ : TopologicalSpace.SeparableSpace Y := hs.separableSpace
  let c (k : ℕ) : X := (TopologicalSpace.denseSeq Y k : X)
  have hcont (f : Dual X) : Continuous (fun b => f (F b)) := by
    have hf : Summable (fun n => |f (u n)|) := by simpa using (h (fun _ => true) f).summable.abs
    have he : (fun b => f (F b)) = maskedSum (fun n => f (u n)) := by
      funext b
      exact (h b f).unique (hasSum_masked _ hf b)
    rw [he]
    exact continuous_maskedSum _ hf
  have hsum : Summable u := by
    refine summable_iff_vanishing.mpr fun U hU => ?_
    obtain ⟨ε, hε, hεU⟩ := Metric.mem_nhds_iff.mp hU
    let δ := ε / 3
    have hδ : 0 < δ := by dsimp [δ]; linarith
    let C (k : ℕ) : Set (ℕ → Bool) := {b | ‖F b - c k‖ ≤ δ}
    have hclosed (k : ℕ) : IsClosed (C k) := by
      have he : C k = ⋂ f : Dual X, {b | |f (F b) - f (c k)| ≤ δ * ‖f‖} := by
        ext b
        simp only [C, mem_ofPred_eq, mem_iInter, ← map_sub]
        constructor
        · intro hb f
          exact (f.le_opNorm _).trans
            (by rw [mul_comm δ]; exact mul_le_mul_of_nonneg_left hb (norm_nonneg f))
        · intro hb
          by_cases hn : ‖F b - c k‖ = 0
          · rw [hn]; exact hδ.le
          · obtain ⟨f, hf, hfval⟩ := exists_dual_vector ℝ (F b - c k) hn
            have hh := hb f
            change f (F b - c k) = ‖F b - c k‖ at hfval
            simpa only [hfval, abs_of_nonneg (norm_nonneg (F b - c k)), hf, mul_one] using hh
      rw [he]
      exact isClosed_iInter fun f =>
        isClosed_le ((hcont f).sub continuous_const).abs continuous_const
    have hcover : ⋃ k, C k = Set.univ := by
      apply Set.eq_univ_of_forall
      intro b
      let y : Y := ⟨F b, hFY b⟩
      have hd := TopologicalSpace.denseRange_denseSeq Y y
      obtain ⟨_, ⟨k, rfl⟩, hdist⟩ := Metric.mem_closure_iff.mp hd δ hδ
      change dist (F b) (c k) < δ at hdist
      rw [dist_eq_norm] at hdist
      exact mem_iUnion.mpr ⟨k, hdist.le⟩
    obtain ⟨k, b, hb⟩ := nonempty_interior_of_iUnion_of_closed hclosed hcover
    obtain ⟨I, hI⟩ := exists_finite_mask_cylinder (mem_interior_iff_mem_nhds.mp hb)
    refine ⟨I, fun J hJ => hεU ?_⟩
    let b₀ (n : ℕ) : Bool := if n ∈ I then b n else false
    let e (n : ℕ) : Bool := if n ∈ I then b n else decide (n ∈ J)
    have hb₀ : b₀ ∈ C k := hI b₀ (fun n hn => ite_eq_left hn)
    have he : e ∈ C k := hI e (fun n hn => ite_eq_left hn)
    have hsum_eq : (∑ n ∈ J, u n) = F e - F b₀ := by
      apply eq_of_dual_eval
      intro f
      rw [map_sum, map_sub]
      have hh := (h e f).sub (h b₀ f)
      have hfn : (fun n => (if e n then f (u n) else 0) - (if b₀ n then f (u n) else 0)) =
          fun n => if n ∈ J then f (u n) else 0 := by
        funext n
        by_cases hn : n ∈ I
        · have hnJ : n ∉ J := fun hm => (Finset.disjoint_left.mp hJ) hm hn
          simp [e, b₀, hn, hnJ]
        · by_cases hnJ : n ∈ J <;> simp [e, b₀, hn, hnJ]
      rw [hfn] at hh
      have hp : HasSum (fun n => if n ∈ J then f (u n) else 0) (∑ n ∈ J, f (u n)) := by
        have hh' : (∑ n ∈ J, if n ∈ J then f (u n) else 0) = ∑ n ∈ J, f (u n) :=
          Finset.sum_congr rfl fun n hn => ite_eq_left hn
        rw [← hh']
        exact hasSum_sum_of_ne_finset_zero fun n hn => ite_eq_right hn
      exact hp.unique hh
    rw [Metric.mem_ball, dist_zero_right, hsum_eq]
    calc
      ‖F e - F b₀‖ = ‖(F e - c k) - (F b₀ - c k)‖ := by
        rw [sub_sub_sub_cancel_right]
      _ ≤ ‖F e - c k‖ + ‖F b₀ - c k‖ := norm_sub_le _ _
      _ ≤ δ + δ := add_le_add he hb₀
      _ < ε := by dsimp [δ]; linarith
  have he : (∑' n, u n) = F (fun _ => true) := by
    apply eq_of_dual_eval
    intro f
    have hm := hsum.hasSum.map f f.continuous
    have hh : HasSum (fun n => f (u n)) (f (F (fun _ => true))) := by
      have hh := h (fun _ => true) f
      have hfn : (fun n => if (true : Bool) then f (u n) else 0) = fun n => f (u n) := by
        funext n
        rfl
      rw [hfn] at hh
      exact hh
    exact hm.unique hh
  exact he ▸ hsum.hasSum

/-- Manuscript, Theorem 3.4 (1): shrinking is equivalent to normality of
the whole bidual. This implication uses Orlicz–Pettis on each adjoint orbit. -/
theorem OVM.shrinking_iff_all_normal (μ : OVM Ω X) :
    μ.Shrinking ↔ ∀ ξ : Bidual X, μ.Normal ξ := by
  constructor
  · exact μ.normal_of_shrinking
  · intro hn B hB f
    let D (b : ℕ → Bool) (n : ℕ) := if b n then B n else MeasSet.empty
    have hD (b : ℕ → Bool) : MeasSet.DisjointSeq (D b) := by
      intro i j hij
      cases hi : b i <;> cases hj : b j <;> simp [D, hi, hj, MeasSet.empty]
      exact hB hij
    let u (n : ℕ) := adjoint (μ.val (B n)) f
    let F (b : ℕ → Bool) := adjoint (μ.val (MeasSet.iUnion (D b))) f
    have hh (b : ℕ → Bool) (ξ : Bidual X) :
        HasSum (fun n => if b n then ξ (u n) else 0) (ξ (F b)) := by
      have he (n : ℕ) : ξ (adjoint (μ.val (D b n)) f) = if b n then ξ (u n) else 0 := by
        cases hb : b n <;> simp [D, hb, u, μ.empty_eq, adjoint]
      simpa only [he] using hn ξ (D b) (hD b) f
    simpa [u, F, D] using hasSum_of_weak_subseries u F hh

/-- Manuscript, prop:normal-coverage, final implication
\(\mathcal N_P\subseteq B_1(X)\) under localization. -/
theorem PVM.baireOne_of_localizes (P : PVM Ω X) (hP : P.Localizes)
    {ξ : Bidual X} (hξ : P.toOVM.Normal ξ) : BaireOne ξ := by
  obtain ⟨A, hA, hcover, hx⟩ := hP ξ hξ
  choose x hx using hx
  let B (n : ℕ) : MeasSet Ω :=
    ⟨disjointed (fun k => (A k).1) n, MeasurableSet.disjointed (fun k => (A k).2) n⟩
  have hB : MeasSet.DisjointSeq B := disjoint_disjointed _
  have hBcover : MeasSet.iUnion B = MeasSet.whole := by
    rw [← hcover]
    exact Subtype.ext iUnion_disjointed
  have hpartial (f : Dual X) (N : ℕ) :
      (∑ n ∈ Finset.range (N + 1), ξ (adjoint (P.val (B n)) f)) = f (x N) := by
    rw [← P.toOVM.normal_finite_union hξ B hB (N + 1) f, ← hx N f]
    have h : MeasSet.finiteUnion B (Finset.range (N + 1)) = A N :=
      Subtype.ext (disjointed_initial_union _ hA N)
    rw [h]
  refine ⟨x, fun f => ?_⟩
  have hs := (hξ B hB f).tendsto_sum_nat
  rw [hBcover] at hs
  have hn := hs.comp (tendsto_add_atTop_nat 1)
  rw [show (fun N => (∑ n ∈ Finset.range N, ξ (adjoint (P.val (B n)) f))) ∘
    (fun N => N + 1) = (fun N => f (x N)) from funext (hpartial f)] at hn
  have hw : P.val MeasSet.whole = ContinuousLinearMap.id ℝ X := P.normalized
  simpa [hw, adjoint] using hn

/-- Under (L), the normal part is exactly the weak-star sequential
closure of the canonical image. -/
theorem PVM.normal_iff_baireOne (P : PVM Ω X) (hP : P.Localizes) (ξ : Bidual X) :
    P.toOVM.Normal ξ ↔ BaireOne ξ :=
  ⟨P.baireOne_of_localizes hP, P.toOVM.normal_of_baireOne ξ⟩

theorem norm_J (x : X) : ‖J x‖ = ‖x‖ := by
  apply le_antisymm
  · apply ContinuousLinearMap.opNorm_le_bound _ (norm_nonneg _)
    intro f
    simpa only [J_apply, mul_comm] using f.le_opNorm x
  · by_cases h : ‖x‖ = 0
    · rw [h]
      exact norm_nonneg (J x)
    · obtain ⟨g, hg, hgx⟩ := exists_dual_vector ℝ x h
      have hb := (J x).le_opNorm g
      change ‖g x‖ ≤ ‖J x‖ * ‖g‖ at hb
      rw [show g x = ‖x‖ by exact hgx, Real.norm_of_nonneg (norm_nonneg x), hg, mul_one] at hb
      exact hb

theorem secondAdjoint_comp (A : X →L[ℝ] Z) {W : Type*} [NormedAddCommGroup W] [NormedSpace ℝ W]
    (B : Z →L[ℝ] W) (ξ : Bidual X) :
    secondAdjoint B (secondAdjoint A ξ) = secondAdjoint (B.comp A) ξ := by
  ext f
  rfl

theorem PVM.cut_inter (P : PVM Ω X) (A B : MeasSet Ω) (ξ : Bidual X) :
    secondAdjoint (P.val A) (secondAdjoint (P.val B) ξ) =
      secondAdjoint (P.val (A.inter B)) ξ := by
  rw [secondAdjoint_comp, P.mul_eq]

theorem OVM.normal_sub (μ : OVM Ω X) {ξ η : Bidual X}
    (hξ : μ.Normal ξ) (hη : μ.Normal η) : μ.Normal (ξ - η) := by
  intro A hA f
  exact (hξ A hA f).sub (hη A hA f)

theorem PVM.normal_cut (P : PVM Ω X) (A : MeasSet Ω) {ξ : Bidual X} (hξ : P.toOVM.Normal ξ) :
    P.toOVM.Normal (secondAdjoint (P.val A) ξ) := by
  apply P.normal_of_intertwining P (P.val A) _ hξ
  intro B
  rw [P.mul_eq, P.mul_eq, show A.inter B = B.inter A from Subtype.ext (inter_comm _ _)]

/-- Convert an increasing measurable exhaustion to its disjoint increments. -/
theorem PVM.exists_localized_partition (P : PVM Ω X) (hP : P.Localizes)
    (ξ : Bidual X) (hξ : P.toOVM.Normal ξ) :
    ∃ B : ℕ → MeasSet Ω, MeasSet.DisjointSeq B ∧ MeasSet.iUnion B = MeasSet.whole ∧
      ∀ n, ∃ x : X, secondAdjoint (P.val (B n)) ξ = J x := by
  obtain ⟨A, _, hcover, hx⟩ := hP ξ hξ
  let B (n : ℕ) : MeasSet Ω :=
    ⟨disjointed (fun k => (A k).1) n, MeasurableSet.disjointed (fun k => (A k).2) n⟩
  have hu : MeasSet.iUnion B = MeasSet.whole := by
    rw [← hcover]
    exact Subtype.ext iUnion_disjointed
  refine ⟨B, disjoint_disjointed _, hu, fun n => ?_⟩
  obtain ⟨x, hx⟩ := hx n
  have hx' : secondAdjoint (P.val (A n)) ξ = J x := by ext f; exact hx f
  have hsub : (B n).inter (A n) = B n :=
    Subtype.ext (inter_eq_left.mpr (disjointed_subset (fun k => (A k).1) n))
  refine ⟨P.val (B n) x, ?_⟩
  rw [← secondAdjoint_canonical, ← hx', P.cut_inter, hsub]

/-- Finite unions recover the increasing exhaustion from the partition. -/
theorem PVM.localizes_of_exists_partition (P : PVM Ω X)
    (hP : ∀ ξ : Bidual X, P.toOVM.Normal ξ →
      ∃ B : ℕ → MeasSet Ω, MeasSet.DisjointSeq B ∧ MeasSet.iUnion B = MeasSet.whole ∧
        ∀ n, ∃ x : X, secondAdjoint (P.val (B n)) ξ = J x) : P.Localizes := by
  intro ξ hξ
  obtain ⟨B, hB, hcover, hx⟩ := hP ξ hξ
  choose x hx using hx
  let A (N : ℕ) := MeasSet.finiteUnion B (Finset.range (N + 1))
  have hm : Monotone (fun N => (A N).1) := by
    intro i j hij ω hω
    obtain ⟨n, hn, hb⟩ := mem_iUnion₂.mp hω
    exact mem_iUnion₂.mpr ⟨n, Finset.range_mono (Nat.succ_le_succ hij) hn, hb⟩
  have hu : MeasSet.iUnion A = MeasSet.whole := by
    rw [← hcover]
    apply Subtype.ext
    ext ω
    change (ω ∈ ⋃ n, (A n).1) ↔ ω ∈ ⋃ n, (B n).1
    constructor
    · intro h
      obtain ⟨N, hN⟩ := mem_iUnion.mp h
      obtain ⟨n, _, hn⟩ := mem_iUnion₂.mp hN
      exact mem_iUnion.mpr ⟨n, hn⟩
    · intro h
      obtain ⟨n, hn⟩ := mem_iUnion.mp h
      exact mem_iUnion.mpr ⟨n, mem_iUnion₂.mpr ⟨n, Finset.mem_range.mpr (Nat.lt_succ_self n), hn⟩⟩
  refine ⟨A, hm, hu, fun N => ⟨∑ n ∈ Finset.range (N + 1), x n, fun f => ?_⟩⟩
  rw [map_sum, P.toOVM.normal_finite_union hξ B hB]
  apply Finset.sum_congr rfl
  intro n _
  exact congrArg (fun ξ : Bidual X => ξ f) (hx n)

theorem secondAdjoint_sub (A : X →L[ℝ] Z) (ξ η : Bidual X) :
    secondAdjoint A (ξ - η) = secondAdjoint A ξ - secondAdjoint A η := by
  ext f
  rfl

theorem PVM.cut_intertwining (P : PVM Ω X) (R : PVM Ω Z) (A : X →L[ℝ] Z)
    (hA : ∀ E, A.comp (P.val E) = (R.val E).comp A) (E : MeasSet Ω) (ξ : Bidual X) :
    secondAdjoint A (secondAdjoint (P.val E) ξ) =
      secondAdjoint (R.val E) (secondAdjoint A ξ) := by
  rw [secondAdjoint_comp, secondAdjoint_comp, hA E]

@[simp] theorem MeasSet.inter_self (A : MeasSet Ω) : A.inter A = A :=
  Subtype.ext (Set.inter_self _)

theorem MeasSet.inter_comm (A B : MeasSet Ω) : A.inter B = B.inter A :=
  Subtype.ext (Set.inter_comm _ _)

/-- A countable partition refined by a countable partition on each cell. -/
def MeasSet.refinePartition (D : ℕ → MeasSet Ω) (F : ℕ → ℕ → MeasSet Ω) (n : ℕ) : MeasSet Ω :=
  (D (Nat.unpair n).1).inter (F (Nat.unpair n).1 (Nat.unpair n).2)

theorem MeasSet.refinePartition_disjoint (D : ℕ → MeasSet Ω) (hD : DisjointSeq D)
    (F : ℕ → ℕ → MeasSet Ω) (hF : ∀ n, DisjointSeq (F n)) :
    DisjointSeq (refinePartition D F) := by
  intro i j hij
  rcases hi : Nat.unpair i with ⟨n, k⟩
  rcases hj : Nat.unpair j with ⟨m, l⟩
  change Disjoint ((D (Nat.unpair i).1).1 ∩ (F (Nat.unpair i).1 (Nat.unpair i).2).1)
    ((D (Nat.unpair j).1).1 ∩ (F (Nat.unpair j).1 (Nat.unpair j).2).1)
  rw [hi, hj]
  by_cases h : n = m
  · subst m
    have hkl : k ≠ l := by
      intro hkl
      subst l
      exact hij (Nat.pairEquiv.symm.injective (hi.trans hj.symm))
    exact (hF n hkl).mono inter_subset_right inter_subset_right
  · exact (hD h).mono inter_subset_left inter_subset_left

theorem MeasSet.refinePartition_cover (D : ℕ → MeasSet Ω) (hD : iUnion D = whole)
    (F : ℕ → ℕ → MeasSet Ω) (hF : ∀ n, iUnion (F n) = whole) :
    iUnion (refinePartition D F) = whole := by
  apply Subtype.ext
  apply Set.eq_univ_of_forall
  intro ω
  have hω : ω ∈ (iUnion D).1 := by rw [hD]; exact mem_univ _
  obtain ⟨n, hn⟩ := mem_iUnion.mp hω
  have hω' : ω ∈ (iUnion (F n)).1 := by rw [hF]; exact mem_univ _
  obtain ⟨k, hk⟩ := mem_iUnion.mp hω'
  refine mem_iUnion.mpr ⟨Nat.pair n k, ?_⟩
  change ω ∈ (D (Nat.unpair (Nat.pair n k)).1).1 ∩
    (F (Nat.unpair (Nat.pair n k)).1 (Nat.unpair (Nat.pair n k)).2).1
  rw [Nat.unpair_pair]
  exact ⟨hn, hk⟩

/-- Manuscript, prop:normal-coverage: localization of restriction and
quotient implies localization of the original PVM. -/
theorem PVM.localizes_of_restrict_and_quotient (P : PVM Ω X) (Y : Submodule ℝ X)
    [IsClosed (Y : Set X)] (hY : P.Invariant Y)
    (hres : (P.restrict Y hY).Localizes) (hquot : (P.quotient Y hY).Localizes) :
    P.Localizes := by
  apply P.localizes_of_exists_partition
  intro ξ hξ
  let q := Y.mkQL
  let R := P.quotient Y hY
  let S := P.restrict Y hY
  have hqnorm : R.toOVM.Normal (secondAdjoint q ξ) :=
    P.normal_of_intertwining R q (P.quotient_intertwines Y hY) hξ
  obtain ⟨D, hD, hDcover, hy⟩ := R.exists_localized_partition hquot _ hqnorm
  choose y hy using hy
  choose t ht using fun n => Submodule.Quotient.mk_surjective Y (y n)
  let x (n : ℕ) := P.val (D n) (t n)
  let ζ (n : ℕ) := secondAdjoint (P.val (D n)) ξ - J (x n)
  have hζ (n : ℕ) : P.toOVM.Normal (ζ n) :=
    P.toOVM.normal_sub (P.normal_cut (D n) hξ) (P.toOVM.normal_J (x n))
  have hker (n : ℕ) : secondAdjoint q (ζ n) = 0 := by
    have hqx : q (x n) = R.val (D n) (y n) := by
      change q (P.val (D n) (t n)) = R.val (D n) (y n)
      exact (congrArg (fun T : X →L[ℝ] X ⧸ Y => T (t n))
        (P.quotient_intertwines Y hY (D n))).trans (congrArg (R.val (D n)) (ht n))
    change secondAdjoint q (secondAdjoint (P.val (D n)) ξ - J (x n)) = 0
    rw [secondAdjoint_sub, secondAdjoint_canonical, hqx,
      P.cut_intertwining R q (P.quotient_intertwines Y hY), ← secondAdjoint_canonical, ← hy n,
      R.cut_inter, MeasSet.inter_self]
    ext f
    exact sub_self _
  choose η hηnormal hη using fun n =>
    (P.normal_quotient_kernel_iff Y hY (hζ n)).mp (hker n)
  choose F hF hFcover hFcut using fun n => S.exists_localized_partition hres (η n) (hηnormal n)
  refine ⟨MeasSet.refinePartition D F, MeasSet.refinePartition_disjoint D hD F hF,
    MeasSet.refinePartition_cover D hDcover F hFcover, fun j => ?_⟩
  let n := (Nat.unpair j).1
  let k := (Nat.unpair j).2
  obtain ⟨w, hw⟩ := hFcut n k
  refine ⟨P.val (F n k) (x n) + (w : X), ?_⟩
  have hz : secondAdjoint (P.val (F n k)) (ζ n) = J (w : X) := by
    rw [← hη n, ← S.cut_intertwining P Y.subtypeL (P.restrict_intertwines Y hY), hw,
      secondAdjoint_canonical]
    rfl
  change secondAdjoint (P.val (D n |>.inter (F n k))) ξ = _
  rw [MeasSet.inter_comm (D n) (F n k), ← P.cut_inter]
  ext f
  change secondAdjoint (P.val (F n k)) (secondAdjoint (P.val (D n)) ξ) f =
    f (P.val (F n k) (x n) + (w : X))
  have hh := congrArg (fun θ : Bidual X => θ f) hz
  change secondAdjoint (P.val (F n k)) (secondAdjoint (P.val (D n)) ξ - J (x n)) f = f w at hh
  rw [secondAdjoint_sub, secondAdjoint_canonical] at hh
  change secondAdjoint (P.val (F n k)) (secondAdjoint (P.val (D n)) ξ) f -
    f (P.val (F n k) (x n)) = f w at hh
  rw [map_add]
  exact (eq_add_of_sub_eq hh).trans (add_comm _ _)

/-- The closed subspace generated by the orbit of \(u\). -/
def PVM.cyclicSubspace (P : PVM Ω X) (u : X) : Submodule ℝ X :=
  (Submodule.span ℝ (Set.range fun E => P.val E u)).topologicalClosure

theorem PVM.cyclicSubspace_invariant (P : PVM Ω X) (u : X) :
    P.Invariant (P.cyclicSubspace u) := by
  intro E x hx
  have hclosed : IsClosed {y : X | P.val E y ∈ P.cyclicSubspace u} :=
    ((Submodule.span ℝ (Set.range fun F => P.val F u)).isClosed_topologicalClosure).preimage
      (P.val E).continuous
  apply closure_minimal _ hclosed hx
  intro y hy
  induction hy using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨F, rfl⟩ := hy
    have he : P.val E (P.val F u) = P.val (E.inter F) u :=
      congrArg (fun T : X →L[ℝ] X => T u) (P.mul_eq E F)
    change P.val E (P.val F u) ∈ P.cyclicSubspace u
    rw [he]
    exact subset_closure (Submodule.subset_span ⟨E.inter F, rfl⟩)
  | zero => change P.val E 0 ∈ P.cyclicSubspace u; rw [map_zero]; exact Submodule.zero_mem _
  | add y z _ _ hy hz =>
    change P.val E (y + z) ∈ P.cyclicSubspace u
    rw [map_add]
    exact Submodule.add_mem _ hy hz
  | smul c y _ hy =>
    change P.val E (c • y) ∈ P.cyclicSubspace u
    rw [map_smul]
    exact Submodule.smul_mem _ _ hy

/-- Manuscript, prop:normal-coverage, (L) implies coverage by cyclic normal
parts. The generating vector is the manuscript's weighted sum of increments. -/
theorem PVM.cyclic_coverage_of_localizes [CompleteSpace X] (P : PVM Ω X)
    (hP : P.Localizes) (ξ : Bidual X) (hξ : P.toOVM.Normal ξ) :
    ∃ u : X, ∃ η : Bidual (P.cyclicSubspace u),
      (P.restrict _ (P.cyclicSubspace_invariant u)).toOVM.Normal η ∧
        secondAdjoint (P.cyclicSubspace u).subtypeL η = ξ := by
  obtain ⟨A, _, hcover, hx⟩ := hP ξ hξ
  choose x hx using hx
  let B (n : ℕ) : MeasSet Ω :=
    ⟨disjointed (fun k => (A k).1) n, MeasurableSet.disjointed (fun k => (A k).2) n⟩
  have hB : MeasSet.DisjointSeq B := disjoint_disjointed _
  have hBcover : MeasSet.iUnion B = MeasSet.whole := by
    rw [← hcover]
    exact Subtype.ext iUnion_disjointed
  let z (n : ℕ) := P.val (B n) (x n)
  have hz (n : ℕ) (f : Dual X) :
      f (z n) = ξ (adjoint (P.val (B n)) f) := by
    have hBA : (B n).inter (A n) = B n :=
      Subtype.ext (inter_eq_left.mpr (disjointed_subset (fun k => (A k).1) n))
    calc
      f (z n) = ξ (adjoint (P.val (A n)) (adjoint (P.val (B n)) f)) :=
        (hx n (adjoint (P.val (B n)) f)).symm
      _ = ξ (adjoint (P.val (B n)) f) := by
        rw [show adjoint (P.val (A n)) (adjoint (P.val (B n)) f) =
          adjoint ((P.val (B n)).comp (P.val (A n))) f by rfl, P.mul_eq, hBA]
  have hJ (n : ℕ) : J (z n) = secondAdjoint (P.val (B n)) ξ := by
    ext f
    exact hz n f
  have hbound (n : ℕ) : ‖z n‖ ≤ P.toOVM.uniformNorm * ‖ξ‖ := calc
    ‖z n‖ = ‖secondAdjoint (P.val (B n)) ξ‖ := by rw [← norm_J, hJ]
    _ ≤ ‖P.val (B n)‖ * ‖ξ‖ := norm_secondAdjoint_le _ _
    _ ≤ P.toOVM.uniformNorm * ‖ξ‖ :=
      mul_le_mul_of_nonneg_right (P.toOVM.opNorm_le_uniformNorm _) (norm_nonneg ξ)
  let c (n : ℕ) : ℝ := (1 / 2 : ℝ) ^ n
  let u := ∑' n, c n • z n
  have hc₀ (n : ℕ) : 0 < c n := pow_pos (by norm_num) n
  have hmajor : Summable (fun n => c n * (P.toOVM.uniformNorm * ‖ξ‖)) :=
    (summable_geometric_of_lt_one (by norm_num : 0 ≤ (1 / 2 : ℝ)) (by norm_num)).mul_right _
  have hu : HasSum (fun n => c n • z n) u :=
    (Summable.of_norm (hmajor.of_nonneg_of_le (fun _ => norm_nonneg _) (fun n => by
      rw [norm_smul, Real.norm_of_nonneg (hc₀ n).le]
      exact mul_le_mul_of_nonneg_left (hbound n) (hc₀ n).le))).hasSum
  have horbit (n : ℕ) : P.val (B n) u = c n • z n := by
    have hm := hu.map (P.val (B n)) (P.val (B n)).continuous
    have he (k : ℕ) :
        P.val (B n) (c k • z k) = if k = n then c n • z n else 0 := by
      rw [map_smul]
      by_cases h : k = n
      · subst k
        rw [ite_eq_left (by rfl : n = n)]
        congr 1
        exact congrArg (fun T : X →L[ℝ] X => T (x n)) (P.projection_idempotent (B n))
      · rw [ite_eq_right h]
        have hd : P.val (B n) (z k) = 0 :=
          congrArg (fun T : X →L[ℝ] X => T (x k)) (P.disjoint_product _ _ (hB (Ne.symm h)))
        rw [hd, smul_zero]
    change HasSum (fun k => P.val (B n) (c k • z k)) (P.val (B n) u) at hm
    rw [funext he] at hm
    exact hm.unique (hasSum_ite_eq n _)
  have hzs (n : ℕ) : z n ∈ P.cyclicSubspace u := by
    have hmem : P.val (B n) u ∈ P.cyclicSubspace u :=
      subset_closure (Submodule.subset_span ⟨B n, rfl⟩)
    rw [horbit n] at hmem
    have hh := (P.cyclicSubspace u).smul_mem ((c n)⁻¹) hmem
    rwa [smul_smul, inv_mul_cancel₀ (hc₀ n).ne', one_smul] at hh
  let y (N : ℕ) : P.cyclicSubspace u :=
    ⟨∑ n ∈ Finset.range N, z n, (P.cyclicSubspace u).sum_mem fun n _ => hzs n⟩
  have hy (f : Dual X) : Tendsto (fun N => f (y N : X)) atTop (𝓝 (ξ f)) := by
    have hsum := hξ B hB f
    have hw : P.val MeasSet.whole = ContinuousLinearMap.id ℝ X := P.normalized
    rw [hBcover, hw] at hsum
    have hid : adjoint (ContinuousLinearMap.id ℝ X) f = f := by ext x; rfl
    rw [hid] at hsum
    change Tendsto (fun N => f (∑ n ∈ Finset.range N, z n)) atTop (𝓝 (ξ f))
    simpa only [map_sum, hz] using hsum.tendsto_sum_nat
  obtain ⟨η, _, hη⟩ := exists_baireOne_restrict_of_sequence (P.cyclicSubspace u) ξ y hy
  exact ⟨u, η, (P.normal_restrict_iff _ (P.cyclicSubspace_invariant u) η).mpr (hη ▸ hξ), hη⟩

/-- The finite-subsums identity in the proof of Remark 3.3. -/
theorem PVM.finite_subsum_eq (P : PVM Ω X) (B : ℕ → MeasSet Ω)
    (hB : MeasSet.DisjointSeq B) (z : ℕ → X) (hz : ∀ n, P.val (B n) (z n) = z n)
    (I : Finset ℕ) (N : ℕ) (hI : I ⊆ Finset.range N) :
    ∑ n ∈ I, z n = P.val (MeasSet.finiteUnion B I) (∑ n ∈ Finset.range N, z n) := by
  classical
  let E := MeasSet.finiteUnion B I
  have he (n : ℕ) : P.val E (z n) = if n ∈ I then z n else 0 := by
    by_cases hn : n ∈ I
    · have hsub : (B n).1 ⊆ E.1 := fun _ hw => mem_iUnion₂.mpr ⟨n, hn, hw⟩
      have hEB : E.inter (B n) = B n := Subtype.ext (inter_eq_right.mpr hsub)
      rw [ite_eq_left hn, ← hz n]
      have he := congrArg (fun T : X →L[ℝ] X => T (z n)) (P.mul_eq E (B n))
      rw [hEB] at he
      exact he
    · have hd : Disjoint E.1 (B n).1 := Set.disjoint_left.mpr (by
        intro ω hw hw'
        obtain ⟨j, hj, hwj⟩ := mem_iUnion₂.mp hw
        exact (Set.disjoint_left.mp (hB (fun heq : j = n => hn (heq ▸ hj))) hwj) hw')
      rw [ite_eq_right hn, ← hz n]
      exact congrArg (fun T : X →L[ℝ] X => T (z n)) (P.disjoint_product E (B n) hd)
  change _ = P.val E _
  rw [map_sum]
  calc
    ∑ n ∈ I, z n = ∑ n ∈ I, P.val E (z n) := by
      apply Finset.sum_congr rfl
      intro n hn
      rw [he n, ite_eq_left hn]
    _ = ∑ n ∈ Finset.range N, P.val E (z n) :=
      Finset.sum_subset hI fun n _ hn => by rw [he n, ite_eq_right hn]

theorem PVM.norm_finite_subsum_le [CompleteSpace X] (P : PVM Ω X) (B : ℕ → MeasSet Ω)
    (hB : MeasSet.DisjointSeq B) (z : ℕ → X) (hz : ∀ n, P.val (B n) (z n) = z n)
    (C : ℝ) (hC : ∀ N : ℕ, ‖∑ n ∈ Finset.range N, z n‖ ≤ C) (I : Finset ℕ) :
    ‖∑ n ∈ I, z n‖ ≤ P.toOVM.uniformNorm * C := by
  obtain ⟨N, hI⟩ := I.exists_nat_subset_range
  rw [P.finite_subsum_eq B hB z hz I N hI]
  exact ((P.val _).le_opNorm _).trans
    (mul_le_mul (P.toOVM.opNorm_le_uniformNorm _) (hC N)
      (norm_nonneg _) P.toOVM.uniformNorm_nonneg)

omit [MeasurableSpace Ω] in
/-- Bounds on real finite subsums control the absolute sum by splitting
the finite index set into nonnegative and negative terms. -/
theorem real_abs_finite_subsum_le (a : ℕ → ℝ) (K : ℝ)
    (hK : ∀ I : Finset ℕ, |∑ n ∈ I, a n| ≤ K) (I : Finset ℕ) :
    ∑ n ∈ I, |a n| ≤ 2 * K := by
  classical
  let positive := I.filter fun n => 0 ≤ a n
  let negative := I.filter fun n => ¬ 0 ≤ a n
  have hs : ∑ n ∈ I, |a n| = (∑ n ∈ positive, a n) - ∑ n ∈ negative, a n := by
    rw [← Finset.sum_filter_add_sum_filter_not I (fun n => 0 ≤ a n) (fun n => |a n|)]
    change (∑ n ∈ positive, |a n|) + (∑ n ∈ negative, |a n|) = _
    have hp : ∑ n ∈ positive, |a n| = ∑ n ∈ positive, a n := by
      apply Finset.sum_congr rfl
      intro n hn
      exact abs_of_nonneg (Finset.mem_filter.mp hn).2
    have hn : ∑ n ∈ negative, |a n| = -(∑ n ∈ negative, a n) := by
      rw [← Finset.sum_neg_distrib]
      apply Finset.sum_congr rfl
      intro n hn
      exact abs_of_neg (lt_of_not_ge (Finset.mem_filter.mp hn).2)
    rw [hp, hn, sub_eq_add_neg]
  rw [hs]
  linarith [le_abs_self (∑ n ∈ positive, a n), neg_le_abs (∑ n ∈ negative, a n),
    hK positive, hK negative]

/-- The scalar total-variation estimate on finite disjoint families. -/
theorem OVM.abs_finite_orbit_coefficients_le [CompleteSpace X] (μ : OVM Ω X)
    (B : ℕ → MeasSet Ω) (hB : MeasSet.DisjointSeq B) (x : X) (f : Dual X) (I : Finset ℕ) :
    ∑ n ∈ I, |f (μ.val (B n) x)| ≤ 2 * μ.uniformNorm * ‖x‖ * ‖f‖ := by
  have hsum (F : Finset ℕ) :
      |∑ n ∈ F, f (μ.val (B n) x)| ≤ ‖f‖ * (μ.uniformNorm * ‖x‖) := by
    rw [← map_sum, ← μ.apply_finite_union B hB F x]
    have hn := (μ.val (MeasSet.finiteUnion B F)).le_opNorm x
    have hb := mul_le_mul_of_nonneg_right (μ.opNorm_le_uniformNorm (MeasSet.finiteUnion B F))
      (norm_nonneg x)
    exact (f.le_opNorm _).trans (mul_le_mul_of_nonneg_left (hn.trans hb) (norm_nonneg f))
  refine (real_abs_finite_subsum_le _ _ hsum I).trans_eq ?_
  ring

/-- Manuscript, eq:multiplier-bound, with the exact factor \(2M_\mu\). -/
theorem OVM.opNorm_finite_multiplier_le [CompleteSpace X] (μ : OVM Ω X)
    (B : ℕ → MeasSet Ω) (hB : MeasSet.DisjointSeq B) (I : Finset ℕ) (a : ℕ → ℝ)
    (ha : ∀ n ∈ I, |a n| ≤ 1) :
    ‖∑ n ∈ I, a n • μ.val (B n)‖ ≤ 2 * μ.uniformNorm := by
  apply ContinuousLinearMap.opNorm_le_bound _
    (mul_nonneg (by norm_num : (0 : ℝ) ≤ 2) μ.uniformNorm_nonneg)
  intro x
  let y : X := (∑ n ∈ I, a n • μ.val (B n)) x
  change ‖y‖ ≤ 2 * μ.uniformNorm * ‖x‖
  have hcoeff (f : Dual X) : |f y| ≤ 2 * μ.uniformNorm * ‖x‖ * ‖f‖ := by
    have he : f y = ∑ n ∈ I, a n * f (μ.val (B n) x) := by
      simp only [y, sum_apply, smul_apply, map_sum, map_smul,
        smul_eq_mul]
    calc
      |f y| = |∑ n ∈ I, a n * f (μ.val (B n) x)| := by rw [he]
      _ ≤ ∑ n ∈ I, |a n * f (μ.val (B n) x)| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ n ∈ I, |f (μ.val (B n) x)| := by
        apply Finset.sum_le_sum
        intro n hn
        rw [abs_mul]
        exact mul_le_of_le_one_left (abs_nonneg _) (ha n hn)
      _ ≤ 2 * μ.uniformNorm * ‖x‖ * ‖f‖ := μ.abs_finite_orbit_coefficients_le B hB x f I
  by_cases h : ‖y‖ = 0
  · rw [h]
    exact mul_nonneg (mul_nonneg (by norm_num) μ.uniformNorm_nonneg) (norm_nonneg x)
  · obtain ⟨f, hf, hfy⟩ := exists_dual_vector ℝ y h
    change f y = ‖y‖ at hfy
    simpa only [hfy, abs_of_nonneg (norm_nonneg y), hf, mul_one] using hcoeff f

/-- The finite-family bound with arbitrary finite labels and an
arbitrary nonnegative bound on the scalar coefficients. -/
theorem OVM.opNorm_finite_type_multiplier_le [CompleteSpace X] (μ : OVM Ω X)
    {ι : Type*} [Fintype ι] (B : ι → MeasSet Ω)
    (hB : Pairwise fun i j => Disjoint (B i).1 (B j).1)
    (a : ι → ℝ) (C : ℝ) (hC : 0 ≤ C) (ha : ∀ i, |a i| ≤ C) :
    ‖∑ i, a i • μ.val (B i)‖ ≤ 2 * μ.uniformNorm * C := by
  classical
  by_cases hc : C = 0
  · have haz (i : ι) : a i = 0 := abs_eq_zero.mp (le_antisymm ((ha i).trans_eq hc) (abs_nonneg _))
    simp only [haz, zero_smul, Finset.sum_const_zero, norm_zero, hc, mul_zero]
    exact le_rfl
  · let e := Fintype.equivFin ι
    let E (n : ℕ) := if hn : n < Fintype.card ι then B (e.symm ⟨n, hn⟩) else MeasSet.empty
    let c (n : ℕ) : ℝ := if hn : n < Fintype.card ι then a (e.symm ⟨n, hn⟩) / C else 0
    have hE : MeasSet.DisjointSeq E := by
      intro i j hij
      by_cases hi : i < Fintype.card ι <;> by_cases hj : j < Fintype.card ι
      · simp only [E, dite_eq_left hi, dite_eq_left hj]
        exact hB (fun h => hij (congrArg Fin.val (e.symm.injective h)))
      · simp [E, hj, MeasSet.empty]
      · simp [E, hi, MeasSet.empty]
      · simp [E, hi, MeasSet.empty]
    have hCpos := lt_of_le_of_ne hC (Ne.symm hc)
    have hcnorm : ∀ n ∈ Finset.range (Fintype.card ι), |c n| ≤ 1 := by
      intro n hn
      have hn' := Finset.mem_range.mp hn
      simp only [c, dite_eq_left hn', abs_div, abs_of_nonneg hC]
      exact (div_le_one hCpos).mpr (ha _)
    have hb := μ.opNorm_finite_multiplier_le E hE _ c hcnorm
    have he : (∑ i, (a i / C) • μ.val (B i)) =
        ∑ n ∈ Finset.range (Fintype.card ι), c n • μ.val (E n) := by
      rw [← Fin.sum_univ_eq_sum_range]
      calc
        _ = ∑ j : Fin (Fintype.card ι), (a (e.symm j) / C) • μ.val (B (e.symm j)) :=
          (e.symm.sum_comp (fun i => (a i / C) • μ.val (B i))).symm
        _ = _ := by
          apply Finset.sum_congr rfl
          intro j _
          simp only [c, E, dite_eq_left j.isLt]
    rw [← he] at hb
    have hsum : (∑ i, a i • μ.val (B i)) = C • (∑ i, (a i / C) • μ.val (B i)) := by
      rw [Finset.smul_sum]
      apply Finset.sum_congr rfl
      intro i _
      rw [smul_smul, mul_comm C (a i / C), div_mul_cancel₀ _ hc]
    rw [hsum, norm_smul, Real.norm_of_nonneg hC]
    exact (mul_le_mul_of_nonneg_left hb hC).trans_eq (mul_comm _ _)

/-- Manuscript, rem:finite-subsums. The supported series is weakly
unconditionally Cauchy with the manuscript's scalar estimate. -/
theorem PVM.summable_abs_dual_of_bounded_partialSums [CompleteSpace X]
    (P : PVM Ω X) (B : ℕ → MeasSet Ω) (hB : MeasSet.DisjointSeq B)
    (z : ℕ → X) (hz : ∀ n, P.val (B n) (z n) = z n)
    (C : ℝ) (hC : ∀ N : ℕ, ‖∑ n ∈ Finset.range N, z n‖ ≤ C) (f : Dual X) :
    Summable (fun n => |f (z n)|) ∧ (∑' n, |f (z n)|) ≤ 2 * P.toOVM.uniformNorm * C * ‖f‖ := by
  have hK (I : Finset ℕ) : |∑ n ∈ I, f (z n)| ≤ ‖f‖ * (P.toOVM.uniformNorm * C) := by
    rw [← map_sum]
    exact (f.le_opNorm _).trans (mul_le_mul_of_nonneg_left
      (P.norm_finite_subsum_le B hB z hz C hC I) (norm_nonneg f))
  have hb := real_abs_finite_subsum_le (fun n => f (z n)) _ hK
  have hs : Summable (fun n => |f (z n)|) :=
    summable_of_sum_le (fun _ => abs_nonneg _) hb
  refine ⟨hs, (hs.tsum_le_of_sum_le hb).trans_eq ?_⟩
  ring

/-- The norm convergence part of the James proof for one normal vector. -/
theorem PVM.exists_J_of_localized_boundedlyComplete [CompleteSpace X] (P : PVM Ω X)
    (hbc : P.BoundedlyComplete) (ξ : Bidual X) (hξ : P.toOVM.Normal ξ)
    (hloc : ∃ A : ℕ → MeasSet Ω, Monotone (fun n => (A n).1) ∧
      MeasSet.iUnion A = MeasSet.whole ∧
      ∀ n, ∃ x : X, ∀ f : Dual X, ξ (adjoint (P.val (A n)) f) = f x) :
    ∃ x : X, J x = ξ := by
  obtain ⟨A, hA, hcover, hx⟩ := hloc
  choose x hx using hx
  let B (n : ℕ) : MeasSet Ω :=
    ⟨disjointed (fun k => (A k).1) n, MeasurableSet.disjointed (fun k => (A k).2) n⟩
  have hB : MeasSet.DisjointSeq B := disjoint_disjointed _
  have hBcover : MeasSet.iUnion B = MeasSet.whole := by
    rw [← hcover]
    exact Subtype.ext iUnion_disjointed
  let z (n : ℕ) := P.val (B n) (x n)
  have hz (n : ℕ) (f : Dual X) :
      f (z n) = ξ (adjoint (P.val (B n)) f) := by
    calc
      f (z n) = ξ (adjoint (P.val (A n)) (adjoint (P.val (B n)) f)) :=
        (hx n (adjoint (P.val (B n)) f)).symm
      _ = ξ (adjoint (P.val (B n)) f) := by
        have hBA : (B n).inter (A n) = B n :=
          Subtype.ext (inter_eq_left.mpr (disjointed_subset (fun k => (A k).1) n))
        rw [show adjoint (P.val (A n)) (adjoint (P.val (B n)) f) =
            adjoint ((P.val (B n)).comp (P.val (A n))) f by rfl, P.mul_eq, hBA]
  have hproj (n : ℕ) : P.val (B n) (z n) = z n :=
    congrArg (fun L : X →L[ℝ] X => L (x n)) (P.projection_idempotent (B n))
  have hpartialEval (f : Dual X) (N : ℕ) :
      f (∑ n ∈ Finset.range (N + 1), z n) = f (x N) := by
    rw [map_sum]
    simp_rw [hz]
    rw [← P.toOVM.normal_finite_union hξ B hB (N + 1) f, ← hx N f]
    have h : MeasSet.finiteUnion B (Finset.range (N + 1)) = A N :=
      Subtype.ext (disjointed_initial_union _ hA N)
    rw [h]
  have hpartial (N : ℕ) : (∑ n ∈ Finset.range (N + 1), z n) = x N :=
    eq_of_dual_eval fun f => hpartialEval f N
  have hsum (f : Dual X) : HasSum (fun n => f (z n)) (ξ f) := by
    have hs := hξ B hB f
    have hw : P.val MeasSet.whole = ContinuousLinearMap.id ℝ X := P.normalized
    rw [hBcover, hw] at hs
    have hi : adjoint (ContinuousLinearMap.id ℝ X) f = f := by
      ext x
      rfl
    rw [hi] at hs
    simpa only [hz] using hs
  have hbound : ∃ C : ℝ, ∀ N : ℕ, ‖∑ n ∈ Finset.range N, z n‖ ≤ C := by
    refine ⟨P.toOVM.uniformNorm * ‖ξ‖, fun N => ?_⟩
    cases N with
    | zero =>
      simpa only [Finset.range_zero, Finset.sum_empty, norm_zero] using
        mul_nonneg P.toOVM.uniformNorm_nonneg (norm_nonneg ξ)
    | succ N =>
      rw [hpartial]
      have hcut : J (x N) = secondAdjoint (P.val (A N)) ξ := by
        ext f
        exact (hx N f).symm
      calc
        ‖x N‖ = ‖secondAdjoint (P.val (A N)) ξ‖ := by rw [← norm_J, hcut]
        _ ≤ ‖P.val (A N)‖ * ‖ξ‖ := norm_secondAdjoint_le _ _
        _ ≤ P.toOVM.uniformNorm * ‖ξ‖ :=
          mul_le_mul_of_nonneg_right (P.toOVM.opNorm_le_uniformNorm _) (norm_nonneg ξ)
  obtain ⟨y, hy⟩ := hbc B z hB hproj hbound
  refine ⟨y, ?_⟩
  ext f
  have ht : Tendsto (fun N => ∑ n ∈ Finset.range N, f (z n)) atTop (𝓝 (f y)) := by
    simpa only [Function.comp_def, map_sum] using (f.continuous.tendsto y).comp hy
  exact tendsto_nhds_unique ht (hsum f).tendsto_sum_nat

/-- Manuscript, thm:representation-james (2). Bounded completeness
and localization identify normal vectors with the canonical image. -/
theorem PVM.normal_eq_range_of_boundedlyComplete [CompleteSpace X] (P : PVM Ω X) (hP : P.Localizes)
    (hbc : P.BoundedlyComplete) : {ξ : Bidual X | P.toOVM.Normal ξ} = Set.range (J : X → Bidual X) := by
  ext ξ
  constructor
  · intro hξ
    exact P.exists_J_of_localized_boundedlyComplete hbc ξ hξ (hP ξ hξ)
  · rintro ⟨x, rfl⟩
    exact P.toOVM.normal_J x

/-- Weak sequential completeness, expressed through convergence of all
scalar evaluations of a weakly Cauchy sequence. -/
def WeaklySeqComplete (X : Type*) [NormedAddCommGroup X] [NormedSpace ℝ X] : Prop :=
  ∀ x : ℕ → X, (∀ f : Dual X, CauchySeq (fun n => f (x n))) →
    ∃ y : X, ∀ f : Dual X, Tendsto (fun n => f (x n)) atTop (𝓝 (f y))

/-- A weakly Cauchy sequence defines its limit in the bidual. Its
continuity is obtained by uniform boundedness on the continuous dual. -/
theorem exists_baireOne_of_weakCauchy (x : ℕ → X)
    (hx : ∀ f : Dual X, CauchySeq (fun n => f (x n))) :
    ∃ ξ : Bidual X, ∀ f : Dual X, Tendsto (fun n => f (x n)) atTop (𝓝 (ξ f)) := by
  classical
  choose lim hlim using fun f => cauchySeq_tendsto_of_complete (hx f)
  obtain ⟨C, hC⟩ := banach_steinhaus (g := fun n => J (x n)) (fun f => by
    have hb : Bornology.IsBounded (Set.range fun n => f (x n)) :=
      Metric.isBounded_range_of_tendsto _ (hlim f)
    obtain ⟨M, hM⟩ := (isBounded_iff_forall_norm_le (E := ℝ)).mp hb
    exact ⟨M, fun n => hM _ ⟨n, rfl⟩⟩)
  let F : Dual X →ₗ[ℝ] ℝ :=
    { toFun := lim
      map_add' := fun f g => by
        exact tendsto_nhds_unique (hlim (f + g)) ((hlim f).add (hlim g))
      map_smul' := fun c f => by
        exact tendsto_nhds_unique (hlim (c • f)) (tendsto_const_nhds.mul (hlim f)) }
  let ξ := F.mkContinuous C (fun f => by
    change ‖lim f‖ ≤ C * ‖f‖
    refine le_of_tendsto (hlim f).norm (Eventually.of_forall fun n => ?_)
    exact ((J (x n)).le_opNorm f).trans (mul_le_mul_of_nonneg_right (hC n) (norm_nonneg f)))
  exact ⟨ξ, fun f => hlim f⟩

theorem weaklySeqComplete_iff_baireOne : WeaklySeqComplete X ↔
    {ξ : Bidual X | BaireOne ξ} = Set.range (J : X → Bidual X) := by
  constructor
  · intro h
    ext ξ
    constructor
    · rintro ⟨x, hx⟩
      obtain ⟨y, hy⟩ := h x (fun f => (hx f).cauchySeq)
      exact ⟨y, by ext f; exact tendsto_nhds_unique (hy f) (hx f)⟩
    · rintro ⟨y, rfl⟩
      exact ⟨fun _ => y, fun _ => tendsto_const_nhds⟩
  · intro h x hx
    obtain ⟨ξ, hξ⟩ := exists_baireOne_of_weakCauchy x hx
    have hb : ξ ∈ {ξ : Bidual X | BaireOne ξ} := ⟨x, hξ⟩
    rw [h] at hb
    obtain ⟨y, rfl⟩ := hb
    exact ⟨y, hξ⟩

/-- The weak sequential completeness implication in Theorem 3.4. -/
theorem PVM.weaklySeqComplete_of_boundedlyComplete [CompleteSpace X]
    (P : PVM Ω X) (hP : P.Localizes) (hbc : P.BoundedlyComplete) : WeaklySeqComplete X := by
  apply weaklySeqComplete_iff_baireOne.mpr
  have he : {ξ : Bidual X | BaireOne ξ} = {ξ : Bidual X | P.toOVM.Normal ξ} :=
    Set.ext fun ξ => (P.normal_iff_baireOne hP ξ).symm
  rw [he, P.normal_eq_range_of_boundedlyComplete hP hbc]

/-- Weak sequential completeness suffices for bounded completeness of the
projection measure. The norm convergence follows by reassembling the
projections of the weak limit using countable additivity. -/
theorem PVM.boundedlyComplete_of_weaklySeqComplete [CompleteSpace X] (P : PVM Ω X)
    (hX : WeaklySeqComplete X) : P.BoundedlyComplete := by
  intro B z hB hz hbound
  obtain ⟨C, hC⟩ := hbound
  let s (N : ℕ) := ∑ n ∈ Finset.range N, z n
  have hsc (f : Dual X) : CauchySeq (fun N => f (s N)) := by
    have ha := (P.summable_abs_dual_of_bounded_partialSums B hB z hz C hC f).1
    have hsum : Summable (fun n => f (z n)) := Summable.of_norm (by simpa [Real.norm_eq_abs] using ha)
    have hlim := hsum.hasSum.tendsto_sum_nat
    have hv : (fun N => f (s N)) = fun N => ∑ n ∈ Finset.range N, f (z n) :=
      funext fun N => map_sum f _ _
    rw [hv]
    exact hlim.cauchySeq
  obtain ⟨y, hy⟩ := hX s hsc
  have hproj (n : ℕ) : P.val (B n) y = z n := by
    apply eq_of_dual_eval
    intro f
    have hlim := hy (adjoint (P.val (B n)) f)
    have hconst : (fun N => f (P.val (B n) (s N))) =ᶠ[atTop] fun _ => f (z n) := by
      filter_upwards [eventually_ge_atTop (n + 1)] with N hN
      have hi : {n} ⊆ Finset.range N := by
        rw [Finset.singleton_subset_iff, Finset.mem_range]
        exact Nat.lt_of_succ_le hN
      have he : MeasSet.finiteUnion B {n} = B n := by
        apply Subtype.ext
        simp [MeasSet.finiteUnion]
      have hp := P.finite_subsum_eq B hB z hz {n} N hi
      rw [he, Finset.sum_singleton] at hp
      exact congrArg f hp.symm
    change Tendsto (fun N => f (P.val (B n) (s N))) atTop (𝓝 (f (P.val (B n) y))) at hlim
    exact tendsto_nhds_unique hlim (tendsto_const_nhds.congr' hconst.symm)
  refine ⟨P.val (MeasSet.iUnion B) y, ?_⟩
  simpa only [hproj] using (P.countably_additive B hB y).tendsto_sum_nat

/-- Reflexivity in its canonical bidual formulation. -/
def IsReflexive (X : Type*) [NormedAddCommGroup X] [NormedSpace ℝ X] : Prop :=
  Function.Surjective (J : X → Bidual X)

/-- Manuscript, thm:representation-james (3), the implication
from the two PVM properties to reflexivity. -/
theorem PVM.reflexive_of_shrinking_boundedlyComplete [CompleteSpace X] (P : PVM Ω X)
    (hP : P.Localizes) (hs : P.toOVM.Shrinking) (hb : P.BoundedlyComplete) : IsReflexive X := by
  intro ξ
  have hξ : ξ ∈ {η : Bidual X | P.toOVM.Normal η} := P.toOVM.normal_of_shrinking hs ξ
  rw [P.normal_eq_range_of_boundedlyComplete hP hb] at hξ
  exact hξ

theorem PVM.shrinking_boundedlyComplete_iff_reflexive [CompleteSpace X] (P : PVM Ω X)
    (hP : P.Localizes) :
    (P.toOVM.Shrinking ∧ P.BoundedlyComplete) ↔ IsReflexive X := by
  constructor
  · rintro ⟨hs, hb⟩
    exact P.reflexive_of_shrinking_boundedlyComplete hP hs hb
  · intro hX
    refine ⟨P.toOVM.shrinking_iff_all_normal.mpr ?_, P.boundedlyComplete_of_weaklySeqComplete ?_⟩
    · intro ξ
      obtain ⟨x, rfl⟩ := hX ξ
      exact P.toOVM.normal_J x
    · intro x hx
      obtain ⟨ξ, hξ⟩ := exists_baireOne_of_weakCauchy x hx
      obtain ⟨y, rfl⟩ := hX ξ
      exact ⟨y, hξ⟩

section PointMeasure

variable (X)

/-- The set function that assigns identity precisely to sets containing the point. -/
noncomputable def pointOperator (ω : Ω) (E : MeasSet Ω) : X →L[ℝ] X := by
  classical
  exact if ω ∈ E.1 then ContinuousLinearMap.id ℝ X else 0

private theorem point_sum {V : Type*} [AddCommMonoid V] [TopologicalSpace V]
    (ω : Ω) (A : ℕ → MeasSet Ω) (hA : MeasSet.DisjointSeq A) (v : V) :
    letI := Classical.propDecidable
    HasSum (fun n => if ω ∈ (A n).1 then v else 0)
      (if ω ∈ (MeasSet.iUnion A).1 then v else 0) := by
  classical
  change HasSum (fun n => if ω ∈ (A n).1 then v else 0)
    (if ω ∈ ⋃ n, (A n).1 then v else 0)
  by_cases h : ω ∈ ⋃ n, (A n).1
  · obtain ⟨k, hk⟩ := mem_iUnion.mp h
    have he (n : ℕ) : ω ∈ (A n).1 ↔ n = k := by
      constructor
      · intro hn
        by_contra hne
        exact Set.disjoint_left.mp (hA hne) hn hk
      · rintro rfl
        exact hk
    simpa [h, he] using (hasSum_ite_eq k v)
  · have hn (n : ℕ) : ω ∉ (A n).1 := fun hn => h (mem_iUnion.mpr ⟨n, hn⟩)
    simp [h, hn]

/-- In §3 the manuscript takes Ω to have one point. The same formulas
define the PVM of a chosen point in any measurable space. -/
noncomputable def pointPVM (ω : Ω) : PVM Ω X := by
  classical
  exact
    { val := pointOperator X ω
      empty_eq := by simp [pointOperator, MeasSet.empty]
      countably_additive := fun A hA x => by
        convert point_sum ω A hA x using 1
        · funext n
          by_cases h : ω ∈ (A n).1 <;> simp [pointOperator, h]
        · by_cases h : ω ∈ (MeasSet.iUnion A).1 <;> simp [pointOperator, h]
      normalized := by simp [OVM.Normalized, pointOperator, MeasSet.whole]
      mul_eq := fun A B => by
        ext x
        by_cases ha : ω ∈ A.1 <;> by_cases hb : ω ∈ B.1 <;>
          simp [pointOperator, MeasSet.inter, ha, hb] }

theorem pointPVM_shrinking (ω : Ω) : (pointPVM X ω).toOVM.Shrinking := by
  classical
  intro A hA f
  have eval (E : MeasSet Ω) :
      adjoint ((pointPVM X ω).val E) f = if ω ∈ E.1 then f else 0 := by
    ext x
    by_cases h : ω ∈ E.1 <;> simp [adjoint, pointPVM, pointOperator, h]
  simpa only [eval] using point_sum ω A hA f

theorem pointPVM_boundedlyComplete (ω : Ω) : (pointPVM X ω).BoundedlyComplete := by
  classical
  intro A z hA hz _
  have hzero (n : ℕ) (h : ω ∉ (A n).1) : z n = 0 := by
    simpa [pointPVM, pointOperator, h] using (hz n).symm
  by_cases h : ω ∈ ⋃ n, (A n).1
  · obtain ⟨k, hk⟩ := mem_iUnion.mp h
    have he (n : ℕ) : ω ∈ (A n).1 ↔ n = k := by
      constructor
      · intro hn
        by_contra hne
        exact Set.disjoint_left.mp (hA hne) hn hk
      · rintro rfl
        exact hk
    have hz' (n : ℕ) : z n = if n = k then z k else 0 := by
      by_cases hn : n = k
      · simp [hn]
      · simp [hn, hzero n (fun h => hn ((he n).mp h))]
    have hs : HasSum z (z k) := by
      simpa only [← hz'] using (hasSum_ite_eq k (z k))
    exact ⟨z k, hs.tendsto_sum_nat⟩
  · have hz' (n : ℕ) : z n = 0 := hzero n (fun hn => h (mem_iUnion.mpr ⟨n, hn⟩))
    have hs : HasSum z 0 := by
      rw [show z = (fun _ : ℕ => (0 : X)) from funext hz']
      exact hasSum_zero
    exact ⟨0, hs.tendsto_sum_nat⟩
theorem pointPVM_localizes_iff (ω : Ω) : (pointPVM X ω).Localizes ↔ IsReflexive X := by
  classical
  constructor
  · intro h ξ
    let P := pointPVM X ω
    obtain ⟨A, _, hcover, hx⟩ := h ξ (P.toOVM.normal_of_shrinking (pointPVM_shrinking X ω) ξ)
    have h : ω ∈ ⋃ n, (A n).1 :=
      show ω ∈ (MeasSet.iUnion A).1 by rw [hcover]; exact mem_univ ω
    obtain ⟨n, hn⟩ := mem_iUnion.mp h
    obtain ⟨x, hξ⟩ := hx n
    refine ⟨x, ?_⟩
    ext f
    have hi : adjoint (P.val (A n)) f = f := by
      ext y
      simp [P, pointPVM, pointOperator, adjoint, hn]
    have hf := hξ f
    change ξ (adjoint (P.val (A n)) f) = f x at hf
    rw [hi] at hf
    exact hf.symm
  · intro h ξ _
    obtain ⟨x, hx⟩ := h ξ
    refine ⟨fun _ => MeasSet.whole, monotone_const, ?_, fun _ => ⟨x, fun f => ?_⟩⟩
    · apply Subtype.ext
      change (⋃ _ : ℕ, (Set.univ : Set Ω)) = Set.univ
      exact Set.eq_univ_of_forall fun w => mem_iUnion.mpr ⟨0, mem_univ w⟩
    · have hi : adjoint ((pointPVM X ω).val MeasSet.whole) f = f := by
        ext y
        simp [pointPVM, pointOperator, MeasSet.whole, adjoint]
      rw [hi, ← hx]
      rfl

end PointMeasure

/-- Manuscript, prop:minimal-cyclic. The dense intertwining step, applied
in the manuscript after restricting to the invariant space \(W\). -/
theorem PVM.cyclicVector_of_dense_intertwining (P : PVM Ω X) (R : PVM Ω Z)
    (A : X →L[ℝ] Z) (hA : ∀ E, A.comp (P.val E) = (R.val E).comp A)
    (hd : DenseRange A) {u : X} (hu : P.CyclicVector u) :
    R.CyclicVector (A u) := by
  let target : Submodule ℝ Z := Submodule.span ℝ (Set.range fun E => R.val E (A u))
  have hspan : ∀ x ∈ Submodule.span ℝ (Set.range fun E => P.val E u), A x ∈ target := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨E, rfl⟩ := hx
      have he : A (P.val E u) = R.val E (A u) :=
        congrArg (fun L : X →L[ℝ] Z => L u) (hA E)
      rw [he]
      exact Submodule.subset_span ⟨E, rfl⟩
    | zero => simpa only [map_zero] using target.zero_mem
    | add x y _ _ hx hy => simpa only [map_add] using target.add_mem hx hy
    | smul a x _ hx => simpa only [map_smul] using target.smul_mem a hx
  have hclosed : IsClosed (A ⁻¹' closure (target : Set Z)) :=
    isClosed_closure.preimage A.continuous
  have hsub : (Submodule.span ℝ (Set.range fun E => P.val E u) : Set X) ⊆
      A ⁻¹' closure (target : Set Z) := fun x hx => subset_closure (hspan x hx)
  have hmap : Set.range A ⊆ closure (target : Set Z) := by
    rintro _ ⟨x, rfl⟩
    exact closure_minimal hsub hclosed (hu x)
  intro z
  exact closure_minimal hmap isClosed_closure (hd z)

/-- Manuscript, prop:ovm-normal. The images of weak-star sequential limits
under the synthesis bidual map are exactly the weak-star sequential limits in \(X^{**}\). -/
theorem Dilation.baireOne_synthesis_image {μ : OVM Ω X} (D : Dilation μ Z) :
    secondAdjoint D.S '' {η : Bidual Z | BaireOne η} = {ξ : Bidual X | BaireOne ξ} := by
  ext ξ
  constructor
  · rintro ⟨η, hη, rfl⟩
    exact BaireOne.second_adjoint hη D.S
  · intro hξ
    refine ⟨secondAdjoint D.T ξ, BaireOne.second_adjoint hξ D.T, ?_⟩
    ext f
    simp only [secondAdjoint_apply]
    have hadj : adjoint D.T (adjoint D.S f) = f := by
      ext x
      change f (D.S (D.T x)) = f x
      exact congrArg f (congrArg (fun L : X →L[ℝ] X => L x) D.split)
    rw [hadj]

section MinimalDilation

local instance : TopologicalSpace (MeasSet Ω) := ⊥
local instance : DiscreteTopology (MeasSet Ω) := ⟨rfl⟩
local instance : Nonempty (MeasSet Ω) := ⟨MeasSet.empty⟩

open scoped BoundedContinuousFunction

abbrev AlphaAmbient (Ω X : Type*) [MeasurableSpace Ω] [NormedAddCommGroup X] :=
  MeasSet Ω →ᵇ X

/-- Evaluation vectors \(F\mapsto\mu(E\cap F)x\) generating the minimal
\(\alpha\)-dilation. -/
noncomputable def OVM.alphaElementary [CompleteSpace X] (μ : OVM Ω X)
    (E : MeasSet Ω) (x : X) : AlphaAmbient Ω X :=
  BoundedContinuousFunction.mkOfBound
    ⟨fun F => μ.val (E.inter F) x, continuous_of_discreteTopology⟩
    (2 * μ.uniformNorm * ‖x‖) (fun F G => by
      have hb (H : MeasSet Ω) : ‖μ.val H x‖ ≤ μ.uniformNorm * ‖x‖ :=
        ((μ.val H).le_opNorm x).trans
          (mul_le_mul_of_nonneg_right (μ.opNorm_le_uniformNorm H) (norm_nonneg x))
      change dist (μ.val (E.inter F) x) (μ.val (E.inter G) x) ≤ _
      rw [dist_eq_norm]
      exact ((norm_sub_le _ _).trans (add_le_add (hb _) (hb _))).trans_eq (by ring))

@[simp] theorem OVM.alphaElementary_apply [CompleteSpace X] (μ : OVM Ω X)
    (E : MeasSet Ω) (x : X) (F : MeasSet Ω) :
    μ.alphaElementary E x F = μ.val (E.inter F) x := rfl

noncomputable def OVM.alphaGenerators [CompleteSpace X] (μ : OVM Ω X) : Set (AlphaAmbient Ω X) :=
  Set.range fun q : MeasSet Ω × X => μ.alphaElementary q.1 q.2

/-- The α-space is the completion of the span, realized as its closed
span inside the complete supremum-norm space. -/
noncomputable def OVM.alphaSubmodule [CompleteSpace X] (μ : OVM Ω X) : Submodule ℝ (AlphaAmbient Ω X) :=
  (Submodule.span ℝ μ.alphaGenerators).topologicalClosure

instance OVM.alphaSubmodule_isClosed [CompleteSpace X] (μ : OVM Ω X) :
    IsClosed (μ.alphaSubmodule : Set (AlphaAmbient Ω X)) :=
  (Submodule.span ℝ μ.alphaGenerators).isClosed_topologicalClosure

theorem OVM.alphaElementary_mem [CompleteSpace X] (μ : OVM Ω X) (E : MeasSet Ω) (x : X) :
    μ.alphaElementary E x ∈ μ.alphaSubmodule :=
  subset_closure (Submodule.subset_span ⟨⟨E, x⟩, rfl⟩)

private noncomputable def alphaAmbientRestriction (E : MeasSet Ω) :
    AlphaAmbient Ω X →L[ℝ] AlphaAmbient Ω X :=
  let g : C(MeasSet Ω, MeasSet Ω) :=
    ⟨fun F => E.inter F, continuous_of_discreteTopology⟩
  LinearMap.mkContinuous
    { toFun := fun η => η.compContinuous g
      map_add' := fun η θ => by ext F; rfl
      map_smul' := fun a η => by ext F; rfl }
    1 (fun η => by
      change ‖η.compContinuous g‖ ≤ 1 * ‖η‖
      rw [one_mul]
      exact η.norm_compContinuous_le g)

private theorem alphaAmbientRestriction_apply (E : MeasSet Ω) (η : AlphaAmbient Ω X)
    (F : MeasSet Ω) : alphaAmbientRestriction E η F = η (E.inter F) := rfl

private theorem alphaAmbientRestriction_invariant [CompleteSpace X] (μ : OVM Ω X)
    (E : MeasSet Ω) (η : AlphaAmbient Ω X) (hη : η ∈ μ.alphaSubmodule) :
    alphaAmbientRestriction E η ∈ μ.alphaSubmodule := by
  have hc : IsClosed {θ : AlphaAmbient Ω X | alphaAmbientRestriction E θ ∈ μ.alphaSubmodule} :=
    (μ.alphaSubmodule_isClosed).preimage (alphaAmbientRestriction E : AlphaAmbient Ω X →L[ℝ] _).continuous
  apply closure_minimal _ hc hη
  intro θ hθ
  induction hθ using Submodule.span_induction with
  | mem θ hθ =>
    obtain ⟨⟨G, x⟩, rfl⟩ := hθ
    change alphaAmbientRestriction E (μ.alphaElementary G x) ∈ μ.alphaSubmodule
    have he : alphaAmbientRestriction E (μ.alphaElementary G x) = μ.alphaElementary (G.inter E) x := by
      ext F
      rw [alphaAmbientRestriction_apply, μ.alphaElementary_apply, μ.alphaElementary_apply]
      exact congrArg (fun A : MeasSet Ω => μ.val A x) (Subtype.ext (Set.inter_assoc _ _ _).symm)
    rw [he]
    exact μ.alphaElementary_mem _ _
  | zero => change alphaAmbientRestriction E 0 ∈ μ.alphaSubmodule; rw [map_zero]; exact Submodule.zero_mem _
  | add η θ _ _ hη hθ =>
    change alphaAmbientRestriction E (η + θ) ∈ μ.alphaSubmodule
    rw [map_add]
    exact Submodule.add_mem _ hη hθ
  | smul a η _ hη =>
    change alphaAmbientRestriction E (a • η) ∈ μ.alphaSubmodule
    rw [map_smul]
    exact Submodule.smul_mem _ _ hη

/-- The multiplication-by-restriction projection on the α-space. -/
noncomputable def OVM.alphaRestriction [CompleteSpace X] (μ : OVM Ω X) (E : MeasSet Ω) :
    μ.alphaSubmodule →L[ℝ] μ.alphaSubmodule :=
  (alphaAmbientRestriction E).restrict (alphaAmbientRestriction_invariant μ E)

theorem OVM.norm_alphaRestriction_apply [CompleteSpace X] (μ : OVM Ω X)
    (E : MeasSet Ω) (η : μ.alphaSubmodule) : ‖μ.alphaRestriction E η‖ ≤ ‖η‖ :=
  (η.1).norm_compContinuous_le _

noncomputable def OVM.alphaSynthesis [CompleteSpace X] (μ : OVM Ω X) :
    μ.alphaSubmodule →L[ℝ] X :=
  (BoundedContinuousFunction.evalCLM ℝ (MeasSet.whole : MeasSet Ω)).comp μ.alphaSubmodule.subtypeL

noncomputable def OVM.alphaAnalysis [CompleteSpace X] (μ : OVM Ω X) :
    X →L[ℝ] μ.alphaSubmodule :=
  LinearMap.mkContinuous
    { toFun := fun x => ⟨μ.alphaElementary MeasSet.whole x, μ.alphaElementary_mem _ _⟩
      map_add' := fun x y => by
        apply Subtype.ext
        ext F
        change μ.val (MeasSet.whole.inter F) (x + y) =
          μ.val (MeasSet.whole.inter F) x + μ.val (MeasSet.whole.inter F) y
        exact map_add _ _ _
      map_smul' := fun a x => by
        apply Subtype.ext
        ext F
        change μ.val (MeasSet.whole.inter F) (a • x) = a • μ.val (MeasSet.whole.inter F) x
        exact map_smul _ _ _ }
    μ.uniformNorm (fun x => by
      change ‖μ.alphaElementary MeasSet.whole x‖ ≤ μ.uniformNorm * ‖x‖
      apply (BoundedContinuousFunction.norm_le (mul_nonneg μ.uniformNorm_nonneg (norm_nonneg x))).mpr
      intro F
      rw [μ.alphaElementary_apply]
      exact ((μ.val _).le_opNorm _).trans
        (mul_le_mul_of_nonneg_right (μ.opNorm_le_uniformNorm _) (norm_nonneg x)))

/-- The compression identity before establishing strong countable
additivity of the restriction projections. -/
theorem OVM.alphaCompression [CompleteSpace X] (μ : OVM Ω X) (E : MeasSet Ω) :
    (μ.alphaSynthesis.comp (μ.alphaRestriction E)).comp μ.alphaAnalysis = μ.val E := by
  ext x
  change μ.val (MeasSet.whole.inter (E.inter MeasSet.whole)) x = μ.val E x
  rw [show MeasSet.whole.inter (E.inter MeasSet.whole) = E from
    Subtype.ext (by change Set.univ ∩ (E.1 ∩ Set.univ) = E.1; simp)]

private theorem OVM.alpha_extension_eq [CompleteSpace X] (μ : OVM Ω X)
    (L R : AlphaAmbient Ω X →L[ℝ] X)
    (h : ∀ E x, L (μ.alphaElementary E x) = R (μ.alphaElementary E x))
    (η : μ.alphaSubmodule) : L η.1 = R η.1 := by
  have hc : IsClosed {ζ : AlphaAmbient Ω X | L ζ = R ζ} :=
    isClosed_eq L.continuous R.continuous
  apply closure_minimal _ hc η.2
  intro ζ hζ
  induction hζ using Submodule.span_induction with
  | mem ζ hz =>
    obtain ⟨⟨E, x⟩, rfl⟩ := hz
    exact h E x
  | zero => change L 0 = R 0; rw [map_zero, map_zero]
  | add ζ θ _ _ hζ hθ =>
    change L (ζ + θ) = R (ζ + θ)
    rw [map_add, map_add]
    exact congrArg₂ (· + ·) hζ hθ
  | smul a ζ _ hζ =>
    change L (a • ζ) = R (a • ζ)
    rw [map_smul, map_smul]
    exact congrArg (a • ·) hζ

private theorem OVM.alpha_empty_eval [CompleteSpace X] (μ : OVM Ω X) (η : μ.alphaSubmodule) :
    η.1 (MeasSet.empty : MeasSet Ω) = 0 := by
  refine μ.alpha_extension_eq (BoundedContinuousFunction.evalCLM ℝ (MeasSet.empty : MeasSet Ω))
    0 (fun E x => ?_) η
  change μ.val (E.inter MeasSet.empty) x = 0
  rw [show E.inter MeasSet.empty = MeasSet.empty from Subtype.ext (Set.inter_empty _), μ.empty_eq]
  rfl

private theorem OVM.alpha_union_eval [CompleteSpace X] (μ : OVM Ω X)
    (B C : MeasSet Ω) (hBC : Disjoint B.1 C.1) (η : μ.alphaSubmodule) :
    η.1 (B.union C) = η.1 B + η.1 C := by
  let eval (A : MeasSet Ω) : AlphaAmbient Ω X →L[ℝ] X :=
    BoundedContinuousFunction.evalCLM ℝ (A : MeasSet Ω)
  refine μ.alpha_extension_eq (eval (B.union C)) (eval B + eval C) (fun E x => ?_) η
  change μ.val (E.inter (B.union C)) x = μ.val (E.inter B) x + μ.val (E.inter C) x
  rw [show E.inter (B.union C) = (E.inter B).union (E.inter C) from
    Subtype.ext (Set.inter_union_distrib_left _ _ _)]
  exact μ.apply_union _ _ (hBC.mono inter_subset_right inter_subset_right) x

private theorem OVM.alpha_cut_apply [CompleteSpace X] (μ : OVM Ω X)
    (A : MeasSet Ω) (η : μ.alphaSubmodule) (F : MeasSet Ω) :
    (μ.alphaRestriction A η).1 F = η.1 (A.inter F) := rfl

private theorem OVM.alphaRestriction_mul [CompleteSpace X] (μ : OVM Ω X) (A B : MeasSet Ω) :
    (μ.alphaRestriction A).comp (μ.alphaRestriction B) = μ.alphaRestriction (A.inter B) := by
  ext η F
  change η.1 (B.inter (A.inter F)) = η.1 ((A.inter B).inter F)
  have he : B.inter (A.inter F) = (A.inter B).inter F :=
    Subtype.ext (by change B.1 ∩ (A.1 ∩ (F : MeasSet Ω).1) = (A.1 ∩ B.1) ∩ (F : MeasSet Ω).1; ac_rfl)
  rw [he]

private theorem OVM.alphaRestriction_finiteUnion [CompleteSpace X] (μ : OVM Ω X)
    (B : ℕ → MeasSet Ω) (hB : MeasSet.DisjointSeq B) (I : Finset ℕ) (η : μ.alphaSubmodule) :
    μ.alphaRestriction (MeasSet.finiteUnion B I) η = ∑ n ∈ I, μ.alphaRestriction (B n) η := by
  apply Subtype.ext
  ext F
  rw [Submodule.coe_sum]
  simp only [sum_apply, μ.alpha_cut_apply]
  let A (n : ℕ) := (B n).inter F
  have hA : MeasSet.DisjointSeq A := fun i j hij =>
    (hB hij).mono inter_subset_left inter_subset_left
  have he : (MeasSet.finiteUnion B I).inter F = MeasSet.finiteUnion A I := by
    apply Subtype.ext
    change (⋃ n ∈ I, (B n).1) ∩ (F : MeasSet Ω).1 = ⋃ n ∈ I, (B n).1 ∩ (F : MeasSet Ω).1
    simp only [Set.iUnion_inter]
  rw [he]
  exact MeasSet.finite_add_of_pair (fun E => η.1 E) (μ.alpha_empty_eval η)
    (fun E G hd => μ.alpha_union_eval E G hd η) A hA I

private theorem OVM.alphaRestriction_subUnion [CompleteSpace X] (μ : OVM Ω X)
    (A B : MeasSet Ω) (hBA : B.1 ⊆ A.1) (η : μ.alphaSubmodule) :
    μ.alphaRestriction A η - μ.alphaRestriction B η = μ.alphaRestriction (A.diff B) η := by
  apply Subtype.ext
  ext F
  simp only [Submodule.coe_sub, sub_apply, μ.alpha_cut_apply]
  have he : (B.inter F).union ((A.diff B).inter F) = A.inter F := by
    apply Subtype.ext
    change (B.1 ∩ (F : MeasSet Ω).1) ∪ ((A.1 \ B.1) ∩ (F : MeasSet Ω).1) =
      A.1 ∩ (F : MeasSet Ω).1
    rw [← Set.union_inter_distrib_right]
    rw [union_comm B.1 (A.1 \ B.1), Set.sdiff_union_of_subset hBA]
  have hd : Disjoint (B.inter F).1 ((A.diff B).inter F).1 :=
    Set.disjoint_left.mpr fun _ h h' => h'.1.2 h.1
  rw [← he, μ.alpha_union_eval _ _ hd η, add_sub_cancel_left]

private theorem OVM.alphaRestriction_tendsto_zero [CompleteSpace X] (μ : OVM Ω X)
    (A : ℕ → MeasSet Ω) (hA : Antitone (fun n => (A n).1))
    (hzero : (⋂ n, (A n).1) = ∅) (η : μ.alphaSubmodule) :
    Tendsto (fun n => μ.alphaRestriction (A n) η) atTop (𝓝 0) := by
  have hcore : ∀ ζ ∈ Submodule.span ℝ μ.alphaGenerators,
      Tendsto (fun n => alphaAmbientRestriction (A n) ζ) atTop (𝓝 0) := by
    intro ζ hζ
    induction hζ using Submodule.span_induction with
    | mem ζ hz =>
      obtain ⟨⟨E, x⟩, rfl⟩ := hz
      apply Metric.tendsto_atTop.mpr
      intro ε hε
      obtain ⟨N, hN⟩ := μ.uniform_orbit_on_decreasing_empty x A hA hzero (ε / 2) (by linarith)
      refine ⟨N, fun n hn => ?_⟩
      rw [dist_zero_right]
      have hb : ‖alphaAmbientRestriction (A n) (μ.alphaElementary E x)‖ ≤ ε / 2 := by
        apply (BoundedContinuousFunction.norm_le (show 0 ≤ ε / 2 by linarith)).mpr
        intro F
        rw [alphaAmbientRestriction_apply, μ.alphaElementary_apply]
        exact (hN _ (inter_subset_right.trans (inter_subset_left.trans (hA hn)))).le
      exact hb.trans_lt (by linarith)
    | zero =>
      simp only [map_zero]
      exact tendsto_const_nhds
    | add ζ θ _ _ hζ hθ =>
      simp only [map_add]
      simpa only [add_zero] using hζ.add hθ
    | smul c ζ _ hζ =>
      simp only [map_smul]
      simpa only [smul_zero] using (tendsto_const_nhds (x := c)).smul hζ
  apply tendsto_subtype_rng.mpr
  change Tendsto (fun n => alphaAmbientRestriction (A n) η.1) atTop (𝓝 0)
  apply Metric.tendsto_atTop.mpr
  intro ε hε
  obtain ⟨ζ, hζ, hdist⟩ := Metric.mem_closure_iff.mp η.2 (ε / 2) (by linarith)
  obtain ⟨N, hN⟩ := Metric.tendsto_atTop.mp (hcore ζ hζ) (ε / 2) (by linarith)
  refine ⟨N, fun n hn => ?_⟩
  rw [dist_zero_right]
  have hb : ‖alphaAmbientRestriction (A n) (η.1 - ζ)‖ ≤ ‖η.1 - ζ‖ :=
    (η.1 - ζ).norm_compContinuous_le _
  have hsmall := hN n hn
  rw [dist_zero_right] at hsmall
  rw [dist_eq_norm] at hdist
  have he : alphaAmbientRestriction (A n) η.1 =
      alphaAmbientRestriction (A n) (η.1 - ζ) + alphaAmbientRestriction (A n) ζ := by
    rw [← map_add, sub_add_cancel]
  rw [he]
  exact (norm_add_le _ _).trans_lt (by linarith)

private theorem OVM.alphaRestriction_hasSum [CompleteSpace X] (μ : OVM Ω X)
    (B : ℕ → MeasSet Ω) (hB : MeasSet.DisjointSeq B) (η : μ.alphaSubmodule) :
    HasSum (fun n => μ.alphaRestriction (B n) η) (μ.alphaRestriction (MeasSet.iUnion B) η) := by
  let U := MeasSet.iUnion B
  let F (I : Finset ℕ) := MeasSet.finiteUnion B I
  have hFU (I : Finset ℕ) : (F I).1 ⊆ U.1 := by
    intro ω hω
    obtain ⟨n, _, hn⟩ := mem_iUnion₂.mp hω
    exact mem_iUnion.mpr ⟨n, hn⟩
  have hFmono : Monotone (fun I => (F I).1) := by
    intro I J hIJ ω hω
    obtain ⟨n, hnI, hωn⟩ := mem_iUnion₂.mp hω
    exact mem_iUnion₂.mpr ⟨n, hIJ hnI, hωn⟩
  let A (n : ℕ) := U.diff (F (Finset.range n))
  have hA : Antitone (fun n => (A n).1) := fun i j hij _ hw =>
    ⟨hw.1, fun hx => hw.2 ((hFmono (Finset.range_mono hij)) hx)⟩
  have hz : (⋂ n, (A n).1) = ∅ := by
    apply Set.eq_empty_iff_forall_notMem.mpr
    intro ω hω
    have hω' : ω ∈ U.1 := (mem_iInter.mp hω 0).1
    obtain ⟨n, hn⟩ := mem_iUnion.mp hω'
    exact (mem_iInter.mp hω (n + 1)).2
      (mem_iUnion₂.mpr ⟨n, Finset.mem_range.mpr (Nat.lt_succ_self n), hn⟩)
  have ht := μ.alphaRestriction_tendsto_zero A hA hz η
  unfold HasSum
  change Tendsto (fun I : Finset ℕ => ∑ n ∈ I, μ.alphaRestriction (B n) η) atTop
    (𝓝 (μ.alphaRestriction U η))
  apply Metric.tendsto_atTop.mpr
  intro ε hε
  obtain ⟨N, hN⟩ := Metric.tendsto_atTop.mp ht ε hε
  have hsmall : ‖μ.alphaRestriction (A N) η‖ < ε := by
    have h := hN N le_rfl
    rwa [dist_zero_right] at h
  refine ⟨Finset.range N, fun I hI => ?_⟩
  have hsub : (U.diff (F I)).1 ⊆ (A N).1 := fun _ hw =>
    ⟨hw.1, fun h => hw.2 (hFmono hI h)⟩
  have he : (U.diff (F I)).inter (A N) = U.diff (F I) := Subtype.ext (inter_eq_left.mpr hsub)
  have hnorm : ‖μ.alphaRestriction (U.diff (F I)) η‖ ≤ ‖μ.alphaRestriction (A N) η‖ := by
    have hmul := congrArg (fun T : μ.alphaSubmodule →L[ℝ] μ.alphaSubmodule => T η)
      (μ.alphaRestriction_mul (U.diff (F I)) (A N))
    rw [he] at hmul
    rw [← hmul]
    exact μ.norm_alphaRestriction_apply _ _
  rw [dist_comm, dist_eq_norm, ← μ.alphaRestriction_finiteUnion B hB,
    μ.alphaRestriction_subUnion U (F I) (hFU I)]
  exact hnorm.trans_lt hsmall

/-- The normalized, strongly countably additive projection measure of
the minimal α-dilation. -/
noncomputable def OVM.alphaPVM [CompleteSpace X] (μ : OVM Ω X) : PVM Ω μ.alphaSubmodule where
  val := μ.alphaRestriction
  empty_eq := by
    ext η F
    change η.1 (MeasSet.empty.inter F) = 0
    rw [show MeasSet.empty.inter F = MeasSet.empty from Subtype.ext (empty_inter _)]
    exact μ.alpha_empty_eval η
  countably_additive := μ.alphaRestriction_hasSum
  normalized := by
    ext η F
    change η.1 (MeasSet.whole.inter F) = η.1 F
    rw [show MeasSet.whole.inter F = F from Subtype.ext (univ_inter _)]
  mul_eq := μ.alphaRestriction_mul

/-- Manuscript, §4.1. The minimal α-dilation on the closed span of the
elementary vector measures with their supremum norm. -/
noncomputable def OVM.alphaDilation [CompleteSpace X] (μ : OVM Ω X) (hμ : μ.Normalized) :
    Dilation μ μ.alphaSubmodule where
  P := μ.alphaPVM
  S := μ.alphaSynthesis
  T := μ.alphaAnalysis
  split := by
    have he : μ.alphaRestriction MeasSet.whole = ContinuousLinearMap.id ℝ μ.alphaSubmodule :=
      μ.alphaPVM.normalized
    have h := (μ.alphaCompression MeasSet.whole).trans hμ
    rw [he, ContinuousLinearMap.comp_id] at h
    exact h
  compress := μ.alphaCompression

#print axioms OVM.alphaPVM
#print axioms OVM.alphaDilation

def Dilation.generatedSpan {μ : OVM Ω X} (D : Dilation μ Z) : Set Z :=
  Set.range fun q : MeasSet Ω × X => D.P.val q.1 (D.T q.2)

/-- The invariant space generated by the range of the analysis map. -/
noncomputable def Dilation.generatedSubmodule {μ : OVM Ω X} (D : Dilation μ Z) : Submodule ℝ Z :=
  (Submodule.span ℝ D.generatedSpan).topologicalClosure

theorem Dilation.generated_mem {μ : OVM Ω X} (D : Dilation μ Z) (E : MeasSet Ω) (x : X) :
    D.P.val E (D.T x) ∈ D.generatedSubmodule :=
  subset_closure (Submodule.subset_span ⟨⟨E, x⟩, rfl⟩)

theorem Dilation.generated_invariant {μ : OVM Ω X} (D : Dilation μ Z) :
    D.P.Invariant D.generatedSubmodule := by
  intro E z hz
  have hc : IsClosed {w : Z | D.P.val E w ∈ D.generatedSubmodule} :=
    (Submodule.span ℝ D.generatedSpan).isClosed_topologicalClosure.preimage (D.P.val E).continuous
  apply closure_minimal _ hc hz
  intro w hw
  induction hw using Submodule.span_induction with
  | mem w hw =>
    obtain ⟨⟨F, x⟩, rfl⟩ := hw
    change D.P.val E (D.P.val F (D.T x)) ∈ D.generatedSubmodule
    have he := congrArg (fun T : Z →L[ℝ] Z => T (D.T x)) (D.P.mul_eq E F)
    change D.P.val E (D.P.val F (D.T x)) = D.P.val (E.inter F) (D.T x) at he
    rw [he]
    exact D.generated_mem _ _
  | zero =>
    change D.P.val E 0 ∈ D.generatedSubmodule
    rw [map_zero]
    exact D.generatedSubmodule.zero_mem
  | add a b _ _ ha hb =>
    change D.P.val E (a + b) ∈ D.generatedSubmodule
    rw [map_add]
    exact D.generatedSubmodule.add_mem ha hb
  | smul c a _ ha =>
    change D.P.val E (c • a) ∈ D.generatedSubmodule
    rw [map_smul]
    exact D.generatedSubmodule.smul_mem c ha

private noncomputable def Dilation.alphaMapAmbient [CompleteSpace Z]
    {μ : OVM Ω X} (D : Dilation μ Z) : Z →L[ℝ] AlphaAmbient Ω X := by
  let C := ‖D.S‖ * D.P.toOVM.uniformNorm
  have hC : 0 ≤ C := mul_nonneg (norm_nonneg _) D.P.toOVM.uniformNorm_nonneg
  have hval (z : Z) (E : MeasSet Ω) : ‖D.S (D.P.val E z)‖ ≤ C * ‖z‖ := by
    calc
      ‖D.S (D.P.val E z)‖ ≤ ‖D.S‖ * ‖D.P.val E z‖ := D.S.le_opNorm _
      _ ≤ ‖D.S‖ * (D.P.toOVM.uniformNorm * ‖z‖) :=
        mul_le_mul_of_nonneg_left (((D.P.val E).le_opNorm z).trans
          (mul_le_mul_of_nonneg_right (D.P.toOVM.opNorm_le_uniformNorm E) (norm_nonneg z)))
          (norm_nonneg D.S)
      _ = C * ‖z‖ := (mul_assoc _ _ _).symm
  let L (z : Z) : AlphaAmbient Ω X :=
    BoundedContinuousFunction.mkOfBound
      ⟨fun F => D.S (D.P.val F z), continuous_of_discreteTopology⟩
      (2 * (C * ‖z‖)) (fun E F => by
        change dist (D.S (D.P.val E z)) (D.S (D.P.val F z)) ≤ _
        rw [dist_eq_norm, two_mul]
        exact (norm_sub_le _ _).trans (add_le_add (hval z E) (hval z F)))
  refine LinearMap.mkContinuous
    { toFun := L
      map_add' := fun z w => by
        ext F
        change D.S (D.P.val F (z + w)) = D.S (D.P.val F z) + D.S (D.P.val F w)
        rw [map_add, map_add]
      map_smul' := fun c z => by
        ext F
        change D.S (D.P.val F (c • z)) = c • D.S (D.P.val F z)
        rw [map_smul, map_smul] } C ?_
  intro z
  change ‖L z‖ ≤ C * ‖z‖
  exact (BoundedContinuousFunction.norm_le (mul_nonneg hC (norm_nonneg z))).mpr (hval z)

private theorem Dilation.alphaMap_on_elementary [CompleteSpace X] [CompleteSpace Z]
    {μ : OVM Ω X} (D : Dilation μ Z) (E : MeasSet Ω) (x : X) :
    D.alphaMapAmbient (D.P.val E (D.T x)) = μ.alphaElementary E x := by
  ext F
  change D.S (D.P.val F (D.P.val E (D.T x))) = μ.val (E.inter F) x
  have he : D.P.val F (D.P.val E (D.T x)) = D.P.val (F.inter E) (D.T x) :=
    congrArg (fun T : Z →L[ℝ] Z => T (D.T x)) (D.P.mul_eq F E)
  rw [he, MeasSet.inter_comm F E]
  exact congrArg (fun T : X →L[ℝ] X => T x) (D.compress (E.inter F))

/-- The canonical dense-range comparison map from a dilation to its
minimal α-dilation, restricted to the generated invariant subspace. -/
noncomputable def Dilation.alphaComparison [CompleteSpace X] [CompleteSpace Z]
    {μ : OVM Ω X} (D : Dilation μ Z) : D.generatedSubmodule →L[ℝ] μ.alphaSubmodule :=
  (D.alphaMapAmbient.comp D.generatedSubmodule.subtypeL).codRestrict μ.alphaSubmodule (by
    intro z
    have hc : IsClosed {w : Z | D.alphaMapAmbient w ∈ μ.alphaSubmodule} :=
      μ.alphaSubmodule_isClosed.preimage D.alphaMapAmbient.continuous
    apply closure_minimal _ hc z.2
    intro w hw
    induction hw using Submodule.span_induction with
    | mem w hw =>
      obtain ⟨⟨E, x⟩, rfl⟩ := hw
      change D.alphaMapAmbient (D.P.val E (D.T x)) ∈ μ.alphaSubmodule
      rw [D.alphaMap_on_elementary]
      exact μ.alphaElementary_mem _ _
    | zero =>
      change D.alphaMapAmbient 0 ∈ μ.alphaSubmodule
      rw [map_zero]
      exact μ.alphaSubmodule.zero_mem
    | add a b _ _ ha hb =>
      change D.alphaMapAmbient (a + b) ∈ μ.alphaSubmodule
      rw [map_add]
      exact μ.alphaSubmodule.add_mem ha hb
    | smul c a _ ha =>
      change D.alphaMapAmbient (c • a) ∈ μ.alphaSubmodule
      rw [map_smul]
      exact μ.alphaSubmodule.smul_mem c ha)

theorem Dilation.alphaComparison_denseRange [CompleteSpace X] [CompleteSpace Z]
    {μ : OVM Ω X} (D : Dilation μ Z) : DenseRange D.alphaComparison := by
  let L := μ.alphaSubmodule.subtypeL.comp D.alphaComparison
  have hspan : Submodule.span ℝ μ.alphaGenerators ≤ L.toLinearMap.range := by
    apply Submodule.span_le.mpr
    rintro _ ⟨⟨E, x⟩, rfl⟩
    exact ⟨⟨D.P.val E (D.T x), D.generated_mem E x⟩, D.alphaMap_on_elementary E x⟩
  intro η
  apply Metric.mem_closure_iff.mpr
  intro ε hε
  obtain ⟨w, hw, hdist⟩ := Metric.mem_closure_iff.mp η.2 ε hε
  obtain ⟨z, rfl⟩ := hspan hw
  exact ⟨D.alphaComparison z, ⟨z, rfl⟩, hdist⟩

theorem Dilation.alphaComparison_intertwines [CompleteSpace X] [CompleteSpace Z]
    {μ : OVM Ω X} (D : Dilation μ Z) (E : MeasSet Ω) :
    D.alphaComparison.comp ((D.P.restrict D.generatedSubmodule D.generated_invariant).val E) =
      (μ.alphaPVM.val E).comp D.alphaComparison := by
  ext z F
  change D.S (D.P.val F (D.P.val E (z : Z))) = D.S (D.P.val (E.inter F) (z : Z))
  rw [MeasSet.inter_comm E F]
  exact congrArg D.S (congrArg (fun T : Z →L[ℝ] Z => T (z : Z)) (D.P.mul_eq F E))

#print axioms Dilation.alphaComparison_denseRange
#print axioms Dilation.alphaComparison_intertwines

/-- The analysis map with codomain the generated invariant subspace. -/
noncomputable def Dilation.generatedAnalysis {μ : OVM Ω X} (D : Dilation μ Z) :
    X →L[ℝ] D.generatedSubmodule :=
  D.T.codRestrict _ (fun x => by
    have h := D.generated_mem MeasSet.whole x
    have he : D.P.val MeasSet.whole = ContinuousLinearMap.id ℝ Z := D.P.normalized
    rw [he] at h
    exact h)

theorem Dilation.alphaComparison_analysis [CompleteSpace X] [CompleteSpace Z]
    {μ : OVM Ω X} (D : Dilation μ Z) :
    D.alphaComparison.comp D.generatedAnalysis = μ.alphaAnalysis := by
  ext x F
  change D.S (D.P.val F (D.T x)) = μ.val (MeasSet.whole.inter F) x
  rw [show MeasSet.whole.inter F = F from Subtype.ext (univ_inter _)]
  exact congrArg (fun T : X →L[ℝ] X => T x) (D.compress F)

/-- The bounded completeness of an OVM in the paper is measured on
the minimal α-dilation. -/
def OVM.BoundedlyComplete [CompleteSpace X] (μ : OVM Ω X) : Prop :=
  μ.alphaPVM.BoundedlyComplete

/-- Manuscript, prop:ovm-normal (2): localization of the dilation and
bounded completeness of the α-projections give weak sequential completeness. -/
theorem Dilation.weaklySeqComplete_of_boundedlyComplete [CompleteSpace X] [CompleteSpace Z]
    {μ : OVM Ω X} (D : Dilation μ Z) (hD : D.P.Localizes) (hbc : μ.BoundedlyComplete) :
    WeaklySeqComplete X := by
  intro seq hseq
  obtain ⟨ξ, hξ⟩ := exists_baireOne_of_weakCauchy seq hseq
  let W := D.generatedSubmodule
  let R := D.P.restrict W D.generated_invariant
  let A₀ := D.generatedAnalysis
  let Q := D.alphaComparison
  have hloc : R.Localizes := D.P.localizes_restrict W
    (Submodule.span ℝ D.generatedSpan).isClosed_topologicalClosure D.generated_invariant hD
  have hbw : BaireOne (secondAdjoint A₀ ξ) := BaireOne.second_adjoint ⟨seq, hξ⟩ A₀
  have hnw := R.toOVM.normal_of_baireOne _ hbw
  have hna : μ.alphaPVM.toOVM.Normal (secondAdjoint μ.alphaAnalysis ξ) :=
    μ.alphaPVM.toOVM.normal_of_baireOne _ (BaireOne.second_adjoint ⟨seq, hξ⟩ μ.alphaAnalysis)
  obtain ⟨E, hE, hcover, hv⟩ := hloc _ hnw
  have hcomp : secondAdjoint Q (secondAdjoint A₀ ξ) = secondAdjoint μ.alphaAnalysis ξ := by
    rw [secondAdjoint_comp, D.alphaComparison_analysis]
  have hlα : ∀ n, ∃ z : μ.alphaSubmodule, ∀ f : Dual μ.alphaSubmodule,
      secondAdjoint μ.alphaAnalysis ξ (adjoint (μ.alphaPVM.val (E n)) f) = f z := by
    intro n
    obtain ⟨v, hv⟩ := hv n
    have he : secondAdjoint (R.val (E n)) (secondAdjoint A₀ ξ) = J v := by ext f; exact hv f
    have hcut : secondAdjoint (μ.alphaPVM.val (E n)) (secondAdjoint μ.alphaAnalysis ξ) = J (Q v) := by
      rw [← hcomp, ← R.cut_intertwining μ.alphaPVM Q D.alphaComparison_intertwines,
        he, secondAdjoint_canonical]
    exact ⟨Q v, fun f => congrArg (fun η : Bidual μ.alphaSubmodule => η f) hcut⟩
  obtain ⟨z, hz⟩ := μ.alphaPVM.exists_J_of_localized_boundedlyComplete hbc _ hna
    ⟨E, hE, hcover, hlα⟩
  have hx := congrArg (secondAdjoint μ.alphaSynthesis) hz
  have hμ : μ.Normalized := by
    unfold OVM.Normalized
    rw [← D.compress MeasSet.whole]
    have hw : D.P.val MeasSet.whole = ContinuousLinearMap.id ℝ Z := D.P.normalized
    rw [hw]
    exact D.split
  have hsplit : μ.alphaSynthesis.comp μ.alphaAnalysis = ContinuousLinearMap.id ℝ X :=
    (μ.alphaDilation hμ).split
  rw [secondAdjoint_canonical, secondAdjoint_comp, hsplit] at hx
  change J (μ.alphaSynthesis z) = secondAdjoint (ContinuousLinearMap.id ℝ X) ξ at hx
  have he : secondAdjoint (ContinuousLinearMap.id ℝ X) ξ = ξ := by ext f; rfl
  rw [he] at hx
  exact ⟨μ.alphaSynthesis z, fun f => (congrArg (fun η : Bidual X => η f) hx).symm ▸ hξ f⟩

#print axioms Dilation.alphaComparison_analysis
#print axioms Dilation.weaklySeqComplete_of_boundedlyComplete

/-- Weak sequential completeness gives an unconditional sum for every
weakly unconditionally Cauchy series, via Orlicz–Pettis. -/
theorem summable_of_weaklySeqComplete_of_abs_dual [CompleteSpace X] (hX : WeaklySeqComplete X)
    (u : ℕ → X) (hu : ∀ f : Dual X, Summable fun n => |f (u n)|) : Summable u := by
  have hlim (b : ℕ → Bool) :
      ∃ x : X, ∀ f : Dual X, HasSum (fun n => if b n then f (u n) else 0) (f x) := by
    let s (N : ℕ) : X := ∑ n ∈ Finset.range N, if b n then u n else 0
    have hss (f : Dual X) : Summable (fun n => if b n then f (u n) else 0) :=
      (hasSum_masked (fun n => f (u n)) (hu f) b).summable
    have he (f : Dual X) :
        (fun N => f (s N)) = fun N => ∑ n ∈ Finset.range N, if b n then f (u n) else 0 := by
      funext N
      dsimp [s]
      rw [map_sum]
      apply Finset.sum_congr rfl
      intro n _
      cases b n <;> simp
    obtain ⟨x, hx⟩ := hX s (fun f => by
      rw [he]
      exact (hss f).hasSum.tendsto_sum_nat.cauchySeq)
    refine ⟨x, fun f => ?_⟩
    have ht := hx f
    rw [he] at ht
    exact (tendsto_nhds_unique (hss f).hasSum.tendsto_sum_nat ht) ▸ (hss f).hasSum
  choose F hF using hlim
  exact (hasSum_of_weak_subseries u F hF).summable

/-- The block argument of prop:minimal-bounded-complete reduces bounded
completeness of the α-dilation to unconditional convergence of weakly
unconditionally Cauchy series in \(X\). -/
theorem OVM.alpha_boundedlyComplete_of_unconditional [CompleteSpace X] (μ : OVM Ω X)
    (hX : ∀ u : ℕ → X, (∀ f : Dual X, Summable fun n => |f (u n)|) → Summable u) :
    μ.BoundedlyComplete := by
  intro B z hB hz hbound
  obtain ⟨C, hC⟩ := hbound
  let s (N : ℕ) := ∑ n ∈ Finset.range N, z n
  by_cases hc : CauchySeq s
  · exact cauchySeq_tendsto_of_complete hc
  · exfalso
    rw [Metric.cauchySeq_iff] at hc
    push Not at hc
    obtain ⟨ε, hε, hbad⟩ := hc
    have hpair (K : ℕ) : ∃ i j : ℕ, K ≤ i ∧ i < j ∧ ε ≤ dist (s j) (s i) := by
      obtain ⟨i, hi, j, hj, hij⟩ := hbad K
      rcases lt_trichotomy i j with hi' | h | hj'
      · exact ⟨i, j, hi, hi', by rwa [dist_comm]⟩
      · subst j
        rw [dist_self] at hij
        exact (not_le_of_gt hε hij).elim
      · exact ⟨j, i, hj, hj', hij⟩
    choose i j hki hij hdist using hpair
    let N : ℕ → ℕ := Nat.rec 0 (fun _ k => j k)
    let I (k : ℕ) : Finset ℕ := Finset.range (N (k + 1)) \ Finset.range (i (N k))
    have hN : Monotone N := monotone_nat_of_le_succ fun k => (hki (N k)).trans (hij (N k)).le
    have hI : Pairwise fun k l => Disjoint (I k) (I l) := by
      apply Pairwise.of_lt
      intro k l hkl
      apply Finset.disjoint_left.mpr
      intro n hk hl
      have h₁ := Finset.mem_range.mp (Finset.mem_sdiff.mp hk).1
      have h₂ := Finset.mem_sdiff.mp hl |>.2
      exact h₂ (Finset.mem_range.mpr (h₁.trans_le ((hN hkl).trans (hki (N l)))))
    let w (k : ℕ) : μ.alphaSubmodule := ∑ n ∈ I k, z n
    have hwlarge (k : ℕ) : ε ≤ ‖w k‖ := by
      have h := Finset.sum_sdiff (f := z)
        (Finset.range_mono (hij (N k)).le : Finset.range (i (N k)) ⊆ Finset.range (N (k + 1)))
      change w k + s (i (N k)) = s (N (k + 1)) at h
      have he : s (N (k + 1)) - s (i (N k)) = w k := by rw [← h, add_sub_cancel_right]
      have h' := hdist (N k)
      change ε ≤ dist (s (N (k + 1))) (s (i (N k))) at h'
      rwa [dist_eq_norm, he] at h'
    let G (k : ℕ) := MeasSet.finiteUnion B (I k)
    have hG : MeasSet.DisjointSeq G := by
      intro k l hkl
      apply Set.disjoint_left.mpr
      intro ω hk hl
      obtain ⟨n, hn, hnω⟩ := mem_iUnion₂.mp hk
      obtain ⟨m, hm, hmω⟩ := mem_iUnion₂.mp hl
      have hnm : n ≠ m := fun h => (Finset.disjoint_left.mp (hI hkl)) (h ▸ hn) hm
      exact (Set.disjoint_left.mp (hB hnm)) hnω hmω
    have hw_cut (k n : ℕ) (hkn : I k ⊆ Finset.range n) :
        w k = μ.alphaRestriction (G k) (s n) :=
      μ.alphaPVM.finite_subsum_eq B hB z hz (I k) n hkn
    have hA (k : ℕ) : ∃ A : MeasSet Ω, A.1 ⊆ (G k).1 ∧ ε / 2 < ‖(w k).1 A‖ := by
      have hn : ¬ ‖(w k).1‖ ≤ ε / 2 := by
        change ¬ ‖w k‖ ≤ ε / 2
        linarith [hwlarge k]
      have hw := mt (BoundedContinuousFunction.norm_le (f := (w k).1) (by linarith : 0 ≤ ε / 2)).mpr hn
      push Not at hw
      obtain ⟨A, hA⟩ := hw
      obtain ⟨n, hn'⟩ := (I k).exists_nat_subset_range
      have hs : μ.alphaRestriction (G k) (w k) = w k := by
        rw [hw_cut k n hn']
        exact congrArg (fun T : μ.alphaSubmodule →L[ℝ] μ.alphaSubmodule => T (s n))
          (μ.alphaPVM.projection_idempotent (G k))
      have hv := congrArg (fun y : μ.alphaSubmodule => y.1 A) hs
      change (w k).1 ((G k).inter A) = (w k).1 A at hv
      refine ⟨(G k).inter A, inter_subset_left, ?_⟩
      rwa [hv]
    choose A hAG hlarge using hA
    let v (k : ℕ) := (w k).1 (A k)
    have hAdis : MeasSet.DisjointSeq A := fun k l hkl => (hG hkl).mono (hAG k) (hAG l)
    have hv_bound (H : Finset ℕ) : ‖∑ k ∈ H, v k‖ ≤ C := by
      obtain ⟨n, hn⟩ := (H.biUnion I).exists_nat_subset_range
      have he (k : ℕ) (hk : k ∈ H) : v k = (s n).1 (A k) := by
        have hkn : I k ⊆ Finset.range n := fun i hi => hn (Finset.mem_biUnion.mpr ⟨k, hk, hi⟩)
        change (w k).1 (A k) = (s n).1 (A k)
        rw [hw_cut k n hkn, μ.alpha_cut_apply]
        rw [show (G k).inter (A k) = A k from Subtype.ext (inter_eq_right.mpr (hAG k))]
      have hs := MeasSet.finite_add_of_pair (fun E => (s n).1 E) (μ.alpha_empty_eval (s n))
        (fun B C hd => μ.alpha_union_eval B C hd (s n)) A hAdis H
      rw [Finset.sum_congr rfl he, ← hs]
      exact ((s n).1.norm_coe_le_norm _).trans (hC n)
    have hV (f : Dual X) : Summable (fun k => |f (v k)|) := by
      refine summable_of_sum_le (fun _ => abs_nonneg _) (c := 2 * (‖f‖ * C)) ?_
      apply real_abs_finite_subsum_le
      intro H
      rw [← map_sum]
      exact (f.le_opNorm _).trans (mul_le_mul_of_nonneg_left (hv_bound H) (norm_nonneg f))
    have ht := (hX v hV).tendsto_atTop_zero
    have htn : Tendsto (fun k => ‖v k‖) atTop (𝓝 (0 : ℝ)) := by
      simpa only [norm_zero] using ht.norm
    obtain ⟨k, hk⟩ := ((tendsto_order.mp htn).2 (ε / 2) (by linarith)).exists
    exact (not_lt_of_ge (hlarge k).le) hk

theorem OVM.alpha_boundedlyComplete_of_weaklySeqComplete [CompleteSpace X]
    (μ : OVM Ω X) (hX : WeaklySeqComplete X) : μ.BoundedlyComplete :=
  μ.alpha_boundedlyComplete_of_unconditional (summable_of_weaklySeqComplete_of_abs_dual hX)

#print axioms OVM.alpha_boundedlyComplete_of_unconditional
#print axioms OVM.alpha_boundedlyComplete_of_weaklySeqComplete

/-- The supremum norm formula used in the minimal-dilation estimates. -/
theorem OVM.alpha_norm_eq_sSup_eval [CompleteSpace X] (μ : OVM Ω X) (η : μ.alphaSubmodule) :
    ‖η‖ = sSup (Set.range fun E : MeasSet Ω => ‖μ.alphaSynthesis (μ.alphaRestriction E η)‖) := by
  have h (E : MeasSet Ω) : μ.alphaSynthesis (μ.alphaRestriction E η) = η.1 E := by
    change η.1 (E.inter MeasSet.whole) = η.1 E
    rw [show E.inter MeasSet.whole = E from Subtype.ext (inter_univ _)]
  simp_rw [h]
  have hb : BddAbove (Set.range fun E : MeasSet Ω => ‖η.1 E‖) := by
    refine ⟨‖η‖, ?_⟩
    rintro _ ⟨E, rfl⟩
    exact η.1.norm_coe_le_norm E
  have hle (E : MeasSet Ω) : ‖η.1 E‖ ≤ sSup (Set.range fun E : MeasSet Ω => ‖η.1 E‖) :=
    le_csSup hb ⟨E, rfl⟩
  apply le_antisymm
  · exact (BoundedContinuousFunction.norm_le_of_nonempty (f := η.1)).mpr hle
  · refine csSup_le ⟨_, ⟨MeasSet.empty, rfl⟩⟩ ?_
    rintro _ ⟨E, rfl⟩
    exact η.1.norm_coe_le_norm E

#print axioms OVM.alpha_norm_eq_sSup_eval

end MinimalDilation

#print axioms OVM.alphaCompression
/-- A measurable set on which a scalar orbit measure vanishes, including
all measurable subsets. -/
def OVM.scalarOrbitNull (μ : OVM Ω X) (u : X) (f : Dual X) (A : MeasSet Ω) : Prop :=
  ∀ E : MeasSet Ω, E.1 ⊆ A.1 → f (μ.val E u) = 0

theorem OVM.scalarOrbitNull_mono (μ : OVM Ω X) {u : X} {f : Dual X} {A B : MeasSet Ω}
    (h : μ.scalarOrbitNull u f B) (hAB : A.1 ⊆ B.1) : μ.scalarOrbitNull u f A :=
  fun E hE => h E (hE.trans hAB)

theorem OVM.scalarOrbitNull_iUnion (μ : OVM Ω X) {u : X} {f : Dual X}
    (A : ℕ → MeasSet Ω) (hA : ∀ n, μ.scalarOrbitNull u f (A n)) :
    μ.scalarOrbitNull u f (MeasSet.iUnion A) := by
  intro E hE
  let B (n : ℕ) : MeasSet Ω :=
    ⟨disjointed (fun k => (A k).1) n, MeasurableSet.disjointed (fun k => (A k).2) n⟩
  let C (n : ℕ) := E.inter (B n)
  have hB : MeasSet.DisjointSeq B := disjoint_disjointed _
  have hC : MeasSet.DisjointSeq C := fun i j hij =>
    (hB hij).mono inter_subset_right inter_subset_right
  have hu : MeasSet.iUnion C = E := by
    apply Subtype.ext
    change (⋃ n, E.1 ∩ disjointed (fun k => (A k).1) n) = E.1
    rw [← inter_iUnion, iUnion_disjointed, inter_eq_left.mpr (show E.1 ⊆ ⋃ k, (A k).1 from hE)]
  have hval (n : ℕ) : f (μ.val (C n) u) = 0 :=
    hA n _ (inter_subset_right.trans (disjointed_subset (fun k => (A k).1) n))
  have ht := (μ.countably_additive C hC u).map f f.continuous
  change HasSum (fun n => f (μ.val (C n) u)) (f (μ.val (MeasSet.iUnion C) u)) at ht
  rw [funext hval, hu] at ht
  exact ht.unique hasSum_zero

/-- For each positive threshold, finitely many coefficient measures
detect all orbit values larger than that threshold. -/
theorem OVM.exists_finite_scalarOrbitDetectors (μ : OVM Ω X) (u : X) (ε : ℝ) (hε : 0 < ε) :
    ∃ F : Finset (Dual X), ∀ A : MeasSet Ω,
      (∀ f ∈ F, μ.scalarOrbitNull u f A) → ‖μ.val A u‖ ≤ ε := by
  classical
  by_contra h
  push Not at h
  have step (F : Finset (Dual X)) :
      ∃ A : MeasSet Ω, ∃ f : Dual X, (∀ g ∈ F, μ.scalarOrbitNull u g A) ∧
        ‖f‖ = 1 ∧ ε < f (μ.val A u) := by
    obtain ⟨A, hA, hlarge⟩ := h F
    obtain ⟨f, hf, hfx⟩ := exists_dual_vector ℝ (μ.val A u) (ne_of_gt (hε.trans hlarge))
    exact ⟨A, f, hA, hf, hfx.symm ▸ hlarge⟩
  let states : ℕ → Finset (Dual X) :=
    Nat.rec ∅ (fun _ F => insert (step F).choose_spec.choose F)
  let A (n : ℕ) := (step (states n)).choose
  let f (n : ℕ) := (step (states n)).choose_spec.choose
  have hs (n : ℕ) : (∀ g ∈ states n, μ.scalarOrbitNull u g (A n)) ∧
      ‖f n‖ = 1 ∧ ε < f n (μ.val (A n) u) :=
    (step (states n)).choose_spec.choose_spec
  have hmono : Monotone states := monotone_nat_of_le_succ fun n => Finset.subset_insert _ _
  have hnull (n k : ℕ) (hnk : n < k) : μ.scalarOrbitNull u (f n) (A k) :=
    (hs k).1 _ (hmono hnk (Finset.mem_insert_self _ _))
  let tail (n : ℕ) := MeasSet.iUnion (fun k => A (n + 1 + k))
  let D (n : ℕ) := (A n).diff (tail n)
  have hdis : MeasSet.DisjointSeq D := by
    apply Pairwise.of_lt
    intro n k hnk
    apply Set.disjoint_left.mpr
    intro ω hn hk
    apply hn.2
    have hpos : n + 1 ≤ k := hnk
    refine mem_iUnion.mpr ⟨k - (n + 1), ?_⟩
    change ω ∈ (A (n + 1 + (k - (n + 1)))).1
    rw [Nat.add_sub_of_le hpos]
    exact hk.1
  have hl (n : ℕ) : ε < ‖μ.val (D n) u‖ := by
    have hnull' : μ.scalarOrbitNull u (f n) (tail n) :=
      μ.scalarOrbitNull_iUnion _ (fun k => hnull n _ (by omega))
    have he : (D n).union ((A n).inter (tail n)) = A n := by
      apply Subtype.ext
      ext ω
      change ((ω ∈ (A n).1 ∧ ω ∉ (tail n).1) ∨
        (ω ∈ (A n).1 ∧ ω ∈ (tail n).1)) ↔ ω ∈ (A n).1
      tauto
    have hd : Disjoint (D n).1 ((A n).inter (tail n)).1 :=
      Set.disjoint_left.mpr fun _ hd hi => hd.2 hi.2
    have hscalar : f n (μ.val (A n) u) = f n (μ.val (D n) u) := by
      conv_lhs => rw [← he, μ.apply_union _ _ hd]
      have hz := hnull' ((A n).inter (tail n)) inter_subset_right
      rw [map_add, hz, add_zero]
    have hn : f n (μ.val (D n) u) ≤ ‖μ.val (D n) u‖ := by
      have hb := (f n).le_opNorm (μ.val (D n) u)
      rw [(hs n).2.1, one_mul] at hb
      exact (le_abs_self _).trans hb
    exact ((hs n).2.2.trans_eq hscalar).trans_le hn
  have hsum := (μ.countably_additive D hdis u).summable.tendsto_atTop_zero
  have hlim : Tendsto (fun n => ‖μ.val (D n) u‖) atTop (𝓝 (0 : ℝ)) := by
    simpa only [norm_zero] using hsum.norm
  obtain ⟨n, hn⟩ := ((tendsto_order.mp hlim).2 ε hε).exists
  exact (not_lt_of_ge (hl n).le) hn

/-- A countable family of scalar orbit measures detects every null
projection of a cyclic representation. -/
theorem PVM.exists_countable_faithful_coefficients (P : PVM Ω X) {u : X}
    (hu : P.CyclicVector u) :
    ∃ F : Set (Dual X), F.Countable ∧ ∀ A : MeasSet Ω,
      (∀ f ∈ F, P.toOVM.scalarOrbitNull u f A) ↔ P.val A = 0 := by
  classical
  choose F hF using fun n : ℕ =>
    P.toOVM.exists_finite_scalarOrbitDetectors u (1 / ((n : ℝ) + 1)) (by positivity)
  let G := ⋃ n, (F n : Set (Dual X))
  refine ⟨G, Set.countable_iUnion (fun n => (F n).finite_toSet.countable), fun A => ?_⟩
  constructor
  · intro h
    apply P.zero_of_cyclic_orbit hu A
    intro B
    have hnorm (n : ℕ) : ‖P.val (A.inter B) u‖ ≤ 1 / ((n : ℝ) + 1) :=
      hF n (A.inter B) (fun f hf =>
        P.toOVM.scalarOrbitNull_mono (h f (mem_iUnion.mpr ⟨n, hf⟩)) inter_subset_left)
    exact norm_eq_zero.mp (le_antisymm
      (ge_of_tendsto (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ)) (Eventually.of_forall hnorm))
      (norm_nonneg _))
  · intro h f _ E hE
    have he : A.inter E = E := Subtype.ext (inter_eq_right.mpr hE)
    have hv := congrArg (fun T : X →L[ℝ] X => T u) (P.mul_eq A E)
    change P.val A (P.val E u) = P.val (A.inter E) u at hv
    rw [h, he] at hv
    change f (P.val E u) = 0
    rw [← hv]
    simp

#print axioms OVM.exists_finite_scalarOrbitDetectors
#print axioms PVM.exists_countable_faithful_coefficients

/-- Coefficient charge of a bidual vector in §2. -/
noncomputable def OVM.coefficientCharge [CompleteSpace X] (μ : OVM Ω X)
    (ξ : Bidual X) (f : Dual X) : ScalarCharge Ω where
  val E := ξ (adjoint (μ.val E) f)
  empty_eq := by simp [μ.empty_eq, adjoint]
  add_union A B h := by
    have he : adjoint (μ.val (A.union B)) f =
        adjoint (μ.val A) f + adjoint (μ.val B) f := by
      ext x
      change f (μ.val (A.union B) x) = f (μ.val A x) + f (μ.val B x)
      rw [μ.apply_union A B h, map_add]
    rw [he, map_add]
  bounded := by
    refine ⟨‖ξ‖ * (‖f‖ * μ.uniformNorm), fun E => ?_⟩
    rw [← Real.norm_eq_abs]
    exact (ξ.le_opNorm _).trans (mul_le_mul_of_nonneg_left
      ((f.opNorm_comp_le (μ.val E)).trans
        (mul_le_mul_of_nonneg_left (μ.opNorm_le_uniformNorm E) (norm_nonneg f))) (norm_nonneg ξ))

/-- A signed orbit coefficient can be replaced by a positive one with
the same null sets, using its Hahn decomposition. -/
theorem PVM.exists_positive_orbitFunctional [CompleteSpace X] (P : PVM Ω X)
    (u : X) (f : Dual X) :
    ∃ g : Dual X, (∀ E : MeasSet Ω, 0 ≤ g (P.val E u)) ∧
      ∀ E : MeasSet Ω, g (P.val E u) = 0 ↔ P.toOVM.scalarOrbitNull u f E := by
  let m := P.toOVM.coefficientCharge (J u) f
  have hca : m.CountablyAdditive := fun E hE => P.toOVM.normal_J u E hE f
  obtain ⟨A, hpos, hneg⟩ := m.exists_hahn hca
  let B : MeasSet Ω := ⟨A.1ᶜ, A.2.compl⟩
  let g := adjoint (P.val A) f - adjoint (P.val B) f
  have hvalue (E : MeasSet Ω) :
      g (P.val E u) = m.val (E.inter A) - m.val (E.inter B) := by
    change f (P.val A (P.val E u)) - f (P.val B (P.val E u)) =
      f (P.val (E.inter A) u) - f (P.val (E.inter B) u)
    have he := congrArg (fun T : X →L[ℝ] X => T u) (P.mul_eq A E)
    have he' := congrArg (fun T : X →L[ℝ] X => T u) (P.mul_eq B E)
    change P.val A (P.val E u) = P.val (A.inter E) u at he
    change P.val B (P.val E u) = P.val (B.inter E) u at he'
    rw [he, he', MeasSet.inter_comm A E, MeasSet.inter_comm B E]
  have hpositive (E : MeasSet Ω) : 0 ≤ g (P.val E u) := by
    rw [hvalue]
    exact sub_nonneg.mpr ((hneg _ inter_subset_right).trans (hpos _ inter_subset_right))
  refine ⟨g, hpositive, fun E => ?_⟩
  constructor
  · intro hE F hFE
    let q := P.toOVM.coefficientCharge (J u) g
    have hq : q.Positive := hpositive
    have hF : q.val F = 0 := le_antisymm ((q.val_mono hq hFE).trans_eq hE) (hq F)
    change g (P.val F u) = 0 at hF
    rw [hvalue] at hF
    have h₁ : 0 ≤ m.val (F.inter A) := hpos _ inter_subset_right
    have h₂ : m.val (F.inter B) ≤ 0 := hneg _ inter_subset_right
    have hu : (F.inter A).union (F.inter B) = F := by
      apply Subtype.ext
      change F.1 ∩ A.1 ∪ F.1 ∩ A.1ᶜ = F.1
      rw [← Set.inter_union_distrib_left, union_compl_self, inter_univ]
    have hd : Disjoint (F.inter A).1 (F.inter B).1 :=
      Set.disjoint_left.mpr fun _ ha hb => hb.2 ha.2
    change m.val F = 0
    have he : m.val F = m.val (F.inter A) + m.val (F.inter B) :=
      (congrArg m.val hu.symm).trans (m.add_union _ _ hd)
    linarith
  · intro hE
    rw [hvalue]
    change f (P.val (E.inter A) u) - f (P.val (E.inter B) u) = 0
    rw [hE _ inter_subset_left, hE _ inter_subset_left, sub_self]

/-- Manuscript, eq:faithful-control. The scalar coefficient of one
continuous functional is a finite positive faithful measure. -/
theorem PVM.exists_faithful_positive_coefficient [CompleteSpace X] (P : PVM Ω X)
    {u : X} (hu : P.CyclicVector u) :
    ∃ ρ : MeasureTheory.Measure Ω, MeasureTheory.IsFiniteMeasure ρ ∧ ∃ g : Dual X,
      (∀ E : MeasSet Ω, (ρ E.1).toReal = g (P.val E u)) ∧
      (∀ E : MeasSet Ω, ρ E.1 = 0 ↔ P.val E = 0) := by
  obtain ⟨F, hF, hdetect⟩ := P.exists_countable_faithful_coefficients hu
  obtain ⟨f, hf⟩ := (hF.insert (0 : Dual X)).exists_eq_range ⟨0, mem_insert _ _⟩
  choose g hg hnull using fun n => P.exists_positive_orbitFunctional u (f n)
  let a (n : ℕ) : ℝ := (1 / 2 : ℝ) ^ n / (1 + ‖g n‖)
  have ha (n : ℕ) : 0 < a n := div_pos (pow_pos (by norm_num) _) (by positivity)
  have hs : Summable (fun n => a n • g n) := by
    apply Summable.of_norm
    apply (summable_geometric_of_lt_one (by norm_num : 0 ≤ (1 / 2 : ℝ)) (by norm_num)).of_nonneg_of_le
      (fun _ => norm_nonneg _)
    intro n
    rw [norm_smul, Real.norm_of_nonneg (ha n).le]
    dsimp [a]
    rw [div_mul_eq_mul_div, div_le_iff₀ (by positivity)]
    exact mul_le_mul_of_nonneg_left (le_add_of_nonneg_left zero_le_one) (by positivity)
  let G := ∑' n, a n • g n
  let m := P.toOVM.coefficientCharge (J u) G
  have hval (E : MeasSet Ω) : HasSum (fun n => a n * g n (P.val E u)) (m.val E) := by
    have h := hs.hasSum.map (J (P.val E u)) (J (P.val E u)).continuous
    exact h
  have hpositive (E : MeasSet Ω) : 0 ≤ m.val E := by
    rw [← (hval E).tsum_eq]
    exact tsum_nonneg fun n => mul_nonneg (ha n).le (hg n E)
  have hca : m.CountablyAdditive := fun E hE => P.toOVM.normal_J u E hE G
  let ρ := m.toMeasure hpositive
  refine ⟨ρ, ScalarCharge.finite_toMeasure m hpositive, G, ?_, ?_⟩
  · intro E
    change (m.toMeasure hpositive E.1).toReal = m.val E
    rw [m.toMeasure_apply_charge hpositive hca E, ENNReal.toReal_ofReal (hpositive E)]
  · intro E
    change m.toMeasure hpositive E.1 = 0 ↔ P.val E = 0
    rw [m.toMeasure_apply_charge hpositive hca E, ENNReal.ofReal_eq_zero]
    constructor
    · intro hE
      apply (hdetect E).mp
      intro f' hf'
      have hf'' : f' ∈ Set.range f := by rw [← hf]; exact mem_insert_of_mem _ hf'
      obtain ⟨n, rfl⟩ := hf''
      apply (hnull n E).mp
      have hb := (hval E).summable.le_tsum n (fun j _ => mul_nonneg (ha j).le (hg j E))
      rw [(hval E).tsum_eq] at hb
      exact le_antisymm (nonpos_of_mul_nonpos_right (hb.trans hE) (ha n)) (hg n E)
    · intro hE
      change G (P.val E u) ≤ 0
      rw [hE]
      simp

#print axioms PVM.exists_positive_orbitFunctional
#print axioms PVM.exists_faithful_positive_coefficient

/-- The scalar derivatives \(g_f\) and \(h\) of §2 exist relative to the
faithful scalar measure. This statement applies to any normal bidual
coefficient, including canonical evaluations \(J(u)\). -/
theorem PVM.exists_normalCoefficient_density [CompleteSpace X] (P : PVM Ω X)
    (ρ : MeasureTheory.Measure Ω) [MeasureTheory.IsFiniteMeasure ρ]
    (hρ : ∀ E : MeasSet Ω, ρ E.1 = 0 → P.val E = 0)
    (ξ : Bidual X) (hξ : P.toOVM.Normal ξ) (f : Dual X) :
    ∃ h : Ω → ℝ, Measurable h ∧ MeasureTheory.Integrable h ρ ∧
      ∀ E : MeasSet Ω, ξ (adjoint (P.val E) f) = ∫ t in E.1, h t ∂ρ := by
  let m := P.toOVM.coefficientCharge ξ f
  have hca : m.CountablyAdditive := fun E hE => hξ E hE f
  apply m.exists_rnDensity hca ρ
  intro E hE
  change ξ (adjoint (P.val E) f) = 0
  simp [hρ E hE, adjoint]

#print axioms PVM.exists_normalCoefficient_density

/-- Evaluation of a finite multiplier against a scalar Radon–Nikodym
coefficient, the simple-function identity in prop:cyclic-normal. -/
theorem OVM.coefficient_finiteMultiplier_integral (μ : OVM Ω X) (ξ : Bidual X)
    (f : Dual X) (ρ : MeasureTheory.Measure Ω) (h : Ω → ℝ)
    (hdensity : ∀ E : MeasSet Ω, ξ (adjoint (μ.val E) f) = ∫ t in E.1, h t ∂ρ)
    {ι : Type*} (B : ι → MeasSet Ω) (I : Finset ι) (a : ι → ℝ) :
    ξ (adjoint (∑ n ∈ I, a n • μ.val (B n)) f) =
      ∑ n ∈ I, ∫ t in (B n).1, a n * h t ∂ρ := by
  have he : adjoint (∑ n ∈ I, a n • μ.val (B n)) f =
      ∑ n ∈ I, a n • adjoint (μ.val (B n)) f := by
    ext x
    simp only [adjoint, ContinuousLinearMap.comp_apply, sum_apply, smul_apply,
      map_sum, map_smul]
  rw [he, map_sum]
  apply Finset.sum_congr rfl
  intro n _
  rw [map_smul, hdensity, MeasureTheory.integral_const_mul]
  rfl

#print axioms OVM.coefficient_finiteMultiplier_integral

/-- The operator integral of a real simple function, using its measurable
fibres as the partition. -/
noncomputable def OVM.simpleMultiplier (μ : OVM Ω X) (a : MeasureTheory.SimpleFunc Ω ℝ) :
    X →L[ℝ] X :=
  ∑ y ∈ a.range, y • μ.val ⟨a ⁻¹' {y}, a.measurableSet_fiber y⟩

theorem OVM.opNorm_simpleMultiplier_le [CompleteSpace X] (μ : OVM Ω X)
    (a : MeasureTheory.SimpleFunc Ω ℝ) (C : ℝ) (hC : 0 ≤ C)
    (ha : ∀ t : Ω, |a t| ≤ C) : ‖μ.simpleMultiplier a‖ ≤ 2 * μ.uniformNorm * C := by
  classical
  let B (y : a.range) : MeasSet Ω := ⟨a ⁻¹' {(y : ℝ)}, a.measurableSet_fiber y⟩
  have hB : Pairwise fun y z => Disjoint (B y).1 (B z).1 := by
    intro y z hyz
    apply Set.disjoint_left.mpr
    intro ω hw hz
    change a ω = (y : ℝ) at hw
    change a ω = (z : ℝ) at hz
    exact hyz (Subtype.ext (hw.symm.trans hz))
  have hA (y : a.range) : |(y : ℝ)| ≤ C := by
    obtain ⟨x, hxy⟩ := MeasureTheory.SimpleFunc.mem_range.mp y.2
    rw [← hxy]
    exact ha x
  have hsum : μ.simpleMultiplier a = ∑ y : a.range, (y : ℝ) • μ.val (B y) := by
    unfold OVM.simpleMultiplier
    exact (Finset.sum_attach a.range (fun y => y • μ.val ⟨a ⁻¹' {y}, a.measurableSet_fiber y⟩)).symm
  rw [hsum]
  exact μ.opNorm_finite_type_multiplier_le B hB (fun y => (y : ℝ)) C hC hA

theorem OVM.coefficient_simpleMultiplier_integral (μ : OVM Ω X) (ξ : Bidual X)
    (f : Dual X) (ρ : MeasureTheory.Measure Ω) (h : Ω → ℝ)
    (hdensity : ∀ E : MeasSet Ω, ξ (adjoint (μ.val E) f) = ∫ t in E.1, h t ∂ρ)
    (a : MeasureTheory.SimpleFunc Ω ℝ) :
    ξ (adjoint (μ.simpleMultiplier a) f) =
      ∑ y ∈ a.range, ∫ t in (a ⁻¹' {y}), y * h t ∂ρ :=
  μ.coefficient_finiteMultiplier_integral ξ f ρ h hdensity
    (fun y => ⟨a ⁻¹' {y}, a.measurableSet_fiber y⟩) a.range id

#print axioms OVM.opNorm_simpleMultiplier_le
#print axioms OVM.coefficient_simpleMultiplier_integral

open MeasureTheory in
private theorem OVM.simpleMultiplier_sub (μ : OVM Ω X) (a b : SimpleFunc Ω ℝ) :
    μ.simpleMultiplier (a - b) = μ.simpleMultiplier a - μ.simpleMultiplier b := by
  classical
  let T (E : Set Ω) : ℝ →L[ℝ] (X →L[ℝ] X) :=
    if h : MeasurableSet E then (ContinuousLinearMap.id ℝ ℝ).smulRight (μ.val ⟨E, h⟩) else 0
  have hT (E : MeasSet Ω) : T E.1 = (ContinuousLinearMap.id ℝ ℝ).smulRight (μ.val E) := by
    simp [T, E.2]
  have hadd : FinMeasAdditive (0 : Measure Ω) T := by
    intro E F hE hF _ _ hd
    have he : μ.val (MeasSet.union ⟨E, hE⟩ ⟨F, hF⟩) =
        μ.val ⟨E, hE⟩ + μ.val ⟨F, hF⟩ := by
      ext x
      exact μ.apply_union ⟨E, hE⟩ ⟨F, hF⟩ hd x
    have e : T (E ∪ F) = (ContinuousLinearMap.id ℝ ℝ).smulRight (μ.val ⟨E ∪ F, hE.union hF⟩) :=
      hT ⟨E ∪ F, hE.union hF⟩
    rw [e, hT ⟨E, hE⟩, hT ⟨F, hF⟩]
    apply ContinuousLinearMap.ext
    intro r
    apply ContinuousLinearMap.ext
    intro x
    have hx := congrArg (fun L : X →L[ℝ] X => (r • L) x) he
    change (r • μ.val (MeasSet.union ⟨E, hE⟩ ⟨F, hF⟩)) x =
      (r • μ.val ⟨E, hE⟩ + r • μ.val ⟨F, hF⟩) x
    rw [← smul_add]
    exact hx
  have hdef (g : SimpleFunc Ω ℝ) : g.setToSimpleFunc T = μ.simpleMultiplier g := by
    unfold SimpleFunc.setToSimpleFunc OVM.simpleMultiplier
    apply Finset.sum_congr rfl
    intro y _
    rw [hT ⟨g ⁻¹' {y}, g.measurableSet_fiber y⟩]
    rfl
  rw [← hdef, ← hdef, ← hdef]
  exact SimpleFunc.setToSimpleFunc_sub T hadd a.integrable_of_isFiniteMeasure b.integrable_of_isFiniteMeasure

open MeasureTheory in
private theorem OVM.coefficient_simpleMultiplier_integral_all (μ : OVM Ω X) (ξ : Bidual X)
    (f : Dual X) (ρ : Measure Ω) (h : Ω → ℝ) (hh : Integrable h ρ)
    (hdensity : ∀ E : MeasSet Ω, ξ (adjoint (μ.val E) f) = ∫ t in E.1, h t ∂ρ)
    (a : SimpleFunc Ω ℝ) :
    ξ (adjoint (μ.simpleMultiplier a) f) = ∫ t, a t * h t ∂ρ := by
  rw [μ.coefficient_simpleMultiplier_integral ξ f ρ h hdensity]
  let g (y : ℝ) := (a ⁻¹' {y}).indicator (fun t => y * h t)
  have he : (fun t => a t * h t) = fun t => ∑ y ∈ a.range, g y t := by
    funext t
    have hm : a t ∈ a.range := SimpleFunc.mem_range.mpr ⟨t, rfl⟩
    rw [Finset.sum_eq_single_of_mem (a t) hm]
    · simp [g]
    · intro y _ hne
      exact Set.indicator_of_notMem (fun hmem : a t = y => hne hmem.symm) _
  rw [he, integral_finsetSum _ (fun y _ => (hh.const_mul y).indicator (a.measurableSet_fiber y))]
  apply Finset.sum_congr rfl
  intro y _
  exact (integral_indicator (a.measurableSet_fiber y)).symm

open MeasureTheory in
/-- Approximate a bounded measurable real function by measurable simple
functions with a uniform error of at most \(1/(n+1)\). -/
theorem exists_uniform_simpleApprox (a : Ω → ℝ) (ha : Measurable a)
    (C : ℝ) (hC : ∀ t, |a t| ≤ C) :
    ∃ p : ℕ → SimpleFunc Ω ℝ, ∀ n t, |p n t - a t| ≤ 1 / ((n : ℝ) + 1) := by
  have h (n : ℕ) : ∃ f : SimpleFunc Ω ℝ, ∀ t, |f t - a t| ≤ 1 / ((n : ℝ) + 1) := by
    let d : ℝ := (n : ℝ) + 1
    have hd : 0 < d := by dsimp [d]; positivity
    let g : Ω → ℤ := fun t => ⌊d * a t⌋
    have hm : Measurable (fun t => d * a t) := measurable_const.mul ha
    have hpre (j : ℤ) : g ⁻¹' {j} = (fun t => d * a t) ⁻¹' Ico (j : ℝ) ((j : ℝ) + 1) := by
      ext t
      change ⌊d * a t⌋ = j ↔ d * a t ∈ Ico (j : ℝ) ((j : ℝ) + 1)
      exact Int.floor_eq_iff
    have hf : (Set.range g).Finite := by
      refine (Set.finite_Icc (⌊d * (-C)⌋ : ℤ) (⌊d * C⌋ : ℤ)).subset ?_
      rintro _ ⟨t, rfl⟩
      exact ⟨Int.floor_mono (mul_le_mul_of_nonneg_left ((abs_le.mp (hC t)).1) hd.le),
        Int.floor_mono (mul_le_mul_of_nonneg_left ((abs_le.mp (hC t)).2) hd.le)⟩
    let q : SimpleFunc Ω ℤ := ⟨g, fun j => by rw [hpre]; exact hm measurableSet_Ico, hf⟩
    let f := q.map fun j : ℤ => (j : ℝ) / d
    refine ⟨f, fun t => ?_⟩
    have h₁ : (⌊d * a t⌋ : ℝ) / d ≤ a t := by
      apply (div_le_iff₀ hd).mpr
      simpa only [mul_comm] using Int.floor_le (d * a t)
    have h₂ : a t - (⌊d * a t⌋ : ℝ) / d ≤ 1 / d := by
      apply (le_div_iff₀ hd).mpr
      rw [sub_mul, div_mul_cancel₀ _ hd.ne']
      linarith [Int.lt_floor_add_one (d * a t)]
    change |(⌊d * a t⌋ : ℝ) / d - a t| ≤ 1 / d
    rw [abs_sub_comm, abs_of_nonneg (sub_nonneg.mpr h₁)]
    exact h₂
  choose p hp using h
  exact ⟨p, hp⟩

#print axioms exists_uniform_simpleApprox

open MeasureTheory in
/-- Bounded measurable multipliers are obtained by operator-norm limits of
simple multipliers. Their scalar evaluations are integrals against the
corresponding coefficient densities. -/
theorem OVM.exists_invariant_boundedMultiplier [CompleteSpace X] (μ : OVM Ω X)
    (a : Ω → ℝ) (ha : Measurable a) (C : ℝ) (hC : ∀ t, |a t| ≤ C) :
    ∃ T : X →L[ℝ] X,
      (∀ Y : Submodule ℝ X, IsClosed (Y : Set X) →
        (∀ E : MeasSet Ω, ∀ x ∈ Y, μ.val E x ∈ Y) → ∀ x ∈ Y, T x ∈ Y) ∧
      ∀ (ξ : Bidual X) (f : Dual X) (ρ : Measure Ω) (h : Ω → ℝ),
      Integrable h ρ →
      (∀ E : MeasSet Ω, ξ (adjoint (μ.val E) f) = ∫ t in E.1, h t ∂ρ) →
      ξ (adjoint T f) = ∫ t, a t * h t ∂ρ := by
  obtain ⟨p, hp⟩ := exists_uniform_simpleApprox a ha C hC
  let δ (n : ℕ) : ℝ := 1 / ((n : ℝ) + 1)
  have hδ₀ (n : ℕ) : 0 ≤ δ n := by dsimp [δ]; positivity
  have hδ : Tendsto δ atTop (𝓝 0) := tendsto_one_div_add_atTop_nhds_zero_nat
  let S (n : ℕ) := μ.simpleMultiplier (p n)
  have hc : CauchySeq S := by
    apply Metric.cauchySeq_iff.mpr
    intro ε hε
    have ht : Tendsto (fun n => (2 * μ.uniformNorm) * δ n) atTop (𝓝 (0 : ℝ)) := by
      simpa only [mul_zero] using (tendsto_const_nhds (x := 2 * μ.uniformNorm)).mul hδ
    obtain ⟨N, hN⟩ := eventually_atTop.mp ((tendsto_order.mp ht).2 (ε / 2) (by linarith))
    refine ⟨N, fun n hn m hm => ?_⟩
    rw [dist_eq_norm]
    change ‖μ.simpleMultiplier (p n) - μ.simpleMultiplier (p m)‖ < ε
    rw [← μ.simpleMultiplier_sub]
    have hb : ‖μ.simpleMultiplier (p n - p m)‖ ≤ 2 * μ.uniformNorm * (δ n + δ m) := by
      apply μ.opNorm_simpleMultiplier_le _ _ (add_nonneg (hδ₀ n) (hδ₀ m))
      intro t
      change |p n t - p m t| ≤ δ n + δ m
      rw [show p n t - p m t = (p n t - a t) + (a t - p m t) by ring]
      exact (abs_add_le _ _).trans (add_le_add (hp n t) (by rw [abs_sub_comm]; exact hp m t))
    exact hb.trans_lt (by
      rw [mul_add]
      linarith [hN n hn, hN m hm])
  obtain ⟨T, hT⟩ := cauchySeq_tendsto_of_complete hc
  refine ⟨T, ?_, fun ξ f ρ h hh hdens => ?_⟩
  · intro Y hY hInv x hx
    let L := ContinuousLinearMap.apply ℝ X x
    have hlim := (L.continuous.tendsto T).comp hT
    apply hY.mem_of_tendsto hlim
    apply Eventually.of_forall
    intro n
    change μ.simpleMultiplier (p n) x ∈ Y
    unfold OVM.simpleMultiplier
    simp only [sum_apply, smul_apply]
    exact Y.sum_mem fun y _ => Y.smul_mem y (hInv _ x hx)
  let L : (X →L[ℝ] X) →L[ℝ] ℝ := ξ.comp (ContinuousLinearMap.compL ℝ X X ℝ f)
  have hleft := (L.continuous.tendsto T).comp hT
  change Tendsto (fun n => ξ (adjoint (μ.simpleMultiplier (p n)) f)) atTop (𝓝 (ξ (adjoint T f))) at hleft
  simp_rw [μ.coefficient_simpleMultiplier_integral_all ξ f ρ h hh hdens] at hleft
  have hF : Integrable (fun t => a t * h t) ρ :=
    hh.bdd_mul (c := C) ha.aestronglyMeasurable (Eventually.of_forall fun t => by
      simpa only [Real.norm_eq_abs] using hC t)
  have hFn (n : ℕ) : Integrable (fun t => p n t * h t) ρ :=
    hh.bdd_mul (c := δ n + C) (p n).measurable.aestronglyMeasurable (Eventually.of_forall fun t => by
      change |p n t| ≤ δ n + C
      rw [show p n t = (p n t - a t) + a t by ring]
      exact (abs_add_le _ _).trans (add_le_add (hp n t) (hC t)))
  have hright : Tendsto (fun n => ∫ t, p n t * h t ∂ρ) atTop (𝓝 (∫ t, a t * h t ∂ρ)) := by
    have ht : Tendsto (fun n => δ n * ∫ t, ‖h t‖ ∂ρ) atTop (𝓝 (0 : ℝ)) := by
      simpa only [zero_mul] using hδ.mul (tendsto_const_nhds (x := ∫ t, ‖h t‖ ∂ρ))
    apply Metric.tendsto_atTop.mpr
    intro ε hε
    obtain ⟨N, hN⟩ := eventually_atTop.mp ((tendsto_order.mp ht).2 ε hε)
    refine ⟨N, fun n hn => ?_⟩
    rw [dist_eq_norm, ← integral_sub (hFn n) hF]
    have hb : ∫ t, ‖p n t * h t - a t * h t‖ ∂ρ ≤ ∫ t, δ n * ‖h t‖ ∂ρ := by
      apply integral_mono_ae ((hFn n).sub hF).norm (hh.norm.const_mul _)
      filter_upwards with t
      change ‖p n t * h t - a t * h t‖ ≤ δ n * ‖h t‖
      rw [← sub_mul, norm_mul, Real.norm_eq_abs (p n t - a t)]
      exact mul_le_mul_of_nonneg_right (hp n t) (norm_nonneg _)
    exact ((norm_integral_le_integral_norm _).trans hb).trans_lt (by
      rw [integral_const_mul]
      exact hN n hn)
  exact tendsto_nhds_unique hleft hright

open MeasureTheory in
theorem OVM.exists_boundedMultiplier [CompleteSpace X] (μ : OVM Ω X)
    (a : Ω → ℝ) (ha : Measurable a) (C : ℝ) (hC : ∀ t, |a t| ≤ C) :
    ∃ T : X →L[ℝ] X, ∀ (ξ : Bidual X) (f : Dual X) (ρ : Measure Ω) (h : Ω → ℝ),
      Integrable h ρ →
      (∀ E : MeasSet Ω, ξ (adjoint (μ.val E) f) = ∫ t in E.1, h t ∂ρ) →
      ξ (adjoint T f) = ∫ t, a t * h t ∂ρ := by
  obtain ⟨T, _, hT⟩ := μ.exists_invariant_boundedMultiplier a ha C hC
  exact ⟨T, hT⟩

#print axioms OVM.exists_boundedMultiplier

private theorem ScalarCharge.tendsto_of_increasing (m : ScalarCharge Ω) (hm : m.CountablyAdditive)
    (A : ℕ → MeasSet Ω) (hA : Monotone (fun n => (A n).1)) :
    Tendsto (fun n => m.val (A n)) atTop (𝓝 (m.val (MeasSet.iUnion A))) := by
  let B (n : ℕ) : MeasSet Ω :=
    ⟨disjointed (fun k => (A k).1) n, MeasurableSet.disjointed (fun k => (A k).2) n⟩
  have hB : MeasSet.DisjointSeq B := disjoint_disjointed _
  have hcover : MeasSet.iUnion B = MeasSet.iUnion A := Subtype.ext iUnion_disjointed
  have ht := (hm B hB).tendsto_sum_nat.comp (tendsto_add_atTop_nat 1)
  have he : (fun N => (∑ n ∈ Finset.range N, m.val (B n))) ∘ (fun N => N + 1) =
      fun N => m.val (A N) := by
    funext N
    change (∑ n ∈ Finset.range (N + 1), m.val (B n)) = m.val (A N)
    rw [← m.finite_add B hB]
    exact congrArg m.val (Subtype.ext (disjointed_initial_union _ hA N))
  rw [he, hcover] at ht
  exact ht

private theorem PVM.eq_dual_of_cyclic_orbit (P : PVM Ω X) {u : X} (hu : P.CyclicVector u)
    (f g : Dual X) (hfg : ∀ E : MeasSet Ω, f (P.val E u) = g (P.val E u)) : f = g := by
  ext x
  have hc : IsClosed {x : X | f x = g x} := isClosed_eq f.continuous g.continuous
  apply closure_minimal _ hc (hu x)
  intro y hy
  induction hy using Submodule.span_induction with
  | mem y hy => obtain ⟨E, rfl⟩ := hy; exact hfg E
  | zero => change f 0 = g 0; rw [map_zero, map_zero]
  | add y z _ _ hy hz =>
    change f (y + z) = g (y + z)
    rw [map_add, map_add, hy, hz]
  | smul c y _ hy =>
    change f (c • y) = g (c • y)
    rw [map_smul, map_smul, hy]

open MeasureTheory in
private theorem PVM.cyclic_coefficient_of_bounded_g [CompleteSpace X] (P : PVM Ω X)
    {u : X} (hu : P.CyclicVector u) (ρ : Measure Ω) [IsFiniteMeasure ρ]
    (φ : Dual X) (hφ : ∀ E : MeasSet Ω, (ρ E.1).toReal = φ (P.val E u))
    (ξ : Bidual X) (f : Dual X) (h g : Ω → ℝ) (hint : Integrable h ρ)
    (hcoeff : ∀ E : MeasSet Ω, ξ (adjoint (P.val E) φ) = ∫ t in E.1, h t ∂ρ)
    (hgmeas : Measurable g)
    (hg : ∀ E : MeasSet Ω, f (P.val E u) = ∫ t in E.1, g t ∂ρ)
    (B : MeasSet Ω) (C : ℝ) (hC : 0 ≤ C) (hgB : ∀ t ∈ B.1, |g t| ≤ C) :
    ξ (adjoint (P.val B) f) = ∫ t in B.1, g t * h t ∂ρ := by
  have hcut_indicator (E F : MeasSet Ω) :
      φ (P.val E (P.val F u)) = ∫ t in E.1, F.1.indicator (fun _ => (1 : ℝ)) t ∂ρ := by
    have he : P.val E (P.val F u) = P.val (E.inter F) u :=
      congrArg (fun T : X →L[ℝ] X => T u) (P.mul_eq E F)
    rw [he, ← hφ, integral_indicator F.2, Measure.restrict_restrict F.2]
    simp [integral_const, measureReal_def, MeasSet.inter, Set.inter_comm]
  let b := B.1.indicator g
  have hb : Measurable b := hgmeas.indicator B.2
  have hbnd (t : Ω) : |b t| ≤ C := by
    by_cases ht : t ∈ B.1
    · rw [show b t = g t from Set.indicator_of_mem ht _]
      exact hgB t ht
    · rw [show b t = 0 from Set.indicator_of_notMem ht _, abs_zero]
      exact hC
  obtain ⟨U, hU⟩ := P.toOVM.exists_boundedMultiplier b hb C hbnd
  have heq : adjoint (P.val B) f = adjoint U φ := by
    apply P.eq_dual_of_cyclic_orbit hu
    intro F
    have he : P.val B (P.val F u) = P.val (B.inter F) u :=
      congrArg (fun T : X →L[ℝ] X => T u) (P.mul_eq B F)
    change f (P.val B (P.val F u)) = J (P.val F u) (adjoint U φ)
    rw [he]
    have hHg : f (P.val (B.inter F) u) = ∫ t in (B.inter F).1, g t ∂ρ := hg _
    rw [hHg, hU _ _ ρ (F.1.indicator (fun _ => (1 : ℝ))) (integrable_const 1 |>.indicator F.2)]
    · rw [← integral_indicator (B.inter F).2]
      apply integral_congr_ae
      filter_upwards with t
      by_cases hB : t ∈ B.1 <;> by_cases hF : t ∈ F.1 <;>
        simp [b, MeasSet.inter, hB, hF, Set.indicator_of_mem, Set.indicator_of_notMem]
    · intro E
      exact hcut_indicator E F
  rw [heq, hU ξ φ ρ h hint hcoeff, ← integral_indicator B.2]
  apply integral_congr_ae
  filter_upwards with t
  by_cases ht : t ∈ B.1 <;> simp [b, ht]

open MeasureTheory in
private theorem PVM.cyclic_coefficient_of_bounded_h [CompleteSpace X] (P : PVM Ω X)
    {u : X} (hu : P.CyclicVector u) (ρ : Measure Ω) [IsFiniteMeasure ρ]
    (φ : Dual X) (hφ : ∀ E : MeasSet Ω, (ρ E.1).toReal = φ (P.val E u))
    (ξ : Bidual X) (hξ : P.toOVM.Normal ξ) (f : Dual X)
    (h g : Ω → ℝ) (hmeas : Measurable h) (hint : Integrable h ρ)
    (hcoeff : ∀ E : MeasSet Ω, ξ (adjoint (P.val E) φ) = ∫ t in E.1, h t ∂ρ)
    (hgmeas : Measurable g) (hgint : Integrable g ρ)
    (hg : ∀ E : MeasSet Ω, f (P.val E u) = ∫ t in E.1, g t ∂ρ)
    (A : MeasSet Ω) (C : ℝ) (hC : 0 ≤ C) (hA : ∀ t ∈ A.1, |h t| ≤ C) :
    ξ (adjoint (P.val A) f) = ∫ t in A.1, g t * h t ∂ρ := by
  let a := A.1.indicator h
  have ha : Measurable a := hmeas.indicator A.2
  have hbound (t : Ω) : |a t| ≤ C := by
    by_cases ht : t ∈ A.1
    · rw [show a t = h t from Set.indicator_of_mem ht _]
      exact hA t ht
    · rw [show a t = 0 from Set.indicator_of_notMem ht _, abs_zero]
      exact hC
  let trunc (g : Ω → ℝ) (hg : Measurable g) (n : ℕ) : MeasSet Ω :=
    ⟨{t | |g t| ≤ (n : ℝ)}, measurableSet_le (continuous_abs.measurable.comp hg) measurable_const⟩
  have hmono (g : Ω → ℝ) (hg : Measurable g) : Monotone (fun n => (trunc g hg n).1) := by
    intro i j hij t hi
    change |g t| ≤ (i : ℝ) at hi
    change |g t| ≤ (j : ℝ)
    exact hi.trans (Nat.cast_le.mpr hij)
  have hcover (g : Ω → ℝ) (hg : Measurable g) :
      MeasSet.iUnion (trunc g hg) = MeasSet.whole := by
    apply Subtype.ext
    apply Set.eq_univ_of_forall
    intro t
    obtain ⟨n, hn⟩ := exists_nat_ge |g t|
    exact mem_iUnion.mpr ⟨n, hn⟩
  have hmul := P.cyclic_coefficient_of_bounded_g hu ρ φ hφ ξ f h g hint hcoeff hgmeas hg
  let D (k : ℕ) := A.inter (trunc g hgmeas k)
  have hDmono : Monotone (fun k => (D k).1) := fun i j hij _ ht =>
    ⟨ht.1, hmono g hgmeas hij ht.2⟩
  have hDcover : MeasSet.iUnion D = A := by
    apply Subtype.ext
    change (⋃ k, A.1 ∩ (trunc g hgmeas k).1) = A.1
    rw [← inter_iUnion, show (⋃ k, (trunc g hgmeas k).1) = Set.univ from
      congrArg Subtype.val (hcover g hgmeas), inter_univ]
  let m := P.toOVM.coefficientCharge ξ f
  have hca : m.CountablyAdditive := fun E hE => hξ E hE f
  have hleft := m.tendsto_of_increasing hca D hDmono
  rw [hDcover] at hleft
  have hprodA : IntegrableOn (fun t => g t * h t) A.1 ρ := by
    have hb : Integrable (fun t => a t * g t) ρ := hgint.bdd_mul (c := C) ha.aestronglyMeasurable
      (Eventually.of_forall fun t => by simpa only [Real.norm_eq_abs] using hbound t)
    have he : (fun t => a t * g t) = A.1.indicator (fun t => g t * h t) := by
      funext t
      by_cases ht : t ∈ A.1 <;> simp [a, ht, mul_comm]
    rw [he] at hb
    exact (integrable_indicator_iff A.2).mp hb
  have hright := tendsto_setIntegral_of_monotone (fun k => (D k).2) hDmono
    (show IntegrableOn (fun t => g t * h t) (⋃ k, (D k).1) ρ from by
      rw [show (⋃ k, (D k).1) = A.1 from congrArg Subtype.val hDcover]
      exact hprodA)
  rw [show (⋃ k, (D k).1) = A.1 from congrArg Subtype.val hDcover] at hright
  have he (k : ℕ) : m.val (D k) = ∫ t in (D k).1, g t * h t ∂ρ :=
    hmul (D k) (k : ℝ) (by positivity) (fun t ht => ht.2)
  have hmval : m.val A = ∫ t in A.1, g t * h t ∂ρ :=
    tendsto_nhds_unique (by simpa only [he] using hleft) hright
  exact hmval

open MeasureTheory in
/-- Manuscript, eq:normal-density. The variation of the coefficient
charge bounds the absolute integrals of the truncated products. -/
theorem PVM.cyclic_normal_density [CompleteSpace X] (P : PVM Ω X)
    {u : X} (hu : P.CyclicVector u) (ρ : Measure Ω) [IsFiniteMeasure ρ]
    (φ : Dual X) (hφ : ∀ E : MeasSet Ω, (ρ E.1).toReal = φ (P.val E u))
    (ξ : Bidual X) (hξ : P.toOVM.Normal ξ) (f : Dual X)
    (h g : Ω → ℝ) (hmeas : Measurable h) (hint : Integrable h ρ)
    (hcoeff : ∀ E : MeasSet Ω, ξ (adjoint (P.val E) φ) = ∫ t in E.1, h t ∂ρ)
    (hgmeas : Measurable g)
    (hg : ∀ E : MeasSet Ω, f (P.val E u) = ∫ t in E.1, g t ∂ρ) :
    Integrable (fun t => g t * h t) ρ ∧
      ∀ E : MeasSet Ω, ξ (adjoint (P.val E) f) = ∫ t in E.1, g t * h t ∂ρ := by
  let k := fun t => g t * h t
  have hkm : Measurable k := hgmeas.mul hmeas
  let m := P.toOVM.coefficientCharge ξ f
  have hca : m.CountablyAdditive := fun E hE => hξ E hE f
  let D (n : ℕ) : MeasSet Ω := ⟨{t | |g t| ≤ (n : ℝ)},
    measurableSet_le (continuous_abs.measurable.comp hgmeas) measurable_const⟩
  have hmono : Monotone (fun n => (D n).1) := by
    intro i j hij t ht
    exact (show |g t| ≤ (i : ℝ) from ht).trans (Nat.cast_le.mpr hij)
  have hcover : (⋃ n, (D n).1) = Set.univ := by
    apply Set.eq_univ_of_forall
    intro t
    obtain ⟨n, hn⟩ := exists_nat_ge |g t|
    exact mem_iUnion.mpr ⟨n, hn⟩
  have hcut (A : MeasSet Ω) (n : ℕ) (hA : A.1 ⊆ (D n).1) :
      m.val A = ∫ t in A.1, k t ∂ρ :=
    P.cyclic_coefficient_of_bounded_g hu ρ φ hφ ξ f h g hint hcoeff hgmeas hg
      A (n : ℝ) (by positivity) (fun t ht => hA ht)
  have hkD (n : ℕ) : IntegrableOn k (D n).1 ρ := by
    let b := (D n).1.indicator g
    have hm : Measurable b := hgmeas.indicator (D n).2
    have hb : Integrable (fun t => b t * h t) ρ := hint.bdd_mul (c := (n : ℝ))
      hm.aestronglyMeasurable (Eventually.of_forall fun t => by
        by_cases ht : t ∈ (D n).1
        · change ‖(D n).1.indicator g t‖ ≤ _
          rw [Set.indicator_of_mem ht, Real.norm_eq_abs]
          exact ht
        · change ‖(D n).1.indicator g t‖ ≤ _
          rw [Set.indicator_of_notMem ht, norm_zero]
          positivity)
    have he : (fun t => b t * h t) = (D n).1.indicator k := by
      funext t
      by_cases ht : t ∈ (D n).1 <;> simp [b, k, ht]
    rw [he] at hb
    exact (integrable_indicator_iff (D n).2).mp hb
  let p (n : ℕ) : MeasSet Ω := ⟨(D n).1 ∩ {t | 0 ≤ k t},
    (D n).2.inter (measurableSet_le measurable_const hkm)⟩
  let q (n : ℕ) : MeasSet Ω := ⟨(D n).1 ∩ {t | k t < 0},
    (D n).2.inter (measurableSet_lt hkm measurable_const)⟩
  let F (n : ℕ) := (D n).1.indicator (fun t => ‖k t‖)
  have hF (n : ℕ) : Integrable (F n) ρ :=
    (integrable_indicator_iff (D n).2).mpr (hkD n).norm
  have hnonneg (n : ℕ) (t : Ω) : 0 ≤ F n t := by
    by_cases ht : t ∈ (D n).1 <;> simp [F, ht]
  have hbound (n : ℕ) : ∫ t, F n t ∂ρ ≤ m.totalVariationMass := by
    have he : F n = (fun t => (p n).1.indicator k t - (q n).1.indicator k t) := by
      funext t
      by_cases hd : t ∈ (D n).1
      · by_cases hp : 0 ≤ k t
        · have ht : t ∈ (p n).1 := ⟨hd, hp⟩
          have hq : t ∉ (q n).1 := fun ht' => (not_lt_of_ge hp) ht'.2
          rw [show F n t = ‖k t‖ from Set.indicator_of_mem hd _, Set.indicator_of_mem ht,
            Set.indicator_of_notMem hq, sub_zero, Real.norm_eq_abs, abs_of_nonneg hp]
        · have ht : t ∈ (q n).1 := ⟨hd, lt_of_not_ge hp⟩
          have hp' : t ∉ (p n).1 := fun ht' => hp ht'.2
          rw [show F n t = ‖k t‖ from Set.indicator_of_mem hd _, Set.indicator_of_notMem hp',
            Set.indicator_of_mem ht, zero_sub, Real.norm_eq_abs, abs_of_neg (lt_of_not_ge hp)]
      · have hp' : t ∉ (p n).1 := fun ht => hd ht.1
        have hq' : t ∉ (q n).1 := fun ht => hd ht.1
        simp [F, hd, hp', hq']
    have hpInt := (integrable_indicator_iff (p n).2).mpr ((hkD n).mono_set inter_subset_left)
    have hqInt := (integrable_indicator_iff (q n).2).mpr ((hkD n).mono_set inter_subset_left)
    rw [he, integral_sub hpInt hqInt, integral_indicator (p n).2, integral_indicator (q n).2,
      ← hcut (p n) n inter_subset_left, ← hcut (q n) n inter_subset_left]
    exact add_le_add (m.val_le_upperVariation (A := MeasSet.whole) (subset_univ _))
      (m.neg.val_le_upperVariation (A := MeasSet.whole) (subset_univ _))
  have hprod : Integrable k ρ := by
    refine ⟨hkm.aestronglyMeasurable, (hasFiniteIntegral_iff_norm _).mpr ?_⟩
    let G (n : ℕ) (t : Ω) := ENNReal.ofReal (F n t)
    have hGmeas (n : ℕ) : Measurable (G n) :=
      ((continuous_norm.measurable.comp hkm).indicator (D n).2).ennreal_ofReal
    have hGmono : Monotone G := by
      intro i j hij t
      apply ENNReal.ofReal_le_ofReal
      by_cases hi : t ∈ (D i).1
      · have hj := hmono hij hi
        simp [F, hi, hj]
      · rw [show F i t = 0 from Set.indicator_of_notMem hi _]
        exact hnonneg j t
    have he (t : Ω) : ENNReal.ofReal ‖k t‖ = ⨆ n, G n t := by
      apply le_antisymm
      · obtain ⟨n, hn⟩ := mem_iUnion.mp (show t ∈ ⋃ n, (D n).1 by rw [hcover]; trivial)
        rw [← show G n t = ENNReal.ofReal ‖k t‖ by simp [G, F, hn]]
        exact le_iSup (fun n => G n t) n
      · apply iSup_le
        intro n
        by_cases hn : t ∈ (D n).1 <;> simp [G, F, hn]
    have hi (n : ℕ) : ∫⁻ t, G n t ∂ρ ≤ ENNReal.ofReal m.totalVariationMass := by
      have hfin := (hasFiniteIntegral_iff_norm _).mp (hF n).2
      have hne : (∫⁻ t, G n t ∂ρ) ≠ ⊤ := (show (∫⁻ t, G n t ∂ρ) < ⊤ from by
        simpa only [G, Real.norm_of_nonneg (hnonneg n _)] using hfin).ne
      have hreal := integral_eq_lintegral_of_nonneg_ae (Eventually.of_forall (hnonneg n))
        (hF n).aestronglyMeasurable
      change (∫ t, F n t ∂ρ) = (∫⁻ t, G n t ∂ρ).toReal at hreal
      rw [← ENNReal.ofReal_toReal hne, ← hreal]
      exact ENNReal.ofReal_le_ofReal (hbound n)
    simp_rw [he]
    rw [lintegral_iSup hGmeas hGmono]
    exact (iSup_le hi).trans_lt ENNReal.ofReal_lt_top
  refine ⟨hprod, fun E => ?_⟩
  let R (n : ℕ) := E.inter (D n)
  have hRmono : Monotone (fun n => (R n).1) := fun i j hij _ ht =>
    ⟨ht.1, hmono hij ht.2⟩
  have hRcover : MeasSet.iUnion R = E := by
    apply Subtype.ext
    change (⋃ n, E.1 ∩ (D n).1) = E.1
    rw [← inter_iUnion, hcover, inter_univ]
  have hleft := m.tendsto_of_increasing hca R hRmono
  rw [hRcover] at hleft
  have hright := tendsto_setIntegral_of_monotone (fun n => (R n).2) hRmono
    (show IntegrableOn k (⋃ n, (R n).1) ρ from hprod.restrict)
  rw [show (⋃ n, (R n).1) = E.1 from congrArg Subtype.val hRcover] at hright
  have hlim : Tendsto (fun n => ∫ t in (R n).1, k t ∂ρ) atTop (𝓝 (m.val E)) := by
    simpa only [hcut (R _) _ inter_subset_right] using hleft
  change Tendsto _ _ (𝓝 (ξ (adjoint (P.val E) f))) at hlim
  exact tendsto_nhds_unique hlim hright

#print axioms PVM.cyclic_normal_density

open MeasureTheory in
/-- Manuscript, prop:cyclic-normal. Obtain the canonical representatives
by multiplying the cyclic vector by bounded truncations of the scalar
density of the bidual coefficient. -/
theorem PVM.localizes_of_cyclic [CompleteSpace X] (P : PVM Ω X) (hP : P.Cyclic) :
    P.Localizes := by
  obtain ⟨u, hu⟩ := hP
  obtain ⟨ρ, hρfinite, φ, hφ, hρfaithful⟩ := P.exists_faithful_positive_coefficient hu
  let _ : IsFiniteMeasure ρ := hρfinite
  have hρ (E : MeasSet Ω) : ρ E.1 = 0 → P.val E = 0 := (hρfaithful E).mp
  intro ξ hξ
  obtain ⟨h, hmeas, hint, hcoeff⟩ := P.exists_normalCoefficient_density ρ hρ ξ hξ φ
  let trunc (g : Ω → ℝ) (hg : Measurable g) (n : ℕ) : MeasSet Ω :=
    ⟨{t | |g t| ≤ (n : ℝ)}, measurableSet_le (continuous_abs.measurable.comp hg) measurable_const⟩
  have hmono (g : Ω → ℝ) (hg : Measurable g) : Monotone (fun n => (trunc g hg n).1) := by
    intro i j hij t hi
    change |g t| ≤ (i : ℝ) at hi
    change |g t| ≤ (j : ℝ)
    exact hi.trans (Nat.cast_le.mpr hij)
  have hcover (g : Ω → ℝ) (hg : Measurable g) :
      MeasSet.iUnion (trunc g hg) = MeasSet.whole := by
    apply Subtype.ext
    apply Set.eq_univ_of_forall
    intro t
    obtain ⟨n, hn⟩ := exists_nat_ge |g t|
    exact mem_iUnion.mpr ⟨n, hn⟩
  refine ⟨trunc h hmeas, hmono h hmeas, hcover h hmeas, fun n => ?_⟩
  let A := trunc h hmeas n
  let a := A.1.indicator h
  have ha : Measurable a := hmeas.indicator A.2
  have hbound (t : Ω) : |a t| ≤ (n : ℝ) := by
    by_cases ht : t ∈ A.1
    · rw [show a t = h t from Set.indicator_of_mem ht _]
      exact ht
    · rw [show a t = 0 from Set.indicator_of_notMem ht _, abs_zero]
      positivity
  obtain ⟨T, hT⟩ := P.toOVM.exists_boundedMultiplier a ha (n : ℝ) hbound
  refine ⟨T u, fun f => ?_⟩
  obtain ⟨g, hgmeas, hgint, hg⟩ := P.exists_normalCoefficient_density ρ hρ (J u) (P.toOVM.normal_J u) f
  have hmval := (P.cyclic_normal_density hu ρ φ hφ ξ hξ f h g hmeas hint
    hcoeff hgmeas hg).2 A
  change ξ (adjoint (P.val A) f) = J u (adjoint T f)
  rw [hmval, hT (J u) f ρ g hgint hg, ← integral_indicator A.2]
  apply integral_congr_ae
  filter_upwards with t
  by_cases ht : t ∈ A.1 <;> simp [a, ht, mul_comm]

#print axioms PVM.localizes_of_cyclic

open MeasureTheory in
/-- The density support used in the proof of the invariant-cyclic lemma. -/
theorem PVM.support_cut_mem [CompleteSpace X] (P : PVM Ω X)
    {u : X} (hu : P.CyclicVector u) (ρ : Measure Ω) [IsFiniteMeasure ρ]
    (φ : Dual X) (hφ : ∀ E : MeasSet Ω, (ρ E.1).toReal = φ (P.val E u))
    (hρ : ∀ E : MeasSet Ω, ρ E.1 = 0 → P.val E = 0)
    (Y : Submodule ℝ X) (hY : IsClosed (Y : Set X)) (hi : P.Invariant Y)
    (y : X) (hy : y ∈ Y) :
    ∃ A : MeasSet Ω, P.val A y = y ∧ P.val A u ∈ Y := by
  obtain ⟨h, hmeas, hint, hcoeff⟩ :=
    P.exists_normalCoefficient_density ρ hρ (J y) (P.toOVM.normal_J y) φ
  let A : MeasSet Ω := ⟨{t | h t ≠ 0}, (hmeas (measurableSet_singleton (0 : ℝ))).compl⟩
  let N : MeasSet Ω := ⟨{t | h t = 0}, hmeas (measurableSet_singleton (0 : ℝ))⟩
  have hcoef (f : Dual X) : ∃ g : Ω → ℝ, Measurable g ∧ Integrable g ρ ∧
      ∀ E : MeasSet Ω, f (P.val E u) = ∫ t in E.1, g t ∂ρ :=
    P.exists_normalCoefficient_density ρ hρ (J u) (P.toOVM.normal_J u) f
  have hzero : P.val N y = 0 := by
    apply eq_of_dual_eval
    intro f
    obtain ⟨g, hgmeas, hgint, hg⟩ := hcoef f
    have hh := P.cyclic_coefficient_of_bounded_h hu ρ φ hφ (J y)
      (P.toOVM.normal_J y) f h g hmeas hint hcoeff hgmeas hgint hg N 0 le_rfl (by
        intro t ht
        change h t = 0 at ht
        rw [ht, abs_zero])
    change f (P.val N y) = _ at hh
    rw [hh, map_zero]
    rw [← integral_indicator N.2]
    have he : N.1.indicator (fun t => g t * h t) = fun _ => (0 : ℝ) := by
      funext t
      by_cases ht : t ∈ N.1
      · have hz : h t = 0 := ht
        rw [Set.indicator_of_mem ht, hz, mul_zero]
      · exact Set.indicator_of_notMem ht _
    rw [he, integral_zero]
  have hAy : P.val A y = y := by
    have hd : Disjoint A.1 N.1 := Set.disjoint_left.mpr fun _ ha hn => ha hn
    have hAN : A.union N = MeasSet.whole := by
      apply Subtype.ext
      ext x
      change (h x ≠ 0 ∨ h x = 0) ↔ x ∈ Set.univ
      simp only [Set.mem_univ, iff_true]
      by_cases hz : h x = 0
      · exact Or.inr hz
      · exact Or.inl hz
    have he := P.toOVM.apply_union A N hd y
    rw [hAN, hzero, add_zero] at he
    have hp : P.val MeasSet.whole = ContinuousLinearMap.id ℝ X := P.normalized
    rw [hp] at he
    exact he.symm
  let c (n : ℕ) : ℝ := (n : ℝ) + 1
  have hc (n : ℕ) : 0 < c n := by dsimp [c]; positivity
  let D (n : ℕ) : MeasSet Ω := ⟨{t | 1 / c n ≤ |h t| ∧ |h t| ≤ c n},
    (measurableSet_le measurable_const (continuous_abs.measurable.comp hmeas)).inter
      (measurableSet_le (continuous_abs.measurable.comp hmeas) measurable_const)⟩
  have hDmono : Monotone (fun n => (D n).1) := by
    intro i j hij t ht
    have hle : c i ≤ c j := by dsimp [c]; exact add_le_add (Nat.cast_le.mpr hij) le_rfl
    exact ⟨(one_div_le_one_div_of_le (hc i) hle).trans ht.1, ht.2.trans hle⟩
  have hDcover : MeasSet.iUnion D = A := by
    apply Subtype.ext
    ext t
    change (t ∈ ⋃ n, (D n).1) ↔ h t ≠ 0
    constructor
    · rintro ht h0
      obtain ⟨n, hn⟩ := Set.mem_iUnion.mp ht
      exact (not_lt_of_ge hn.1) (by rw [h0, abs_zero]; positivity)
    · intro ht
      have hp : 0 < |h t| := abs_pos.mpr ht
      obtain ⟨n, hn⟩ := exists_nat_ge (max (|h t|) (1 / |h t|))
      have hnc : (n : ℝ) ≤ c n := by dsimp [c]; linarith
      have hi : 1 / |h t| ≤ c n := (le_max_right _ _).trans (hn.trans hnc)
      refine Set.mem_iUnion.mpr ⟨n, ?_, (le_max_left _ _).trans (hn.trans hnc)⟩
      exact (div_le_iff₀ (hc n)).mpr (by
        have hh := (div_le_iff₀ hp).mp hi
        simpa only [mul_comm] using hh)
  have hDn (n : ℕ) : P.val (D n) u ∈ Y := by
    let B := D n
    let b := B.1.indicator (fun t => (h t)⁻¹)
    have hb : Measurable b := hmeas.inv.indicator B.2
    have hbnd (t : Ω) : |b t| ≤ c n := by
      by_cases ht : t ∈ B.1
      · rw [show b t = (h t)⁻¹ from Set.indicator_of_mem ht _, abs_inv]
        have hpos : 0 < |h t| := (by positivity : 0 < 1 / c n).trans_le ht.1
        have hh := one_div_le_one_div_of_le (by positivity : 0 < 1 / c n) ht.1
        simpa only [one_div, inv_inv] using hh
      · rw [show b t = 0 from Set.indicator_of_notMem ht _, abs_zero]
        exact (hc n).le
    obtain ⟨U, hUinv, hU⟩ := P.toOVM.exists_invariant_boundedMultiplier b hb (c n) hbnd
    have heq : U (P.val B y) = P.val B u := by
      apply eq_of_dual_eval
      intro f
      obtain ⟨g, hgmeas, hgint, hg⟩ := hcoef f
      let d := B.1.indicator (fun t => g t * h t)
      have hbd (t : Ω) : ‖B.1.indicator h t‖ ≤ c n := by
        by_cases ht : t ∈ B.1
        · rw [Set.indicator_of_mem ht, Real.norm_eq_abs]
          exact ht.2
        · rw [Set.indicator_of_notMem ht, norm_zero]
          exact (hc n).le
      have hd : Integrable d ρ := by
        have hh := hgint.bdd_mul (c := c n) (hmeas.indicator B.2).aestronglyMeasurable
          (Eventually.of_forall hbd)
        have hfun : (fun t => B.1.indicator h t * g t) = d := by
          funext t
          by_cases ht : t ∈ B.1 <;> simp [d, ht, mul_comm]
        rwa [hfun] at hh
      have hcut (E : MeasSet Ω) : (J (P.val B y)) (adjoint (P.val E) f) =
          ∫ t in E.1, d t ∂ρ := by
        change f (P.val E (P.val B y)) = _
        have he := congrArg (fun T : X →L[ℝ] X => T y) (P.mul_eq E B)
        change P.val E (P.val B y) = P.val (E.inter B) y at he
        rw [he]
        have hf := P.cyclic_coefficient_of_bounded_h hu ρ φ hφ (J y)
          (P.toOVM.normal_J y) f h g hmeas hint hcoeff hgmeas hgint hg
          (E.inter B) (c n) (hc n).le (fun _ ht => ht.2.2)
        change f (P.val (E.inter B) y) = _ at hf
        rw [hf]
        change _ = ∫ t in E.1, B.1.indicator (fun t => g t * h t) t ∂ρ
        rw [integral_indicator B.2, Measure.restrict_restrict B.2]
        change (∫ t in E.1 ∩ B.1, g t * h t ∂ρ) = ∫ t in B.1 ∩ E.1, g t * h t ∂ρ
        rw [Set.inter_comm E.1 B.1]
      change (J (P.val B y)) (adjoint U f) = _
      rw [hU (J (P.val B y)) f ρ d hd hcut, hg B, ← integral_indicator B.2]
      apply integral_congr_ae
      filter_upwards with t
      by_cases ht : t ∈ B.1
      · have hn : h t ≠ 0 := by
          intro hz
          have hh : 1 / c n ≤ |h t| := ht.1
          rw [hz, abs_zero] at hh
          exact (not_lt_of_ge hh) (by positivity)
        simp only [b, d, Set.indicator_of_mem ht]
        calc
          (h t)⁻¹ * (g t * h t) = g t * ((h t)⁻¹ * h t) := by ring
          _ = g t := by rw [inv_mul_cancel₀ hn, mul_one]
      · simp [b, d, ht]
    exact heq ▸ hUinv Y hY hi _ (hi B y hy)
  have hlim := P.toOVM.tendsto_apply_of_increasing D hDmono u
  rw [hDcover] at hlim
  exact ⟨A, hAy, hY.mem_of_tendsto hlim (Eventually.of_forall hDn)⟩

#print axioms PVM.support_cut_mem
/-- The restriction to the closed orbit span has the stated cyclic vector. -/
theorem PVM.cyclicVector_restrict_cyclicSubspace (P : PVM Ω X) (u : X)
    (hu : u ∈ P.cyclicSubspace u) :
    (P.restrict (P.cyclicSubspace u) (P.cyclicSubspace_invariant u)).CyclicVector ⟨u, hu⟩ := by
  let Y := P.cyclicSubspace u
  let R := P.restrict Y (P.cyclicSubspace_invariant u)
  let v : Y := ⟨u, hu⟩
  intro y
  let W := Submodule.span ℝ (Set.range fun E => R.val E v)
  have hW : W.map Y.subtype = Submodule.span ℝ (Set.range fun E => P.val E u) := by
    rw [Submodule.map_span]
    congr 1
    ext x
    constructor
    · rintro ⟨_, ⟨E, rfl⟩, rfl⟩
      exact ⟨E, rfl⟩
    · rintro ⟨E, rfl⟩
      exact ⟨R.val E v, ⟨E, rfl⟩, rfl⟩
  apply Metric.mem_closure_iff.mpr
  intro ε hε
  obtain ⟨z, hz, hdist⟩ := Metric.mem_closure_iff.mp y.2 ε hε
  have hz' : z ∈ W.map Y.subtype := by rw [hW]; exact hz
  obtain ⟨w, hw, rfl⟩ := hz'
  exact ⟨w, hw, hdist⟩

/-- Each closed cyclic subspace carries a cyclic restriction. -/
theorem PVM.cyclic_restrict_cyclicSubspace (P : PVM Ω X) (u : X) :
    (P.restrict (P.cyclicSubspace u) (P.cyclicSubspace_invariant u)).Cyclic := by
  let Y := P.cyclicSubspace u
  have hu : u ∈ Y := by
    have h : P.val MeasSet.whole u ∈ Y := subset_closure (Submodule.subset_span ⟨MeasSet.whole, rfl⟩)
    rw [show P.val MeasSet.whole = ContinuousLinearMap.id ℝ X from P.normalized] at h
    exact h
  exact ⟨⟨u, hu⟩, P.cyclicVector_restrict_cyclicSubspace u hu⟩

/-- The equivalence of (1) and (3) in prop:normal-coverage. -/
theorem PVM.localizes_iff_cyclic_coverage [CompleteSpace X] (P : PVM Ω X) :
    P.Localizes ↔
      ∀ ξ : Bidual X, P.toOVM.Normal ξ → ∃ u : X, ∃ η : Bidual (P.cyclicSubspace u),
        (P.restrict _ (P.cyclicSubspace_invariant u)).toOVM.Normal η ∧
          secondAdjoint (P.cyclicSubspace u).subtypeL η = ξ := by
  constructor
  · exact P.cyclic_coverage_of_localizes
  · intro h ξ hξ
    obtain ⟨u, η, hη, hξ'⟩ := h ξ hξ
    let Y := P.cyclicSubspace u
    let R := P.restrict Y (P.cyclicSubspace_invariant u)
    let _ : IsClosed (Y : Set X) := (Submodule.span ℝ (Set.range fun E => P.val E u)).isClosed_topologicalClosure
    have hR : R.Localizes := R.localizes_of_cyclic (P.cyclic_restrict_cyclicSubspace u)
    obtain ⟨A, hA, hcover, hx⟩ := hR _ hη
    refine ⟨A, hA, hcover, fun n => ?_⟩
    obtain ⟨x, hx⟩ := hx n
    refine ⟨(x : X), fun f => ?_⟩
    have he : secondAdjoint (R.val (A n)) η = J x := by ext g; exact hx g
    have he' : secondAdjoint (P.val (A n)) ξ = J (x : X) := by
      rw [← hξ', ← R.cut_intertwining P Y.subtypeL (P.restrict_intertwines Y (P.cyclicSubspace_invariant u)),
        he, secondAdjoint_canonical]
      rfl
    exact congrArg (fun η : Bidual X => η f) he'

#print axioms PVM.cyclic_restrict_cyclicSubspace
#print axioms PVM.localizes_iff_cyclic_coverage

private theorem PVM.apply_inter (P : PVM Ω X) (A B : MeasSet Ω) (x : X) :
    P.val A (P.val B x) = P.val (A.inter B) x :=
  congrArg (fun T : X →L[ℝ] X => T x) (P.mul_eq A B)

open MeasureTheory in
/-- Manuscript, lem:invariant-cyclic. A closed invariant subspace is one
spectral band, and the spectral cut of the original generator is cyclic. -/
theorem PVM.invariant_eq_projection_range [CompleteSpace X] (P : PVM Ω X)
    {u : X} (hu : P.CyclicVector u) (Y : Submodule ℝ X)
    (hY : IsClosed (Y : Set X)) (hi : P.Invariant Y) :
    ∃ A : MeasSet Ω, Set.range (P.val A) = (Y : Set X) ∧
      ∃ v : Y, (v : X) = P.val A u ∧ (P.restrict Y hi).CyclicVector v := by
  obtain ⟨ρ, hfin, φ, hφ, hfaith⟩ := P.exists_faithful_positive_coefficient hu
  let _ : IsFiniteMeasure ρ := hfin
  let Good (B : MeasSet Ω) : Prop := P.val B u ∈ Y
  have hempty : Good MeasSet.empty := by
    change P.val MeasSet.empty u ∈ Y
    rw [P.empty_eq, zero_apply]
    exact Y.zero_mem
  have hunion (B C : MeasSet Ω) (hB : Good B) (hC : Good C) : Good (B.union C) := by
    have hdiff : Good (C.diff B) := by
      change P.val (C.diff B) u ∈ Y
      have hE : (C.diff B).inter C = C.diff B := Subtype.ext (inter_eq_left.mpr sdiff_subset)
      have hp := hi (C.diff B) _ hC
      rwa [P.apply_inter, hE] at hp
    have hd : Disjoint B.1 (C.diff B).1 := Set.disjoint_left.mpr fun _ h h' => h'.2 h
    have he : B.union (C.diff B) = B.union C := by
      apply Subtype.ext
      ext t
      change (t ∈ B.1 ∨ (t ∈ C.1 ∧ t ∉ B.1)) ↔ (t ∈ B.1 ∨ t ∈ C.1)
      tauto
    change P.val (B.union C) u ∈ Y
    rw [← he, P.toOVM.apply_union _ _ hd]
    exact Y.add_mem hB hdiff
  let V : Set ℝ := {a | ∃ B : MeasSet Ω, Good B ∧ ρ.real B.1 = a}
  have hVne : V.Nonempty := ⟨_, MeasSet.empty, hempty, rfl⟩
  have hVbdd : BddAbove V := by
    refine ⟨ρ.real Set.univ, ?_⟩
    rintro _ ⟨B, _, rfl⟩
    exact measureReal_mono (subset_univ _)
  let α := sSup V
  let δ (n : ℕ) : ℝ := 1 / ((n : ℝ) + 1)
  have hδ (n : ℕ) : 0 < δ n := by dsimp [δ]; positivity
  have happrox (n : ℕ) : ∃ B : MeasSet Ω, Good B ∧ α - δ n < ρ.real B.1 := by
    obtain ⟨a, ⟨B, hB, rfl⟩, ha⟩ := exists_lt_of_lt_csSup hVne (sub_lt_self α (hδ n))
    exact ⟨B, hB, ha⟩
  choose C hC hmass using happrox
  let B : ℕ → MeasSet Ω := Nat.rec (C 0) (fun n D => D.union (C (n + 1)))
  have hCB (n : ℕ) : (C n).1 ⊆ (B n).1 := by
    cases n with
    | zero => exact Subset.rfl
    | succ n => exact subset_union_right
  have hB (n : ℕ) : Good (B n) := by
    induction n with
    | zero => exact hC 0
    | succ n ih => exact hunion (B n) (C (n + 1)) ih (hC (n + 1))
  have hmono : Monotone (fun n => (B n).1) := monotone_nat_of_le_succ fun _ => subset_union_left
  let A := MeasSet.iUnion B
  have hAg : Good A := hY.mem_of_tendsto (P.toOVM.tendsto_apply_of_increasing B hmono u)
    (Eventually.of_forall hB)
  have hmax : ρ.real A.1 = α := by
    apply le_antisymm (le_csSup hVbdd ⟨A, hAg, rfl⟩)
    have hm (n : ℕ) : α - δ n ≤ ρ.real A.1 := by
      have hBA : (B n).1 ⊆ A.1 := by
        change (B n).1 ⊆ ⋃ i, (B i).1
        exact subset_iUnion (fun i => (B i).1) n
      exact (hmass n).le.trans (measureReal_mono ((hCB n).trans hBA))
    have hlim : Tendsto (fun n => α - δ n) atTop (𝓝 α) := by
      simpa only [sub_zero] using (tendsto_const_nhds (x := α)).sub
        (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ))
    exact le_of_tendsto hlim (Eventually.of_forall hm)
  have hnull (C : MeasSet Ω) (hC : Good C) : P.val (C.diff A) = 0 := by
    apply (hfaith (C.diff A)).mp
    apply (measureReal_eq_zero_iff (μ := ρ) (s := (C.diff A).1)).mp
    have hm : ρ.real (A.union C).1 ≤ α := le_csSup hVbdd ⟨_, hunion A C hAg hC, rfl⟩
    have he : (A.union C).1 \ A.1 = (C.diff A).1 := by
      ext t
      change ((t ∈ A.1 ∨ t ∈ C.1) ∧ t ∉ A.1) ↔ (t ∈ C.1 ∧ t ∉ A.1)
      tauto
    have hh := measureReal_sdiff (μ := ρ) (s₁ := (A.union C).1) (s₂ := A.1)
      (show A.1 ⊆ (A.union C).1 from subset_union_left) A.2
    rw [he, hmax] at hh
    linarith [measureReal_nonneg (μ := ρ) (s := (C.diff A).1)]
  have hfix (y : X) (hy : y ∈ Y) : P.val A y = y := by
    obtain ⟨C, hCy, hCg⟩ := P.support_cut_mem hu ρ φ hφ (fun E => (hfaith E).mp) Y hY hi y hy
    have hd : Disjoint (A.inter C).1 (C.diff A).1 :=
      Set.disjoint_left.mpr fun _ h h' => h'.2 h.1
    have he : (A.inter C).union (C.diff A) = C := by
      apply Subtype.ext
      ext t
      change ((t ∈ A.1 ∧ t ∈ C.1) ∨ (t ∈ C.1 ∧ t ∉ A.1)) ↔ t ∈ C.1
      tauto
    have hp := P.toOVM.apply_union (A.inter C) (C.diff A) hd y
    rw [he, hnull C hCg, zero_apply, add_zero, ← P.apply_inter, hCy] at hp
    exact hp.symm
  have hmaps (x : X) : P.val A x ∈ Y := by
    have hclosed : IsClosed {z : X | P.val A z ∈ Y} := hY.preimage (P.val A).continuous
    apply closure_minimal _ hclosed (hu x)
    intro z hz
    induction hz using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨E, rfl⟩ := hz
      change P.val A (P.val E u) ∈ Y
      rw [P.apply_inter, MeasSet.inter_comm A E, ← P.apply_inter]
      exact hi E _ hAg
    | zero => change P.val A 0 ∈ Y; rw [map_zero]; exact Y.zero_mem
    | add x y _ _ hx hy => change P.val A (x + y) ∈ Y; rw [map_add]; exact Y.add_mem hx hy
    | smul c x _ hx => change P.val A (c • x) ∈ Y; rw [map_smul]; exact Y.smul_mem c hx
  let T := (P.val A).codRestrict Y hmaps
  have hT : Function.Surjective T := fun y => ⟨(y : X), Subtype.ext (hfix _ y.2)⟩
  have hinter : ∀ E, T.comp (P.val E) = ((P.restrict Y hi).val E).comp T := by
    intro E
    apply ContinuousLinearMap.ext
    intro x
    apply Subtype.ext
    change P.val A (P.val E x) = P.val E (P.val A x)
    rw [P.apply_inter, P.apply_inter, MeasSet.inter_comm A E]
  refine ⟨A, ?_, T u, rfl, P.cyclicVector_of_dense_intertwining _ T hinter hT.denseRange hu⟩
  ext y
  constructor
  · rintro ⟨x, rfl⟩
    exact hmaps x
  · intro hy
    exact ⟨y, hfix y hy⟩

#print axioms PVM.invariant_eq_projection_range
private noncomputable def OVM.normalCoefficient [CompleteSpace X] (μ : OVM Ω X)
    (ξ : Bidual X) (f : Dual X) (E : MeasSet Ω) : ℝ :=
  (μ.coefficientCharge ξ f).countablyAdditivePart.val E

private theorem OVM.normalCoefficient_add_bidual [CompleteSpace X] (μ : OVM Ω X)
    (ξ η : Bidual X) (f : Dual X) (E : MeasSet Ω) :
    μ.normalCoefficient (ξ + η) f E =
      μ.normalCoefficient ξ f E + μ.normalCoefficient η f E := by
  unfold OVM.normalCoefficient
  have he : μ.coefficientCharge (ξ + η) f = (μ.coefficientCharge ξ f).add (μ.coefficientCharge η f) :=
    ScalarCharge.ext_val fun _ => rfl
  rw [he, ScalarCharge.countablyAdditivePart_add]
  rfl

private theorem OVM.normalCoefficient_smul_bidual [CompleteSpace X] (μ : OVM Ω X)
    (a : ℝ) (ξ : Bidual X) (f : Dual X) (E : MeasSet Ω) :
    μ.normalCoefficient (a • ξ) f E = a * μ.normalCoefficient ξ f E := by
  unfold OVM.normalCoefficient
  have he : μ.coefficientCharge (a • ξ) f = (μ.coefficientCharge ξ f).scale a :=
    ScalarCharge.ext_val fun _ => rfl
  rw [he, ScalarCharge.countablyAdditivePart_scale]
  rfl

private theorem OVM.normalCoefficient_add_dual [CompleteSpace X] (μ : OVM Ω X)
    (ξ : Bidual X) (f g : Dual X) (E : MeasSet Ω) :
    μ.normalCoefficient ξ (f + g) E =
      μ.normalCoefficient ξ f E + μ.normalCoefficient ξ g E := by
  unfold OVM.normalCoefficient
  have he : μ.coefficientCharge ξ (f + g) =
      (μ.coefficientCharge ξ f).add (μ.coefficientCharge ξ g) := by
    apply ScalarCharge.ext_val
    intro A
    change ξ (adjoint (μ.val A) (f + g)) = ξ (adjoint (μ.val A) f) + ξ (adjoint (μ.val A) g)
    rw [show adjoint (μ.val A) (f + g) = adjoint (μ.val A) f + adjoint (μ.val A) g by ext x; rfl,
      map_add]
  rw [he, ScalarCharge.countablyAdditivePart_add]
  rfl

private theorem OVM.normalCoefficient_smul_dual [CompleteSpace X] (μ : OVM Ω X)
    (a : ℝ) (ξ : Bidual X) (f : Dual X) (E : MeasSet Ω) :
    μ.normalCoefficient ξ (a • f) E = a * μ.normalCoefficient ξ f E := by
  unfold OVM.normalCoefficient
  have he : μ.coefficientCharge ξ (a • f) = (μ.coefficientCharge ξ f).scale a := by
    apply ScalarCharge.ext_val
    intro A
    change ξ (adjoint (μ.val A) (a • f)) = a • ξ (adjoint (μ.val A) f)
    rw [show adjoint (μ.val A) (a • f) = a • adjoint (μ.val A) f by ext x; rfl, map_smul]
  rw [he, ScalarCharge.countablyAdditivePart_scale]
  rfl

private theorem OVM.abs_normalCoefficient_le [CompleteSpace X] (μ : OVM Ω X)
    (ξ : Bidual X) (f : Dual X) (E : MeasSet Ω) :
    |μ.normalCoefficient ξ f E| ≤ 2 * μ.uniformNorm * ‖ξ‖ * ‖f‖ := by
  have he (A : MeasSet Ω) : |(μ.coefficientCharge ξ f).val A| ≤ ‖ξ‖ * (‖f‖ * μ.uniformNorm) := by
    change ‖ξ (adjoint (μ.val A) f)‖ ≤ _
    exact (ξ.le_opNorm _).trans (mul_le_mul_of_nonneg_left
      ((f.opNorm_comp_le (μ.val A)).trans
        (mul_le_mul_of_nonneg_left (μ.opNorm_le_uniformNorm A) (norm_nonneg f))) (norm_nonneg ξ))
  exact ((μ.coefficientCharge ξ f).abs_countablyAdditivePart_le _ he E).trans_eq (by ring)

private noncomputable def OVM.normalProjectionValue [CompleteSpace X] (μ : OVM Ω X)
    (ξ : Bidual X) : Bidual X :=
  LinearMap.mkContinuous
    { toFun := fun f => μ.normalCoefficient ξ f MeasSet.whole
      map_add' := fun f g => μ.normalCoefficient_add_dual ξ f g _
      map_smul' := fun a f => μ.normalCoefficient_smul_dual a ξ f _ }
    (2 * μ.uniformNorm * ‖ξ‖)
    (fun f => μ.abs_normalCoefficient_le ξ f _)

private theorem OVM.norm_normalProjectionValue_le [CompleteSpace X] (μ : OVM Ω X)
    (ξ : Bidual X) : ‖μ.normalProjectionValue ξ‖ ≤ 2 * μ.uniformNorm * ‖ξ‖ :=
  (μ.normalProjectionValue ξ).opNorm_le_bound
    (mul_nonneg (mul_nonneg (by norm_num) μ.uniformNorm_nonneg) (norm_nonneg ξ))
    (fun f => μ.abs_normalCoefficient_le ξ f _)

/-- Manuscript, eq:ovm-normal-projection. The map is defined by evaluating
the countably additive part of each coefficient at the whole space. -/
noncomputable def OVM.normalProjection [CompleteSpace X] (μ : OVM Ω X) :
    Bidual X →L[ℝ] Bidual X :=
  LinearMap.mkContinuous
    { toFun := μ.normalProjectionValue
      map_add' := fun ξ η => by
        ext f
        exact μ.normalCoefficient_add_bidual ξ η f _
      map_smul' := fun a ξ => by
        ext f
        exact μ.normalCoefficient_smul_bidual a ξ f _ }
    (2 * μ.uniformNorm) μ.norm_normalProjectionValue_le

theorem OVM.normalProjection_apply [CompleteSpace X] (μ : OVM Ω X) (ξ : Bidual X) (f : Dual X) :
    μ.normalProjection ξ f = (μ.coefficientCharge ξ f).countablyAdditivePart.val MeasSet.whole :=
  rfl

set_option maxSynthPendingDepth 16 in
theorem OVM.norm_normalProjection_le [CompleteSpace X] (μ : OVM Ω X) :
    ‖μ.normalProjection‖ ≤ 2 * μ.uniformNorm :=
  μ.normalProjection.opNorm_le_bound
    (mul_nonneg (by norm_num : (0 : ℝ) ≤ 2) μ.uniformNorm_nonneg) μ.norm_normalProjectionValue_le

theorem PVM.normalProjection_coeff [CompleteSpace X] (P : PVM Ω X) (ξ : Bidual X)
    (f : Dual X) (E : MeasSet Ω) :
    P.toOVM.normalProjection ξ (adjoint (P.val E) f) =
      (P.toOVM.coefficientCharge ξ f).countablyAdditivePart.val E := by
  rw [OVM.normalProjection_apply]
  have he : P.toOVM.coefficientCharge ξ (adjoint (P.val E) f) =
      (P.toOVM.coefficientCharge ξ f).restrict E := by
    apply ScalarCharge.ext_val
    intro A
    change ξ (adjoint (P.val A) (adjoint (P.val E) f)) = ξ (adjoint (P.val (A.inter E)) f)
    rw [show adjoint (P.val A) (adjoint (P.val E) f) =
      adjoint ((P.val E).comp (P.val A)) f by rfl, P.mul_eq, MeasSet.inter_comm E A]
  rw [he, ScalarCharge.countablyAdditivePart_restrict]
  have hwhole : MeasSet.whole.inter E = E := Subtype.ext (Set.univ_inter _)
  change (P.toOVM.coefficientCharge ξ f).countablyAdditivePart.val (MeasSet.whole.inter E) = _
  rw [hwhole]

theorem PVM.normal_normalProjection [CompleteSpace X] (P : PVM Ω X) (ξ : Bidual X) :
    P.toOVM.Normal (P.toOVM.normalProjection ξ) := by
  intro A hA f
  simp_rw [P.normalProjection_coeff]
  exact (P.toOVM.coefficientCharge ξ f).countablyAdditivePart_countablyAdditive A hA

theorem OVM.normalProjection_eq_of_normal [CompleteSpace X] (μ : OVM Ω X)
    (hμ : μ.Normalized) (ξ : Bidual X) (hξ : μ.Normal ξ) : μ.normalProjection ξ = ξ := by
  ext f
  rw [OVM.normalProjection_apply, ScalarCharge.countablyAdditivePart_eq_of_countablyAdditive _ (fun A hA => hξ A hA f)]
  change ξ (adjoint (μ.val MeasSet.whole) f) = ξ f
  rw [show μ.val MeasSet.whole = ContinuousLinearMap.id ℝ X from hμ]
  rfl

/-- Manuscript, lem:normal-restriction. The map is a bounded projection
onto the normal part of the bidual. -/
theorem PVM.normalProjection_range [CompleteSpace X] (P : PVM Ω X) :
    Set.range P.toOVM.normalProjection = {ξ : Bidual X | P.toOVM.Normal ξ} := by
  ext ξ
  constructor
  · rintro ⟨η, rfl⟩
    exact P.normal_normalProjection η
  · intro hξ
    exact ⟨ξ, P.toOVM.normalProjection_eq_of_normal P.normalized ξ hξ⟩

theorem PVM.normalProjection_idempotent [CompleteSpace X] (P : PVM Ω X) (ξ : Bidual X) :
    P.toOVM.normalProjection (P.toOVM.normalProjection ξ) = P.toOVM.normalProjection ξ :=
  P.toOVM.normalProjection_eq_of_normal P.normalized _ (P.normal_normalProjection ξ)

theorem PVM.normalProjection_intertwining [CompleteSpace X] [CompleteSpace Z]
    (P : PVM Ω X) (R : PVM Ω Z) (A : X →L[ℝ] Z)
    (hA : ∀ E, A.comp (P.val E) = (R.val E).comp A) (ξ : Bidual X) :
    R.toOVM.normalProjection (secondAdjoint A ξ) = secondAdjoint A (P.toOVM.normalProjection ξ) := by
  ext f
  rw [secondAdjoint_apply, OVM.normalProjection_apply, OVM.normalProjection_apply]
  have he : R.toOVM.coefficientCharge (secondAdjoint A ξ) f =
      P.toOVM.coefficientCharge ξ (adjoint A f) := by
    apply ScalarCharge.ext_val
    intro E
    change ξ (adjoint A (adjoint (R.val E) f)) = ξ (adjoint (P.val E) (adjoint A f))
    congr 1
    ext x
    exact congrArg f (congrArg (fun L : X →L[ℝ] Z => L x) (hA E)).symm
  rw [he]

/-- The rightmost map in the short exact sequence of normal parts is onto. -/
theorem PVM.normal_quotient_surjective [CompleteSpace X] (P : PVM Ω X)
    (Y : Submodule ℝ X) [IsClosed (Y : Set X)] (hY : P.Invariant Y)
    (η : Bidual (X ⧸ Y)) (hη : (P.quotient Y hY).toOVM.Normal η) :
    ∃ ξ : Bidual X, P.toOVM.Normal ξ ∧ secondAdjoint Y.mkQL ξ = η := by
  obtain ⟨ξ, hξ⟩ := secondAdjoint_quotient_surjective Y η
  refine ⟨P.toOVM.normalProjection ξ, P.normal_normalProjection ξ, ?_⟩
  rw [← P.normalProjection_intertwining _ Y.mkQL (P.quotient_intertwines Y hY), hξ]
  exact (P.quotient Y hY).toOVM.normalProjection_eq_of_normal (P.quotient Y hY).normalized η hη

theorem PVM.localizes_quotient [CompleteSpace X] (P : PVM Ω X) (Y : Submodule ℝ X)
    [IsClosed (Y : Set X)] (hY : P.Invariant Y) (hloc : P.Localizes) :
    (P.quotient Y hY).Localizes := by
  intro η hη
  obtain ⟨ξ, hξ, hq⟩ := P.normal_quotient_surjective Y hY η hη
  obtain ⟨A, hmono, hcover, hx⟩ := hloc ξ hξ
  refine ⟨A, hmono, hcover, fun n => ?_⟩
  obtain ⟨x, hx⟩ := hx n
  have hcut : secondAdjoint (P.val (A n)) ξ = J x := by ext f; exact hx f
  have he : secondAdjoint ((P.quotient Y hY).val (A n)) η = J (Y.mkQL x) := by
    rw [← hq, ← P.cut_intertwining _ Y.mkQL (P.quotient_intertwines Y hY), hcut, secondAdjoint_canonical]
  exact ⟨Y.mkQL x, fun f => congrArg (fun θ : Bidual (X ⧸ Y) => θ f) he⟩

/-- The three-space assertion of the manuscript, prop:normal-coverage. -/
theorem PVM.localizes_iff_restrict_and_quotient [CompleteSpace X] (P : PVM Ω X)
    (Y : Submodule ℝ X) [hYc : IsClosed (Y : Set X)] (hY : P.Invariant Y) :
    P.Localizes ↔ (P.restrict Y hY).Localizes ∧ (P.quotient Y hY).Localizes :=
  ⟨fun h => ⟨P.localizes_restrict Y hYc hY h, P.localizes_quotient Y hY h⟩,
    fun h => P.localizes_of_restrict_and_quotient Y hY h.1 h.2⟩

/-- The collection of orbit vectors from a finite family of generators. -/
def PVM.generatorOrbit (P : PVM Ω X) {n : ℕ} (x : Fin n → X) : Set X :=
  {z | ∃ i E, P.val E (x i) = z}

/-- Finite generation uses the closed linear span of the orbit family. -/
def PVM.FinitelyGenerated (P : PVM Ω X) : Prop :=
  ∃ (n : ℕ) (x : Fin n → X), Dense (Submodule.span ℝ (P.generatorOrbit x) : Set X)

private theorem PVM.invariant_generatorSpan (P : PVM Ω X) {n : ℕ} (x : Fin n → X) :
    P.Invariant (Submodule.span ℝ (P.generatorOrbit x)).topologicalClosure := by
  let S := Submodule.span ℝ (P.generatorOrbit x)
  intro E y hy
  have hs : Set.MapsTo (P.val E) (S : Set X) S := by
    intro y hy
    induction hy using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨i, F, rfl⟩ := hz
      rw [P.apply_inter]
      exact Submodule.subset_span ⟨i, E.inter F, rfl⟩
    | zero => rw [map_zero]; exact S.zero_mem
    | add z w _ _ hz hw => rw [map_add]; exact S.add_mem hz hw
    | smul a z _ hz => rw [map_smul]; exact S.smul_mem a hz
  exact (hs.closure (P.val E).continuous) hy

universe v

private theorem localizes_of_generator_family :
    ∀ n (V : Type v) [NormedAddCommGroup V] [NormedSpace ℝ V] [CompleteSpace V]
      (P : PVM Ω V) (x : Fin n → V),
      Dense (Submodule.span ℝ (P.generatorOrbit x) : Set V) → P.Localizes := by
  intro n
  induction n with
  | zero =>
    intro V _ _ _ P x hd
    apply P.localizes_of_cyclic
    refine ⟨0, ?_⟩
    apply hd.mono
    exact Submodule.span_mono (by rintro _ ⟨i, _, _⟩; exact Fin.elim0 i)
  | succ n ih =>
    intro V _ _ _ P x hd
    let t (i : Fin n) := x i.succ
    let S := Submodule.span ℝ (P.generatorOrbit t)
    let Y := S.topologicalClosure
    let hi := P.invariant_generatorSpan t
    let hY : IsClosed (Y : Set V) := S.isClosed_topologicalClosure
    let _ : CompleteSpace Y := hY.completeSpace_coe
    let R := P.restrict Y hi
    let Q := P.quotient Y hi
    have ht (i : Fin n) : t i ∈ Y := by
      apply subset_closure
      exact Submodule.subset_span ⟨i, MeasSet.whole, congrArg
        (fun A : V →L[ℝ] V => A (t i)) P.normalized⟩
    let y (i : Fin n) : Y := ⟨t i, ht i⟩
    have hR : R.Localizes := by
      apply ih Y R y
      let W := Submodule.span ℝ (R.generatorOrbit y)
      have hW : W.map Y.subtype = S := by
        rw [Submodule.map_span]
        congr 1
        ext z
        constructor
        · rintro ⟨_, ⟨i, E, rfl⟩, rfl⟩
          exact ⟨i, E, rfl⟩
        · rintro ⟨i, E, rfl⟩
          exact ⟨R.val E (y i), ⟨i, E, rfl⟩, rfl⟩
      intro z
      apply Metric.mem_closure_iff.mpr
      intro ε hε
      obtain ⟨w, hw, hdw⟩ := Metric.mem_closure_iff.mp z.2 ε hε
      have hw' : w ∈ W.map Y.subtype := by rw [hW]; exact hw
      obtain ⟨b, hb, rfl⟩ := hw'
      exact ⟨b, hb, hdw⟩
    have hQ : Q.CyclicVector (Y.mkQL (x 0)) := by
      let B := Q.cyclicSubspace (Y.mkQL (x 0))
      have hB : IsClosed (Y.mkQL ⁻¹' (B : Set (V ⧸ Y))) :=
        (Submodule.isClosed_topologicalClosure _).preimage Y.mkQL.continuous
      have hspan : (Submodule.span ℝ (P.generatorOrbit x) : Set V) ⊆
          Y.mkQL ⁻¹' (B : Set (V ⧸ Y)) := by
        change Submodule.span ℝ (P.generatorOrbit x) ≤
          B.comap Y.mkQL.toLinearMap
        apply Submodule.span_le.mpr
        rintro _ ⟨i, E, rfl⟩
        refine Fin.cases ?_ (fun j => ?_) i
        · change Y.mkQL (P.val E (x 0)) ∈ B
          rw [← P.quotientOperator_mk Y hi]
          exact subset_closure (Submodule.subset_span ⟨E, rfl⟩)
        · have hz : P.val E (t j) ∈ Y := hi E _ (ht j)
          change Y.mkQL (P.val E (t j)) ∈ B
          rw [show Y.mkQL (P.val E (t j)) = 0 from
            (Submodule.Quotient.mk_eq_zero Y).mpr hz]
          exact B.zero_mem
      intro z
      obtain ⟨w, rfl⟩ := Submodule.Quotient.mk_surjective Y z
      exact closure_minimal hspan hB (hd w)
    exact P.localizes_of_restrict_and_quotient Y hi hR (Q.localizes_of_cyclic ⟨_, hQ⟩)

/-- Manuscript, prop:normal-coverage, finite generation implies localization. -/
theorem PVM.localizes_of_finitelyGenerated [CompleteSpace X] (P : PVM Ω X)
    (hP : P.FinitelyGenerated) : P.Localizes := by
  obtain ⟨n, x, hx⟩ := hP
  exact localizes_of_generator_family n X P x hx

