/-- The sequential form of weak compactness used for bounded sequences
in the proof of cor:local-representation-james. -/
def WeakBoundedSequencesCompact (X : Type*) [NormedAddCommGroup X] [NormedSpace ℝ X] : Prop :=
  ∀ u : ℕ → X, (∃ C : ℝ, ∀ n, ‖u n‖ ≤ C) →
    ∃ (φ : ℕ → ℕ) (_ : StrictMono φ) (x : X),
      ∀ f : Dual X, Tendsto (fun n => f (u (φ n))) atTop (𝓝 (f x))

/-- The reflexivity criterion obtained from Eberlein–Šmulian and weak
compactness of the unit ball. The use of this criterion is explicit. -/
def EberleinSmulianReflexivityCriterion (X : Type*)
    [NormedAddCommGroup X] [NormedSpace ℝ X] : Prop :=
  IsReflexive X ↔ WeakBoundedSequencesCompact X

/-- The reduction in cor:local-representation-james (3). Each bounded sequence
is put into a closed invariant subspace, Theorem 3.4 makes it reflexive,
and the criterion on that subspace supplies a weakly convergent subsequence. -/
theorem PVM.weakBoundedSequencesCompact_of_countable_cover [CompleteSpace X] (P : PVM Ω X)
    (hcover : ∀ s : Set X, s.Countable → ∃ (Y : Submodule ℝ X) (_ : IsClosed (Y : Set X))
      (hi : P.Invariant Y), s ⊆ Y ∧ (P.restrict Y hi).Localizes)
    (criterion_subspace : ∀ Y : Submodule ℝ X, IsClosed (Y : Set X) →
      EberleinSmulianReflexivityCriterion Y)
    (hs : P.toOVM.Shrinking) (hb : P.BoundedlyComplete) : WeakBoundedSequencesCompact X := by
  intro x hx
  obtain ⟨Y, hY, hi, hseq, hloc⟩ := hcover (Set.range x) (Set.countable_range x)
  let _ : CompleteSpace Y := hY.completeSpace_coe
  have hR : IsReflexive Y := (P.restrict Y hi).reflexive_of_shrinking_boundedlyComplete hloc
    (P.shrinking_restrict Y hY hi hs) (P.boundedlyComplete_restrict Y hY hi hb)
  let y (n : ℕ) : Y := ⟨x n, hseq (Set.mem_range_self n)⟩
  obtain ⟨φ, hφ, z, hz⟩ := (criterion_subspace Y hY).mp hR y hx
  exact ⟨φ, hφ, z, fun f => hz (f.comp Y.subtypeL)⟩

/-- The Eberlein–Šmulian step of cor:local-representation-james (3),
with the ambient and subspace instances of the classical criterion displayed. -/
theorem PVM.reflexive_of_countable_cover_using_eberleinSmulian [CompleteSpace X] (P : PVM Ω X)
    (hcover : ∀ s : Set X, s.Countable → ∃ (Y : Submodule ℝ X) (_ : IsClosed (Y : Set X))
      (hi : P.Invariant Y), s ⊆ Y ∧ (P.restrict Y hi).Localizes)
    (criterion_X : EberleinSmulianReflexivityCriterion X)
    (criterion_subspace : ∀ Y : Submodule ℝ X, IsClosed (Y : Set X) →
      EberleinSmulianReflexivityCriterion Y)
    (hs : P.toOVM.Shrinking) (hb : P.BoundedlyComplete) : IsReflexive X :=
  criterion_X.mpr (P.weakBoundedSequencesCompact_of_countable_cover hcover criterion_subspace hs hb)

/-- Eberlein–Šmulian for weak subsets of a Banach space, together with
its standard bounded-sequence reflexivity criterion used in the manuscript. -/
axiom citeEberleinSmulian (V : Type*) [NormedAddCommGroup V] [NormedSpace ℝ V]
    [CompleteSpace V] :
    (∀ K : Set (WeakSpace ℝ V), IsCompact K ↔ IsSeqCompact K) ∧
      EberleinSmulianReflexivityCriterion V

/-- Manuscript, cor:local-representation-james (3). -/
theorem PVM.reflexivity_iff_shrinking_boundedlyComplete_of_countable_cover
    [CompleteSpace X] (P : PVM Ω X)
    (hcover : ∀ s : Set X, s.Countable → ∃ (Y : Submodule ℝ X) (_ : IsClosed (Y : Set X))
      (hi : P.Invariant Y), s ⊆ Y ∧ (P.restrict Y hi).Localizes) :
    IsReflexive X ↔ P.toOVM.Shrinking ∧ P.BoundedlyComplete := by
  constructor
  · intro hX
    obtain ⟨h₁, h₀⟩ := hX.excludes_lOne_and_cZero
    exact ⟨P.toOVM.shrinking_of_not_contains_lOne h₁, P.boundedlyComplete_of_not_contains_cZero h₀⟩
  · rintro ⟨hs, hb⟩
    refine P.reflexive_of_countable_cover_using_eberleinSmulian hcover
      (citeEberleinSmulian X).2 (fun Y hY => ?_) hs hb
    let _ : CompleteSpace Y := hY.completeSpace_coe
    exact (citeEberleinSmulian Y).2

