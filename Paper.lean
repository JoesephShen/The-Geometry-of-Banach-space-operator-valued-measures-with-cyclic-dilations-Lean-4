namespace Paper

noncomputable section SectionSevenOrlicz

open MeasureTheory Set Filter
open scoped ENNReal Topology

/-- The Young function and its complementary Young function in the manuscript. -/
def exponentialYoung (u : ℝ) : ℝ := Real.exp (u ^ 2) - 1

def exponentialComplement (v : ℝ) : ℝ :=
  sSup ((fun u : ℝ => v * u - exponentialYoung u) '' Set.Ici 0)

def DeltaTwoAtInfinity (Ψ : ℝ → ℝ) : Prop :=
  ∃ K a : ℝ, ∀ v ≥ a, Ψ (2 * v) ≤ K * Ψ v

def expModular (f : ℝ → ℝ) (a : ℝ) : ℝ :=
  ∫ t, exponentialYoung (|f t| / a) ∂lebesgueUnitInterval

structure ExponentialHeartModel (G : Type) [NormedAddCommGroup G] [NormedSpace ℝ G] where
  scalar : KotheScalarSpace lebesgueUnitInterval G
  realization : KotheBochnerQuotient scalar ℝ G
  range_iff : ∀ a : ℝ →ₘ[lebesgueUnitInterval] ℝ,
    a ∈ Set.range realization.repr ↔
      ∀ c > (0 : ℝ), Integrable (fun t => exponentialYoung (|a t| / c)) lebesgueUnitInterval
  norm_iff : ∀ x : G, ∀ c > (0 : ℝ), ‖x‖ ≤ c ↔ expModular (realization.repr x) c ≤ 1
  one : G
  one_ae : (⇑(realization.repr one)) =ᵐ[lebesgueUnitInterval] fun _ => 1
  indicator : MeasSet ℝ → G
  indicator_ae : ∀ E, (⇑(realization.repr (indicator E))) =ᵐ[lebesgueUnitInterval] E.1.indicator (fun _ => 1)
  simple_dense : Dense (Submodule.span ℝ (Set.range indicator) : Set G)
  separable : TopologicalSpace.SeparableSpace G

structure ExponentialHeartExists where
  carrier : Type
  group : NormedAddCommGroup carrier
  space : letI := group; NormedSpace ℝ carrier
  complete : letI := group; CompleteSpace carrier
  model : letI := group; letI := space; ExponentialHeartModel carrier

/-- The usual realization of the Orlicz heart as a.e. classes with the
Luxemburg norm, including simple-function density and order continuity.
See Lindenstrauss–Tzafriri, Classical Banach Spaces II, Section 2.a, and
Cheridito–Li, Risk Measures on Orlicz Hearts, Section 4. -/
axiom citeLindenstraussTzafririExponentialHeart : Nonempty ExponentialHeartExists

structure ExponentialHeartDual {G : Type} [NormedAddCommGroup G] [NormedSpace ℝ G]
    (H : ExponentialHeartModel G) where
  scalar : KotheScalarSpace lebesgueUnitInterval (Dual G)
  realization : KotheBochnerQuotient scalar ℝ (Dual G)
  range_iff : ∀ a : ℝ →ₘ[lebesgueUnitInterval] ℝ,
    a ∈ Set.range realization.repr ↔
      ∃ c > (0 : ℝ), Integrable (fun t => exponentialComplement (|a t| / c)) lebesgueUnitInterval
  pairing : ∀ (g : Dual G) (x : G),
    g x = ∫ t, realization.repr g t * H.realization.repr x t ∂lebesgueUnitInterval

/-- Orlicz duality and order continuity of the complementary Orlicz space
under the finite-measure Delta-two condition. See Cheridito–Li, Risk
Measures on Orlicz Hearts, Section 4, and Classical Banach Spaces II, Section 2.b. -/
axiom citeLindenstraussTzafririExponentialDual {G : Type} [NormedAddCommGroup G] [NormedSpace ℝ G]
    [CompleteSpace G] (H : ExponentialHeartModel G) :
    DeltaTwoAtInfinity exponentialComplement → Nonempty (ExponentialHeartDual H)

namespace ExponentialHeartModel

variable {G : Type} [NormedAddCommGroup G] [NormedSpace ℝ G] [CompleteSpace G]
variable (H : ExponentialHeartModel G)

abbrev P (H : ExponentialHeartModel G) : PVM ℝ G := H.realization.multiplication

omit [CompleteSpace G] in
theorem indicator_eq_cut (E : MeasSet ℝ) : H.indicator E = H.P.val E H.one := by
  apply H.realization.injective
  apply AEEqFun.ext
  filter_upwards [H.indicator_ae E,H.realization.repr_cut E H.one,H.one_ae] with t hE hT hu
  change H.realization.repr (H.indicator E) t =
    H.realization.repr (H.realization.cut E H.one) t
  rw [hE,hT]
  by_cases ht : t ∈ E.1 <;> simp [ht,hu]

omit [CompleteSpace G] in
theorem cyclic_one : H.P.CyclicVector H.one := by
  have hr : Set.range H.indicator = Set.range (fun E => H.P.val E H.one) := by
    congr 1
    funext E
    exact H.indicator_eq_cut E
  change Dense (Submodule.span ℝ (Set.range (fun E => H.P.val E H.one)) : Set G)
  rw [← hr]
  exact H.simple_dense

omit [CompleteSpace G] in
theorem finitelyGenerated : H.P.FinitelyGenerated :=
  H.P.finitelyGenerated_of_cyclic ⟨H.one,H.cyclic_one⟩

omit [CompleteSpace G] in
theorem adjoint_cut (D : ExponentialHeartDual H) (E : MeasSet ℝ) (g : Dual G) :
    adjoint (H.P.val E) g = D.realization.multiplication.val E g := by
  ext x
  change g (H.realization.cut E x) = (D.realization.cut E g) x
  rw [D.pairing g, D.pairing (D.realization.cut E g)]
  apply integral_congr_ae
  filter_upwards [D.realization.repr_cut E g,H.realization.repr_cut E x] with t hg hx
  rw [hg,hx]
  by_cases ht : t ∈ E.1 <;> simp [ht]

theorem shrinking (hΔ : DeltaTwoAtInfinity exponentialComplement) : H.P.toOVM.Shrinking := by
  obtain ⟨D⟩ := citeLindenstraussTzafririExponentialDual H hΔ
  intro A hA g
  simpa only [H.adjoint_cut D] using D.realization.multiplication.countably_additive A hA g

end ExponentialHeartModel

#print axioms ExponentialHeartModel.cyclic_one
#print axioms ExponentialHeartModel.shrinking

end SectionSevenOrlicz

