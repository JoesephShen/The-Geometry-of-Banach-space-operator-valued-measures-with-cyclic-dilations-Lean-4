noncomputable section SectionSevenBlockLimit

open Set Filter
open scoped Topology

namespace ExponentialHeartModel

variable {G : Type} [NormedAddCommGroup G] [NormedSpace ℝ G]

theorem block_norm_tendsto_one (H : ExponentialHeartModel G) :
    Tendsto (fun n => ‖H.blockVector n‖) atTop (𝓝 1) := by
  let u (n : ℕ) : ℝ := (n:ℝ)+1
  let r (n : ℕ) := Real.log (1+Real.exp (-(u n)^2)) / (u n)^2
  have hu₁ (n : ℕ) : 1 ≤ u n := le_add_of_nonneg_left (Nat.cast_nonneg n)
  have hu (n : ℕ) : 0 < u n := zero_lt_one.trans_le (hu₁ n)
  have hsq (n : ℕ) : u n ≤ (u n)^2 := by
    have h := mul_le_mul_of_nonneg_right (hu₁ n) (hu n).le
    nlinarith
  have hut : Tendsto u atTop atTop := by
    have ht : Tendsto (fun n : ℕ => ((n+1 : ℕ):ℝ)) atTop atTop :=
      tendsto_natCast_atTop_atTop.comp (tendsto_add_atTop_nat 1)
    simpa only [Nat.cast_succ] using ht
  have hsq_t : Tendsto (fun n => (u n)^2) atTop atTop :=
    tendsto_atTop.mpr (fun b => ((tendsto_atTop.mp hut) b).mono (fun n hn => hn.trans (hsq n)))
  have hi : Tendsto (fun n => 1/(u n)^2) atTop (𝓝 0) := by
    have h := tendsto_inv_atTop_zero.comp hsq_t
    change Tendsto (fun n => ((u n)^2)⁻¹) atTop (𝓝 0) at h
    simpa only [one_div] using h
  have hn (n : ℕ) : 0 ≤ Real.log (1+Real.exp (-(u n)^2)) := by
    apply Real.log_nonneg
    linarith [Real.exp_pos (-(u n)^2)]
  have hle (n : ℕ) : Real.log (1+Real.exp (-(u n)^2)) ≤ 1 := by
    have hl := Real.log_le_sub_one_of_pos (show 0 < 1+Real.exp (-(u n)^2) by positivity)
    have he := Real.exp_le_exp.mpr (show -(u n)^2 ≤ 0 by nlinarith [sq_nonneg (u n)])
    rw [Real.exp_zero] at he
    linarith
  have hr : Tendsto r atTop (𝓝 0) :=
    squeeze_zero (fun n => div_nonneg (hn n) (sq_nonneg _))
      (fun n => div_le_div_of_nonneg_right (hle n) (sq_nonneg _)) hi
  have ht : Tendsto (fun n => 1/Real.sqrt (1+r n)) atTop (𝓝 1) := by
    have hroot := (tendsto_const_nhds.add hr : Tendsto (fun n => (1:ℝ)+r n) atTop (𝓝 (1+0))).sqrt
    have h₁ : Real.sqrt (1+0:ℝ) ≠ 0 := by norm_num
    have h := (tendsto_const_nhds (x := (1:ℝ)) (f := (atTop : Filter ℕ))).div hroot h₁
    change Tendsto (fun n => 1 / Real.sqrt (1+r n)) atTop (𝓝 (1 / Real.sqrt (1+0))) at h
    simpa only [add_zero,Real.sqrt_one,div_one] using h
  apply ht.congr'
  filter_upwards with n
  rw [H.block_norm]
  change 1/Real.sqrt (1+r n) = u n/Real.sqrt (Real.log (1+Real.exp ((u n)^2)))
  have hlog : Real.log (1+Real.exp ((u n)^2)) = (u n)^2+Real.log (1+Real.exp (-(u n)^2)) := by
    have h : Real.exp ((u n)^2)*Real.exp (-(u n)^2) = 1 := by
      rw [← Real.exp_add,add_neg_cancel,Real.exp_zero]
    rw [show 1+Real.exp ((u n)^2) = Real.exp ((u n)^2)*(1+Real.exp (-(u n)^2)) by linarith [mul_add (Real.exp ((u n)^2)) 1 (Real.exp (-(u n)^2))],
      Real.log_mul (Real.exp_ne_zero _) (ne_of_gt (by positivity)),Real.log_exp]
  have hfact : (u n)^2 * (1+r n) = (u n)^2+Real.log (1+Real.exp (-(u n)^2)) := by
    dsimp [r]
    field_simp [(hu n).ne']
  rw [hlog,← hfact,Real.sqrt_mul (sq_nonneg _),Real.sqrt_sq (hu n).le]
  have hh : Real.sqrt (1+r n) ≠ 0 := ne_of_gt (Real.sqrt_pos.2
    (by have : 0 ≤ r n := div_nonneg (hn n) (sq_nonneg _); linarith))
  field_simp [(hu n).ne',hh]

end ExponentialHeartModel

