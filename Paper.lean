theorem Dilation.boundedlyComplete_iff_weaklySeqComplete [CompleteSpace X] [CompleteSpace Z]
    {μ : OVM Ω X} (D : Dilation μ Z) (hD : D.P.Localizes) :
    μ.BoundedlyComplete ↔ WeaklySeqComplete X :=
  ⟨D.weaklySeqComplete_of_boundedlyComplete hD, μ.alpha_boundedlyComplete_of_weaklySeqComplete⟩

/-- Manuscript, prop:ovm-normal (3), using the localized bidual argument
and weak sequential completeness in both implications. -/
theorem Dilation.shrinking_boundedlyComplete_iff_reflexive [CompleteSpace X] [CompleteSpace Z]
    {μ : OVM Ω X} (D : Dilation μ Z) (hD : D.P.Localizes) :
    (μ.Shrinking ∧ μ.BoundedlyComplete) ↔ IsReflexive X := by
  constructor
  · rintro ⟨hs, hbc⟩ ξ
    have hwsc := D.weaklySeqComplete_of_boundedlyComplete hD hbc
    have hn : ξ ∈ {ξ : Bidual X | BaireOne ξ} :=
      (D.normal_iff_baireOne hD ξ).mp (μ.normal_of_shrinking hs ξ)
    rw [weaklySeqComplete_iff_baireOne.mp hwsc] at hn
    exact hn
  · intro hX
    refine ⟨μ.shrinking_iff_all_normal.mpr ?_, μ.alpha_boundedlyComplete_of_weaklySeqComplete ?_⟩
    · intro ξ
      obtain ⟨x, rfl⟩ := hX ξ
      exact μ.normal_J x
    · intro x hx
      obtain ⟨ξ, hξ⟩ := exists_baireOne_of_weakCauchy x hx
      obtain ⟨y, rfl⟩ := hX ξ
      exact ⟨y, hξ⟩

