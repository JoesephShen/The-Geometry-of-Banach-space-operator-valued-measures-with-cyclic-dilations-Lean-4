theorem norm_localAffine_localization_integral (hd : 1 ≤ d) (ρ : BarronControl d)
    {p : ℝ≥0∞} [Fact (1 ≤ p)] (hp : p ≠ ⊤) (E : MeasSet (BarronSphere d))
    (hE : reflection d ⁻¹' E.1 = E.1) (z : (barronStage hd ρ p hp).Quotient) :
    let q := (foldStage hd ρ hp).ker.mkQL
    let ν := hyperplaneMeasure hd ρ.1
    let g := foldStage hd ρ hp z
    ‖q (z - (barronStage hd ρ p hp).localOVM.val E z)‖ =
      (∫ t in (hyperplaneCut hd E).1ᶜ, |g t| ^ p.toReal ∂ν) ^ p.toReal⁻¹ := by
  dsimp only
  rw [norm_localAffine_localization_exact hd ρ hp E hE z]
  let A := (hyperplaneCut hd E).1ᶜ
  let ν := hyperplaneMeasure hd ρ.1
  let g := foldStage hd ρ hp z
  have hA : MeasurableSet A := (hyperplaneCut hd E).2.compl
  have h0 : p ≠ 0 := ne_of_gt (zero_lt_one.trans_le (Fact.out : 1 ≤ p))
  have hq : 0 < p.toReal := ENNReal.toReal_pos h0 hp
  have hmeas : StronglyMeasurable (A.indicator (⇑g)) := (Lp.stronglyMeasurable g).indicator hA
  change (eLpNorm (A.indicator (⇑g)) p ν).toReal = _
  rw [eLpNorm_eq_lintegral_rpow_eNorm_toReal h0 hp hmeas.aestronglyMeasurable, ← ENNReal.toReal_rpow, one_div,
    ← integral_indicator hA]
  congr 1
  rw [integral_eq_lintegral_of_nonneg_ae
    (Eventually.of_forall fun t => Set.indicator_nonneg (fun s _ => Real.rpow_nonneg (abs_nonneg (g s)) _) t)
    (((Real.continuous_rpow_const hq.le).comp_stronglyMeasurable
      (continuous_abs.comp_stronglyMeasurable (Lp.stronglyMeasurable g))).indicator hA).aestronglyMeasurable]
  congr 1
  apply lintegral_congr_ae
  filter_upwards with t
  by_cases ht : t ∈ A
  · rw [Set.indicator_of_mem ht, Set.indicator_of_mem ht, ← ofReal_norm,
      ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hq.le, Real.norm_eq_abs]
  · simp [Set.indicator_of_notMem ht, ENNReal.zero_rpow_of_pos hq]

theorem barronCounter_hilbertBasis (hd : 1 ≤ d) :
    let hp : (2 : ℝ≥0∞) ≠ ⊤ := by norm_num
    let Q := (barronStage hd (barronCounterControl d) 2 hp).Quotient
    letI : InnerProductSpace ℝ Q := barronStageHilbert hd (barronCounterControl d) hp
    ∃ (w : Set Q) (b : HilbertBasis w ℝ Q), ⇑b = ((↑) : w → Q) := by
  dsimp only
  exact @exists_hilbertBasis ℝ inferInstance _ inferInstance
    (barronStageHilbert hd (barronCounterControl d) (by norm_num)) inferInstance

