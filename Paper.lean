noncomputable section SpectralExamples

open MeasureTheory
open scoped ENNReal BigOperators

theorem complexSeqTwo_separable : TopologicalSpace.SeparableSpace ComplexSeqTwo := by
  let S := Submodule.span ℂ (Set.range complexSeqUnit)
  have hs : TopologicalSpace.IsSeparable (S : Set ComplexSeqTwo) := (Set.countable_range complexSeqUnit).isSeparable.span
  have hd : Dense (S : Set ComplexSeqTwo) := by
    intro x
    have hn (n : ℕ) : (lp.single 2 n (x n) : ComplexSeqTwo) ∈ S := by
      have he : (lp.single 2 n (x n) : ComplexSeqTwo) = x n • complexSeqUnit n := by
        apply Subtype.ext
        funext i
        change (lp.single 2 n (x n) : ComplexSeqTwo) i = ((x n • complexSeqUnit n) : ComplexSeqTwo) i
        rw [lp.coeFn_smul]
        by_cases h : i = n <;> simp [complexSeqUnit, lp.single_apply, h, Pi.single_eq_of_ne]
      rw [he]
      exact S.smul_mem _ (Submodule.subset_span ⟨n, rfl⟩)
    exact isClosed_closure.mem_of_tendsto ((lp.hasSum_single (by norm_num) x).tendsto_sum_nat)
      (Eventually.of_forall fun n => subset_closure (S.sum_mem fun i _ => hn i))
  have hU : TopologicalSpace.IsSeparable (Set.univ : Set ComplexSeqTwo) := hd.closure_eq ▸ hs.closure
  obtain ⟨s, hc, hs'⟩ := hU
  exact ⟨⟨s, hc, fun x => hs' (mem_univ x)⟩⟩

/-- The concrete phase observable with its original cyclic complex
multiplication dilation and obstruction to any same-circle frame. -/
theorem exists_hardy_toeplitz :
    ∃ m : Measure SpectralCircle, CircleNormalizedHaar m ∧
      ∃ hm : IsProbabilityMeasure m, letI := hm;
      ∃ H : HardyFourierCoordinates m,
        H.phase MeasSet.whole = ContinuousLinearMap.id ℂ _ ∧
        (∀ A : ℕ → MeasSet SpectralCircle, MeasSet.DisjointSeq A → ∀ x,
          HasSum (fun n => H.phase (A n) x) (H.phase (MeasSet.iUnion A) x)) ∧
        (∀ E x, 0 ≤ (seqTwoPair (H.phase E x) x).re ∧ (seqTwoPair (H.phase E x) x).im = 0) ∧
        ComplexCyclicVector (complexLTwoCut m) (complexLTwoOne m) ∧
        (∀ E n, seqTwoPair (H.phase E (complexSeqUnit n)) (complexSeqUnit n) = ↑(m.real E.1)) ∧
        (∀ E : MeasSet SpectralCircle, 0 < m E.1 → ¬ IsCompactOperator (H.phase E)) ∧
        (¬ ∃ η : Measure SpectralCircle, SigmaFinite η ∧ Nonempty (ComplexSchauderRepresentation η H.phase)) := by
  obtain ⟨m, hm, hp, ⟨H⟩⟩ := citeHardyFourierCoordinates
  let := hp
  exact ⟨m, hm, hp, H, H.phase_normalized, H.phase_countably_additive, H.phase_positive,
    complexLTwoCut_cyclic m, H.phase_diagonal, H.phase_not_compact, H.phase_no_frame complexSeqTwo_separable⟩

/-- The Koopman example, with the cyclic restriction of the spectral
measure and its exact pure-atomic criterion. -/
theorem exists_koopman_cyclic_spectral {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (τ : Ω ≃ᵐ Ω) (hτ : MeasurePreserving τ μ μ) (g : ComplexLTwo μ) (hg : ‖g‖ = 1) :
    ∃ B : CyclicUnitarySpectralData (koopmanUnitary μ τ hτ) g, letI := B.probability;
      ComplexCyclicVector B.cut (B.W (complexLTwoOne B.ρ)) ∧
      ((∃ η : Measure SpectralCircle, SigmaFinite η ∧ Nonempty (ComplexSchauderRepresentation η B.cut))
        ↔ spectralPurelyAtomic B.ρ) := by
  obtain ⟨B⟩ := citeCyclicUnitarySpectralTheorem (koopmanUnitary μ τ hτ) g hg
  exact ⟨B, B.cut_cyclic, B.cut_frame_iff_atomic⟩

#print axioms complexSeqTwo_separable
#print axioms exists_hardy_toeplitz
#print axioms exists_koopman_cyclic_spectral

theorem HardyFourierCoordinates.phase_cross_pair {m : MeasureTheory.Measure SpectralCircle}
    [MeasureTheory.IsProbabilityMeasure m] (H : HardyFourierCoordinates m)
    (E : MeasSet SpectralCircle) (x y : ComplexSeqTwo) :
    seqTwoPair (H.phase E x) y = ∫ t in E.1, H.V x t * star (H.V y t) ∂m := by
  open MeasureTheory in
  change seqTwoPair (H.adj (complexLTwoCut m E (H.V x))) y = _
  open MeasureTheory in
  rw [H.adj_pair, ← integral_indicator E.2]
  open MeasureTheory in
  apply integral_congr_ae
  filter_upwards [complexLTwoCut_apply_ae m E (H.V x)] with t ht
  rw [ht]
  by_cases h : t ∈ E.1 <;> simp [h]

/-- The scalar evaluation of the weak operator integral for every
bounded Borel symbol, with the exact Toeplitz compression. -/
theorem HardyFourierCoordinates.toeplitz_integral_pair {m : MeasureTheory.Measure SpectralCircle}
    [MeasureTheory.IsProbabilityMeasure m] (H : HardyFourierCoordinates m)
    (b : SpectralCircle → ℂ) (hb : Measurable b)
    (C : ℝ) (hC : 0 ≤ C) (hbound : ∀ t, ‖b t‖ ≤ C) (x y : ComplexSeqTwo) :
    seqTwoPair (H.toeplitz b hb C hC hbound x) y =
      ∫ t, b t * (H.V x t * star (H.V y t)) ∂m := by
  change seqTwoPair (H.adj (complexLTwoMultiplier m b hb C hC hbound (H.V x))) y = _
  rw [H.adj_pair]
  apply MeasureTheory.integral_congr_ae
  filter_upwards [complexLTwoMultiplier_apply_ae m b hb C hC hbound (H.V x)] with t ht
  rw [ht, mul_assoc]

#print axioms HardyFourierCoordinates.toeplitz_integral_pair

end SpectralExamples


noncomputable section BarronSignedIntegration

open MeasureTheory
open scoped ENNReal Classical

variable {Ω : Type*} [MeasurableSpace Ω]

local instance : TopologicalSpace (MeasSet Ω × MeasSet Ω) := ⊥

namespace FiniteSignedMeasure

def signedIntegral (b : boundedMeasurableAlgebra Ω) : FiniteSignedMeasure Ω →L[ℝ] ℝ :=
  (eval MeasSet.whole).comp ((restrictionPVM Ω).boundedMeasurableRepresentation b)

theorem signedIntegral_ofDensity (b : boundedMeasurableAlgebra Ω)
    {ρ : Measure Ω} {f : Ω → ℝ} (hf : Integrable f ρ) :
    signedIntegral b (ofDensity hf) = ∫ t, b.1 t * f t ∂ρ := by
  change eval MeasSet.whole ((restrictionPVM Ω).toOVM.boundedMeasurableMultiplier b (ofDensity hf)) = _
  refine OVM.boundedMeasurableMultiplier_orbit (restrictionPVM Ω).toOVM b
    (ofDensity hf) (eval MeasSet.whole) ρ f hf (fun E => ?_)
  change eval MeasSet.whole (cut E (ofDensity hf)) = _
  rw [eval_cut, eval_ofDensity]
  have he : MeasSet.whole.inter E = E := Subtype.ext (univ_inter _)
  rw [he]

theorem exists_own_variation_density (μ : FiniteSignedMeasure Ω) :
    ∃ f : Ω → ℝ, Measurable f ∧ ∃ hf : Integrable f (toMeasure (modulus μ) (modulus_positive μ)),
      ofDensity hf = μ := by
  apply exists_density
  intro E hE
  rw [toMeasure_apply] at hE
  have hpos := modulus_positive μ E
  have hz : eval E (modulus μ) = 0 :=
    le_antisymm (ENNReal.ofReal_eq_zero.mp hE) hpos
  exact abs_eq_zero.mp (le_antisymm ((abs_eval_le_modulus μ E).trans_eq hz) (abs_nonneg _))

theorem signedIntegral_norm_le (b : boundedMeasurableAlgebra Ω) (μ : FiniteSignedMeasure Ω)
    (C : ℝ) (hc : ∀ t, ‖b.1 t‖ ≤ C) : ‖signedIntegral b μ‖ ≤ C * ‖μ‖ := by
  obtain ⟨f, _, hf, hμ⟩ := exists_own_variation_density μ
  rw [← hμ, signedIntegral_ofDensity b hf, norm_ofDensity, ← integral_const_mul]
  refine (norm_integral_le_integral_norm _).trans ?_
  apply integral_mono_ae (integrable_boundedMeasurable_mul b hf).norm (hf.norm.const_mul C)
  filter_upwards with t
  rw [norm_mul]
  exact mul_le_mul_of_nonneg_right (hc t) (norm_nonneg _)

/-- Real bounded measurable functions use their actual pointwise symbols. -/
def boundedSymbol (f : Ω → ℝ) (hf : Measurable f) (C : ℝ) (hC : ∀ t, ‖f t‖ ≤ C) :
    boundedMeasurableAlgebra Ω := by
  letI : TopologicalSpace Ω := ⊥
  letI : DiscreteTopology Ω := ⟨rfl⟩
  exact ⟨BoundedContinuousFunction.mkOfBound ⟨f, continuous_of_discreteTopology⟩ (C + C)
    (fun x y => (dist_le_norm_add_norm _ _).trans (add_le_add (hC x) (hC y))), hf⟩

theorem boundedSymbol_apply (f : Ω → ℝ) (hf : Measurable f) (C : ℝ) (hC : ∀ t, ‖f t‖ ≤ C) (t : Ω) :
    (boundedSymbol f hf C hC).1 t = f t := rfl

theorem signedIntegral_congr {b c : boundedMeasurableAlgebra Ω}
    (h : ∀ t, b.1 t = c.1 t) : signedIntegral b = signedIntegral c := by
  let : TopologicalSpace Ω := ⊥
  exact congrArg signedIntegral (Subtype.ext (BoundedContinuousFunction.ext h))

theorem signedIntegral_add (b c : boundedMeasurableAlgebra Ω) (μ : FiniteSignedMeasure Ω) :
    signedIntegral (b + c) μ = signedIntegral b μ + signedIntegral c μ := by
  unfold signedIntegral
  rw [map_add]
  simp only [ContinuousLinearMap.comp_apply, add_apply, map_add]

theorem signedIntegral_smul (a : ℝ) (b : boundedMeasurableAlgebra Ω) (μ : FiniteSignedMeasure Ω) :
    signedIntegral (a • b) μ = a * signedIntegral b μ := by
  unfold signedIntegral
  rw [map_smul]
  simp only [ContinuousLinearMap.comp_apply, smul_apply, map_smul, smul_eq_mul]

theorem signedIntegral_cut (b : boundedMeasurableAlgebra Ω) (E : MeasSet Ω)
    (μ : FiniteSignedMeasure Ω) :
    signedIntegral b (cut E μ) = signedIntegral (b * measurableIndicator E) μ := by
  unfold signedIntegral
  rw [map_mul, PVM.boundedMeasurableRepresentation_indicator]
  rfl

/-- The atomic measure used in the affine correction. -/
def pointMass (t : Ω) : FiniteSignedMeasure Ω :=
  ofDensity (ρ := Measure.dirac t) (integrable_const (1 : ℝ))

@[simp] theorem signedIntegral_pointMass (b : boundedMeasurableAlgebra Ω)
    [MeasurableSingletonClass Ω] (t : Ω) :
    signedIntegral b (pointMass t) = b.1 t := by
  rw [pointMass, signedIntegral_ofDensity]
  simp only [mul_one]
  exact integral_dirac _ _

theorem eval_pointMass [MeasurableSingletonClass Ω] (E : MeasSet Ω) (t : Ω) :
    eval E (pointMass t) = if t ∈ E.1 then 1 else 0 := by
  classical
  rw [pointMass, eval_ofDensity, setIntegral_const]
  by_cases h : t ∈ E.1
  · rw [Measure.real, Measure.dirac_apply' _ E.2, indicator_of_mem h]
    simp [h]
  · rw [Measure.real, Measure.dirac_apply' _ E.2, indicator_of_notMem h]
    simp [h]

theorem norm_pointMass (t : Ω) : ‖pointMass t‖ = 1 := by
  rw [pointMass, norm_ofDensity]
  simp

-- The finite signed pushforward is defined by the values on measurable cuts.
def pushforward (r : Ω ≃ᵐ Ω) : FiniteSignedMeasure Ω →L[ℝ] FiniteSignedMeasure Ω := by
  let pre (E : MeasSet Ω) : MeasSet Ω := ⟨r ⁻¹' E.1, r.measurable E.2⟩
  let φ (μ : FiniteSignedMeasure Ω) : ScalarCharge Ω :=
    { val := fun E => eval (pre E) μ
      empty_eq := by
        obtain ⟨ν, hν, rfl⟩ := exists_charge μ
        rw [eval_ofCharge, show pre MeasSet.empty = MeasSet.empty from Subtype.ext (preimage_empty), ν.empty_eq]
      add_union := fun E F hd => by
        obtain ⟨ν, hν, rfl⟩ := exists_charge μ
        simp only [eval_ofCharge]
        exact ν.add_union (pre E) (pre F) (hd.preimage r)
      bounded := ⟨‖μ‖, fun E => by
        change |μ.1 ((pre E), MeasSet.empty)| ≤ ‖μ.1‖
        exact μ.1.norm_coe_le_norm _⟩ }
  have hs (μ : FiniteSignedMeasure Ω) : (φ μ).CountablyAdditive := by
    obtain ⟨ν, hν, rfl⟩ := exists_charge μ
    intro A hA
    have he : MeasSet.iUnion (fun n => pre (A n)) = pre (MeasSet.iUnion A) := Subtype.ext preimage_iUnion.symm
    change HasSum (fun n => eval (pre (A n)) (ofCharge ν hν))
      (eval (pre (MeasSet.iUnion A)) (ofCharge ν hν))
    simp only [eval_ofCharge]
    rw [← he]
    exact hν _ (fun i j hij => (hA hij).preimage r)
  let L : FiniteSignedMeasure Ω →ₗ[ℝ] FiniteSignedMeasure Ω :=
    { toFun := fun μ => ofCharge (φ μ) (hs μ)
      map_add' := fun μ ν => by
        apply FiniteSignedMeasure.ext
        intro E
        simp only [eval_ofCharge, map_add]
        rfl
      map_smul' := fun c μ => by
        apply FiniteSignedMeasure.ext
        intro E
        simp only [eval_ofCharge, map_smul]
        rfl }
  refine LinearMap.mkContinuous (𝕜 := ℝ) (𝕜₂ := ℝ)
    (E := FiniteSignedMeasure Ω) (F := FiniteSignedMeasure Ω) L 1 (fun μ => ?_)
  rw [one_mul]
  obtain ⟨ν, hν, rfl⟩ := exists_charge μ
  change ‖(ofCharge (φ (ofCharge ν hν)) (hs _)).1‖ ≤ ‖(ofCharge ν hν).1‖
  apply (BoundedContinuousFunction.norm_le (norm_nonneg _)).mpr
  rintro ⟨E, F⟩
  change ‖eval (pre E) (ofCharge ν hν) - eval (pre F) (ofCharge ν hν)‖ ≤ _
  simp only [eval_ofCharge]
  exact (ofCharge ν hν).1.norm_coe_le_norm (pre E, pre F)

@[simp] theorem eval_pushforward (r : Ω ≃ᵐ Ω) (E : MeasSet Ω) (μ : FiniteSignedMeasure Ω) :
    eval E (pushforward r μ) = eval ⟨r ⁻¹' E.1, r.measurable E.2⟩ μ := by
  unfold pushforward
  simp only [LinearMap.mkContinuous_apply, LinearMap.coe_mk, AddHom.coe_mk, eval_ofCharge]

theorem pushforward_cut (r : Ω ≃ᵐ Ω) (E : MeasSet Ω) (μ : FiniteSignedMeasure Ω) :
    cut E (pushforward r μ) = pushforward r (cut ⟨r ⁻¹' E.1, r.measurable E.2⟩ μ) := by
  apply FiniteSignedMeasure.ext
  intro F
  simp only [eval_cut, eval_pushforward]
  congr 1

theorem pushforward_involutive (r : Ω ≃ᵐ Ω) (hr : Function.Involutive r)
    (μ : FiniteSignedMeasure Ω) : pushforward r (pushforward r μ) = μ := by
  apply FiniteSignedMeasure.ext
  intro E
  simp only [eval_pushforward]
  have he : (⟨r ⁻¹' r ⁻¹' E.1, r.measurable (r.measurable E.2)⟩ : MeasSet Ω) = E := by
    apply Subtype.ext
    ext x
    change r (r x) ∈ E.1 ↔ x ∈ E.1
    rw [hr]
  rw [he]

theorem signedIntegral_pushforward (r : Ω ≃ᵐ Ω)
    (b c : boundedMeasurableAlgebra Ω) (hbc : ∀ t, c.1 t = b.1 (r t))
    (μ : FiniteSignedMeasure Ω) :
    signedIntegral b (pushforward r μ) = signedIntegral c μ := by
  obtain ⟨f, hmf, hf, he⟩ := exists_own_variation_density μ
  let ρ := toMeasure (modulus μ) (modulus_positive μ)
  let ν := Measure.map r ρ
  let v := fun t => f (r.symm t)
  have hvm : Measurable v := hmf.comp r.symm.measurable
  have hvi : Integrable v ν := by
    apply (integrable_map_measure hvm.aestronglyMeasurable r.measurable.aemeasurable).mpr
    simpa only [v, Function.comp_def, r.symm_apply_apply] using hf
  have hp : pushforward r μ = ofDensity hvi := by
    apply FiniteSignedMeasure.ext
    intro E
    rw [eval_pushforward, ← he, eval_ofDensity, eval_ofDensity]
    rw [← integral_indicator E.2, integral_map r.measurable.aemeasurable (hvm.indicator E.2).aestronglyMeasurable,
      ← integral_indicator (r.measurable E.2)]
    apply integral_congr_ae
    filter_upwards with t
    by_cases h : r t ∈ E.1
    · rw [indicator_of_mem h, indicator_of_mem (show t ∈ r ⁻¹' E.1 from h)]
      exact (congrArg f (r.symm_apply_apply t)).symm
    · rw [indicator_of_notMem h, indicator_of_notMem (show t ∉ r ⁻¹' E.1 from h)]
  rw [hp, ← he, signedIntegral_ofDensity b hvi, signedIntegral_ofDensity c hf]
  change (∫ t, (b.1 * v) t ∂Measure.map r ρ) = ∫ t, c.1 t * f t ∂ρ
  rw [integral_map r.measurable.aemeasurable (b.2.mul hvm).aestronglyMeasurable]
  apply integral_congr_ae
  filter_upwards with t
  change b.1 (r t) * f (r.symm (r t)) = c.1 t * f t
  rw [r.symm_apply_apply, hbc]

theorem pushforward_pointMass [MeasurableSingletonClass Ω] (r : Ω ≃ᵐ Ω) (t : Ω) :
    pushforward r (pointMass t) = pointMass (r t) := by
  apply FiniteSignedMeasure.ext
  intro E
  rw [eval_pushforward, eval_pointMass, eval_pointMass]
  rfl

theorem cut_pointMass [MeasurableSingletonClass Ω] (E : MeasSet Ω) (t : Ω) :
    cut E (pointMass t) = if t ∈ E.1 then pointMass t else 0 := by
  apply FiniteSignedMeasure.ext
  intro F
  rw [eval_cut, eval_pointMass]
  by_cases h : t ∈ E.1
  · simp [MeasSet.inter, h, eval_pointMass]
  · simp [MeasSet.inter, h]

end FiniteSignedMeasure

#print axioms FiniteSignedMeasure.signedIntegral_norm_le
#print axioms FiniteSignedMeasure.pushforward_involutive

end BarronSignedIntegration


noncomputable section BarronSphereCoordinates

open MeasureTheory
open scoped BigOperators ENNReal Classical
open FiniteSignedMeasure

/-- The Euclidean parameter sphere with all d weights and the bias. -/
abbrev BarronSphere (d : ℕ) :=
  {u : (Fin d → ℝ) × ℝ // (∑ i, (u.1 i)^2) + u.2^2 = 1}

namespace BarronSphere

local instance (Ω : Type*) [MeasurableSpace Ω] : TopologicalSpace (MeasSet Ω × MeasSet Ω) := ⊥

variable {d : ℕ}

def weight (θ : BarronSphere d) (i : Fin d) : ℝ := θ.1.1 i
def bias (θ : BarronSphere d) : ℝ := θ.1.2

theorem norm_weight_le (θ : BarronSphere d) (i : Fin d) : ‖θ.weight i‖ ≤ 1 := by
  have ht := θ.2
  have hi : (θ.weight i)^2 ≤ ∑ j : Fin d, (θ.weight j)^2 :=
    Finset.single_le_sum (fun j _ => sq_nonneg (θ.weight j)) (Finset.mem_univ i)
  change (∑ i, (θ.weight i)^2) + θ.bias^2 = 1 at ht
  have h : (θ.weight i)^2 ≤ 1 := by linarith [sq_nonneg θ.bias]
  rw [Real.norm_eq_abs, abs_le]
  constructor <;> nlinarith

theorem norm_bias_le (θ : BarronSphere d) : ‖θ.bias‖ ≤ 1 := by
  have ht := θ.2
  have hu : 0 ≤ ∑ i : Fin d, (θ.weight i)^2 := Finset.sum_nonneg fun i _ => sq_nonneg _
  change (∑ i, (θ.weight i)^2) + θ.bias^2 = 1 at ht
  have h : θ.bias^2 ≤ 1 := by linarith
  rw [Real.norm_eq_abs, abs_le]
  constructor <;> nlinarith

private def negate (θ : BarronSphere d) : BarronSphere d :=
  ⟨(-θ.1.1, -θ.bias), by
    change (∑ i, (-θ.weight i)^2) + (-θ.bias)^2 = 1
    simp only [neg_sq]
    exact θ.2⟩

private theorem negate_involutive : Function.Involutive (negate (d := d)) := by
  intro θ
  apply Subtype.ext
  ext i <;> simp [negate, bias]

private theorem continuous_negate : Continuous (negate (d := d)) := by
  apply Continuous.subtype_mk
  exact (continuous_subtype_val.fst.neg).prodMk (continuous_subtype_val.snd.neg)

def reflection (d : ℕ) : BarronSphere d ≃ᵐ BarronSphere d :=
  ⟨⟨negate, negate, negate_involutive, negate_involutive⟩,
    continuous_negate.measurable, continuous_negate.measurable⟩

theorem reflection_involutive (d : ℕ) : Function.Involutive (reflection d) :=
  negate_involutive

@[simp] theorem weight_reflection (θ : BarronSphere d) (i : Fin d) :
    (reflection d θ).weight i = -θ.weight i := rfl

@[simp] theorem bias_reflection (θ : BarronSphere d) :
    (reflection d θ).bias = -θ.bias := rfl

def polePlus (d : ℕ) : BarronSphere d := ⟨(0, 1), by simp⟩
def poleMinus (d : ℕ) : BarronSphere d := ⟨(0, -1), by simp⟩

def axis (i : Fin d) : BarronSphere d :=
  ⟨(Pi.single i 1, 0), by
    change (∑ j : Fin d, (Pi.single i (1 : ℝ) j)^2) + (0 : ℝ)^2 = 1
    rw [Finset.sum_eq_single i]
    · simp
    · intro j _ h
      simp [Pi.single_eq_of_ne h]
    · simp⟩

def axisMinus (i : Fin d) : BarronSphere d := reflection d (axis i)

@[simp] theorem weight_polePlus (i : Fin d) : (polePlus d).weight i = 0 := rfl
@[simp] theorem weight_poleMinus (i : Fin d) : (poleMinus d).weight i = 0 := rfl
@[simp] theorem bias_polePlus : (polePlus d).bias = 1 := rfl
@[simp] theorem bias_poleMinus : (poleMinus d).bias = -1 := rfl
@[simp] theorem weight_axis (i j : Fin d) : (axis i).weight j = if j = i then 1 else 0 := by
  change (Pi.single i (1 : ℝ) : Fin d → ℝ) j = _
  by_cases h : j = i <;> simp [h, Pi.single_eq_of_ne]
@[simp] theorem bias_axis (i : Fin d) : (axis i).bias = 0 := rfl
@[simp] theorem bias_axisMinus (i : Fin d) : (axisMinus i).bias = 0 := by simp [axisMinus]

def nonPole (d : ℕ) : MeasSet (BarronSphere d) := by
  have hb : Measurable (bias (d := d)) := continuous_subtype_val.snd.measurable
  exact ⟨{θ | θ.bias ≠ 1} ∩ {θ | θ.bias ≠ -1},
    (hb (measurableSet_singleton (1 : ℝ))).compl.inter
      (hb (measurableSet_singleton (-1 : ℝ))).compl⟩

theorem nonPole_eq_compl (d : ℕ) :
    (nonPole d).1 = ({polePlus d, poleMinus d} : Set (BarronSphere d))ᶜ := by
  have hz (θ : BarronSphere d) (h : θ.bias = 1 ∨ θ.bias = -1) : θ.weight = 0 := by
    have he : (∑ i, (θ.weight i)^2) + θ.bias^2 = 1 := θ.2
    have hb : θ.bias^2 = 1 := by rcases h with ht | ht <;> rw [ht] <;> norm_num
    rw [hb, add_eq_right] at he
    funext i
    have hi : (θ.weight i)^2 ≤ ∑ j : Fin d, (θ.weight j)^2 :=
      Finset.single_le_sum (fun j _ => sq_nonneg _) (Finset.mem_univ i)
    rw [he] at hi
    change θ.weight i = 0
    nlinarith
  ext θ
  constructor
  · intro ht hn
    have hh : θ = polePlus d ∨ θ = poleMinus d := by simpa only [mem_insert_iff, Set.mem_singleton_iff] using hn
    rcases hh with rfl | rfl
    · exact ht.1 rfl
    · exact ht.2 rfl
  · intro h
    constructor
    · intro hi
      apply h
      have he : θ = polePlus d := Subtype.ext (Prod.ext (hz θ (Or.inl hi)) hi)
      simp [he]
    · intro hi
      apply h
      have he : θ = poleMinus d := Subtype.ext (Prod.ext (hz θ (Or.inr hi)) hi)
      simp [he]

theorem reflection_preimage_nonPole (d : ℕ) : reflection d ⁻¹' (nonPole d).1 = (nonPole d).1 := by
  ext θ
  change ((-θ.bias ≠ 1) ∧ (-θ.bias ≠ -1)) ↔ θ.bias ≠ 1 ∧ θ.bias ≠ -1
  constructor
  · rintro ⟨h₁, h₂⟩
    exact ⟨fun h => h₂ (by rw [h]), fun h => h₁ (by rw [h]; norm_num)⟩
  · rintro ⟨h₁, h₂⟩
    exact ⟨fun h => h₂ (by linarith), fun h => h₁ (by linarith)⟩

def weightSymbol (i : Fin d) : boundedMeasurableAlgebra (BarronSphere d) :=
  boundedSymbol (fun θ => θ.weight i) (continuous_apply i |>.comp continuous_subtype_val.fst |>.measurable)
    1 (fun θ => norm_weight_le θ i)

def biasSymbol (d : ℕ) : boundedMeasurableAlgebra (BarronSphere d) :=
  boundedSymbol bias continuous_subtype_val.snd.measurable 1 norm_bias_le

def reflectedEven (d : ℕ) : FiniteSignedMeasure (BarronSphere d) →ₗ[ℝ] FiniteSignedMeasure (BarronSphere d) :=
  (1 / 2 : ℝ) • ((cut (nonPole d)).toLinearMap +
    (cut (nonPole d)).toLinearMap.comp (pushforward (reflection d)).toLinearMap)

def affineCoefficients (d : ℕ) :
    FiniteSignedMeasure (BarronSphere d) →L[ℝ] ((Fin d → ℝ) × ℝ) := by
  let W (i : Fin d) : FiniteSignedMeasure (BarronSphere d) →L[ℝ] ℝ :=
    (1 / 2 : ℝ) • (signedIntegral (weightSymbol i)).comp (cut (nonPole d))
  exact (ContinuousLinearMap.pi W).prod
    ((1 / 2 : ℝ) • (signedIntegral (biasSymbol d)).comp (cut (nonPole d)) +
      eval ⟨{polePlus d}, measurableSet_singleton _⟩)

def affineAtoms (d : ℕ) : ((Fin d → ℝ) × ℝ) →ₗ[ℝ] FiniteSignedMeasure (BarronSphere d) := by
  let L (i : Fin d) : ((Fin d → ℝ) × ℝ) →ₗ[ℝ] ℝ :=
    ((ContinuousLinearMap.proj i : (Fin d → ℝ) →L[ℝ] ℝ).comp
      (ContinuousLinearMap.fst ℝ (Fin d → ℝ) ℝ)).toLinearMap
  exact (∑ i : Fin d, (L i).smulRight (pointMass (axis i) - pointMass (axisMinus i))) +
    (ContinuousLinearMap.snd ℝ (Fin d → ℝ) ℝ).toLinearMap.smulRight (pointMass (polePlus d))

def canonicalProjection (d : ℕ) :
    FiniteSignedMeasure (BarronSphere d) →ₗ[ℝ] FiniteSignedMeasure (BarronSphere d) :=
  reflectedEven d + (affineAtoms d).comp (affineCoefficients d).toLinearMap

theorem reflectedEven_apply (μ : FiniteSignedMeasure (BarronSphere d)) :
    reflectedEven d μ = (1 / 2 : ℝ) • (cut (nonPole d) μ + cut (nonPole d) (pushforward (reflection d) μ)) := rfl

theorem reflectedEven_supported (μ : FiniteSignedMeasure (BarronSphere d)) :
    cut (nonPole d) (reflectedEven d μ) = reflectedEven d μ := by
  have hc (x : FiniteSignedMeasure (BarronSphere d)) :
      cut (nonPole d) (cut (nonPole d) x) = cut (nonPole d) x := by
    have he := DFunLike.congr_fun ((restrictionPVM (BarronSphere d)).mul_eq (nonPole d) (nonPole d)) x
    change cut (nonPole d) (cut (nonPole d) x) = cut ((nonPole d).inter (nonPole d)) x at he
    rw [show (nonPole d).inter (nonPole d) = nonPole d from Subtype.ext (Set.inter_self _)] at he
    exact he
  rw [reflectedEven_apply, map_smul, map_add, hc, hc]

theorem reflectedEven_even (μ : FiniteSignedMeasure (BarronSphere d)) :
    pushforward (reflection d) (reflectedEven d μ) = reflectedEven d μ := by
  have hcut (μ : FiniteSignedMeasure (BarronSphere d)) :
      pushforward (reflection d) (cut (nonPole d) μ) = cut (nonPole d) (pushforward (reflection d) μ) := by
    have he := pushforward_cut (reflection d) (nonPole d) μ
    have ha : (⟨reflection d ⁻¹' (nonPole d).1, (reflection d).measurable (nonPole d).2⟩ :
      MeasSet (BarronSphere d)) = nonPole d := Subtype.ext (reflection_preimage_nonPole d)
    rw [ha] at he
    exact he.symm
  rw [reflectedEven_apply, map_smul, map_add, hcut, hcut,
    pushforward_involutive _ (reflection_involutive d), add_comm]

theorem reflectedEven_idempotent (μ : FiniteSignedMeasure (BarronSphere d)) :
    reflectedEven d (reflectedEven d μ) = reflectedEven d μ := by
  rw [reflectedEven_apply (reflectedEven d μ), reflectedEven_even, reflectedEven_supported, ← two_smul ℝ]
  rw [smul_smul]
  norm_num

theorem reflectedEven_affineAtoms (a : (Fin d → ℝ) × ℝ) :
    reflectedEven d (affineAtoms d a) = 0 := by
  have haxis (i : Fin d) :
      reflectedEven d (pointMass (axis i) - pointMass (axisMinus i)) = 0 := by
    have h (i : Fin d) : reflection d (axisMinus i) = axis i := reflection_involutive d _
    rw [reflectedEven_apply]
    have hm (x y : FiniteSignedMeasure (BarronSphere d)) :
        cut (nonPole d) (x - y) = cut (nonPole d) x - cut (nonPole d) y :=
      map_sub (cut (nonPole d)).toLinearMap x y
    have hj : pushforward (reflection d) (pointMass (axis i) - pointMass (axisMinus i)) =
        pointMass (axisMinus i) - pointMass (axis i) := by
      rw [show pushforward (reflection d) (pointMass (axis i) - pointMass (axisMinus i)) =
        pushforward (reflection d) (pointMass (axis i)) - pushforward (reflection d) (pointMass (axisMinus i))
        from map_sub (pushforward (reflection d)).toLinearMap _ _, pushforward_pointMass,
        pushforward_pointMass, h]
      rfl
    rw [hj, hm, hm]
    change (1 / 2 : ℝ) •
      ((cut (nonPole d)) (pointMass (axis i)) - (cut (nonPole d)) (pointMass (axisMinus i)) +
        ((cut (nonPole d)) (pointMass (axisMinus i)) - (cut (nonPole d)) (pointMass (axis i)))) = _
    convert (smul_zero (1 / 2 : ℝ) : (1 / 2 : ℝ) • (0 : FiniteSignedMeasure (BarronSphere d)) = 0) using 2
    abel
  have hp : reflectedEven d (pointMass (polePlus d)) = 0 := by
    have hs : reflection d (polePlus d) = poleMinus d := by
      apply Subtype.ext
      exact Prod.ext (neg_zero : -(0 : Fin d → ℝ) = 0) rfl
    rw [reflectedEven_apply, pushforward_pointMass, hs, cut_pointMass, cut_pointMass]
    have h₁ : polePlus d ∉ (nonPole d).1 := fun h => h.1 rfl
    have h₂ : poleMinus d ∉ (nonPole d).1 := fun h => h.2 rfl
    simp [h₁, h₂]
  unfold affineAtoms
  simp [LinearMap.smulRight_apply, map_add, map_sum, map_smul, hp, haxis]

theorem affineCoefficients_apply (μ : FiniteSignedMeasure (BarronSphere d)) :
    affineCoefficients d μ =
      (fun i => (1 / 2 : ℝ) * signedIntegral (weightSymbol i) (cut (nonPole d) μ),
        (1 / 2 : ℝ) * signedIntegral (biasSymbol d) (cut (nonPole d) μ) +
          eval ⟨{polePlus d}, measurableSet_singleton _⟩ μ) := rfl

theorem affineAtoms_apply (a : (Fin d → ℝ) × ℝ) :
    affineAtoms d a = (∑ i : Fin d, a.1 i •
      (pointMass (axis i) - pointMass (axisMinus i))) + a.2 • pointMass (polePlus d) := by
  simp [affineAtoms, LinearMap.smulRight_apply]

private theorem signedIntegral_odd_of_even (r : BarronSphere d ≃ᵐ BarronSphere d)
    (b : boundedMeasurableAlgebra (BarronSphere d))
    (hodd : ∀ t, b.1 (r t) = - b.1 t)
    (μ : FiniteSignedMeasure (BarronSphere d)) (he : pushforward r μ = μ) :
    signedIntegral b μ = 0 := by
  have h := signedIntegral_pushforward r b ((-1 : ℝ) • b) (fun t => by
    have hh := hodd t
    change (-1 : ℝ) * b.1 t = b.1 (r t)
    linarith) μ
  rw [he, signedIntegral_smul] at h
  linarith

theorem affineCoefficients_reflectedEven (μ : FiniteSignedMeasure (BarronSphere d)) :
    affineCoefficients d (reflectedEven d μ) = 0 := by
  have hWeight (i : Fin d) := signedIntegral_odd_of_even (reflection d) (weightSymbol i)
    (fun t => weight_reflection t i) (reflectedEven d μ) (reflectedEven_even μ)
  have hBias := signedIntegral_odd_of_even (reflection d) (biasSymbol d)
    bias_reflection (reflectedEven d μ) (reflectedEven_even μ)
  have hPole : eval (⟨{polePlus d}, measurableSet_singleton _⟩ : MeasSet (BarronSphere d))
      (reflectedEven d μ) = 0 := by
    let A : MeasSet (BarronSphere d) := ⟨{polePlus d}, measurableSet_singleton _⟩
    have he : A.inter (nonPole d) = MeasSet.empty := by
      apply Subtype.ext
      apply Set.eq_empty_iff_forall_notMem.mpr
      intro t ht
      have h := ht.1
      change t = polePlus d at h
      subst t
      exact ht.2.1 rfl
    have h := congrArg (fun ν => eval A ν) (reflectedEven_supported μ)
    rw [eval_cut, he] at h
    rw [← h]
    obtain ⟨c, hc, hEq⟩ := exists_charge (reflectedEven d μ)
    rw [← hEq, eval_ofCharge, c.empty_eq]
  rw [affineCoefficients_apply, reflectedEven_supported, hBias, hPole]
  simp [hWeight, Pi.zero_def]

private theorem axis_ne_polePlus (i : Fin d) : axis i ≠ polePlus d := by
  intro he
  have h := congrArg bias he
  simp at h

private theorem axisMinus_ne_polePlus (i : Fin d) : axisMinus i ≠ polePlus d := by
  intro he
  have h := congrArg bias he
  simp at h

private theorem affineCoefficients_axis_difference (i : Fin d) :
    affineCoefficients d (pointMass (axis i) - pointMass (axisMinus i)) =
      (Pi.single i 1, 0) := by
  have hAxis : axis i ∈ (nonPole d).1 := by
    change (axis i).bias ≠ 1 ∧ (axis i).bias ≠ -1
    simp
  have hAxis' : axisMinus i ∈ (nonPole d).1 := by
    change (axisMinus i).bias ≠ 1 ∧ (axisMinus i).bias ≠ -1
    simp
  have hcut : cut (nonPole d) (pointMass (axis i) - pointMass (axisMinus i)) =
      pointMass (axis i) - pointMass (axisMinus i) := by
    rw [show cut (nonPole d) (pointMass (axis i) - pointMass (axisMinus i)) =
      cut (nonPole d) (pointMass (axis i)) - cut (nonPole d) (pointMass (axisMinus i))
      from map_sub (cut (nonPole d)).toLinearMap _ _, cut_pointMass, cut_pointMass,
      ite_eq_left hAxis, ite_eq_left hAxis']
  let Q : MeasSet (BarronSphere d) := ⟨{polePlus d}, measurableSet_singleton _⟩
  have hQ : eval Q (pointMass (axis i) - pointMass (axisMinus i)) = 0 := by
    rw [show eval Q (pointMass (axis i) - pointMass (axisMinus i)) =
      eval Q (pointMass (axis i)) - eval Q (pointMass (axisMinus i))
      from map_sub (eval Q).toLinearMap _ _, eval_pointMass, eval_pointMass]
    simp only [Q, mem_singleton_iff, ite_eq_right (axis_ne_polePlus i),
      ite_eq_right (axisMinus_ne_polePlus i), sub_zero]
  rw [affineCoefficients_apply, hcut, hQ]
  apply Prod.ext
  · funext j
    change (1 / 2 : ℝ) * signedIntegral (weightSymbol j) (pointMass (axis i) - pointMass (axisMinus i)) = _
    rw [show signedIntegral (weightSymbol j) (pointMass (axis i) - pointMass (axisMinus i)) =
      signedIntegral (weightSymbol j) (pointMass (axis i)) - signedIntegral (weightSymbol j) (pointMass (axisMinus i))
      from map_sub (signedIntegral (weightSymbol j)).toLinearMap _ _, signedIntegral_pointMass, signedIntegral_pointMass]
    change (1 / 2 : ℝ) * ((axis i).weight j - (reflection d (axis i)).weight j) =
      (Pi.single i (1 : ℝ) : Fin d → ℝ) j
    rw [weight_reflection, weight_axis]
    by_cases h : j = i <;> simp [h, Pi.single_eq_of_ne]
    norm_num
  · simp only [add_zero]
    rw [show signedIntegral (biasSymbol d) (pointMass (axis i) - pointMass (axisMinus i)) =
      signedIntegral (biasSymbol d) (pointMass (axis i)) - signedIntegral (biasSymbol d) (pointMass (axisMinus i))
      from map_sub (signedIntegral (biasSymbol d)).toLinearMap _ _, signedIntegral_pointMass, signedIntegral_pointMass]
    change (1 / 2 : ℝ) * ((axis i).bias - (axisMinus i).bias) = 0
    simp

private theorem affineCoefficients_polePlus :
    affineCoefficients d (pointMass (polePlus d)) = (0, 1) := by
  have hn : polePlus d ∉ (nonPole d).1 := fun h => h.1 rfl
  have hz := cut_pointMass (nonPole d) (polePlus d)
  rw [ite_eq_right hn] at hz
  rw [affineCoefficients_apply, hz, eval_pointMass]
  simp [Pi.zero_def]

theorem affineCoefficients_affineAtoms (a : (Fin d → ℝ) × ℝ) :
    affineCoefficients d (affineAtoms d a) = a := by
  rw [affineAtoms_apply, map_add, map_sum, map_smul, affineCoefficients_polePlus]
  simp_rw [map_smul, affineCoefficients_axis_difference]
  apply Prod.ext
  · funext j
    rw [Prod.fst_add, Prod.fst_sum]
    have hz : (a.2 • ((0 : Fin d → ℝ), (1 : ℝ))).1 = 0 := smul_zero _
    rw [hz, add_zero, Finset.sum_apply]
    change (∑ i : Fin d, a.1 i * (Pi.single i (1 : ℝ) : Fin d → ℝ) j) = a.1 j
    rw [Finset.sum_eq_single j]
    · simp
    · intro i _ hi
      simp [Pi.single_eq_of_ne (Ne.symm hi)]
    · simp
  · simp [Prod.snd_sum]

theorem canonicalProjection_idempotent (μ : FiniteSignedMeasure (BarronSphere d)) :
    canonicalProjection d (canonicalProjection d μ) = canonicalProjection d μ := by
  change reflectedEven d (reflectedEven d μ + affineAtoms d (affineCoefficients d μ)) +
    affineAtoms d (affineCoefficients d (reflectedEven d μ + affineAtoms d (affineCoefficients d μ))) =
      reflectedEven d μ + affineAtoms d (affineCoefficients d μ)
  rw [map_add, reflectedEven_idempotent, reflectedEven_affineAtoms, add_zero, map_add,
    affineCoefficients_reflectedEven, affineCoefficients_affineAtoms, zero_add]

