namespace Paper

noncomputable section SectionSevenBochnerConstants

open MeasureTheory Set Filter
open scoped ENNReal Topology

variable {Y : Type} [NormedAddCommGroup Y] [NormedSpace ℝ Y] [CompleteSpace Y]
abbrev IntervalBochnerTwo (Y : Type) [NormedAddCommGroup Y] := VectorBochnerTwo Y lebesgueUnitInterval

omit [NormedSpace ℝ Y] [CompleteSpace Y] in
private theorem intervalBochnerTwo_integrable (x : IntervalBochnerTwo Y) :
    Integrable x lebesgueUnitInterval :=
  memLp_one_iff_integrable.mp ((Lp.memLp x).mono_exponent (by norm_num))

def intervalBochnerTwoIntegral : IntervalBochnerTwo Y →L[ℝ] Y := by
  let L : IntervalBochnerTwo Y →ₗ[ℝ] Y :=
    { toFun := fun x => ∫ t, x t ∂lebesgueUnitInterval
      map_add' := fun x y => by
        change (∫ t, (x + y) t ∂lebesgueUnitInterval) =
          (∫ t, x t ∂lebesgueUnitInterval) + ∫ t, y t ∂lebesgueUnitInterval
        rw [← integral_add (intervalBochnerTwo_integrable x) (intervalBochnerTwo_integrable y)]
        exact integral_congr_ae (Lp.coeFn_add x y)
      map_smul' := fun c x => by
        change (∫ t, (c • x) t ∂lebesgueUnitInterval) = c • ∫ t, x t ∂lebesgueUnitInterval
        rw [← integral_smul]
        exact integral_congr_ae (Lp.coeFn_smul c x) }
  refine L.mkContinuous 1 (fun x => ?_)
  change ‖∫ t, x t ∂lebesgueUnitInterval‖ ≤ 1 * ‖x‖
  rw [one_mul]
  refine (norm_integral_le_integral_norm _).trans ?_
  rw [Lp.norm_def]
  have h := intervalBochnerTwo_integrable x
  have hle := eLpNorm_le_eLpNorm_of_exponent_le (μ := lebesgueUnitInterval)
    (f := (⇑x)) (show (1:ℝ≥0∞) ≤ 2 by norm_num)
  have hnorm : (eLpNorm (⇑x) 1 lebesgueUnitInterval).toReal = ∫ t, ‖x t‖ ∂lebesgueUnitInterval := by
    rw [eLpNorm_one_eq_lintegral_eNorm h.aestronglyMeasurable,
      ← ofReal_integral_norm_eq_lintegral_eNorm h,
      ENNReal.toReal_ofReal (integral_nonneg fun _ => norm_nonneg _)]
  rw [← hnorm]
  exact ENNReal.toReal_mono (Lp.memLp x).eLpNorm_ne_top hle

def intervalBochnerTwoConstant : Y →L[ℝ] IntervalBochnerTwo Y := by
  let c (y : Y) : IntervalBochnerTwo Y :=
    indicatorConstLp 2 MeasurableSet.univ (measure_ne_top lebesgueUnitInterval univ) y
  have hc (y : Y) : (fun t => c y t) =ᵐ[lebesgueUnitInterval] fun _ => y := by
    have h : (fun t => c y t) =ᵐ[lebesgueUnitInterval] univ.indicator (fun _ => y) :=
      indicatorConstLp_coeFn
    simpa only [indicator_univ] using h
  let L : Y →ₗ[ℝ] IntervalBochnerTwo Y :=
    { toFun := c
      map_add' := fun x y => by
        apply Lp.ext
        filter_upwards [hc (x+y),hc x,hc y,Lp.coeFn_add (c x) (c y)] with t ha hx hy hsum
        rw [ha,hsum,Pi.add_apply,hx,hy]
      map_smul' := fun r y => by
        apply Lp.ext
        change (fun t => c (r • y) t) =ᵐ[lebesgueUnitInterval] fun t => (r • c y) t
        filter_upwards [hc (r • y),hc y,Lp.coeFn_smul r (c y)] with t h₁ h₂ h₃
        rw [h₁,h₃,Pi.smul_apply,h₂] }
  refine L.mkContinuous 1 (fun y => ?_)
  change ‖c y‖ ≤ 1 * ‖y‖
  rw [one_mul]
  unfold c
  rw [norm_indicatorConstLp (by norm_num) (by norm_num)]
  simp [Measure.real]

theorem intervalBochnerTwo_complemented :
    IsComplementedIn Y (IntervalBochnerTwo Y) := by
  refine ⟨intervalBochnerTwoConstant,intervalBochnerTwoIntegral,?_⟩
  ext y
  change (∫ t, intervalBochnerTwoConstant y t ∂lebesgueUnitInterval) = y
  have hh : (fun t => intervalBochnerTwoConstant y t) =ᵐ[lebesgueUnitInterval] fun _ => y := by
    have h : (fun t => intervalBochnerTwoConstant y t) =ᵐ[lebesgueUnitInterval] univ.indicator (fun _ => y) :=
      indicatorConstLp_coeFn (hs := MeasurableSet.univ)
        (hμs := measure_ne_top lebesgueUnitInterval univ)
    simpa only [indicator_univ] using h
  rw [integral_congr_ae hh,integral_const,probReal_univ,one_smul]

#print axioms intervalBochnerTwo_complemented

