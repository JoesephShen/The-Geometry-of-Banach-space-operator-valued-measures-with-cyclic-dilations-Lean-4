theorem PVM.boundedlyComplete_restrict (P : PVM Ω X) (Y : Submodule ℝ X)
    (hY : IsClosed (Y : Set X)) (hi : P.Invariant Y) (hP : P.BoundedlyComplete) :
    (P.restrict Y hi).BoundedlyComplete := by
  intro A z hA hz hb
  have hz' (n : ℕ) : P.val (A n) (z n : X) = (z n : X) :=
    congrArg Subtype.val (hz n)
  obtain ⟨C, hC⟩ := hb
  have hb' : ∃ C : ℝ, ∀ N : ℕ, ‖∑ n ∈ Finset.range N, (z n : X)‖ ≤ C := by
    refine ⟨C, fun N => ?_⟩
    rw [← Submodule.coe_sum]
    exact hC N
  obtain ⟨x, hx⟩ := hP A (fun n => (z n : X)) hA hz' hb'
  have hm : x ∈ Y := hY.mem_of_tendsto hx (Eventually.of_forall fun N =>
    Submodule.sum_mem Y (fun n _ => (z n).2))
  refine ⟨⟨x, hm⟩, tendsto_subtype_rng.mpr ?_⟩
  simpa only [Submodule.coe_sum] using hx

/-- The usual coordinate truncations converge in the norm of the manuscript's
copy of `c₀`. -/
private theorem cZero_range_sums_tendsto (a : CZero) :
    Tendsto (fun N => ∑ n ∈ Finset.range N, a n • cZeroIndicator {n}) atTop (𝓝 a) := by
  classical
  rw [Metric.tendsto_atTop]
  intro ε hε
  have ha : Tendsto (fun n => |a n|) atTop (𝓝 0) := by
    simpa only [abs_zero, Function.comp_def] using (continuous_abs.tendsto (0 : ℝ)).comp (cZero_tendsto a)
  obtain ⟨k, hk⟩ := eventually_atTop.mp ((tendsto_order.mp ha).2 (ε / 2) (by positivity))
  refine ⟨k, fun N hN => ?_⟩
  rw [dist_eq_norm, norm_sub_rev]
  refine (cZero_norm_le _ (by positivity : 0 ≤ ε / 2) ?_).trans_lt (half_lt_self hε)
  intro j
  have he : (∑ n ∈ Finset.range N, a n • cZeroIndicator {n}) j =
      if j < N then a j else 0 := by
    change (cZeroEval j) (∑ n ∈ Finset.range N, a n • cZeroIndicator {n}) = _
    rw [map_sum]
    have hterm (n : ℕ) : cZeroEval j (a n • cZeroIndicator {n}) = if n = j then a j else 0 := by
      rw [map_smul]
      change a n * (if j ∈ ({n} : Finset ℕ) then (1 : ℝ) else 0) = _
      by_cases h : n = j
      · subst n
        simp
      · simp [h, Ne.symm h]
    simp_rw [hterm]
    simp [Finset.mem_range]
  change |a j - (∑ n ∈ Finset.range N, a n • cZeroIndicator {n}) j| ≤ _
  rw [he]
  by_cases hj : j < N
  · simp [hj, show 0 ≤ ε / 2 by positivity]
  · rw [ite_eq_right hj, sub_zero]
    exact (hk j (hN.trans (le_of_not_gt hj))).le

/-- Manuscript, cor:local-representation-james (2): put the standard basis
of a proposed copy of `c₀` into a single closed invariant subspace. -/
theorem PVM.not_contains_cZero_of_boundedlyComplete_of_countable_cover [CompleteSpace X]
    (P : PVM Ω X)
    (hP : ∀ s : Set X, s.Countable → ∃ (Y : Submodule ℝ X) (_hY : IsClosed (Y : Set X))
      (hi : P.Invariant Y), s ⊆ Y ∧ (P.restrict Y hi).Localizes)
    (hbc : P.BoundedlyComplete) : ¬ ContainsCopy CZero X := by
  rintro ⟨A, c, hc, hbound⟩
  obtain ⟨Y, hY, hi, hcover, hloc⟩ := hP
    (Set.range fun n => A (cZeroIndicator {n})) (Set.countable_range _)
  let _ : CompleteSpace Y := hY.completeSpace_coe
  have hr (a : CZero) : A a ∈ Y := by
    apply hY.mem_of_tendsto ((A.continuous.tendsto a).comp (cZero_range_sums_tendsto a))
    exact Eventually.of_forall fun N => by
      change A (∑ n ∈ Finset.range N, a n • cZeroIndicator {n}) ∈ Y
      rw [map_sum]
      refine Y.sum_mem fun n _ => ?_
      rw [map_smul]
      exact Y.smul_mem _ (hcover (Set.mem_range_self n))
  exact ((P.restrict Y hi).boundedlyComplete_james hloc).1.mp
    (P.boundedlyComplete_restrict Y hY hi hbc) ⟨A.codRestrict Y hr, c, hc, hbound⟩

#print axioms PVM.not_contains_cZero_of_boundedlyComplete_of_countable_cover


/-- Manuscript, cor:local-representation-james (2). -/
theorem PVM.boundedlyComplete_james_of_countable_cover [CompleteSpace X] (P : PVM Ω X)
    (hP : ∀ s : Set X, s.Countable → ∃ (Y : Submodule ℝ X) (_hY : IsClosed (Y : Set X))
      (hi : P.Invariant Y), s ⊆ Y ∧ (P.restrict Y hi).Localizes) :
    (P.BoundedlyComplete ↔ ¬ ContainsCopy CZero X) ∧
    (P.BoundedlyComplete ↔ WeaklySeqComplete X) := by
  have hW : P.BoundedlyComplete → WeaklySeqComplete X := by
    intro h x hx
    obtain ⟨Y, hY, hi, hxY, hl⟩ := hP (Set.range x) (Set.countable_range x)
    let _ : CompleteSpace Y := hY.completeSpace_coe
    let y (n : ℕ) : Y := ⟨x n, hxY (Set.mem_range_self n)⟩
    have hy (f : Dual Y) : CauchySeq (fun n => f (y n)) := by
      obtain ⟨g, hg, _⟩ := exists_extension_norm_eq Y f
      have he : (fun n => g (x n)) = fun n => f (y n) := funext fun n => hg (y n)
      exact he ▸ hx g
    have hr := (P.restrict Y hi).weaklySeqComplete_of_boundedlyComplete hl
      (P.boundedlyComplete_restrict Y hY hi h)
    obtain ⟨z, hz⟩ := hr y hy
    exact ⟨(z : X), fun f => hz (f.comp Y.subtypeL)⟩
  exact ⟨⟨P.not_contains_cZero_of_boundedlyComplete_of_countable_cover hP, P.boundedlyComplete_of_not_contains_cZero⟩,
    ⟨hW, P.boundedlyComplete_of_weaklySeqComplete⟩⟩

#print axioms PVM.boundedlyComplete_james_of_countable_cover


end SequenceGeometry

section SummableSequences

open scoped ENNReal

abbrev LOne := lp (fun _ : ℕ => ℝ) 1
private instance : Fact ((1 : ℝ≥0∞) ≤ 1) := ⟨le_rfl⟩

private theorem lOne_hasSum_abs (u : LOne) : HasSum (fun n => |u n|) ‖u‖ := by
  simpa only [ENNReal.toReal_one, Real.rpow_one, Real.norm_eq_abs] using
    lp.hasSum_norm (p := 1) (by simp) u

private noncomputable def lOneCut (s : Finset ℕ) (u : LOne) : LOne :=
  ∑ i ∈ s, lp.single 1 i (u i)

private theorem lOneCut_apply (s : Finset ℕ) (u : LOne) (n : ℕ) :
    lOneCut s u n = if n ∈ s then u n else 0 := by
  let e := lp.evalCLM ℝ (fun _ : ℕ => ℝ) 1 n
  change e (∑ i ∈ s, lp.single 1 i (u i)) = _
  rw [map_sum]
  change (∑ i ∈ s, lp.single 1 i (u i) n) = _
  simp [lp.single_apply]

private theorem lOneCut_norm (s : Finset ℕ) (u : LOne) :
    ‖lOneCut s u‖ = ∑ n ∈ s, |u n| := by
  simpa only [lOneCut, ENNReal.toReal_one, Real.rpow_one, Real.norm_eq_abs] using
    lp.norm_sum_single (p := 1) (by simp) (fun n => u n) s

private theorem lOneCut_hasSum (u : LOne) :
    Tendsto (fun N => lOneCut (Finset.range N) u) atTop (𝓝 u) :=
  (lp.hasSum_single (by simp : (1 : ℝ≥0∞) ≠ ⊤) u).tendsto_sum_nat

private theorem lOneCut_nearby (u : LOne) (ε : ℝ) (hε : 0 < ε) (K : ℕ) :
    ∃ L ≥ K, ‖u - lOneCut (Finset.range L) u‖ < ε := by
  have ht := ((tendsto_const_nhds (x := u)).sub (lOneCut_hasSum u)).norm
  rw [sub_self, norm_zero] at ht
  obtain ⟨L, hL⟩ := (((tendsto_order.mp ht).2 ε hε).and (eventually_ge_atTop K)).exists
  exact ⟨L, hL.2, hL.1⟩

private theorem lOneHead_tendsto_zero (u : ℕ → LOne) (h : ∀ n, Tendsto (fun k => u k n) atTop (𝓝 0))
    (s : Finset ℕ) : Tendsto (fun k => ‖lOneCut s (u k)‖) atTop (𝓝 0) := by
  classical
  simp only [lOneCut_norm]
  induction s using Finset.induction_on with
  | empty => simpa only [Finset.sum_empty] using tendsto_const_nhds
  | insert n s hn ih =>
    simp only [Finset.sum_insert hn]
    have hn' : Tendsto (fun k => |u k n|) atTop (𝓝 0) := by
      have ht := (continuous_abs.tendsto (0 : ℝ)).comp (h n)
      change Tendsto (fun k => |u k n|) atTop (𝓝 |(0 : ℝ)|) at ht
      rwa [abs_zero] at ht
    simpa only [zero_add] using hn'.add ih

/-- A subsequence of a coordinatewise null family can be approximated
by vectors with successive finite supports. -/
private theorem lOne_glidingHump (u : ℕ → LOne)
    (h : ∀ n, Tendsto (fun k => u k n) atTop (𝓝 0)) (ε : ℝ) (hε : 0 < ε) :
    ∃ k : ℕ → ℕ, StrictMono k ∧
      ∃ B : ℕ → Finset ℕ, (Pairwise fun i j => Disjoint (B i) (B j)) ∧
        ∀ n, ‖u (k n) - lOneCut (B n) (u (k n))‖ < ε := by
  classical
  have hnext (K M : ℕ) : ∃ (k L : ℕ), M ≤ k ∧ K ≤ L ∧
      ‖u k - lOneCut (Finset.range L \ Finset.range K) (u k)‖ < ε := by
    have hr : 0 < ε / 2 := by linarith
    obtain ⟨k, hk⟩ := (((tendsto_order.mp (lOneHead_tendsto_zero u h (Finset.range K))).2
      (ε / 2) hr).and (eventually_ge_atTop M)).exists
    obtain ⟨L, hL, hLt⟩ := lOneCut_nearby (u k) (ε / 2) hr K
    refine ⟨k, L, hk.2, hL, ?_⟩
    have he : lOneCut (Finset.range L \ Finset.range K) (u k) + lOneCut (Finset.range K) (u k) =
        lOneCut (Finset.range L) (u k) :=
      Finset.sum_sdiff (Finset.range_mono hL)
    have h_eq : u k - lOneCut (Finset.range L \ Finset.range K) (u k) =
        (u k - lOneCut (Finset.range L) (u k)) + lOneCut (Finset.range K) (u k) := by
      rw [← he]
      abel
    rw [h_eq]
    exact (norm_add_le _ _).trans_lt (by linarith [hk.1, hLt])
  choose chooseIndex chooseEnd hI hE hB using hnext
  let ends : ℕ → ℕ × ℕ :=
    Nat.rec (0, 0) (fun _ p => (chooseEnd p.1 p.2, chooseIndex p.1 p.2 + 1))
  let k (n : ℕ) := chooseIndex (ends n).1 (ends n).2
  let B (n : ℕ) := Finset.range (ends (n + 1)).1 \ Finset.range (ends n).1
  have hmono : Monotone (fun n => (ends n).1) :=
    monotone_nat_of_le_succ fun n => hE (ends n).1 (ends n).2
  have hk : StrictMono k := strictMono_nat_of_lt_succ fun n =>
    (Nat.lt_succ_self _).trans_le (hI (ends (n + 1)).1 (ends (n + 1)).2)
  refine ⟨k, hk, B, Pairwise.of_lt (fun i j hij => Finset.disjoint_left.mpr fun n hi hj => ?_), ?_⟩
  · have hn := Finset.mem_range.mp (Finset.mem_sdiff.mp hi).1
    exact (Finset.mem_sdiff.mp hj).2
      (Finset.mem_range.mpr (hn.trans_le (hmono (Nat.succ_le_of_lt hij))))
  · exact fun n => hB (ends n).1 (ends n).2

/-- Evaluation against any uniformly bounded real coefficient sequence. -/
private noncomputable def lOneBoundedEval (q : ℕ → ℝ) (hq : ∀ n, |q n| ≤ 1) : Dual LOne := by
  have hs (u : LOne) : Summable (fun n => q n * u n) := by
    apply (lOne_hasSum_abs u).summable.of_norm_bounded
    intro n
    rw [Real.norm_eq_abs, abs_mul]
    exact mul_le_of_le_one_left (abs_nonneg _) (hq n)
  refine LinearMap.mkContinuous
    { toFun := fun u => ∑' n, q n * u n
      map_add' := fun u v => ?_
      map_smul' := fun c u => ?_ } 1 (fun u => ?_)
  · have he : (fun n => q n * u n + q n * v n) = (fun n => q n * (u + v) n) := by
      funext n
      exact (mul_add _ _ _).symm
    have h := (hs u).hasSum.add (hs v).hasSum
    rw [he] at h
    exact h.tsum_eq
  · have he : (fun n => c • (q n * u n)) = (fun n => q n * (c • u) n) := by
      funext n
      change c * (q n * u n) = q n * (c * u n)
      ring
    have h := (hs u).hasSum.const_smul c
    rw [he] at h
    exact h.tsum_eq
  · change ‖∑' n, q n * u n‖ ≤ 1 * ‖u‖
    rw [one_mul, ← (lOne_hasSum_abs u).tsum_eq]
    refine norm_tsum_le_tsum_norm (by
      apply (lOne_hasSum_abs u).summable.of_nonneg_of_le (fun _ => norm_nonneg _)
      intro n
      rw [Real.norm_eq_abs, abs_mul]
      exact mul_le_of_le_one_left (abs_nonneg _) (hq n)) |>.trans ?_
    apply Summable.tsum_le_tsum
    · intro n
      rw [Real.norm_eq_abs, abs_mul]
      exact mul_le_of_le_one_left (abs_nonneg _) (hq n)
    · apply (lOne_hasSum_abs u).summable.of_nonneg_of_le (fun _ => norm_nonneg _)
      intro n
      rw [Real.norm_eq_abs, abs_mul]
      exact mul_le_of_le_one_left (abs_nonneg _) (hq n)
    · exact (lOne_hasSum_abs u).summable

private theorem norm_lOneBoundedEval_le (q : ℕ → ℝ) (hq : ∀ n, |q n| ≤ 1) :
    ‖lOneBoundedEval q hq‖ ≤ 1 := by
  unfold lOneBoundedEval
  apply LinearMap.mkContinuous_norm_le _ zero_le_one

private theorem lOneBoundedEval_cut (q : ℕ → ℝ) (hq : ∀ n, |q n| ≤ 1)
    (s : Finset ℕ) (u : LOne) :
    lOneBoundedEval q hq (lOneCut s u) = ∑ n ∈ s, q n * u n := by
  change (∑' n, q n * lOneCut s u n) = _
  rw [tsum_eq_sum (s := s) (fun n hn => by rw [lOneCut_apply, ite_eq_right hn, mul_zero])]
  exact Finset.sum_congr rfl (fun n hn => by rw [lOneCut_apply, ite_eq_left hn])

private noncomputable def lOneSign (x : ℝ) : ℝ := if 0 ≤ x then 1 else -1

private theorem abs_lOneSign (x : ℝ) : |lOneSign x| ≤ 1 := by
  by_cases hx : 0 ≤ x <;> simp [lOneSign, hx]

private theorem lOneSign_mul (x : ℝ) : lOneSign x * x = |x| := by
  by_cases hx : 0 ≤ x
  · simp [lOneSign, hx, abs_of_nonneg hx]
  · simp [lOneSign, hx, abs_of_neg (lt_of_not_ge hx)]

/-- The Schur property in the sequential form used for the James theorem. -/
theorem lOne_tendsto_zero_of_weaklyNull (u : ℕ → LOne)
    (h : ∀ f : Dual LOne, Tendsto (fun n => f (u n)) atTop (𝓝 0)) :
    Tendsto u atTop (𝓝 0) := by
  classical
  by_contra hn
  rw [Metric.tendsto_atTop] at hn
  push Not at hn
  obtain ⟨δ, hδ, hn⟩ := hn
  choose k hk hlarge using hn
  let idx : ℕ → ℕ := Nat.rec (k 0) (fun _ i => k (i + 1))
  have hi : StrictMono idx := strictMono_nat_of_lt_succ fun n =>
    (Nat.lt_succ_self _).trans_le (hk (idx n + 1))
  have hlow (i : ℕ) : δ ≤ ‖u (idx i)‖ := by
    cases i with
    | zero =>
      change δ ≤ ‖u (k 0)‖
      simpa only [dist_zero_right] using hlarge 0
    | succ i =>
      change δ ≤ ‖u (k (idx i + 1))‖
      simpa only [dist_zero_right] using hlarge (idx i + 1)
  let v (n : ℕ) := u (idx n)
  have hcoord (n : ℕ) : Tendsto (fun k => v k n) atTop (𝓝 0) :=
    (h (lp.evalCLM ℝ (fun _ : ℕ => ℝ) 1 n)).comp hi.tendsto_atTop
  obtain ⟨l, hl, B, hB, hBl⟩ := lOne_glidingHump v hcoord (δ / 4) (by linarith)
  let q (n : ℕ) := if hn : ∃ k, n ∈ B k then lOneSign (v (l (Classical.choose hn)) n) else 0
  have hq (n : ℕ) : |q n| ≤ 1 := by
    by_cases hn : ∃ k, n ∈ B k
    · simp only [q, dite_eq_left hn]
      exact abs_lOneSign _
    · simp [q, hn]
  let f := lOneBoundedEval q hq
  have hnorm : ‖f‖ ≤ 1 := norm_lOneBoundedEval_le q hq
  have hf (k : ℕ) : δ / 2 ≤ f (v (l k)) := by
    let b := lOneCut (B k) (v (l k))
    have hb : f b = ‖b‖ := by
      rw [lOneBoundedEval_cut, lOneCut_norm]
      apply Finset.sum_congr rfl
      intro n hn
      have he : ∃ i, n ∈ B i := ⟨k, hn⟩
      have hh : Classical.choose he = k := by
        by_contra hne
        exact (Finset.disjoint_left.mp (hB hne)) (Classical.choose_spec he) hn
      simp only [q, dite_eq_left he, hh, lOneSign_mul]
    have hu := norm_le_insert' (v (l k)) b
    have herr : |f (v (l k)) - f b| ≤ ‖v (l k) - b‖ := by
      rw [← map_sub, ← Real.norm_eq_abs]
      refine (f.le_opNorm _).trans ?_
      simpa only [one_mul] using mul_le_mul_of_nonneg_right hnorm (norm_nonneg (v (l k) - b))
    linarith [hBl k, hlow (l k), le_abs_self (f b - f (v (l k))),
      neg_le_abs (f (v (l k)) - f b)]
  have ht := (h f).comp (hi.tendsto_atTop.comp hl.tendsto_atTop)
  have hbad : δ / 2 ≤ (0 : ℝ) := ge_of_tendsto ht (Eventually.of_forall hf)
  linarith

set_option maxHeartbeats 1000000 in
theorem weaklySeqComplete_lOne : WeaklySeqComplete LOne := by
  intro u hu
  have hc : CauchySeq u := by
    by_contra hn
    rw [Metric.cauchySeq_iff] at hn
    push Not at hn
    obtain ⟨ε, hε, hn⟩ := hn
    choose i hi j hj hd using hn
    let v (n : ℕ) := u (i n) - u (j n)
    have hweak (f : Dual LOne) : Tendsto (fun n => f (v n)) atTop (𝓝 0) := by
      obtain ⟨a, ha⟩ := cauchySeq_tendsto_of_complete (hu f)
      have hi' : Tendsto i atTop atTop := tendsto_atTop.mpr fun n =>
        (eventually_ge_atTop n).mono fun k hnk => hnk.trans (hi k)
      have hj' : Tendsto j atTop atTop := tendsto_atTop.mpr fun n =>
        (eventually_ge_atTop n).mono fun k hnk => hnk.trans (hj k)
      simpa only [v, map_sub, Function.comp_apply, sub_self] using
        (ha.comp hi').sub (ha.comp hj')
    have hnorm := (lOne_tendsto_zero_of_weaklyNull v hweak).norm
    rw [norm_zero] at hnorm
    have hbad : ε ≤ (0 : ℝ) := ge_of_tendsto hnorm (Eventually.of_forall fun n => by
      change ε ≤ ‖u (i n) - u (j n)‖
      simpa only [dist_eq_norm] using hd n)
    linarith
  obtain ⟨x, hx⟩ := cauchySeq_tendsto_of_complete hc
  exact ⟨x, fun f => (f.continuous.tendsto x).comp hx⟩

private noncomputable def lOneUnit (n : ℕ) : LOne := lp.single 1 n 1

private theorem norm_lOneUnit (n : ℕ) : ‖lOneUnit n‖ = 1 := by
  simpa only [lOneUnit, norm_one] using lp.norm_single
    (E := fun _ : ℕ => ℝ) (p := 1) (by simp) n (1 : ℝ)

theorem not_reflexive_lOne : ¬ IsReflexive LOne := by
  classical
  intro h
  let p (n : ℕ) : Dual LOne := lp.evalCLM ℝ (fun _ : ℕ => ℝ) 1 n
  let S := Submodule.span ℝ (Set.range p)
  let Y := S.topologicalClosure
  let hY : IsClosed (Y : Set (Dual LOne)) := S.isClosed_topologicalClosure
  let f := lOneBoundedEval (fun _ => 1) (fun _ => by norm_num)
  have hf (n : ℕ) : f (lOneUnit n) = 1 := by
    change (∑' i, 1 * lOneUnit n i) = _
    simp only [one_mul]
    rw [tsum_eq_single n (fun i hi => by simp [lOneUnit, lp.single_apply, hi])]
    simp [lOneUnit, lp.single_apply]
  have hs (g : Dual LOne) (hg : g ∈ S) : ∃ N : ℕ, ∀ n ≥ N, g (lOneUnit n) = 0 := by
    induction hg using Submodule.span_induction with
    | mem g hg =>
      obtain ⟨i, rfl⟩ := hg
      refine ⟨i + 1, fun n hn => ?_⟩
      change lOneUnit n i = 0
      have hne : i ≠ n := ne_of_lt (Nat.lt_of_succ_le hn)
      simp [lOneUnit, lp.single_apply, Pi.single_eq_of_ne hne]
    | zero => exact ⟨0, fun _ _ => rfl⟩
    | add g k _ _ hg hk =>
      obtain ⟨N, hN⟩ := hg
      obtain ⟨M, hM⟩ := hk
      exact ⟨max N M, fun n hn => by simp [hN n (le_trans (le_max_left _ _) hn),
        hM n (le_trans (le_max_right _ _) hn)]⟩
    | smul r g _ hg =>
      obtain ⟨N, hN⟩ := hg
      exact ⟨N, fun n hn => by simp [hN n hn]⟩
  have hfm : f ∉ Y := by
    intro hh
    obtain ⟨g, hg, hd⟩ := Metric.mem_closure_iff.mp hh (1 / 2) (by norm_num)
    obtain ⟨N, hN⟩ := hs g hg
    have hb := (f - g).le_opNorm (lOneUnit N)
    rw [sub_apply, hf N, hN _ le_rfl, sub_zero, norm_one,
      norm_lOneUnit, mul_one] at hb
    rw [dist_eq_norm] at hd
    linarith
  have hnorm : ‖Y.mkQL f‖ ≠ 0 := by
    intro hn
    have hm : f ∈ closure (Y : Set (Dual LOne)) :=
      (QuotientAddGroup.norm_mk_eq_zero_iff_mem_closure (S := Y.toAddSubgroup)).mp hn
    rw [hY.closure_eq] at hm
    exact hfm hm
  obtain ⟨b, _, hb⟩ := exists_dual_vector ℝ (Y.mkQL f) hnorm
  let ξ : Bidual LOne := b.comp Y.mkQL
  have hξ (n : ℕ) : ξ (p n) = 0 := by
    have hp : Y.mkQL (p n) = 0 := (Submodule.Quotient.mk_eq_zero Y).mpr
      (subset_closure (Submodule.subset_span (Set.mem_range_self n)))
    change b (Y.mkQL (p n)) = 0
    rw [hp, map_zero]
  obtain ⟨u, hu⟩ := h ξ
  have he (n : ℕ) : u n = 0 := by
    change J u (p n) = 0
    rw [hu, hξ]
  have hu0 : u = 0 := by
    ext i
    exact he i
  have hξf : ξ f = 0 := by rw [← hu, hu0, J_apply, map_zero]
  change b (Y.mkQL f) = 0 at hξf
  change b (Y.mkQL f) = ‖Y.mkQL f‖ at hb
  exact hnorm (hb.symm.trans hξf)

variable {X Z Ω : Type*} [MeasurableSpace Ω] [NormedAddCommGroup X] [NormedSpace ℝ X]
  [NormedAddCommGroup Z] [NormedSpace ℝ Z]

/-- The obstruction to the normal part being the entire bidual. -/
theorem not_contains_lOne_of_baireOne_all (hX : ∀ ξ : Bidual X, BaireOne ξ) :
    ¬ ContainsCopy LOne X := by
  intro h
  obtain ⟨Y, hY, ⟨B⟩⟩ := h.closed_range
  have hall (ξ : Bidual LOne) : BaireOne ξ := by
    have hb := (baireOne_subspace_iff Y hY (secondAdjoint B.toContinuousLinearMap ξ)).mp (hX _)
    have hr := hb.second_adjoint B.symm.toContinuousLinearMap
    have he : secondAdjoint B.symm.toContinuousLinearMap (secondAdjoint B.toContinuousLinearMap ξ) =
        ξ := by
      ext f
      rw [secondAdjoint_apply, secondAdjoint_apply]
      congr 1
      ext x
      change f (B.symm (B x)) = f x
      rw [B.symm_apply_apply]
    exact he ▸ hr
  apply not_reflexive_lOne
  intro ξ
  have hm := (weaklySeqComplete_iff_baireOne.mp weaklySeqComplete_lOne)
  change ξ ∈ Set.range (J : LOne → Bidual LOne)
  rw [← hm]
  exact hall ξ

/-- Manuscript, thm:representation-james (1), the implication from
shrinking to exclusion of an isomorphic copy of ℓ₁. -/
theorem PVM.not_contains_lOne_of_shrinking (P : PVM Ω X) (hP : P.Localizes)
    (hs : P.toOVM.Shrinking) : ¬ ContainsCopy LOne X :=
  not_contains_lOne_of_baireOne_all fun ξ =>
    (P.normal_iff_baireOne hP ξ).mp (P.toOVM.normal_of_shrinking hs ξ)

/-- Manuscript, prop:ovm-normal (1), the implication from shrinking
to exclusion of ℓ₁. -/
theorem Dilation.not_contains_lOne_of_shrinking [CompleteSpace X] [CompleteSpace Z]
    {μ : OVM Ω X} (D : Dilation μ Z) (hP : D.P.Localizes)
    (hs : μ.Shrinking) : ¬ ContainsCopy LOne X :=
  not_contains_lOne_of_baireOne_all fun ξ => (D.normal_iff_baireOne hP ξ).mp (μ.normal_of_shrinking hs ξ)

