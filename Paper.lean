section SequenceGeometry

open scoped ZeroAtInfty NNReal

variable {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- An isomorphic copy, witnessed by a bounded linear map bounded below.
Completeness of the model space makes its range closed. -/
def ContainsCopy (E X : Type*) [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup X] [NormedSpace ℝ X] : Prop :=
  ∃ (A : E →L[ℝ] X) (c : ℝ), 0 < c ∧ ∀ x, c * ‖x‖ ≤ ‖A x‖

abbrev CZero := C₀(ℕ, ℝ)

private theorem cZero_apply_bound (a : CZero) (n : ℕ) : |a n| ≤ ‖a‖ :=
  BoundedContinuousFunction.norm_coe_le_norm a.toBCF n

private theorem cZero_norm_le (a : CZero) {C : ℝ} (hC : 0 ≤ C)
    (h : ∀ n, |a n| ≤ C) : ‖a‖ ≤ C :=
  (BoundedContinuousFunction.norm_le (f := a.toBCF) hC).mpr h

private theorem cZero_tendsto (a : CZero) : Tendsto a atTop (𝓝 (0 : ℝ)) := by
  have ht := a.zero_at_infty'
  rw [cocompact_eq_atTop] at ht
  exact ht

/-- Uniform boundedness of all finite absolute scalar sums. -/
private theorem abs_dual_sum_uniform (u : ℕ → X)
    (hu : ∀ f : Dual X, Summable (fun n => |f (u n)|)) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ (s : Finset ℕ) (f : Dual X),
      (∑ n ∈ s, |f (u n)|) ≤ C * ‖f‖ := by
  classical
  obtain ⟨K, hK⟩ := banach_steinhaus
    (g := fun s : Finset ℕ => J (∑ n ∈ s, u n)) (fun f => by
      refine ⟨∑' n, |f (u n)|, fun s => ?_⟩
      rw [J_apply, map_sum, Real.norm_eq_abs]
      exact (Finset.abs_sum_le_sum_abs _ _).trans
        ((hu f).sum_le_tsum s (fun _ _ => abs_nonneg _)))
  refine ⟨2 * K, mul_nonneg (by norm_num) ((norm_nonneg _).trans (hK ∅)), fun s f => ?_⟩
  rw [mul_assoc]
  apply real_abs_finite_subsum_le
  intro t
  rw [← map_sum, ← Real.norm_eq_abs, ← J_apply]
  exact ((J _).le_opNorm f).trans (mul_le_mul_of_nonneg_right (hK t) (norm_nonneg f))

private theorem norm_weighted_sum_le (u : ℕ → X) {C : ℝ}
    (hC : 0 ≤ C) (hu : ∀ (s : Finset ℕ) (f : Dual X),
      (∑ n ∈ s, |f (u n)|) ≤ C * ‖f‖)
    (s : Finset ℕ) (a : ℕ → ℝ) {r : ℝ} (hr : 0 ≤ r)
    (ha : ∀ n ∈ s, |a n| ≤ r) : ‖∑ n ∈ s, a n • u n‖ ≤ C * r := by
  let z := ∑ n ∈ s, a n • u n
  by_cases hz : ‖z‖ = 0
  · simpa only [z, hz] using mul_nonneg hC hr
  obtain ⟨f, hf, hfz⟩ := exists_dual_vector ℝ z hz
  change f z = ‖z‖ at hfz
  change ‖z‖ ≤ C * r
  rw [← hfz]
  calc
    f z ≤ |f z| := le_abs_self _
    _ = |∑ n ∈ s, a n * f (u n)| := by simp [z, map_smul]
    _ ≤ ∑ n ∈ s, |a n * f (u n)| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ n ∈ s, r * |f (u n)| := by
      apply Finset.sum_le_sum
      intro n hn
      rw [abs_mul]
      exact mul_le_mul_of_nonneg_right (ha n hn) (abs_nonneg _)
    _ ≤ C * r := by
      rw [← Finset.mul_sum, mul_comm C r]
      apply mul_le_mul_of_nonneg_left _ hr
      simpa only [hf, mul_one] using hu s f

private theorem cZeroWeightedSummable [CompleteSpace X] (u : ℕ → X) (C : ℝ)
    (hC : 0 ≤ C) (hu : ∀ (s : Finset ℕ) (f : Dual X),
      (∑ n ∈ s, |f (u n)|) ≤ C * ‖f‖) (a : CZero) :
    Summable (fun n => a n • u n) := by
  apply summable_iff_vanishing_norm.mpr
  intro ε hε
  let r := ε / (C + 1)
  have hr : 0 < r := div_pos hε (by linarith)
  have ht := (cZero_tendsto a).norm
  rw [norm_zero] at ht
  obtain ⟨N, hN⟩ := eventually_atTop.mp ((tendsto_order.mp ht).2 r hr)
  refine ⟨Finset.range N, fun s hs => ?_⟩
  have hb := norm_weighted_sum_le u hC hu s a hr.le (fun n hn => by
    have hn' : N ≤ n := le_of_not_gt (fun h => Finset.disjoint_left.mp hs hn (Finset.mem_range.mpr h))
    exact (hN n hn').le)
  refine hb.trans_lt ?_
  dsimp [r]
  rw [← mul_div_assoc, div_lt_iff₀ (by linarith : 0 < C + 1)]
  nlinarith

/-- The coefficient map \(a\mapsto\sum_n a_n u_n\) on \(c_0\). -/
private noncomputable def cZeroSynthesis [CompleteSpace X] (u : ℕ → X) (C : ℝ)
    (hC : 0 ≤ C) (hu : ∀ (s : Finset ℕ) (f : Dual X),
      (∑ n ∈ s, |f (u n)|) ≤ C * ‖f‖) : CZero →L[ℝ] X := by
  let hs := cZeroWeightedSummable u C hC hu
  refine LinearMap.mkContinuous
    { toFun := fun a => ∑' n, a n • u n
      map_add' := fun a b => ?_
      map_smul' := fun r a => ?_ } C (fun a => ?_)
  · have ht := (hs a).hasSum.add (hs b).hasSum
    have he : (fun n => a n • u n + b n • u n) = fun n => (a + b) n • u n :=
      funext fun n => (add_smul (a n) (b n) (u n)).symm
    rw [he] at ht
    exact ht.tsum_eq
  · have ht := (hs a).hasSum.const_smul r
    have he : (fun n => r • (a n • u n)) = fun n => (r • a) n • u n :=
      funext fun n => (mul_smul r (a n) (u n)).symm
    rw [he] at ht
    exact ht.tsum_eq
  · exact le_of_tendsto (hs a).hasSum.norm (Eventually.of_forall fun s =>
      norm_weighted_sum_le u hC hu s a (norm_nonneg _) (fun n _ => cZero_apply_bound a n))

private theorem cZeroSynthesis_hasSum [CompleteSpace X] (u : ℕ → X) (C : ℝ)
    (hC : 0 ≤ C) (hu : ∀ (s : Finset ℕ) (f : Dual X),
      (∑ n ∈ s, |f (u n)|) ≤ C * ‖f‖) (a : CZero) :
    HasSum (fun n => a n • u n) (cZeroSynthesis u C hC hu a) := by
  change HasSum _ (∑' n, a n • u n)
  exact (cZeroWeightedSummable u C hC hu a).hasSum

/-- A triangular family of norming functionals with small upper tails
gives a bounded-below map from the usual space of null sequences. -/
private theorem contains_cZero_of_triangular [CompleteSpace X] (u : ℕ → X)
    (hu : ∀ f : Dual X, Summable (fun n => |f (u n)|))
    (f : ℕ → Dual X) {δ : ℝ} (hδ : 0 < δ) (hf : ∀ n, ‖f n‖ ≤ 1)
    (hdiag : ∀ n, δ ≤ f n (u n))
    (hlower : ∀ i j, j < i → f i (u j) = 0)
    (htail : ∀ i (s : Finset ℕ), (∀ j ∈ s, i < j) →
      (∑ j ∈ s, |f i (u j)|) ≤ δ / 2) : ContainsCopy CZero X := by
  classical
  obtain ⟨C, hC, hCsum⟩ := abs_dual_sum_uniform u hu
  let A := cZeroSynthesis u C hC hCsum
  refine ⟨A, δ / 2, by linarith, fun a => ?_⟩
  have hcoord (i : ℕ) : |a i| * δ ≤ ‖A a‖ + ‖a‖ * (δ / 2) := by
    have hsum := (f i).hasSum (cZeroSynthesis_hasSum u C hC hCsum a)
    have ht := hsum.tendsto_sum_nat
    have hb : ∀ᶠ N in atTop, |a i| * δ ≤
        |∑ j ∈ Finset.range N, f i (a j • u j)| + ‖a‖ * (δ / 2) := by
      filter_upwards [eventually_ge_atTop (i + 1)] with N hN
      let s := (Finset.range N).filter (i < ·)
      have hi : i ∈ Finset.range N := Finset.mem_range.mpr (lt_of_lt_of_le (Nat.lt_succ_self i) hN)
      have he : (∑ j ∈ Finset.range N, f i (a j • u j)) =
          a i * f i (u i) + ∑ j ∈ s, a j * f i (u j) := by
        simp only [map_smul, smul_eq_mul]
        have hsub : s ⊆ (Finset.range N).erase i := by
          intro j hj
          obtain ⟨hjN, hjlt⟩ := Finset.mem_filter.mp hj
          exact Finset.mem_erase.mpr ⟨ne_of_gt hjlt, hjN⟩
        have hss : (∑ j ∈ s, a j * f i (u j)) =
            ∑ j ∈ (Finset.range N).erase i, a j * f i (u j) := by
          apply Finset.sum_subset hsub
          intro j hj hjs
          obtain ⟨hne, hjN⟩ := Finset.mem_erase.mp hj
          have hlt : j < i := by
            by_contra! hle
            exact hjs (Finset.mem_filter.mpr ⟨hjN, lt_of_le_of_ne hle (Ne.symm hne)⟩)
          rw [hlower i j hlt, mul_zero]
        rw [hss, add_comm, Finset.sum_erase_add _ _ hi]
      have habs : |∑ j ∈ s, a j * f i (u j)| ≤ ‖a‖ * (δ / 2) := by
        refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
        simp_rw [abs_mul]
        calc
          _ ≤ ∑ j ∈ s, ‖a‖ * |f i (u j)| :=
            Finset.sum_le_sum fun j _ => mul_le_mul_of_nonneg_right (cZero_apply_bound a j) (abs_nonneg _)
          _ ≤ _ := by
            rw [← Finset.mul_sum]
            exact mul_le_mul_of_nonneg_left (htail i s fun j hj => (Finset.mem_filter.mp hj).2) (norm_nonneg _)
      have hmain : |a i| * δ ≤ |a i * f i (u i)| := by
        rw [abs_mul, abs_of_nonneg (hδ.le.trans (hdiag i))]
        exact mul_le_mul_of_nonneg_left (hdiag i) (abs_nonneg _)
      rw [he]
      have htri := abs_sub_le (a i * f i (u i) + ∑ j ∈ s, a j * f i (u j))
        0 (∑ j ∈ s, a j * f i (u j))
      rw [add_sub_cancel_right, sub_zero, zero_sub, abs_neg] at htri
      linarith
    have ht' : Tendsto (fun N => |∑ j ∈ Finset.range N, f i (a j • u j)| + ‖a‖ * (δ / 2))
        atTop (𝓝 (|f i (A a)| + ‖a‖ * (δ / 2))) :=
      ((continuous_abs.tendsto (f i (A a))).comp ht).add_const _
    have hlim := ge_of_tendsto ht' hb
    have hnorm : |f i (A a)| ≤ ‖A a‖ := by
      rw [← Real.norm_eq_abs]
      refine ((f i).le_opNorm _).trans ?_
      simpa only [one_mul] using mul_le_mul_of_nonneg_right (hf i) (norm_nonneg (A a))
    exact hlim.trans (add_le_add hnorm le_rfl)
  have hR : 0 ≤ (‖A a‖ + ‖a‖ * (δ / 2)) / δ :=
    div_nonneg (add_nonneg (norm_nonneg _) (mul_nonneg (norm_nonneg _) (by linarith))) hδ.le
  have hn := cZero_norm_le a hR (fun i => (le_div_iff₀ hδ).mpr (hcoord i))
  have hm := (le_div_iff₀ hδ).mp hn
  linarith

/-- A uniformly seminormalized weakly null sequence has arbitrarily late
terms a fixed distance from any finite-dimensional subspace. -/
private theorem exists_large_quotient [CompleteSpace X] (u : ℕ → X)
    {δ M : ℝ} (hδ : 0 < δ) (hlo : ∀ n, δ ≤ ‖u n‖) (hhi : ∀ n, ‖u n‖ ≤ M)
    (hweak : ∀ f : Dual X, Tendsto (fun n => f (u n)) atTop (𝓝 0))
    (S : Submodule ℝ X) [FiniteDimensional ℝ S] (K : ℕ) :
    ∃ n ≥ K, δ / 4 ≤ ‖S.mkQL (u n)‖ := by
  let _ : IsClosed (S : Set X) := S.isClosed_of_finiteDimensional
  by_contra! hb
  have hnear (n : ℕ) : ∃ y : S, ‖u (K + n) - (y : X)‖ < δ / 4 := by
    have hn := hb (K + n) (Nat.le_add_right K n)
    change ‖(Submodule.Quotient.mk (u (K + n)) : X ⧸ S)‖ < δ / 4 at hn
    have he : ‖(Submodule.Quotient.mk (u (K + n)) : X ⧸ S)‖ =
        Metric.infDist (u (K + n)) (S : Set X) :=
      QuotientAddGroup.norm_mk (S := S.toAddSubgroup) _
    rw [he, Metric.infDist_lt_iff ⟨0, S.zero_mem⟩] at hn
    obtain ⟨y, hy, hy'⟩ := hn
    exact ⟨⟨y, hy⟩, by simpa only [dist_eq_norm] using hy'⟩
  choose y hy using hnear
  have hyl (n : ℕ) : 3 * δ / 4 ≤ ‖y n‖ := by
    have hle := norm_le_insert' (u (K + n)) (y n : X)
    change 3 * δ / 4 ≤ ‖(y n : X)‖
    linarith [hlo (K + n), hy n]
  have hyu (n : ℕ) : y n ∈ Metric.closedBall (0 : S) (M + δ / 4) := by
    rw [Metric.mem_closedBall, dist_zero_right]
    change ‖(y n : X)‖ ≤ M + δ / 4
    have hle := norm_le_insert' (y n : X) (u (K + n))
    rw [norm_sub_rev] at hle
    linarith [hhi (K + n), hy n]
  obtain ⟨z, _, k, hk, hzk⟩ := (isCompact_closedBall (0 : S) _).tendsto_subseq hyu
  have hzlo : 3 * δ / 4 ≤ ‖z‖ :=
    ge_of_tendsto hzk.norm (Eventually.of_forall fun n => hyl (k n))
  obtain ⟨f, hf, hfz⟩ := exists_dual_vector ℝ (z : X) (by
    change ‖z‖ ≠ 0
    linarith)
  have hku : Tendsto (fun n => K + k n) atTop atTop := tendsto_atTop.mpr fun N =>
    ((tendsto_atTop.mp hk.tendsto_atTop) N).mono fun n hn => hn.trans (Nat.le_add_left _ _)
  have hfy : Tendsto (fun n => f (y (k n) : X)) atTop (𝓝 (f z)) :=
    (f.comp S.subtypeL).continuous.tendsto z |>.comp hzk
  have habs : Tendsto (fun n => ‖f (y (k n) : X) - f (u (K + k n))‖)
      atTop (𝓝 ‖f z‖) := by simpa only [sub_zero, Function.comp_apply] using (hfy.sub ((hweak f).comp hku)).norm
  have hzhi : ‖f z‖ ≤ δ / 4 := le_of_tendsto habs (Eventually.of_forall fun n => by
    rw [← map_sub]
    exact ((f.le_opNorm _).trans (by rw [hf, one_mul, norm_sub_rev]; exact (hy _).le)))
  change f (z : X) = ‖z‖ at hfz
  rw [hfz, Real.norm_of_nonneg (norm_nonneg z)] at hzhi
  linarith

private theorem wuC_tail (a : ℕ → ℝ) (ha : Summable a) {r : ℝ} (hr : 0 < r) :
    ∃ K : ℕ, ∀ s : Finset ℕ, (∀ n ∈ s, K ≤ n) → ‖∑ n ∈ s, a n‖ < r := by
  obtain ⟨t, ht⟩ := summable_iff_vanishing_norm.mp ha r hr
  obtain ⟨K, hK⟩ := t.exists_nat_subset_range
  refine ⟨K, fun s hs => ht s (Finset.disjoint_left.mpr fun n hn hnt => ?_)⟩
  exact (not_lt_of_ge (hs n hn)) (Finset.mem_range.mp (hK hnt))

/-- The seminormalized form of the Bessaga–Pełczyński argument. -/
theorem contains_cZero_of_seminormalized_abs_dual [CompleteSpace X] (u : ℕ → X)
    (hu : ∀ f : Dual X, Summable (fun n => |f (u n)|))
    {δ : ℝ} (hδ : 0 < δ) (hlo : ∀ n, δ ≤ ‖u n‖) : ContainsCopy CZero X := by
  classical
  obtain ⟨M, hM, huM⟩ := abs_dual_sum_uniform u hu
  have hhi (n : ℕ) : ‖u n‖ ≤ M := by
    simpa only [Finset.sum_singleton, one_smul, mul_one] using
      norm_weighted_sum_le u hM huM {n} (fun _ => 1) (by norm_num : 0 ≤ (1 : ℝ))
        (fun _ _ => by norm_num)
  have hweak (f : Dual X) : Tendsto (fun n => f (u n)) atTop (𝓝 0) :=
    (Summable.of_norm (by simpa only [Real.norm_eq_abs] using hu f)).tendsto_atTop_zero
  have hselect (s : Finset ℕ) (K : ℕ) : ∃ (n : ℕ) (f : Dual X), K ≤ n ∧
      ‖f‖ ≤ 1 ∧ δ / 4 ≤ f (u n) ∧ ∀ j ∈ s, f (u j) = 0 := by
    let S := Submodule.span ℝ (u '' (s : Set ℕ))
    let _ : FiniteDimensional ℝ S := Module.Finite.span_of_finite ℝ (s.finite_toSet.image u)
    let _ : IsClosed (S : Set X) := S.isClosed_of_finiteDimensional
    obtain ⟨n, hn, hfar⟩ := exists_large_quotient u hδ hlo hhi hweak S K
    obtain ⟨g, hg, hgu⟩ := exists_dual_vector ℝ (S.mkQL (u n)) (by linarith)
    refine ⟨n, g.comp S.mkQL, hn, ?_, ?_, fun j hj => ?_⟩
    · refine (g.opNorm_comp_le S.mkQL).trans ?_
      rw [hg, one_mul]
      apply ContinuousLinearMap.opNorm_le_bound _ zero_le_one
      intro x
      rw [one_mul]
      exact QuotientAddGroup.norm_mk_le_norm (S := S.toAddSubgroup)
    · exact hfar.trans (ge_of_eq hgu)
    · have hh : S.mkQL (u j) = 0 :=
        (Submodule.Quotient.mk_eq_zero S).mpr (Submodule.subset_span ⟨j, hj, rfl⟩)
      change g (S.mkQL (u j)) = 0
      rw [hh, map_zero]
  choose index func hmin hfnorm hdiag hvanish using hselect
  have hcut (f : Dual X) : ∃ K : ℕ, ∀ s : Finset ℕ, (∀ n ∈ s, K ≤ n) →
      (∑ n ∈ s, |f (u n)|) ≤ δ / 8 := by
    obtain ⟨K, hK⟩ := wuC_tail _ (hu f) (show 0 < δ / 8 by linarith)
    exact ⟨K, fun s hs => (le_abs_self _).trans
      (by simpa only [Real.norm_eq_abs] using (hK s hs).le)⟩
  choose cut hcut using hcut
  let state : ℕ → Finset ℕ × ℕ :=
    Nat.rec (∅, 0) (fun _ p => (insert (index p.1 p.2) p.1,
      max (index p.1 p.2 + 1) (cut (func p.1 p.2))))
  let k (n : ℕ) := index (state n).1 (state n).2
  let f (n : ℕ) := func (state n).1 (state n).2
  have hstep₁ (n : ℕ) : (state (n + 1)).1 = insert (k n) (state n).1 := rfl
  have hstep₂ (n : ℕ) : (state (n + 1)).2 = max (k n + 1) (cut (f n)) := rfl
  have hm₁ : Monotone (fun n => (state n).1) := monotone_nat_of_le_succ fun n => by
    rw [hstep₁]
    exact Finset.subset_insert _ _
  have hm₂ : Monotone (fun n => (state n).2) := monotone_nat_of_le_succ fun n => by
    rw [hstep₂]
    exact (hmin (state n).1 (state n).2).trans (le_max_of_le_left (Nat.le_succ _))
  have hk : StrictMono k := strictMono_nat_of_lt_succ fun n => by
    have hn := hmin (state (n + 1)).1 (state (n + 1)).2
    rw [hstep₂] at hn
    exact (lt_of_lt_of_le (Nat.lt_succ_self _) (le_max_left _ _)).trans_le hn
  apply contains_cZero_of_triangular (u ∘ k) (fun g => (hu g).comp_injective hk.injective)
    f (show 0 < δ / 4 by linarith)
  · exact fun n => hfnorm (state n).1 (state n).2
  · exact fun n => hdiag (state n).1 (state n).2
  · intro i j hji
    apply hvanish (state i).1 (state i).2 (k j)
    apply hm₁ (Nat.succ_le_of_lt hji)
    change k j ∈ (state (j + 1)).1
    rw [hstep₁]
    exact Finset.mem_insert_self _ _
  · intro i s hs
    have hb := hcut (f i) (s.image k) (fun n hn => by
      obtain ⟨j, hj, rfl⟩ := Finset.mem_image.mp hn
      exact (le_max_right _ _).trans (by
        rw [← hstep₂]
        exact (hm₂ (Nat.succ_le_of_lt (hs j hj))).trans (hmin (state j).1 (state j).2)))
    rw [Finset.sum_image (fun a _ b _ h => hk.injective h)] at hb
    exact hb.trans (by ring_nf; rfl)

/-- The Bessaga–Pełczyński implication used in §§3–4 of the manuscript. -/
theorem summable_of_not_contains_cZero [CompleteSpace X] (hX : ¬ ContainsCopy CZero X)
    (u : ℕ → X) (hu : ∀ f : Dual X, Summable (fun n => |f (u n)|)) : Summable u := by
  classical
  by_contra hn
  rw [summable_iff_vanishing_norm] at hn
  push Not at hn
  obtain ⟨δ, hδ, hn⟩ := hn
  have hb (K : ℕ) : ∃ s : Finset ℕ, (∀ n ∈ s, K ≤ n) ∧ δ ≤ ‖∑ n ∈ s, u n‖ := by
    obtain ⟨s, hd, hl⟩ := hn (Finset.range K)
    exact ⟨s, fun n hns => le_of_not_gt fun h =>
      Finset.disjoint_left.mp hd hns (Finset.mem_range.mpr h), hl⟩
  choose b hb hbig using hb
  choose cutoff hcutoff using fun K => (b K).exists_nat_subset_range
  let N : ℕ → ℕ := Nat.rec 0 (fun _ K => max K (cutoff K))
  let B (n : ℕ) := b (N n)
  have hN : Monotone N := monotone_nat_of_le_succ fun _ => le_max_left _ _
  have hB : Pairwise fun i j => Disjoint (B i) (B j) := by
    apply Pairwise.of_lt
    intro i j hij
    apply Finset.disjoint_left.mpr
    intro k hi hj
    have h₁ := Finset.mem_range.mp (hcutoff (N i) hi)
    have h₂ := hb (N j) k hj
    have h₃ : cutoff (N i) ≤ N (i + 1) := le_max_right _ _
    exact (not_lt_of_ge (h₃.trans ((hN (Nat.succ_le_of_lt hij)).trans h₂))) h₁
  let w (n : ℕ) := ∑ k ∈ B n, u k
  have hw (f : Dual X) : Summable (fun n => |f (w n)|) := by
    refine summable_of_sum_le (fun _ => abs_nonneg _) (c := ∑' k, |f (u k)|) (fun s => ?_)
    calc
      _ ≤ ∑ n ∈ s, ∑ k ∈ B n, |f (u k)| := by
        apply Finset.sum_le_sum
        intro n _
        rw [show w n = ∑ k ∈ B n, u k from rfl, map_sum]
        exact Finset.abs_sum_le_sum_abs _ _
      _ = ∑ k ∈ s.biUnion B, |f (u k)| :=
        (Finset.sum_biUnion (fun i _ j _ hij => hB hij)).symm
      _ ≤ _ := (hu f).sum_le_tsum _ (fun _ _ => abs_nonneg _)
  exact hX (contains_cZero_of_seminormalized_abs_dual w hw hδ (fun n => hbig (N n)))

private noncomputable def cZeroIndicator (s : Finset ℕ) : CZero where
  toContinuousMap := ⟨fun n => if n ∈ s then 1 else 0, continuous_of_discreteTopology⟩
  zero_at_infty' := by
    rw [cocompact_eq_atTop]
    obtain ⟨N, hN⟩ := s.exists_nat_subset_range
    apply tendsto_const_nhds.congr'
    filter_upwards [eventually_ge_atTop N] with n hn
    have hnot : n ∉ s := fun hs => (not_lt_of_ge hn) (Finset.mem_range.mp (hN hs))
    simp only [hnot, ↓reduceIte]

private noncomputable def cZeroEval (n : ℕ) : Dual CZero :=
  LinearMap.mkContinuous
    { toFun := fun a => a n
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl } 1
    (fun a => by
      change ‖a n‖ ≤ 1 * ‖a‖
      rw [Real.norm_eq_abs, one_mul]
      exact cZero_apply_bound a n)

theorem not_weaklySeqComplete_cZero : ¬ WeaklySeqComplete CZero := by
  classical
  intro h
  let e (n : ℕ) : CZero := cZeroIndicator {n}
  have hId (s : Finset ℕ) : ∑ n ∈ s, e n = cZeroIndicator s := by
    ext j
    change (∑ n ∈ s, e n).toContinuousMap j = _
    rw [show (∑ n ∈ s, e n).toContinuousMap j = ∑ n ∈ s, e n j from
      map_sum (cZeroEval j) _ _]
    change (∑ n ∈ s, if j ∈ ({n} : Finset ℕ) then (1 : ℝ) else 0) =
      if j ∈ s then 1 else 0
    simp
  have hnorm (s : Finset ℕ) : ‖cZeroIndicator s‖ ≤ 1 := by
    apply cZero_norm_le _ zero_le_one
    intro n
    change |if n ∈ s then (1 : ℝ) else 0| ≤ 1
    by_cases hs : n ∈ s <;> simp [hs]
  have hsum (f : Dual CZero) : Summable (fun n => |f (e n)|) := by
    refine summable_of_sum_le (fun _ => abs_nonneg _) (c := 2 * ‖f‖) ?_
    apply real_abs_finite_subsum_le
    intro s
    rw [← map_sum, hId, ← Real.norm_eq_abs]
    refine (f.le_opNorm _).trans ?_
    simpa only [mul_one] using mul_le_mul_of_nonneg_left (hnorm s) (norm_nonneg f)
  obtain ⟨a, ha⟩ := h (fun N => cZeroIndicator (Finset.range N)) (fun f => by
    have hf := (Summable.of_norm (show Summable (fun n => ‖f (e n)‖) by
      simpa only [Real.norm_eq_abs] using hsum f)).hasSum.tendsto_sum_nat.cauchySeq
    have he : (fun N => ∑ n ∈ Finset.range N, f (e n)) =
        fun N => f (cZeroIndicator (Finset.range N)) := by
      funext N
      rw [← map_sum, hId]
    exact he ▸ hf)
  have ha1 (n : ℕ) : a n = 1 := by
    have hf : Tendsto (fun N => cZeroIndicator (Finset.range N) n) atTop (𝓝 (a n)) :=
      ha (cZeroEval n)
    have he : (fun N => cZeroIndicator (Finset.range N) n) =ᶠ[atTop] fun _ => (1 : ℝ) := by
      filter_upwards [eventually_ge_atTop (n + 1)] with N hN
      change (if n ∈ Finset.range N then (1 : ℝ) else 0) = 1
      have hn : n ∈ Finset.range N := Finset.mem_range.mpr (Nat.lt_of_succ_le hN)
      simp only [hn, ↓reduceIte]
    exact tendsto_nhds_unique hf (tendsto_const_nhds.congr' he.symm)
  have he : (fun n => a n) = fun _ => (1 : ℝ) := funext ha1
  have ht := cZero_tendsto a
  change Tendsto (fun n => a n) atTop (𝓝 (0 : ℝ)) at ht
  rw [he] at ht
  exact zero_ne_one (tendsto_nhds_unique ht tendsto_const_nhds)

/-- Weak sequential completeness passes to closed subspaces. -/
theorem WeaklySeqComplete.closedSubmodule (hX : WeaklySeqComplete X) (Y : Submodule ℝ X)
    (hY : IsClosed (Y : Set X)) : WeaklySeqComplete Y := by
  let _ : IsClosed (Y : Set X) := hY
  intro x hx
  obtain ⟨y, hy⟩ := hX (fun n => (x n : X)) (fun f => hx (f.comp Y.subtypeL))
  have hy0 : Y.mkQL y = 0 := by
    apply eq_of_dual_eval
    intro f
    have lim := hy (f.comp Y.mkQL)
    have hz : (fun n => (f.comp Y.mkQL) (x n : X)) = fun _ => (0 : ℝ) := by
      funext n
      change f (Y.mkQL (x n : X)) = 0
      rw [show Y.mkQL (x n : X) = 0 from (Submodule.Quotient.mk_eq_zero Y).mpr (x n).2,
        map_zero]
    rw [hz] at lim
    simpa only [map_zero, ContinuousLinearMap.comp_apply] using
      (tendsto_nhds_unique lim tendsto_const_nhds)
  have hym : y ∈ Y := (Submodule.Quotient.mk_eq_zero Y).mp hy0
  refine ⟨⟨y, hym⟩, fun f => ?_⟩
  obtain ⟨g, hg, _⟩ := exists_extension_norm_eq Y f
  have he : g y = f ⟨y, hym⟩ := hg ⟨y, hym⟩
  simpa only [hg, he] using hy g

/-- Bounded-below maps from Banach spaces have closed ranges, and their
inverse on the range is bounded by the reciprocal lower bound. -/
theorem ContainsCopy.closed_range [CompleteSpace E] (h : ContainsCopy E X) :
    ∃ Y : Submodule ℝ X, IsClosed (Y : Set X) ∧ Nonempty (E ≃L[ℝ] Y) := by
  obtain ⟨A, c, hc, hl⟩ := h
  let K : ℝ≥0 := ⟨1 / c, by positivity⟩
  have ha : AntilipschitzWith K A := AntilipschitzWith.of_le_mul_dist fun x y => by
    rw [dist_eq_norm, dist_eq_norm, ← map_sub]
    change ‖x - y‖ ≤ (1 / c) * ‖A (x - y)‖
    rw [one_div, inv_mul_eq_div, le_div_iff₀ hc, mul_comm]
    exact hl (x - y)
  let Y := A.toLinearMap.range
  have hY : IsClosed (Y : Set X) := ha.isClosed_range A.lipschitzWith.uniformContinuous
  let B := LinearEquiv.ofInjective A.toLinearMap ha.injective
  have hB (y : Y) : ‖B.symm y‖ ≤ (1 / c) * ‖y‖ := by
    rw [one_div, inv_mul_eq_div, le_div_iff₀ hc, mul_comm]
    exact (hl (B.symm y)).trans_eq (congrArg (fun w : Y => ‖w‖) (B.apply_symm_apply y))
  refine ⟨Y, hY, ⟨{ toLinearEquiv := B, continuous_toFun := ?_, continuous_invFun := ?_ }⟩⟩
  · exact (A.codRestrict Y fun x => ⟨x, rfl⟩).continuous
  · exact (B.symm.toLinearMap.mkContinuous (1 / c) hB).continuous

theorem containsCopy_iff_closed_range [CompleteSpace E] : ContainsCopy E X ↔
    ∃ Y : Submodule ℝ X, IsClosed (Y : Set X) ∧ Nonempty (E ≃L[ℝ] Y) := by
  constructor
  · exact ContainsCopy.closed_range
  · rintro ⟨Y, _, ⟨B⟩⟩
    let A := Y.subtypeL.comp B.toContinuousLinearMap
    let C := ‖B.symm.toContinuousLinearMap‖ + 1
    have hC : 0 < C := by dsimp [C]; positivity
    refine ⟨A, 1 / C, one_div_pos.mpr hC, fun x => ?_⟩
    rw [one_div, inv_mul_eq_div, div_le_iff₀ hC, mul_comm]
    have h := B.symm.toContinuousLinearMap.le_opNorm (B x)
    change ‖B.symm (B x)‖ ≤ ‖B.symm.toContinuousLinearMap‖ * ‖A x‖ at h
    rw [B.symm_apply_apply x] at h
    exact h.trans (mul_le_mul_of_nonneg_right (by dsimp [C]; linarith) (norm_nonneg _))

theorem WeaklySeqComplete.not_contains_cZero (hX : WeaklySeqComplete X) : ¬ ContainsCopy CZero X := by
  intro h
  obtain ⟨Y, hY, ⟨B⟩⟩ := h.closed_range
  apply not_weaklySeqComplete_cZero
  intro x hx
  obtain ⟨y, hy⟩ := (hX.closedSubmodule Y hY) (fun n => B (x n)) (fun f =>
    hx (f.comp B.toContinuousLinearMap))
  refine ⟨B.symm y, fun f => ?_⟩
  simpa only [ContinuousLinearMap.comp_apply, ContinuousLinearEquiv.coe_coe,
    ContinuousLinearEquiv.symm_apply_apply] using hy (f.comp B.symm.toContinuousLinearMap)

variable {Ω Z : Type*} [MeasurableSpace Ω] [NormedAddCommGroup Z] [NormedSpace ℝ Z]

theorem PVM.boundedlyComplete_of_not_contains_cZero [CompleteSpace X] (P : PVM Ω X)
    (hX : ¬ ContainsCopy CZero X) : P.BoundedlyComplete := by
  intro A z hA hz hbound
  obtain ⟨C, hC⟩ := hbound
  have hs := summable_of_not_contains_cZero hX z (fun f =>
    (P.summable_abs_dual_of_bounded_partialSums A hA z hz C hC f).1)
  exact ⟨∑' n, z n, hs.hasSum.tendsto_sum_nat⟩

/-- Manuscript, thm:representation-james (2), all four equivalent clauses. -/
theorem PVM.boundedlyComplete_james [CompleteSpace X] (P : PVM Ω X) (hP : P.Localizes) :
    (P.BoundedlyComplete ↔ ¬ ContainsCopy CZero X) ∧
    (P.BoundedlyComplete ↔ WeaklySeqComplete X) ∧
    (P.BoundedlyComplete ↔ {ξ : Bidual X | P.toOVM.Normal ξ} = Set.range (J : X → Bidual X)) := by
  have h₁ : P.BoundedlyComplete ↔ WeaklySeqComplete X :=
    ⟨P.weaklySeqComplete_of_boundedlyComplete hP, P.boundedlyComplete_of_weaklySeqComplete⟩
  have he : {ξ : Bidual X | P.toOVM.Normal ξ} = {ξ : Bidual X | BaireOne ξ} :=
    Set.ext (P.normal_iff_baireOne hP)
  exact ⟨⟨fun h => (h₁.mp h).not_contains_cZero, P.boundedlyComplete_of_not_contains_cZero⟩,
    h₁, by rw [he]; exact h₁.trans weaklySeqComplete_iff_baireOne⟩

/-- Manuscript, prop:minimal-bounded-complete. -/
theorem OVM.alpha_boundedlyComplete_of_not_contains_cZero [CompleteSpace X] (μ : OVM Ω X)
    (hX : ¬ ContainsCopy CZero X) : μ.BoundedlyComplete :=
  μ.alpha_boundedlyComplete_of_unconditional (summable_of_not_contains_cZero hX)

/-- Manuscript, prop:ovm-normal (2). -/
theorem Dilation.boundedlyComplete_iff_not_contains_cZero [CompleteSpace X] [CompleteSpace Z]
    {μ : OVM Ω X} (D : Dilation μ Z) (hP : D.P.Localizes) :
    μ.BoundedlyComplete ↔ ¬ ContainsCopy CZero X :=
  ⟨fun h => ((D.boundedlyComplete_iff_weaklySeqComplete hP).mp h).not_contains_cZero,
    μ.alpha_boundedlyComplete_of_not_contains_cZero⟩

