#print axioms BarronSphere.synthesisQuotient_canonicalSection
#print axioms BarronSphere.barronOperatorMeasure_normalized
#print axioms BarronSphere.barronOperatorMeasure_symmetric_mul


/-- A positive probability measure satisfying the manuscript's compatibility conditions. -/
def CompatibleProbability (d : ℕ) (ρ : Measure (BarronSphere d)) : Prop :=
  ρ univ = 1 ∧ (∃ k : ℝ≥0∞, k < ∞ ∧ Measure.map (reflection d) ρ ≤ k • ρ) ∧
    (∀ i : Fin d, 0 < ρ {axis i} ∧ 0 < ρ {axisMinus i}) ∧
    0 < ρ {polePlus d} ∧ 0 < ρ {poleMinus d}

private theorem map_reflection_map (ρ : Measure (BarronSphere d)) :
    Measure.map (reflection d) (Measure.map (reflection d) ρ) = ρ := by
  rw [Measure.map_map (reflection d).measurable (reflection d).measurable]
  rw [show (reflection d : BarronSphere d → BarronSphere d) ∘ reflection d = id
    from funext (reflection_involutive d), Measure.map_id]

private theorem map_reflection_univ (ρ : Measure (BarronSphere d)) :
    Measure.map (reflection d) ρ univ = ρ univ := by
  rw [Measure.map_apply (reflection d).measurable MeasurableSet.univ, preimage_univ]

/-- The mixture with coefficient a on the input and b on each of its reflection and the atoms. -/
def compatibleMixture (η τ : Measure (BarronSphere d)) (a b : ℝ≥0∞) :
    Measure (BarronSphere d) := a • η + b • Measure.map (reflection d) η + b • τ

private theorem measure_scale_mono {μ ν : Measure (BarronSphere d)} (h : μ ≤ ν) (c : ℝ≥0∞) :
    c • μ ≤ c • ν := by
  intro E
  exact mul_le_mul_right (h E) c

theorem compatibleMixture_dominates (η τ : Measure (BarronSphere d))
    (a b : ℝ≥0∞) (ha : a ≠ 0) (hat : a ≠ ∞) :
    η ≤ a⁻¹ • compatibleMixture η τ a b := by
  have hₐ : a • η ≤ compatibleMixture η τ a b :=
    (Measure.le_add_right le_rfl).trans (Measure.le_add_right le_rfl)
  have h := measure_scale_mono hₐ a⁻¹
  rw [smul_smul, ENNReal.inv_mul_cancel ha hat, one_smul] at h
  exact h

theorem compatibleMixture_compatible (η τ : Measure (BarronSphere d))
    (hη : η univ = 1) (hτ : τ univ = 1) (hτE : Measure.map (reflection d) τ = τ)
    (hτA : (∀ i : Fin d, 0 < τ {axis i} ∧ 0 < τ {axisMinus i}) ∧
      0 < τ {polePlus d} ∧ 0 < τ {poleMinus d})
    (a b : ℝ≥0∞) (ha : a ≠ 0) (hb : b ≠ 0) (hat : a ≠ ∞) (hbt : b ≠ ∞)
    (hs : a + b + b = 1) :
    CompatibleProbability d (compatibleMixture η τ a b) := by
  let r := reflection d
  let ν := Measure.map r η
  let ρ := compatibleMixture η τ a b
  have hA : a • η ≤ ρ := (Measure.le_add_right le_rfl).trans (Measure.le_add_right le_rfl)
  have hB : b • ν ≤ ρ := (Measure.le_add_left le_rfl).trans (Measure.le_add_right le_rfl)
  have hC : b • τ ≤ ρ := Measure.le_add_left le_rfl
  constructor
  · change ρ univ = 1
    simp [ρ, compatibleMixture, map_reflection_univ, hη, hτ, hs]
  constructor
  · let k := a / b + b / a + 1
    have hk : k < ∞ := by
      unfold k
      exact lt_top_iff_ne_top.mpr (ENNReal.add_ne_top.mpr
        ⟨ENNReal.add_ne_top.mpr ⟨ENNReal.div_ne_top hat hb, ENNReal.div_ne_top hbt ha⟩, ENNReal.one_ne_top⟩)
    refine ⟨k, hk, ?_⟩
    have h1 := measure_scale_mono hB (a / b)
    have h2 := measure_scale_mono hA (b / a)
    rw [smul_smul, ENNReal.div_mul_cancel hb hbt] at h1
    rw [smul_smul, ENNReal.div_mul_cancel ha hat] at h2
    change Measure.map r (a • η + b • ν + b • τ) ≤ k • ρ
    rw [Measure.map_add _ _ r.measurable, Measure.map_add _ _ r.measurable,
      Measure.map_smul _ r.measurable.aemeasurable, Measure.map_smul _ r.measurable.aemeasurable,
      Measure.map_smul _ r.measurable.aemeasurable]
    change a • ν + b • Measure.map r ν + b • Measure.map r τ ≤ _
    rw [map_reflection_map, hτE, show k • ρ = (a / b) • ρ + (b / a) • ρ + ρ by
      simp only [k, add_smul, one_smul]]
    exact add_le_add (add_le_add h1 h2) hC
  · have hpos (θ : BarronSphere d) (hθ : 0 < τ {θ}) : 0 < ρ {θ} := by
      exact (ENNReal.mul_pos hb (ne_of_gt hθ)).trans_le (hC {θ})
    exact ⟨fun i => ⟨hpos _ (hτA.1 i).1, hpos _ (hτA.1 i).2⟩,
      hpos _ hτA.2.1, hpos _ hτA.2.2⟩

#print axioms BarronSphere.compatibleMixture_compatible
#print axioms BarronSphere.compatibleMixture_dominates


private def positiveAtom (d : ℕ) (i : Option (Fin d)) : BarronSphere d :=
  i.elim (polePlus d) axis

/-- Equal mass on all marked parameters, including both poles. -/
def uniformAtomicProbability (d : ℕ) : Measure (BarronSphere d) :=
  (2 * (d + 1 : ℝ≥0∞))⁻¹ •
    (Measure.sum (fun i : Option (Fin d) => Measure.dirac (positiveAtom d i)) +
      Measure.sum (fun i : Option (Fin d) => Measure.dirac (reflection d (positiveAtom d i))))

private theorem map_reflection_dirac (θ : BarronSphere d) :
    Measure.map (reflection d) (Measure.dirac θ) = Measure.dirac (reflection d θ) :=
  Measure.map_dirac' (reflection d).measurable θ

theorem uniformAtomicProbability_symmetric (d : ℕ) :
    Measure.map (reflection d) (uniformAtomicProbability d) = uniformAtomicProbability d := by
  let r := reflection d
  unfold uniformAtomicProbability
  rw [Measure.map_smul _ r.measurable.aemeasurable, Measure.map_add _ _ r.measurable,
    Measure.map_sum r.measurable.aemeasurable, Measure.map_sum r.measurable.aemeasurable]
  simp only [r, map_reflection_dirac]
  have h : (fun i : Option (Fin d) => Measure.dirac (reflection d (reflection d (positiveAtom d i)))) =
      fun i => Measure.dirac (positiveAtom d i) := funext fun i =>
        congrArg Measure.dirac (reflection_involutive d (positiveAtom d i))
  rw [h, add_comm (Measure.sum fun i : Option (Fin d) => Measure.dirac (reflection d (positiveAtom d i))) ]

theorem uniformAtomicProbability_mass (d : ℕ) : uniformAtomicProbability d univ = 1 := by
  unfold uniformAtomicProbability
  simp only [smul_apply, smul_eq_mul, add_apply, Measure.sum_apply _ MeasurableSet.univ,
    Measure.dirac_apply_of_mem (mem_univ _), tsum_fintype, Finset.sum_const, Finset.card_univ,
    Fintype.card_option, Fintype.card_fin, nsmul_eq_mul, Nat.cast_add, Nat.cast_one, mul_one, ← two_mul]
  exact ENNReal.inv_mul_cancel (by positivity) (by finiteness)

private theorem uniformAtomicProbability_marked (d : ℕ) (i : Option (Fin d)) :
    0 < uniformAtomicProbability d {positiveAtom d i} ∧
    0 < uniformAtomicProbability d {reflection d (positiveAtom d i)} := by
  let μ := Measure.sum (fun j : Option (Fin d) => Measure.dirac (positiveAtom d j))
  let ν := Measure.sum (fun j : Option (Fin d) => Measure.dirac (reflection d (positiveAtom d j)))
  have hμ : Measure.dirac (positiveAtom d i) ≤ μ := Measure.le_sum (fun j => Measure.dirac (positiveAtom d j)) i
  have hν : Measure.dirac (reflection d (positiveAtom d i)) ≤ ν := Measure.le_sum (fun j => Measure.dirac (reflection d (positiveAtom d j))) i
  let c := (2 * (d + 1 : ℝ≥0∞))⁻¹
  have hc : 0 < c := ENNReal.inv_pos.mpr (by finiteness)
  have h₁ : Measure.dirac (positiveAtom d i) ≤ μ + ν := Measure.le_add_right hμ
  have h₂ : Measure.dirac (reflection d (positiveAtom d i)) ≤ μ + ν := Measure.le_add_left hν
  constructor
  · refine lt_of_lt_of_le (b := c * (1 : ℝ≥0∞)) (by simpa using hc) ?_
    change c * 1 ≤ c * (μ + ν) {positiveAtom d i}
    have h := h₁ {positiveAtom d i}
    rw [Measure.dirac_apply_of_mem (mem_singleton _)] at h
    exact mul_le_mul_right h c
  · refine lt_of_lt_of_le (b := c * (1 : ℝ≥0∞)) (by simpa using hc) ?_
    change c * 1 ≤ c * (μ + ν) {reflection d (positiveAtom d i)}
    have h := h₂ {reflection d (positiveAtom d i)}
    rw [Measure.dirac_apply_of_mem (mem_singleton _)] at h
    exact mul_le_mul_right h c

theorem compatibleMixture_with_uniformAtoms (η : Measure (BarronSphere d)) (hη : η univ = 1)
    (a b : ℝ≥0∞) (ha : a ≠ 0) (hb : b ≠ 0) (hat : a ≠ ∞) (hbt : b ≠ ∞)
    (hs : a + b + b = 1) :
    CompatibleProbability d (compatibleMixture η (uniformAtomicProbability d) a b) := by
  apply compatibleMixture_compatible η _ hη (uniformAtomicProbability_mass _)
    (uniformAtomicProbability_symmetric _)
  · refine ⟨fun i => uniformAtomicProbability_marked d (some i), ?_⟩
    have hp : reflection d (polePlus d) = poleMinus d := by
      apply Subtype.ext
      exact Prod.ext (neg_zero : -(0 : Fin d → ℝ) = 0) rfl
    simpa only [positiveAtom, Option.elim_none, hp] using uniformAtomicProbability_marked d none
  · exact ha
  · exact hb
  · exact hat
  · exact hbt
  · exact hs

#print axioms BarronSphere.uniformAtomicProbability_mass
#print axioms BarronSphere.compatibleMixture_with_uniformAtoms


theorem compatibleProbabilities_cofinal (η : Measure (BarronSphere d)) (hη : η univ = 1)
    (ε : NNReal) (hε : 0 < ε) (hε₁ : ε < 1) :
    let a : ℝ≥0∞ := (↑(1 - ε : NNReal) : ℝ≥0∞)
    let ρ := compatibleMixture η (uniformAtomicProbability d) a ((ε : ℝ≥0∞) / 2)
    CompatibleProbability d ρ ∧ η ≤ a⁻¹ • ρ := by
  dsimp only
  let a : ℝ≥0∞ := ↑(1 - ε : NNReal)
  let b : ℝ≥0∞ := (ε : ℝ≥0∞) / 2
  have ha : a ≠ 0 := by
    dsimp only [a]
    exact_mod_cast (ne_of_gt (tsub_pos_of_lt hε₁))
  have hb : b ≠ 0 := by
    change (ε : ℝ≥0∞) / 2 ≠ 0
    exact (ENNReal.div_pos (by exact_mod_cast (ne_of_gt hε)) (by norm_num)).ne'
  have hat : a ≠ ∞ := ENNReal.coe_ne_top
  have hbt : b ≠ ∞ := by
    exact ENNReal.div_ne_top ENNReal.coe_ne_top (by norm_num)
  have hs : a + b + b = 1 := by
    have h2b : b + b = (ε : ℝ≥0∞) := by
      rw [← two_mul, mul_comm]
      exact ENNReal.div_mul_cancel (by norm_num) (by norm_num)
    rw [add_assoc, h2b]
    dsimp only [a]
    exact_mod_cast (tsub_add_cancel_of_le hε₁.le)
  exact ⟨compatibleMixture_with_uniformAtoms η hη a b ha hb hat hbt hs,
    compatibleMixture_dominates η _ a b ha hat⟩

theorem compatibleProbabilities_countablyDirected (ρ : ℕ → Measure (BarronSphere d))
    (hρ : ∀ n, CompatibleProbability d (ρ n)) :
    ∃ ν : Measure (BarronSphere d), CompatibleProbability d ν ∧
      ∀ n, ∃ k : ℝ≥0∞, k < ∞ ∧ ρ n ≤ k • ν := by
  let w : ℕ → NNReal := fun n => (1 / 2) * (1 / 2)^n
  have hw : HasSum w 1 := by
    have hg := (NNReal.hasSum_geometric (show (1 / 2 : NNReal) < 1 by norm_num)).mul_left (1 / 2 : NNReal)
    have h : (1 / 2 : NNReal) * (1 - 1 / 2)⁻¹ = 1 := by
      rw [show (1 - 1 / 2 : NNReal) = 1 / 2 from tsub_eq_of_eq_add (by norm_num), mul_inv_cancel₀ (by norm_num)]
    simpa only [h] using hg
  let η := Measure.sum (fun n => (w n : ℝ≥0∞) • ρ n)
  have hη : η univ = 1 := by
    change Measure.sum (fun n => (w n : ℝ≥0∞) • ρ n) univ = 1
    rw [Measure.sum_apply _ MeasurableSet.univ]
    have hm (n : ℕ) := (hρ n).1
    simp only [smul_apply, smul_eq_mul, hm, mul_one]
    exact ENNReal.tsum_coe_eq hw
  obtain ⟨hν, hη_le⟩ := compatibleProbabilities_cofinal η hη (1 / 2) (by norm_num) (by norm_num)
  let a : ℝ≥0∞ := ↑(1 - (1 / 2 : NNReal))
  let ν := compatibleMixture η (uniformAtomicProbability d) a ((↑(1 / 2 : NNReal) : ℝ≥0∞) / 2)
  refine ⟨ν, hν, fun n => ?_⟩
  have h1 : (w n : ℝ≥0∞) • ρ n ≤ η := Measure.le_sum (fun j => (w j : ℝ≥0∞) • ρ j) n
  have h2 := measure_scale_mono (h1.trans hη_le) ((w n : ℝ≥0∞)⁻¹)
  have hwn0 : (w n : ℝ≥0∞) ≠ 0 := by
    exact_mod_cast (show w n ≠ 0 by unfold w; positivity)
  rw [smul_smul, ENNReal.inv_mul_cancel hwn0 ENNReal.coe_ne_top, one_smul, smul_smul] at h2
  refine ⟨((w n : ℝ≥0∞)⁻¹) * a⁻¹, ?_, h2⟩
  have ha0 : a ≠ 0 := by norm_num [a]
  exact ENNReal.mul_lt_top (lt_top_iff_ne_top.mpr (ENNReal.inv_ne_top.mpr hwn0))
    (lt_top_iff_ne_top.mpr (ENNReal.inv_ne_top.mpr ha0))

#print axioms BarronSphere.compatibleProbabilities_cofinal
#print axioms BarronSphere.compatibleProbabilities_countablyDirected


theorem signedPushforward_ofDensity (r : BarronSphere d ≃ᵐ BarronSphere d)
    {ρ : Measure (BarronSphere d)} {f : BarronSphere d → ℝ} (hmf : Measurable f)
    (hf : Integrable f ρ) :
    ∃ h : Integrable (fun t => f (r.symm t)) (Measure.map r ρ),
      pushforward r (ofDensity hf) = ofDensity h := by
  let v := fun t => f (r.symm t)
  have hvm : Measurable v := hmf.comp r.symm.measurable
  have hvi : Integrable v (Measure.map r ρ) := by
    apply (integrable_map_measure hvm.aestronglyMeasurable r.measurable.aemeasurable).mpr
    simpa only [v, Function.comp_def, r.symm_apply_apply] using hf
  refine ⟨hvi, ?_⟩
  apply FiniteSignedMeasure.ext
  intro E
  rw [eval_pushforward, eval_ofDensity, eval_ofDensity]
  rw [← integral_indicator E.2, integral_map r.measurable.aemeasurable (hvm.indicator E.2).aestronglyMeasurable,
    ← integral_indicator (r.measurable E.2)]
  apply integral_congr_ae
  filter_upwards with t
  by_cases h : r t ∈ E.1
  · rw [indicator_of_mem h, indicator_of_mem (show t ∈ r ⁻¹' E.1 from h)]
    exact (congrArg f (r.symm_apply_apply t)).symm
  · rw [indicator_of_notMem h, indicator_of_notMem (show t ∉ r ⁻¹' E.1 from h)]

theorem pointMass_density {ρ : Measure (BarronSphere d)} [IsFiniteMeasure ρ]
    (θ : BarronSphere d) (hθ : ρ {θ} ≠ 0) :
    ∃ h : Integrable (({θ} : Set (BarronSphere d)).indicator
        (fun _ => ((ρ {θ}).toReal)⁻¹ : BarronSphere d → ℝ)) ρ,
      pointMass θ = ofDensity h := by
  have h₁ : Integrable (fun _ : BarronSphere d => ((ρ {θ}).toReal)⁻¹) ρ := integrable_const _
  refine ⟨h₁.indicator (measurableSet_singleton _), ?_⟩
  apply FiniteSignedMeasure.ext
  intro E
  rw [eval_pointMass, eval_ofDensity, setIntegral_indicator (measurableSet_singleton _), setIntegral_const]
  have hn : (ρ {θ}).toReal ≠ 0 := ENNReal.toReal_ne_zero.mpr ⟨hθ, measure_ne_top _ _⟩
  by_cases he : θ ∈ E.1
  · rw [ite_eq_left he, show E.1 ∩ {θ} = {θ} from inter_eq_right.mpr (singleton_subset_iff.mpr he)]
    change 1 = (ρ {θ}).toReal * (ρ {θ}).toReal⁻¹
    rw [mul_inv_cancel₀ hn]
  · rw [ite_eq_right he, show E.1 ∩ {θ} = ∅ from Set.disjoint_iff_inter_eq_empty.mp
      (Set.disjoint_singleton_right.mpr he)]
    simp

#print axioms BarronSphere.signedPushforward_ofDensity
#print axioms BarronSphere.pointMass_density


private theorem reflection_inverse (θ : BarronSphere d) :
    (reflection d).symm θ = reflection d θ := by
  apply (reflection d).injective
  rw [MeasurableEquiv.apply_symm_apply]
  exact (reflection_involutive d θ).symm

/-- The real Radon–Nikodym coefficient for the reflected density. -/
def reflectedDensity (ρ : Measure (BarronSphere d)) (f : BarronSphere d → ℝ) :
    BarronSphere d → ℝ :=
  fun θ => ((Measure.map (reflection d) ρ).rnDeriv ρ θ).toReal * f (reflection d θ)

theorem reflectedDensity_representation {ρ : Measure (BarronSphere d)} [IsFiniteMeasure ρ]
    (hρ : Measure.map (reflection d) ρ ≪ ρ) {f : BarronSphere d → ℝ}
    (hm : Measurable f) (hf : Integrable f ρ) :
    ∃ h : Integrable (reflectedDensity ρ f) ρ, pushforward (reflection d) (ofDensity hf) = ofDensity h := by
  let ν := Measure.map (reflection d) ρ
  let r : BarronSphere d → NNReal := fun θ => (ν.rnDeriv ρ θ).toNNReal
  let v := fun θ => f ((reflection d).symm θ)
  have hr : Measurable r := (ν.measurable_rnDeriv ρ).ennreal_toNNReal
  have hν : ρ.withDensity (fun θ => (r θ : ℝ≥0∞)) = ν := by
    rw [← ν.withDensity_rnDeriv_eq ρ hρ]
    apply withDensity_congr_ae
    filter_upwards [ν.rnDeriv_lt_top ρ] with θ hθ
    exact ENNReal.coe_toNNReal hθ.ne
  obtain ⟨hv, hp⟩ := signedPushforward_ofDensity (reflection d) hm hf
  have hvi : Integrable v (ρ.withDensity (fun θ => (r θ : ℝ≥0∞))) := hν ▸ hv
  have hi := (integrable_withDensity_iff_integrable_smul hr).mp hvi
  have hfun : (fun θ => r θ • v θ) = reflectedDensity ρ f := by
    funext θ
    change (r θ : ℝ) * f ((reflection d).symm θ) =
      (ν.rnDeriv ρ θ).toReal * f (reflection d θ)
    rw [reflection_inverse]
    rfl
  rw [hfun] at hi
  refine ⟨hi, hp.trans ?_⟩
  apply FiniteSignedMeasure.ext
  intro E
  rw [eval_ofDensity, eval_ofDensity]
  change (∫ θ in E.1, v θ ∂ν) = _
  rw [← hν, setIntegral_withDensity_eq_setIntegral_smul hr v E.2]
  rw [hfun]

#print axioms BarronSphere.reflectedDensity_representation


private def RepresentsDensity (ρ : Measure (BarronSphere d)) (f : BarronSphere d → ℝ)
    (μ : FiniteSignedMeasure (BarronSphere d)) : Prop :=
  ∃ h : Integrable f ρ, ofDensity h = μ

private theorem representsDensity_add {ρ : Measure (BarronSphere d)}
    {f g : BarronSphere d → ℝ} {μ ν : FiniteSignedMeasure (BarronSphere d)}
    (hf : RepresentsDensity ρ f μ) (hg : RepresentsDensity ρ g ν) :
    RepresentsDensity ρ (f + g) (μ + ν) := by
  obtain ⟨hf, rfl⟩ := hf
  obtain ⟨hg, rfl⟩ := hg
  refine ⟨hf.add hg, ?_⟩
  apply FiniteSignedMeasure.ext
  intro E
  rw [eval_ofDensity, map_add, eval_ofDensity, eval_ofDensity]
  exact integral_add hf.integrableOn hg.integrableOn

private theorem representsDensity_smul {ρ : Measure (BarronSphere d)}
    {f : BarronSphere d → ℝ} {μ : FiniteSignedMeasure (BarronSphere d)} (a : ℝ)
    (hf : RepresentsDensity ρ f μ) : RepresentsDensity ρ (a • f) (a • μ) := by
  obtain ⟨hf, rfl⟩ := hf
  refine ⟨hf.smul a, ?_⟩
  apply FiniteSignedMeasure.ext
  intro E
  rw [eval_ofDensity, map_smul, eval_ofDensity]
  exact integral_smul a f

private theorem representsDensity_sub {ρ : Measure (BarronSphere d)}
    {f g : BarronSphere d → ℝ} {μ ν : FiniteSignedMeasure (BarronSphere d)}
    (hf : RepresentsDensity ρ f μ) (hg : RepresentsDensity ρ g ν) :
    RepresentsDensity ρ (f - g) (μ - ν) := by
  obtain ⟨hf, rfl⟩ := hf
  obtain ⟨hg, rfl⟩ := hg
  refine ⟨hf.sub hg, ?_⟩
  apply FiniteSignedMeasure.ext
  intro E
  rw [eval_ofDensity, show eval E (ofDensity hf - ofDensity hg) =
      eval E (ofDensity hf) - eval E (ofDensity hg) from map_sub (eval E).toLinearMap _ _,
    eval_ofDensity, eval_ofDensity]
  exact integral_sub hf.integrableOn hg.integrableOn

private theorem representsDensity_cut {ρ : Measure (BarronSphere d)}
    {f : BarronSphere d → ℝ} {μ : FiniteSignedMeasure (BarronSphere d)}
    (h : RepresentsDensity ρ f μ) (E : MeasSet (BarronSphere d)) :
    RepresentsDensity ρ (E.1.indicator f) (cut E μ) := by
  obtain ⟨h, rfl⟩ := h
  exact ⟨h.indicator E.2, (cut_ofDensity h E).symm⟩

private theorem representsDensity_sum {ρ : Measure (BarronSphere d)}
    {f : Fin d → BarronSphere d → ℝ} {μ : Fin d → FiniteSignedMeasure (BarronSphere d)}
    (H : ∀ i, RepresentsDensity ρ (f i) (μ i)) (F : Finset (Fin d)) :
    RepresentsDensity ρ (∑ i ∈ F, f i) (∑ i ∈ F, μ i) := by
  classical
  induction F using Finset.induction_on with
  | empty =>
      simp only [Finset.sum_empty]
      refine ⟨integrable_zero _ _ _, ?_⟩
      apply FiniteSignedMeasure.ext
      intro E
      rw [eval_ofDensity, map_zero]
      exact integral_zero _ _
  | insert i F hi ih =>
      rw [Finset.sum_insert hi, Finset.sum_insert hi]
      exact representsDensity_add (H i) ih

/-- The atom's density, with respect to a measure giving positive mass to that atom. -/
def atomicDensity (ρ : Measure (BarronSphere d)) (u : BarronSphere d) : BarronSphere d → ℝ :=
  ({u} : Set (BarronSphere d)).indicator (fun _ => ((ρ {u}).toReal)⁻¹)

private theorem representsDensity_atom {ρ : Measure (BarronSphere d)} [IsFiniteMeasure ρ]
    (u : BarronSphere d) (hu : ρ {u} ≠ 0) : RepresentsDensity ρ (atomicDensity ρ u) (pointMass u) := by
  obtain ⟨h, hh⟩ := pointMass_density u hu
  exact ⟨h, hh.symm⟩

/-- The coefficient function in the paper's formula for the local projection. -/
def canonicalDensity (ρ : Measure (BarronSphere d)) (f : BarronSphere d → ℝ)
    (a : (Fin d → ℝ) × ℝ) : BarronSphere d → ℝ :=
  (1 / 2 : ℝ) • ((nonPole d).1.indicator (f + reflectedDensity ρ f)) +
    ((∑ i : Fin d, a.1 i • (atomicDensity ρ (axis i) - atomicDensity ρ (axisMinus i))) +
      a.2 • atomicDensity ρ (polePlus d))

theorem canonicalDensity_representation {ρ : Measure (BarronSphere d)} [IsFiniteMeasure ρ]
    (hρ : CompatibleProbability d ρ) {f : BarronSphere d → ℝ} (hm : Measurable f)
    (hf : Integrable f ρ) :
    ∃ h : Integrable (canonicalDensity ρ f (affineCoefficients d (ofDensity hf))) ρ,
      canonicalProjection d (ofDensity hf) = ofDensity h := by
  obtain ⟨k, _, hk⟩ := hρ.2.1
  have hac : Measure.map (reflection d) ρ ≪ ρ := by
    intro E hE
    refine le_antisymm ((hk E).trans ?_) bot_le
    change k * ρ E ≤ 0
    rw [hE, mul_zero]
  let μ := ofDensity hf
  let a := affineCoefficients d μ
  obtain ⟨hr, he⟩ := reflectedDensity_representation hac hm hf
  have hC : RepresentsDensity ρ ((1 / 2 : ℝ) • ((nonPole d).1.indicator (f + reflectedDensity ρ f)))
      (reflectedEven d μ) := by
    rw [reflectedEven_apply]
    have hcut := (cut (nonPole d)).toLinearMap.map_add μ (pushforward (reflection d) μ)
    rw [← show cut (nonPole d) (μ + pushforward (reflection d) μ) =
      cut (nonPole d) μ + cut (nonPole d) (pushforward (reflection d) μ) from hcut]
    exact representsDensity_smul _ (representsDensity_cut
      (representsDensity_add ⟨hf, rfl⟩ ⟨hr, he.symm⟩) _)
  have hJ : RepresentsDensity ρ
      ((∑ i : Fin d, a.1 i • (atomicDensity ρ (axis i) - atomicDensity ρ (axisMinus i))) +
        a.2 • atomicDensity ρ (polePlus d)) (affineAtoms d a) := by
    rw [affineAtoms_apply]
    refine representsDensity_add (representsDensity_sum (fun i => ?_) Finset.univ)
      (representsDensity_smul _ (representsDensity_atom _ (hρ.2.2.2.1).ne'))
    exact representsDensity_smul _ (representsDensity_sub
      (representsDensity_atom _ (hρ.2.2.1 i).1.ne') (representsDensity_atom _ (hρ.2.2.1 i).2.ne'))
  obtain ⟨h, hh⟩ := representsDensity_add hC hJ
  exact ⟨h, hh.symm⟩

#print axioms BarronSphere.canonicalDensity_representation


private theorem measure_absContinuous_of_boundedDomination {ρ ν : Measure (BarronSphere d)}
    {k : ℝ≥0∞} (h : ν ≤ k • ρ) : ν ≪ ρ := by
  intro E hE
  refine le_antisymm ((h E).trans ?_) bot_le
  change k * ρ E ≤ 0
  rw [hE, mul_zero]

private theorem reflectedDensity_bound {ρ : Measure (BarronSphere d)} [IsProbabilityMeasure ρ]
    {k : ℝ≥0∞} (hkfin : k < ∞) (hk : Measure.map (reflection d) ρ ≤ k • ρ)
    {f : BarronSphere d → ℝ} {M : ℝ} (_hM : 0 ≤ M) (hf : ∀ᵐ θ ∂ρ, ‖f θ‖ ≤ M) :
    ∀ᵐ θ ∂ρ, ‖reflectedDensity ρ f θ‖ ≤ k.toReal * M := by
  let ν := Measure.map (reflection d) ρ
  have hac : ν ≪ ρ := measure_absContinuous_of_boundedDomination hk
  have hRN : ∀ᵐ θ ∂ρ, ν.rnDeriv ρ θ ≤ k := by
    apply ae_le_of_forall_setLIntegral_le_of_sigmaFinite (ν.measurable_rnDeriv ρ)
    intro E hE _
    have hm := hk E
    change ν E ≤ k * ρ E at hm
    rw [← Measure.withDensity_rnDeriv_eq ν ρ hac, withDensity_apply _ hE] at hm
    simpa only [lintegral_const, Measure.restrict_apply_univ, MeasurableSet.univ] using hm
  have hr := ae_of_ae_map (reflection d).measurable.aemeasurable (hac.ae_le hf)
  filter_upwards [hRN, hr] with θ hθ hrf
  change ‖(ν.rnDeriv ρ θ).toReal * f (reflection d θ)‖ ≤ k.toReal * M
  rw [norm_mul, Real.norm_of_nonneg ENNReal.toReal_nonneg]
  exact mul_le_mul (ENNReal.toReal_mono hkfin.ne hθ) hrf (norm_nonneg _) ENNReal.toReal_nonneg

private theorem signedIntegral_cut_ofDensity (b : boundedMeasurableAlgebra (BarronSphere d))
    (E : MeasSet (BarronSphere d)) {ρ : Measure (BarronSphere d)} {f : BarronSphere d → ℝ}
    (hf : Integrable f ρ) :
    signedIntegral b (cut E (ofDensity hf)) = ∫ θ in E.1, b.1 θ * f θ ∂ρ := by
  rw [signedIntegral_cut, signedIntegral_ofDensity, ← integral_indicator E.2]
  apply integral_congr_ae
  filter_upwards with θ
  change b.1 θ * (measurableIndicator E).1 θ * f θ = E.1.indicator (fun t => b.1 t * f t) θ
  rw [measurableIndicator_apply]
  by_cases h : θ ∈ E.1
  · rw [indicator_of_mem h, indicator_of_mem h, mul_one]
  · rw [indicator_of_notMem h, indicator_of_notMem h, mul_zero, zero_mul]

private theorem moment_cut_bound {ρ : Measure (BarronSphere d)} [IsProbabilityMeasure ρ]
    {f : BarronSphere d → ℝ} (hf : Integrable f ρ) {M : ℝ} (hM : 0 ≤ M)
    (hB : ∀ᵐ θ ∂ρ, ‖f θ‖ ≤ M) (b : boundedMeasurableAlgebra (BarronSphere d))
    (hb : ∀ θ, ‖b.1 θ‖ ≤ 1) :
    ‖signedIntegral b (cut (nonPole d) (ofDensity hf))‖ ≤ M := by
  rw [signedIntegral_cut_ofDensity]
  refine (norm_setIntegral_le_of_norm_le_const_ae (C := M) (measure_lt_top ρ _) ?_).trans ?_
  · apply (Measure.absolutelyContinuous_of_le Measure.restrict_le_self).ae_le
    filter_upwards [hB] with θ hθ
    rw [norm_mul]
    exact (mul_le_of_le_one_left (norm_nonneg _) (hb θ)).trans hθ
  · have he : ρ.real (nonPole d).1 ≤ 1 := by
      change (ρ (nonPole d).1).toReal ≤ 1
      calc
        _ ≤ (ρ univ).toReal := ENNReal.toReal_mono (measure_ne_top ρ _) (measure_mono (subset_univ _))
        _ = 1 := by rw [measure_univ, ENNReal.toReal_one]
    exact mul_le_of_le_one_right hM he

private theorem affineCoefficients_density_bound {ρ : Measure (BarronSphere d)} [IsProbabilityMeasure ρ]
    {f : BarronSphere d → ℝ} (hf : Integrable f ρ) {M : ℝ} (hM : 0 ≤ M)
    (hB : ∀ᵐ θ ∂ρ, ‖f θ‖ ≤ M) :
    let a := affineCoefficients d (ofDensity hf)
    (∀ i, ‖a.1 i‖ ≤ M / 2) ∧ ‖a.2‖ ≤ M / 2 + M * (ρ {polePlus d}).toReal := by
  dsimp only
  rw [affineCoefficients_apply]
  have hm' : ‖(1 / 2 : ℝ)‖ = 1 / 2 := by norm_num
  constructor
  · intro i
    change ‖(1 / 2 : ℝ) * signedIntegral (weightSymbol i) (cut (nonPole d) (ofDensity hf))‖ ≤ _
    rw [norm_mul, hm']
    have h := moment_cut_bound hf hM hB (weightSymbol i) (fun θ => norm_weight_le θ i)
    linarith
  · change ‖(1 / 2 : ℝ) * signedIntegral (biasSymbol d) (cut (nonPole d) (ofDensity hf)) +
      eval ⟨{polePlus d}, measurableSet_singleton _⟩ (ofDensity hf)‖ ≤ _
    refine (norm_add_le ..).trans ?_
    rw [norm_mul, hm', eval_ofDensity]
    have h := moment_cut_bound hf hM hB (biasSymbol d) norm_bias_le
    have he := norm_setIntegral_le_of_norm_le_const_ae (measure_lt_top ρ {polePlus d})
      ((Measure.absolutelyContinuous_of_le Measure.restrict_le_self).ae_le hB :
        ∀ᵐ θ ∂ρ.restrict {polePlus d}, ‖f θ‖ ≤ M)
    have he' : ‖∫ θ in {polePlus d}, f θ ∂ρ‖ ≤ M * (ρ {polePlus d}).toReal := he
    linarith

