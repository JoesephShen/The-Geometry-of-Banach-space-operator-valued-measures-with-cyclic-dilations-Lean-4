/-- Shrinking passes to an invariant subspace by extending each functional
via Hahn–Banach and restricting the norm-convergent adjoint series. -/
theorem PVM.shrinking_restrict [CompleteSpace X] (P : PVM Ω X) (Y : Submodule ℝ X)
    (_hY : IsClosed (Y : Set X)) (hi : P.Invariant Y) (hs : P.toOVM.Shrinking) :
    (P.restrict Y hi).toOVM.Shrinking := by
  intro A hA f
  obtain ⟨g, hg, _⟩ := exists_extension_norm_eq Y f
  let R : Dual X →L[ℝ] Dual Y := (ContinuousLinearMap.compL ℝ Y X ℝ).flip Y.subtypeL
  have he (E : MeasSet Ω) : R (adjoint (P.val E) g) =
      adjoint ((P.restrict Y hi).val E) f := by
    ext y
    exact hg ⟨P.val E y, hi E y y.2⟩
  have ht := hs A hA g
  unfold HasSum at ht ⊢
  simpa only [Function.comp_def, map_sum, he] using (R.continuous.tendsto _).comp ht


/-- Manuscript, cor:local-representation-james (1). -/
theorem PVM.shrinking_james_of_countable_cover [CompleteSpace X] (P : PVM Ω X)
    (hP : ∀ s : Set X, s.Countable → ∃ (Y : Submodule ℝ X) (_hY : IsClosed (Y : Set X))
      (hi : P.Invariant Y), s ⊆ Y ∧ (P.restrict Y hi).Localizes) :
    P.toOVM.Shrinking ↔ ¬ ContainsCopy LOne X := by
  refine ⟨fun hs h => ?_, P.toOVM.shrinking_of_not_contains_lOne⟩
  obtain ⟨A, c, hc, hl⟩ := h
  obtain ⟨Y, hY, hi, hcover, hloc⟩ := hP (Set.range fun n => A (lOneUnit n))
    (Set.countable_range _)
  have hr (a : LOne) : A a ∈ Y := by
    have hsum := A.hasSum (lp.hasSum_single (by simp : (1 : ℝ≥0∞) ≠ ⊤) a)
    apply hY.mem_of_tendsto hsum
    apply Eventually.of_forall
    intro s
    apply Submodule.sum_mem
    intro n _
    have he : (lp.single 1 n (a n) : LOne) = a n • lOneUnit n := by
      ext j
      by_cases hj : j = n
      · subst j
        simp [lOneUnit, lp.single_apply, lp.coeFn_smul]
      · change (lp.single 1 n (a n) : LOne) j = a n * lOneUnit n j
        simp [lOneUnit, lp.single_apply, Pi.single_eq_of_ne hj]
    rw [he, map_smul]
    exact Y.smul_mem _ (hcover (Set.mem_range_self n))
  exact (P.restrict Y hi).not_contains_lOne_of_shrinking hloc (P.shrinking_restrict Y hY hi hs)
    ⟨A.codRestrict Y hr, c, hc, hl⟩

/-- The embedding in any dilation preserves closed isomorphic copies. -/
theorem Dilation.containsCopy_of_underlying {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E] {μ : OVM Ω X} (D : Dilation μ Z)
    (h : ContainsCopy E X) : ContainsCopy E Z := by
  obtain ⟨A, c, hc, hl⟩ := h
  have hS : 0 < ‖D.S‖ + 1 := by positivity
  refine ⟨D.T.comp A, c / (‖D.S‖ + 1), div_pos hc hS, fun x => ?_⟩
  have hST : D.S (D.T (A x)) = A x := congrArg (fun R : X →L[ℝ] X => R (A x)) D.split
  have hnorm := (D.S.le_opNorm (D.T (A x))).trans
    (mul_le_mul_of_nonneg_right (show ‖D.S‖ ≤ ‖D.S‖ + 1 by linarith) (norm_nonneg _))
  rw [hST] at hnorm
  change c / (‖D.S‖ + 1) * ‖x‖ ≤ ‖D.T (A x)‖
  rw [div_mul_eq_mul_div, div_le_iff₀ hS, mul_comm (‖D.T (A x)‖)]
  exact (hl x).trans hnorm

/-- Manuscript, thm:dilation-geometry (1), necessity for a shrinking cyclic dilation. -/
theorem Dilation.not_contains_lOne_of_shrinking_cyclic [CompleteSpace Z]
    {μ : OVM Ω X} (D : Dilation μ Z) (hc : D.P.Cyclic) (hs : D.P.toOVM.Shrinking) :
    ¬ ContainsCopy LOne X := fun h =>
  D.P.not_contains_lOne_of_shrinking (D.P.localizes_of_cyclic hc) hs
    (D.containsCopy_of_underlying h)

/-- Manuscript, thm:dilation-geometry (2), necessity for a boundedly complete cyclic dilation. -/
theorem Dilation.not_contains_cZero_of_boundedlyComplete_cyclic [CompleteSpace Z]
    {μ : OVM Ω X} (D : Dilation μ Z) (hc : D.P.Cyclic) (hb : D.P.BoundedlyComplete) :
    ¬ ContainsCopy CZero X := fun h =>
  ((D.P.boundedlyComplete_james (D.P.localizes_of_cyclic hc)).1.mp hb)
    (D.containsCopy_of_underlying h)

/-- Manuscript, thm:dilation-geometry (3), necessity for every reflexive dilation. -/
theorem Dilation.reflexive_of_reflexive_space {μ : OVM Ω X} (D : Dilation μ Z)
    (hZ : IsReflexive Z) : IsReflexive X := by
  intro ξ
  obtain ⟨z, hz⟩ := hZ (secondAdjoint D.T ξ)
  refine ⟨D.S z, ?_⟩
  rw [← secondAdjoint_canonical, hz, secondAdjoint_comp, D.split]
  ext f
  rfl

