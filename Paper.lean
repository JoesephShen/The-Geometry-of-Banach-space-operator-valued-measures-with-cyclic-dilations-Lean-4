namespace Paper

noncomputable section SectionSevenHaar

open MeasureTheory Set Filter
open scoped ENNReal Topology

def dyadicInitial (n : ℕ) : MeasSet ℝ :=
  ⟨Ico 0 ((1/2 : ℝ)^n), measurableSet_Ico⟩

private theorem dyadicInitial_antitone : Antitone (fun n => (dyadicInitial n).1) := by
  apply antitone_nat_of_succ_le
  intro n t ht
  have hn : (1/2 : ℝ)^(n+1) ≤ (1/2 : ℝ)^n := by
    rw [pow_succ]
    exact mul_le_of_le_one_right (by positivity) (by norm_num)
  exact ⟨ht.1,ht.2.trans_le hn⟩

private theorem dyadicInitial_measure (n : ℕ) :
    lebesgueUnitInterval.real (dyadicInitial n).1 = (1/2 : ℝ)^n := by
  have hs : Ico 0 ((1/2 : ℝ)^n) ⊆ Icc (0:ℝ) 1 := by
    intro t ht
    have hn : (1/2 : ℝ)^n ≤ 1 := pow_le_one₀ (by norm_num) (by norm_num)
    exact ⟨ht.1,ht.2.le.trans hn⟩
  change (lebesgueUnitInterval (Ico 0 ((1/2 : ℝ)^n))).toReal = _
  rw [lebesgueUnitInterval,Measure.restrict_apply measurableSet_Ico,inter_eq_left.mpr hs,
    Real.volume_Ico,sub_zero,ENNReal.toReal_ofReal (by positivity)]

def haarLeft (n : ℕ) (t : ℝ) : ℝ :=
  2 * (dyadicInitial (n+1)).1.indicator (fun _ => (1 : ℝ)) t -
    (dyadicInitial n).1.indicator (fun _ => 1) t

theorem haarLeft_eq (n : ℕ) (t : ℝ) :
    haarLeft n t =
      (dyadicInitial (n+1)).1.indicator (fun _ => (1 : ℝ)) t -
      (Ico ((1/2 : ℝ)^(n+1)) ((1/2 : ℝ)^n)).indicator (fun _ => (1 : ℝ)) t := by
  unfold haarLeft
  by_cases hb : t ∈ (dyadicInitial (n+1)).1
  · have ha := dyadicInitial_antitone (Nat.le_succ n) hb
    have hr : t ∉ Ico ((1/2 : ℝ)^(n+1)) ((1/2 : ℝ)^n) := fun hr => (not_lt_of_ge hr.1) hb.2
    rw [indicator_of_mem hb,indicator_of_mem ha,indicator_of_notMem hr]
    norm_num
  · by_cases ha : t ∈ (dyadicInitial n).1
    · have hleft : (1/2 : ℝ)^(n+1) ≤ t := by
        apply le_of_not_gt
        intro ht
        exact hb ⟨ha.1,ht⟩
      have hr : t ∈ Ico ((1/2 : ℝ)^(n+1)) ((1/2 : ℝ)^n) := ⟨hleft,ha.2⟩
      rw [indicator_of_notMem hb,indicator_of_mem ha,indicator_of_mem hr]
      norm_num
    · have hr : t ∉ Ico ((1/2 : ℝ)^(n+1)) ((1/2 : ℝ)^n) := fun hr =>
        ha ⟨(show 0 ≤ (1/2 : ℝ)^(n+1) by positivity).trans hr.1,hr.2⟩
      rw [indicator_of_notMem hb,indicator_of_notMem ha,indicator_of_notMem hr]
      norm_num

private theorem alternating_prefix_le_one (N : ℕ) :
    |∑ n ∈ Finset.range N, (-1:ℝ)^n| ≤ 1 := by
  have hs : (∑ n ∈ Finset.range N, (-1:ℝ)^n) * (-2) = (-1:ℝ)^N - 1 := by
    convert geom_sum_mul (-1:ℝ) N using 1; norm_num
  have ha : |(-1:ℝ)^N| ≤ 1 := by rw [abs_pow]; norm_num
  have hl := (abs_le.mp ha).1
  have hh := (abs_le.mp ha).2
  exact abs_le.mpr ⟨by linarith,by linarith⟩

theorem haarLeft_sign_bound (N : ℕ) (t : ℝ) :
    |∑ n ∈ Finset.range N, (-1 : ℝ)^n * haarLeft n t| ≤ 2 := by
  classical
  by_cases hN : t ∈ (dyadicInitial N).1
  · have he (i : ℕ) (hi : i ∈ Finset.range N) : haarLeft i t = 1 := by
      have hij : i+1 ≤ N := Nat.succ_le_of_lt (Finset.mem_range.mp hi)
      have h1 := dyadicInitial_antitone hij hN
      have h0 := dyadicInitial_antitone (Nat.le_succ i) h1
      rw [haarLeft,indicator_of_mem h0,indicator_of_mem h1]
      norm_num
    have hs : (∑ n ∈ Finset.range N, (-1:ℝ)^n * haarLeft n t) =
        ∑ n ∈ Finset.range N, (-1:ℝ)^n := Finset.sum_congr rfl (fun i hi => by rw [he i hi,mul_one])
    rw [hs]
    exact (alternating_prefix_le_one N).trans (by norm_num)
  · let k := Nat.find (show ∃ n, t ∉ (dyadicInitial n).1 from ⟨N,hN⟩)
    have hk : t ∉ (dyadicInitial k).1 := Nat.find_spec (show ∃ n, t ∉ (dyadicInitial n).1 from ⟨N,hN⟩)
    have hkN : k ≤ N := Nat.find_min' _ hN
    have ht (i : ℕ) (hi : i < k) : t ∈ (dyadicInitial i).1 := by
      by_contra h
      have ht := Nat.find_min' (show ∃ n, t ∉ (dyadicInitial n).1 from ⟨N,hN⟩) h
      exact (not_le_of_gt hi) ht
    have hzero (i : ℕ) (hi : k ≤ i) : haarLeft i t = 0 := by
      have hn : t ∉ (dyadicInitial i).1 := fun h => hk (dyadicInitial_antitone hi h)
      have hm : t ∉ (dyadicInitial (i+1)).1 := fun h => hk (dyadicInitial_antitone (hi.trans (Nat.le_succ i)) h)
      simp [haarLeft,hn,hm]
    have hs : (∑ n ∈ Finset.range N, (-1:ℝ)^n * haarLeft n t) =
        ∑ n ∈ Finset.range k, (-1:ℝ)^n * haarLeft n t := by
      symm
      apply Finset.sum_subset (Finset.range_mono hkN)
      intro i _ hi
      rw [hzero i (Nat.le_of_not_gt (fun h => hi (Finset.mem_range.mpr h))),mul_zero]
    rw [hs]
    cases hk' : k with
    | zero => simp
    | succ j =>
      have hp (i : ℕ) (hi : i ∈ Finset.range j) : haarLeft i t = 1 := by
        have hi' := Finset.mem_range.mp hi
        have h1 := ht (i+1) (by omega : i+1 < k)
        have h0 := dyadicInitial_antitone (Nat.le_succ i) h1
        rw [haarLeft,indicator_of_mem h0,indicator_of_mem h1]
        norm_num
      have hn : haarLeft j t = -1 := by
        have h0 := ht j (by omega)
        have h1 : t ∉ (dyadicInitial (j+1)).1 := by simpa only [hk'] using hk
        rw [haarLeft,indicator_of_notMem h1,indicator_of_mem h0]
        norm_num
      rw [Finset.sum_range_succ,hn]
      have he : (∑ i ∈ Finset.range j, (-1:ℝ)^i * haarLeft i t) =
          ∑ i ∈ Finset.range j, (-1:ℝ)^i := Finset.sum_congr rfl (fun i hi => by rw [hp i hi,mul_one])
      rw [he]
      refine (abs_add_le _ _).trans ?_
      have h := alternating_prefix_le_one j
      have hm : |(-1:ℝ)^j * (-1)| = 1 := by simp only [abs_mul,abs_pow,abs_neg,abs_one,one_pow,mul_one]
      rw [hm]
      linarith

namespace ExponentialHeartModel

variable {G : Type} [NormedAddCommGroup G] [NormedSpace ℝ G]
variable (H : ExponentialHeartModel G)

def haarVector (H : ExponentialHeartModel G) (n : ℕ) : G :=
  (2:ℝ) • H.indicator (dyadicInitial (n+1)) - H.indicator (dyadicInitial n)

theorem repr_haarVector (n : ℕ) :
    (⇑(H.realization.repr (H.haarVector n))) =ᵐ[lebesgueUnitInterval] haarLeft n := by
  rw [haarVector,map_sub,map_smul]
  let x := H.realization.repr (H.indicator (dyadicInitial (n+1)))
  let y := H.realization.repr (H.indicator (dyadicInitial n))
  filter_upwards [AEEqFun.coeFn_sub ((2:ℝ) • x) y,AEEqFun.coeFn_smul (2:ℝ) x,
    H.indicator_ae (dyadicInitial (n+1)),H.indicator_ae (dyadicInitial n)] with t ht hx h1 h0
  change ((2:ℝ) • x - y) t = _
  rw [ht]
  change ((2:ℝ) • x) t - y t = _
  rw [hx]
  change 2 * x t - y t = _
  change x t = _ at h1
  change y t = _ at h0
  rw [h1,h0]
  rfl

theorem repr_haar_sum (s : ℕ → ℝ) (N : ℕ) :
    (⇑(H.realization.repr (∑ n ∈ Finset.range N, s n • H.haarVector n))) =ᵐ[lebesgueUnitInterval]
      fun t => ∑ n ∈ Finset.range N, s n * haarLeft n t := by
  induction N with
  | zero =>
    simp only [Finset.range_zero,Finset.sum_empty,map_zero]
    filter_upwards [AEEqFun.coeFn_zero (α := ℝ) (β := ℝ) (μ := lebesgueUnitInterval)] with t ht
    exact ht
  | succ n ih =>
    simp only [Finset.sum_range_succ,map_add,map_smul]
    let x := H.realization.repr (∑ i ∈ Finset.range n, s i • H.haarVector i)
    let y := H.realization.repr (H.haarVector n)
    filter_upwards [AEEqFun.coeFn_add x (s n • y),AEEqFun.coeFn_smul (s n) y,ih,H.repr_haarVector n]
      with t ht hy hi hn
    change (x + s n • y) t = _
    rw [ht]
    change x t + (s n • y) t = _
    rw [hy]
    change x t + s n * y t = _
    change x t = _ at hi
    change y t = _ at hn
    rw [hi,hn]

theorem haar_alternating_norm (N : ℕ) :
    ‖∑ n ∈ Finset.range N, (-1:ℝ)^n • H.haarVector n‖ ≤ 2 * ‖H.one‖ := by
  let z := ∑ n ∈ Finset.range N, (-1:ℝ)^n • H.haarVector n
  have hconst : H.one ≠ 0 := by
    intro h
    have h1 := H.one_ae
    rw [h,map_zero] at h1
    have he : ∀ᵐ t ∂lebesgueUnitInterval, (0:ℝ) = 1 := by
      filter_upwards [h1,AEEqFun.coeFn_zero (α := ℝ) (β := ℝ) (μ := lebesgueUnitInterval)] with t h₁ h₀
      exact h₀.symm.trans h₁
    exact zero_ne_one he.exists.choose_spec
  have hc : 0 < ‖H.one‖ := norm_pos_iff.mpr hconst
  apply (H.norm_iff z (2 * ‖H.one‖) (by positivity)).mpr
  refine le_trans ?_ ((H.norm_iff H.one _ hc).mp le_rfl)
  apply integral_mono_ae (H.modular_integrable z (by positivity)) (H.modular_integrable H.one hc)
  filter_upwards [H.repr_haar_sum (fun n => (-1:ℝ)^n) N,H.one_ae] with t ht h1
  change exponentialYoung (|H.realization.repr z t| / (2 * ‖H.one‖)) ≤ _
  rw [ht,h1,abs_one]
  apply exponentialYoung_mono (by positivity)
  apply (div_le_div_iff₀ (by positivity) hc).mpr
  have h := mul_le_mul_of_nonneg_right (haarLeft_sign_bound N t) hc.le
  linarith

theorem haar_positive_norm (N : ℕ) (hN : 0 < N) :
    (N:ℝ) / Real.sqrt (Real.log (1 + (2 : ℝ)^N)) ≤ ‖∑ n ∈ Finset.range N, H.haarVector n‖ := by
  have hm : lebesgueUnitInterval.real (dyadicInitial N).1 = (1/2 : ℝ)^N := dyadicInitial_measure N
  have he : 1 / lebesgueUnitInterval.real (dyadicInitial N).1 = (2:ℝ)^N := by
    rw [hm,one_div,← inv_pow]
    norm_num
  let z := ∑ n ∈ Finset.range N, H.haarVector n
  have hh : ∀ᵐ t ∂lebesgueUnitInterval, t ∈ (dyadicInitial N).1 → (N:ℝ) ≤ |H.realization.repr z t| := by
    have hr := H.repr_haar_sum (fun _ => (1:ℝ)) N
    simp only [one_smul,one_mul] at hr
    filter_upwards [hr] with t ht h
    rw [ht]
    have hs : ∑ n ∈ Finset.range N, haarLeft n t = N := by
      have h1 (i : ℕ) (hi : i ∈ Finset.range N) : haarLeft i t = 1 := by
        have hb := dyadicInitial_antitone (Nat.succ_le_of_lt (Finset.mem_range.mp hi)) h
        have ha := dyadicInitial_antitone (Nat.le_succ i) hb
        rw [haarLeft,indicator_of_mem ha,indicator_of_mem hb]
        norm_num
      rw [Finset.sum_congr rfl h1]
      simp
    rw [hs,abs_of_nonneg (by positivity)]
  have hh' := H.norm_lower_on_set z (dyadicInitial N) (N:ℝ) (by exact_mod_cast hN)
    (by rw [hm]; positivity) hh
  rwa [he] at hh'

end ExponentialHeartModel

