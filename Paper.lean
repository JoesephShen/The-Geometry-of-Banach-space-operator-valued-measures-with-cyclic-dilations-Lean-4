noncomputable section SectionSevenSummary

open MeasureTheory Set
open scoped ENNReal

def HasContinuousFrame (X : Type) [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X] : Prop :=
  ∃ (Ω : Type) (_ : MeasurableSpace Ω) (ρ : Measure Ω) (_ : SigmaFinite ρ),
    Nonempty (ContinuousSchauderFrame (X := X) ρ)

/-- The four columns of the manuscript's summary table. -/
def SectionSevenRow {Ω X : Type} [MeasurableSpace Ω] [NormedAddCommGroup X]
    [NormedSpace ℝ X] [CompleteSpace X] (P : PVM Ω X) (s b m f : Bool) : Prop :=
  (P.toOVM.Shrinking ↔ s = true) ∧ (P.BoundedlyComplete ↔ b = true) ∧
    (P.HasFiniteMultiplicity ↔ m = true) ∧ (HasContinuousFrame X ↔ f = true)

def NoBanachLatticeIsomorphism (X : Type) [NormedAddCommGroup X] [NormedSpace ℝ X] : Prop :=
  ∀ (Z : Type) [NormedAddCommGroup Z] [NormedSpace ℝ Z] [CompleteSpace Z],
    HasBanachLatticeOrder Z → ¬ Nonempty (X ≃L[ℝ] Z)

theorem sectionSeven_L1_row : SectionSevenRow intervalL1PVM false true true false := by
  have hframe : ¬ HasContinuousFrame IntervalL1 := fun ⟨_,_,ρ,_,F⟩ =>
    intervalL1_no_continuousFrame ρ F
  simp [SectionSevenRow,intervalL1_not_shrinking,intervalL1_boundedlyComplete_disjoint,
    intervalL1PVM.finiteMultiplicity_of_finitelyGenerated intervalL1_finitelyGenerated,hframe]

theorem sectionSeven_Orlicz_row {G : Type} [NormedAddCommGroup G] [NormedSpace ℝ G] [CompleteSpace G]
    (H : ExponentialHeartModel G) : SectionSevenRow H.P true false true false := by
  have hframe : ¬ HasContinuousFrame G := fun ⟨_,_,ρ,_,F⟩ => H.no_continuousFrame ρ F
  simp [SectionSevenRow,H.shrinking exponentialComplement_deltaTwo,H.not_boundedlyComplete,
    H.P.finiteMultiplicity_of_finitelyGenerated H.finitelyGenerated,hframe]

theorem sectionSeven_Orlicz_example :
    ∃ O : ExponentialHeartExists,
      let := O.group
      let := O.space
      let := O.complete
      SectionSevenRow O.model.P true false true false := by
  obtain ⟨O⟩ := citeLindenstraussTzafririExponentialHeart
  let : NormedAddCommGroup O.carrier := O.group
  let : NormedSpace ℝ O.carrier := O.space
  let : CompleteSpace O.carrier := O.complete
  exact ⟨O,sectionSeven_Orlicz_row O.model⟩

private theorem sectionSeven_HI_obstructions {X Y : Type}
    [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X] [TopologicalSpace.SeparableSpace X]
    [NormedAddCommGroup Y] [NormedSpace ℝ Y] [CompleteSpace Y]
    (hYi : ¬ FiniteDimensional ℝ Y) (hY : ¬ HasUnconditionalBasicSequence Y)
    (h : IsComplementedIn Y X) :
    NoBanachLatticeIsomorphism X ∧ ¬ HasContinuousFrame X := by
  refine ⟨no_lattice_equiv_of_complemented_HI hYi hY h,?_⟩
  intro ⟨_,_,ρ,_,F⟩
  exact no_continuousFrame_of_no_unconditional ρ (no_unconditionalFrame_of_complemented_HI hYi hY h) F

theorem sectionSeven_Ferenczi_examples (F : FerencziSpace) :
    let := F.group
    let := F.space
    let := F.complete
    let Y := F.carrier
    SectionSevenRow (vectorCZeroCoordinates (Y := Y)).pvm true false false false ∧
    SectionSevenRow (vectorOneCoordinates Y).pvm false true false false ∧
    SectionSevenRow (vectorTwoCoordinates Y).pvm true true false false ∧
    NoBanachLatticeIsomorphism (VectorCZero Y) ∧
    NoBanachLatticeIsomorphism (VectorLp Y 1) ∧
