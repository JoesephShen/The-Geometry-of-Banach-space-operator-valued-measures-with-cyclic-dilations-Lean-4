/-- Manuscript, prop:minimal-cyclic, nontrivial direction. -/
theorem Dilation.cyclic_alphaPVM [CompleteSpace X] [CompleteSpace Z]
    {μ : OVM Ω X} (D : Dilation μ Z) (hD : D.P.Cyclic) : μ.alphaPVM.Cyclic := by
  obtain ⟨u, hu⟩ := hD
  obtain ⟨_, _, v, _, hv⟩ := D.P.invariant_eq_projection_range hu D.generatedSubmodule
    (Submodule.span ℝ D.generatedSpan).isClosed_topologicalClosure D.generated_invariant
  exact ⟨D.alphaComparison v,
    (D.P.restrict D.generatedSubmodule D.generated_invariant).cyclicVector_of_dense_intertwining
      μ.alphaPVM D.alphaComparison D.alphaComparison_intertwines D.alphaComparison_denseRange hv⟩

/-- The minimal dilation itself realizes the converse in prop:minimal-cyclic. -/
theorem OVM.cyclic_alphaDilation [CompleteSpace X] (μ : OVM Ω X) (hμ : μ.Normalized)
    (hP : μ.alphaPVM.Cyclic) : (μ.alphaDilation hμ).P.Cyclic := hP

