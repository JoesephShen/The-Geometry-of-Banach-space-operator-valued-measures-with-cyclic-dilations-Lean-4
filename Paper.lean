/-- The map from a local quotient by affine functions into the global quotient. -/
def localAffineToGlobal (hd : 1 ≤ d) (ρ : BarronControl d)
    {p : ℝ≥0∞} [Fact (1 ≤ p)] (hp : p ≠ ⊤) :
    BarronLocalAffineQuotient hd ρ hp →L[ℝ] BarronAffineQuotient hd := by
  let Q := barronStage hd ρ p hp
  let W := foldStage hd ρ hp
  let q := (evenPart hd).ker.mkQL
  refine W.ker.liftQL (q.comp Q.inclusion) ?_
  intro z hz
  change q (Q.inclusion z) = 0
  apply (Submodule.Quotient.mk_eq_zero (evenPart hd).ker).mpr
  exact (foldStage_kernel hd ρ hp z).mp hz

theorem affineQuotient_symmetricStages_cover (hd : 1 ≤ d) (y : BarronAffineQuotient hd) :
    ∃ ρ : BarronControl d, Measure.map (reflection d) ρ.1 = ρ.1 ∧
      ∃ z : BarronLocalAffineQuotient hd ρ (p := 1) ENNReal.one_ne_top,
        localAffineToGlobal hd ρ ENNReal.one_ne_top z = y := by
  obtain ⟨x, rfl⟩ := (evenPart hd).ker.mkQ_surjective y
  obtain ⟨ρ, hρ, hz⟩ := exists_symmetricCommonStages hd (fun _ => x) (p := 1) ENNReal.one_ne_top
  obtain ⟨z, hz⟩ := hz 0
  refine ⟨ρ, hρ, Submodule.Quotient.mk z, ?_⟩
  change (Submodule.Quotient.mk ((barronStage hd ρ 1 ENNReal.one_ne_top).inclusion z) :
    BarronAffineQuotient hd) = Submodule.Quotient.mk x
  rw [hz]

theorem affineQuotient_symmetricStages_finalTopology (hd : 1 ≤ d) (q : Seminorm ℝ (BarronAffineQuotient hd)) :
    Continuous q ↔ ∀ ρ : BarronControl d, Measure.map (reflection d) ρ.1 = ρ.1 →
      Continuous (fun z : BarronLocalAffineQuotient hd ρ (p := 1) ENNReal.one_ne_top =>
        q (localAffineToGlobal hd ρ ENNReal.one_ne_top z)) := by
  constructor
  · intro h ρ _
    exact h.comp (localAffineToGlobal hd ρ ENNReal.one_ne_top).continuous
  · intro h
    apply ((evenPart hd).ker.isQuotientMap_mkQL.continuous_iff).mpr
    let q₀ := q.comp (evenPart hd).ker.mkQL.toLinearMap
    change Continuous q₀
    apply (barronStage_finalTopology hd 1 ENNReal.one_ne_top q₀).mpr
    intro η
    obtain ⟨ρ, hρ, hdom⟩ := exists_symmetricControl_upper η
    let Q := barronStage hd η 1 ENNReal.one_ne_top
    let Q' := barronStage hd ρ 1 ENNReal.one_ne_top
    obtain ⟨j, hj, _, _, _, hInc, _, _⟩ := barronStage_connecting hd η ρ 1 ENNReal.one_ne_top 2
      (by norm_num) (by simpa using hdom)
    let I := Q.connectingMap Q' j hj
    let cq := (foldStage hd ρ (p := 1) ENNReal.one_ne_top).ker.mkQL
    have hcomp := (h ρ hρ).comp (cq.comp I).continuous
    have he : (fun z : Q.Quotient => q (localAffineToGlobal hd ρ ENNReal.one_ne_top (cq (I z)))) =
        (fun z : Q.Quotient => q₀ (Q.inclusion z)) := by
      funext z
      have hz := hInc z
      change Q'.inclusion (I z) = Q.inclusion z at hz
      change q ((evenPart hd).ker.mkQL (Q'.inclusion (I z))) =
        q ((evenPart hd).ker.mkQL (Q.inclusion z))
      rw [hz]
    exact he ▸ hcomp

theorem hyperplaneL1_cyclic_one (hd : 1 ≤ d) (ρ : BarronControl d) :
    Dense (Submodule.span ℝ (Set.range (fun E : MeasSet (BarronHyperplanes d) =>
      indicatorConstLp (1 : ℝ≥0∞) E.2 (measure_ne_top (hyperplaneMeasure hd ρ.1) E.1) (1 : ℝ))) :
      Set (Lp ℝ 1 (hyperplaneMeasure hd ρ.1))) := by
  let ν := hyperplaneMeasure hd ρ.1
  let u (E : MeasSet (BarronHyperplanes d)) :=
    indicatorConstLp (1 : ℝ≥0∞) E.2 (measure_ne_top ν E.1) (1 : ℝ)
  let W := Submodule.span ℝ (Set.range u)
  have hscalar (c : ℝ) (E : MeasSet (BarronHyperplanes d)) :
      indicatorConstLp (1 : ℝ≥0∞) E.2 (measure_ne_top ν E.1) c = c • u E := by
    apply Lp.ext
    filter_upwards [indicatorConstLp_coeFn (p := (1 : ℝ≥0∞)) (hs := E.2)
        (hμs := measure_ne_top ν E.1) (c := c),
      Lp.coeFn_smul c (u E),
      show (fun t => u E t) =ᵐ[ν] E.1.indicator (fun _ => (1 : ℝ)) from indicatorConstLp_coeFn]
      with t h₁ h₂ h₃
    rw [h₁, h₂]
    change E.1.indicator (fun _ => c) t = c • u E t
    rw [h₃]
    by_cases ht : t ∈ E.1 <;> simp [Set.indicator, ht]
  have hsimple (f : Lp.simpleFunc ℝ 1 ν) : (f : Lp ℝ 1 ν) ∈ W := by
    apply Lp.simpleFunc.induction one_ne_zero ENNReal.one_ne_top
      (P := fun f => (f : Lp ℝ 1 ν) ∈ W) _ _ f
    · intro c E hE hEfin
      let A : MeasSet (BarronHyperplanes d) := ⟨E, hE⟩
      change indicatorConstLp (1 : ℝ≥0∞) A.2 (measure_ne_top ν A.1) c ∈ W
      rw [hscalar c A]
      exact W.smul_mem c (Submodule.subset_span ⟨A, rfl⟩)
    · intro f g hf hg hfg hfW hgW
      exact W.add_mem hfW hgW
  change Dense (W : Set (Lp ℝ 1 ν))
  exact (Lp.simpleFunc.dense ENNReal.one_ne_top).mono (fun f hf => hsimple ⟨f, hf⟩)

