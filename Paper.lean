/-- Rosenthal (1974), PNAS 71, 2411–2413, the no-`ℓ¹` direction of the
bounded-sequence dichotomy cited in the manuscript, prop:no-l1-general. -/
axiom citeRosenthal1974 (V : Type*) [NormedAddCommGroup V] [NormedSpace ℝ V]
    [CompleteSpace V] : RosenthalSubsequence V

/-- Manuscript, prop:no-l1-general, following the cited Rosenthal route. -/
theorem OVM.shrinking_of_not_contains_lOne [CompleteSpace X] (μ : OVM Ω X)
    (hX : ¬ ContainsCopy LOne X) : μ.Shrinking :=
  μ.shrinking_of_not_contains_lOne_using_rosenthal (citeRosenthal1974 X) hX

