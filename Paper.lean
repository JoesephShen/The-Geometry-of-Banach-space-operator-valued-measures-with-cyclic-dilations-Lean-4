theorem symmetric_localization_finite_network (hd : 1 ≤ d) (E : MeasSet (BarronSphere d))
    (hE : reflection d ⁻¹' E.1 = E.1) (n : ℕ) (a : Fin n → ℝ) (θ : Fin n → BarronSphere d) :
    cut E (evenPart hd (synthesisQuotient d (∑ i, a i • pointMass (θ i)))) =
      ∑ i, a i • (if θ i ∈ E.1 then evenPart hd (synthesisQuotient d (pointMass (θ i))) else 0) := by
  let R := (cut E).comp ((evenPart hd).comp (synthesisQuotient d))
  change R (∑ i, a i • pointMass (θ i)) = _
  rw [map_sum]
  apply Finset.sum_congr rfl
  intro i _
  rw [map_smul]
  exact congrArg (a i • ·) (symmetric_localization_finite_atom hd E hE (θ i))

