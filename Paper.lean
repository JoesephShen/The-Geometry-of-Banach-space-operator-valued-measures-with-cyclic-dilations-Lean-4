namespace Paper

noncomputable section SectionSevenL1Cuts

open MeasureTheory Set Filter
open scoped ENNReal Topology

def intervalL1Integral : Dual IntervalL1 := by
  let L : IntervalL1 →ₗ[ℝ] ℝ :=
    { toFun := fun x => ∫ t, x t ∂lebesgueUnitInterval
      map_add' := fun x y => by
        change (∫ t, (x + y) t ∂lebesgueUnitInterval) =
          (∫ t, x t ∂lebesgueUnitInterval) + ∫ t, y t ∂lebesgueUnitInterval
        rw [← integral_add (intervalLpOne_integrable x) (intervalLpOne_integrable y)]
        exact integral_congr_ae (Lp.coeFn_add x y)
      map_smul' := fun c x => by
        change (∫ t, (c • x) t ∂lebesgueUnitInterval) = c * ∫ t, x t ∂lebesgueUnitInterval
        rw [← integral_const_mul]
        exact integral_congr_ae (Lp.coeFn_smul c x) }
  refine L.mkContinuous 1 (fun x => ?_)
  change |∫ t, x t ∂lebesgueUnitInterval| ≤ 1 * ‖x‖
  rw [one_mul,intervalNorm_eq_integral]
  exact abs_integral_le_integral_abs

theorem intervalL1Integral_indicator (E : MeasSet ℝ) :
    intervalL1Integral (intervalL1Indicator E) = lebesgueUnitInterval.real E.1 := by
  change (∫ t, intervalL1Indicator E t ∂lebesgueUnitInterval) = _
  have h : (fun t => intervalL1Indicator E t) =ᵐ[lebesgueUnitInterval]
      E.1.indicator (fun _ => (1:ℝ)) := indicatorConstLp_coeFn
  rw [integral_congr_ae h,integral_indicator E.2,setIntegral_const,smul_eq_mul,mul_one]

theorem intervalL1_adjointIntegral_cut_norm (E : MeasSet ℝ)
    (hE : 0 < lebesgueUnitInterval.real E.1) : ‖adjoint (intervalL1PVM.val E) intervalL1Integral‖ = 1 := by
  let f := adjoint (intervalL1PVM.val E) intervalL1Integral
  have hupper : ‖f‖ ≤ 1 := by
    apply ContinuousLinearMap.opNorm_le_bound f zero_le_one
    intro x
    rw [one_mul]
    change |∫ t, intervalL1PVM.val E x t ∂lebesgueUnitInterval| ≤ ‖x‖
    refine abs_integral_le_integral_abs.trans ?_
    rw [intervalNorm_eq_integral]
    apply integral_mono_ae (intervalLpOne_integrable (intervalL1PVM.val E x)).abs (intervalLpOne_integrable x).abs
    filter_upwards [FiniteSignedMeasure.lpCut_ae E x] with t ht
    change |FiniteSignedMeasure.lpCut E x t| ≤ |x t|
    rw [ht]
    by_cases h : t ∈ E.1 <;> simp [h]
  have hfix : intervalL1PVM.val E (intervalL1Indicator E) = intervalL1Indicator E := by
    rw [← intervalL1VectorMeasure_indicator]
    change intervalL1PVM.val E (intervalL1PVM.val E (intervalL1Indicator MeasSet.whole)) = _
    have h := congrArg (fun L : IntervalL1 →L[ℝ] IntervalL1 => L (intervalL1Indicator MeasSet.whole))
      (intervalL1PVM.mul_eq E E)
    rwa [show E.inter E = E from Subtype.ext (Set.inter_self _)] at h
  have hv : f (intervalL1Indicator E) = lebesgueUnitInterval.real E.1 := by
    change intervalL1Integral (intervalL1PVM.val E (intervalL1Indicator E)) = _
    rw [hfix,intervalL1Integral_indicator]
  have hnorm : ‖intervalL1Indicator E‖ = lebesgueUnitInterval.real E.1 := by
    rw [← intervalL1VectorMeasure_indicator,intervalL1VectorMeasure_norm]
  have h := f.le_opNorm (intervalL1Indicator E)
  rw [hv,Real.norm_of_nonneg hE.le,hnorm] at h
  refine le_antisymm hupper ?_
  by_contra! hh
  have hl := mul_lt_mul_of_pos_right hh hE
  linarith

def intervalTail (n : ℕ) : MeasSet ℝ :=
  ⟨Ioo 0 (1 / ((n:ℝ)+1)),measurableSet_Ioo⟩

theorem intervalTail_antitone : Antitone (fun n => (intervalTail n).1) := by
  intro i j hij t ht
  have h : (i:ℝ)+1 ≤ (j:ℝ)+1 := by exact_mod_cast Nat.succ_le_succ hij
  exact ⟨ht.1,ht.2.trans_le (one_div_le_one_div_of_le (by positivity) h)⟩

theorem intervalTail_iInter_empty : (⋂ n, (intervalTail n).1) = ∅ := by
  apply Set.eq_empty_iff_forall_notMem.mpr
  intro t ht
  have h : 0 < t := (Set.mem_iInter.mp ht 0).1
  obtain ⟨n,hn⟩ := exists_nat_gt (1/t)
  have hlt : t < 1/((n:ℝ)+1) := (Set.mem_iInter.mp ht n).2
  have h' := (div_lt_iff₀ h).mp hn
  have h'' := (lt_div_iff₀ (show 0 < (n:ℝ)+1 by positivity)).mp hlt
  nlinarith

theorem intervalTail_measure (n : ℕ) : lebesgueUnitInterval.real (intervalTail n).1 = 1/((n:ℝ)+1) := by
  let r := 1/((n:ℝ)+1)
  have hr : 0 < r := by dsimp [r]; positivity
  have hsub : Ioo 0 r ⊆ Icc (0:ℝ) 1 := by
    intro t ht
    have hr₁ : r ≤ 1 := (div_le_iff₀ (by positivity)).mpr (by
      rw [one_mul]; exact le_add_of_nonneg_left (Nat.cast_nonneg n))
    exact ⟨ht.1.le,ht.2.le.trans hr₁⟩
  change (lebesgueUnitInterval (Ioo 0 r)).toReal = r
  rw [lebesgueUnitInterval, Measure.restrict_apply measurableSet_Ioo,inter_eq_left.mpr hsub,
    Real.volume_Ioo,sub_zero,ENNReal.toReal_ofReal hr.le]

theorem intervalTail_adjoint_norm (n : ℕ) :
    ‖adjoint (intervalL1PVM.val (intervalTail n)) intervalL1Integral‖ = 1 :=
  intervalL1_adjointIntegral_cut_norm _ (by rw [intervalTail_measure]; positivity)

theorem intervalL1_has_vectorIntegration_model :
    ∃ M : VectorMeasureL1Model intervalL1VectorMeasure,
      letI := M.normedGroup
      letI := M.normedScalar
      (∀ y, ‖M.data.integration y‖ = ‖y‖) ∧ Function.Surjective M.data.integration := by
  have hzero : intervalL1VectorMeasure MeasSet.empty = 0 :=
    congrArg (fun L : IntervalL1 →L[ℝ] IntervalL1 => L (intervalL1Indicator MeasSet.whole))
      intervalL1PVM.empty_eq
  obtain ⟨M⟩ := citeVectorMeasureL1 intervalL1VectorMeasure hzero (fun A h =>
    intervalL1PVM.countably_additive A h (intervalL1Indicator MeasSet.whole))
  let : NormedAddCommGroup M.carrier := M.normedGroup
  let : NormedSpace ℝ M.carrier := M.normedScalar
  let : CompleteSpace M.carrier := M.isComplete
  exact ⟨M,intervalL1_vectorIntegration_isometry M.data⟩

#print axioms intervalTail_iInter_empty
#print axioms intervalTail_adjoint_norm
#print axioms intervalL1_has_vectorIntegration_model

end SectionSevenL1Cuts
