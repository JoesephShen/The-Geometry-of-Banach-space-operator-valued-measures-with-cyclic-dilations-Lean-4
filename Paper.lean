open MeasureTheory Set Filter
open scoped ENNReal Topology

abbrev IntervalL1 := Lp ℝ (1 : ℝ≥0∞) lebesgueUnitInterval

def intervalL1PVM : PVM ℝ IntervalL1 :=
  FiniteSignedMeasure.probabilityLpPVM ENNReal.one_ne_top

def intervalL1Indicator (E : MeasSet ℝ) : IntervalL1 :=
  indicatorConstLp 1 E.2 (measure_ne_top _ _) (1 : ℝ)

def intervalL1VectorMeasure (E : MeasSet ℝ) : IntervalL1 :=
  intervalL1PVM.val E (intervalL1Indicator MeasSet.whole)

theorem intervalL1VectorMeasure_indicator (E : MeasSet ℝ) :
    intervalL1VectorMeasure E = intervalL1Indicator E := by
  apply Lp.ext
  filter_upwards [FiniteSignedMeasure.lpCut_ae E (intervalL1Indicator MeasSet.whole),
    (indicatorConstLp_coeFn (p := 1) (hs := (MeasSet.whole : MeasSet ℝ).2)
      (hμs := measure_ne_top lebesgueUnitInterval univ) (c := (1 : ℝ))),
    (indicatorConstLp_coeFn (p := 1) (hs := E.2)
      (hμs := measure_ne_top lebesgueUnitInterval E.1) (c := (1 : ℝ)))] with t hP hu hE
  have he : intervalL1Indicator E t = E.1.indicator (fun _ => (1 : ℝ)) t := hE
  rw [he]
  change FiniteSignedMeasure.lpCut E (intervalL1Indicator MeasSet.whole) t = _
  rw [hP]
  have hu' : intervalL1Indicator MeasSet.whole t = 1 := by
    change (indicatorConstLp 1 MeasurableSet.univ _ (1 : ℝ) : IntervalL1) t = 1
    simpa only [MeasSet.whole, indicator_univ] using hu
  by_cases ht : t ∈ E.1 <;> simp [ht, hu']

theorem intervalL1VectorMeasure_norm (E : MeasSet ℝ) :
    ‖intervalL1VectorMeasure E‖ = lebesgueUnitInterval.real E.1 := by
  rw [intervalL1VectorMeasure_indicator]
  simpa [intervalL1Indicator] using
    (norm_indicatorConstLp (p := (1 : ℝ≥0∞)) (hs := E.2)
      (hμs := measure_ne_top lebesgueUnitInterval E.1) (c := (1 : ℝ))
      one_ne_zero ENNReal.one_ne_top)

theorem intervalL1VectorMeasure_variation (E : MeasSet ℝ)
    (D : ℕ → MeasSet ℝ) (hD : MeasSet.DisjointSeq D) (I : Finset ℕ)
    (hE : MeasSet.finiteUnion D I = E) :
    ∑ n ∈ I, ‖intervalL1VectorMeasure (D n)‖ = lebesgueUnitInterval.real E.1 := by
  simp_rw [intervalL1VectorMeasure_norm]
  have h := congrArg (fun A : MeasSet ℝ => lebesgueUnitInterval A.1) hE
  change lebesgueUnitInterval (⋃ n ∈ I, (D n).1) = _ at h
  rw [measure_biUnion_finset (fun i _ j _ hij => hD hij) (fun n _ => (D n).2)] at h
  rw [Measure.real, ← h, ENNReal.toReal_sum (fun n _ => measure_ne_top _ _)]
  rfl

/-- Diestel--Uhl, Vector Measures, Chapter III, weak sequential completeness
of scalar L1 and the nonexistence of a Bochner derivative for E ↦ 1_E. -/
axiom citeDiestelUhlL1WeaklySequentiallyComplete :
    WeaklySeqComplete IntervalL1

/-- Diestel--Uhl, Vector Measures, Chapter III, the atomless interval example. -/
axiom citeDiestelUhlL1IndicatorNoDensity :
    ¬ ∃ g : ℝ → IntervalL1, Integrable g lebesgueUnitInterval ∧
      ∀ E : MeasSet ℝ, intervalL1Indicator E = ∫ t in E.1, g t ∂lebesgueUnitInterval

theorem intervalL1_not_RNP : ¬ HasRadonNikodymProperty.{0} IntervalL1 := by
  intro h
  apply citeDiestelUhlL1IndicatorNoDensity
  have h0 : intervalL1VectorMeasure MeasSet.empty = 0 :=
    congrArg (fun L : IntervalL1 →L[ℝ] IntervalL1 => L (intervalL1Indicator MeasSet.whole))
      intervalL1PVM.empty_eq
  have hv : BoundedVectorVariation intervalL1VectorMeasure := by
    refine ⟨1, fun D hD I => ?_⟩
    rw [intervalL1VectorMeasure_variation (MeasSet.finiteUnion D I) D hD I rfl]
    exact ENNReal.toReal_le_of_le_ofReal (by norm_num) (by simpa using (measure_mono (subset_univ (MeasSet.finiteUnion D I).1) :
      lebesgueUnitInterval (MeasSet.finiteUnion D I).1 ≤ lebesgueUnitInterval univ))
  obtain ⟨g, hg, hE⟩ := h ℝ lebesgueUnitInterval intervalL1VectorMeasure h0
    (fun D hd => intervalL1PVM.countably_additive D hd (intervalL1Indicator MeasSet.whole))
    (fun E hE => norm_eq_zero.mp (by rw [intervalL1VectorMeasure_norm, Measure.real, hE, ENNReal.toReal_zero])) hv
  exact ⟨g, hg, fun E => (intervalL1VectorMeasure_indicator E).symm.trans (hE E)⟩

theorem intervalL1_no_cZero : ¬ ContainsCopy CZero IntervalL1 :=
  citeDiestelUhlL1WeaklySequentiallyComplete.not_contains_cZero

theorem intervalL1_boundedlyComplete : intervalL1PVM.BoundedlyComplete :=
  intervalL1PVM.boundedlyComplete_of_not_contains_cZero intervalL1_no_cZero

theorem intervalL1_cyclic : intervalL1PVM.Cyclic :=
  FiniteSignedMeasure.probabilityLpPVM_cyclic ENNReal.one_ne_top

theorem intervalL1_finitelyGenerated : intervalL1PVM.FinitelyGenerated :=
  intervalL1PVM.finitelyGenerated_of_cyclic intervalL1_cyclic


theorem intervalL1_not_shrinking : ¬ intervalL1PVM.toOVM.Shrinking := by
  intro hs
  apply intervalL1PVM.not_contains_lOne_of_shrinking (intervalL1PVM.localizes_of_cyclic intervalL1_cyclic) hs
  apply citeAtomlessProbabilityL1ContainsLone lebesgueUnitInterval
  intro x
  rw [lebesgueUnitInterval, Measure.restrict_apply (measurableSet_singleton x)]
  exact measure_mono_null inter_subset_left (measure_singleton x)

theorem continuousFrame_RNP_of_no_cZero {Ω X : Type*} [MeasurableSpace Ω]
    [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X] [TopologicalSpace.SeparableSpace X]
    {ρ : Measure Ω} [SigmaFinite ρ] (F : ContinuousSchauderFrame (X := X) ρ)
    (hc₀ : ¬ ContainsCopy CZero X) : HasRadonNikodymProperty.{0} X := by
  obtain ⟨D, hD, hu, hlocal⟩ := F.exists_partition_locally_compact_operatorMeasure
  let μ := F.operatorMeasure
  have hK (n : ℕ) : RelativelyWeaklyCompact (μ.val (D n) '' Metric.closedBall 0 1) := by
    let T := μ.val (D n)
    have hc : IsCompactOperator T := (hlocal n).2.2 (D n) Subset.rfl
    have hcomp := hc.isCompact_closure_image_closedBall (f := T.toLinearMap) 1
    apply (citeRelativeEberleinSmulian _).mpr
    intro u hu
    obtain ⟨z, _, φ, hφ, hz⟩ := hcomp.isSeqCompact (fun j => subset_closure (hu j))
    exact ⟨φ, hφ, z, fun f => (f.continuous.tendsto z).comp hz⟩
  refine hasRadonNikodymProperty_of_weaklyCompact_resolution hc₀ (fun n => μ.val (D n))
    hK ?_ (2 * μ.uniformNorm) (mul_nonneg (by norm_num) μ.uniformNorm_nonneg) ?_
  · intro x
    have h := μ.countably_additive D hD x
    rwa [hu, show μ.Normalized from F.operatorMeasure_normalized, ContinuousLinearMap.id_apply] at h
  · intro I
    simpa only [one_smul] using μ.opNorm_finite_multiplier_le D hD I (fun _ => 1) (by simp)

theorem intervalL1_no_continuousFrame {Ω : Type*} [MeasurableSpace Ω]
    (ρ : Measure Ω) [SigmaFinite ρ] :
    ¬ Nonempty (ContinuousSchauderFrame (X := IntervalL1) ρ) := by
  let : Fact ((1 : ℝ≥0∞) ≠ ⊤) := ⟨ENNReal.one_ne_top⟩
  let : MeasurableSpace.CountablyGenerated ℝ := BorelSpace.countablyGenerated
  intro ⟨F⟩
  exact intervalL1_not_RNP (continuousFrame_RNP_of_no_cZero F intervalL1_no_cZero)

theorem intervalL1_no_unconditionalFrame :
    ¬ ∃ (y : ℕ → IntervalL1) (g : ℕ → Dual IntervalL1), IsUnconditionalSchauderFrame y g := by
  rintro ⟨y, g, hg⟩
  exact intervalL1_no_continuousFrame Measure.count ⟨hg.countingFrame⟩

