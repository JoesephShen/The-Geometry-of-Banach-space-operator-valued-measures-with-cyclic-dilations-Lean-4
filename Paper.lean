noncomputable section SectionSevenVectorOneTwo

open MeasureTheory Set Filter
open scoped ENNReal Topology

variable {Y : Type} [NormedAddCommGroup Y] [NormedSpace ℝ Y] [CompleteSpace Y]

omit [NormedSpace ℝ Y] [CompleteSpace Y] in
private theorem vectorOne_hasSum_norm (x : VectorLp Y 1) :
    HasSum (fun n => ‖x n‖) ‖x‖ := by
  simpa only [ENNReal.toReal_one,Real.rpow_one] using lp.hasSum_norm (by norm_num) x

omit [CompleteSpace Y] in
theorem vectorOne_disjoint_norm_sum (A : ℕ → MeasSet ℕ) (z : ℕ → VectorLp Y 1)
    (hA : MeasSet.DisjointSeq A) (hz : ∀ n, (vectorOneCoordinates Y).pvm.val (A n) (z n) = z n)
    (I : Finset ℕ) : ‖∑ n ∈ I, z n‖ = ∑ n ∈ I, ‖z n‖ := by
  classical
  have hs (n j : ℕ) (h : j ∉ (A n).1) : z n j = 0 := by
    have he := congrArg (fun x : VectorLp Y 1 => x j) (hz n)
    change vectorLpCut (A n).1 (z n) j = z n j at he
    rw [vectorLpCut_apply,ite_eq_right h] at he
    exact he.symm
  have hq (j : ℕ) : ‖(∑ n ∈ I, z n) j‖ = ∑ n ∈ I, ‖z n j‖ := by
    rw [lp.coeFn_sum,Finset.sum_apply]
    by_cases h : ∃ n ∈ I, j ∈ (A n).1
    · obtain ⟨n,hn,hj⟩ := h
      have he (i : ℕ) (hi : i ≠ n) : z i j = 0 := hs i j (fun ht => (Set.disjoint_left.mp (hA hi)) ht hj)
      rw [Finset.sum_eq_single_of_mem n hn (fun i _ hi => he i hi),
        Finset.sum_eq_single_of_mem n hn (fun i _ hi => by rw [he i hi,norm_zero])]
    · have he (n : ℕ) (hn : n ∈ I) : z n j = 0 := hs n j (fun hj => h ⟨n,hn,hj⟩)
      rw [Finset.sum_eq_zero he,norm_zero]
      exact (Finset.sum_eq_zero (fun n hn => by rw [he n hn,norm_zero])).symm
  have ht (K : Finset ℕ) : HasSum (fun j => ∑ n ∈ K, ‖z n j‖) (∑ n ∈ K, ‖z n‖) := by
    induction K using Finset.induction_on with
    | empty => simpa only [Finset.sum_empty] using (hasSum_zero : HasSum (fun _ : ℕ => (0:ℝ)) 0)
    | @insert n I hn ih =>
      simpa only [Finset.sum_insert hn] using (vectorOne_hasSum_norm (z n)).add ih
  have h := vectorOne_hasSum_norm (∑ n ∈ I, z n)
  simp_rw [hq] at h
  exact h.unique (ht I)

theorem vectorOne_boundedlyComplete : (vectorOneCoordinates Y).pvm.BoundedlyComplete := by
  intro A z hA hz hbounded
  obtain ⟨C,hC⟩ := hbounded
  have hs : Summable (fun n => ‖z n‖) :=
    summable_of_sum_range_le (fun _ => norm_nonneg _) (fun N => by
      rw [← vectorOne_disjoint_norm_sum A z hA hz]
      exact hC N)
  exact ⟨∑' n, z n, hs.of_norm.hasSum.tendsto_sum_nat⟩

omit [CompleteSpace Y] in
private theorem vectorOne_constantFunctional_summable (g : Dual Y) (x : VectorLp Y 1) :
    Summable (fun n => g (x n)) := by
  apply Summable.of_norm
  apply Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun n => g.le_opNorm (x n))
  exact (vectorOne_hasSum_norm x).summable.mul_left ‖g‖

def vectorOneConstantFunctional (g : Dual Y) : Dual (VectorLp Y 1) := by
  let L : VectorLp Y 1 →ₗ[ℝ] ℝ :=
    { toFun := fun x => ∑' n, g (x n)
      map_add' := fun x y => by
        change (∑' n, g ((x+y) n)) = (∑' n, g (x n)) + ∑' n, g (y n)
        rw [← (vectorOne_constantFunctional_summable g x).tsum_add
          (vectorOne_constantFunctional_summable g y)]
        apply tsum_congr
        intro n
        change g (x n + y n) = _
        exact map_add g _ _
      map_smul' := fun a x => by
        change (∑' n, g ((a • x) n)) = a * (∑' n, g (x n))
        rw [← tsum_mul_left]
        apply tsum_congr
        intro n
        change g (a • x n) = _
        exact map_smul g _ _ }
  refine L.mkContinuous ‖g‖ fun x => ?_
  change ‖∑' n, g (x n)‖ ≤ _
  have hs : Summable (fun n => ‖g (x n)‖) := (vectorOne_constantFunctional_summable g x).norm
  have ht := (vectorOne_hasSum_norm x).mul_left ‖g‖
  exact (norm_tsum_le_tsum_norm hs).trans (ht.tsum_eq ▸
    hs.tsum_le_tsum (fun n => g.le_opNorm (x n)) ht.summable)

omit [CompleteSpace Y] in
theorem vectorOneConstantFunctional_single (g : Dual Y) (n : ℕ) (y : Y) :
    vectorOneConstantFunctional g ((vectorOneCoordinates Y).single n y) = g y := by
  classical
  change (∑' j, g ((vectorOneCoordinates Y).single n y j)) = g y
  have h (j : ℕ) :
      ((vectorOneCoordinates Y).single n y) j = if j = n then y else 0 :=
    (vectorOneCoordinates Y).single_eval n j y
  simp_rw [h]
  have he (j : ℕ) : g (if j = n then y else 0) = if j = n then g y else 0 := by
    by_cases hj : j = n <;> simp [hj]
  simp_rw [he]
  exact tsum_ite_eq _ _

omit [CompleteSpace Y] in
theorem vectorOne_not_shrinking [Nontrivial Y] : ¬ (vectorOneCoordinates Y).pvm.toOVM.Shrinking := by
  intro hs
  obtain ⟨y,hy⟩ := exists_ne (0 : Y)
  obtain ⟨g,_,hg⟩ := exists_dual_vector ℝ y (norm_ne_zero_iff.mpr hy)
  let S := vectorOneCoordinates Y
  let F (n : ℕ) := adjoint (S.pvm.val (MeasSet.natAtom n)) (vectorOneConstantFunctional g)
  have hh := hs MeasSet.natAtom (fun _ _ h => Set.disjoint_singleton.mpr h) (vectorOneConstantFunctional g)
  have ht : Tendsto F atTop (𝓝 0) := by
    let a := adjoint (S.pvm.val (MeasSet.iUnion MeasSet.natAtom)) (vectorOneConstantFunctional g)
    have hn : Tendsto (fun N => ∑ n ∈ Finset.range N,F n) atTop (𝓝 a) := hh.tendsto_sum_nat
    have h := (hn.comp (tendsto_add_atTop_nat 1)).sub hn
    rw [sub_self] at h
    apply h.congr'
    filter_upwards with N
    simp [Finset.sum_range_succ]
  have hl (n : ℕ) : 1 ≤ ‖F n‖ := by
    have hfix : S.pvm.val (MeasSet.natAtom n) (S.single n y) = S.single n y := by
      rw [S.singleton_factor,ContinuousLinearMap.comp_apply,S.single_eval,ite_eq_left rfl]
    have h := (F n).le_opNorm (S.single n y)
    have he : F n (S.single n y) = ‖y‖ := by
      change vectorOneConstantFunctional g (S.pvm.val (MeasSet.natAtom n) (S.single n y)) = _
      rw [hfix,vectorOneConstantFunctional_single,hg]
      rfl
    rw [he,Real.norm_of_nonneg (norm_nonneg _),S.single_norm] at h
    by_contra! h'
    have hlt := mul_lt_mul_of_pos_right h' (norm_pos_iff.mpr hy)
    linarith
  have hzero : Tendsto (fun n => ‖F n‖) atTop (𝓝 0) := by simpa only [norm_zero] using ht.norm
  obtain ⟨n,hn⟩ := ((tendsto_order.mp hzero).2 1 zero_lt_one).exists
  exact (not_lt_of_ge (hl n)) hn

/-- Reflexivity of the ℓ² sum of a reflexive Banach space. This is the
counting-measure case of the Bochner Lp reflexivity theorem. -/
axiom citeVectorLTwoReflexivity (hY : IsReflexive Y) : IsReflexive (VectorLp Y 2)

theorem vectorTwo_geometry (hY : IsReflexive Y) :
    (vectorTwoCoordinates Y).pvm.toOVM.Shrinking ∧ (vectorTwoCoordinates Y).pvm.BoundedlyComplete :=
  ((vectorTwoCoordinates Y).pvm.shrinking_boundedlyComplete_iff_reflexive
    ((vectorTwoCoordinates Y).localizes hY)).mpr (citeVectorLTwoReflexivity hY)

