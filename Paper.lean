section FrameDilationAssembly

open MeasureTheory

variable {Ω X Y : Type*} [MeasurableSpace Ω] [NormedAddCommGroup X] [NormedSpace ℝ X]
  [CompleteSpace X] [NormedAddCommGroup Y] [NormedSpace ℝ Y] {η : Measure Ω}

/-- The coefficient identities of an L¹(m) analysis map give the dilation
by multiplication, with the constant-one indicator as its cyclic vector. -/
theorem ContinuousSchauderFrame.cyclic_dilation_of_L1_analysis
    (F : ContinuousSchauderFrame (X := X) η)
    {m : MeasSet Ω → X} (M : VectorMeasureL1Data m Y) (T : X →L[ℝ] Y)
    (hT : ∀ (E : MeasSet Ω) (x : X) (g : Dual X),
      g (M.integration (M.multiplication.val E (T x))) =
        ∫ t in E.1, F.functional t x * g (F.vector t) ∂η) :
    ∃ D : Dilation F.operatorMeasure Y, D.P = M.multiplication ∧ D.S = M.integration ∧
      D.T = T ∧ D.P.CyclicVector (M.indicator MeasSet.whole) := by
  have hcomp (E : MeasSet Ω) : (M.integration.comp (M.multiplication.val E)).comp T =
      F.operatorMeasure.val E := by
    ext x
    exact eq_of_dual_eval fun g => (hT E x g).trans (F.operatorMeasure_coeff E x g).symm
  have hs := hcomp MeasSet.whole
  have hp : M.multiplication.val MeasSet.whole = ContinuousLinearMap.id ℝ Y := M.multiplication.normalized
  rw [hp, F.operatorMeasure_normalized] at hs
  have hsplit : M.integration.comp T = ContinuousLinearMap.id ℝ X := by
    simpa only [ContinuousLinearMap.comp_id] using hs
  refine ⟨⟨M.multiplication, M.integration, T, hsplit, hcomp⟩, rfl, rfl, rfl, ?_⟩
  have h (E : MeasSet Ω) : M.multiplication.val E (M.indicator MeasSet.whole) = M.indicator E := by
    rw [M.multiplication_indicator, show E.inter MeasSet.whole = E from Subtype.ext (Set.inter_univ _)]
  change M.multiplication.CyclicVector (M.indicator MeasSet.whole)
  unfold PVM.CyclicVector
  simp_rw [h]
  exact M.dense_indicators

#print axioms ContinuousSchauderFrame.cyclic_dilation_of_L1_analysis

end FrameDilationAssembly

section FrameL1Analysis

open MeasureTheory

variable {Ω X : Type*} [MeasurableSpace Ω] [NormedAddCommGroup X] [NormedSpace ℝ X]
  {η : Measure Ω}

/-- Actual representatives of the scalar integrable functions for the
vector measure with Bochner density v. Scalar integration is written
against the scalar density g ∘ v. -/
def vectorDensityFunctions (η : Measure Ω) (v : Ω → X) : Submodule ℝ (Ω → ℝ) where
  carrier := {f | Measurable f ∧
    (∀ g : Dual X, Integrable (fun t => f t * g (v t)) η) ∧
    ∀ E : MeasSet Ω, ∃ y : X, ∀ g : Dual X,
      g y = ∫ t in E.1, f t * g (v t) ∂η}
  zero_mem' := by
    refine ⟨measurable_const, fun g => ?_, fun E => ⟨0, fun g => ?_⟩⟩ <;> simp
  add_mem' := by
    rintro f h ⟨hfm, hfi, hf⟩ ⟨hhm, hhi, hh⟩
    refine ⟨hfm.add hhm, fun g => ?_, fun E => ?_⟩
    · change Integrable (fun t => (f t + h t) * g (v t)) η
      simp only [add_mul]
      exact (hfi g).add (hhi g)
    · obtain ⟨x, hx⟩ := hf E
      obtain ⟨y, hy⟩ := hh E
      refine ⟨x + y, fun g => ?_⟩
      simpa only [map_add, hx g, hy g, Pi.add_apply, add_mul] using
        (integral_add (hfi g).restrict (hhi g).restrict).symm
  smul_mem' := by
    rintro c f ⟨hfm, hfi, hf⟩
    refine ⟨measurable_const.mul hfm, fun g => ?_, fun E => ?_⟩
    · simpa only [Pi.smul_apply, smul_eq_mul, mul_assoc] using (hfi g).const_mul c
    · obtain ⟨x, hx⟩ := hf E
      refine ⟨c • x, fun g => ?_⟩
      simp only [map_smul, hx g, Pi.smul_apply, smul_eq_mul, mul_assoc]
      exact (integral_const_mul _ _).symm

/-- The representative maps of the standard L¹ construction, specialized
to a vector measure with Bochner density. -/
structure VectorDensityL1Realization (η : Measure Ω) (v : Ω → X)
    (m : MeasSet Ω → X) where
  model : VectorMeasureL1Model m
  represent : letI := model.normedGroup; letI := model.normedScalar
    vectorDensityFunctions η v →ₗ[ℝ] model.carrier
  norm_represent : letI := model.normedGroup; letI := model.normedScalar
    ∀ f : vectorDensityFunctions η v, ‖represent f‖ =
      sSup {r | ∃ g : Dual X, ‖g‖ ≤ 1 ∧ r = ∫ t, |f.1 t * g (v t)| ∂η}
  eval_cut : letI := model.normedGroup; letI := model.normedScalar
    ∀ (f : vectorDensityFunctions η v) (E : MeasSet Ω) (g : Dual X),
      g (model.data.integration (model.data.multiplication.val E (represent f))) =
        ∫ t in E.1, f.1 t * g (v t) ∂η

/-- Standard vector-measure L¹ with its quotient map on integrable scalar
representatives. See Calabuig, Rodríguez and Sánchez-Pérez, J. Convex Anal.
21 (2014), pp. 811–812, and Okada–Ricker, Comment. Math. Univ. Carolin.
35 (1994), §1. For a Bochner density, scalar integration and total
variation have the corresponding scalar density and its absolute value. -/
axiom citeVectorMeasureL1Representatives [CompleteSpace X] (v : Ω → X)
    (hv : Integrable v η) (m : MeasSet Ω → X)
    (hm : ∀ E, m E = ∫ t in E.1, v t ∂η) :
    Nonempty (VectorDensityL1Realization η v m)

namespace ContinuousSchauderFrame

variable [CompleteSpace X] (F : ContinuousSchauderFrame (X := X) η)

/-- The real scalar total-variation bound for the Pettis coefficient
measure on the orbit of x. -/
theorem integral_abs_coefficient_le (x : X) (g : Dual X) :
    (∫ t, |F.functional t x * g (F.vector t)| ∂η) ≤
      2 * F.operatorMeasure.uniformNorm * ‖x‖ * ‖g‖ := by
  let f (t : Ω) := F.functional t x * g (F.vector t)
  have hm : Measurable f := (F.weakStarMeasurable x).mul (F.weaklyMeasurable g)
  have hi : Integrable f η := by
    simpa only [f, map_smul, smul_eq_mul] using ((F.pettis x).1 g).2
  let E : MeasSet Ω := ⟨{t | 0 ≤ f t}, measurableSet_le measurable_const hm⟩
  let B : MeasSet Ω := ⟨E.1ᶜ, E.2.compl⟩
  have he : (∫ t in E.1, |f t| ∂η) = ∫ t in E.1, f t ∂η :=
    setIntegral_congr_fun E.2 fun t ht => abs_of_nonneg ht
  have hb : (∫ t in B.1, |f t| ∂η) = -(∫ t in B.1, f t ∂η) := by
    rw [← integral_neg]
    exact setIntegral_congr_fun B.2 fun t ht => abs_of_nonpos (le_of_not_ge ht)
  have hbound (A : MeasSet Ω) : |∫ t in A.1, f t ∂η| ≤
      ‖g‖ * (F.operatorMeasure.uniformNorm * ‖x‖) := by
    rw [← F.operatorMeasure_coeff A x g]
    exact (g.le_opNorm _).trans (mul_le_mul_of_nonneg_left
      (((F.operatorMeasure.val A).le_opNorm x).trans
        (mul_le_mul_of_nonneg_right (F.operatorMeasure.opNorm_le_uniformNorm A) (norm_nonneg x)))
      (norm_nonneg g))
  have hsplit : (∫ t in E.1, |f t| ∂η) + (∫ t in B.1, |f t| ∂η) =
      ∫ t, |f t| ∂η := by
    simpa only [Real.norm_eq_abs] using integral_add_compl E.2 hi.norm
  change (∫ t, |f t| ∂η) ≤ _
  rw [← hsplit, he, hb]
  calc
    _ ≤ |∫ t in E.1, f t ∂η| + |∫ t in B.1, f t ∂η| :=
      add_le_add (le_abs_self _) (neg_le_abs _)
    _ ≤ _ := (add_le_add (hbound E) (hbound B)).trans_eq (by ring)

private theorem weighted_analysis_mem (w : Ω → ℝ) (hwm : Measurable w) (hwp : ∀ t, 0 < w t)
    (x : X) : (fun t => F.functional t x / w t) ∈
      vectorDensityFunctions η (fun t => w t • F.vector t) := by
  change Measurable (fun t => F.functional t x / w t) ∧
    (∀ g : Dual X, Integrable (fun t => (F.functional t x / w t) * g (w t • F.vector t)) η) ∧
    ∀ E : MeasSet Ω, ∃ y : X, ∀ g : Dual X,
      g y = ∫ t in E.1, (F.functional t x / w t) * g (w t • F.vector t) ∂η
  refine ⟨(F.weakStarMeasurable x).div hwm, fun g => ?_, fun E => ⟨F.operatorMeasure.val E x, fun g => ?_⟩⟩
  · have hc (t : Ω) : (F.functional t x / w t) * g (w t • F.vector t) =
        F.functional t x * g (F.vector t) := by
      rw [map_smul, smul_eq_mul, ← mul_assoc, div_mul_cancel₀ _ (hwp t).ne']
    simp_rw [hc]
    simpa only [map_smul, smul_eq_mul] using ((F.pettis x).1 g).2
  · simpa only [map_smul, smul_eq_mul] using (F.weighted_analysis_coeff w hwm hwp x g).2.2 E

noncomputable def weightedAnalysisFunctions (w : Ω → ℝ) (hwm : Measurable w) (hwp : ∀ t, 0 < w t) :
    X →ₗ[ℝ] vectorDensityFunctions η (fun t => w t • F.vector t) where
  toFun x := ⟨fun t => F.functional t x / w t, F.weighted_analysis_mem w hwm hwp x⟩
  map_add' x y := Subtype.ext (funext fun t => by simp [add_div])
  map_smul' c x := Subtype.ext (funext fun t => by simp [smul_eq_mul, mul_div_assoc])

/-- The bounded analysis operator sends x to the class of f_t(x)/w(t). -/
theorem exists_weighted_analysis_map (w : Ω → ℝ) (hwm : Measurable w) (hwp : ∀ t, 0 < w t)
    {m : MeasSet Ω → X} (M : VectorDensityL1Realization η (fun t => w t • F.vector t) m) :
    letI := M.model.normedGroup
    letI := M.model.normedScalar
    ∃ T : X →L[ℝ] M.model.carrier,
      (∀ x, T x = M.represent (F.weightedAnalysisFunctions w hwm hwp x)) ∧
      ‖T‖ ≤ 2 * F.operatorMeasure.uniformNorm ∧
      ∀ (E : MeasSet Ω) (x : X) (g : Dual X),
        g (M.model.data.integration (M.model.data.multiplication.val E (T x))) =
          ∫ t in E.1, F.functional t x * g (F.vector t) ∂η := by
  let := M.model.normedGroup
  let := M.model.normedScalar
  let T₀ := M.represent.comp (F.weightedAnalysisFunctions w hwm hwp)
  have hC : 0 ≤ F.operatorMeasure.uniformNorm :=
    (norm_nonneg _).trans (F.operatorMeasure.opNorm_le_uniformNorm MeasSet.whole)
  have hcancel (x : X) (g : Dual X) (t : Ω) :
      (F.functional t x / w t) * g (w t • F.vector t) =
        F.functional t x * g (F.vector t) := by
    rw [map_smul, smul_eq_mul, ← mul_assoc, div_mul_cancel₀ _ (hwp t).ne']
  have hb (x : X) : ‖T₀ x‖ ≤ (2 * F.operatorMeasure.uniformNorm) * ‖x‖ := by
    change ‖M.represent (F.weightedAnalysisFunctions w hwm hwp x)‖ ≤ _
    rw [M.norm_represent]
    apply csSup_le
    · exact ⟨0, 0, by simp, by simp⟩
    · rintro _ ⟨g, hg, rfl⟩
      change (∫ t, |(F.functional t x / w t) * g (w t • F.vector t)| ∂η) ≤ _
      simp_rw [hcancel]
      exact (F.integral_abs_coefficient_le x g).trans
        ((mul_le_mul_of_nonneg_left hg (by positivity)).trans_eq (mul_one _))
  let T := T₀.mkContinuous _ hb
  refine ⟨T, fun _ => rfl, ContinuousLinearMap.opNorm_le_bound _ (by positivity) hb,
    fun E x g => ?_⟩
  have h := M.eval_cut (F.weightedAnalysisFunctions w hwm hwp x) E g
  change g (M.model.data.integration (M.model.data.multiplication.val E (T x))) =
      ∫ t in E.1, (F.functional t x / w t) * g (w t • F.vector t) ∂η at h
  simpa only [hcancel] using h

/-- The continuous frame's OVM admits a cyclic dilation on the standard
L¹ of the weighted vector measure, with the explicit analysis map. -/
theorem exists_cyclic_dilation_weightedL1 [TopologicalSpace.SeparableSpace X] [SigmaFinite η] :
    ∃ (w : Ω → ℝ) (m : MeasSet Ω → X) (hwm : Measurable w) (hwp : ∀ t, 0 < w t),
      Integrable (fun t => w t • F.vector t) η ∧
      (∫ t, ‖w t • F.vector t‖ ∂η) ≤ 1 ∧
      (∀ E, m E = ∫ t in E.1, w t • F.vector t ∂η) ∧
      m MeasSet.empty = 0 ∧
      (∀ E : ℕ → MeasSet Ω, MeasSet.DisjointSeq E →
        HasSum (fun n => m (E n)) (m (MeasSet.iUnion E))) ∧
      ∃ M : VectorDensityL1Realization η (fun t => w t • F.vector t) m,
        letI := M.model.normedGroup
        letI := M.model.normedScalar
        ∃ D : Dilation F.operatorMeasure M.model.carrier,
          D.P = M.model.data.multiplication ∧ D.S = M.model.data.integration ∧
          (∀ x, D.T x = M.represent (F.weightedAnalysisFunctions w hwm hwp x)) ∧
          ‖D.T‖ ≤ 2 * F.operatorMeasure.uniformNorm ∧
          D.P.CyclicVector (M.model.data.indicator MeasSet.whole) := by
  obtain ⟨w, m, hwm, hwp, hv, hvnorm, hm, hm₀, hmσ, _⟩ := F.exists_weighted_vectorMeasure
  obtain ⟨M⟩ := citeVectorMeasureL1Representatives _ hv m hm
  let := M.model.normedGroup
  let := M.model.normedScalar
  obtain ⟨T, hT, hnorm, heval⟩ := F.exists_weighted_analysis_map w hwm hwp M
  obtain ⟨D, hp, hs, ht, hc⟩ := F.cyclic_dilation_of_L1_analysis M.model.data T heval
  exact ⟨w, m, hwm, hwp, hv, hvnorm, hm, hm₀, hmσ, M, D, hp, hs, by simpa only [ht] using hT,
    by simpa only [ht] using hnorm, hc⟩

end ContinuousSchauderFrame

#print axioms ContinuousSchauderFrame.integral_abs_coefficient_le
#print axioms ContinuousSchauderFrame.exists_weighted_analysis_map
#print axioms ContinuousSchauderFrame.exists_cyclic_dilation_weightedL1

end FrameL1Analysis

section DiscreteFrameRankOne

open scoped Classical

variable {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]

/-- Rank-at-most-one operators factor through a bounded scalar functional.
The zero operator is represented by two zero factors. -/
theorem rank_le_one_iff_exists_smulRight (A : X →L[ℝ] X) :
    Module.rank ℝ A.toLinearMap.range ≤ 1 ↔
      ∃ (y : X) (f : Dual X), A = f.smulRight y := by
  constructor
  · intro h
    obtain ⟨y, hy⟩ := rank_le_one_iff.mp h
    by_cases hzero : (y : X) = 0
    · refine ⟨0, 0, ?_⟩
      ext x
      obtain ⟨c, hc⟩ := hy ⟨A x, ⟨x, rfl⟩⟩
      have heq : c • (y : X) = A x := congrArg Subtype.val hc
      simpa [hzero, ContinuousLinearMap.smulRight_apply] using heq.symm
    · obtain ⟨g, _, hg⟩ := exists_dual_vector ℝ (y : X) (norm_ne_zero_iff.mpr hzero)
      let f : Dual X := ‖(y : X)‖⁻¹ • g.comp A
      refine ⟨y, f, ?_⟩
      ext x
      obtain ⟨c, hc⟩ := hy ⟨A x, ⟨x, rfl⟩⟩
      have heq : c • (y : X) = A x := congrArg Subtype.val hc
      have hfx : f x = c := by
        change ‖(y : X)‖⁻¹ * g (A x) = c
        rw [← heq, map_smul, smul_eq_mul, hg]
        change ‖(y : X)‖⁻¹ * (c * ‖(y : X)‖) = c
        field_simp [norm_ne_zero_iff.mpr hzero]
      rw [ContinuousLinearMap.smulRight_apply, hfx, heq]
  · rintro ⟨y, f, rfl⟩
    apply rank_le_one_iff.mpr
    by_cases hf : f = 0
    · subst f
      refine ⟨0, ?_⟩
      rintro ⟨_, x, rfl⟩
      exact ⟨0, Subtype.ext (by simp)⟩
    · have he : ∃ x, f x ≠ 0 := by
        by_contra! hc
        exact hf (ContinuousLinearMap.ext hc)
      obtain ⟨x, hx⟩ := he
      let z := (f x)⁻¹ • x
      have hz : f z = 1 := by
        change f ((f x)⁻¹ • x) = 1
        rw [map_smul, smul_eq_mul, inv_mul_cancel₀ hx]
      have hy : y ∈ (f.smulRight y).toLinearMap.range := by
        refine ⟨z, ?_⟩
        change f z • y = y
        rw [hz, one_smul]
      refine ⟨⟨y, hy⟩, ?_⟩
      rintro ⟨_, u, rfl⟩
      exact ⟨f u, Subtype.ext rfl⟩

def MeasSet.natAtom (n : ℕ) : MeasSet ℕ := ⟨{n}, measurableSet_singleton n⟩

/-- Strong additivity over the measurable singletons, also for an arbitrary
subcollection of the atoms. -/
theorem OVM.natAtom_hasSum (μ : OVM ℕ X) (E : MeasSet ℕ) (x : X) :
    HasSum (fun n => if n ∈ E.1 then μ.val (MeasSet.natAtom n) x else 0) (μ.val E x) := by
  let A (n : ℕ) := E.inter (MeasSet.natAtom n)
  have hA : MeasSet.DisjointSeq A := by
    intro i j hij
    apply Set.disjoint_left.mpr
    intro n hi hj
    exact hij ((show n = i from hi.2).symm.trans (show n = j from hj.2))
  have hcover : MeasSet.iUnion A = E := by
    apply Subtype.ext
    change (⋃ n, E.1 ∩ {n}) = E.1
    ext n
    constructor
    · intro hn
      obtain ⟨i, hi⟩ := mem_iUnion.mp hn
      exact hi.1
    · intro hn
      exact mem_iUnion.mpr ⟨n, hn, rfl⟩
  have ha (n : ℕ) : μ.val (A n) x =
      if n ∈ E.1 then μ.val (MeasSet.natAtom n) x else 0 := by
    by_cases hn : n ∈ E.1
    · simp [hn]
      congr 2
      apply Subtype.ext
      exact inter_eq_right.mpr (singleton_subset_iff.mpr hn)
    · simp [hn]
      have he : A n = MeasSet.empty := by
        apply Subtype.ext
        change E.1 ∩ {n} = ∅
        exact eq_empty_iff_forall_notMem.mpr (fun t ht => hn ((show t = n from ht.2) ▸ ht.1))
      rw [he, μ.empty_eq, zero_apply]
  have hs := μ.countably_additive A hA x
  rw [hcover] at hs
  simpa only [ha] using hs

/-- The rank-one part of prop:discrete-frame-representation. The given
OVM is represented by the frame on every measurable subset of ℕ. -/
theorem OVM.nat_rankOne_iff_unconditionalSchauderFrame (μ : OVM ℕ X) (hμ : μ.Normalized) :
    (∀ n, Module.rank ℝ (μ.val (MeasSet.natAtom n)).toLinearMap.range ≤ 1) ↔
      ∃ (y : ℕ → X) (f : ℕ → Dual X), IsUnconditionalSchauderFrame y f ∧
        ∀ (E : MeasSet ℕ) (x : X),
          HasSum (fun n => if n ∈ E.1 then f n x • y n else 0) (μ.val E x) := by
  constructor
  · intro h
    choose y f hf using fun n => (rank_le_one_iff_exists_smulRight _).mp (h n)
    have hs (E : MeasSet ℕ) (x : X) :
        HasSum (fun n => if n ∈ E.1 then f n x • y n else 0) (μ.val E x) := by
      simpa only [hf, ContinuousLinearMap.smulRight_apply] using μ.natAtom_hasSum E x
    refine ⟨y, f, fun x => ?_, hs⟩
    have hwhole := hs MeasSet.whole x
    rw [hμ] at hwhole
    simpa only [MeasSet.whole, Set.mem_univ, ite_true, ContinuousLinearMap.id_apply] using hwhole
  · rintro ⟨y, f, _, hs⟩ n
    apply (rank_le_one_iff_exists_smulRight _).mpr
    refine ⟨y n, f n, ?_⟩
    ext x
    have he : HasSum (fun k => if k ∈ (MeasSet.natAtom n).1 then f k x • y k else 0)
        (f n x • y n) := by
      have hfun : (fun k => if k ∈ (MeasSet.natAtom n).1 then f k x • y k else 0) =
          fun k => if k = n then f n x • y n else 0 := by
        funext k
        by_cases h : k = n <;> simp [MeasSet.natAtom, h]
      rw [hfun]
      exact hasSum_ite_eq n (f n x • y n) _
    exact (hs (MeasSet.natAtom n) x).unique he

#print axioms rank_le_one_iff_exists_smulRight
#print axioms OVM.natAtom_hasSum
#print axioms OVM.nat_rankOne_iff_unconditionalSchauderFrame

end DiscreteFrameRankOne

section DiscreteFrameFiniteGenerators

variable {X Z : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]
  [NormedAddCommGroup Z] [NormedSpace ℝ Z]

/-- A dilation generated by r orbit vectors has singleton operators of
rank at most r. This is (2) implies (1) in prop:discrete-frame-representation. -/
theorem Dilation.nat_rank_le_of_generators {μ : OVM ℕ X} (D : Dilation μ Z)
    {r : ℕ} (u : Fin r → Z) (hu : Dense (Submodule.span ℝ (D.P.generatorOrbit u) : Set Z))
    (n : ℕ) : Module.rank ℝ (μ.val (MeasSet.natAtom n)).toLinearMap.range ≤ (r : Cardinal) := by
  classical
  let A := MeasSet.natAtom n
  let L := D.S.comp (D.P.val A)
  let W := Submodule.span ℝ (Set.range fun i => L (u i))
  let : Module.Finite ℝ W := Module.Finite.span_of_finite ℝ (Set.finite_range _)
  have hW : IsClosed (W : Set X) := W.isClosed_of_finiteDimensional
  have horbit : D.P.generatorOrbit u ⊆ (W.comap L.toLinearMap : Set Z) := by
    rintro _ ⟨i, E, rfl⟩
    change D.S (D.P.val A (D.P.val E (u i))) ∈ W
    have hprod := congrArg (fun B : Z →L[ℝ] Z => B (u i)) (D.P.mul_eq A E)
    change D.P.val A (D.P.val E (u i)) = D.P.val (A.inter E) (u i) at hprod
    rw [hprod]
    by_cases hn : n ∈ E.1
    · have h : A.inter E = A := Subtype.ext (inter_eq_left.mpr (singleton_subset_iff.mpr hn))
      rw [h]
      exact Submodule.subset_span ⟨i, rfl⟩
    · have h : A.inter E = MeasSet.empty := by
        apply Subtype.ext
        change ({n} : Set ℕ) ∩ E.1 = ∅
        exact eq_empty_iff_forall_notMem.mpr (fun t ht => hn ((show t = n from ht.1) ▸ ht.2))
      rw [h, D.P.empty_eq, zero_apply, map_zero]
      exact W.zero_mem
  have hspan : (Submodule.span ℝ (D.P.generatorOrbit u) : Set Z) ⊆ (W.comap L.toLinearMap : Set Z) :=
    Submodule.span_le.mpr horbit
  have hclosed : IsClosed (W.comap L.toLinearMap : Set Z) := hW.preimage L.continuous
  have hall (z : Z) : L z ∈ W := hclosed.closure_subset_iff.mpr hspan (hu z)
  have hrange : (μ.val A).toLinearMap.range ≤ W := by
    rintro _ ⟨x, rfl⟩
    have h := congrArg (fun B : X →L[ℝ] X => B x) (D.compress A)
    change L (D.T x) = μ.val A x at h
    exact h ▸ hall (D.T x)
  let : Module.Finite ℝ (μ.val A).toLinearMap.range := Submodule.finiteDimensional_of_le hrange
  have hd : Module.finrank ℝ W ≤ r := by
    change (Set.range fun i => L (u i)).finrank ℝ ≤ r
    simpa only [Fintype.card_fin] using (finrank_range_le_card (R := ℝ) fun i => L (u i))
  change Module.rank ℝ (μ.val A).toLinearMap.range ≤ (r : Cardinal)
  rw [← Module.finrank_eq_rank]
  exact Nat.cast_le.mpr ((Submodule.finrank_mono hrange).trans hd)

#print axioms Dilation.nat_rank_le_of_generators

end DiscreteFrameFiniteGenerators

section AlphaFrameAtoms

open scoped BoundedContinuousFunction

local instance : TopologicalSpace (MeasSet ℕ) := ⊥
local instance : Nonempty (MeasSet ℕ) := ⟨MeasSet.empty⟩

variable {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X]

/-- Evaluation at a singleton identifies the corresponding minimal
α-coordinate with the singleton operator's finite-dimensional range. -/
noncomputable def OVM.alphaAtomIsometry (μ : OVM ℕ X) (n : ℕ)
    [Module.Finite ℝ (μ.val (MeasSet.natAtom n)).toLinearMap.range] :
    (μ.alphaPVM.val (MeasSet.natAtom n)).toLinearMap.range ≃ₗᵢ[ℝ]
      (μ.val (MeasSet.natAtom n)).toLinearMap.range := by
  classical
  let A := MeasSet.natAtom n
  let W := (μ.alphaPVM.val A).toLinearMap.range
  let R := (μ.val A).toLinearMap.range
  let L : AlphaAmbient ℕ X →L[ℝ] X := BoundedContinuousFunction.evalCLM ℝ A
  have hinter (E : MeasSet ℕ) (h : n ∈ E.1) : A.inter E = A :=
    Subtype.ext (inter_eq_left.mpr (singleton_subset_iff.mpr h))
  have hinter' (E : MeasSet ℕ) (h : n ∉ E.1) : A.inter E = MeasSet.empty := by
    apply Subtype.ext
    change ({n} : Set ℕ) ∩ E.1 = ∅
    exact eq_empty_iff_forall_notMem.mpr (fun t ht => h ((show t = n from ht.1) ▸ ht.2))
  have hempty (z : μ.alphaSubmodule) : z.1 MeasSet.empty = 0 := by
    have h := congrArg (fun B : μ.alphaSubmodule →L[ℝ] μ.alphaSubmodule =>
      (B z).1 MeasSet.whole) μ.alphaPVM.empty_eq
    change z.1 (MeasSet.empty.inter MeasSet.whole) = 0 at h
    simpa only [show MeasSet.empty.inter MeasSet.whole = MeasSet.empty from
      Subtype.ext (inter_univ _)] using h
  have hproj (z : μ.alphaSubmodule) (E : MeasSet ℕ) :
      (μ.alphaPVM.val A z).1 E = z.1 (A.inter E) := rfl
  have hS (z : μ.alphaSubmodule) : μ.alphaSynthesis (μ.alphaPVM.val A z) = z.1 A := by
    change z.1 (A.inter MeasSet.whole) = z.1 A
    rw [show A.inter MeasSet.whole = A from Subtype.ext (inter_univ _)]
  have horbit : μ.alphaGenerators ⊆ (R.comap L.toLinearMap : Set (AlphaAmbient ℕ X)) := by
    rintro _ ⟨⟨E, x⟩, rfl⟩
    change μ.alphaElementary E x A ∈ R
    rw [μ.alphaElementary_apply, show E.inter A = A.inter E from Subtype.ext (inter_comm _ _)]
    by_cases he : n ∈ E.1
    · rw [hinter E he]
      exact ⟨x, rfl⟩
    · rw [hinter' E he, μ.empty_eq, zero_apply]
      exact R.zero_mem
  have hclosed : IsClosed (R.comap L.toLinearMap : Set (AlphaAmbient ℕ X)) :=
    R.isClosed_of_finiteDimensional.preimage L.continuous
  have hEval (z : μ.alphaSubmodule) : z.1 A ∈ R :=
    hclosed.closure_subset_iff.mpr (Submodule.span_le.mpr horbit) z.2
  have hSRange (z : W) : μ.alphaSynthesis z.1 ∈ R := by
    obtain ⟨q, hq⟩ := z.2
    have h := hS q
    change μ.alphaPVM.val A q = z.1 at hq
    rw [hq] at h
    exact h ▸ hEval q
  let S : W →ₗ[ℝ] R := (μ.alphaSynthesis.toLinearMap.comp W.subtype).codRestrict R hSRange
  have hcoord (z : W) (E : MeasSet ℕ) :
      z.1.1 E = if n ∈ E.1 then μ.alphaSynthesis z.1 else 0 := by
    obtain ⟨q, hq⟩ := z.2
    change μ.alphaPVM.val A q = z.1 at hq
    rw [← hq, hproj, hS q]
    by_cases he : n ∈ E.1
    · simp [he, hinter E he]
    · simp [he, hinter' E he, hempty]
  have hi : Function.Injective S := by
    intro z z' he
    have he' : μ.alphaSynthesis z.1 = μ.alphaSynthesis z'.1 := congrArg Subtype.val he
    apply Subtype.ext
    apply Subtype.ext
    ext E
    exact (hcoord z E).trans ((congrArg (fun x : X => if n ∈ E.1 then x else 0) he')
      |>.trans (hcoord z' E).symm)
  have hs : Function.Surjective S := by
    rintro ⟨_, x, rfl⟩
    refine ⟨⟨μ.alphaPVM.val A (μ.alphaAnalysis x), ⟨μ.alphaAnalysis x, rfl⟩⟩, ?_⟩
    apply Subtype.ext
    exact congrArg (fun B : X →L[ℝ] X => B x) (μ.alphaCompression A)
  refine ⟨LinearEquiv.ofBijective S ⟨hi, hs⟩, fun z => ?_⟩
  change ‖μ.alphaSynthesis z.1‖ = ‖z.1.1‖
  have hwhole : μ.alphaSynthesis z.1 = z.1.1 MeasSet.whole := rfl
  apply le_antisymm
  · rw [hwhole]
    exact z.1.1.norm_coe_le_norm MeasSet.whole
  · apply (BoundedContinuousFunction.norm_le (norm_nonneg _)).mpr
    intro E
    by_cases he : n ∈ E.1
    · simp [hcoord, he]
    · simpa only [hcoord, he, ite_false, norm_zero] using (norm_nonneg (μ.alphaSynthesis z.1))

#print axioms OVM.alphaAtomIsometry

/-- A normalized basis in each finite-dimensional coordinate can be
summed with geometric weights to generate the entire minimal α-dilation. -/
theorem OVM.nat_alpha_generators_of_rank_le (μ : OVM ℕ X) (r : ℕ)
    (hr : ∀ n, Module.rank ℝ (μ.val (MeasSet.natAtom n)).toLinearMap.range ≤ (r : Cardinal)) :
    ∃ u : Fin r → μ.alphaSubmodule,
      Dense (Submodule.span ℝ (μ.alphaPVM.generatorOrbit u) : Set μ.alphaSubmodule) := by
  classical
  let P := μ.alphaPVM
  let A := MeasSet.natAtom
  let W (n : ℕ) := (P.val (A n)).toLinearMap.range
  let R (n : ℕ) := (μ.val (A n)).toLinearMap.range
  let : ∀ n, Module.Finite ℝ (R n) := fun n => by
    let b := Module.Basis.ofVectorSpace ℝ (R n)
    let := b.finite_index_of_rank_lt_aleph0 ((hr n).trans_lt Cardinal.natCast_lt_aleph0)
    exact Module.Finite.of_basis b
  let e (n : ℕ) : W n ≃ₗᵢ[ℝ] R n := μ.alphaAtomIsometry n
  let : ∀ n, Module.Finite ℝ (W n) := fun n =>
    Module.Finite.of_injective (e n).toLinearMap (e n).injective
  let d (n : ℕ) := Module.finrank ℝ (W n)
  have hd (n : ℕ) : d n ≤ r := by
    change Module.finrank ℝ (W n) ≤ r
    rw [(e n).toLinearEquiv.finrank_eq]
    have hcast : (Module.finrank ℝ (R n) : Cardinal) ≤ (r : Cardinal) := by
      rw [Module.finrank_eq_rank]
      exact hr n
    exact Nat.cast_le.mp hcast
  let b (n : ℕ) : Module.Basis (Fin (d n)) ℝ (W n) := Module.finBasis ℝ (W n)
  let v (n : ℕ) (i : Fin r) : W n :=
    if h : i.val < d n then ‖b n ⟨i, h⟩‖⁻¹ • b n ⟨i, h⟩ else 0
  have hv (n : ℕ) (i : Fin r) : ‖v n i‖ ≤ 1 := by
    unfold v
    split
    · rw [norm_smul, Real.norm_eq_abs, abs_inv, abs_of_nonneg (norm_nonneg _),
        inv_mul_cancel₀ (norm_ne_zero_iff.mpr ((b n).ne_zero _))]
    · rw [norm_zero]
      exact zero_le_one
  let w (n : ℕ) : ℝ := (1 / 2 : ℝ) ^ n
  have hw (n : ℕ) : 0 < w n := by dsimp [w]; positivity
  have hws : Summable w := summable_geometric_of_lt_one (by norm_num) (by norm_num)
  have hvs (i : Fin r) : Summable (fun n => w n • (v n i : μ.alphaSubmodule)) := by
    apply Summable.of_norm
    apply hws.of_nonneg_of_le (fun _ => norm_nonneg _)
    intro n
    rw [norm_smul, Real.norm_of_nonneg (hw n).le]
    exact (mul_le_mul_of_nonneg_left (hv n i) (hw n).le).trans_eq (mul_one _)
  let u (i : Fin r) := ∑' n, w n • (v n i : μ.alphaSubmodule)
  have hp (n k : ℕ) (i : Fin r) :
      P.val (A n) (v k i : μ.alphaSubmodule) =
        if k = n then (v k i : μ.alphaSubmodule) else 0 := by
    obtain ⟨z, hz⟩ := (v k i).2
    change P.val (A k) z = (v k i : μ.alphaSubmodule) at hz
    rw [← hz]
    have hprod := congrArg (fun L : μ.alphaSubmodule →L[ℝ] μ.alphaSubmodule => L z)
      (P.mul_eq (A n) (A k))
    change P.val (A n) (P.val (A k) z) = P.val ((A n).inter (A k)) z at hprod
    rw [hprod]
    by_cases h : k = n
    · subst k
      simp
    · have he : (A n).inter (A k) = MeasSet.empty := by
        apply Subtype.ext
        change ({n} : Set ℕ) ∩ {k} = ∅
        exact eq_empty_iff_forall_notMem.mpr (fun t ht => h ((show t = k from ht.2).symm.trans ht.1))
      simp [h, he, P.empty_eq]
  have hcuts (n : ℕ) (i : Fin r) : P.val (A n) (u i) = w n • (v n i : μ.alphaSubmodule) := by
    have hs := (P.val (A n)).hasSum (hvs i).hasSum
    have hEq : (fun k => P.val (A n) (w k • (v k i : μ.alphaSubmodule))) =
        fun k => if k = n then w n • (v n i : μ.alphaSubmodule) else 0 := by
      funext k
      rw [map_smul, hp]
      by_cases h : k = n
      · subst k
        simp
      · simp [h]
    rw [hEq] at hs
    exact hs.unique (hasSum_ite_eq n _ _)
  refine ⟨u, ?_⟩
  let C := (Submodule.span ℝ (P.generatorOrbit u)).topologicalClosure
  have hvC (n : ℕ) (i : Fin r) : (v n i : μ.alphaSubmodule) ∈ C := by
    have huC : P.val (A n) (u i) ∈ C :=
      subset_closure (Submodule.subset_span ⟨i, A n, rfl⟩)
    rw [hcuts] at huC
    have h := C.smul_mem (w n)⁻¹ huC
    rwa [smul_smul, inv_mul_cancel₀ (hw n).ne', one_smul] at h
  have hbC (n : ℕ) (j : Fin (d n)) : ((b n j : W n) : μ.alphaSubmodule) ∈ C := by
    let i : Fin r := ⟨j, j.isLt.trans_le (hd n)⟩
    have h := hvC n i
    change ((v n i : W n) : μ.alphaSubmodule) ∈ C at h
    have he : v n i = ‖b n j‖⁻¹ • b n j := by
      unfold v
      exact dite_eq_left j.isLt
    rw [he] at h
    have h' := C.smul_mem ‖b n j‖ h
    change ‖b n j‖ • (‖b n j‖⁻¹ • ((b n j : W n) : μ.alphaSubmodule)) ∈ C at h'
    rwa [smul_smul, mul_inv_cancel₀ (norm_ne_zero_iff.mpr ((b n).ne_zero _)), one_smul] at h'
  have hWC (n : ℕ) (z : W n) : (z : μ.alphaSubmodule) ∈ C := by
    have he := congrArg (W n).subtype ((b n).sum_repr z)
    rw [map_sum] at he
    have h : (∑ j, (W n).subtype (((b n).repr z) j • b n j)) ∈ C := by
      apply Submodule.sum_mem
      intro j _
      rw [map_smul]
      exact C.smul_mem _ (hbC n j)
    have hmem : (W n).subtype z ∈ C := he ▸ h
    exact hmem
  intro z
  change z ∈ C
  have hsum : HasSum (fun n => P.val (A n) z) z := by
    have hs := P.toOVM.natAtom_hasSum MeasSet.whole z
    rw [P.normalized] at hs
    simpa only [MeasSet.whole, Set.mem_univ, ite_true, ContinuousLinearMap.id_apply] using hs
  have hclosed : IsClosed (C : Set μ.alphaSubmodule) :=
    (Submodule.span ℝ (P.generatorOrbit u)).isClosed_topologicalClosure
  apply hclosed.mem_of_tendsto hsum
  apply Eventually.of_forall
  intro s
  apply Submodule.sum_mem
  intro n _
  exact hWC n ⟨P.val (A n) z, ⟨z, rfl⟩⟩

#print axioms OVM.nat_alpha_generators_of_rank_le

end AlphaFrameAtoms

section DiscreteFrameEquivalences

open scoped Classical

universe u

variable {X : Type u} [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X]

/-- A Banach dilation and a specified finite family whose orbits span it. -/
structure OVM.NatGeneratedDilation (μ : OVM ℕ X) (r : ℕ) where
  carrier : Type u
  normedGroup : NormedAddCommGroup carrier
  normedScalar : letI := normedGroup; NormedSpace ℝ carrier
  isComplete : letI := normedGroup; CompleteSpace carrier
  dilation : letI := normedGroup; letI := normedScalar; Dilation μ carrier
  generators : Fin r → carrier
  dense_orbits : letI := normedGroup; letI := normedScalar
    Dense (Submodule.span ℝ (dilation.P.generatorOrbit generators) : Set carrier)

/-- The three rank and finite-generation conditions of
prop:discrete-frame-representation, for every r including zero. -/
theorem OVM.nat_rank_generated_equivalences (μ : OVM ℕ X) (hμ : μ.Normalized) (r : ℕ) :
    ((∀ n, Module.rank ℝ (μ.val (MeasSet.natAtom n)).toLinearMap.range ≤ (r : Cardinal)) ↔
      Nonempty (μ.NatGeneratedDilation r)) ∧
    (Nonempty (μ.NatGeneratedDilation r) ↔
      ∃ u : Fin r → μ.alphaSubmodule,
        Dense (Submodule.span ℝ (μ.alphaPVM.generatorOrbit u) : Set μ.alphaSubmodule)) := by
  have hr (D : μ.NatGeneratedDilation r) (n : ℕ) :
      Module.rank ℝ (μ.val (MeasSet.natAtom n)).toLinearMap.range ≤ (r : Cardinal) := by
    let := D.normedGroup
    let := D.normedScalar
    exact D.dilation.nat_rank_le_of_generators D.generators D.dense_orbits n
  have hα : (∃ u : Fin r → μ.alphaSubmodule,
      Dense (Submodule.span ℝ (μ.alphaPVM.generatorOrbit u) : Set μ.alphaSubmodule)) →
      Nonempty (μ.NatGeneratedDilation r) := by
    rintro ⟨u, hu⟩
    exact ⟨⟨μ.alphaSubmodule, inferInstance, inferInstance, inferInstance, μ.alphaDilation hμ, u, hu⟩⟩
  exact ⟨⟨fun h => hα (μ.nat_alpha_generators_of_rank_le r h), fun ⟨D⟩ => hr D⟩,
    ⟨fun ⟨D⟩ => μ.nat_alpha_generators_of_rank_le r (hr D), hα⟩⟩

omit [CompleteSpace X] in
/-- The ranges of the singleton projections of any discrete PVM give the
unique unconditional expansion. Zero ranges can be ignored. -/
theorem PVM.nat_unconditionalDecomposition (P : PVM ℕ X) (x : X) :
    ∃! z : ℕ → X, (∀ n, z n ∈ (P.val (MeasSet.natAtom n)).toLinearMap.range) ∧ HasSum z x := by
  let A := MeasSet.natAtom
  let z (n : ℕ) := P.val (A n) x
  have hsum : HasSum z x := by
    have h := P.toOVM.natAtom_hasSum MeasSet.whole x
    rw [P.normalized] at h
    simpa only [MeasSet.whole, Set.mem_univ, ite_true, ContinuousLinearMap.id_apply] using h
  refine ⟨z, ⟨fun _ => ⟨x, rfl⟩, hsum⟩, fun y ⟨hy, hys⟩ => ?_⟩
  funext n
  have hn := (P.val (A n)).hasSum hys
  have hsingle (k : ℕ) : P.val (A n) (y k) = if k = n then y n else 0 := by
    obtain ⟨q, hq⟩ := hy k
    change P.val (A k) q = y k at hq
    rw [← hq]
    have h := congrArg (fun L : X →L[ℝ] X => L q) (P.mul_eq (A n) (A k))
    change P.val (A n) (P.val (A k) q) = P.val ((A n).inter (A k)) q at h
    rw [h]
    by_cases hk : k = n
    · subst k
      simp [hq]
    · have he : (A n).inter (A k) = MeasSet.empty := by
        apply Subtype.ext
        change ({n} : Set ℕ) ∩ {k} = ∅
        exact eq_empty_iff_forall_notMem.mpr (fun t ht => hk ((show t = k from ht.2).symm.trans ht.1))
      simp [hk, he, P.empty_eq]
  simp_rw [hsingle] at hn
  exact (hasSum_ite_eq n (y n) _).unique hn

#print axioms OVM.nat_rank_generated_equivalences
#print axioms PVM.nat_unconditionalDecomposition

end DiscreteFrameEquivalences

noncomputable section
section MeasurableMultiplierRepresentation

open MeasureTheory
open scoped BoundedContinuousFunction ENNReal

variable {Ω X : Type*} [MeasurableSpace Ω] [NormedAddCommGroup X] [NormedSpace ℝ X]
  [CompleteSpace X]

/-- Weak countable additivity of all scalar coefficients gives the OVM
on the original set function, by the Orlicz–Pettis argument. -/
def OVM.ofWeakCountablyAdditive (A : MeasSet Ω → X →L[ℝ] X)
    (h₀ : A MeasSet.empty = 0)
    (h : ∀ D : ℕ → MeasSet Ω, MeasSet.DisjointSeq D → ∀ (x : X) (f : Dual X),
      HasSum (fun n => f (A (D n) x)) (f (A (MeasSet.iUnion D) x))) : OVM Ω X where
  val := A
  empty_eq := h₀
  countably_additive D hD x := by
    let B (b : ℕ → Bool) (n : ℕ) := if b n then D n else MeasSet.empty
    have hB (b : ℕ → Bool) : MeasSet.DisjointSeq (B b) := by
      intro i j hij
      cases hi : b i <;> cases hj : b j <;> simp [B, hi, hj, MeasSet.empty]
      exact hD hij
    let F (b : ℕ → Bool) := A (MeasSet.iUnion (B b)) x
    have hs (b : ℕ → Bool) (f : Dual X) :
        HasSum (fun n => if b n then f (A (D n) x) else 0) (f (F b)) := by
      have he (n : ℕ) : f (A (B b n) x) = if b n then f (A (D n) x) else 0 := by
        cases hb : b n <;> simp [B, hb, h₀]
      simpa only [he] using h (B b) (hB b) x f
    simpa [F, B] using hasSum_of_weak_subseries (fun n => A (D n) x) F hs

abbrev DiscreteBoundedRealFunctions (Ω : Type*) := @BoundedContinuousFunction Ω ℝ ⊥ _

omit [MeasurableSpace Ω] in
private theorem discreteBounded_norm_apply_le (a : DiscreteBoundedRealFunctions Ω) (t : Ω) :
    ‖a t‖ ≤ ‖a‖ := by
  let : TopologicalSpace Ω := ⊥
  exact BoundedContinuousFunction.norm_coe_le_norm a t

/-- Actual bounded measurable functions with the supremum norm and pointwise
algebra operations. Continuity here refers to the discrete topology. -/
def boundedMeasurableAlgebra (Ω : Type*) [MeasurableSpace Ω] :
    Subalgebra ℝ (DiscreteBoundedRealFunctions Ω) where
  carrier := {a | Measurable a}
  mul_mem' := fun ha hb => ha.mul hb
  add_mem' := fun ha hb => ha.add hb
  algebraMap_mem' := fun _ => measurable_const

local instance (priority := 2000) (Ω : Type*) [MeasurableSpace Ω] :
    Semiring (boundedMeasurableAlgebra Ω) :=
  (boundedMeasurableAlgebra Ω).toRing.toSemiring

/-- The characteristic function of a measurable set in the multiplier algebra. -/
noncomputable def measurableIndicator (E : MeasSet Ω) : boundedMeasurableAlgebra Ω := by
  letI : TopologicalSpace Ω := ⊥
  letI : DiscreteTopology Ω := ⟨rfl⟩
  let g : Ω → ℝ := E.1.indicator 1
  let h : DiscreteBoundedRealFunctions Ω := BoundedContinuousFunction.mkOfBound
    ⟨g, continuous_of_discreteTopology⟩ 1 (fun s t => by
      by_cases hs : s ∈ E.1 <;> by_cases ht : t ∈ E.1 <;>
        simp [g, hs, ht, Real.dist_eq])
  exact ⟨h, measurable_const.indicator E.2⟩

theorem measurableIndicator_apply (E : MeasSet Ω) (t : Ω) :
    (measurableIndicator E).1 t = E.1.indicator (fun _ => (1 : ℝ)) t := rfl

omit [CompleteSpace X] in
private theorem OVM.exists_orbitDensity (μ : OVM Ω X) (x : X) (f : Dual X) :
    ∃ (ρ : Measure Ω) (h : Ω → ℝ), Measurable h ∧ Integrable h ρ ∧
      ∀ E : MeasSet Ω, f (μ.val E x) = ∫ t in E.1, h t ∂ρ := by
  let m := μ.orbitCharge x f
  have hca : m.CountablyAdditive := fun E hE => μ.normal_J x E hE f
  refine ⟨m.variationMeasure, m.exists_rnDensity hca m.variationMeasure (fun E hE => ?_)⟩
  rw [m.variationMeasure_apply hca E, ENNReal.ofReal_eq_zero] at hE
  have hp := m.positivePart_positive E
  have hq := m.neg.positivePart_positive E
  rw [m.val_eq_positive_sub_negative E]
  linarith

/-- The multiplier constructed by uniform approximation, evaluated on
all normal coefficients whenever a scalar density is supplied. -/
noncomputable def OVM.boundedMeasurableMultiplier (μ : OVM Ω X)
    (a : boundedMeasurableAlgebra Ω) : X →L[ℝ] X :=
  (μ.exists_boundedMultiplier a.1 a.2 ‖a.1‖
    (fun t => by simpa only [Real.norm_eq_abs] using discreteBounded_norm_apply_le a.1 t)).choose

theorem OVM.boundedMeasurableMultiplier_coeff (μ : OVM Ω X) (a : boundedMeasurableAlgebra Ω)
    (ξ : Bidual X) (f : Dual X) (ρ : Measure Ω) (h : Ω → ℝ) (hi : Integrable h ρ)
    (hd : ∀ E : MeasSet Ω, ξ (adjoint (μ.val E) f) = ∫ t in E.1, h t ∂ρ) :
    ξ (adjoint (μ.boundedMeasurableMultiplier a) f) = ∫ t, a.1 t * h t ∂ρ :=
  (μ.exists_boundedMultiplier a.1 a.2 ‖a.1‖
    (fun t => by simpa only [Real.norm_eq_abs] using discreteBounded_norm_apply_le a.1 t)).choose_spec
    ξ f ρ h hi hd

private theorem OVM.boundedMeasurableMultiplier_orbit (μ : OVM Ω X)
    (a : boundedMeasurableAlgebra Ω) (x : X) (f : Dual X) (ρ : Measure Ω) (h : Ω → ℝ)
    (hi : Integrable h ρ) (hd : ∀ E : MeasSet Ω, f (μ.val E x) = ∫ t in E.1, h t ∂ρ) :
    f (μ.boundedMeasurableMultiplier a x) = ∫ t, a.1 t * h t ∂ρ :=
  μ.boundedMeasurableMultiplier_coeff a (J x) f ρ h hi hd

private theorem integrable_boundedMeasurable_mul (a : boundedMeasurableAlgebra Ω)
    {ρ : Measure Ω} {h : Ω → ℝ} (hi : Integrable h ρ) :
    Integrable (fun t => a.1 t * h t) ρ :=
  hi.bdd_mul (c := ‖a.1‖) a.2.aestronglyMeasurable
    (Eventually.of_forall (discreteBounded_norm_apply_le a.1))

/-- The scalar density of the orbit after applying a multiplier is
obtained by multiplying the original density by that function. -/
theorem PVM.boundedMeasurableMultiplier_cut (P : PVM Ω X)
    (a : boundedMeasurableAlgebra Ω) (x : X) (f : Dual X) (ρ : Measure Ω) (h : Ω → ℝ)
    (hi : Integrable h ρ) (hd : ∀ E : MeasSet Ω, f (P.val E x) = ∫ t in E.1, h t ∂ρ)
    (E : MeasSet Ω) :
    f (P.val E (P.toOVM.boundedMeasurableMultiplier a x)) = ∫ t in E.1, a.1 t * h t ∂ρ := by
  let k := E.1.indicator h
  have hk : Integrable k ρ := hi.indicator E.2
  have hcut (F : MeasSet Ω) : (adjoint (P.val E) f) (P.val F x) = ∫ t in F.1, k t ∂ρ := by
    have he := congrArg (fun L : X →L[ℝ] X => f (L x)) (P.mul_eq E F)
    change (adjoint (P.val E) f) (P.val F x) = f (P.val (E.inter F) x) at he
    rw [he, hd, setIntegral_indicator E.2]
    exact congrArg (fun A : Set Ω => ∫ t in A, h t ∂ρ) (inter_comm _ _)
  have he := P.toOVM.boundedMeasurableMultiplier_orbit a x (adjoint (P.val E) f) ρ k hk hcut
  change f (P.val E (P.toOVM.boundedMeasurableMultiplier a x)) = _ at he
  rw [he, ← integral_indicator E.2]
  apply congrArg (fun q : Ω → ℝ => ∫ t, q t ∂ρ)
  funext t
  by_cases ht : t ∈ E.1 <;> simp [k, ht]

/-- The unital algebra representation in rem:ovm-bounds. -/
noncomputable def PVM.boundedMeasurableRepresentation (P : PVM Ω X) :
    boundedMeasurableAlgebra Ω →ₐ[ℝ] (X →L[ℝ] X) where
  toFun := P.toOVM.boundedMeasurableMultiplier
  map_zero' := by
    ext x
    apply eq_of_dual_eval
    intro g
    obtain ⟨ρ, h, _, hi, hd⟩ := P.toOVM.exists_orbitDensity x g
    rw [P.toOVM.boundedMeasurableMultiplier_orbit _ x g ρ h hi hd]
    simp
  map_one' := by
    ext x
    apply eq_of_dual_eval
    intro g
    obtain ⟨ρ, h, _, hi, hd⟩ := P.toOVM.exists_orbitDensity x g
    rw [P.toOVM.boundedMeasurableMultiplier_orbit _ x g ρ h hi hd]
    have hx := hd MeasSet.whole
    rw [P.normalized] at hx
    simpa [MeasSet.whole] using hx.symm
  map_add' a b := by
    ext x
    apply eq_of_dual_eval
    intro g
    obtain ⟨ρ, h, _, hi, hd⟩ := P.toOVM.exists_orbitDensity x g
    change g (P.toOVM.boundedMeasurableMultiplier (a + b) x) =
      g (P.toOVM.boundedMeasurableMultiplier a x + P.toOVM.boundedMeasurableMultiplier b x)
    rw [map_add, P.toOVM.boundedMeasurableMultiplier_orbit _ x g ρ h hi hd,
      P.toOVM.boundedMeasurableMultiplier_orbit a x g ρ h hi hd,
      P.toOVM.boundedMeasurableMultiplier_orbit b x g ρ h hi hd]
    change (∫ t, (a.1 t + b.1 t) * h t ∂ρ) =
      (∫ t, a.1 t * h t ∂ρ) + ∫ t, b.1 t * h t ∂ρ
    simp only [add_mul]
    exact integral_add (integrable_boundedMeasurable_mul a hi) (integrable_boundedMeasurable_mul b hi)
  map_mul' a b := by
    ext x
    apply eq_of_dual_eval
    intro g
    obtain ⟨ρ, h, _, hi, hd⟩ := P.toOVM.exists_orbitDensity x g
    change g (P.toOVM.boundedMeasurableMultiplier (a * b) x) =
      g (P.toOVM.boundedMeasurableMultiplier a (P.toOVM.boundedMeasurableMultiplier b x))
    rw [P.toOVM.boundedMeasurableMultiplier_orbit _ x g ρ h hi hd,
      P.toOVM.boundedMeasurableMultiplier_orbit a _ g ρ _ (integrable_boundedMeasurable_mul b hi)
        (P.boundedMeasurableMultiplier_cut b x g ρ h hi hd)]
    change (∫ t, (a.1 t * b.1 t) * h t ∂ρ) = ∫ t, a.1 t * (b.1 t * h t) ∂ρ
    simp only [mul_assoc]
  commutes' c := by
    ext x
    apply eq_of_dual_eval
    intro g
    obtain ⟨ρ, h, _, hi, hd⟩ := P.toOVM.exists_orbitDensity x g
    change g (P.toOVM.boundedMeasurableMultiplier (algebraMap ℝ (boundedMeasurableAlgebra Ω) c) x) =
      g (c • x)
    rw [P.toOVM.boundedMeasurableMultiplier_orbit _ x g ρ h hi hd, map_smul, smul_eq_mul]
    have hx := hd MeasSet.whole
    rw [P.normalized] at hx
    simpa [MeasSet.whole, integral_const_mul] using congrArg (c * ·) hx.symm

#print axioms PVM.boundedMeasurableRepresentation
#print axioms PVM.boundedMeasurableMultiplier_cut

theorem PVM.boundedMeasurableRepresentation_indicator (P : PVM Ω X) (E : MeasSet Ω) :
    P.boundedMeasurableRepresentation (measurableIndicator E) = P.val E := by
  ext x
  apply eq_of_dual_eval
  intro f
  obtain ⟨ρ, h, _, hi, hd⟩ := P.toOVM.exists_orbitDensity x f
  change f (P.toOVM.boundedMeasurableMultiplier (measurableIndicator E) x) = f (P.val E x)
  rw [P.toOVM.boundedMeasurableMultiplier_orbit _ x f ρ h hi hd, hd E, ← integral_indicator E.2]
  apply congrArg (fun q : Ω → ℝ => ∫ t, q t ∂ρ)
  funext t
  by_cases ht : t ∈ E.1 <;> simp [measurableIndicator_apply, ht]

#print axioms PVM.boundedMeasurableRepresentation_indicator

private theorem OVM.orbitDensity_integral_norm_le (μ : OVM Ω X) (x : X) (f : Dual X)
    (ρ : Measure Ω) (h : Ω → ℝ) (hm : Measurable h) (hi : Integrable h ρ)
    (hd : ∀ E : MeasSet Ω, f (μ.val E x) = ∫ t in E.1, h t ∂ρ) :
    (∫ t, ‖h t‖ ∂ρ) ≤ 2 * μ.uniformNorm * ‖x‖ * ‖f‖ := by
  let E : MeasSet Ω := ⟨{t | 0 ≤ h t}, measurableSet_le measurable_const hm⟩
  let B : MeasSet Ω := ⟨E.1ᶜ, E.2.compl⟩
  have he : (∫ t in E.1, ‖h t‖ ∂ρ) = ∫ t in E.1, h t ∂ρ :=
    setIntegral_congr_fun E.2 fun t ht => Real.norm_of_nonneg ht
  have hb : (∫ t in B.1, ‖h t‖ ∂ρ) = -(∫ t in B.1, h t ∂ρ) := by
    rw [← integral_neg]
    exact setIntegral_congr_fun B.2 fun t ht => Real.norm_of_nonpos (le_of_not_ge ht)
  have hbound (A : MeasSet Ω) : |∫ t in A.1, h t ∂ρ| ≤ ‖f‖ * (μ.uniformNorm * ‖x‖) := by
    rw [← hd A]
    exact (f.le_opNorm _).trans (mul_le_mul_of_nonneg_left
      (((μ.val A).le_opNorm x).trans
        (mul_le_mul_of_nonneg_right (μ.opNorm_le_uniformNorm A) (norm_nonneg x))) (norm_nonneg f))
  have hsplit : (∫ t in E.1, ‖h t‖ ∂ρ) + (∫ t in B.1, ‖h t‖ ∂ρ) = ∫ t, ‖h t‖ ∂ρ :=
    integral_add_compl E.2 hi.norm
  rw [← hsplit, he, hb]
  calc
    _ ≤ |∫ t in E.1, h t ∂ρ| + |∫ t in B.1, h t ∂ρ| :=
      add_le_add (le_abs_self _) (neg_le_abs _)
    _ ≤ _ := (add_le_add (hbound E) (hbound B)).trans_eq (by ring)

private theorem OVM.norm_boundedMeasurableMultiplier_apply_le (μ : OVM Ω X)
    (a : boundedMeasurableAlgebra Ω) (x : X) (C : ℝ) (hC : 0 ≤ C)
    (hb : ∀ f : Dual X, ∃ (ρ : Measure Ω) (h : Ω → ℝ), Measurable h ∧ Integrable h ρ ∧
      (∀ E : MeasSet Ω, f (μ.val E x) = ∫ t in E.1, h t ∂ρ) ∧
        ∀ᵐ t ∂ρ, ‖a.1 t * h t‖ ≤ C * ‖h t‖) :
    ‖μ.boundedMeasurableMultiplier a x‖ ≤ 2 * μ.uniformNorm * C * ‖x‖ := by
  let y := μ.boundedMeasurableMultiplier a x
  change ‖y‖ ≤ _
  by_cases hy : y = 0
  · rw [hy, norm_zero]
    have hM := μ.uniformNorm_nonneg
    positivity
  · obtain ⟨f, hf, hfy⟩ := exists_dual_vector ℝ y (norm_ne_zero_iff.mpr hy)
    obtain ⟨ρ, h, hm, hi, hd, hbound⟩ := hb f
    have he := μ.boundedMeasurableMultiplier_orbit a x f ρ h hi hd
    change f y = _ at he
    rw [hfy] at he
    change ‖y‖ = _ at he
    rw [he]
    calc
      _ ≤ ‖∫ t, a.1 t * h t ∂ρ‖ := le_abs_self _
      _ ≤ ∫ t, ‖a.1 t * h t‖ ∂ρ := norm_integral_le_integral_norm _
      _ ≤ ∫ t, C * ‖h t‖ ∂ρ :=
        integral_mono_ae (integrable_boundedMeasurable_mul a hi).norm (hi.norm.const_mul C)
          hbound
      _ = C * (∫ t, ‖h t‖ ∂ρ) := integral_const_mul _ _
      _ ≤ _ := (mul_le_mul_of_nonneg_left (μ.orbitDensity_integral_norm_le x f ρ h hm hi hd) hC).trans_eq
        (by rw [hf, mul_one]; ring)

/-- The operator-norm estimate in rem:ovm-bounds. -/
theorem OVM.norm_boundedMeasurableMultiplier_le (μ : OVM Ω X) (a : boundedMeasurableAlgebra Ω) :
    ‖μ.boundedMeasurableMultiplier a‖ ≤ 2 * μ.uniformNorm * ‖a.1‖ := by
  have hM := μ.uniformNorm_nonneg
  apply ContinuousLinearMap.opNorm_le_bound _ (by positivity)
  intro x
  apply μ.norm_boundedMeasurableMultiplier_apply_le a x _ (norm_nonneg _)
  intro f
  obtain ⟨ρ, h, hm, hi, hd⟩ := μ.exists_orbitDensity x f
  refine ⟨ρ, h, hm, hi, hd, ?_⟩
  exact Eventually.of_forall fun t => (norm_mul _ _).trans_le
    (mul_le_mul_of_nonneg_right (discreteBounded_norm_apply_le a.1 t) (norm_nonneg _))

#print axioms OVM.norm_boundedMeasurableMultiplier_le

/-- Almost-everywhere equality to zero defines the ideal used in the
bounded-representative model of L-infinity. -/
def boundedMeasurableNullIdeal (ρ : Measure Ω) : Ideal (boundedMeasurableAlgebra Ω) where
  carrier := {a | ∀ᵐ t ∂ρ, a.1 t = 0}
  zero_mem' := by
    change ∀ᵐ t ∂ρ, (0 : DiscreteBoundedRealFunctions Ω) t = 0
    exact Eventually.of_forall fun _ => rfl
  add_mem' := by
    intro a b ha hb
    change (∀ᵐ t ∂ρ, a.1 t = 0) at ha
    change (∀ᵐ t ∂ρ, b.1 t = 0) at hb
    change ∀ᵐ t ∂ρ, (a + b).1 t = 0
    filter_upwards [ha, hb] with t hat hbt
    change a.1 t + b.1 t = 0
    rw [hat, hbt, add_zero]
  smul_mem' := by
    intro c a ha
    change (∀ᵐ t ∂ρ, a.1 t = 0) at ha
    change ∀ᵐ t ∂ρ, (c * a).1 t = 0
    filter_upwards [ha] with t hat
    change c.1 t * a.1 t = 0
    rw [hat, mul_zero]

abbrev BoundedMeasurableQuotient (ρ : Measure Ω) :=
  ↥(boundedMeasurableAlgebra Ω) ⧸ boundedMeasurableNullIdeal ρ

private theorem PVM.boundedMeasurableMultiplier_eq_zero (P : PVM Ω X) (ρ : Measure Ω)
    [IsFiniteMeasure ρ] (hρ : ∀ E : MeasSet Ω, ρ E.1 = 0 → P.val E = 0)
    (a : boundedMeasurableAlgebra Ω) (ha : ∀ᵐ t ∂ρ, a.1 t = 0) :
    P.boundedMeasurableRepresentation a = 0 := by
  ext x
  apply eq_of_dual_eval
  intro f
  obtain ⟨h, _, hi, hd⟩ := P.exists_normalCoefficient_density ρ hρ (J x) (P.toOVM.normal_J x) f
  rw [zero_apply, map_zero]
  change f (P.toOVM.boundedMeasurableMultiplier a x) = 0
  rw [P.toOVM.boundedMeasurableMultiplier_orbit a x f ρ h hi hd]
  have he : (fun t => a.1 t * h t) =ᵐ[ρ] (fun _ => (0 : ℝ)) :=
    ha.mono fun t ht => by simp only [ht, zero_mul]
  rw [integral_congr_ae he, integral_zero]

/-- The algebra homomorphism on the almost-everywhere quotient. -/
noncomputable def PVM.boundedMeasurableQuotientRepresentation (P : PVM Ω X) (ρ : Measure Ω)
    [IsFiniteMeasure ρ] (hρ : ∀ E : MeasSet Ω, ρ E.1 = 0 → P.val E = 0) :
    BoundedMeasurableQuotient ρ →ₐ[ℝ] (X →L[ℝ] X) :=
  Ideal.Quotient.liftₐ (boundedMeasurableNullIdeal ρ) P.boundedMeasurableRepresentation
    (fun a ha => P.boundedMeasurableMultiplier_eq_zero ρ hρ a ha)

theorem PVM.boundedMeasurableQuotientRepresentation_mk (P : PVM Ω X) (ρ : Measure Ω)
    [IsFiniteMeasure ρ] (hρ : ∀ E : MeasSet Ω, ρ E.1 = 0 → P.val E = 0)
    (a : boundedMeasurableAlgebra Ω) :
    P.boundedMeasurableQuotientRepresentation ρ hρ (Ideal.Quotient.mk _ a) =
      P.boundedMeasurableRepresentation a := rfl

/-- The norm estimate uses an essential bound on the representative. -/
theorem PVM.norm_boundedMeasurableQuotientRepresentation_le (P : PVM Ω X) (ρ : Measure Ω)
    [IsFiniteMeasure ρ] (hρ : ∀ E : MeasSet Ω, ρ E.1 = 0 → P.val E = 0)
    (a : boundedMeasurableAlgebra Ω) (C : ℝ) (hC : 0 ≤ C) (ha : ∀ᵐ t ∂ρ, ‖a.1 t‖ ≤ C) :
    ‖P.boundedMeasurableQuotientRepresentation ρ hρ (Ideal.Quotient.mk _ a)‖ ≤
      2 * P.toOVM.uniformNorm * C := by
  have hM := P.toOVM.uniformNorm_nonneg
  apply ContinuousLinearMap.opNorm_le_bound _ (by positivity)
  intro x
  change ‖P.toOVM.boundedMeasurableMultiplier a x‖ ≤ _
  apply P.toOVM.norm_boundedMeasurableMultiplier_apply_le a x C hC
  intro f
  obtain ⟨h, hm, hi, hd⟩ := P.exists_normalCoefficient_density ρ hρ (J x) (P.toOVM.normal_J x) f
  refine ⟨ρ, h, hm, hi, hd, ha.mono ?_⟩
  intro t ht
  rw [norm_mul]
  exact mul_le_mul_of_nonneg_right ht (norm_nonneg _)

theorem boundedMeasurableQuotient_mk_eq_iff (ρ : Measure Ω) (a b : boundedMeasurableAlgebra Ω) :
    Ideal.Quotient.mk (boundedMeasurableNullIdeal ρ) a =
      Ideal.Quotient.mk (boundedMeasurableNullIdeal ρ) b ↔ a.1 =ᵐ[ρ] b.1 := by
  rw [Ideal.Quotient.mk_eq_mk_iff_sub_mem]
  change (∀ᵐ t ∂ρ, a.1 t - b.1 t = 0) ↔ ∀ᵐ t ∂ρ, a.1 t = b.1 t
  exact eventually_congr (Eventually.of_forall fun _ => sub_eq_zero)

theorem PVM.boundedMeasurableRepresentation_eq_zero_iff (P : PVM Ω X) (ρ : Measure Ω)
    [IsFiniteMeasure ρ] (hρ : ∀ E : MeasSet Ω, ρ E.1 = 0 ↔ P.val E = 0)
    (a : boundedMeasurableAlgebra Ω) :
    P.boundedMeasurableRepresentation a = 0 ↔ ∀ᵐ t ∂ρ, a.1 t = 0 := by
  refine ⟨fun h => ?_, P.boundedMeasurableMultiplier_eq_zero ρ (fun E => (hρ E).mp) a⟩
  let A : MeasSet Ω := ⟨{t | a.1 t ≠ 0}, (measurableSet_eq_fun a.2 measurable_const).compl⟩
  apply ae_iff.mpr
  apply (hρ A).mpr
  ext x
  apply eq_of_dual_eval
  intro f
  obtain ⟨k, _, hki, hd⟩ :=
    P.exists_normalCoefficient_density ρ (fun E => (hρ E).mp) (J x) (P.toOVM.normal_J x) f
  have hz (s : Set Ω) (hs : MeasurableSet s) : ∫ t in s, a.1 t * k t ∂ρ = 0 := by
    rw [← P.boundedMeasurableMultiplier_cut a x f ρ k hki hd ⟨s, hs⟩]
    have he : P.toOVM.boundedMeasurableMultiplier a = 0 := h
    rw [he, zero_apply, map_zero, map_zero]
  have hprod : (fun t => a.1 t * k t) =ᵐ[ρ] 0 :=
    ae_eq_zero_of_forall_setIntegral_eq_of_sigmaFinite
      (fun _ _ _ => (integrable_boundedMeasurable_mul a hki).integrableOn) (fun s hs _ => hz s hs)
  have hA : A.1.indicator k =ᵐ[ρ] (fun _ => (0 : ℝ)) := by
    filter_upwards [hprod] with t ht
    by_cases hmem : t ∈ A.1
    · rw [Set.indicator_of_mem hmem]
      exact (mul_eq_zero.mp ht).resolve_left hmem
    · exact Set.indicator_of_notMem hmem _
  rw [zero_apply, show f (P.val A x) = ∫ t in A.1, k t ∂ρ from hd A,
    ← integral_indicator A.2, integral_congr_ae hA, integral_zero, map_zero]

/-- A faithful finite control measure yields an injective representation
of the algebra of essentially bounded classes. -/
theorem PVM.boundedMeasurableQuotientRepresentation_injective (P : PVM Ω X) (ρ : Measure Ω)
    [IsFiniteMeasure ρ] (hρ : ∀ E : MeasSet Ω, ρ E.1 = 0 ↔ P.val E = 0) :
    Function.Injective (P.boundedMeasurableQuotientRepresentation ρ (fun E => (hρ E).mp)) := by
  let π := P.boundedMeasurableQuotientRepresentation ρ (fun E => (hρ E).mp)
  apply (injective_iff_map_eq_zero π).mpr
  intro c hc
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective c
  apply Ideal.Quotient.eq_zero_iff_mem.mpr
  exact (P.boundedMeasurableRepresentation_eq_zero_iff ρ hρ a).mp hc

/-- Every element of the library L-infinity space has a measurable
representative bounded on the whole sample space. -/
theorem exists_boundedMeasurable_representative (ρ : Measure Ω) (a : Lp ℝ ⊤ ρ) :
    ∃ b : boundedMeasurableAlgebra Ω, b.1 =ᵐ[ρ] a := by
  have hf := (Lp.stronglyMeasurable a).measurable
  let b (t : Ω) : ℝ := max (-‖a‖) (min ‖a‖ (a t))
  let : TopologicalSpace Ω := ⊥
  let : DiscreteTopology Ω := ⟨rfl⟩
  have hB (t : Ω) : |b t| ≤ ‖a‖ := by
    exact abs_le.mpr ⟨le_max_left _ _, max_le (by simp) (min_le_left _ _)⟩
  let c : DiscreteBoundedRealFunctions Ω := BoundedContinuousFunction.mkOfBound
    ⟨b, continuous_of_discreteTopology⟩ (2 * ‖a‖) fun s t => by
      rw [Real.dist_eq, two_mul]
      exact (abs_sub _ _).trans (add_le_add (hB s) (hB t))
  refine ⟨⟨c, measurable_const.max (measurable_const.min hf)⟩, ?_⟩
  have ha : ∀ᵐ t ∂ρ, ‖a t‖ ≤ ‖a‖ := by
    have hfin := (Lp.memLp a).eLpNorm_ne_top
    filter_upwards [ae_le_eLpNormEssSup (f := fun t => a t)] with t ht
    rw [Lp.norm_def]
    have h : ‖a t‖ₑ ≤ eLpNorm a ⊤ ρ := by
      rwa [eLpNorm_exponent_top (Lp.memLp a).aestronglyMeasurable]
    simpa only [← ofReal_norm, ENNReal.toReal_ofReal (norm_nonneg _)] using
      ENNReal.toReal_mono hfin h
  filter_upwards [ha] with t ht
  change b t = a t
  have h := abs_le.mp (show |a t| ≤ ‖a‖ from ht)
  dsimp [b]
  rw [min_eq_right h.2, max_eq_right h.1]

#print axioms OVM.ofWeakCountablyAdditive
#print axioms PVM.boundedMeasurableQuotientRepresentation_mk
#print axioms PVM.norm_boundedMeasurableQuotientRepresentation_le
#print axioms PVM.boundedMeasurableQuotientRepresentation_injective
#print axioms exists_boundedMeasurable_representative

end MeasurableMultiplierRepresentation
end

section BadeCompleteness

open MeasureTheory
open scoped ENNReal

variable {Ω X : Type*} [MeasurableSpace Ω] [NormedAddCommGroup X] [NormedSpace ℝ X]

private theorem measure_eq_zero_diff_of_ae_le {ρ : Measure Ω} {A B : Set Ω}
    (h : A ≤ᵐ[ρ] B) : ρ (A \ B) = 0 := by
  have he : {x | ¬ (x ∈ A → x ∈ B)} = A \ B := by ext x; simp
  have hz := (ae_iff (p := fun x => x ∈ A → x ∈ B)).mp h
  rwa [he] at hz

private theorem PVM.val_inter_eq_of_ae_le (P : PVM Ω X) (ρ : Measure Ω)
    (hρ : ∀ E : MeasSet Ω, ρ E.1 = 0 → P.val E = 0)
    (A B : MeasSet Ω) (h : A.1 ≤ᵐ[ρ] B.1) :
    P.val (A.inter B) = P.val A := by
  have hzero := hρ (A.diff B) (measure_eq_zero_diff_of_ae_le h)
  have hu : (A.inter B).union (A.diff B) = A := by
    apply Subtype.ext
    exact Set.inter_union_sdiff _ _
  ext x
  have he := P.toOVM.apply_union (A.inter B) (A.diff B)
    (Set.disjoint_left.mpr fun t ht hu => hu.2 ht.2) x
  rw [hu, hzero, zero_apply, add_zero] at he
  exact he.symm

/-- The supremum of an increasing family in a finite measure algebra is
the union of countably many members. The approximating finite unions are
eventually below the family in the almost-everywhere order. -/
private theorem exists_countable_measureSup {ι : Type*} [Nonempty ι] [Preorder ι]
    [IsDirectedOrder ι] (ρ : Measure Ω) [IsFiniteMeasure ρ] (A : ι → MeasSet Ω)
    (hA : ∀ ⦃i j⦄, i ≤ j → (A i).1 ≤ᵐ[ρ] (A j).1) :
    ∃ (D : ℕ → MeasSet Ω) (j : ℕ → ι), Monotone (fun n => (D n).1) ∧
      (∀ n i, j n ≤ i → (D n).1 ≤ᵐ[ρ] (A i).1) ∧
      ∀ i, (A i).1 ≤ᵐ[ρ] (MeasSet.iUnion D).1 := by
  classical
  let m (i : ι) := (ρ (A i).1).toReal
  let β := sSup (Set.range m)
  have hmb : BddAbove (Set.range m) := ⟨(ρ univ).toReal, by
    rintro _ ⟨i, rfl⟩
    exact ENNReal.toReal_mono (measure_ne_top _ _) (measure_mono (subset_univ _))⟩
  have hle (i : ι) : m i ≤ β := le_csSup hmb ⟨i, rfl⟩
  have hβ : 0 ≤ β := ENNReal.toReal_nonneg.trans (hle (Classical.choice ‹Nonempty ι›))
  let δ (n : ℕ) : ℝ := 1 / ((n : ℝ) + 1)
  have hδ (n : ℕ) : 0 < δ n := by dsimp [δ]; positivity
  have hnear (n : ℕ) : ∃ i, β - δ n < m i := by
    obtain ⟨_, ⟨i, rfl⟩, hi⟩ := exists_lt_of_lt_csSup (Set.range_nonempty m)
      (show β - δ n < β by linarith [hδ n])
    exact ⟨i, hi⟩
  choose i hi using hnear
  choose supIndex hleft hright using (exists_ge_ge : ∀ a b : ι, ∃ c, a ≤ c ∧ b ≤ c)
  let j : ℕ → ι := Nat.rec (i 0) (fun n p => supIndex p (i (n + 1)))
  have hij (n k : ℕ) (hk : k ≤ n) : i k ≤ j n := by
    induction n with
    | zero =>
      have : k = 0 := Nat.eq_zero_of_le_zero hk
      subst k
      exact le_rfl
    | succ n ih =>
      by_cases hn : k ≤ n
      · exact (ih hn).trans (hleft (j n) (i (n + 1)))
      · have he : k = n + 1 := by omega
        rw [he]
        exact hright (j n) (i (n + 1))
  let D (n : ℕ) : MeasSet Ω :=
    ⟨⋃ k ≤ n, (A (i k)).1, MeasurableSet.iUnion fun k => MeasurableSet.iUnion fun _ => (A (i k)).2⟩
  have hD (n : ℕ) (b : ι) (hb : j n ≤ b) : (D n).1 ≤ᵐ[ρ] (A b).1 := by
    have he : ∀ᵐ t ∂ρ, ∀ k : ℕ, k ≤ n → t ∈ (A (i k)).1 → t ∈ (A b).1 := by
      apply ae_all_iff.mpr
      intro k
      by_cases hk : k ≤ n
      · exact (hA ((hij n k hk).trans hb)).mono fun _ h _ => h
      · exact Eventually.of_forall fun _ h => (hk h).elim
    filter_upwards [he] with t ht
    intro hd
    obtain ⟨k, hk, hmem⟩ := mem_iUnion₂.mp hd
    exact ht k hk hmem
  have hmono : Monotone (fun n => (D n).1) := by
    intro n k hnk t ht
    obtain ⟨l, hl, htl⟩ := mem_iUnion₂.mp ht
    exact mem_iUnion₂.mpr ⟨l, hl.trans hnk, htl⟩
  refine ⟨D, j, hmono, hD, fun a => ?_⟩
  let B := MeasSet.iUnion D
  have hU : ∀ n, ρ ((D n).1 ∪ (A a).1) ≤ ENNReal.ofReal β := by
    intro n
    obtain ⟨p, hp, ha⟩ := exists_ge_ge (j n) a
    have hsub : (D n).1 ∪ (A a).1 ≤ᵐ[ρ] (A p).1 := by
      filter_upwards [hD n p hp, hA ha] with t ht₁ ht₂
      exact fun ht => ht.elim ht₁ ht₂
    exact (measure_mono_ae hsub).trans ((ENNReal.le_ofReal_iff_toReal_le (measure_ne_top _ _) hβ).mpr (hle p))
  have hUB : ρ (B.1 ∪ (A a).1) ≤ ENNReal.ofReal β := by
    have he : B.1 ∪ (A a).1 = ⋃ n, (D n).1 ∪ (A a).1 := by
      ext t
      constructor
      · rintro (ht | ht)
        · obtain ⟨n, hn⟩ := mem_iUnion.mp ht
          exact mem_iUnion.mpr ⟨n, Or.inl hn⟩
        · exact mem_iUnion.mpr ⟨0, Or.inr ht⟩
      · intro ht
        obtain ⟨n, hn⟩ := mem_iUnion.mp ht
        exact hn.elim (fun hz => Or.inl (mem_iUnion.mpr ⟨n, hz⟩)) Or.inr
    rw [he, Monotone.measure_iUnion (fun n k h => Set.union_subset_union (hmono h) Subset.rfl)]
    exact iSup_le hU
  have hB : ENNReal.ofReal β ≤ ρ B.1 := by
    have hsub (n : ℕ) : (A (i n)).1 ⊆ B.1 := fun t ht =>
      mem_iUnion.mpr ⟨n, mem_iUnion₂.mpr ⟨n, le_rfl, ht⟩⟩
    have hlow (n : ℕ) : β - δ n < (ρ B.1).toReal :=
      (hi n).trans_le (ENNReal.toReal_mono (measure_ne_top _ _) (measure_mono (hsub n)))
    have hb : β ≤ (ρ B.1).toReal := by
      by_contra! hn
      have ht : Tendsto δ atTop (𝓝 0) := tendsto_one_div_add_atTop_nhds_zero_nat
      obtain ⟨n, h⟩ := eventually_atTop.mp ((tendsto_order.mp ht).2 _ (sub_pos.mpr hn))
      linarith [h n le_rfl, hlow n]
    rw [← ENNReal.ofReal_toReal (measure_ne_top ρ B.1)]
    exact ENNReal.ofReal_le_ofReal hb
  have heq : ρ (B.1 ∪ (A a).1) = ρ B.1 :=
    le_antisymm (hUB.trans hB) (measure_mono Set.subset_union_left)
  have hdiff : (A a).1 \ B.1 = (B.1 ∪ (A a).1) \ B.1 := by ext t; simp
  apply ae_iff.mpr
  have he : {t | ¬ (t ∈ (A a).1 → t ∈ B.1)} = (A a).1 \ B.1 := by ext t; simp
  rw [he, hdiff, measure_sdiff Set.subset_union_left B.2.nullMeasurableSet (measure_ne_top _ _), heq, tsub_self]

private theorem PVM.val_diff_apply (P : PVM Ω X) (A B : MeasSet Ω) (x : X) :
    P.val (A.diff B) x = P.val A x - P.val (A.inter B) x := by
  have hu : (A.inter B).union (A.diff B) = A := Subtype.ext (Set.inter_union_sdiff _ _)
  have h := P.toOVM.apply_union (A.inter B) (A.diff B)
    (Set.disjoint_left.mpr fun t ht hd => hd.2 ht.2) x
  rw [hu] at h
  exact eq_sub_of_add_eq' h.symm

private theorem PVM.ae_le_of_val_inter_eq (P : PVM Ω X) (ρ : Measure Ω)
    (hρ : ∀ E : MeasSet Ω, P.val E = 0 → ρ E.1 = 0)
    (A B : MeasSet Ω) (h : P.val (A.inter B) = P.val A) : A.1 ≤ᵐ[ρ] B.1 := by
  have hz : P.val (A.diff B) = 0 := by
    ext x
    rw [P.val_diff_apply, h, sub_self, zero_apply]
  apply ae_iff.mpr
  have he : {t | ¬ (t ∈ A.1 → t ∈ B.1)} = (A.diff B).1 := by ext t; simp [MeasSet.diff]
  rw [he]
  exact hρ _ hz

/-- With a faithful finite control measure, an increasing net of
measurable projections has a least upper projection and converges strongly
to it. Monotonicity is expressed by the product order on projections. -/
theorem PVM.badeComplete_of_faithful [CompleteSpace X] (P : PVM Ω X)
    (ρ : Measure Ω) [IsFiniteMeasure ρ]
    (hρ : ∀ E : MeasSet Ω, ρ E.1 = 0 ↔ P.val E = 0)
    {ι : Type*} [Nonempty ι] [Preorder ι] [IsDirectedOrder ι] (A : ι → MeasSet Ω)
    (hA : ∀ ⦃i j⦄, i ≤ j → P.val ((A i).inter (A j)) = P.val (A i)) :
    ∃ B : MeasSet Ω, (∀ i, P.val ((A i).inter B) = P.val (A i)) ∧
      (∀ C : MeasSet Ω, (∀ i, P.val ((A i).inter C) = P.val (A i)) →
        P.val (B.inter C) = P.val B) ∧
      ∀ x : X, Tendsto (fun i => P.val (A i) x) atTop (𝓝 (P.val B x)) := by
  have hmono ⦃i j⦄ (h : i ≤ j) : (A i).1 ≤ᵐ[ρ] (A j).1 :=
    P.ae_le_of_val_inter_eq ρ (fun E => (hρ E).mpr) _ _ (hA h)
  obtain ⟨D, j, hD, hDA, hBA⟩ := exists_countable_measureSup ρ A hmono
  let B := MeasSet.iUnion D
  have hAB (i : ι) : P.val ((A i).inter B) = P.val (A i) :=
    P.val_inter_eq_of_ae_le ρ (fun E => (hρ E).mp) _ _ (hBA i)
  refine ⟨B, hAB, fun C hC => ?_, fun x => ?_⟩
  · have hc (n : ℕ) : (D n).1 ≤ᵐ[ρ] C.1 :=
      (hDA n (j n) le_rfl).trans (P.ae_le_of_val_inter_eq ρ (fun E => (hρ E).mpr) _ _ (hC (j n)))
    apply P.val_inter_eq_of_ae_le ρ (fun E => (hρ E).mp)
    have he := ae_all_iff.mpr hc
    filter_upwards [he] with t ht
    intro hmem
    obtain ⟨n, hn⟩ := mem_iUnion.mp hmem
    exact ht n hn
  · have hlim := P.toOVM.tendsto_apply_of_increasing D hD x
    apply Metric.tendsto_nhds.mpr
    intro ε hε
    let M := P.toOVM.uniformNorm
    have hM : 0 ≤ M := P.toOVM.uniformNorm_nonneg
    have hδ : 0 < ε / (M + 1) := div_pos hε (by positivity)
    obtain ⟨n, hn⟩ := eventually_atTop.mp ((Metric.tendsto_nhds.mp hlim) _ hδ)
    apply eventually_atTop.mpr
    refine ⟨j n, fun i hi => ?_⟩
    let F := B.diff (A i)
    have hF : P.val F x = P.val B x - P.val (A i) x := by
      rw [P.val_diff_apply, show B.inter (A i) = (A i).inter B from Subtype.ext (inter_comm _ _), hAB]
    have hFzero : P.val (F.inter (D n)) = 0 := by
      apply (hρ _).mp
      have hsub : (F.inter (D n)).1 ⊆ (D n).1 \ (A i).1 := fun _ ht => ⟨ht.2, ht.1.2⟩
      exact measure_mono_null hsub
        (measure_eq_zero_diff_of_ae_le (hDA n i hi))
    have hFB : F.inter B = F :=
      Subtype.ext (Set.inter_eq_left.mpr Set.sdiff_subset)
    have hfac : P.val F (P.val B x - P.val (D n) x) = P.val F x := by
      rw [map_sub]
      change (P.val F).comp (P.val B) x - (P.val F).comp (P.val (D n)) x = _
      rw [P.mul_eq, P.mul_eq, hFB, hFzero, zero_apply, sub_zero]
    rw [dist_eq_norm, norm_sub_rev, ← hF, ← hfac]
    have ht : ‖P.val B x - P.val (D n) x‖ < ε / (M + 1) := by
      simpa only [dist_eq_norm, norm_sub_rev] using hn n le_rfl
    calc
      _ ≤ ‖P.val F‖ * ‖P.val B x - P.val (D n) x‖ :=
        (P.val F).le_opNorm _
      _ ≤ (M + 1) * ‖P.val B x - P.val (D n) x‖ :=
        mul_le_mul_of_nonneg_right ((P.toOVM.opNorm_le_uniformNorm F).trans (by simp [M])) (norm_nonneg _)
      _ < ε := by
        have h := (lt_div_iff₀ (show 0 < M + 1 by positivity)).mp ht
        rwa [mul_comm]

#print axioms PVM.badeComplete_of_faithful

/-- All spectral restriction spaces of a cyclic PVM are cyclic, with the
corresponding cut of the original vector. -/
theorem PVM.cyclicVector_restrict_range (P : PVM Ω X) {u : X} (hu : P.CyclicVector u)
    (E : MeasSet Ω) :
    let Y := (P.val E).toLinearMap.range
    ∃ (hY : P.Invariant Y) (v : Y), (v : X) = P.val E u ∧
      (P.restrict Y hY).CyclicVector v := by
  let Y := (P.val E).toLinearMap.range
  have hY : P.Invariant Y := by
    intro A _ hy
    obtain ⟨x, rfl⟩ := hy
    refine ⟨P.val A x, ?_⟩
    change (P.val E).comp (P.val A) x = (P.val A).comp (P.val E) x
    rw [P.mul_eq, P.mul_eq, MeasSet.inter_comm]
  let T : X →L[ℝ] Y := (P.val E).codRestrict Y fun x => ⟨x, rfl⟩
  have hT : Function.Surjective T := fun y => by
    obtain ⟨x, hx⟩ := y.2
    exact ⟨x, Subtype.ext hx⟩
  refine ⟨hY, T u, rfl, P.cyclicVector_of_dense_intertwining _ T ?_ hT.denseRange hu⟩
  intro A
  apply ContinuousLinearMap.ext
  intro x
  apply Subtype.ext
  change (P.val E).comp (P.val A) x = (P.val A).comp (P.val E) x
  rw [P.mul_eq, P.mul_eq, MeasSet.inter_comm]

#print axioms PVM.cyclicVector_restrict_range

universe uNet

/-- Bade completeness on the range of the projection measure, with the
partial order expressed by multiplication of commuting projections. -/
def PVM.BadeComplete (P : PVM Ω X) : Prop :=
  ∀ {ι : Type uNet} [Nonempty ι] [Preorder ι] [IsDirectedOrder ι] (A : ι → MeasSet Ω),
    (∀ ⦃i j⦄, i ≤ j → P.val ((A i).inter (A j)) = P.val (A i)) →
      ∃ B : MeasSet Ω, (∀ i, P.val ((A i).inter B) = P.val (A i)) ∧
        (∀ C : MeasSet Ω, (∀ i, P.val ((A i).inter C) = P.val (A i)) →
          P.val (B.inter C) = P.val B) ∧
        ∀ x : X, Tendsto (fun i => P.val (A i) x) atTop (𝓝 (P.val B x))

theorem PVM.badeComplete_of_cyclic [CompleteSpace X] (P : PVM Ω X) {u : X}
    (hu : P.CyclicVector u) : P.BadeComplete := by
  obtain ⟨ρ, hfinite, _, _, hρ⟩ := P.exists_faithful_positive_coefficient hu
  let := hfinite
  intro ι _ _ _ A hA
  exact P.badeComplete_of_faithful ρ hρ A hA

#print axioms PVM.badeComplete_of_cyclic

/-- The finite sum of the control measures of the cyclic generators is
faithful on the whole finitely generated representation. -/
theorem PVM.exists_faithful_measure_of_finitelyGenerated [CompleteSpace X] (P : PVM Ω X)
    (hP : P.FinitelyGenerated) :
    ∃ ρ : Measure Ω, IsFiniteMeasure ρ ∧ ∀ E : MeasSet Ω, ρ E.1 = 0 ↔ P.val E = 0 := by
  classical
  obtain ⟨r, u, hu⟩ := hP
  let Y (i : Fin r) := P.cyclicSubspace (u i)
  let R (i : Fin r) := P.restrict (Y i) (P.cyclicSubspace_invariant (u i))
  have h_i (i : Fin r) : ∃ m : Measure Ω, IsFiniteMeasure m ∧
      ∀ E : MeasSet Ω, m E.1 = 0 ↔ (R i).val E = 0 := by
    let : IsClosed (Y i : Set X) :=
      (Submodule.span ℝ (Set.range fun E => P.val E (u i))).isClosed_topologicalClosure
    obtain ⟨v, hv⟩ := P.cyclic_restrict_cyclicSubspace (u i)
    obtain ⟨m, hfin, _, _, hm⟩ := (R i).exists_faithful_positive_coefficient hv
    exact ⟨m, hfin, hm⟩
  choose m hfin hm using h_i
  let ρ := Measure.sum m
  have hρ : IsFiniteMeasure ρ := by
    constructor
    rw [Measure.sum_apply _ MeasurableSet.univ, tsum_fintype]
    exact ENNReal.sum_lt_top.mpr (fun i _ => (hfin i).measure_univ_lt_top)
  refine ⟨ρ, hρ, fun E => ⟨fun hE => ?_, fun hE => ?_⟩⟩
  · have hz (i : Fin r) : (R i).val E = 0 :=
      (hm i E).mp (le_antisymm ((Measure.le_sum m i E.1).trans_eq hE) bot_le)
    have hgen : P.generatorOrbit u ⊆ ((P.val E).ker : Set X) := by
      rintro _ ⟨i, A, rfl⟩
      let y : Y i := ⟨P.val A (u i), subset_closure (Submodule.subset_span ⟨A, rfl⟩)⟩
      have h := congrArg (fun L : Y i →L[ℝ] Y i => ((L y : Y i) : X)) (hz i)
      exact h
    have hspan : (Submodule.span ℝ (P.generatorOrbit u) : Set X) ⊆ (P.val E).ker :=
      Submodule.span_le.mpr hgen
    ext x
    exact (P.val E).isClosed_ker.closure_subset_iff.mpr hspan (hu x)
  · have hz (i : Fin r) : (R i).val E = 0 := by
      apply ContinuousLinearMap.ext
      intro y
      apply Subtype.ext
      change P.val E (y : X) = 0
      rw [hE, zero_apply]
    change (Measure.sum m) E.1 = 0
    rw [Measure.sum_apply _ E.2]
    simp_rw [fun i => (hm i E).mpr (hz i)]
    exact tsum_zero

#print axioms PVM.exists_faithful_measure_of_finitelyGenerated

end BadeCompleteness

section CyclicOrderContinuousLattice

open MeasureTheory

universe uSpace uIndex uSigma

variable {Ω : Type uSigma} {X : Type uSpace} [MeasurableSpace Ω] [NormedAddCommGroup X]
  [NormedSpace ℝ X]

/-- A band projection is a positive projection with positive complement
and disjoint ranges of the projection and its complement. -/
def IsLatticeBandProjection {Y : Type*} [NormedAddCommGroup Y] [NormedSpace ℝ Y]
    [Lattice Y] (Q : Y →L[ℝ] Y) : Prop :=
  Q.comp Q = Q ∧ (∀ y : Y, 0 ≤ y → 0 ≤ Q y ∧ 0 ≤ y - Q y) ∧
    ∀ y z : Y, |Q y| ⊓ |z - Q z| = 0

/-- An equivalent Banach lattice norm on the cyclic space, presented by
a Banach lattice isomorphic to the original space. -/
structure CyclicOrderContinuousLattice (P : PVM Ω X) (u : X) where
  carrier : Type uSpace
  normedGroup : NormedAddCommGroup carrier
  normedScalar : letI := normedGroup; NormedSpace ℝ carrier
  isComplete : letI := normedGroup; CompleteSpace carrier
  lattice : Lattice carrier
  orderedAddition : letI := normedGroup; letI := lattice; IsOrderedAddMonoid carrier
  orderedScalar : letI := normedGroup; letI := normedScalar; letI := lattice
    PosSMulMono ℝ carrier
  solidNorm : letI := normedGroup; letI := lattice
    ∀ y z : carrier, |y| ≤ |z| → ‖y‖ ≤ ‖z‖
  equivalent : letI := normedGroup; letI := normedScalar; X ≃L[ℝ] carrier
  orderContinuous : letI := normedGroup; letI := lattice
    ∀ {ι : Type uIndex} [Nonempty ι] [Preorder ι] [IsDirectedOrder ι] (a : ι → carrier),
      Antitone a → IsGLB (Set.range a) 0 → Tendsto a atTop (𝓝 0)
  generatorPositive : letI := normedGroup; letI := normedScalar; letI := lattice
    0 ≤ equivalent u
  generatorQuasiInterior : letI := normedGroup; letI := normedScalar; letI := lattice
    Dense {y : carrier | ∃ c : ℝ, 0 ≤ c ∧ |y| ≤ c • equivalent u}
  bands : letI := normedGroup; letI := normedScalar; letI := lattice
    ∀ Q : carrier →L[ℝ] carrier, IsLatticeBandProjection Q ↔
      ∃ E : MeasSet Ω, Q = (equivalent.toContinuousLinearMap.comp (P.val E)).comp
        equivalent.symm.toContinuousLinearMap

/-- Rall's cyclic Banach lattice representation, as recalled by Kitover
and Orhon, Positivity 22 (2018), Proposition 2.4 and Lemma 2.9. -/
axiom citeRallCyclicLattice [CompleteSpace X] (P : PVM Ω X) (u : X)
    (hu : P.CyclicVector u) (hb : PVM.BadeComplete.{max uSigma uSpace uIndex, uSigma, uSpace} P)
    (hm : ∀ E : MeasSet Ω, let Y := (P.val E).toLinearMap.range
      ∃ (hY : P.Invariant Y) (v : Y), (v : X) = P.val E u ∧ (P.restrict Y hY).CyclicVector v) :
    Nonempty (CyclicOrderContinuousLattice.{_, uIndex, _} P u)

theorem PVM.exists_orderContinuousLattice_of_cyclic [CompleteSpace X] (P : PVM Ω X)
    {u : X} (hu : P.CyclicVector u) : Nonempty (CyclicOrderContinuousLattice.{_, uIndex, _} P u) :=
  citeRallCyclicLattice P u hu
    (P.badeComplete_of_cyclic hu) (P.cyclicVector_restrict_range hu)

#print axioms PVM.exists_orderContinuousLattice_of_cyclic

end CyclicOrderContinuousLattice

section NormalBidualQuotients

variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V]

abbrev RealSubspaceQuotient (Y : Submodule ℝ V) := V ⧸ Y

abbrev QuotientInProjectionRange (Q : V →L[ℝ] V) (Y : Submodule ℝ V) :=
  Q.toLinearMap.range ⧸ Y.comap Q.toLinearMap.range.subtype

abbrev ProjectionSplitTarget (Q : V →L[ℝ] V) (Y : Submodule ℝ V) :=
  QuotientInProjectionRange Q Y × Q.ker

private theorem subsingleton_quotient_iff_all_mem (Y : Submodule ℝ V) :
    Subsingleton (RealSubspaceQuotient Y) ↔ ∀ v : V, v ∈ Y := by
  constructor
  · intro h v
    exact (Submodule.Quotient.mk_eq_zero Y).mp (h.elim (Y.mkQ v) 0)
  · intro h
    have hzero (z : V ⧸ Y) : z = 0 := by
      obtain ⟨v, rfl⟩ := Y.mkQ_surjective z
      exact (Submodule.Quotient.mk_eq_zero Y).mpr (h v)
    exact ⟨fun x y => (hzero x).trans (hzero y).symm⟩

private theorem subsingleton_quotientInProjectionRange_iff (Q : V →L[ℝ] V) (Y : Submodule ℝ V) :
    Subsingleton (QuotientInProjectionRange Q Y) ↔ Q.toLinearMap.range ≤ Y :=
  (subsingleton_quotient_iff_all_mem (Y.comap Q.toLinearMap.range.subtype)).trans
    ⟨fun h v hv => h ⟨v, hv⟩, fun h v => h v.2⟩

/-- The quotient by a closed subspace of a projection's range splits
into the quotient inside the range and the complementary kernel. -/
noncomputable def projection_quotient_split (Q : V →L[ℝ] V)
    (hQ : ∀ x : V, Q (Q x) = Q x) (Y : Submodule ℝ V) [IsClosed (Y : Set V)]
    (hY : Y ≤ Q.toLinearMap.range) :
    (V ⧸ Y) ≃L[ℝ] ProjectionSplitTarget Q Y := by
  let R := Q.toLinearMap.range
  let K := Q.ker
  let U := Y.comap R.subtype
  let := IsClosed.preimage R.subtypeL.continuous (inferInstance : IsClosed (Y : Set V))
  let L : V →L[ℝ] R := Q.codRestrict R fun x => ⟨x, rfl⟩
  let J : V →L[ℝ] K := (ContinuousLinearMap.id ℝ V - Q).codRestrict K fun x => by
    change Q (x - Q x) = 0
    rw [map_sub, hQ x, sub_self]
  have hfix (v : R) : Q v = v := by
    obtain ⟨x, hx⟩ := v.2
    change Q x = (v : V) at hx
    rw [← hx, hQ]
  have ha : Y ≤ (U.mkQL.comp L).ker := by
    intro y hy
    change U.mkQL (L y) = 0
    apply (Submodule.Quotient.mk_eq_zero U).mpr
    change Q y ∈ Y
    obtain ⟨x, hx⟩ := hY hy
    change Q x = y at hx
    rwa [← hx, hQ, hx]
  have hb : Y ≤ J.ker := by
    intro y hy
    change J y = 0
    apply Subtype.ext
    change y - Q y = 0
    obtain ⟨x, hx⟩ := hY hy
    change Q x = y at hx
    rw [← hx, hQ, sub_self]
  let a := Y.liftQL (U.mkQL.comp L) ha
  let b := Y.liftQL J hb
  let T := a.prod b
  let S₁ := U.liftQL (Y.mkQL.comp R.subtypeL) (fun y hy => (Submodule.Quotient.mk_eq_zero Y).mpr hy)
  let S₂ := Y.mkQL.comp K.subtypeL
  let S := S₁.comp (ContinuousLinearMap.fst ℝ (R ⧸ U) K) +
    S₂.comp (ContinuousLinearMap.snd ℝ (R ⧸ U) K)
  have hleft (z : V ⧸ Y) : S (T z) = z := by
    obtain ⟨x, rfl⟩ := Y.mkQ_surjective z
    change Y.mkQL (Q x) + Y.mkQL (x - Q x) = Y.mkQL x
    rw [← map_add]
    congr 1
    abel
  have hright (z : (R ⧸ U) × K) : T (S z) = z := by
    obtain ⟨v, w⟩ := z
    obtain ⟨y, rfl⟩ := U.mkQ_surjective v
    have hS : S (U.mkQL y, w) = Y.mkQL ((y : V) + (w : V)) := by
      change Y.mkQL (y : V) + Y.mkQL (w : V) = _
      exact (map_add _ _ _).symm
    change T (S (U.mkQL y, w)) = (U.mkQL y, w)
    rw [hS]
    have hQw : Q w = 0 := w.2
    have hsum : Q ((y : V) + (w : V)) = y := by rw [map_add, hfix y, hQw, add_zero]
    apply Prod.ext
    · change U.mkQL (L ((y : V) + (w : V))) = U.mkQL y
      exact congrArg U.mkQL (Subtype.ext hsum)
    · apply Subtype.ext
      change (y : V) + (w : V) - Q ((y : V) + (w : V)) = w
      rw [hsum, add_comm (y : V), add_sub_cancel_right]
  exact
    { toLinearEquiv := LinearEquiv.ofLinearMap T.toLinearMap S.toLinearMap
        (LinearMap.ext hright) (LinearMap.ext hleft)
      continuous_toFun := T.continuous
      continuous_invFun := S.continuous }

theorem projection_range_closed (Q : V →L[ℝ] V) (hQ : ∀ x : V, Q (Q x) = Q x) :
    IsClosed (Q.toLinearMap.range : Set V) := by
  have heq : (Q.toLinearMap.range : Set V) = {x | Q x = x} := by
    ext x
    constructor
    · rintro ⟨y, rfl⟩
      exact hQ y
    · intro h
      exact ⟨x, h⟩
  rw [heq]
  exact isClosed_eq Q.continuous continuous_id

/-- Quotienting by the range identifies the quotient with the kernel.
The map from the kernel is inclusion followed by the quotient map. -/
noncomputable def projection_kernel_equiv_quotient (Q : V →L[ℝ] V)
    (hQ : ∀ x : V, Q (Q x) = Q x) :
    letI := projection_range_closed Q hQ
    Q.ker ≃L[ℝ] RealSubspaceQuotient Q.toLinearMap.range := by
  let R := Q.toLinearMap.range
  let K := Q.ker
  letI : IsClosed (R : Set V) := projection_range_closed Q hQ
  let J : V →L[ℝ] K := (ContinuousLinearMap.id ℝ V - Q).codRestrict K fun x => by
    change Q (x - Q x) = 0
    rw [map_sub, hQ x, sub_self]
  let a := R.mkQL.comp K.subtypeL
  let b := R.liftQL J (by
    rintro _ ⟨x, rfl⟩
    apply Subtype.ext
    change Q x - Q (Q x) = 0
    rw [hQ, sub_self])
  have hleft (x : K) : b (a x) = x := by
    apply Subtype.ext
    change (x : V) - Q x = x
    rw [show Q x = 0 from x.2, sub_zero]
  have hright (z : V ⧸ R) : a (b z) = z := by
    obtain ⟨x, rfl⟩ := R.mkQ_surjective z
    change R.mkQL (x - Q x) = R.mkQL x
    have hzero : R.mkQL (Q x) = 0 := (Submodule.Quotient.mk_eq_zero R).mpr ⟨x, rfl⟩
    rw [map_sub, hzero, sub_zero]
  exact
    { toLinearEquiv := LinearEquiv.ofLinearMap a.toLinearMap b.toLinearMap
        (LinearMap.ext hright) (LinearMap.ext hleft)
      continuous_toFun := a.continuous
      continuous_invFun := b.continuous }

variable {Ω X : Type*} [MeasurableSpace Ω] [NormedAddCommGroup X] [NormedSpace ℝ X]
  [CompleteSpace X]

/-- The canonical isometric embedding into the bidual as a continuous
linear map. -/
noncomputable def canonicalBidualEmbedding : X →L[ℝ] Bidual X :=
  LinearMap.mkContinuous
    { toFun := J
      map_add' := fun x y => by ext f; exact map_add f x y
      map_smul' := fun a x => by ext f; exact map_smul f a x } 1
    (fun x => by change ‖J x‖ ≤ 1 * ‖x‖; rw [norm_J, one_mul])

omit [CompleteSpace X] in
theorem isometry_canonicalBidualEmbedding :
    Isometry (canonicalBidualEmbedding : X →L[ℝ] Bidual X) := by
  apply Isometry.of_dist_eq
  intro x y
  rw [dist_eq_norm, dist_eq_norm,
    ← map_sub (canonicalBidualEmbedding : X →L[ℝ] Bidual X)]
  exact norm_J (x - y)

instance canonicalBidualEmbedding_range_closed :
    IsClosed ((canonicalBidualEmbedding : X →L[ℝ] Bidual X).toLinearMap.range : Set (Bidual X)) :=
  (isometry_canonicalBidualEmbedding (X := X)).isClosedEmbedding.isClosed_range

/-- The splitting of the first bidual quotient in rem:normal-quotients.
The range of Q is the normal subspace by normalProjection_range. -/
noncomputable def PVM.normalBidualQuotientSplit (P : PVM Ω X) :
    let JX := (canonicalBidualEmbedding : X →L[ℝ] Bidual X).toLinearMap.range
    let Q := P.toOVM.normalProjection
    RealSubspaceQuotient (V := Bidual X) JX ≃L[ℝ] ProjectionSplitTarget (V := Bidual X) Q JX :=
  projection_quotient_split (V := Bidual X) _ P.normalProjection_idempotent _ (by
    rintro _ ⟨x, rfl⟩
    exact ⟨J x, P.toOVM.normalProjection_eq_of_normal P.normalized _ (P.toOVM.normal_J x)⟩)

#print axioms PVM.normalBidualQuotientSplit

noncomputable def PVM.normalProjectionKernelEquivQuotient (P : PVM Ω X) :=
  projection_kernel_equiv_quotient (V := Bidual X) P.toOVM.normalProjection P.normalProjection_idempotent

#print axioms PVM.normalProjectionKernelEquivQuotient

theorem PVM.shrinking_iff_normalDefectQuotient_zero (P : PVM Ω X) :
    P.toOVM.Shrinking ↔ Subsingleton
      (RealSubspaceQuotient (V := Bidual X) P.toOVM.normalProjection.toLinearMap.range) := by
  rw [subsingleton_quotient_iff_all_mem, P.toOVM.shrinking_iff_all_normal]
  have he : (P.toOVM.normalProjection.toLinearMap.range : Set (Bidual X)) =
      {ξ : Bidual X | P.toOVM.Normal ξ} := P.normalProjection_range
  have hmem (ξ : Bidual X) : (ξ ∈ P.toOVM.normalProjection.toLinearMap.range) =
      P.toOVM.Normal ξ := congrArg (fun S : Set (Bidual X) => ξ ∈ S) he
  exact ⟨fun h ξ => Eq.mpr (hmem ξ) (h ξ), fun h ξ => Eq.mp (hmem ξ) (h ξ)⟩

theorem PVM.boundedlyComplete_iff_canonicalNormalQuotient_zero (P : PVM Ω X) (hP : P.Localizes) :
    P.BoundedlyComplete ↔ Subsingleton (QuotientInProjectionRange (V := Bidual X)
      P.toOVM.normalProjection (canonicalBidualEmbedding : X →L[ℝ] Bidual X).toLinearMap.range) := by
  rw [subsingleton_quotientInProjectionRange_iff]
  change P.BoundedlyComplete ↔
    (P.toOVM.normalProjection.toLinearMap.range : Set (Bidual X)) ⊆ Set.range (J : X → Bidual X)
  have he : (P.toOVM.normalProjection.toLinearMap.range : Set (Bidual X)) =
      {ξ : Bidual X | P.toOVM.Normal ξ} := P.normalProjection_range
  rw [he]
  constructor
  · intro h
    rw [P.normal_eq_range_of_boundedlyComplete hP h]
  · intro h
    apply P.boundedlyComplete_of_weaklySeqComplete
    intro x hx
    obtain ⟨ξ, hξ⟩ := exists_baireOne_of_weakCauchy x hx
    obtain ⟨y, rfl⟩ := h (P.toOVM.normal_of_baireOne ξ ⟨x, hξ⟩)
    exact ⟨y, hξ⟩

#print axioms PVM.shrinking_iff_normalDefectQuotient_zero
#print axioms PVM.boundedlyComplete_iff_canonicalNormalQuotient_zero

/-- Strong countable additivity of the second-adjoint set function. -/
def PVM.SecondAdjointCountablyAdditive (P : PVM Ω X) : Prop :=
  ∀ A : ℕ → MeasSet Ω, MeasSet.DisjointSeq A → ∀ ξ : Bidual X,
    HasSum (fun n => secondAdjoint (P.val (A n)) ξ)
      (secondAdjoint (P.val (MeasSet.iUnion A)) ξ)

/-- The implication for arbitrary PVMs in rem:normal-quotients. -/
theorem PVM.shrinking_boundedlyComplete_of_secondAdjoint
    (P : PVM Ω X) (h : P.SecondAdjointCountablyAdditive) :
    P.toOVM.Shrinking ∧ P.BoundedlyComplete := by
  constructor
  · apply P.toOVM.shrinking_iff_all_normal.mpr
    intro ξ A hA f
    exact (ContinuousLinearMap.apply ℝ ℝ f).hasSum (h A hA ξ)
  · intro A z hA hz hbound
    obtain ⟨C, hC⟩ := hbound
    let s (N : ℕ) := ∑ n ∈ Finset.range N, z n
    have hsc (f : Dual X) : CauchySeq (fun N => f (s N)) := by
      have ha := (P.summable_abs_dual_of_bounded_partialSums A hA z hz C hC f).1
      have hsum : Summable (fun n => f (z n)) := Summable.of_norm (by simpa [Real.norm_eq_abs] using ha)
      have hv : (fun N => f (s N)) = fun N => ∑ n ∈ Finset.range N, f (z n) :=
        funext fun N => map_sum f _ _
      rw [hv]
      exact hsum.hasSum.tendsto_sum_nat.cauchySeq
    obtain ⟨ξ, hξ⟩ := exists_baireOne_of_weakCauchy s hsc
    have hproj (n : ℕ) : secondAdjoint (P.val (A n)) ξ = J (z n) := by
      ext f
      have hlim := hξ (adjoint (P.val (A n)) f)
      have hconst : (fun N => f (P.val (A n) (s N))) =ᶠ[atTop] fun _ => f (z n) := by
        filter_upwards [eventually_ge_atTop (n + 1)] with N hN
        have hi : {n} ⊆ Finset.range N := by
          rw [Finset.singleton_subset_iff, Finset.mem_range]
          exact Nat.lt_of_succ_le hN
        have he : MeasSet.finiteUnion A {n} = A n := by
          apply Subtype.ext
          simp [MeasSet.finiteUnion]
        have hp := P.finite_subsum_eq A hA z hz {n} N hi
        rw [he, Finset.sum_singleton] at hp
        exact congrArg f hp.symm
      exact tendsto_nhds_unique hlim (tendsto_const_nhds.congr' hconst.symm)
    let Jc : X →L[ℝ] Bidual X := canonicalBidualEmbedding
    have hJ : Isometry Jc := isometry_canonicalBidualEmbedding
    let η := secondAdjoint (P.val (MeasSet.iUnion A)) ξ
    have hlim := (h A hA ξ).tendsto_sum_nat
    simp_rw [hproj] at hlim
    have hJN : ∀ N : ℕ, Jc (s N) = ∑ n ∈ Finset.range N, J (z n) := fun N => map_sum Jc z _
    simp_rw [← hJN] at hlim
    have hmem := hJ.isClosedEmbedding.isClosed_range.mem_of_tendsto hlim
      (Eventually.of_forall fun N => Set.mem_range_self (s N))
    obtain ⟨x, hx⟩ : ∃ x : X, Jc x = η := hmem
    exact ⟨x, hJ.isEmbedding.tendsto_nhds_iff.mpr (hx ▸ hlim)⟩

omit [CompleteSpace X] in
theorem PVM.secondAdjointCountablyAdditive_of_reflexive (P : PVM Ω X) (hX : IsReflexive X) :
    P.SecondAdjointCountablyAdditive := by
  intro A hA ξ
  obtain ⟨x, rfl⟩ := hX ξ
  simp_rw [secondAdjoint_canonical]
  exact (canonicalBidualEmbedding : X →L[ℝ] Bidual X).hasSum (P.countably_additive A hA x)

theorem PVM.secondAdjointCountablyAdditive_iff_reflexive (P : PVM Ω X)
    (hP : P.Localizes) : P.SecondAdjointCountablyAdditive ↔ IsReflexive X :=
  ⟨fun h => (P.shrinking_boundedlyComplete_iff_reflexive hP).mp
    (P.shrinking_boundedlyComplete_of_secondAdjoint h), P.secondAdjointCountablyAdditive_of_reflexive⟩

theorem PVM.secondAdjointCountablyAdditive_iff_reflexive_of_countable_cover (P : PVM Ω X)
    (hcover : ∀ s : Set X, s.Countable → ∃ (Y : Submodule ℝ X) (_ : IsClosed (Y : Set X))
      (hi : P.Invariant Y), s ⊆ Y ∧ (P.restrict Y hi).Localizes) :
    P.SecondAdjointCountablyAdditive ↔ IsReflexive X :=
  ⟨fun h => (P.reflexivity_iff_shrinking_boundedlyComplete_of_countable_cover hcover).mpr
    (P.shrinking_boundedlyComplete_of_secondAdjoint h), P.secondAdjointCountablyAdditive_of_reflexive⟩

#print axioms PVM.shrinking_boundedlyComplete_of_secondAdjoint
#print axioms PVM.secondAdjointCountablyAdditive_iff_reflexive
#print axioms PVM.secondAdjointCountablyAdditive_iff_reflexive_of_countable_cover

end NormalBidualQuotients

section BandProjectionCover

variable {Ω X : Type*} [MeasurableSpace Ω] [NormedAddCommGroup X] [NormedSpace ℝ X] [Lattice X]

/-- An order-continuous lattice norm, expressed using the values of
decreasing nets with greatest lower bound zero. -/
def OrderContinuousLatticeNorm (X : Type*) [NormedAddCommGroup X] [Lattice X] : Prop :=
  ∀ s : Set X, s.Nonempty → DirectedOn (· ≥ ·) s → IsGLB s 0 →
    ∀ ε : ℝ, 0 < ε → ∃ z ∈ s, ‖z‖ < ε

/-- Freudenthal's spectral approximation in an order-continuous Banach
lattice, using the principal projection property. The approximating
vectors are in the finite linear span of band-projection cuts. -/
axiom citeFreudenthalPrincipalIdeal [CompleteSpace X] [IsOrderedAddMonoid X]
    [PosSMulMono ℝ X] [HasSolidNorm X] (hX : OrderContinuousLatticeNorm X)
    (u : X) (hu : 0 ≤ u) (x : X) (hx : ∃ c : ℝ, 0 ≤ c ∧ |x| ≤ c • u)
    (ε : ℝ) (hε : 0 < ε) :
    ∃ y ∈ Submodule.span ℝ {v : X | ∃ Q : X →L[ℝ] X, IsLatticeBandProjection Q ∧ v = Q u},
      |x - y| ≤ ε • u

variable [CompleteSpace X] [IsOrderedAddMonoid X] [PosSMulMono ℝ X] [HasSolidNorm X]

omit [CompleteSpace X] [HasSolidNorm X] [IsOrderedAddMonoid X] in
private theorem abs_smul_lattice_le (a : ℝ) (x : X) : |a • x| ≤ |a| • |x| := by
  have h (b : ℝ) (hb : 0 ≤ b) (y : X) : |b • y| ≤ b • |y| := by
    rw [abs, ← smul_neg]
    exact sup_le (smul_le_smul_of_nonneg_left (le_abs_self y) hb)
      (smul_le_smul_of_nonneg_left (neg_le_abs y) hb)
  by_cases ha : 0 ≤ a
  · simpa [abs_of_nonneg ha] using h a ha x
  · have ha' := le_of_not_ge ha
    simpa [abs_of_nonpos ha'] using h (-a) (neg_nonneg.mpr ha') (-x)

/-- The principal ideal of a positive vector, as a real submodule. -/
def latticePrincipalIdeal (u : X) : Submodule ℝ X where
  carrier := {x | ∃ c : ℝ, 0 ≤ c ∧ |x| ≤ c • u}
  zero_mem' := ⟨0, le_rfl, by simp⟩
  add_mem' := by
    rintro x y ⟨c, hc, hx⟩ ⟨d, hd, hy⟩
    exact ⟨c + d, add_nonneg hc hd,
      (abs_add_le x y).trans ((add_le_add hx hy).trans_eq (add_smul _ _ _).symm)⟩
  smul_mem' := by
    rintro a x ⟨c, hc, hx⟩
    refine ⟨|a| * c, mul_nonneg (abs_nonneg a) hc, ?_⟩
    rw [mul_smul]
    exact (abs_smul_lattice_le a x).trans (smul_le_smul_of_nonneg_left hx (abs_nonneg a))

/-- The geometric series from rem:lattice-james dominates every term
of the given sequence in its principal ideal. -/
theorem exists_principalIdeal_cover (x : ℕ → X) :
    ∃ u : X, 0 ≤ u ∧ (∀ n, x n ∈ latticePrincipalIdeal u) ∧
      u = ∑' n, ((1 / 2 : ℝ) ^ n / (1 + ‖x n‖)) • |x n| := by
  let w (n : ℕ) : ℝ := (1 / 2) ^ n / (1 + ‖x n‖)
  let z (n : ℕ) := w n • |x n|
  have hw (n : ℕ) : 0 < w n := by dsimp [w]; positivity
  have hz (n : ℕ) : 0 ≤ z n := smul_nonneg (hw n).le (abs_nonneg _)
  have hn (n : ℕ) : ‖z n‖ ≤ (1 / 2 : ℝ) ^ n := by
    change ‖w n • |x n|‖ ≤ _
    rw [norm_smul, Real.norm_of_nonneg (hw n).le, norm_abs_eq_norm]
    change ((1 / 2 : ℝ) ^ n / (1 + ‖x n‖)) * ‖x n‖ ≤ _
    rw [div_mul_eq_mul_div]
    refine (div_le_iff₀ (show 0 < 1 + ‖x n‖ by positivity)).mpr ?_
    gcongr
    linarith
  have hs : Summable z := Summable.of_norm
    ((summable_geometric_of_lt_one (r := (1 / 2 : ℝ)) (by norm_num) (by norm_num)).of_nonneg_of_le
      (fun _ => norm_nonneg _) hn)
  let u := ∑' n, z n
  have hu : 0 ≤ u := tsum_nonneg hz
  refine ⟨u, hu, fun n => ?_, rfl⟩
  refine ⟨(w n)⁻¹, inv_nonneg.mpr (hw n).le, ?_⟩
  have h := smul_le_smul_of_nonneg_left (hs.le_tsum n (fun k _ => hz k)) (inv_nonneg.mpr (hw n).le)
  change (w n)⁻¹ • (w n • |x n|) ≤ (w n)⁻¹ • u at h
  rwa [smul_smul, inv_mul_cancel₀ (hw n).ne', one_smul] at h

/-- The closed principal ideal is exactly the cyclic subspace generated
by its positive generator under all band projections. -/
theorem PVM.cyclicSubspace_eq_principalIdealClosure (P : PVM Ω X)
    (hband : ∀ Q : X →L[ℝ] X, IsLatticeBandProjection Q ↔ ∃ E : MeasSet Ω, Q = P.val E)
    (hX : OrderContinuousLatticeNorm X) (u : X) (hu : 0 ≤ u) :
    P.cyclicSubspace u = (latticePrincipalIdeal u).topologicalClosure := by
  have hs : {v : X | ∃ Q : X →L[ℝ] X, IsLatticeBandProjection Q ∧ v = Q u} =
      Set.range (fun E : MeasSet Ω => P.val E u) := by
    ext v
    constructor
    · rintro ⟨Q, hQ, rfl⟩
      obtain ⟨E, rfl⟩ := (hband Q).mp hQ
      exact ⟨E, rfl⟩
    · rintro ⟨E, rfl⟩
      exact ⟨P.val E, (hband _).mpr ⟨E, rfl⟩, rfl⟩
  have hspan : Submodule.span ℝ (Set.range fun E => P.val E u) ≤ latticePrincipalIdeal u := by
    apply Submodule.span_le.mpr
    rintro _ ⟨E, rfl⟩
    have hp := ((hband (P.val E)).mpr ⟨E, rfl⟩).2.1 u hu
    refine ⟨1, zero_le_one, ?_⟩
    rw [one_smul, abs_of_nonneg hp.1]
    exact sub_nonneg.mp hp.2
  apply le_antisymm
  · exact Submodule.topologicalClosure_mono hspan
  · change closure (latticePrincipalIdeal u : Set X) ⊆ (P.cyclicSubspace u : Set X)
    apply closure_minimal _ ((Submodule.span ℝ (Set.range fun E => P.val E u)).isClosed_topologicalClosure)
    intro x hx
    apply Metric.mem_closure_iff.mpr
    intro ε hε
    let δ := ε / (‖u‖ + 1)
    have hδ : 0 < δ := div_pos hε (by positivity)
    obtain ⟨y, hy, hxy⟩ := citeFreudenthalPrincipalIdeal hX u hu x hx δ hδ
    rw [hs] at hy
    refine ⟨y, hy, ?_⟩
    rw [dist_eq_norm]
    have hnorm := norm_le_norm_of_abs_le_abs (hxy.trans_eq (abs_of_nonneg (smul_nonneg hδ.le hu)).symm)
    refine hnorm.trans_lt ?_
    rw [norm_smul, Real.norm_of_nonneg hδ.le]
    dsimp [δ]
    rw [div_mul_eq_mul_div]
    apply (div_lt_iff₀ (by positivity)).mpr
    linarith

/-- Every countable set is contained in a cyclic subrepresentation of
the band-projection resolution. -/
theorem PVM.bandProjection_countable_cyclic_cover (P : PVM Ω X)
    (hband : ∀ Q : X →L[ℝ] X, IsLatticeBandProjection Q ↔ ∃ E : MeasSet Ω, Q = P.val E)
    (hX : OrderContinuousLatticeNorm X) (s : Set X) (hs : s.Countable) :
    ∃ u : X, s ⊆ P.cyclicSubspace u := by
  obtain ⟨x, hx⟩ := (hs.insert (0 : X)).exists_eq_range ⟨0, mem_insert _ _⟩
  obtain ⟨u, hu, he, _⟩ := exists_principalIdeal_cover x
  refine ⟨u, ?_⟩
  rw [P.cyclicSubspace_eq_principalIdealClosure hband hX u hu]
  intro y hy
  have h : y ∈ range x := hx ▸ mem_insert_of_mem _ hy
  obtain ⟨n, rfl⟩ := h
  exact subset_closure (he n)

/-- The localization hypotheses of Corollary 3.5 hold for the cyclic
cover just constructed. -/
theorem PVM.bandProjection_countable_localization (P : PVM Ω X)
    (hband : ∀ Q : X →L[ℝ] X, IsLatticeBandProjection Q ↔ ∃ E : MeasSet Ω, Q = P.val E)
    (hX : OrderContinuousLatticeNorm X) :
    ∀ s : Set X, s.Countable → ∃ (Y : Submodule ℝ X) (_ : IsClosed (Y : Set X))
      (hi : P.Invariant Y), s ⊆ Y ∧ (P.restrict Y hi).Localizes := by
  intro s hs
  obtain ⟨u, hu⟩ := P.bandProjection_countable_cyclic_cover hband hX s hs
  let Y := P.cyclicSubspace u
  let hi := P.cyclicSubspace_invariant u
  have hY : IsClosed (Y : Set X) :=
    (Submodule.span ℝ (Set.range fun E => P.val E u)).isClosed_topologicalClosure
  let : CompleteSpace Y := hY.completeSpace_coe
  exact ⟨Y, hY, hi, hu, (P.restrict Y hi).localizes_of_cyclic (P.cyclic_restrict_cyclicSubspace u)⟩

/-- All three James comparisons for band projections, obtained by
applying the countable-cover theorem to the principal ideals. -/
theorem PVM.bandProjection_james (P : PVM Ω X)
    (hband : ∀ Q : X →L[ℝ] X, IsLatticeBandProjection Q ↔ ∃ E : MeasSet Ω, Q = P.val E)
    (hX : OrderContinuousLatticeNorm X) :
    (P.toOVM.Shrinking ↔ ¬ ContainsCopy LOne X) ∧
    (P.BoundedlyComplete ↔ ¬ ContainsCopy CZero X) ∧
    (P.BoundedlyComplete ↔ WeaklySeqComplete X) ∧
    (IsReflexive X ↔ P.toOVM.Shrinking ∧ P.BoundedlyComplete) := by
  have hloc := P.bandProjection_countable_localization hband hX
  have hbc := P.boundedlyComplete_james_of_countable_cover hloc
  exact ⟨P.shrinking_james_of_countable_cover hloc, hbc.1, hbc.2,
    P.reflexivity_iff_shrinking_boundedlyComplete_of_countable_cover hloc⟩

#print axioms exists_principalIdeal_cover
#print axioms PVM.cyclicSubspace_eq_principalIdealClosure
#print axioms PVM.bandProjection_countable_cyclic_cover
#print axioms PVM.bandProjection_countable_localization
#print axioms PVM.bandProjection_james

end BandProjectionCover

section BandProjectionAlgebra

universe uBand uPts

variable {X : Type uBand} [NormedAddCommGroup X] [NormedSpace ℝ X] [Lattice X]

/-- The Boolean algebra of bands and its order projections. -/
structure CompleteBandAlgebra (X : Type uBand) [NormedAddCommGroup X] [NormedSpace ℝ X]
    [Lattice X] where
  carrier : Type uBand
  algebra : CompleteBooleanAlgebra carrier
  projection : carrier → X →L[ℝ] X
  range_eq : ∀ Q : X →L[ℝ] X, IsLatticeBandProjection Q ↔ ∃ b, Q = projection b
  map_bot : letI := algebra; projection ⊥ = 0
  map_top : letI := algebra; projection ⊤ = ContinuousLinearMap.id ℝ X
  map_inf : letI := algebra; ∀ a b, projection (a ⊓ b) = (projection a).comp (projection b)
  map_disjoint_sup : letI := algebra; ∀ a b, Disjoint a b →
    projection (a ⊔ b) = projection a + projection b
  monotone_on_positive : letI := algebra; ∀ x : X, 0 ≤ x → Monotone (fun b => projection b x)
  join_apply : letI := algebra; ∀ (b : ℕ → carrier) (x : X), Monotone b → 0 ≤ x →
    IsLUB (Set.range fun n => projection (b n) x) (projection (⨆ n, b n) x)

/-- The classical completeness of the band-projection algebra of an
order-continuous Banach lattice. Suprema of increasing projections act
on the positive cone by the corresponding order suprema. -/
axiom citeCompleteBandAlgebra [CompleteSpace X] [IsOrderedAddMonoid X]
    [PosSMulMono ℝ X] [HasSolidNorm X] (hX : OrderContinuousLatticeNorm X) :
    Nonempty (CompleteBandAlgebra X)

/-- A sigma-field presentation of a complete Boolean algebra. -/
structure BooleanSigmaPresentation (B : Type uBand) [CompleteBooleanAlgebra B] where
  carrier : Type uBand
  measurableSpace : MeasurableSpace carrier
  classify : letI := measurableSpace; MeasSet carrier → B
  onto : letI := measurableSpace; Function.Surjective classify
  empty_eq : letI := measurableSpace; classify MeasSet.empty = ⊥
  whole_eq : letI := measurableSpace; classify MeasSet.whole = ⊤
  inter_eq : letI := measurableSpace; ∀ E F, classify (E.inter F) = classify E ⊓ classify F
  iUnion_eq : letI := measurableSpace; ∀ E : ℕ → MeasSet carrier,
    classify (MeasSet.iUnion E) = ⨆ n, classify (E n)

/-- The Loomis--Sikorski theorem in the form of a surjective sigma
homomorphism, cf. Fremlin, Measure Theory, §566L. -/
axiom citeLoomisSikorski (B : Type uBand) [CompleteBooleanAlgebra B] :
    Nonempty (BooleanSigmaPresentation B)

variable [IsOrderedAddMonoid X] [PosSMulMono ℝ X] [HasSolidNorm X]

omit [NormedSpace ℝ X] [PosSMulMono ℝ X] in
private theorem tendsto_of_increasing_order_continuous (hX : OrderContinuousLatticeNorm X)
    (v : ℕ → X) (a : X) (hv : Monotone v) (ha : IsLUB (Set.range v) a) :
    Tendsto v atTop (𝓝 a) := by
  apply Metric.tendsto_atTop.mpr
  intro ε hε
  let z (n : ℕ) := a - v n
  have hz : Antitone z := fun _ _ h => sub_le_sub_left (hv h) _
  have hz_nonneg (n : ℕ) : 0 ≤ z n := sub_nonneg.mpr (ha.1 (Set.mem_range_self n))
  have hglb : IsGLB (Set.range z) 0 := by
    refine ⟨?_, ?_⟩
    · rintro _ ⟨n, rfl⟩
      exact hz_nonneg n
    · intro y hy
      have h : a ≤ a - y := ha.2 (by
        rintro _ ⟨n, rfl⟩
        exact le_sub_comm.mp (hy (Set.mem_range_self n)))
      exact nonpos_of_neg_nonneg (by simpa [sub_eq_add_neg] using h)
  obtain ⟨_, ⟨N, rfl⟩, hN⟩ := hX (Set.range z) (Set.range_nonempty z)
    (by
      rintro _ ⟨n, rfl⟩ _ ⟨k, rfl⟩
      exact ⟨z (max n k), ⟨max n k, rfl⟩, hz (le_max_left _ _), hz (le_max_right _ _)⟩)
    hglb ε hε
  refine ⟨N, fun n hn => ?_⟩
  rw [dist_comm, dist_eq_norm]
  have hb : |z n| ≤ |z N| := by
    simpa only [abs_of_nonneg (hz_nonneg n), abs_of_nonneg (hz_nonneg N)] using hz hn
  exact (norm_le_norm_of_abs_le_abs hb).trans_lt hN

omit [PosSMulMono ℝ X] in
/-- A disjoint family of bands has a norm-unconditional sum, whose value
is the projection onto the join applied to the original vector. -/
theorem CompleteBandAlgebra.hasSum_of_disjoint (B : CompleteBandAlgebra X)
    (hX : OrderContinuousLatticeNorm X) :
    letI := B.algebra
    ∀ a : ℕ → B.carrier, Pairwise (fun i j => Disjoint (a i) (a j)) →
      ∀ x : X, HasSum (fun n => B.projection (a n) x) (B.projection (⨆ n, a n) x) := by
  let := B.algebra
  intro a hd x
  classical
  let b (s : Finset ℕ) := s.sup a
  have hsum (s : Finset ℕ) (y : X) : (∑ i ∈ s, B.projection (a i) y) = B.projection (b s) y := by
    induction s using Finset.induction_on with
    | empty => simp [b, B.map_bot]
    | insert n s hn ih =>
      have hds : Disjoint (a n) (b s) := by
        apply Finset.disjoint_sup_right.mpr
        exact fun j hj => hd (fun h => hn (h ▸ hj))
      rw [Finset.sum_insert hn, ih]
      change B.projection (a n) y + B.projection (s.sup a) y = B.projection ((insert n s).sup a) y
      rw [Finset.sup_insert, B.map_disjoint_sup _ _ hds, add_apply]
  have hmono : Monotone (fun n : ℕ => b (Finset.range n)) :=
    fun _ _ h => Finset.sup_mono (Finset.range_subset_range.mpr h)
  have hsup : (⨆ n, b (Finset.range n)) = ⨆ n, a n := by
    apply le_antisymm
    · exact iSup_le fun n => Finset.sup_le fun i _ => le_iSup a i
    · apply iSup_le
      intro n
      exact (Finset.le_sup (f := a) (Finset.mem_range.mpr (Nat.lt_succ_self n))).trans
        (le_iSup (fun k => b (Finset.range k)) (n + 1))
  have hpos (y : X) (hy : 0 ≤ y) :
      HasSum (fun n => B.projection (a n) y) (B.projection (⨆ n, a n) y) := by
    let t := B.projection (⨆ n, a n) y
    have hm := B.monotone_on_positive y hy
    have hlub := B.join_apply (fun n => b (Finset.range n)) y hmono hy
    rw [hsup] at hlub
    have ht := tendsto_of_increasing_order_continuous hX (fun n => B.projection (b (Finset.range n)) y)
      t (hm.comp hmono) hlub
    apply Metric.tendsto_nhds.mpr
    intro ε hε
    obtain ⟨N, hN⟩ := Metric.tendsto_atTop.mp ht ε hε
    apply (eventually_atTop.mpr ⟨Finset.range N, fun s hs => ?_⟩)
    change dist (∑ i ∈ s, B.projection (a i) y) t < ε
    rw [hsum, dist_comm, dist_eq_norm]
    have hsub₁ := hm (Finset.sup_mono hs : b (Finset.range N) ≤ b s)
    have hsub₂ : B.projection (b s) y ≤ t :=
      hm (Finset.sup_le fun i _ => le_iSup a i)
    have hdiff : |t - B.projection (b s) y| ≤ |t - B.projection (b (Finset.range N)) y| := by
      rw [abs_of_nonneg (sub_nonneg.mpr hsub₂), abs_of_nonneg (sub_nonneg.mpr (hsub₁.trans hsub₂))]
      exact sub_le_sub_left hsub₁ _
    have hN' := hN N le_rfl
    rw [dist_comm, dist_eq_norm] at hN'
    exact (norm_le_norm_of_abs_le_abs hdiff).trans_lt hN'
  have hx : x⁺ - x⁻ = x := posPart_sub_negPart x
  have h := (hpos x⁺ (posPart_nonneg x)).sub (hpos x⁻ (negPart_nonneg x))
  simp only [← map_sub, hx] at h
  exact h

/-- The band algebra gives an ordinary PVM on any Loomis--Sikorski
presentation. Its range is exactly the family of band projections. -/
noncomputable def CompleteBandAlgebra.toPVM (B : CompleteBandAlgebra X)
    (hX : OrderContinuousLatticeNorm X) :
    letI := B.algebra
    ∀ M : BooleanSigmaPresentation B.carrier,
      letI := M.measurableSpace
      PVM M.carrier X := by
  letI := B.algebra
  intro M
  letI := M.measurableSpace
  refine
    { val := fun E => B.projection (M.classify E)
      empty_eq := by rw [M.empty_eq, B.map_bot]
      normalized := by change B.projection (M.classify MeasSet.whole) = _; rw [M.whole_eq, B.map_top]
      mul_eq := fun A D => by rw [M.inter_eq, B.map_inf]
      countably_additive := fun D hd x => ?_ }
  have hdisj : Pairwise (fun i j => Disjoint (M.classify (D i)) (M.classify (D j))) := by
    intro i j hij
    rw [disjoint_iff]
    have he : (D i).inter (D j) = MeasSet.empty :=
      Subtype.ext (Set.disjoint_iff_inter_eq_empty.mp (hd hij))
    rw [← M.inter_eq, he, M.empty_eq]
  rw [M.iUnion_eq]
  exact B.hasSum_of_disjoint hX _ hdisj x

omit [PosSMulMono ℝ X] in
theorem CompleteBandAlgebra.toPVM_isBandProjection (B : CompleteBandAlgebra X)
    (hX : OrderContinuousLatticeNorm X) :
    letI := B.algebra
    ∀ M : BooleanSigmaPresentation B.carrier,
      letI := M.measurableSpace
      ∀ Q : X →L[ℝ] X, IsLatticeBandProjection Q ↔ ∃ E : MeasSet M.carrier, Q = (B.toPVM hX M).val E := by
  let := B.algebra
  intro M
  let := M.measurableSpace
  intro Q
  rw [B.range_eq]
  constructor
  · rintro ⟨b, hb⟩
    obtain ⟨E, rfl⟩ := M.onto b
    exact ⟨E, hb⟩
  · rintro ⟨E, hE⟩
    exact ⟨M.classify E, hE⟩

#print axioms CompleteBandAlgebra.hasSum_of_disjoint
#print axioms CompleteBandAlgebra.toPVM_isBandProjection

/-- A measurable realization of the complete band-projection algebra. -/
structure BandProjectionRepresentation (X : Type uBand) [NormedAddCommGroup X] [NormedSpace ℝ X]
    [Lattice X] where
  carrier : Type uBand
  measurableSpace : MeasurableSpace carrier
  measure : letI := measurableSpace; PVM carrier X
  range_eq : letI := measurableSpace; ∀ Q : X →L[ℝ] X,
    IsLatticeBandProjection Q ↔ ∃ E : MeasSet carrier, Q = measure.val E

theorem exists_bandProjectionRepresentation [CompleteSpace X] (hX : OrderContinuousLatticeNorm X) :
    Nonempty (BandProjectionRepresentation X) := by
  obtain ⟨B⟩ := citeCompleteBandAlgebra hX
  let := B.algebra
  obtain ⟨M⟩ := citeLoomisSikorski B.carrier
  exact ⟨⟨M.carrier, M.measurableSpace, B.toPVM hX M, B.toPVM_isBandProjection hX M⟩⟩

/-- The classical KB criterion for an order-continuous Banach lattice.
It follows from the usual no-`c₀` sublattice characterizations of KB
and weak sequential completeness, as in Meyer-Nieberg, §2.4. -/
axiom citeOrderContinuousLatticeKB [CompleteSpace X] [IsOrderedAddMonoid X]
    [PosSMulMono ℝ X] [HasSolidNorm X] (hX : OrderContinuousLatticeNorm X) :
    WeaklySeqComplete X ↔
      ∀ u : ℕ → X, Monotone u → (∀ n, 0 ≤ u n) → (∃ C : ℝ, ∀ n, ‖u n‖ ≤ C) →
        ∃ v : X, Tendsto u atTop (𝓝 v)

/-- The converse lattice statement of rem:lattice-james, including KB
and the actual realization by all band projections. -/
theorem bandProjection_representation_james [CompleteSpace X] (hX : OrderContinuousLatticeNorm X) :
    ∃ M : BandProjectionRepresentation X,
      letI := M.measurableSpace
      (M.measure.toOVM.Shrinking ↔ ¬ ContainsCopy LOne X) ∧
      (M.measure.BoundedlyComplete ↔ ¬ ContainsCopy CZero X) ∧
      (M.measure.BoundedlyComplete ↔ WeaklySeqComplete X) ∧
      (M.measure.BoundedlyComplete ↔
        ∀ u : ℕ → X, Monotone u → (∀ n, 0 ≤ u n) → (∃ C : ℝ, ∀ n, ‖u n‖ ≤ C) →
          ∃ v : X, Tendsto u atTop (𝓝 v)) ∧
      (IsReflexive X ↔ M.measure.toOVM.Shrinking ∧ M.measure.BoundedlyComplete) := by
  obtain ⟨M⟩ := exists_bandProjectionRepresentation hX
  let := M.measurableSpace
  obtain ⟨hs, hb, hw, hr⟩ := M.measure.bandProjection_james M.range_eq hX
  exact ⟨M, hs, hb, hw, hw.trans (citeOrderContinuousLatticeKB hX), hr⟩

#print axioms exists_bandProjectionRepresentation
#print axioms bandProjection_representation_james

end BandProjectionAlgebra

noncomputable section CKModuleComparison

open MeasureTheory
open scoped BoundedContinuousFunction

variable {Ω X : Type*} [MeasurableSpace Ω] [NormedAddCommGroup X] [NormedSpace ℝ X]
  [CompleteSpace X]

local instance (priority := 2000) (Ω : Type*) [MeasurableSpace Ω] :
    Semiring (boundedMeasurableAlgebra Ω) :=
  (boundedMeasurableAlgebra Ω).toRing.toSemiring

/-- A normal bidual vector has exactly the coefficients represented by
the canonical L¹ predual of the multiplier algebra. -/
theorem PVM.normal_iff_integrable_multiplier_coefficients (P : PVM Ω X)
    (ρ : Measure Ω) [IsFiniteMeasure ρ] (hρ : ∀ E : MeasSet Ω, ρ E.1 = 0 → P.val E = 0)
    (ξ : Bidual X) :
    P.toOVM.Normal ξ ↔ ∀ f : Dual X, ∃ h : Ω → ℝ, Integrable h ρ ∧
      ∀ a : boundedMeasurableAlgebra Ω,
        ξ (adjoint (P.boundedMeasurableRepresentation a) f) =
          ∫ t, a.1 t * h t ∂ρ := by
  constructor
  · intro hξ f
    obtain ⟨h, _, hi, hd⟩ := P.exists_normalCoefficient_density ρ hρ ξ hξ f
    exact ⟨h, hi, fun a => P.toOVM.boundedMeasurableMultiplier_coeff a ξ f ρ h hi hd⟩
  · intro hξ A hA f
    obtain ⟨h, hi, hh⟩ := hξ f
    have he (E : MeasSet Ω) :
        ξ (adjoint (P.val E) f) = ∫ t in E.1, h t ∂ρ := by
      rw [← P.boundedMeasurableRepresentation_indicator E, hh]
      rw [← integral_indicator E.2]
      apply integral_congr_ae
      exact Eventually.of_forall fun t => by
        by_cases ht : t ∈ E.1 <;> simp [measurableIndicator_apply, ht]
    simp only [he]
    exact hasSum_integral_iUnion (fun n => (A n).2) hA hi.integrableOn

#print axioms PVM.normal_iff_integrable_multiplier_coefficients

section ArensAction

variable {K : Type*} [TopologicalSpace K] [CompactSpace K]

/-- The continuous operator representation obtained by transporting the quotient action. -/
def PVM.continuousFunctionRepresentation (P : PVM Ω X) (ρ : Measure Ω)
    [IsFiniteMeasure ρ] (hρ : ∀ E : MeasSet Ω, ρ E.1 = 0 → P.val E = 0)
    (e : BoundedMeasurableQuotient ρ ≃ₐ[ℝ] C(K, ℝ))
    (hbound : ∀ a : boundedMeasurableAlgebra Ω,
      ∀ᵐ t ∂ρ, ‖a.1 t‖ ≤ ‖e (Ideal.Quotient.mk _ a)‖) :
    C(K, ℝ) →L[ℝ] (X →L[ℝ] X) :=
  ((P.boundedMeasurableQuotientRepresentation ρ hρ).comp e.symm.toAlgHom).toLinearMap.mkContinuous
    (2 * P.toOVM.uniformNorm) (by
      intro b
      obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (e.symm b)
      have hb : e (Ideal.Quotient.mk _ a) = b := by rw [ha, e.apply_symm_apply]
      change ‖P.boundedMeasurableQuotientRepresentation ρ hρ (e.symm b)‖ ≤ _
      rw [← ha]
      exact P.norm_boundedMeasurableQuotientRepresentation_le ρ hρ a ‖b‖
        (norm_nonneg _) (hb ▸ hbound a))

/-- The coefficient of the represented function algebra as a member of its dual. -/
def continuousFunctionCoefficient (π : C(K, ℝ) →L[ℝ] (X →L[ℝ] X)) (ξ : Bidual X) :
    Dual X →L[ℝ] Dual C(K, ℝ) :=
  (ContinuousLinearMap.compL ℝ C(K, ℝ) (Dual X) ℝ ξ).comp
    (((ContinuousLinearMap.compL ℝ X X ℝ).flip.comp π).flip)

/-- The Arens action on the bidual, evaluated against each original dual vector. -/
def continuousFunctionArensAction (π : C(K, ℝ) →L[ℝ] (X →L[ℝ] X))
    (p : Bidual C(K, ℝ)) (ξ : Bidual X) : Bidual X :=
  p.comp (continuousFunctionCoefficient π ξ)

/-- The bidual projection associated with the predual is the predual projection
evaluated at the unit. Its Arens action has range exactly the normal part. -/
theorem PVM.continuousFunctionArensAction_range (P : PVM Ω X) (ρ : Measure Ω)
    [IsFiniteMeasure ρ] (hρ : ∀ E : MeasSet Ω, ρ E.1 = 0 ↔ P.val E = 0)
    (e : BoundedMeasurableQuotient ρ ≃ₐ[ℝ] C(K, ℝ))
    (hbound : ∀ a : boundedMeasurableAlgebra Ω,
      ∀ᵐ t ∂ρ, ‖a.1 t‖ ≤ ‖e (Ideal.Quotient.mk _ a)‖)
    (R : Dual C(K, ℝ) →L[ℝ] Dual C(K, ℝ))
    (hidem : ∀ c, R (R c) = R c)
    (hmodule : ∀ a c, R (c.comp (ContinuousLinearMap.mul ℝ C(K, ℝ) a)) =
      (R c).comp (ContinuousLinearMap.mul ℝ C(K, ℝ) a))
    (hpredual : ∀ c, R c = c ↔ ∃ h : Ω → ℝ, Integrable h ρ ∧
      ∀ a : boundedMeasurableAlgebra Ω, c (e (Ideal.Quotient.mk _ a)) = ∫ t, a.1 t * h t ∂ρ) :
    Set.range (continuousFunctionArensAction
      (P.continuousFunctionRepresentation ρ (fun E => (hρ E).mp) e hbound)
      ((ContinuousLinearMap.apply ℝ ℝ (1 : C(K, ℝ))).comp R)) =
      {ξ | P.toOVM.Normal ξ} := by
  let π := P.continuousFunctionRepresentation ρ (fun E => (hρ E).mp) e hbound
  let p := (ContinuousLinearMap.apply ℝ ℝ (1 : C(K, ℝ))).comp R
  have hfactor (a : boundedMeasurableAlgebra Ω) :
      π (e (Ideal.Quotient.mk _ a)) = P.boundedMeasurableRepresentation a := by
    change P.boundedMeasurableQuotientRepresentation ρ (fun E => (hρ E).mp) (e.symm (e _)) = _
    rw [e.symm_apply_apply]
    rfl
  have hmul (a b : C(K, ℝ)) : π (a * b) = (π a).comp (π b) := by
    change P.boundedMeasurableQuotientRepresentation ρ (fun E => (hρ E).mp) (e.symm (a * b)) = _
    rw [map_mul, map_mul]
    rfl
  have hone : π 1 = ContinuousLinearMap.id ℝ X := by
    change P.boundedMeasurableQuotientRepresentation ρ (fun E => (hρ E).mp) (e.symm 1) = _
    rw [map_one, map_one]
    rfl
  have normal_iff (ξ : Bidual X) :
      P.toOVM.Normal ξ ↔ ∀ f, R (continuousFunctionCoefficient π ξ f) =
        continuousFunctionCoefficient π ξ f := by
    rw [P.normal_iff_integrable_multiplier_coefficients ρ (fun E => (hρ E).mp)]
    apply forall_congr'
    intro f
    rw [hpredual]
    simp only [continuousFunctionCoefficient, ContinuousLinearMap.comp_apply,
      ContinuousLinearMap.compL_apply, ContinuousLinearMap.flip_apply, hfactor, adjoint]
  have hcoeff (ξ : Bidual X) (f : Dual X) :
      continuousFunctionCoefficient π (continuousFunctionArensAction π p ξ) f =
        R (continuousFunctionCoefficient π ξ f) := by
    ext a
    have hshift : continuousFunctionCoefficient π ξ (f.comp (π a)) =
        (continuousFunctionCoefficient π ξ f).comp (ContinuousLinearMap.mul ℝ C(K, ℝ) a) := by
      ext b
      change ξ ((f.comp (π a)).comp (π b)) = ξ (f.comp (π (a * b)))
      rw [hmul]
      rfl
    change (R (continuousFunctionCoefficient π ξ (f.comp (π a)))) 1 =
      (R (continuousFunctionCoefficient π ξ f)) a
    rw [hshift, hmodule]
    change (R (continuousFunctionCoefficient π ξ f)) (a * 1) = _
    rw [mul_one]
  change Set.range (continuousFunctionArensAction π p) = _
  ext ξ
  change (∃ η, continuousFunctionArensAction π p η = ξ) ↔ P.toOVM.Normal ξ
  constructor
  · rintro ⟨η, rfl⟩
    exact (normal_iff _).mpr fun f => by rw [hcoeff, hidem]
  · intro hξ
    refine ⟨ξ, ?_⟩
    ext f
    change (R (continuousFunctionCoefficient π ξ f)) 1 = ξ f
    rw [(normal_iff ξ).mp hξ f]
    change ξ (f.comp (π 1)) = ξ f
    rw [hone, ContinuousLinearMap.comp_id]

#print axioms PVM.continuousFunctionArensAction_range

end ArensAction

universe uHyperstonian

/-- A compact model of the real essential-bounded function algebra, equipped with
the projection onto the canonical predual. The fixed-point condition specifies
that predual by integration. -/
structure HyperstonianLInfinityModel {A : Type uHyperstonian} [MeasurableSpace A]
    (ρ : Measure A) where
  carrier : Type uHyperstonian
  topology : TopologicalSpace carrier
  compact : @CompactSpace carrier topology
  hausdorff : @T2Space carrier topology
  algebraEquiv : letI := topology; BoundedMeasurableQuotient ρ ≃ₐ[ℝ] C(carrier, ℝ)
  normBound : letI := topology; letI := compact;
    ∀ a : boundedMeasurableAlgebra A, ∀ᵐ t ∂ρ, ‖a.1 t‖ ≤ ‖algebraEquiv (Ideal.Quotient.mk _ a)‖
  predual : letI := topology; letI := compact; Dual C(carrier, ℝ) →L[ℝ] Dual C(carrier, ℝ)
  idempotent : letI := topology; letI := compact; ∀ c, predual (predual c) = predual c
  moduleLaw : letI := topology; letI := compact;
    ∀ a c, predual (c.comp (ContinuousLinearMap.mul ℝ C(carrier, ℝ) a)) =
      (predual c).comp (ContinuousLinearMap.mul ℝ C(carrier, ℝ) a)
  fixed_iff_integral : letI := topology; letI := compact;
    ∀ c, predual c = c ↔ ∃ h : A → ℝ, Integrable h ρ ∧
      ∀ a : boundedMeasurableAlgebra A,
        c (algebraEquiv (Ideal.Quotient.mk _ a)) = ∫ t, a.1 t * h t ∂ρ

/-- Cited scalar result. The hyperstonian (L^\infty\) representation and its
canonical predual band projection in the dual of the function algebra.
The projection is multiplication by the central predual idempotent.
See the hyperstonian representation theorem and Kitover–Orhon, Remark 2.10
and Lemma 2.13(1). -/
axiom citeHyperstonianLInfinity {A : Type uHyperstonian} [MeasurableSpace A] (ρ : Measure A)
    [IsFiniteMeasure ρ] : Nonempty (HyperstonianLInfinityModel ρ)

/-- Under finite faithful control the hyperstonian action has image exactly
the normal bidual. -/
theorem PVM.exists_hyperstonian_normal_range (P : PVM Ω X) (ρ : Measure Ω)
    [IsFiniteMeasure ρ] (hρ : ∀ E : MeasSet Ω, ρ E.1 = 0 ↔ P.val E = 0) :
    ∃ M : HyperstonianLInfinityModel ρ, letI := M.topology; letI := M.compact;
      Set.range (continuousFunctionArensAction
        (P.continuousFunctionRepresentation ρ (fun E => (hρ E).mp) M.algebraEquiv M.normBound)
        ((ContinuousLinearMap.apply ℝ ℝ (1 : C(M.carrier, ℝ))).comp M.predual)) =
        {ξ | P.toOVM.Normal ξ} := by
  obtain ⟨M⟩ := citeHyperstonianLInfinity ρ
  refine ⟨M, ?_⟩
  let _ : TopologicalSpace M.carrier := M.topology
  let _ : CompactSpace M.carrier := M.compact
  exact P.continuousFunctionArensAction_range ρ hρ M.algebraEquiv M.normBound
    M.predual M.idempotent M.moduleLaw M.fixed_iff_integral

#print axioms PVM.exists_hyperstonian_normal_range

/-- The equality of the normal part and the canonical image is a three-space
property for the closed invariant subspaces of a PVM. -/
theorem PVM.normal_eq_canonical_threeSpace (P : PVM Ω X)
    (Y : Submodule ℝ X) [IsClosed (Y : Set X)] (hY : P.Invariant Y) :
    (∀ ξ, P.toOVM.Normal ξ → ∃ x : X, J x = ξ) ↔
      (∀ η, (P.restrict Y hY).toOVM.Normal η → ∃ y : Y, J y = η) ∧
      (∀ ζ, (P.quotient Y hY).toOVM.Normal ζ → ∃ z : X ⧸ Y, J z = ζ) := by
  constructor
  · intro h
    constructor
    · intro η hη
      let ξ := secondAdjoint Y.subtypeL η
      have hξ : P.toOVM.Normal ξ := (P.normal_restrict_iff Y hY η).mp hη
      obtain ⟨x, hx⟩ := h ξ hξ
      let y : Y := ⟨x, secondAdjoint_subtype_J_mem Y inferInstance η hx.symm⟩
      refine ⟨y, secondAdjoint_subtype_injective Y ?_⟩
      rw [secondAdjoint_canonical]
      exact hx
    · intro ζ hζ
      obtain ⟨ξ, hξ, hq⟩ := P.normal_quotient_surjective Y hY ζ hζ
      obtain ⟨x, hx⟩ := h ξ hξ
      exact ⟨Y.mkQL x, (secondAdjoint_canonical Y.mkQL x).symm.trans
        ((congrArg (secondAdjoint Y.mkQL) hx).trans hq)⟩
  · rintro ⟨hres, hquot⟩ ξ hξ
    have hqnorm := P.normal_of_intertwining (P.quotient Y hY) Y.mkQL
      (P.quotient_intertwines Y hY) hξ
    obtain ⟨z, hz⟩ := hquot _ hqnorm
    obtain ⟨x, hx⟩ := Submodule.Quotient.mk_surjective Y z
    have hqx : Y.mkQL x = z := hx
    have hnorm := P.toOVM.normal_sub hξ (P.toOVM.normal_J x)
    have hker : secondAdjoint Y.mkQL (ξ - J x) = 0 := by
      rw [secondAdjoint_sub, secondAdjoint_canonical, hqx, hz]
      ext f
      exact sub_self _
    obtain ⟨η, hη, he⟩ := (P.normal_quotient_kernel_iff Y hY hnorm).mp hker
    obtain ⟨y, hy⟩ := hres _ hη
    rw [← hy, secondAdjoint_canonical] at he
    refine ⟨(y : X) + x, ?_⟩
    ext f
    change f ((y : X) + x) = ξ f
    rw [map_add]
    exact eq_sub_iff_add_eq.mp (congrArg (fun w : Bidual X => w f) he)

#print axioms PVM.normal_eq_canonical_threeSpace

end CKModuleComparison

noncomputable section CZeroCoordinate

open scoped ZeroAtInfty BoundedContinuousFunction

private theorem coord_cZero_norm_le (a : CZero) {C : ℝ} (hC : 0 ≤ C)
    (h : ∀ n, |a n| ≤ C) : ‖a‖ ≤ C :=
  (BoundedContinuousFunction.norm_le (f := a.toBCF) hC).mpr h

private theorem coord_cZero_eventually_small (a : CZero) (ε : ℝ) (hε : 0 < ε) :
    ∃ k, ∀ j ≥ k, |a j| < ε := by
  have h := a.zero_at_infty'
  rw [cocompact_eq_atTop] at h
  change Tendsto (fun j => a j) atTop (𝓝 0) at h
  simpa only [Real.dist_eq, sub_zero] using Metric.tendsto_atTop.mp h ε hε

/-- Multiplication by the indicator of an arbitrary set of coordinates on c₀. -/
def cZeroCoordinateCut (A : Set ℕ) : CZero →L[ℝ] CZero := by
  classical
  let cut (a : CZero) : CZero :=
    { toContinuousMap := ⟨fun n => if n ∈ A then a n else 0, continuous_of_discreteTopology⟩
      zero_at_infty' := by
        rw [cocompact_eq_atTop, Metric.tendsto_atTop]
        intro ε hε
        obtain ⟨k, hk⟩ := coord_cZero_eventually_small a ε hε
        refine ⟨k, fun j hj => ?_⟩
        by_cases h : j ∈ A
        · simpa [h, Real.dist_eq] using hk j hj
        · simpa [h] using hε }
  refine LinearMap.mkContinuous
    { toFun := cut
      map_add' := fun a b => ?_
      map_smul' := fun r a => ?_ } 1 (fun a => ?_)
  · ext j
    change (if j ∈ A then a j + b j else 0) =
      (if j ∈ A then a j else 0) + (if j ∈ A then b j else 0)
    by_cases hj : j ∈ A <;> simp [hj]
  · ext j
    change (if j ∈ A then r * a j else 0) = r * (if j ∈ A then a j else 0)
    by_cases hj : j ∈ A <;> simp [hj]
  · rw [one_mul]
    apply coord_cZero_norm_le _ (norm_nonneg _)
    intro j
    change |if j ∈ A then a j else 0| ≤ ‖a‖
    by_cases hj : j ∈ A
    · simp only [ite_eq_left hj]
      exact BoundedContinuousFunction.norm_coe_le_norm a.toBCF j
    · simp [hj]

private theorem cZeroCoordinateCut_apply (A : Set ℕ) (a : CZero) (j : ℕ) [Decidable (j ∈ A)] :
    cZeroCoordinateCut A a j = if j ∈ A then a j else 0 := by
  classical
  by_cases h : j ∈ A <;> simp [cZeroCoordinateCut, h]

/-- The strongly countably additive coordinate measure on c₀. -/
def cZeroCoordinatePVM : PVM ℕ CZero where
  val E := cZeroCoordinateCut E.1
  empty_eq := by
    classical
    ext a j
    change cZeroCoordinateCut ∅ a j = 0
    simp [cZeroCoordinateCut_apply]
  normalized := by
    classical
    ext a j
    change cZeroCoordinateCut Set.univ a j = a j
    simp [cZeroCoordinateCut_apply]
  mul_eq A B := by
    classical
    ext a j
    change cZeroCoordinateCut A.1 (cZeroCoordinateCut B.1 a) j =
      cZeroCoordinateCut (A.1 ∩ B.1) a j
    simp only [cZeroCoordinateCut_apply, Set.mem_inter_iff]
    by_cases hA : j ∈ A.1 <;> by_cases hB : j ∈ B.1 <;> simp [hA, hB]
  countably_additive A hA a := by
    classical
    let owner (j : ℕ) := if h : ∃ n, j ∈ (A n).1 then h.choose else 0
    have howner (j : ℕ) {n : ℕ} (hj : j ∈ (A n).1) : owner j = n := by
      have h : ∃ m, j ∈ (A m).1 := ⟨n, hj⟩
      have hh : owner j = h.choose := by
        change (if h : ∃ m, j ∈ (A m).1 then h.choose else 0) = _
        rw [dite_eq_left h]
      rw [hh]
      by_contra hn
      exact (Set.disjoint_left.mp (hA hn)) h.choose_spec hj
    have hsum (s : Finset ℕ) (j : ℕ) :
        (∑ n ∈ s, cZeroCoordinateCut (A n).1 a) j =
          if j ∈ ⋃ n ∈ s, (A n).1 then a j else 0 := by
      let ev : CZero →+ ℝ := ⟨⟨fun a => a j, rfl⟩, fun _ _ => rfl⟩
      change ev (∑ n ∈ s, cZeroCoordinateCut (A n).1 a) = _
      rw [map_sum]
      change (∑ n ∈ s, cZeroCoordinateCut (A n).1 a j) = _
      simp only [cZeroCoordinateCut_apply, Set.mem_iUnion, exists_prop]
      by_cases h : ∃ n ∈ s, j ∈ (A n).1
      · obtain ⟨n, hn, hj⟩ := h
        rw [ite_eq_left ⟨n, hn, hj⟩, Finset.sum_eq_single_of_mem n hn]
        · simp [hj]
        · intro m hm hne
          exact ite_eq_right (fun hmem => Set.disjoint_left.mp (hA hne) hmem hj)
      · rw [ite_eq_right h]
        exact Finset.sum_eq_zero fun n hn => ite_eq_right (fun hj => h ⟨n, hn, hj⟩)
    change Tendsto (fun s : Finset ℕ => ∑ n ∈ s, cZeroCoordinateCut (A n).1 a)
      atTop (𝓝 (cZeroCoordinateCut (⋃ n, (A n).1) a))
    rw [Metric.tendsto_nhds]
    intro ε hε
    obtain ⟨k, hk⟩ := coord_cZero_eventually_small a (ε / 2) (by positivity)
    filter_upwards [eventually_ge_atTop ((Finset.range k).image owner)] with s hs
    rw [dist_eq_norm]
    refine lt_of_le_of_lt (b := ε / 2) (coord_cZero_norm_le _ (by positivity) fun j => ?_) (by linarith)
    rw [sub_apply]
    rw [hsum, cZeroCoordinateCut_apply]
    by_cases h : j ∈ ⋃ n, (A n).1
    · by_cases hj : j < k
      · obtain ⟨n, hn⟩ := Set.mem_iUnion.mp h
        have hm : n ∈ s := hs (Finset.mem_image.mpr
          ⟨j, Finset.mem_range.mpr hj, howner j hn⟩)
        have hall : j ∈ ⋃ n ∈ s, (A n).1 :=
          Set.mem_iUnion.mpr ⟨n, Set.mem_iUnion.mpr ⟨hm, hn⟩⟩
        simpa [h, hall] using (show 0 ≤ ε / 2 by positivity)
      · have hh := (hk j (Nat.le_of_not_gt hj)).le
        by_cases hm : j ∈ ⋃ n ∈ s, (A n).1
        · simpa [h, hm] using (show 0 ≤ ε / 2 by positivity)
        · simpa [h, hm] using hh
    · have hh : j ∉ ⋃ n ∈ s, (A n).1 := fun hj => by
        obtain ⟨n, hj⟩ := Set.mem_iUnion.mp hj
        obtain ⟨_, hmem⟩ := Set.mem_iUnion.mp hj
        exact h (Set.mem_iUnion.mpr ⟨n, hmem⟩)
      simpa [h, hh] using (show 0 ≤ ε / 2 by positivity)

#print axioms cZeroCoordinatePVM

def cZeroCoordinateVector (n : ℕ) : CZero where
  toContinuousMap := ⟨fun j => if j = n then 1 else 0, continuous_of_discreteTopology⟩
  zero_at_infty' := by
    rw [cocompact_eq_atTop]
    apply tendsto_const_nhds.congr'
    filter_upwards [eventually_gt_atTop n] with j hj
    rw [ite_eq_right (ne_of_gt hj)]

def cZeroCoordinateEval (n : ℕ) : Dual CZero :=
  LinearMap.mkContinuous
    { toFun := fun a => a n
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl } 1 (fun a => by
    change |a n| ≤ 1 * ‖a‖
    rw [one_mul]
    exact BoundedContinuousFunction.norm_coe_le_norm a.toBCF n)

private theorem coord_cZero_single_action (n : ℕ) (a : CZero) :
    cZeroCoordinatePVM.val (MeasSet.natAtom n) a = (a n) • cZeroCoordinateVector n := by
  classical
  ext j
  change cZeroCoordinateCut {n} a j = a n * (if j = n then 1 else 0)
  rw [cZeroCoordinateCut_apply]
  by_cases hj : j = n
  · subst j
    simp
  · simp [hj]

/-- Each atomic cut of a normal bidual vector is represented by one coordinate
of an original vector. This gives the localization in the c₀ example. -/
theorem cZeroCoordinatePVM_localizes : cZeroCoordinatePVM.Localizes := by
  apply cZeroCoordinatePVM.localizes_of_exists_partition
  intro ξ _
  refine ⟨MeasSet.natAtom, ?_, ?_, fun n => ?_⟩
  · intro n m h
    exact Set.disjoint_singleton.mpr h
  · ext n
    simp [MeasSet.iUnion, MeasSet.natAtom, MeasSet.whole]
  · refine ⟨ξ (cZeroCoordinateEval n) • cZeroCoordinateVector n, ?_⟩
    ext f
    have hcoef : adjoint (cZeroCoordinatePVM.val (MeasSet.natAtom n)) f =
        f (cZeroCoordinateVector n) • cZeroCoordinateEval n := by
      ext a
      change f (cZeroCoordinatePVM.val (MeasSet.natAtom n) a) =
        f (cZeroCoordinateVector n) * a n
      rw [coord_cZero_single_action, map_smul]
      exact mul_comm _ _
    rw [secondAdjoint_apply, hcoef, J_apply, map_smul, map_smul]
    exact mul_comm _ _

#print axioms cZeroCoordinatePVM_localizes

/-- The canonical scalar sequence-space dualities c₀* = ℓ¹ and ℓ¹* = ℓ∞.
The ℓ¹ coefficients give a norm-convergent expansion of each functional. -/
axiom citeCZeroSequenceDuality :
    (∀ f : Dual CZero, HasSum (fun n => f (cZeroCoordinateVector n) • cZeroCoordinateEval n) f) ∧
    ∃ e : Bidual CZero ≃ₗᵢ[ℝ] DiscreteBoundedRealFunctions ℕ,
      ∀ (ξ : Bidual CZero) (n : ℕ), e ξ n = ξ (cZeroCoordinateEval n)

/-- All bidual vectors of c₀ are normal for its coordinate PVM, and the
canonical image is proper under the canonical isometry to ℓ∞. -/
theorem cZeroCoordinatePVM_normal_part :
    (∀ ξ : Bidual CZero, cZeroCoordinatePVM.toOVM.Normal ξ) ∧
    ∃ e : Bidual CZero ≃ₗᵢ[ℝ] DiscreteBoundedRealFunctions ℕ,
      (∀ (a : CZero) (n : ℕ), e (J a) n = a n) ∧
      ∃ ξ : Bidual CZero, ∀ a : CZero, J a ≠ ξ := by
  obtain ⟨hdual, e, he⟩ := citeCZeroSequenceDuality
  have heJ (a : CZero) (n : ℕ) : e (J a) n = a n := he _ _
  refine ⟨?_, e, heJ, e.symm 1, ?_⟩
  · intro ξ
    apply cZeroCoordinatePVM.toOVM.normal_of_baireOne ξ
    refine ⟨fun N => ∑ n ∈ Finset.range N, ξ (cZeroCoordinateEval n) • cZeroCoordinateVector n, ?_⟩
    intro f
    have h := (ξ.continuous.tendsto f).comp (hdual f).tendsto_sum_nat
    have hN (N : ℕ) :
        f (∑ n ∈ Finset.range N, ξ (cZeroCoordinateEval n) • cZeroCoordinateVector n) =
          ξ (∑ n ∈ Finset.range N, f (cZeroCoordinateVector n) • cZeroCoordinateEval n) := by
      simp only [map_sum, map_smul]
      exact Finset.sum_congr rfl fun n _ => mul_comm _ _
    simpa only [Function.comp_def, hN] using h
  · intro a ha
    have ha1 (n : ℕ) : a n = 1 := by
      rw [← heJ, ha, e.apply_symm_apply]
      rfl
    obtain ⟨k, hk⟩ := coord_cZero_eventually_small a 1 one_pos
    have h := hk k le_rfl
    rw [ha1, abs_one] at h
    exact (lt_irrefl _) h

#print axioms cZeroCoordinatePVM_normal_part

end CZeroCoordinate

noncomputable section BochnerNormalMeasure

open MeasureTheory

variable {Ω X Y : Type*} [MeasurableSpace Ω]
  [NormedAddCommGroup X] [NormedSpace ℝ X]
  [NormedAddCommGroup Y] [NormedSpace ℝ Y] [CompleteSpace Y]

/-- The vector measure determined by the constant dual fields in the reverse
direction of prop:bochner-normal. The estimate on finite simple fields yields
the total-variation bounds used before applying the Radon–Nikodym property. -/
theorem PVM.exists_vectorMeasure_of_normal_constants (P : PVM Ω X)
    (C : Dual Y →L[ℝ] Dual X) (hY : IsReflexive Y) (ρ : Measure Ω)
    (hρ : ∀ E : MeasSet Ω, ρ E.1 = 0 → P.val E = 0)
    (N : ℝ) (hN : ∀ (A : ℕ → MeasSet Ω), MeasSet.DisjointSeq A →
      ∀ (s : Finset ℕ) (g : ℕ → Dual Y), (∀ n ∈ s, ‖g n‖ ≤ 1) →
        ‖∑ n ∈ s, adjoint (P.val (A n)) (C (g n))‖ ≤ N)
    (ξ : Bidual X) (hξ : P.toOVM.Normal ξ) :
    ∃ m : MeasSet Ω → Y,
      m MeasSet.empty = 0 ∧
      (∀ A : ℕ → MeasSet Ω, MeasSet.DisjointSeq A → HasSum (fun n => m (A n)) (m (MeasSet.iUnion A))) ∧
      (∀ (E : MeasSet Ω) (g : Dual Y), g (m E) = ξ (adjoint (P.val E) (C g))) ∧
      (∀ E : MeasSet Ω, ρ E.1 = 0 → m E = 0) ∧
      ∀ (A : ℕ → MeasSet Ω), MeasSet.DisjointSeq A → ∀ s : Finset ℕ,
        ∑ n ∈ s, ‖m (A n)‖ ≤ ‖ξ‖ * N := by
  classical
  let coeff (E : MeasSet Ω) : Bidual Y :=
    ξ.comp (((ContinuousLinearMap.compL ℝ X X ℝ).flip (P.val E)).comp C)
  choose m hm using fun E : MeasSet Ω => hY (coeff E)
  have hm_eval (E : MeasSet Ω) (g : Dual Y) : g (m E) = ξ (adjoint (P.val E) (C g)) := by
    exact DFunLike.congr_fun (hm E) g
  have hzero (E : MeasSet Ω) (hE : P.val E = 0) : m E = 0 := by
    apply eq_of_dual_eval
    intro g
    rw [hm_eval, hE]
    simp [adjoint]
  have hempty : m MeasSet.empty = 0 := hzero _ P.toOVM.empty_eq
  have hadd (A : ℕ → MeasSet Ω) (hA : MeasSet.DisjointSeq A) :
      HasSum (fun n => m (A n)) (m (MeasSet.iUnion A)) := by
    let B (b : ℕ → Bool) (n : ℕ) := if b n then A n else MeasSet.empty
    have hB (b : ℕ → Bool) : MeasSet.DisjointSeq (B b) := by
      intro i j hij
      cases hi : b i <;> cases hj : b j <;> simp [B, hi, hj, MeasSet.empty, hA hij]
    have h := hasSum_of_weak_subseries (fun n => m (A n)) (fun b => m (MeasSet.iUnion (B b))) (by
      intro b g
      have hsum := hξ (B b) (hB b) (C g)
      rw [← hm_eval] at hsum
      convert hsum using 1
      funext n
      rw [← hm_eval]
      cases hn : b n <;> simp [B, hn, hempty])
    simpa [B] using h
  refine ⟨m, hempty, hadd, hm_eval, fun E hE => hzero E (hρ E hE), ?_⟩
  intro A hA s
  have hex (n : ℕ) : ∃ g : Dual Y, ‖g‖ ≤ 1 ∧ g (m (A n)) = ‖m (A n)‖ := by
    by_cases h : m (A n) = 0
    · exact ⟨0, by simp, by simp [h]⟩
    · obtain ⟨g, hg, hgval⟩ := exists_dual_vector ℝ (m (A n)) (norm_ne_zero_iff.mpr h)
      exact ⟨g, hg.le, hgval⟩
  choose g hg hgval using hex
  have hsum : ∑ n ∈ s, ‖m (A n)‖ = ξ (∑ n ∈ s, adjoint (P.val (A n)) (C (g n))) := by
    rw [map_sum]
    apply Finset.sum_congr rfl
    intro n _
    rw [← hgval, hm_eval]
  rw [hsum]
  exact (le_abs_self _).trans ((ξ.le_opNorm _).trans
    (mul_le_mul_of_nonneg_left (hN A hA s g (fun n _ => hg n)) (norm_nonneg ξ)))

#print axioms PVM.exists_vectorMeasure_of_normal_constants

end BochnerNormalMeasure

noncomputable section BochnerNormalDensity

open MeasureTheory

variable {Ω X Y : Type*} [MeasurableSpace Ω]
  [NormedAddCommGroup X] [NormedSpace ℝ X]
  [NormedAddCommGroup Y] [NormedSpace ℝ Y] [CompleteSpace Y]

/-- Diestel–Uhl, Vector Measures, Chapter III. A reflexive Banach space
has the Radon–Nikodým property for finite control measures. -/
axiom citeReflexiveVectorRadonNikodym (ρ : Measure Ω) [IsFiniteMeasure ρ]
    (hY : IsReflexive Y) (m : MeasSet Ω → Y) (h₀ : m MeasSet.empty = 0)
    (hadd : ∀ A : ℕ → MeasSet Ω, MeasSet.DisjointSeq A →
      HasSum (fun n => m (A n)) (m (MeasSet.iUnion A)))
    (hnull : ∀ E : MeasSet Ω, ρ E.1 = 0 → m E = 0)
    (hvar : ∃ M : ℝ, ∀ (A : ℕ → MeasSet Ω), MeasSet.DisjointSeq A →
      ∀ s : Finset ℕ, ∑ n ∈ s, ‖m (A n)‖ ≤ M) :
    ∃ h : Ω → Y, Integrable h ρ ∧ ∀ E : MeasSet Ω, m E = ∫ t in E.1, h t ∂ρ

/-- Normality and the bound on finite simple dual fields produce a
Bochner density representing every constant dual field on every cut. -/
theorem PVM.exists_bochner_density_of_normal_constants (P : PVM Ω X)
    (C : Dual Y →L[ℝ] Dual X) (hY : IsReflexive Y) (ρ : Measure Ω) [IsFiniteMeasure ρ]
    (hρ : ∀ E : MeasSet Ω, ρ E.1 = 0 → P.val E = 0)
    (N : ℝ) (hN : ∀ (A : ℕ → MeasSet Ω), MeasSet.DisjointSeq A →
      ∀ (s : Finset ℕ) (g : ℕ → Dual Y), (∀ n ∈ s, ‖g n‖ ≤ 1) →
        ‖∑ n ∈ s, adjoint (P.val (A n)) (C (g n))‖ ≤ N)
    (ξ : Bidual X) (hξ : P.toOVM.Normal ξ) :
    ∃ h : Ω → Y, Integrable h ρ ∧ ∀ (E : MeasSet Ω) (g : Dual Y),
      ξ (adjoint (P.val E) (C g)) = ∫ t in E.1, g (h t) ∂ρ := by
  obtain ⟨m, h₀, hadd, hcoeff, hnull, hvar⟩ :=
    P.exists_vectorMeasure_of_normal_constants C hY ρ hρ N hN ξ hξ
  obtain ⟨h, hi, hm⟩ := citeReflexiveVectorRadonNikodym ρ hY m h₀ hadd hnull ⟨_, hvar⟩
  refine ⟨h, hi, fun E g => ?_⟩
  rw [← hcoeff, hm, ← g.integral_comp_comm (hi.restrict (s := E.1))]

/-- The integral pairing agrees with a normal functional on a countably
valued field if it agrees on each member of the field's partition. This
requires integrability of the actual scalar product, not density of
finite simple functions in the dual norm. -/
theorem PVM.normal_integral_of_partition (P : PVM Ω X)
    (ρ : Measure Ω) (ξ : Bidual X) (hξ : P.toOVM.Normal ξ) (f : Dual X)
    (A : ℕ → MeasSet Ω) (hA : MeasSet.DisjointSeq A) (hu : MeasSet.iUnion A = MeasSet.whole)
    (a : Ω → ℝ) (hi : Integrable a ρ)
    (ha : ∀ n, ξ (adjoint (P.val (A n)) f) = ∫ t in (A n).1, a t ∂ρ) :
    ξ f = ∫ t, a t ∂ρ := by
  have hs := hξ A hA f
  have ht := hasSum_integral_iUnion (fun n => (A n).2) hA hi.integrableOn
  rw [hu, P.normalized, show adjoint (ContinuousLinearMap.id ℝ X) f = f by
    ext x; rfl] at hs
  change HasSum _ (∫ t in (MeasSet.iUnion A).1, a t ∂ρ) at ht
  rw [hu] at ht
  exact hs.unique (by simpa only [ha, MeasSet.whole, Measure.restrict_univ] using ht)

/-- An integrable scalar pairing on each coefficient proves normality
directly by scalar countable additivity. -/
theorem PVM.normal_of_coefficient_setIntegral (P : PVM Ω X) (ρ : Measure Ω) (ξ : Bidual X)
    (h : ∀ f : Dual X, ∃ a : Ω → ℝ, Integrable a ρ ∧
      ∀ E : MeasSet Ω, ξ (adjoint (P.val E) f) = ∫ t in E.1, a t ∂ρ) :
    P.toOVM.Normal ξ := by
  intro A hA f
  obtain ⟨a, ha, hcoeff⟩ := h f
  simp only [hcoeff]
  exact hasSum_integral_iUnion (fun n => (A n).2) hA ha.integrableOn

#print axioms PVM.exists_bochner_density_of_normal_constants
#print axioms PVM.normal_integral_of_partition
#print axioms PVM.normal_of_coefficient_setIntegral

end BochnerNormalDensity

noncomputable section BochnerSelection

open MeasureTheory

variable {Ω Y : Type*} [MeasurableSpace Ω] [NormedAddCommGroup Y] [NormedSpace ℝ Y]

/-- Selecting the first member of a countable measurable cover is measurable. -/
private theorem measurable_first_cover (A : ℕ → Set Ω) (hm : ∀ n, MeasurableSet (A n))
    (hc : ∀ t, ∃ n, t ∈ A n) : ∃ j : Ω → ℕ, Measurable j ∧ ∀ t, t ∈ A (j t) := by
  classical
  let j (t : Ω) : ℕ := Nat.find (hc t)
  refine ⟨j, measurable_to_countable (fun t => ?_), fun t => Nat.find_spec (hc t)⟩
  have he (n : ℕ) : j ⁻¹' {n} = A n ∩ ⋂ i : Fin n, (A i)ᶜ := by
    ext z
    change j z = n ↔ _
    rw [Nat.find_eq_iff]
    simp only [mem_inter_iff, mem_iInter, mem_compl_iff]
    exact and_congr_right (fun _ => ⟨fun h i => h i i.isLt, fun h i hi => h ⟨i, hi⟩⟩)
  rw [he]
  exact (hm _).inter (MeasurableSet.iInter fun i => (hm i).compl)

omit [NormedSpace ℝ Y] in
/-- A countable set contains the ranges of all finite approximants. -/
private theorem exists_stronglyMeasurable_sample (v : Ω → Y) (hv : StronglyMeasurable v) :
    ∃ d : ℕ → Y, ∀ t ε, 0 < ε → ∃ n, dist (v t) (d n) < ε := by
  let A : Set Y := (⋃ n, Set.range (hv.approx n)) ∪ {0}
  have hA : A.Countable :=
    (Set.countable_iUnion fun n => (hv.approx n).finite_range.countable).union (Set.countable_singleton 0)
  have hn : A.Nonempty := ⟨0, Or.inr rfl⟩
  obtain ⟨d, hd⟩ := hA.exists_eq_range hn
  refine ⟨d, fun t ε he => ?_⟩
  obtain ⟨N, hN⟩ := Metric.tendsto_atTop.mp (hv.tendsto_approx t) ε he
  have hh : hv.approx N t ∈ A := Or.inl (mem_iUnion.mpr ⟨N, ⟨t, rfl⟩⟩)
  rw [hd] at hh
  obtain ⟨n, hn⟩ := hh
  exact ⟨n, hn ▸ (by simpa only [dist_comm] using hN N le_rfl)⟩

/-- The measurable countably valued almost-norming field used in
Manuscript, prop:bochner-normal. It works for arbitrary range spaces. -/
theorem exists_stronglyMeasurable_normingField (v : Ω → Y) (hv : StronglyMeasurable v)
    (ε : ℝ) (he : 0 < ε) :
    ∃ s : Ω → Dual Y, StronglyMeasurable s ∧ (Set.range s).Countable ∧
      ∀ t, ‖s t‖ ≤ 1 ∧ (1 - ε) * ‖v t‖ ≤ s t (v t) := by
  classical
  obtain ⟨d, hd⟩ := exists_stronglyMeasurable_sample v hv
  have hn (n : ℕ) : ∃ f : Dual Y, ‖f‖ ≤ 1 ∧ f (d n) = ‖d n‖ := by
    by_cases h : d n = 0
    · exact ⟨0, by simp, by simp [h]⟩
    · obtain ⟨f, hf, hf'⟩ := exists_dual_vector ℝ (d n) (norm_ne_zero_iff.mpr h)
      exact ⟨f, hf.le, hf'⟩
  choose f hf hfn using hn
  let A (n : ℕ) : Set Ω := {t | (1 - ε) * ‖v t‖ ≤ f n (v t)}
  have hA (n : ℕ) : MeasurableSet (A n) := by
    let : MeasurableSpace Y := borel Y
    let : BorelSpace Y := ⟨rfl⟩
    exact measurableSet_le (measurable_const.mul hv.measurable.norm)
      ((f n).continuous.measurable.comp hv.measurable)
  have hc (t : Ω) : ∃ n, t ∈ A n := by
    by_cases ht : v t = 0
    · exact ⟨0, by simp [A, ht]⟩
    have hpos : 0 < ‖v t‖ := norm_pos_iff.mpr ht
    obtain ⟨n, hn⟩ := hd t (ε * ‖v t‖ / 2) (by positivity)
    have hΔ : ‖v t - d n‖ < ε * ‖v t‖ / 2 := by simpa only [dist_eq_norm] using hn
    have hnorm := norm_sub_norm_le (v t) (d n)
    have hdual := (f n).le_opNorm (v t - d n)
    have hneg : -(f n (v t - d n)) ≤ ‖v t - d n‖ :=
      (neg_le_abs _).trans (hdual.trans (mul_le_of_le_one_left (norm_nonneg _) (hf n)))
    rw [map_sub, hfn] at hneg
    refine ⟨n, ?_⟩
    change (1 - ε) * ‖v t‖ ≤ f n (v t)
    linarith
  obtain ⟨j, hj, hj'⟩ := measurable_first_cover A hA hc
  let s : Ω → Dual Y := f ∘ j
  have hs : (Set.range s).Countable := (Set.countable_range f).mono (Set.range_comp_subset_range _ _)
  refine ⟨s, ?_, hs, fun t => ⟨hf (j t), hj' t⟩⟩
  let : MeasurableSpace (Dual Y) := borel (Dual Y)
  let : BorelSpace (Dual Y) := ⟨rfl⟩
  exact stronglyMeasurable_iff_measurable_separable.mpr
    ⟨(measurable_of_countable f).comp hj, hs.isSeparable⟩

#print axioms exists_stronglyMeasurable_normingField

omit [NormedSpace ℝ Y] in
/-- Uniform approximation by a countably valued measurable field with
explicit measurable fibers. The range space need not be separable. -/
theorem exists_measurable_uniform_countableApprox (v : Ω → Y) (hv : StronglyMeasurable v)
    {ε : ℝ} (he : 0 < ε) : ∃ (d : ℕ → Y) (j : Ω → ℕ),
    Measurable j ∧ StronglyMeasurable (d ∘ j) ∧ ∀ t, ‖v t - d (j t)‖ < ε := by
  obtain ⟨d, hd⟩ := exists_stronglyMeasurable_sample v hv
  let : MeasurableSpace Y := borel Y
  let : BorelSpace Y := ⟨rfl⟩
  let A (n : ℕ) : Set Ω := {t | dist (v t) (d n) < ε}
  have hm (n : ℕ) : MeasurableSet (A n) :=
    measurableSet_lt ((continuous_id.dist continuous_const).measurable.comp hv.measurable)
      measurable_const
  obtain ⟨j, hj, hdist⟩ := measurable_first_cover A hm (fun t => hd t ε he)
  refine ⟨d, j, hj, ?_, ?_⟩
  · exact stronglyMeasurable_iff_measurable_separable.mpr
      ⟨(measurable_of_countable d).comp hj,
        ((Set.countable_range d).mono (Set.range_comp_subset_range _ _)).isSeparable⟩
  · simpa only [A, mem_ofPred_eq, dist_eq_norm] using hdist

#print axioms exists_measurable_uniform_countableApprox

end BochnerSelection

noncomputable section BochnerPairing

open MeasureTheory

variable {Ω X Y : Type*} [MeasurableSpace Ω] [NormedAddCommGroup X] [NormedSpace ℝ X]
  [NormedAddCommGroup Y] [NormedSpace ℝ Y]

private theorem stronglyMeasurable_dualPairing (h : Ω → Y) (k : Ω → Dual Y)
    (hh : StronglyMeasurable h) (hk : StronglyMeasurable k) :
    StronglyMeasurable (fun t => k t (h t)) :=
  (continuous_fst.clm_apply continuous_snd).comp_stronglyMeasurable (hk.prodMk hh)

private theorem integrable_bounded_dualPairing (ρ : Measure Ω) (h : Ω → Y) (k : Ω → Dual Y)
    (hh : StronglyMeasurable h) (hi : Integrable h ρ) (hk : StronglyMeasurable k)
    (R : ℝ) (hR : ∀ t, ‖k t‖ ≤ R) : Integrable (fun t => k t (h t)) ρ :=
  (hi.norm.const_mul R).mono' (stronglyMeasurable_dualPairing h k hh hk).aestronglyMeasurable
    (Eventually.of_forall fun t => ((k t).le_opNorm (h t)).trans
      (mul_le_mul_of_nonneg_right (hR t) (norm_nonneg _)))

/-- Uniform approximation by countably valued fields extends the constant-field
pairing to every bounded strongly measurable dual field. -/
theorem PVM.normal_integral_of_bounded_fields (P : PVM Ω X) (ρ : Measure Ω)
    (F : (Ω → Dual Y) → Dual X)
    (hcut : ∀ (E : MeasSet Ω) (k : Ω → Dual Y), StronglyMeasurable k →
      (∃ M : ℝ, ∀ t, ‖k t‖ ≤ M) → adjoint (P.val E) (F k) = F (E.1.indicator k))
    (N : ℝ) (hN : 0 ≤ N)
    (hF : ∀ (k l : Ω → Dual Y), StronglyMeasurable k → StronglyMeasurable l →
      (∃ M : ℝ, ∀ t, ‖k t‖ ≤ M) → ∀ δ ≥ 0, (∀ t, ‖k t - l t‖ ≤ δ) →
        ‖F k - F l‖ ≤ N * δ)
    (ξ : Bidual X) (hξ : P.toOVM.Normal ξ) (h : Ω → Y)
    (hh : StronglyMeasurable h) (hi : Integrable h ρ)
    (hconst : ∀ (E : MeasSet Ω) (g : Dual Y),
      ξ (adjoint (P.val E) (F fun _ => g)) = ∫ t in E.1, g (h t) ∂ρ)
    (k : Ω → Dual Y) (hk : StronglyMeasurable k) (R : ℝ) (hR : ∀ t, ‖k t‖ ≤ R) :
    ξ (F k) = ∫ t, k t (h t) ∂ρ := by
  classical
  let M := ‖ξ‖ * N + ∫ t, ‖h t‖ ∂ρ
  have hM : 0 ≤ M := add_nonneg (mul_nonneg (norm_nonneg ξ) hN)
    (integral_nonneg fun t => norm_nonneg _)
  have hpair (ε : ℝ) (he : 0 < ε) :
      ‖ξ (F k) - ∫ t, k t (h t) ∂ρ‖ ≤ ε := by
    let δ := ε / (1 + M)
    have hpos : 0 < 1 + M := by linarith
    have hδ : 0 < δ := div_pos he hpos
    obtain ⟨d, j, hj, hq, hclose⟩ := exists_measurable_uniform_countableApprox k hk hδ
    let q := d ∘ j
    let A (n : ℕ) : MeasSet Ω := ⟨j ⁻¹' {n}, hj (measurableSet_singleton n)⟩
    have hA : MeasSet.DisjointSeq A := by
      intro m n hmn
      apply Set.disjoint_left.mpr
      intro t ht hs
      exact hmn ((show j t = m from ht).symm.trans (show j t = n from hs))
    have hAu : MeasSet.iUnion A = MeasSet.whole := by
      ext t
      exact ⟨fun _ => Set.mem_univ t, fun _ => mem_iUnion.mpr ⟨j t, rfl⟩⟩
    have hclose' (t : Ω) : ‖k t - q t‖ ≤ δ := (hclose t).le
    have hQ (t : Ω) : ‖q t‖ ≤ R + δ := by
      have ht := norm_sub_norm_le (q t) (k t)
      rw [norm_sub_rev] at ht
      linarith [hR t, hclose' t]
    have hqi := integrable_bounded_dualPairing ρ h q hh hi hq (R + δ) hQ
    have hki := integrable_bounded_dualPairing ρ h k hh hi hk R hR
    have hqpair : ξ (F q) = ∫ t, q t (h t) ∂ρ := by
      apply P.normal_integral_of_partition ρ ξ hξ (F q) A hA hAu _ hqi
      intro n
      have heq : (A n).1.indicator q = (A n).1.indicator (fun _ => d n) := by
        funext t
        by_cases ht : t ∈ (A n).1
        · rw [Set.indicator_of_mem ht, Set.indicator_of_mem ht]
          exact congrArg d (show j t = n from ht)
        · rw [Set.indicator_of_notMem ht, Set.indicator_of_notMem ht]
      rw [hcut (A n) q hq ⟨_, hQ⟩, heq, ← hcut (A n) _ stronglyMeasurable_const ⟨_, fun _ => le_rfl⟩, hconst]
      apply setIntegral_congr_fun (A n).2
      intro t ht
      change d n (h t) = q t (h t)
      rw [show q t = d n from congrArg d (show j t = n from ht)]
    have hdual : ‖ξ (F k) - ξ (F q)‖ ≤ ‖ξ‖ * (N * δ) := by
      rw [← map_sub]
      exact (ξ.le_opNorm _).trans
        (mul_le_mul_of_nonneg_left (hF k q hk hq ⟨R, hR⟩ δ hδ.le hclose') (norm_nonneg ξ))
    have hint : ‖(∫ t, q t (h t) ∂ρ) - ∫ t, k t (h t) ∂ρ‖ ≤
        δ * ∫ t, ‖h t‖ ∂ρ := by
      rw [← integral_sub hqi hki, ← integral_const_mul]
      apply norm_integral_le_of_norm_le (hi.norm.const_mul δ)
      exact Eventually.of_forall fun t => by
        rw [← sub_apply]
        exact ((q t - k t).le_opNorm (h t)).trans
          (mul_le_mul_of_nonneg_right (by simpa only [norm_sub_rev] using hclose' t) (norm_nonneg _))
    have hsum : ξ (F k) - (∫ t, k t (h t) ∂ρ) =
        (ξ (F k) - ξ (F q)) + ((∫ t, q t (h t) ∂ρ) - ∫ t, k t (h t) ∂ρ) := by
      rw [← hqpair]
      ring
    rw [hsum]
    calc
      _ ≤ _ := norm_add_le _ _
      _ ≤ ‖ξ‖ * (N * δ) + δ * ∫ t, ‖h t‖ ∂ρ := add_le_add hdual hint
      _ = δ * M := by dsimp [M]; ring
      _ ≤ ε := by
        have hε : δ * (1 + M) = ε := div_mul_cancel₀ _ hpos.ne'
        nlinarith [hδ.le]
  have hz : ‖ξ (F k) - ∫ t, k t (h t) ∂ρ‖ = 0 :=
    le_antisymm (le_of_forall_pos_le_add fun ε he => by simpa only [zero_add] using hpair ε he)
      (norm_nonneg _)
  exact sub_eq_zero.mp (norm_eq_zero.mp hz)

#print axioms PVM.normal_integral_of_bounded_fields

/-- For an integrable pairing, the bounded-field identity extends along
the disjoint partition by levels of the dual field's norm. -/
theorem PVM.normal_integral_of_bounded_cuts (P : PVM Ω X) (ρ : Measure Ω)
    (ξ : Bidual X) (hξ : P.toOVM.Normal ξ) (f : Dual X)
    (h : Ω → Y) (k : Ω → Dual Y) (hk : StronglyMeasurable k)
    (hi : Integrable (fun t => k t (h t)) ρ)
    (hcut : ∀ E : MeasSet Ω, (∃ M : ℝ, ∀ t ∈ E.1, ‖k t‖ ≤ M) →
      ξ (adjoint (P.val E) f) = ∫ t, (E.1.indicator k) t (h t) ∂ρ) :
    ξ f = ∫ t, k t (h t) ∂ρ := by
  classical
  let B (n : ℕ) : Set Ω := {t | ‖k t‖ ≤ (n : ℝ)}
  have hm (n : ℕ) : MeasurableSet (B n) :=
    measurableSet_le hk.norm.measurable measurable_const
  obtain ⟨j, hj, hlevel⟩ := measurable_first_cover B hm (fun t => exists_nat_ge ‖k t‖)
  let A (n : ℕ) : MeasSet Ω := ⟨j ⁻¹' {n}, hj (measurableSet_singleton n)⟩
  have hA : MeasSet.DisjointSeq A := by
    intro m n hmn
    exact Set.disjoint_left.mpr (fun t ht hs =>
      hmn ((show j t = m from ht).symm.trans (show j t = n from hs)))
  have hu : MeasSet.iUnion A = MeasSet.whole := by
    ext t
    exact ⟨fun _ => Set.mem_univ t, fun _ => mem_iUnion.mpr ⟨j t, rfl⟩⟩
  apply P.normal_integral_of_partition ρ ξ hξ f A hA hu _ hi
  intro n
  rw [hcut (A n) ⟨n, fun t ht => by
    have hh := hlevel t
    change ‖k t‖ ≤ ↑(j t) at hh
    rwa [show j t = n from ht] at hh⟩, ← integral_indicator (A n).2]
  congr 1
  funext t
  by_cases ht : t ∈ (A n).1 <;> simp [ht]

/-- Bounded truncations of a representing density give canonical
representatives of its cuts and hence localization. -/
theorem PVM.localizes_of_bochner_representatives (P : PVM Ω X) (ρ : Measure Ω)
    (K : Dual X → Ω → Dual Y)
    (hrep : ∀ ξ : Bidual X, P.toOVM.Normal ξ → ∃ h : Ω → Y,
      StronglyMeasurable h ∧
      ∀ (f : Dual X) (E : MeasSet Ω),
        ξ (adjoint (P.val E) f) = ∫ t in E.1, K f t (h t) ∂ρ)
    (hbounded : ∀ v : Ω → Y, StronglyMeasurable v →
      (∃ M : ℝ, ∀ t, ‖v t‖ ≤ M) →
      ∃ x : X, ∀ f : Dual X, f x = ∫ t, K f t (v t) ∂ρ) :
    P.Localizes := by
  classical
  intro ξ hξ
  obtain ⟨h, hh, hcoeff⟩ := hrep ξ hξ
  let A (n : ℕ) : MeasSet Ω :=
    ⟨{t | ‖h t‖ ≤ (n : ℝ)}, measurableSet_le hh.norm.measurable measurable_const⟩
  refine ⟨A, ?_, ?_, fun n => ?_⟩
  · intro i j hij t ht
    exact (show ‖h t‖ ≤ (i : ℝ) from ht).trans (by exact_mod_cast hij)
  · ext t
    exact ⟨fun _ => Set.mem_univ t, fun _ => mem_iUnion.mpr (exists_nat_ge ‖h t‖)⟩
  · obtain ⟨x, hx⟩ := hbounded ((A n).1.indicator h) (hh.indicator (A n).2)
      ⟨n, fun t => by
        by_cases ht : t ∈ (A n).1
        · rw [Set.indicator_of_mem ht]
          exact ht
        · simpa only [Set.indicator_of_notMem ht, norm_zero] using (Nat.cast_nonneg n : (0 : ℝ) ≤ n)⟩
    refine ⟨x, fun f => ?_⟩
    rw [hcoeff f, hx f, ← integral_indicator (A n).2]
    congr 1
    funext t
    by_cases ht : t ∈ (A n).1 <;> simp [ht]

#print axioms PVM.normal_integral_of_bounded_cuts
#print axioms PVM.localizes_of_bochner_representatives

end BochnerPairing

noncomputable section BochnerAssociate

open MeasureTheory
open scoped ENNReal

variable {Ω X Y : Type*} [MeasurableSpace Ω] [NormedAddCommGroup X] [NormedSpace ℝ X]
  [NormedAddCommGroup Y] [NormedSpace ℝ Y]

/-- A norm bound on scalar multiples of bounded almost-norming fields
controls the full associate integral, including unbounded scalar weights. -/
theorem bochner_assoc_integral_le (ρ : Measure Ω) (F : (Ω → Dual Y) → Dual X)
    (ξ : Bidual X) (h : Ω → Y) (hh : StronglyMeasurable h) (hi : Integrable h ρ)
    (hpair : ∀ k : Ω → Dual Y, StronglyMeasurable k → (∃ R : ℝ, ∀ t, ‖k t‖ ≤ R) →
      ξ (F k) = ∫ t, k t (h t) ∂ρ)
    (b : Ω → ℝ) (hb : Measurable b) (hb0 : ∀ t, 0 ≤ b t)
    (hbound : ∀ (n : ℕ) (s : Ω → Dual Y), StronglyMeasurable s → (∀ t, ‖s t‖ ≤ 1) →
      ‖F (fun t => min (b t) n • s t)‖ ≤ 1) :
    Integrable (fun t => b t * ‖h t‖) ρ ∧
      (∫ t, b t * ‖h t‖ ∂ρ) ≤ ‖ξ‖ := by
  let w (n : ℕ) (t : Ω) : ℝ := min (b t) n
  have hwm (n : ℕ) : Measurable (w n) := hb.min measurable_const
  have hw₀ (n : ℕ) (t : Ω) : 0 ≤ w n t := le_min (hb0 t) (Nat.cast_nonneg n)
  have hwN (n : ℕ) (t : Ω) : w n t ≤ n := min_le_right _ _
  let a (n : ℕ) (t : Ω) : ℝ := w n t * ‖h t‖
  have ha₀ (n : ℕ) (t : Ω) : 0 ≤ a n t := mul_nonneg (hw₀ n t) (norm_nonneg _)
  have hai (n : ℕ) : Integrable (a n) ρ :=
    hi.norm.bdd_mul (hwm n).aestronglyMeasurable
      (Eventually.of_forall fun t => by rw [Real.norm_of_nonneg (hw₀ n t)]; exact hwN n t)
  have hia (n : ℕ) : (∫ t, a n t ∂ρ) ≤ ‖ξ‖ := by
    apply le_of_forall_pos_le_add
    intro δ hδ
    let V := ∫ t, a n t ∂ρ
    have hV : 0 ≤ V := integral_nonneg (ha₀ n)
    let ε := δ / (1 + V)
    have hp : 0 < 1 + V := by linarith
    have he : 0 < ε := div_pos hδ hp
    obtain ⟨s, hs, _, hn⟩ := exists_stronglyMeasurable_normingField h hh ε he
    let k (t : Ω) : Dual Y := w n t • s t
    have hk : StronglyMeasurable k := (hwm n).stronglyMeasurable.smul hs
    have hkN (t : Ω) : ‖k t‖ ≤ n := by
      change ‖w n t • s t‖ ≤ _
      rw [norm_smul, Real.norm_of_nonneg (hw₀ n t)]
      exact (mul_le_of_le_one_right (hw₀ n t) (hn t).1).trans (hwN n t)
    have hki := integrable_bounded_dualPairing ρ h k hh hi hk n hkN
    have hlow : (1 - ε) * V ≤ ∫ t, k t (h t) ∂ρ := by
      rw [show (1 - ε) * V = ∫ t, (1 - ε) * a n t ∂ρ by rw [integral_const_mul]]
      apply integral_mono ((hai n).const_mul _) hki
      intro t
      change (1 - ε) * (w n t * ‖h t‖) ≤ w n t * s t (h t)
      rw [← mul_left_comm]
      exact mul_le_mul_of_nonneg_left (hn t).2 (hw₀ n t)
    have hup : (∫ t, k t (h t) ∂ρ) ≤ ‖ξ‖ := by
      rw [← hpair k hk ⟨_, hkN⟩]
      have hnorm := (ξ.le_opNorm (F k)).trans (mul_le_of_le_one_right (norm_nonneg ξ) (hbound n s hs (fun t => (hn t).1)))
      exact (le_abs_self _).trans hnorm
    change V ≤ ‖ξ‖ + δ
    have hidentity : ε * (1 + V) = δ := div_mul_cancel₀ _ hp.ne'
    nlinarith [hlow.trans hup, he.le]
  have hsup (t : Ω) : (⨆ n, ENNReal.ofReal (a n t)) = ENNReal.ofReal (b t * ‖h t‖) := by
    apply le_antisymm
    · exact iSup_le fun n => ENNReal.ofReal_le_ofReal
        (mul_le_mul_of_nonneg_right (min_le_left _ _) (norm_nonneg _))
    · obtain ⟨n, hn⟩ := exists_nat_ge (b t)
      exact (show ENNReal.ofReal (b t * ‖h t‖) = ENNReal.ofReal (a n t) by
        dsimp [a, w]; rw [min_eq_left hn]).le.trans (le_iSup (fun i => ENNReal.ofReal (a i t)) n)
  have hlin : (∫⁻ t, ENNReal.ofReal (b t * ‖h t‖) ∂ρ) ≤ ENNReal.ofReal ‖ξ‖ := by
    simp_rw [← hsup]
    have ham (n : ℕ) : Measurable (fun t => ENNReal.ofReal (a n t)) :=
      ((hwm n).mul hh.norm.measurable).ennreal_ofReal
    have hmono : Monotone (fun (n : ℕ) t => ENNReal.ofReal (a n t)) := by
      intro i j hij t
      have hcast : (i : ℝ) ≤ (j : ℝ) := by exact_mod_cast hij
      exact ENNReal.ofReal_le_ofReal
        (mul_le_mul_of_nonneg_right (min_le_min_left (b t) hcast) (norm_nonneg _))
    rw [lintegral_iSup ham hmono]
    exact iSup_le fun n => by
      rw [← ofReal_integral_eq_lintegral_ofReal (hai n) (Eventually.of_forall (ha₀ n))]
      exact ENNReal.ofReal_le_ofReal (hia n)
  have hnonneg (t : Ω) : 0 ≤ b t * ‖h t‖ := mul_nonneg (hb0 t) (norm_nonneg _)
  have hfin : Integrable (fun t => b t * ‖h t‖) ρ := by
    refine ⟨(hb.mul hh.norm.measurable).aestronglyMeasurable, ?_⟩
    rw [hasFiniteIntegral_iff_norm]
    simpa only [Real.norm_of_nonneg (hnonneg _)] using hlin.trans_lt ENNReal.ofReal_lt_top
  refine ⟨hfin, ?_⟩
  rw [← ofReal_integral_eq_lintegral_ofReal hfin (Eventually.of_forall hnonneg)] at hlin
  exact (ENNReal.ofReal_le_iff_le_toReal ENNReal.ofReal_ne_top).mp hlin |>.trans_eq
    (ENNReal.toReal_ofReal (norm_nonneg ξ))

#print axioms bochner_assoc_integral_le

end BochnerAssociate

noncomputable section BochnerNormalModel

open MeasureTheory

variable {Ω X Y : Type*} [MeasurableSpace Ω] [NormedAddCommGroup X] [NormedSpace ℝ X]
  [NormedAddCommGroup Y] [NormedSpace ℝ Y]

/-- The integral description of the dual of a Köthe–Bochner space, expressed
in strongly measurable representatives. The set U represents the positive
unit ball of the scalar Köthe associate space. -/
structure KotheBochnerDualModel (P : PVM Ω X) (ρ : Measure Ω)
    (U : Set (Ω → ℝ)) (Y : Type*) [NormedAddCommGroup Y] [NormedSpace ℝ Y] where
  weights : ∀ b ∈ U, Measurable b ∧ ∀ t, 0 ≤ b t
  P_null : ∀ E : MeasSet Ω, ρ E.1 = 0 → P.val E = 0
  constants : Dual Y →L[ℝ] Dual X
  field : (Ω → Dual Y) → Dual X
  constants_eq : ∀ g, field (fun _ => g) = constants g
  rep : Dual X → Ω → Dual Y
  rep_measurable : ∀ f, StronglyMeasurable (rep f)
  rep_add : ∀ f g, rep (f + g) =ᵐ[ρ] fun t => rep f t + rep g t
  rep_smul : ∀ (a : ℝ) f, rep (a • f) =ᵐ[ρ] fun t => a • rep f t
  rep_scale : ∀ (f : Dual X) (c : ℝ), 0 < c → ‖f‖ ≤ c →
    (fun t => ‖rep f t‖ / c) ∈ U
  rep_field : ∀ (k : Ω → Dual Y), StronglyMeasurable k →
    (∃ R : ℝ, ∀ t, ‖k t‖ ≤ R) → rep (field k) =ᵐ[ρ] k
  rep_cut : ∀ E f, rep (adjoint (P.val E) f) =ᵐ[ρ] E.1.indicator (rep f)
  lift_rep_cut : ∀ E f, (∃ M : ℝ, ∀ t ∈ E.1, ‖rep f t‖ ≤ M) →
    field (E.1.indicator (rep f)) = adjoint (P.val E) f
  field_cut : ∀ (E : MeasSet Ω) (k : Ω → Dual Y), StronglyMeasurable k →
    (∃ M : ℝ, ∀ t, ‖k t‖ ≤ M) → adjoint (P.val E) (field k) = field (E.1.indicator k)
  boundConstant : ℝ
  boundConstant_nonneg : 0 ≤ boundConstant
  bounded_simple : ∀ (A : ℕ → MeasSet Ω), MeasSet.DisjointSeq A →
    ∀ (s : Finset ℕ) (g : ℕ → Dual Y), (∀ n ∈ s, ‖g n‖ ≤ 1) →
      ‖∑ n ∈ s, adjoint (P.val (A n)) (constants (g n))‖ ≤ boundConstant
  uniform_bound : ∀ (k l : Ω → Dual Y), StronglyMeasurable k → StronglyMeasurable l →
    (∃ M : ℝ, ∀ t, ‖k t‖ ≤ M) → ∀ δ ≥ 0, (∀ t, ‖k t - l t‖ ≤ δ) →
      ‖field k - field l‖ ≤ boundConstant * δ
  associate_unit_bound : ∀ b ∈ U, ∀ (n : ℕ) (s : Ω → Dual Y),
    StronglyMeasurable s → (∀ t, ‖s t‖ ≤ 1) →
    ‖field (fun t => min (b t) n • s t)‖ ≤ 1

variable {P : PVM Ω X} {ρ : Measure Ω} {U : Set (Ω → ℝ)}

private theorem KotheBochnerDualModel.integrable_pair (D : KotheBochnerDualModel P ρ U Y)
    (h : Ω → Y) (hh : StronglyMeasurable h)
    (hb : ∀ b ∈ U, Integrable (fun t => b t * ‖h t‖) ρ)
    (f : Dual X) (c : ℝ) (hc0 : 0 < c) (hfc : ‖f‖ ≤ c) :
    Integrable (fun t => ‖D.rep f t‖ * ‖h t‖) ρ ∧
      Integrable (fun t => D.rep f t (h t)) ρ := by
  have hit := (hb _ (D.rep_scale f c hc0 hfc)).const_mul c
  have hit' : Integrable (fun t => ‖D.rep f t‖ * ‖h t‖) ρ := by
    apply hit.congr
    exact Eventually.of_forall fun t => by
      change c * (‖D.rep f t‖ / c * ‖h t‖) = _
      field_simp
  exact ⟨hit', hit'.mono'
    (stronglyMeasurable_dualPairing h (D.rep f) hh (D.rep_measurable f)).aestronglyMeasurable
    (Eventually.of_forall fun t => (D.rep f t).le_opNorm _)⟩

private theorem KotheBochnerDualModel.norm_integral_pair_le (D : KotheBochnerDualModel P ρ U Y)
    (h : Ω → Y) (hh : StronglyMeasurable h) (M : ℝ) (hM : 0 ≤ M)
    (hbound : ∀ b ∈ U, Integrable (fun t => b t * ‖h t‖) ρ ∧
      (∫ t, b t * ‖h t‖ ∂ρ) ≤ M) (f : Dual X) :
    ‖∫ t, D.rep f t (h t) ∂ρ‖ ≤ M * ‖f‖ := by
  apply le_of_forall_pos_le_add
  intro ε hε
  let δ := ε / (1 + M)
  have hδ : 0 < δ := div_pos hε (by linarith)
  let c := ‖f‖ + δ
  have hfc : ‖f‖ ≤ c := le_add_of_nonneg_right hδ.le
  have hc : 0 < c := by dsimp [c]; positivity
  have hbc := hbound _ (D.rep_scale f c hc hfc)
  have hint := (D.integrable_pair h hh (fun b hb => (hbound b hb).1) f c hc hfc).1
  calc
    _ ≤ ∫ t, ‖D.rep f t‖ * ‖h t‖ ∂ρ :=
      norm_integral_le_of_norm_le hint (Eventually.of_forall fun t => (D.rep f t).le_opNorm _)
    _ = c * ∫ t, ‖D.rep f t‖ / c * ‖h t‖ ∂ρ := by
      rw [← integral_const_mul]
      apply integral_congr_ae
      exact Eventually.of_forall fun t => by field_simp
    _ ≤ c * M := mul_le_mul_of_nonneg_left hbc.2 hc.le
    _ ≤ M * ‖f‖ + ε := by
      have hmul : δ * (1 + M) = ε := div_mul_cancel₀ _ (by linarith)
      dsimp [c]
      nlinarith [hδ.le]

private theorem KotheBochnerDualModel.coefficient_setIntegral (D : KotheBochnerDualModel P ρ U Y)
    (ξ : Bidual X) (h : Ω → Y) (hpair : ∀ f : Dual X, ξ f = ∫ t, D.rep f t (h t) ∂ρ)
    (f : Dual X) (E : MeasSet Ω) :
    ξ (adjoint (P.val E) f) = ∫ t in E.1, D.rep f t (h t) ∂ρ := by
  rw [hpair, ← integral_indicator E.2]
  apply integral_congr_ae
  filter_upwards [D.rep_cut E f] with t ht
  rw [ht]
  by_cases he : t ∈ E.1 <;> simp [he]

/-- Integrability and the norm estimate for the reconstructed Köthe
bidual density, and the full dual pairing. -/
theorem KotheBochnerDualModel.normal_has_density [CompleteSpace Y] [IsFiniteMeasure ρ]
    (D : KotheBochnerDualModel P ρ U Y) (hY : IsReflexive Y)
    (ξ : Bidual X) (hξ : P.toOVM.Normal ξ) :
    ∃ h : Ω → Y, StronglyMeasurable h ∧ Integrable h ρ ∧
      (∀ b ∈ U, Integrable (fun t => b t * ‖h t‖) ρ ∧
        (∫ t, b t * ‖h t‖ ∂ρ) ≤ ‖ξ‖) ∧
      ∀ f : Dual X, Integrable (fun t => D.rep f t (h t)) ρ ∧
        ξ f = ∫ t, D.rep f t (h t) ∂ρ := by
  obtain ⟨u, hui, hu⟩ := P.exists_bochner_density_of_normal_constants
    D.constants hY ρ D.P_null D.boundConstant D.bounded_simple ξ hξ
  let h := hui.aestronglyMeasurable.mk u
  have hh : StronglyMeasurable h := hui.aestronglyMeasurable.stronglyMeasurable_mk
  have heq : u =ᵐ[ρ] h := hui.aestronglyMeasurable.ae_eq_mk
  have hi : Integrable h ρ := hui.congr heq
  have hc (E : MeasSet Ω) (g : Dual Y) :
      ξ (adjoint (P.val E) (D.field fun _ => g)) = ∫ t in E.1, g (h t) ∂ρ := by
    rw [D.constants_eq, hu]
    exact integral_congr_ae ((ae_restrict_of_ae heq).mono fun t ht => congrArg g ht)
  have hp (k : Ω → Dual Y) (hk : StronglyMeasurable k) (hbk : ∃ R : ℝ, ∀ t, ‖k t‖ ≤ R) :
      ξ (D.field k) = ∫ t, k t (h t) ∂ρ := by
    obtain ⟨R, hR⟩ := hbk
    exact P.normal_integral_of_bounded_fields ρ D.field D.field_cut D.boundConstant
      D.boundConstant_nonneg D.uniform_bound ξ hξ h hh hi hc k hk R hR
  have hw (b : Ω → ℝ) (hb : b ∈ U) :
      Integrable (fun t => b t * ‖h t‖) ρ ∧ (∫ t, b t * ‖h t‖ ∂ρ) ≤ ‖ξ‖ :=
    bochner_assoc_integral_le ρ D.field ξ h hh hi hp b (D.weights b hb).1 (D.weights b hb).2
      (D.associate_unit_bound b hb)
  refine ⟨h, hh, hi, hw, fun f => ?_⟩
  let c := 1 + ‖f‖
  have hc0 : 0 < c := by dsimp [c]; positivity
  have hfc : ‖f‖ ≤ c := by dsimp [c]; linarith
  have hik := (D.integrable_pair h hh (fun b hb => (hw b hb).1) f c hc0 hfc).2
  refine ⟨hik, P.normal_integral_of_bounded_cuts ρ ξ hξ f h (D.rep f)
    (D.rep_measurable f) hik (fun E hE => ?_)⟩
  rw [← D.lift_rep_cut E f hE]
  obtain ⟨R, hR⟩ := hE
  refine hp _ ((D.rep_measurable f).indicator E.2) ⟨max R 0, fun t => ?_⟩
  by_cases ht : t ∈ E.1
  · rw [indicator_of_mem ht]
    exact (hR t ht).trans (le_max_left _ _)
  · rw [indicator_of_notMem ht, norm_zero]
    exact le_max_right _ _

/-- A density represents a normal vector exactly when it gives the full
integral dual pairing with the integrability and Köthe associate bound. -/
theorem KotheBochnerDualModel.normal_iff_density [CompleteSpace Y] [IsFiniteMeasure ρ]
    (D : KotheBochnerDualModel P ρ U Y) (hY : IsReflexive Y)
    (ξ : Bidual X) :
    P.toOVM.Normal ξ ↔
      ∃ h : Ω → Y, StronglyMeasurable h ∧ Integrable h ρ ∧
        (∀ b ∈ U, Integrable (fun t => b t * ‖h t‖) ρ ∧
          (∫ t, b t * ‖h t‖ ∂ρ) ≤ ‖ξ‖) ∧
        ∀ f : Dual X, Integrable (fun t => D.rep f t (h t)) ρ ∧
          ξ f = ∫ t, D.rep f t (h t) ∂ρ := by
  refine ⟨D.normal_has_density hY ξ, ?_⟩
  rintro ⟨h, _, _, _, hpair⟩
  apply P.normal_of_coefficient_setIntegral ρ ξ
  intro f
  exact ⟨fun t => D.rep f t (h t), (hpair f).1,
    D.coefficient_setIntegral ξ h (fun f => (hpair f).2) f⟩

#print axioms KotheBochnerDualModel.normal_has_density
#print axioms KotheBochnerDualModel.normal_iff_density

/-- The operator norm of an integral representative is exactly the Köthe
associate bound, characterized by all upper bounds on its positive unit ball. -/
theorem KotheBochnerDualModel.represented_norm_le_iff (D : KotheBochnerDualModel P ρ U Y)
    (ξ : Bidual X) (h : Ω → Y) (hh : StronglyMeasurable h) (hi : Integrable h ρ)
    (hpair : ∀ f : Dual X, ξ f = ∫ t, D.rep f t (h t) ∂ρ)
    (M : ℝ) (hM : 0 ≤ M) :
    ‖ξ‖ ≤ M ↔ ∀ b ∈ U, Integrable (fun t => b t * ‖h t‖) ρ ∧
      (∫ t, b t * ‖h t‖ ∂ρ) ≤ M := by
  constructor
  · intro hξ b hb
    have hp (k : Ω → Dual Y) (hk : StronglyMeasurable k) (hk' : ∃ R : ℝ, ∀ t, ‖k t‖ ≤ R) :
        ξ (D.field k) = ∫ t, k t (h t) ∂ρ := by
      rw [hpair]
      exact integral_congr_ae ((D.rep_field k hk hk').mono fun t ht =>
        congrArg (fun f : Dual Y => f (h t)) ht)
    obtain ⟨hint, hbnd⟩ := bochner_assoc_integral_le ρ D.field ξ h hh hi hp b
      (D.weights b hb).1 (D.weights b hb).2 (D.associate_unit_bound b hb)
    exact ⟨hint, hbnd.trans hξ⟩
  · intro hbound
    apply ContinuousLinearMap.opNorm_le_bound _ hM
    intro f
    rw [hpair]
    exact D.norm_integral_pair_le h hh M hM hbound f

/-- Each density with finite associate norm defines a normal bidual vector
by the canonical integral pairing. -/
theorem KotheBochnerDualModel.exists_normal_of_associate_density
    (D : KotheBochnerDualModel P ρ U Y)
    (h : Ω → Y) (hh : StronglyMeasurable h) (hi : Integrable h ρ)
    (M : ℝ) (hM : 0 ≤ M)
    (hbound : ∀ b ∈ U, Integrable (fun t => b t * ‖h t‖) ρ ∧
      (∫ t, b t * ‖h t‖ ∂ρ) ≤ M) :
    ∃ ξ : Bidual X, P.toOVM.Normal ξ ∧ ‖ξ‖ ≤ M ∧
      ∀ f : Dual X, ξ f = ∫ t, D.rep f t (h t) ∂ρ := by
  have hint (f : Dual X) : Integrable (fun t => D.rep f t (h t)) ρ :=
    (D.integrable_pair h hh (fun b hb => (hbound b hb).1) f (1 + ‖f‖)
      (by positivity) (by linarith)).2
  let L : Dual X →ₗ[ℝ] ℝ :=
    { toFun := fun f => ∫ t, D.rep f t (h t) ∂ρ
      map_add' := fun f g => by
        rw [← integral_add (hint f) (hint g)]
        apply integral_congr_ae
        filter_upwards [D.rep_add f g] with t ht
        rw [ht, add_apply]
      map_smul' := fun a f => by
        change (∫ t, D.rep (a • f) t (h t) ∂ρ) = a * ∫ t, D.rep f t (h t) ∂ρ
        rw [← integral_const_mul]
        apply integral_congr_ae
        filter_upwards [D.rep_smul a f] with t ht
        rw [ht]
        rfl }
  let ξ : Bidual X := L.mkContinuous M (D.norm_integral_pair_le h hh M hM hbound)
  have hξ (f : Dual X) : ξ f = ∫ t, D.rep f t (h t) ∂ρ := rfl
  have hnorm := (D.represented_norm_le_iff ξ h hh hi hξ M hM).mpr hbound
  refine ⟨ξ, P.normal_of_coefficient_setIntegral ρ ξ (fun f => ?_), hnorm, hξ⟩
  exact ⟨fun t => D.rep f t (h t), hint f, D.coefficient_setIntegral ξ h hξ f⟩

/-- On the Köthe–Bochner dual model, canonical representatives of the
bounded primal fields give the cyclic coverage asserted in the manuscript. -/
theorem KotheBochnerDualModel.localizes [CompleteSpace Y] [IsFiniteMeasure ρ]
    (D : KotheBochnerDualModel P ρ U Y) (hY : IsReflexive Y)
    (hb : ∀ v : Ω → Y, StronglyMeasurable v → (∃ M : ℝ, ∀ t, ‖v t‖ ≤ M) →
      ∃ x : X, ∀ f : Dual X, f x = ∫ t, D.rep f t (v t) ∂ρ) :
    P.Localizes := by
  apply P.localizes_of_bochner_representatives ρ D.rep _ hb
  intro ξ hξ
  obtain ⟨h, hh, _, _, hpair⟩ := D.normal_has_density hY ξ hξ
  exact ⟨h, hh, D.coefficient_setIntegral ξ h (fun f => (hpair f).2)⟩

#print axioms KotheBochnerDualModel.represented_norm_le_iff
#print axioms KotheBochnerDualModel.exists_normal_of_associate_density
#print axioms KotheBochnerDualModel.localizes

/-- On the Köthe–Bochner model a normal vector comes from a single cyclic
subrepresentation, by applying the localization equivalence of §2. -/
theorem KotheBochnerDualModel.cyclic_coverage [CompleteSpace X] [CompleteSpace Y] [IsFiniteMeasure ρ]
    (D : KotheBochnerDualModel P ρ U Y) (hY : IsReflexive Y)
    (hb : ∀ v : Ω → Y, StronglyMeasurable v → (∃ M : ℝ, ∀ t, ‖v t‖ ≤ M) →
      ∃ x : X, ∀ f : Dual X, f x = ∫ t, D.rep f t (v t) ∂ρ)
    (ξ : Bidual X) (hξ : P.toOVM.Normal ξ) :
    ∃ u : X, ∃ η : Bidual (P.cyclicSubspace u),
      (P.restrict _ (P.cyclicSubspace_invariant u)).toOVM.Normal η ∧
        secondAdjoint (P.cyclicSubspace u).subtypeL η = ξ :=
  P.cyclic_coverage_of_localizes (D.localizes hY hb) ξ hξ

/-- When the associate unit ball contains a positive constant, the integral
representation is unique up to almost-everywhere equality. -/
theorem KotheBochnerDualModel.density_ae_unique (D : KotheBochnerDualModel P ρ U Y)
    (hc : ∃ c : ℝ, 0 < c ∧ (fun _ : Ω => c) ∈ U)
    (ξ : Bidual X) (h g : Ω → Y) (hh : StronglyMeasurable h) (hg : StronglyMeasurable g)
    (hi : Integrable h ρ) (gi : Integrable g ρ)
    (hpair : ∀ f : Dual X, Integrable (fun t => D.rep f t (h t)) ρ ∧
      ξ f = ∫ t, D.rep f t (h t) ∂ρ)
    (gpair : ∀ f : Dual X, Integrable (fun t => D.rep f t (g t)) ρ ∧
      ξ f = ∫ t, D.rep f t (g t) ∂ρ) :
    h =ᵐ[ρ] g := by
  obtain ⟨c, hc0, hcU⟩ := hc
  have hsub (f : Dual X) : (0 : Bidual X) f = ∫ t, D.rep f t (h t - g t) ∂ρ := by
    simp only [map_sub, integral_sub (hpair f).1 (gpair f).1, ← (hpair f).2, ← (gpair f).2, sub_self]
    rfl
  have hn : ‖(0 : Bidual X)‖ ≤ 0 := ContinuousLinearMap.opNorm_zero.le
  have hweight := (D.represented_norm_le_iff 0 (h - g) (hh.sub hg) (hi.sub gi) hsub 0 le_rfl).mp hn
    (fun _ => c) hcU
  have hpos : ∀ t, 0 ≤ c * ‖h t - g t‖ := fun t => mul_nonneg hc0.le (norm_nonneg _)
  have hz : (∫ t, c * ‖h t - g t‖ ∂ρ) = 0 := le_antisymm hweight.2 (integral_nonneg hpos)
  have hzero := (integral_eq_zero_iff_of_nonneg (fun t => hpos t) hweight.1).mp hz
  filter_upwards [hzero] with t ht
  exact sub_eq_zero.mp (norm_eq_zero.mp ((mul_eq_zero.mp ht).resolve_left hc0.ne'))

#print axioms KotheBochnerDualModel.cyclic_coverage
#print axioms KotheBochnerDualModel.density_ae_unique

end BochnerNormalModel

noncomputable section BochnerLocalization

open MeasureTheory

variable {Ω X Y : Type*} [MeasurableSpace Ω] [NormedAddCommGroup X] [NormedSpace ℝ X]
  [NormedAddCommGroup Y] [NormedSpace ℝ Y]

/-- Order-continuous small tails of the constant-section operator imply
normality of its full second-adjoint image. -/
theorem PVM.normal_secondAdjoint_of_small_tails [CompleteSpace X] (P : PVM Ω X)
    (C : Y →L[ℝ] X)
    (hsmall : ∀ E : ℕ → MeasSet Ω, Antitone (fun n => (E n).1) →
      (⋂ n, (E n).1) = ∅ →
      Tendsto (fun n => ‖(P.val (E n)).comp C‖) atTop (𝓝 0))
    (η : Bidual Y) : P.toOVM.Normal (secondAdjoint C η) := by
  intro A hA f
  let U := MeasSet.iUnion A
  let V (s : Finset ℕ) := MeasSet.finiteUnion A s
  let R (s : Finset ℕ) := U.diff (V s)
  let D (n : ℕ) := R (Finset.range n)
  have hV (s : Finset ℕ) : (V s).1 ⊆ U.1 := by
    intro t ht
    obtain ⟨n, _, hn⟩ := mem_iUnion₂.mp ht
    exact mem_iUnion.mpr ⟨n, hn⟩
  have hR {s t : Finset ℕ} (hst : s ⊆ t) : (R t).1 ⊆ (R s).1 := by
    intro u hu
    refine ⟨hu.1, fun hv => hu.2 ?_⟩
    obtain ⟨n, hs, hn⟩ := mem_iUnion₂.mp hv
    exact mem_iUnion₂.mpr ⟨n, hst hs, hn⟩
  have hDa : Antitone (fun n => (D n).1) := fun _ _ h => hR (Finset.range_mono h)
  have hDe : (⋂ n, (D n).1) = ∅ := by
    apply Set.eq_empty_iff_forall_notMem.mpr
    intro t ht
    obtain ⟨n, hn⟩ := mem_iUnion.mp ((Set.mem_iInter.mp ht 0).1)
    exact (Set.mem_iInter.mp ht (n + 1)).2 (mem_iUnion₂.mpr ⟨n, Finset.mem_range.mpr (Nat.lt_succ_self n), hn⟩)
  have hlim := hsmall D hDa hDe
  have heq (s : Finset ℕ) : ∑ n ∈ s, (P.val (A n)).comp C = (P.val (V s)).comp C := by
    ext y
    simp only [sum_apply]
    exact (P.toOVM.apply_finite_union A hA s (C y)).symm
  have hsplit (s : Finset ℕ) : (P.val U).comp C - (P.val (V s)).comp C = (P.val (R s)).comp C := by
    have huv : U = (V s).union (R s) := by
      apply Subtype.ext
      exact (Set.union_sdiff_cancel (hV s)).symm
    have hdis : Disjoint (V s).1 (R s).1 := disjoint_sdiff_right
    ext y
    change P.val U (C y) - P.val (V s) (C y) = P.val (R s) (C y)
    conv_lhs => rw [huv]
    rw [P.toOVM.apply_union _ _ hdis, add_sub_cancel_left]
  have hsum : HasSum (fun n => (P.val (A n)).comp C) ((P.val U).comp C) := by
    change Tendsto (fun s : Finset ℕ => ∑ n ∈ s, (P.val (A n)).comp C) atTop (𝓝 ((P.val U).comp C))
    rw [Metric.tendsto_nhds]
    intro ε hε
    let M := P.toOVM.uniformNorm
    have hM : 0 ≤ M := P.toOVM.uniformNorm_nonneg
    have hp : 0 < 1 + M := by linarith
    let δ := ε / (1 + M)
    have hd : 0 < δ := div_pos hε hp
    obtain ⟨N, hN⟩ := Metric.tendsto_atTop.mp hlim δ hd
    have hn : ‖(P.val (D N)).comp C‖ < δ := by
      simpa only [Real.dist_eq, sub_zero, abs_of_nonneg (norm_nonneg _)] using hN N le_rfl
    filter_upwards [eventually_ge_atTop (Finset.range N)] with s hs
    rw [heq, dist_eq_norm, norm_sub_rev, hsplit]
    have hcomp : (P.val (R s)).comp ((P.val (D N)).comp C) = (P.val (R s)).comp C := by
      rw [← ContinuousLinearMap.comp_assoc, P.mul_eq]
      have he : (R s).inter (D N) = R s :=
        Subtype.ext (Set.inter_eq_left.mpr (hR hs))
      rw [he]
    calc
      _ ≤ M * ‖(P.val (D N)).comp C‖ := by
        rw [← hcomp]
        exact ((P.val (R s)).opNorm_comp_le _).trans
          (mul_le_mul_of_nonneg_right (P.toOVM.opNorm_le_uniformNorm (R s)) (norm_nonneg _))
      _ ≤ M * δ := mul_le_mul_of_nonneg_left hn.le hM
      _ < ε := by
        have hh : δ * (1 + M) = ε := div_mul_cancel₀ _ hp.ne'
        nlinarith
  let L := η.comp (ContinuousLinearMap.compL ℝ Y X ℝ f)
  exact hsum.map L L.continuous

/-- Necessity in rem:bochner-localization-dilation. Positive total mass and
the constant-section and integration operators recover the entire bidual. -/
theorem PVM.reflexive_of_localizes_with_constant_sections [CompleteSpace X]
    (P : PVM Ω X) (ρ : Measure Ω) [IsFiniteMeasure ρ] (hρ : ρ Set.univ ≠ 0)
    (C : Y →L[ℝ] X) (V : X →L[ℝ] Y)
    (hCV : ∀ E : MeasSet Ω, (V.comp (P.val E)).comp C =
      (ρ E.1).toReal • ContinuousLinearMap.id ℝ Y)
    (hsmall : ∀ E : ℕ → MeasSet Ω, Antitone (fun n => (E n).1) →
      (⋂ n, (E n).1) = ∅ →
      Tendsto (fun n => ‖(P.val (E n)).comp C‖) atTop (𝓝 0))
    (hP : P.Localizes) : IsReflexive Y := by
  intro η
  obtain ⟨A, _, hAu, hA⟩ := hP _ (P.normal_secondAdjoint_of_small_tails C hsmall η)
  have hn : ∃ n, ρ (A n).1 ≠ 0 := by
    by_contra! hn
    have hz : ρ (MeasSet.iUnion A).1 = 0 := measure_iUnion_null hn
    rw [hAu] at hz
    exact hρ hz
  obtain ⟨n, hn⟩ := hn
  obtain ⟨x, hx⟩ := hA n
  let a := (ρ (A n).1).toReal
  have ha : 0 < a := ENNReal.toReal_pos hn (measure_ne_top ρ _)
  refine ⟨a⁻¹ • V x, ?_⟩
  have hcut : secondAdjoint (P.val (A n)) (secondAdjoint C η) = J x := by
    ext f
    exact hx f
  have hs : secondAdjoint ((V.comp (P.val (A n))).comp C) η = J (V x) := by
    rw [← secondAdjoint_comp, ← secondAdjoint_comp, hcut, secondAdjoint_canonical]
  rw [hCV] at hs
  ext f
  have he := DFunLike.congr_fun hs f
  have hmul : a * η f = f (V x) := by
    rw [secondAdjoint_apply, J_apply, show adjoint (a • ContinuousLinearMap.id ℝ Y) f = a • f by
      ext y
      change f (a • y) = a * f y
      exact map_smul f a y, map_smul] at he
    exact he
  rw [J_apply, map_smul, ← hmul]
  change a⁻¹ * (a * η f) = η f
  rw [← mul_assoc, inv_mul_cancel₀ ha.ne', one_mul]

#print axioms PVM.normal_secondAdjoint_of_small_tails
#print axioms PVM.reflexive_of_localizes_with_constant_sections

/-- The normal part and the Baire-one part of the compressed OVM agree,
and are the image of the integral representatives on the dilation space. -/
theorem Dilation.normal_bochner_image {Z : Type*} [NormedAddCommGroup Z] [NormedSpace ℝ Z]
    [CompleteSpace X] [CompleteSpace Z] [CompleteSpace Y]
    {μ : OVM Ω X} (D : Dilation μ Z) (ρ : Measure Ω) [IsFiniteMeasure ρ] (U : Set (Ω → ℝ))
    (B : KotheBochnerDualModel D.P ρ U Y) (hY : IsReflexive Y)
    (hb : ∀ v : Ω → Y, StronglyMeasurable v → (∃ M : ℝ, ∀ t, ‖v t‖ ≤ M) →
      ∃ z : Z, ∀ f : Dual Z, f z = ∫ t, B.rep f t (v t) ∂ρ) :
    {ξ : Bidual X | μ.Normal ξ} = {ξ : Bidual X | BaireOne ξ} ∧
      secondAdjoint D.S '' {ζ : Bidual Z | ∃ h : Ω → Y,
        StronglyMeasurable h ∧ Integrable h ρ ∧
          ∀ f : Dual Z, Integrable (fun t => B.rep f t (h t)) ρ ∧
            ζ f = ∫ t, B.rep f t (h t) ∂ρ} = {ξ : Bidual X | BaireOne ξ} := by
  have hloc := B.localizes hY hb
  refine ⟨Set.ext fun ξ => D.normal_iff_baireOne hloc ξ, ?_⟩
  have hset : {ζ : Bidual Z | ∃ h : Ω → Y,
      StronglyMeasurable h ∧ Integrable h ρ ∧
        ∀ f : Dual Z, Integrable (fun t => B.rep f t (h t)) ρ ∧
          ζ f = ∫ t, B.rep f t (h t) ∂ρ} = {ζ | D.P.toOVM.Normal ζ} := by
    ext ζ
    constructor
    · rintro ⟨h, hh, hi, hpair⟩
      apply (B.normal_iff_density hY ζ).mpr
      refine ⟨h, hh, hi, ?_, hpair⟩
      exact (B.represented_norm_le_iff ζ h hh hi (fun f => (hpair f).2) ‖ζ‖
        (norm_nonneg ζ)).mp le_rfl
    · intro hζ
      obtain ⟨h, hh, hi, _, hpair⟩ := B.normal_has_density hY ζ hζ
      exact ⟨h, hh, hi, hpair⟩
  rw [hset]
  exact D.secondAdjoint_image_normal_eq_baireOne hloc

#print axioms Dilation.normal_bochner_image

end BochnerLocalization

noncomputable section KotheAssociateUnit

open MeasureTheory

variable {Ω : Type*} [MeasurableSpace Ω]

/-- Positive measurable representatives of the unit ball of the scalar associate
space. The scalar test set is the set of representatives of the primal unit ball. -/
def kothePositiveAssociateUnit (ρ : Measure Ω) (B : Set (Ω → ℝ)) : Set (Ω → ℝ) :=
  {b | Measurable b ∧ (∀ t, 0 ≤ b t) ∧
    ∀ a ∈ B, Integrable (fun t => |a t| * b t) ρ ∧ (∫ t, |a t| * b t ∂ρ) ≤ 1}

/-- Solidity of the positive associate unit ball. -/
theorem kothePositiveAssociateUnit_solid (ρ : Measure Ω) (B : Set (Ω → ℝ))
    (hB : ∀ a ∈ B, Measurable a) {b c : Ω → ℝ} (hb : b ∈ kothePositiveAssociateUnit ρ B)
    (hc : Measurable c) (hc0 : ∀ t, 0 ≤ c t) (hle : ∀ t, c t ≤ b t) :
    c ∈ kothePositiveAssociateUnit ρ B := by
  refine ⟨hc, hc0, fun a ha => ?_⟩
  have hmono (t : Ω) : |a t| * c t ≤ |a t| * b t :=
    mul_le_mul_of_nonneg_left (hle t) (abs_nonneg _)
  have hg := hb.2.2 a ha
  have hh : Integrable (fun t => |a t| * c t) ρ := hg.1.mono'
    ((continuous_abs.measurable.comp (hB a ha)).mul hc).aestronglyMeasurable
    (Eventually.of_forall fun t => by
      rw [Real.norm_of_nonneg (mul_nonneg (abs_nonneg _) (hc0 t))]
      exact hmono t)
  exact ⟨hh, (integral_mono hh hg.1 hmono).trans hg.2⟩

/-- The continuous (E subseteq L^1) inclusion yields a positive constant
in the associate unit ball; this is the separating weight for densities. -/
theorem kothePositiveAssociateUnit_contains_const (ρ : Measure Ω) (B : Set (Ω → ℝ))
    (M : ℝ) (hM : 0 < M)
    (hB : ∀ a ∈ B, Integrable a ρ ∧ (∫ t, |a t| ∂ρ) ≤ M) :
    (fun _ => M⁻¹) ∈ kothePositiveAssociateUnit ρ B := by
  refine ⟨measurable_const, fun _ => inv_nonneg.mpr hM.le, fun a ha => ?_⟩
  have hh := (hB a ha).1.abs.const_mul M⁻¹
  have hi : Integrable (fun t => |a t| * M⁻¹) ρ := by
    simpa only [mul_comm] using hh
  refine ⟨hi, ?_⟩
  calc
    (∫ t, |a t| * M⁻¹ ∂ρ) = M⁻¹ * ∫ t, |a t| ∂ρ := by
      simpa only [mul_comm] using integral_const_mul M⁻¹ (fun t => |a t|)
    _ ≤ M⁻¹ * M := mul_le_mul_of_nonneg_left (hB a ha).2 (inv_nonneg.mpr hM.le)
    _ = 1 := inv_mul_cancel₀ hM.ne'

#print axioms kothePositiveAssociateUnit_solid
#print axioms kothePositiveAssociateUnit_contains_const

end KotheAssociateUnit

noncomputable section ConcreteKotheBochner

open MeasureTheory

universe uΩ uE uY uX

variable {Ω : Type uΩ} [MeasurableSpace Ω]

/-- A scalar Köthe space represented in the actual space of a.e. classes.
Order continuity is expressed on positive decreasing sequences with a.e.
limit zero, which is the form used by multiplication projections. -/
structure KotheScalarSpace (ρ : Measure Ω) (E : Type uE)
    [NormedAddCommGroup E] [NormedSpace ℝ E] where
  repr : E →ₗ[ℝ] (Ω →ₘ[ρ] ℝ)
  injective : Function.Injective repr
  solid : ∀ (e : E) (a : Ω →ₘ[ρ] ℝ), (∀ᵐ t ∂ρ, |a t| ≤ |repr e t|) →
    ∃ b : E, repr b = a ∧ ‖b‖ ≤ ‖e‖
  one : E
  repr_one : repr one = 1
  order_continuous : ∀ x : ℕ → E, (∀ n, ∀ᵐ t ∂ρ, 0 ≤ repr (x n) t) →
    (∀ i j, i ≤ j → ∀ᵐ t ∂ρ, repr (x j) t ≤ repr (x i) t) →
    (∀ᵐ t ∂ρ, Tendsto (fun n => repr (x n) t) atTop (𝓝 0)) →
    Tendsto (fun n => ‖x n‖) atTop (𝓝 0)
  l1Bound : ℝ
  l1Bound_pos : 0 < l1Bound
  l1 : ∀ e, Integrable (repr e) ρ ∧ (∫ t, |repr e t| ∂ρ) ≤ l1Bound * ‖e‖

variable {E : Type uE} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {Y : Type uY} [NormedAddCommGroup Y] [NormedSpace ℝ Y]
  {X : Type uX} [NormedAddCommGroup X] [NormedSpace ℝ X] {ρ : Measure Ω}

/-- The Köthe–Bochner subspace of a.e. classes, specified by its exact
membership and norm. No projection operators or duality are assumed. -/
structure KotheBochnerQuotient (S : KotheScalarSpace ρ E) (Y : Type uY)
    [NormedAddCommGroup Y] [NormedSpace ℝ Y] (X : Type uX)
    [NormedAddCommGroup X] [NormedSpace ℝ X] where
  repr : X →ₗ[ℝ] (Ω →ₘ[ρ] Y)
  injective : Function.Injective repr
  range_iff : ∀ h : Ω →ₘ[ρ] Y, h ∈ Set.range repr ↔
    AEEqFun.comp norm continuous_norm h ∈ Set.range S.repr
  norm_eq : ∀ x e, AEEqFun.comp norm continuous_norm (repr x) = S.repr e → ‖x‖ = ‖e‖

namespace KotheBochnerQuotient

variable {S : KotheScalarSpace ρ E} (Q : KotheBochnerQuotient S Y X)

private theorem ae_eqFun_eq {Z : Type*} [TopologicalSpace Z] {a b : Ω →ₘ[ρ] Z}
    (h : (a : Ω → Z) =ᵐ[ρ] b) : a = b := AEEqFun.ext h

private def cutClass {Z : Type*} [TopologicalSpace Z] [Zero Z]
    (A : MeasSet Ω) (x : Ω →ₘ[ρ] Z) : Ω →ₘ[ρ] Z :=
  AEEqFun.mk (A.1.indicator x) (x.stronglyMeasurable.indicator A.2).aestronglyMeasurable

private theorem cutClass_ae {Z : Type*} [TopologicalSpace Z] [Zero Z]
    (A : MeasSet Ω) (x : Ω →ₘ[ρ] Z) :
    (cutClass A x : Ω → Z) =ᵐ[ρ] A.1.indicator x :=
  AEEqFun.coeFn_mk _ _

private theorem exists_cut (A : MeasSet Ω) (x : X) :
    ∃ z : X, Q.repr z = cutClass A (Q.repr x) ∧ ‖z‖ ≤ ‖x‖ := by
  obtain ⟨e, he⟩ := (Q.range_iff (Q.repr x)).mp ⟨x, rfl⟩
  let a := AEEqFun.comp norm continuous_norm (cutClass A (Q.repr x))
  have hle : ∀ᵐ t ∂ρ, |a t| ≤ |S.repr e t| := by
    filter_upwards [AEEqFun.coeFn_comp norm continuous_norm (cutClass A (Q.repr x)),
      cutClass_ae A (Q.repr x), AEEqFun.coeFn_comp norm continuous_norm (Q.repr x)] with t h₁ h₂ h₃
    rw [he]
    change |(AEEqFun.comp norm continuous_norm (cutClass A (Q.repr x))) t| ≤
      |(AEEqFun.comp norm continuous_norm (Q.repr x)) t|
    rw [h₁, h₃]
    simp only [Function.comp_apply]
    rw [h₂]
    by_cases ht : t ∈ A.1 <;> simp [ht]
  obtain ⟨b, hb, hbn⟩ := S.solid e a hle
  obtain ⟨z, hz⟩ := (Q.range_iff _).mpr ⟨b, hb⟩
  refine ⟨z, hz, ?_⟩
  rw [Q.norm_eq z b (by rw [hz]; exact hb.symm), Q.norm_eq x e he.symm]
  exact hbn

/-- Multiplication by a measurable indicator on the quotient. -/
def cut (A : MeasSet Ω) : X →L[ℝ] X := by
  let z (x : X) := Classical.choose (Q.exists_cut A x)
  have hz (x : X) : Q.repr (z x) = cutClass A (Q.repr x) :=
    (Classical.choose_spec (Q.exists_cut A x)).1
  let L : X →ₗ[ℝ] X :=
    { toFun := z
      map_add' := fun x y => by
        apply Q.injective
        apply ae_eqFun_eq
        simp only [map_add, hz]
        filter_upwards [cutClass_ae A (Q.repr x + Q.repr y),
          show (Q.repr (x + y) : Ω → Y) =ᵐ[ρ] fun t => Q.repr x t + Q.repr y t from
            by rw [map_add]; exact AEEqFun.coeFn_add _ _,
          cutClass_ae A (Q.repr x), cutClass_ae A (Q.repr y),
          AEEqFun.coeFn_add (cutClass A (Q.repr x)) (cutClass A (Q.repr y))]
          with t h₁ h₂ h₃ h₄ h₅
        change _ = _ at h₅
        rw [h₁, h₅]
        change _ = (cutClass A (Q.repr x)) t + (cutClass A (Q.repr y)) t
        rw [h₃, h₄]
        rw [map_add] at h₂
        by_cases ht : t ∈ A.1 <;> simp [ht, h₂]
      map_smul' := fun c x => by
        apply Q.injective
        apply ae_eqFun_eq
        change (Q.repr (z (c • x)) : Ω → Y) =ᵐ[ρ] Q.repr (c • z x)
        simp only [map_smul, hz]
        filter_upwards [cutClass_ae A (c • Q.repr x),
          show (Q.repr (c • x) : Ω → Y) =ᵐ[ρ] fun t => c • Q.repr x t from
            by rw [map_smul]; exact AEEqFun.coeFn_smul _ _,
          cutClass_ae A (Q.repr x), AEEqFun.coeFn_smul c (cutClass A (Q.repr x))]
          with t h₁ h₂ h₃ h₄
        rw [h₁, h₄]
        change _ = c • (cutClass A (Q.repr x)) t
        rw [h₃]
        rw [map_smul] at h₂
        by_cases ht : t ∈ A.1 <;> simp [ht, h₂] }
  exact L.mkContinuous 1 (fun x => by
    change ‖z x‖ ≤ 1 * ‖x‖
    rw [one_mul]
    exact (Classical.choose_spec (Q.exists_cut A x)).2)

theorem repr_cut (A : MeasSet Ω) (x : X) :
    (Q.repr (Q.cut A x) : Ω → Y) =ᵐ[ρ] A.1.indicator (Q.repr x) := by
  change (Q.repr (Classical.choose (Q.exists_cut A x)) : Ω → Y) =ᵐ[ρ] _
  rw [(Classical.choose_spec (Q.exists_cut A x)).1]
  exact cutClass_ae _ _

theorem cut_contractive (A : MeasSet Ω) (x : X) : ‖Q.cut A x‖ ≤ ‖x‖ := by
  change ‖Classical.choose (Q.exists_cut A x)‖ ≤ ‖x‖
  exact (Classical.choose_spec (Q.exists_cut A x)).2

theorem cut_null (A : MeasSet Ω) (hA : ρ A.1 = 0) : Q.cut A = 0 := by
  ext x
  apply Q.injective
  apply ae_eqFun_eq
  have ha : ∀ᵐ t ∂ρ, t ∉ A.1 := by
    rw [ae_iff]
    change ρ {t | ¬ t ∉ A.1} = 0
    simp only [not_not, ofPred_mem_eq]
    exact hA
  filter_upwards [Q.repr_cut A x, ha, show (Q.repr (0 : X) : Ω → Y) =ᵐ[ρ] fun _ => 0 from
    by rw [map_zero]; exact AEEqFun.coeFn_zero] with t ht hn hz
  change Q.repr (Q.cut A x) t = Q.repr 0 t
  rw [ht, hz, indicator_of_notMem hn]

private theorem cut_union (A B : MeasSet Ω) (h : Disjoint A.1 B.1) (x : X) :
    Q.cut (A.union B) x = Q.cut A x + Q.cut B x := by
  apply Q.injective
  apply ae_eqFun_eq
  rw [map_add]
  filter_upwards [Q.repr_cut (A.union B) x, Q.repr_cut A x, Q.repr_cut B x,
    AEEqFun.coeFn_add (Q.repr (Q.cut A x)) (Q.repr (Q.cut B x))] with t ht ha hb hs
  rw [ht, hs]
  change _ = Q.repr (Q.cut A x) t + Q.repr (Q.cut B x) t
  rw [ha, hb]
  change (A.1 ∪ B.1).indicator (Q.repr x) t = _
  by_cases hA : t ∈ A.1
  · have hB : t ∉ B.1 := fun ht => Set.disjoint_left.mp h hA ht
    simp [hA, hB]
  · by_cases hB : t ∈ B.1 <;> simp [hA, hB]

private theorem cut_comp (A B : MeasSet Ω) (x : X) :
    Q.cut A (Q.cut B x) = Q.cut (A.inter B) x := by
  apply Q.injective
  apply ae_eqFun_eq
  filter_upwards [Q.repr_cut A (Q.cut B x), Q.repr_cut B x, Q.repr_cut (A.inter B) x] with t ha hb hab
  rw [ha, hab]
  change A.1.indicator (Q.repr (Q.cut B x)) t = (A.1 ∩ B.1).indicator (Q.repr x) t
  by_cases hA : t ∈ A.1 <;> by_cases hB : t ∈ B.1 <;> simp [hA, hB, hb]

/-- Order continuity of E controls the norm of every descending cut to the empty set. -/
theorem cut_tendsto_zero (A : ℕ → MeasSet Ω) (ha : Antitone (fun n => (A n).1))
    (hcap : (⋂ n, (A n).1) = ∅) (x : X) :
    Tendsto (fun n => ‖Q.cut (A n) x‖) atTop (𝓝 0) := by
  choose e he using fun n => (Q.range_iff (Q.repr (Q.cut (A n) x))).mp ⟨_, rfl⟩
  have hrepr (n : ℕ) : (S.repr (e n) : Ω → ℝ) =ᵐ[ρ]
      (A n).1.indicator (fun t => ‖Q.repr x t‖) := by
    rw [he]
    filter_upwards [AEEqFun.coeFn_comp norm continuous_norm (Q.repr (Q.cut (A n) x)),
      Q.repr_cut (A n) x] with t h₁ h₂
    rw [h₁]
    change ‖Q.repr (Q.cut (A n) x) t‖ = _
    rw [h₂]
    by_cases ht : t ∈ (A n).1 <;> simp [ht]
  have ht := S.order_continuous e
    (fun n => by
      filter_upwards [hrepr n] with t ht
      rw [ht]
      by_cases hn : t ∈ (A n).1 <;> simp [hn])
    (fun i j hij => by
      filter_upwards [hrepr i, hrepr j] with t hi hj
      rw [hi, hj]
      by_cases ht : t ∈ (A j).1
      · simp [ht, ha hij ht]
      · by_cases hti : t ∈ (A i).1 <;> simp [ht, hti])
    (by
      filter_upwards [ae_all_iff.mpr hrepr] with t ht
      have hex : ∃ n, t ∉ (A n).1 := by
        by_contra! hn
        have hh := Set.mem_iInter.mpr hn
        rw [hcap] at hh
        exact hh
      obtain ⟨N, hn⟩ := hex
      apply tendsto_const_nhds.congr'
      filter_upwards [eventually_ge_atTop N] with n hN
      exact ((ht n).trans (indicator_of_notMem (fun hn' => hn (ha hN hn')) _)).symm)
  simpa only [Q.norm_eq _ _ (he _).symm] using ht

private theorem cut_finiteUnion (A : ℕ → MeasSet Ω) (hA : MeasSet.DisjointSeq A)
    (s : Finset ℕ) (x : X) :
    Q.cut (MeasSet.finiteUnion A s) x = ∑ n ∈ s, Q.cut (A n) x := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    rw [Finset.sum_empty, show MeasSet.finiteUnion A ∅ = MeasSet.empty by
      ext t; simp [MeasSet.finiteUnion, MeasSet.empty]]
    rw [Q.cut_null _ (by simp [MeasSet.empty]), zero_apply]
  | insert n s hn ih =>
    have he : MeasSet.finiteUnion A (insert n s) = (A n).union (MeasSet.finiteUnion A s) := by
      ext t
      change (t ∈ ⋃ i ∈ insert n s, (A i).1) ↔ t ∈ (A n).1 ∪ ⋃ i ∈ s, (A i).1
      simp only [mem_iUnion, Finset.mem_insert, mem_union]
      constructor
      · rintro ⟨i, rfl | hi, ht⟩
        · exact Or.inl ht
        · exact Or.inr ⟨i, hi, ht⟩
      · rintro (ht | ⟨i, hi, ht⟩)
        · exact ⟨n, Or.inl rfl, ht⟩
        · exact ⟨i, Or.inr hi, ht⟩
    have hd : Disjoint (A n).1 (MeasSet.finiteUnion A s).1 := Set.disjoint_left.mpr (by
      intro t ht hs
      obtain ⟨i, hi, hi'⟩ := mem_iUnion₂.mp hs
      have hni : n ≠ i := fun he => hn (he.symm ▸ hi)
      exact Set.disjoint_left.mp (hA hni) ht hi')
    rw [he, Q.cut_union _ _ hd, ih, Finset.sum_insert hn]

/-- The actual indicator multipliers of the Köthe–Bochner quotient form a
strongly countably additive normalized PVM. -/
def multiplication : PVM Ω X where
  val := Q.cut
  empty_eq := Q.cut_null _ (by simp [MeasSet.empty])
  normalized := by
    ext x
    apply Q.injective
    apply ae_eqFun_eq
    change (Q.repr (Q.cut MeasSet.whole x) : Ω → Y) =ᵐ[ρ] Q.repr x
    simpa only [MeasSet.whole, indicator_univ] using Q.repr_cut MeasSet.whole x
  mul_eq := fun A B => by
    ext x
    exact Q.cut_comp A B x
  countably_additive A hA x := by
    let U := MeasSet.iUnion A
    let V (s : Finset ℕ) := MeasSet.finiteUnion A s
    let R (s : Finset ℕ) := U.diff (V s)
    let D (n : ℕ) := R (Finset.range n)
    have hV (s : Finset ℕ) : (V s).1 ⊆ U.1 := by
      intro t ht
      obtain ⟨n, _, hn⟩ := mem_iUnion₂.mp ht
      exact mem_iUnion.mpr ⟨n, hn⟩
    have hR {s t : Finset ℕ} (hst : s ⊆ t) : (R t).1 ⊆ (R s).1 := by
      intro u hu
      refine ⟨hu.1, fun hv => hu.2 ?_⟩
      obtain ⟨n, hs, hn⟩ := mem_iUnion₂.mp hv
      exact mem_iUnion₂.mpr ⟨n, hst hs, hn⟩
    have hda : Antitone (fun n => (D n).1) := fun _ _ h => hR (Finset.range_mono h)
    have hdz : (⋂ n, (D n).1) = ∅ := by
      apply Set.eq_empty_iff_forall_notMem.mpr
      intro t ht
      obtain ⟨n, hn⟩ := mem_iUnion.mp ((Set.mem_iInter.mp ht 0).1)
      exact (Set.mem_iInter.mp ht (n + 1)).2
        (mem_iUnion₂.mpr ⟨n, Finset.mem_range.mpr (Nat.lt_succ_self n), hn⟩)
    have hlim := Q.cut_tendsto_zero D hda hdz x
    change Tendsto (fun s : Finset ℕ => ∑ n ∈ s, Q.cut (A n) x) atTop (𝓝 (Q.cut U x))
    rw [Metric.tendsto_nhds]
    intro ε hε
    obtain ⟨N, hN⟩ := Metric.tendsto_atTop.mp hlim ε hε
    have hn : ‖Q.cut (D N) x‖ < ε := by
      simpa only [Real.dist_eq, sub_zero, abs_of_nonneg (norm_nonneg _)] using hN N le_rfl
    filter_upwards [eventually_ge_atTop (Finset.range N)] with s hs
    rw [← Q.cut_finiteUnion A hA, dist_eq_norm, norm_sub_rev]
    have huv : U = (V s).union (R s) := Subtype.ext (Set.union_sdiff_cancel (hV s)).symm
    have he : Q.cut U x - Q.cut (V s) x = Q.cut (R s) x := by
      conv_lhs => rw [huv]
      rw [Q.cut_union _ _ disjoint_sdiff_right, add_sub_cancel_left]
    rw [he]
    have hin : (R s).inter (D N) = R s := Subtype.ext (Set.inter_eq_left.mpr (hR hs))
    have hs' := Q.cut_contractive (R s) (Q.cut (D N) x)
    rw [Q.cut_comp, hin] at hs'
    exact hs'.trans_lt hn

#print axioms KotheBochnerQuotient.multiplication

/-- Every bounded strongly measurable field has an element of the quotient,
with the norm bound furnished by the original constant function 1. -/
theorem contains_bounded (v : Ω → Y) (hv : StronglyMeasurable v)
    (M : ℝ) (hM : 0 ≤ M) (hb : ∀ t, ‖v t‖ ≤ M) :
    ∃ x : X, (Q.repr x : Ω → Y) =ᵐ[ρ] v ∧ ‖x‖ ≤ M * ‖S.one‖ := by
  let w : Ω →ₘ[ρ] Y := AEEqFun.mk v hv.aestronglyMeasurable
  let a := AEEqFun.comp norm continuous_norm w
  have hw : (w : Ω → Y) =ᵐ[ρ] v := AEEqFun.coeFn_mk _ _
  have hle : ∀ᵐ t ∂ρ, |a t| ≤ |S.repr (M • S.one) t| := by
    have hrepr : (S.repr (M • S.one) : Ω → ℝ) =ᵐ[ρ] fun _ => M := by
      rw [map_smul, S.repr_one]
      filter_upwards [AEEqFun.coeFn_smul M (1 : Ω →ₘ[ρ] ℝ),
        show ((1 : Ω →ₘ[ρ] ℝ) : Ω → ℝ) =ᵐ[ρ] 1 from AEEqFun.coeFn_one] with t ht ho
      rw [ht]
      change M * (1 : Ω →ₘ[ρ] ℝ) t = M
      rw [ho]
      exact mul_one M
    filter_upwards [AEEqFun.coeFn_comp norm continuous_norm w, hw, hrepr] with t ht hs hrt
    change |(AEEqFun.comp norm continuous_norm w) t| ≤ _
    rw [ht, hrt, Function.comp_apply, hs, abs_of_nonneg hM,
      abs_of_nonneg (norm_nonneg _)]
    exact hb t
  obtain ⟨e, he, hn⟩ := S.solid (M • S.one) a hle
  obtain ⟨x, hx⟩ := (Q.range_iff w).mpr ⟨e, he⟩
  refine ⟨x, by rw [hx]; exact hw, ?_⟩
  rw [Q.norm_eq x e (by rw [hx]; exact he.symm)]
  simpa only [norm_smul, Real.norm_of_nonneg hM] using hn

/-- The scalar inclusion into L¹ yields the vector-valued inclusion. -/
theorem integrable_repr (x : X) :
    Integrable (Q.repr x : Ω → Y) ρ ∧
      (∫ t, ‖Q.repr x t‖ ∂ρ) ≤ S.l1Bound * ‖x‖ := by
  obtain ⟨e, he⟩ := (Q.range_iff (Q.repr x)).mp ⟨x, rfl⟩
  have hi := S.l1 e
  have hn : (S.repr e : Ω → ℝ) =ᵐ[ρ] fun t => ‖Q.repr x t‖ := by
    rw [he]
    exact AEEqFun.coeFn_comp norm continuous_norm (Q.repr x)
  refine ⟨(integrable_norm_iff (Q.repr x).aestronglyMeasurable).mp (hi.1.congr hn), ?_⟩
  have hn' : (fun t => |S.repr e t|) =ᵐ[ρ] fun t => ‖Q.repr x t‖ := hn.mono fun t ht => by
    change |S.repr e t| = ‖Q.repr x t‖
    rw [ht, abs_of_nonneg (norm_nonneg _)]
  rw [← integral_congr_ae hn', Q.norm_eq x e he.symm]
  exact hi.2

#print axioms KotheBochnerQuotient.contains_bounded
#print axioms KotheBochnerQuotient.integrable_repr

end KotheBochnerQuotient

end ConcreteKotheBochner

noncomputable section ConcreteKotheIntegralDual

open MeasureTheory

variable {Ω E X Y : Type*} [MeasurableSpace Ω] {ρ : Measure Ω}
  [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup X] [NormedSpace ℝ X]
  [NormedAddCommGroup Y] [NormedSpace ℝ Y]

/-- Scalar unit ball of the Köthe space, with measurable representatives. -/
def KotheScalarSpace.representedUnit (S : KotheScalarSpace ρ E) : Set (Ω → ℝ) :=
  {a | ∃ e : E, ‖e‖ ≤ 1 ∧ a = S.repr e}

/-- Positive unit ball in the actual scalar associate space. -/
def KotheScalarSpace.associateUnit (S : KotheScalarSpace ρ E) : Set (Ω → ℝ) :=
  kothePositiveAssociateUnit ρ (KotheScalarSpace.representedUnit S)

private theorem KotheScalarSpace.unit_measurable (S : KotheScalarSpace ρ E) :
    ∀ a ∈ KotheScalarSpace.representedUnit S, Measurable a := by
  rintro _ ⟨e, _, rfl⟩
  exact (S.repr e).stronglyMeasurable.measurable

private theorem KotheScalarSpace.inv_const_mem (S : KotheScalarSpace ρ E) :
    (fun _ => S.l1Bound⁻¹) ∈ KotheScalarSpace.associateUnit S := by
  apply kothePositiveAssociateUnit_contains_const ρ _ _ S.l1Bound_pos
  rintro _ ⟨e, he, rfl⟩
  exact ⟨(S.l1 e).1, (S.l1 e).2.trans (by nlinarith [S.l1Bound_pos])⟩

private theorem KotheScalarSpace.associateUnit_congr (S : KotheScalarSpace ρ E)
    {b c : Ω → ℝ} (hb : b ∈ KotheScalarSpace.associateUnit S)
    (hc : Measurable c) (hc0 : ∀ t, 0 ≤ c t) (he : b =ᵐ[ρ] c) :
    c ∈ KotheScalarSpace.associateUnit S := by
  refine ⟨hc, hc0, fun a ha => ?_⟩
  have h := hb.2.2 a ha
  have he' := he.mono fun t ht => congrArg (|a t| * ·) ht
  exact ⟨h.1.congr he', (integral_congr_ae he').symm.le.trans h.2⟩

variable {S : KotheScalarSpace ρ E} (Q : KotheBochnerQuotient S Y X)

/-- The precise Bochner pairing against the actual primal a.e. classes. -/
def KotheBochnerQuotient.Represents (f : Dual X) (k : Ω → Dual Y) : Prop :=
  ∀ x : X, Integrable (fun t => k t (Q.repr x t)) ρ ∧
    f x = ∫ t, k t (Q.repr x t) ∂ρ

/-- The standard Köthe–Bochner integral duality (Hardtke, 2013,
the proof of Corollary 21). It gives an integral representative and the
isometric identification with the scalar associate norm. This representative
form incorporates the standard completion of the underlying measure. -/
axiom citeKotheBochnerIntegralDuality [CompleteSpace E] [CompleteSpace X] [CompleteSpace Y]
    [IsFiniteMeasure ρ] (hY : IsReflexive Y) (f : Dual X) :
    ∃ k : Ω → Dual Y, StronglyMeasurable k ∧ Q.Represents f k ∧
      ∀ c : ℝ, 0 < c → (‖f‖ ≤ c ↔
        (fun t => ‖k t‖ / c) ∈ KotheScalarSpace.associateUnit S)

namespace KotheBochnerQuotient

theorem repr_add_ae (x y : X) :
    (Q.repr (x + y) : Ω → Y) =ᵐ[ρ] fun t => Q.repr x t + Q.repr y t := by
  rw [map_add]
  exact AEEqFun.coeFn_add _ _

theorem repr_smul_ae (c : ℝ) (x : X) :
    (Q.repr (c • x) : Ω → Y) =ᵐ[ρ] fun t => c • Q.repr x t := by
  rw [map_smul]
  exact AEEqFun.coeFn_smul _ _

private theorem represents_add {f g : Dual X} {k l : Ω → Dual Y}
    (hf : Q.Represents f k) (hg : Q.Represents g l) :
    Q.Represents (f + g) (fun t => k t + l t) := by
  intro x
  change Integrable (fun t => (k t + l t) (Q.repr x t)) ρ ∧ _
  refine ⟨(hf x).1.add (hg x).1, ?_⟩
  rw [add_apply, (hf x).2, (hg x).2, ← integral_add (hf x).1 (hg x).1]
  rfl

private theorem represents_smul {f : Dual X} {k : Ω → Dual Y} (hf : Q.Represents f k) (a : ℝ) :
    Q.Represents (a • f) (fun t => a • k t) := by
  intro x
  refine ⟨(hf x).1.const_mul a, ?_⟩
  change a * f x = ∫ t, a * k t (Q.repr x t) ∂ρ
  rw [(hf x).2, integral_const_mul]

private theorem represents_cut {f : Dual X} {k : Ω → Dual Y} (hf : Q.Represents f k)
    (A : MeasSet Ω) : Q.Represents (adjoint (Q.cut A) f) (A.1.indicator k) := by
  intro x
  have he : (fun t => k t (Q.repr (Q.cut A x) t)) =ᵐ[ρ]
      fun t => (A.1.indicator k) t (Q.repr x t) := by
    filter_upwards [Q.repr_cut A x] with t ht
    rw [ht]
    by_cases h : t ∈ A.1 <;> simp [h]
  exact ⟨(hf (Q.cut A x)).1.congr he, (hf (Q.cut A x)).2.trans (integral_congr_ae he)⟩

/-- Two strongly measurable integral representatives are equal a.e.
The bounded primal field chosen by a measurable norming selector tests the
difference, using reflexivity to turn its bidual values into primal values. -/
theorem represents_ae_unique (hY : IsReflexive Y) {f : Dual X} {k l : Ω → Dual Y}
    (hk : StronglyMeasurable k) (hl : StronglyMeasurable l)
    (hf : Q.Represents f k) (hg : Q.Represents f l) :
    k =ᵐ[ρ] l := by
  obtain ⟨s, hs, _, hnorm⟩ := exists_stronglyMeasurable_normingField
    (fun t => k t - l t) (hk.sub hl) (1 / 2) (by norm_num)
  let Jₗ : Y →ₗᵢ[ℝ] Bidual Y :=
    ⟨(canonicalBidualEmbedding : Y →L[ℝ] Bidual Y).toLinearMap, norm_J⟩
  let Jₑ := LinearIsometryEquiv.ofSurjective Jₗ hY
  let v (t : Ω) : Y := Jₑ.symm (s t)
  have hv : StronglyMeasurable v := Jₑ.symm.continuous.comp_stronglyMeasurable hs
  have hvn (t : Ω) : ‖v t‖ ≤ 1 := (Jₑ.symm.norm_map _).le.trans (hnorm t).1
  obtain ⟨x, hx, _⟩ := Q.contains_bounded v hv 1 (by norm_num) hvn
  let w (t : Ω) : ℝ := (k t - l t) (Q.repr x t)
  have hwi : Integrable w ρ := (hf x).1.sub (hg x).1
  have hw0 : (∫ t, w t ∂ρ) = 0 := by
    change (∫ t, k t (Q.repr x t) - l t (Q.repr x t) ∂ρ) = 0
    rw [integral_sub (hf x).1 (hg x).1, ← (hf x).2, ← (hg x).2, sub_self]
  have he (t : Ω) : J (v t) = s t := Jₑ.apply_symm_apply _
  have hpos : ∀ᵐ t ∂ρ, (1 - (1 / 2 : ℝ)) * ‖k t - l t‖ ≤ w t := by
    filter_upwards [hx] with t ht
    simpa only [← he t, J_apply, w, ht] using (hnorm t).2
  have hzero := (integral_eq_zero_iff_of_nonneg_ae (hpos.mono fun t ht =>
    (mul_nonneg (by norm_num) (norm_nonneg (k t - l t))).trans ht) hwi).mp hw0
  filter_upwards [hpos, hzero] with t ht hz
  change w t = 0 at hz
  rw [hz] at ht
  exact sub_eq_zero.mp (norm_eq_zero.mp (le_antisymm (by linarith) (norm_nonneg _)))

private theorem represented_eq {f g : Dual X} {k : Ω → Dual Y}
    (hf : Q.Represents f k) (hg : Q.Represents g k) : f = g := by
  ext x
  exact (hf x).2.trans (hg x).2.symm

private theorem pairing_norm_le (k : Ω → Dual Y)
    (R : ℝ) (hR0 : 0 ≤ R) (hR : ∀ t, ‖k t‖ ≤ R) (x : X) :
    ‖∫ t, k t (Q.repr x t) ∂ρ‖ ≤ R * S.l1Bound * ‖x‖ := by
  calc
      _ ≤ ∫ t, R * ‖Q.repr x t‖ ∂ρ :=
        norm_integral_le_of_norm_le ((Q.integrable_repr x).1.norm.const_mul R)
          (Eventually.of_forall fun t => ((k t).le_opNorm _).trans
            (mul_le_mul_of_nonneg_right (hR t) (norm_nonneg _)))
      _ = R * ∫ t, ‖Q.repr x t‖ ∂ρ := integral_const_mul _ _
      _ ≤ R * S.l1Bound * ‖x‖ := by
        rw [mul_assoc]
        exact mul_le_mul_of_nonneg_left (Q.integrable_repr x).2 hR0

private theorem represents_norm_le {f : Dual X} {k : Ω → Dual Y}
    (hf : Q.Represents f k) (R : ℝ) (hR0 : 0 ≤ R) (hR : ∀ t, ‖k t‖ ≤ R) :
    ‖f‖ ≤ R * S.l1Bound := by
  apply ContinuousLinearMap.opNorm_le_bound _ (mul_nonneg hR0 S.l1Bound_pos.le)
  intro x
  rw [(hf x).2]
  exact Q.pairing_norm_le k R hR0 hR x

private theorem exists_bounded_pairing (k : Ω → Dual Y) (hk : StronglyMeasurable k)
    (R : ℝ) (hR : ∀ t, ‖k t‖ ≤ R) : ∃ f : Dual X, Q.Represents f k := by
  have hi (x : X) : Integrable (fun t => k t (Q.repr x t)) ρ :=
    ((Q.integrable_repr x).1.norm.const_mul R).mono'
      ((continuous_fst.clm_apply continuous_snd).comp_stronglyMeasurable
        (hk.prodMk (Q.repr x).stronglyMeasurable)).aestronglyMeasurable
      (Eventually.of_forall fun t => ((k t).le_opNorm _).trans
        (mul_le_mul_of_nonneg_right (hR t) (norm_nonneg _)))
  let L : X →ₗ[ℝ] ℝ :=
    { toFun := fun x => ∫ t, k t (Q.repr x t) ∂ρ
      map_add' := fun x y => by
        rw [← integral_add (hi x) (hi y)]
        apply integral_congr_ae
        filter_upwards [Q.repr_add_ae x y] with t ht
        change k t (Q.repr (x + y) t) = k t (Q.repr x t) + k t (Q.repr y t)
        rw [ht, map_add]
      map_smul' := fun a x => by
        change (∫ t, k t (Q.repr (a • x) t) ∂ρ) = a * ∫ t, k t (Q.repr x t) ∂ρ
        rw [← integral_const_mul]
        apply integral_congr_ae
        filter_upwards [Q.repr_smul_ae a x] with t ht
        change k t (Q.repr (a • x) t) = a * k t (Q.repr x t)
        rw [ht]
        exact map_smul (k t) a (Q.repr x t) }
  let R' := max R 0
  exact ⟨L.mkContinuous (R' * S.l1Bound)
    (Q.pairing_norm_le k R' (le_max_right _ _) (fun t => (hR t).trans (le_max_left _ _))),
    fun x => ⟨hi x, rfl⟩⟩

private def boundedField (k : Ω → Dual Y) : Dual X := by
  classical
  exact if h : StronglyMeasurable k ∧ ∃ R : ℝ, ∀ t, ‖k t‖ ≤ R then
    Classical.choose (Q.exists_bounded_pairing k h.1 h.2.choose h.2.choose_spec)
  else 0

private theorem boundedField_represents (k : Ω → Dual Y) (hk : StronglyMeasurable k)
    (hb : ∃ R : ℝ, ∀ t, ‖k t‖ ≤ R) : Q.Represents (Q.boundedField k) k := by
  classical
  unfold boundedField
  let h : StronglyMeasurable k ∧ ∃ R : ℝ, ∀ t, ‖k t‖ ≤ R := ⟨hk, hb⟩
  rw [dite_eq_left h]
  exact Classical.choose_spec (Q.exists_bounded_pairing k h.1 h.2.choose h.2.choose_spec)

private def constantField : Dual Y →L[ℝ] Dual X := by
  let F (g : Dual Y) := Q.boundedField (fun _ => g)
  have hf (g : Dual Y) : Q.Represents (F g) (fun _ => g) :=
    Q.boundedField_represents _ stronglyMeasurable_const ⟨‖g‖, fun _ => le_rfl⟩
  let L : Dual Y →ₗ[ℝ] Dual X :=
    { toFun := F
      map_add' := fun g l => Q.represented_eq (hf _) (Q.represents_add (hf g) (hf l))
      map_smul' := fun a g => Q.represented_eq (hf _) (Q.represents_smul (hf g) a) }
  exact L.mkContinuous S.l1Bound (fun g => by
    change ‖F g‖ ≤ S.l1Bound * ‖g‖
    rw [mul_comm]
    exact Q.represents_norm_le (hf g) ‖g‖ (norm_nonneg g) (fun _ => le_rfl))

private theorem represents_sum {f : ℕ → Dual X} {k : ℕ → Ω → Dual Y}
    (s : Finset ℕ) (hr : ∀ n ∈ s, Q.Represents (f n) (k n)) :
    Q.Represents (∑ n ∈ s, f n) (fun t => ∑ n ∈ s, k n t) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    intro x
    simp
  | insert n s hn ih =>
    simp only [Finset.sum_insert hn]
    exact Q.represents_add (hr n (Finset.mem_insert_self _ _))
      (ih fun i hi => hr i (Finset.mem_insert_of_mem hi))

private theorem bounded_indicator (A : MeasSet Ω) {k : Ω → Dual Y}
    (hb : ∃ R : ℝ, ∀ t ∈ A.1, ‖k t‖ ≤ R) :
    ∃ R : ℝ, ∀ t, ‖A.1.indicator k t‖ ≤ R := by
  obtain ⟨R, hR⟩ := hb
  refine ⟨max R 0, fun t => ?_⟩
  by_cases h : t ∈ A.1
  · rw [indicator_of_mem h]
    exact (hR t h).trans (le_max_left _ _)
  · rw [indicator_of_notMem h, ContinuousLinearMap.opNorm_zero]
    exact le_max_right _ _

#print axioms KotheBochnerQuotient.represents_ae_unique

/-- Instantiation of the normal-part dual model on the concrete quotient.
The cut laws, finite disjoint-field estimate and uniform estimates are all
derived from the integral pairing. -/
theorem exists_dualModel [CompleteSpace E] [CompleteSpace X] [CompleteSpace Y]
    [IsFiniteMeasure ρ] (hY : IsReflexive Y) :
    ∃ D : KotheBochnerDualModel Q.multiplication ρ (KotheScalarSpace.associateUnit S) Y,
      ∀ f : Dual X, Q.Represents f (D.rep f) := by
  classical
  choose r hm hp hn using citeKotheBochnerIntegralDuality Q hY
  have hfield (k : Ω → Dual Y) (hk : StronglyMeasurable k)
      (hb : ∃ R : ℝ, ∀ t, ‖k t‖ ≤ R) : r (Q.boundedField k) =ᵐ[ρ] k :=
    Q.represents_ae_unique hY (hm _) hk (hp _) (Q.boundedField_represents k hk hb)
  have hcut (A : MeasSet Ω) (f : Dual X) :
      r (adjoint (Q.cut A) f) =ᵐ[ρ] A.1.indicator (r f) :=
    Q.represents_ae_unique hY (hm _) ((hm f).indicator A.2) (hp _) (Q.represents_cut (hp f) A)
  refine ⟨{
    weights := fun b hb => ⟨hb.1, hb.2.1⟩
    P_null := Q.cut_null
    constants := Q.constantField
    field := Q.boundedField
    constants_eq := fun _ => rfl
    rep := r
    rep_measurable := hm
    rep_add := fun f g => Q.represents_ae_unique hY (hm _) ((hm f).add (hm g))
      (hp _) (Q.represents_add (hp f) (hp g))
    rep_smul := fun a f => Q.represents_ae_unique hY (hm _) ((hm f).const_smul a)
      (hp _) (Q.represents_smul (hp f) a)
    rep_scale := fun f c hc hfc => (hn f c hc).mp hfc
    rep_field := hfield
    rep_cut := hcut
    lift_rep_cut := fun A f hb => Q.represented_eq
      (Q.boundedField_represents _ ((hm f).indicator A.2) (bounded_indicator A hb))
      (Q.represents_cut (hp f) A)
    field_cut := fun A k hk hk' => Q.represented_eq
      (Q.represents_cut (Q.boundedField_represents k hk hk') A)
      (Q.boundedField_represents _ (hk.indicator A.2)
        (bounded_indicator A (by obtain ⟨R, hR⟩ := hk'; exact ⟨R, fun t _ => hR t⟩)))
    boundConstant := S.l1Bound
    boundConstant_nonneg := S.l1Bound_pos.le
    bounded_simple := ?_
    uniform_bound := ?_
    associate_unit_bound := ?_ }, hp⟩
  · intro A hA s g hg
    let k (n : ℕ) := (A n).1.indicator (fun _ => g n)
    have hr (n : ℕ) : Q.Represents (adjoint (Q.cut (A n)) (Q.constantField (g n))) (k n) :=
      Q.represents_cut (Q.boundedField_represents _ stronglyMeasurable_const ⟨‖g n‖, fun _ => le_rfl⟩) _
    have hh := Q.represents_sum s (fun n _ => hr n)
    have hnorm (t : Ω) : ‖∑ n ∈ s, k n t‖ ≤ 1 := by
      by_cases h : ∃ n ∈ s, t ∈ (A n).1
      · obtain ⟨n, hn, ht⟩ := h
        rw [Finset.sum_eq_single_of_mem n hn]
        · simpa only [k, indicator_of_mem ht] using hg n hn
        · intro m _ hm'
          exact indicator_of_notMem (fun hmt => Set.disjoint_left.mp (hA hm') hmt ht) _
      · rw [Finset.sum_eq_zero (fun n hn => indicator_of_notMem (fun ht => h ⟨n, hn, ht⟩) _)]
        rw [ContinuousLinearMap.opNorm_zero]
        norm_num
    change ‖∑ n ∈ s, adjoint (Q.cut (A n)) (Q.constantField (g n))‖ ≤ S.l1Bound
    simpa only [one_mul] using Q.represents_norm_le hh 1 (by norm_num) hnorm
  · intro k l hk hl hkb δ hδ hclose
    obtain ⟨R, hR⟩ := hkb
    have hlb (t : Ω) : ‖l t‖ ≤ R + δ := by
      have ht := norm_sub_norm_le (l t) (k t)
      rw [norm_sub_rev] at ht
      linarith [hR t, hclose t]
    have ha := Q.boundedField_represents k hk ⟨R, hR⟩
    have hb := Q.boundedField_represents l hl ⟨R + δ, hlb⟩
    have hr : Q.Represents (Q.boundedField k - Q.boundedField l) (fun t => k t - l t) := by
      intro x
      refine ⟨(ha x).1.sub (hb x).1, ?_⟩
      rw [sub_apply, (ha x).2, (hb x).2, ← integral_sub (ha x).1 (hb x).1]
      rfl
    simpa only [mul_comm] using Q.represents_norm_le hr δ hδ hclose
  · intro b hb n s hs hsn
    let k (t : Ω) : Dual Y := min (b t) (n : ℝ) • s t
    have hk : StronglyMeasurable k := (hb.1.min measurable_const).stronglyMeasurable.smul hs
    have hdom (t : Ω) : ‖k t‖ ≤ min (b t) (n : ℝ) := by
      dsimp [k]
      rw [norm_smul, Real.norm_of_nonneg (le_min (hb.2.1 t) (Nat.cast_nonneg n))]
      exact mul_le_of_le_one_right (le_min (hb.2.1 t) (Nat.cast_nonneg n)) (hsn t)
    have hbnd (t : Ω) : ‖k t‖ ≤ n := (hdom t).trans (min_le_right _ _)
    have hw : (fun t => ‖k t‖) ∈ KotheScalarSpace.associateUnit S :=
      kothePositiveAssociateUnit_solid ρ _ (KotheScalarSpace.unit_measurable S) hb
        hk.norm.measurable (fun _ => norm_nonneg _) (fun t => (hdom t).trans (min_le_left _ _))
    have hrep := hfield k hk ⟨n, hbnd⟩
    apply (hn (Q.boundedField k) 1 (by norm_num)).mpr
    simp only [div_one]
    exact KotheScalarSpace.associateUnit_congr S hw (hm _).norm.measurable
      (fun _ => norm_nonneg _) (hrep.symm.mono fun _ ht => congrArg norm ht)

#print axioms KotheBochnerQuotient.exists_dualModel

/-- Actual a.e. classes belonging to the Köthe–Bochner bidual space.
The upper bounds encode the defining associate norm. -/
def associateBidual (S : KotheScalarSpace ρ E) (Y : Type*)
    [NormedAddCommGroup Y] : Set (Ω →ₘ[ρ] Y) :=
  {h | ∃ M : ℝ, 0 ≤ M ∧ ∀ b ∈ KotheScalarSpace.associateUnit S,
    Integrable (fun t => b t * ‖h t‖) ρ ∧ (∫ t, b t * ‖h t‖ ∂ρ) ≤ M}

omit [NormedSpace ℝ Y] in
private theorem associateBidual_integrable {h : Ω →ₘ[ρ] Y}
    (hh : h ∈ associateBidual S Y) : Integrable (h : Ω → Y) ρ := by
  obtain ⟨M, _, hm⟩ := hh
  have hw := (hm _ (KotheScalarSpace.inv_const_mem S)).1.const_mul S.l1Bound
  apply (integrable_norm_iff h.aestronglyMeasurable).mp
  apply hw.congr
  exact Eventually.of_forall fun t => by
    change S.l1Bound * (S.l1Bound⁻¹ * ‖h t‖) = ‖h t‖
    rw [← mul_assoc, mul_inv_cancel₀ S.l1Bound_pos.ne', one_mul]

/-- Manuscript, prop:bochner-normal. For the actual Köthe–Bochner
quotient the normal part is exactly the integral image of the actual
associate-bidual classes. Each class has a normal representative in the
norm bidual, and its associate bound is the operator norm of that vector. -/
theorem normalPart [CompleteSpace E] [CompleteSpace X] [CompleteSpace Y]
    [IsFiniteMeasure ρ] (hY : IsReflexive Y) :
    ∃ D : KotheBochnerDualModel Q.multiplication ρ (KotheScalarSpace.associateUnit S) Y,
      (∀ f : Dual X, Q.Represents f (D.rep f)) ∧
      (∀ ξ : Bidual X, Q.multiplication.toOVM.Normal ξ ↔
        ∃ h ∈ associateBidual S Y, ∀ f : Dual X, ξ f = ∫ t, D.rep f t (h t) ∂ρ) ∧
      ∀ h ∈ associateBidual S Y, ∃ ξ : Bidual X,
        Q.multiplication.toOVM.Normal ξ ∧
        (∀ f : Dual X, ξ f = ∫ t, D.rep f t (h t) ∂ρ) ∧
        ∀ M : ℝ, 0 ≤ M → (‖ξ‖ ≤ M ↔
          ∀ b ∈ KotheScalarSpace.associateUnit S,
            Integrable (fun t => b t * ‖h t‖) ρ ∧ (∫ t, b t * ‖h t‖ ∂ρ) ≤ M) := by
  obtain ⟨D, hD⟩ := Q.exists_dualModel hY
  have hex (h : Ω →ₘ[ρ] Y) (hh : h ∈ associateBidual S Y) :
      ∃ ξ : Bidual X, Q.multiplication.toOVM.Normal ξ ∧
        ∀ f : Dual X, ξ f = ∫ t, D.rep f t (h t) ∂ρ := by
    have hi := associateBidual_integrable hh
    obtain ⟨M, hM, hm⟩ := hh
    obtain ⟨ξ, hn, _, hp⟩ := D.exists_normal_of_associate_density h h.stronglyMeasurable
      hi M hM hm
    exact ⟨ξ, hn, hp⟩
  refine ⟨D, hD, fun ξ => ?_, fun h hh => ?_⟩
  · constructor
    · intro hξ
      obtain ⟨v, hv, _, hw, hp⟩ := D.normal_has_density hY ξ hξ
      let h : Ω →ₘ[ρ] Y := AEEqFun.mk v hv.aestronglyMeasurable
      have he : (h : Ω → Y) =ᵐ[ρ] v := AEEqFun.coeFn_mk _ _
      refine ⟨h, ⟨‖ξ‖, norm_nonneg ξ, fun b hb => ?_⟩, fun f => ?_⟩
      · have he' : (fun t => b t * ‖h t‖) =ᵐ[ρ] fun t => b t * ‖v t‖ :=
          he.mono fun t ht => congrArg (fun y : Y => b t * ‖y‖) ht
        exact ⟨(hw b hb).1.congr he'.symm, (integral_congr_ae he').le.trans (hw b hb).2⟩
      · exact (hp f).2.trans (integral_congr_ae (he.mono fun t ht => congrArg (D.rep f t) ht)).symm
    · rintro ⟨h, hh, hp⟩
      obtain ⟨η, hη, he⟩ := hex h hh
      have heq : η = ξ := by ext f; exact (he f).trans (hp f).symm
      exact heq ▸ hη
  · obtain ⟨ξ, hn, hp⟩ := hex h hh
    exact ⟨ξ, hn, hp, D.represented_norm_le_iff ξ h h.stronglyMeasurable (associateBidual_integrable hh) hp⟩

/-- The concrete quotient multiplication has localization. The canonical
representatives of bounded density cuts are elements of the actual quotient. -/
theorem localizes [CompleteSpace E] [CompleteSpace X] [CompleteSpace Y]
    [IsFiniteMeasure ρ] (hY : IsReflexive Y) : Q.multiplication.Localizes := by
  obtain ⟨D, hD⟩ := Q.exists_dualModel hY
  apply D.localizes hY
  rintro v hv ⟨M, hM⟩
  obtain ⟨x, hx, _⟩ := Q.contains_bounded v hv (max M 0) (le_max_right _ _)
    (fun t => (hM t).trans (le_max_left _ _))
  exact ⟨x, fun f => (hD f x).2.trans
    (integral_congr_ae (hx.mono fun t ht => congrArg (D.rep f t) ht))⟩

theorem cyclic_coverage [CompleteSpace E] [CompleteSpace X] [CompleteSpace Y]
    [IsFiniteMeasure ρ] (hY : IsReflexive Y)
    (ξ : Bidual X) (hξ : Q.multiplication.toOVM.Normal ξ) :
    ∃ u : X, ∃ η : Bidual (Q.multiplication.cyclicSubspace u),
      (Q.multiplication.restrict _ (Q.multiplication.cyclicSubspace_invariant u)).toOVM.Normal η ∧
        secondAdjoint (Q.multiplication.cyclicSubspace u).subtypeL η = ξ :=
  Q.multiplication.cyclic_coverage_of_localizes (Q.localizes hY) ξ hξ

/-- The integral embedding separates distinct associate-bidual a.e. classes. -/
theorem associateBidual_pairing_injective
    (D : KotheBochnerDualModel Q.multiplication ρ (KotheScalarSpace.associateUnit S) Y)
    {h g : Ω →ₘ[ρ] Y} (hh : h ∈ associateBidual S Y) (hg : g ∈ associateBidual S Y)
    (ξ : Bidual X) (hp : ∀ f : Dual X, ξ f = ∫ t, D.rep f t (h t) ∂ρ)
    (gp : ∀ f : Dual X, ξ f = ∫ t, D.rep f t (g t) ∂ρ) : h = g := by
  have hi (v : Ω →ₘ[ρ] Y) (hv : v ∈ associateBidual S Y) (f : Dual X) :
      Integrable (fun t => D.rep f t (v t)) ρ := by
    let c := 1 + ‖f‖
    have hc : 0 < c := by dsimp [c]; positivity
    have hcn : ‖f‖ ≤ c := by dsimp [c]; linarith
    obtain ⟨_, _, hb⟩ := hv
    have hi := (hb _ (D.rep_scale f c hc hcn)).1.const_mul c
    have hnorm : Integrable (fun t => ‖D.rep f t‖ * ‖v t‖) ρ := by
      apply hi.congr
      exact Eventually.of_forall fun t => by
        change c * (‖D.rep f t‖ / c * ‖v t‖) = _
        field_simp
    exact hnorm.mono'
      ((continuous_fst.clm_apply continuous_snd).comp_stronglyMeasurable
        ((D.rep_measurable f).prodMk v.stronglyMeasurable)).aestronglyMeasurable
      (Eventually.of_forall fun t => (D.rep f t).le_opNorm _)
  apply AEEqFun.ext
  exact D.density_ae_unique ⟨S.l1Bound⁻¹, inv_pos.mpr S.l1Bound_pos, KotheScalarSpace.inv_const_mem S⟩
    ξ h g h.stronglyMeasurable g.stronglyMeasurable (associateBidual_integrable hh)
    (associateBidual_integrable hg)
    (fun f => ⟨hi h hh f, hp f⟩) (fun f => ⟨hi g hg f, gp f⟩)

