namespace Paper

noncomputable section SectionSevenHaarFrames

open MeasureTheory Set Filter
open scoped ENNReal Topology

namespace ExponentialHeartModel

variable {G : Type} [NormedAddCommGroup G] [NormedSpace ℝ G]

theorem haar_positive_eventually (H : ExponentialHeartModel G) (C : ℝ) :
    ∀ᶠ N in atTop, C < ‖∑ n ∈ Finset.range N, H.haarVector n‖ := by
  let B := max C 0
  have hB : 0 ≤ B := le_max_right _ _
  obtain ⟨N₀,hN₀'⟩ := exists_nat_gt ((2*B+1)^2)
  filter_upwards [eventually_ge_atTop N₀] with N hNN
  have hN : (2*B+1)^2 < (N:ℝ) := hN₀'.trans_le (by exact_mod_cast hNN)
  have hN₁ : (1:ℝ) ≤ N := by
    have hh : 1 ≤ (2*B+1)^2 := by nlinarith
    linarith
  have hN₀ : 0 < N := by exact_mod_cast (show (0:ℝ) < N by linarith)
  have hpow : (1:ℝ) ≤ 2^N := one_le_pow₀ (by norm_num)
  have hlog : Real.log (1+(2:ℝ)^N) ≤ (N:ℝ)+1 := by
    have h := Real.log_le_log (show 0 < 1+(2:ℝ)^N by positivity)
      (show 1+(2:ℝ)^N ≤ (2:ℝ) * 2^N by linarith)
    rw [Real.log_mul (by norm_num) (pow_ne_zero _ (by norm_num)),Real.log_pow] at h
    have hl : Real.log 2 ≤ 1 := by
      have h₀ := Real.log_le_sub_one_of_pos (show (0:ℝ) < 2 by norm_num)
      linarith
    have hh := mul_le_mul_of_nonneg_left hl (show (0:ℝ) ≤ N by positivity)
    linarith
  let d := Real.sqrt (Real.log (1+(2:ℝ)^N))
  let n := Real.sqrt (N:ℝ)
  have hn : 0 < n := Real.sqrt_pos.2 (by linarith)
  have hnn : n ^ 2 = (N:ℝ) := Real.sq_sqrt (by positivity)
  have hd : 0 < d := Real.sqrt_pos.2 (Real.log_pos (by linarith))
  have hdn : d ≤ 2*n := by
    have hr := Real.sqrt_le_sqrt (hlog.trans (show (N:ℝ)+1 ≤ 4*N by linarith))
    have h4 : Real.sqrt (4:ℝ) = 2 := by
      rw [show (4:ℝ) = 2 ^ 2 by norm_num,Real.sqrt_sq (by norm_num : (0:ℝ) ≤ 2)]
    simpa only [d,n,Real.sqrt_mul (by norm_num : (0:ℝ) ≤ 4),h4] using hr
  have hnB : 2*B < n := by
    have hh := Real.sqrt_lt_sqrt (sq_nonneg (2*B+1)) hN
    rw [Real.sqrt_sq (by positivity : 0 ≤ 2*B+1)] at hh
    linarith
  have hBnd : B * d < N := by
    have ha := mul_le_mul_of_nonneg_left hdn hB
    have hb := mul_lt_mul_of_pos_right hnB hn
    nlinarith
  exact (lt_of_le_of_lt (le_max_left C 0) ((lt_div_iff₀ hd).mpr hBnd)).trans_le
    (H.haar_positive_norm N hN₀)

theorem haar_positive_tendsto_atTop (H : ExponentialHeartModel G) :
    Tendsto (fun N => ‖∑ n ∈ Finset.range N, H.haarVector n‖) atTop atTop :=
  tendsto_atTop.mpr fun C => (H.haar_positive_eventually C).mono (fun _ h => h.le)

/-- Lindenstrauss–Tzafriri, Classical Banach Spaces II, Theorem 2.c.8.
The uniform sign estimate is restricted to the left-branch Haar functions. -/
axiom citeLindenstraussTzafririHaarReproducibility [CompleteSpace G] (H : ExponentialHeartModel G)
    {Z : Type} [NormedAddCommGroup Z] [NormedSpace ℝ Z] [CompleteSpace Z]
    (hZ : HasUnconditionalBasis Z) (h : ContainsCopy G Z) :
    ∃ C : ℝ, 0 < C ∧ ∀ (a s : ℕ → ℝ) (N : ℕ), (∀ n, |s n| = 1) →
      ‖∑ i ∈ Finset.range N, (s i * a i) • H.haarVector i‖ ≤
        C * ‖∑ i ∈ Finset.range N, a i • H.haarVector i‖

theorem no_unconditional_basis_embedding [CompleteSpace G] (H : ExponentialHeartModel G)
    {Z : Type} [NormedAddCommGroup Z] [NormedSpace ℝ Z] [CompleteSpace Z] (hZ : HasUnconditionalBasis Z) :
    ¬ ContainsCopy G Z := by
  intro h
  obtain ⟨C,hC,hbound⟩ := H.citeLindenstraussTzafririHaarReproducibility hZ h
  let s (n : ℕ) := (-1 : ℝ)^n
  have hs : ∀ n, |s n| = 1 := fun n => by simp only [s,abs_pow,abs_neg,abs_one,one_pow]
  obtain ⟨N,hN⟩ := (H.haar_positive_eventually (C * (2 * ‖H.one‖))).exists
  have hb := hbound s s N hs
  have hsq (n : ℕ) : s n * s n = 1 := by simp only [s,← mul_pow,neg_mul_neg,one_mul,one_pow]
  simp_rw [hsq,one_smul] at hb
  exact (not_lt_of_ge (hb.trans (mul_le_mul_of_nonneg_left (H.haar_alternating_norm N) hC.le))) hN

theorem no_unconditionalFrame [CompleteSpace G] (H : ExponentialHeartModel G) :
    ¬ ∃ (u : ℕ → G) (g : ℕ → Dual G), IsUnconditionalSchauderFrame u g := by
  rintro ⟨u,g,hf⟩
  obtain ⟨Z,_,_,_,hZ,⟨i,r,hr⟩⟩ := citeHanLarsonLiuLiuUnconditionalBasis hf
  apply H.no_unconditional_basis_embedding hZ
  let B := 1 + ‖r‖
  have hB : 0 < B := by dsimp [B]; positivity
  refine ⟨i,B⁻¹,inv_pos.mpr hB,fun x => ?_⟩
  have h := congrArg (fun L : G →L[ℝ] G => L x) hr
  change r (i x) = x at h
  have hm := r.le_opNorm (i x)
  rw [h] at hm
  calc
    B⁻¹ * ‖x‖ ≤ B⁻¹ * (B * ‖i x‖) :=
      mul_le_mul_of_nonneg_left (hm.trans (mul_le_mul_of_nonneg_right (by dsimp [B]; linarith) (norm_nonneg _)))
        (inv_nonneg.mpr hB.le)
    _ = ‖i x‖ := by rw [← mul_assoc,inv_mul_cancel₀ hB.ne',one_mul]

theorem no_continuousFrame [CompleteSpace G] (H : ExponentialHeartModel G)
    {Ω : Type*} [MeasurableSpace Ω] (ρ : Measure Ω) [SigmaFinite ρ] :
    ¬ Nonempty (ContinuousSchauderFrame (X := G) ρ) := by
  let : TopologicalSpace.SeparableSpace G := H.separable
  exact no_continuousFrame_of_no_unconditional ρ H.no_unconditionalFrame

end ExponentialHeartModel

