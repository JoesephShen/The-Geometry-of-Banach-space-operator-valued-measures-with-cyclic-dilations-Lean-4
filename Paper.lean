noncomputable section ContinuousFrameFactors

open MeasureTheory
open scoped ENNReal

variable {Ω X : Type*} [MeasurableSpace Ω] [NormedAddCommGroup X] [NormedSpace ℝ X]
  [CompleteSpace X]

theorem ContinuousSchauderFrame.operatorVariation_sigmaFinite [TopologicalSpace.SeparableSpace X]
    {ρ : Measure Ω} [SigmaFinite ρ] (F : ContinuousSchauderFrame (X := X) ρ) :
    SigmaFinite F.operatorMeasure.operatorVariationMeasure := by
  obtain ⟨D, _, hD, hfin⟩ := F.exists_partition_locally_compact_operatorMeasure
  apply Measure.sigmaFinite_of_countable (Set.countable_range fun n => (D n).1)
  · rintro _ ⟨n, rfl⟩
    rw [F.operatorMeasure.operatorVariationMeasure_apply]
    exact (hfin n).2.1
  · rw [sUnion_range]
    exact congrArg Subtype.val hD

private theorem measurable_countable_dispatch {Y : Type*} [MeasurableSpace Y] (j : Ω → ℕ)
    (hj : Measurable j) (a : ℕ → Ω → Y) (ha : ∀ n, Measurable (a n)) :
    Measurable (fun t => a (j t) t) := by
  intro E hE
  have he : (fun t => a (j t) t) ⁻¹' E = ⋃ n, (j ⁻¹' {n}) ∩ (a n ⁻¹' E) := by
    ext t
    constructor
    · intro ht
      exact mem_iUnion.mpr ⟨j t, rfl, ht⟩
    · intro ht
      obtain ⟨n, hn, ha₀⟩ := mem_iUnion.mp ht
      change j t = n at hn
      change a (j t) t ∈ E
      rwa [hn]
  rw [he]
  exact MeasurableSet.iUnion (fun n => (hj (measurableSet_singleton n)).inter (ha n hE))

omit [CompleteSpace X] in
private theorem exists_countable_norming_family [TopologicalSpace.SeparableSpace X]
    (d : ℕ → X) (hd : DenseRange d) :
    ∃ f : ℕ → Dual X, (∀ n, ‖f n‖ ≤ 1) ∧
      ∀ (x : X) (C : ℝ), (∀ n, |f n x| ≤ C) → ‖x‖ ≤ C := by
  have h (n : ℕ) : ∃ f : Dual X, ‖f‖ ≤ 1 ∧ f (d n) = ‖d n‖ := by
    by_cases hn : d n = 0
    · exact ⟨0, by simp, by simp [hn]⟩
    · obtain ⟨f, hf, hv⟩ := exists_dual_vector ℝ (d n) (norm_ne_zero_iff.mpr hn)
      exact ⟨f, hf.le, hv⟩
  choose f hf hD using h
  refine ⟨f, hf, fun x C hC => ?_⟩
  by_contra! hn
  let ε := (‖x‖ - C) / 3
  have hε : 0 < ε := by dsimp [ε]; linarith
  obtain ⟨z, ⟨n, rfl⟩, hn₀⟩ := Metric.mem_closure_iff.mp (hd x) ε hε
  have hdist : ‖x - d n‖ < ε := by simpa only [dist_eq_norm, dist_comm] using hn₀
  have hN : ‖x‖ ≤ ‖x - d n‖ + ‖d n‖ := by
    have he := norm_add_le (x - d n) (d n)
    rwa [sub_add_cancel] at he
  have hF : f n (d n) ≤ ‖x - d n‖ + C := by
    rw [show f n (d n) = f n (d n - x) + f n x from by rw [← map_add, sub_add_cancel]]
    apply add_le_add _ ((le_abs_self _).trans (hC n))
    exact (le_abs_self _).trans ((f n).le_opNorm _ |>.trans
      (by simpa only [one_mul, norm_sub_rev] using mul_le_mul_of_nonneg_right (hf n) (norm_nonneg (d n - x))))
  rw [hD] at hF
  dsimp [ε] at hdist
  linarith

omit [CompleteSpace X] in
private theorem eq_zero_of_norming_family
    (g : ℕ → Dual X) (hnorm : ∀ (x : X) (C : ℝ), (∀ n, |g n x| ≤ C) → ‖x‖ ≤ C)
    (x : X) (h : ∀ n, g n x = 0) : x = 0 := by
  apply norm_le_zero_iff.mp
  exact hnorm x 0 (by simp [h])

omit [CompleteSpace X] in
private theorem eq_of_eq_on_dense_linear {Y : Type*}
    [NormedAddCommGroup Y] [NormedSpace ℝ Y]
    (d : ℕ → X) (hd : DenseRange d) (A B : X →L[ℝ] Y)
    (h : ∀ n, A (d n) = B (d n)) : A = B := by
  apply ContinuousLinearMap.ext
  intro x
  exact (isClosed_eq A.continuous B.continuous).closure_subset_iff.mpr
    (by rintro _ ⟨n, rfl⟩; exact h n) (hd x)

omit [CompleteSpace X] in
private theorem rankOne_formula_of_coeffMinors (A : X →L[ℝ] X)
    (d : ℕ → X) (hd : DenseRange d) (g : ℕ → Dual X)
    (hnorm : ∀ (x : X) (C : ℝ), (∀ n, |g n x| ≤ C) → ‖x‖ ≤ C)
    (hminor : ∀ i k j l, g j (A (d i)) * g l (A (d k)) = g j (A (d k)) * g l (A (d i)))
    (i j : ℕ) (hne : g j (A (d i)) ≠ 0) :
    A = ((g j (A (d i)))⁻¹ • (g j).comp A).smulRight (A (d i)) := by
  apply eq_of_eq_on_dense_linear d hd
  intro k
  apply sub_eq_zero.mp
  apply eq_zero_of_norming_family g hnorm
  intro l
  rw [map_sub]
  change g l (A (d k)) - g l (((g j (A (d i)))⁻¹ * g j (A (d k))) • A (d i)) = 0
  rw [map_smul, smul_eq_mul]
  apply (mul_right_inj' hne).mp
  field_simp
  linarith [hminor i k j l]

/-- Explicit measurable factorization of a pointwise rank-one operator
field, using the first nonzero coefficient in a countable matrix. -/
theorem exists_measurable_rankOne_factors [TopologicalSpace.SeparableSpace X]
    (A : Ω → X →L[ℝ] X) (hm : ∀ x, StronglyMeasurable (fun t => A t x))
    (hr : ∀ t, ∃ (v : X) (f : Dual X), A t = f.smulRight v) :
    ∃ (v : Ω → X) (f : Ω → Dual X),
      StronglyMeasurable v ∧ (∀ x, Measurable (fun t => f t x)) ∧
        ∀ t, A t = (f t).smulRight (v t) := by
  classical
  let d := TopologicalSpace.denseSeq X
  have hd := TopologicalSpace.denseRange_denseSeq X
  obtain ⟨g, _, hnorm⟩ := exists_countable_norming_family d hd
  let p := Nat.pairEquiv.symm
  let c (n : ℕ) (t : Ω) := g (p n).2 (A t (d (p n).1))
  have hc (n : ℕ) : Measurable (c n) :=
    ((g (p n).2).continuous.comp_stronglyMeasurable (hm (d (p n).1))).measurable
  let K (n : ℕ) : Set Ω := {t | c n t ≠ 0}
  have hK (n : ℕ) : MeasurableSet (K n) := (measurableSet_eq_fun (hc n) measurable_const).compl
  let B (n : ℕ) := K n ∪ (⋃ i, K i)ᶜ
  obtain ⟨j, hj, hSel⟩ := measurable_first_cover B
    (fun n => (hK n).union (MeasurableSet.iUnion hK).compl) (fun t => by
      by_cases ht : t ∈ ⋃ i, K i
      · obtain ⟨i, hi⟩ := mem_iUnion.mp ht
        exact ⟨i, Or.inl hi⟩
      · exact ⟨0, Or.inr ht⟩)
  let v (t : Ω) := A t (d (p (j t)).1)
  let f (t : Ω) : Dual X := (c (j t) t)⁻¹ • (g (p (j t)).2).comp (A t)
  have hv : StronglyMeasurable v := by
    apply citePettisMeasurability
    intro a
    exact measurable_countable_dispatch j hj (fun n t => a (A t (d (p n).1)))
      (fun n => (a.continuous.comp_stronglyMeasurable (hm (d (p n).1))).measurable)
  have hf (x : X) : Measurable (fun t => f t x) :=
    measurable_countable_dispatch j hj (fun n t => (c n t)⁻¹ * g (p n).2 (A t x))
      (fun n => (hc n).inv.mul (((g (p n).2).continuous.comp_stronglyMeasurable (hm x)).measurable))
  refine ⟨v, f, hv, hf, fun t => ?_⟩
  rcases hSel t with ht | ht
  · apply rankOne_formula_of_coeffMinors (A t) d hd g hnorm _ (p (j t)).1 (p (j t)).2 ht
    obtain ⟨v₀, f₀, hvf⟩ := hr t
    intro i k l r
    rw [hvf]
    simp only [ContinuousLinearMap.smulRight_apply, map_smul, smul_eq_mul]
    ring
  · have hzero : A t = 0 := by
      apply eq_of_eq_on_dense_linear d hd
      intro n
      rw [zero_apply]
      apply eq_zero_of_norming_family g hnorm
      intro l
      have hh : t ∉ K (Nat.pairEquiv (n, l)) :=
        fun h => ht (mem_iUnion.mpr ⟨_, h⟩)
      simpa [K, c, p] using hh
    simp [v, hzero]

#print axioms ContinuousSchauderFrame.operatorVariation_sigmaFinite
#print axioms exists_measurable_rankOne_factors

end ContinuousFrameFactors



noncomputable section OperatorDensityNorm

open MeasureTheory
open scoped ENNReal

variable {Ω X : Type*} [MeasurableSpace Ω] [NormedAddCommGroup X] [NormedSpace ℝ X]
  [CompleteSpace X]

omit [CompleteSpace X] in
/-- The norm of the value of an OVM on one set is among the
partition bounds defining operator variation. -/
theorem OVM.enorm_val_le_operatorVariation (μ : OVM Ω X) (E : MeasSet Ω) :
    ENNReal.ofReal ‖μ.val E‖ ≤ μ.operatorVariation E := by
  apply le_sSup
  refine ⟨fun _ => E, {0}, by simp, ?_, by simp⟩
  apply Subtype.ext
  change (⋃ i ∈ ({0} : Finset ℕ), E.1) = E.1
  simp

omit [CompleteSpace X] in
private theorem opNorm_le_of_dense_closedBall
    {Y : Type*} [NormedAddCommGroup Y] [NormedSpace ℝ Y]
    (B : X →L[ℝ] Y) (d : ℕ → Metric.closedBall (0 : X) 1) (hd : DenseRange d)
    (C : ℝ) (hC : 0 ≤ C) (h : ∀ n, ‖B (d n)‖ ≤ C) :
    ‖B‖ ≤ C := by
  have hb (z : Metric.closedBall (0 : X) 1) : ‖B z‖ ≤ C := by
    have hc : IsClosed {z : Metric.closedBall (0 : X) 1 | ‖B z‖ ≤ C} :=
      isClosed_le (B.continuous.comp continuous_subtype_val).norm continuous_const
    exact hc.closure_subset_iff.mpr (by rintro _ ⟨n, rfl⟩; exact h n) (hd z)
  apply ContinuousLinearMap.opNorm_le_bound _ hC
  intro x
  by_cases hx : x = 0
  · simp [hx]
  have hx₀ : 0 < ‖x‖ := norm_pos_iff.mpr hx
  let y : X := ‖x‖⁻¹ • x
  have hy : ‖y‖ = 1 := by
    rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr (norm_nonneg x)), inv_mul_cancel₀ hx₀.ne']
  have hby := hb ⟨y, mem_closedBall_zero_iff.mpr hy.le⟩
  change ‖B (‖x‖⁻¹ • x)‖ ≤ C at hby
  rw [map_smul, norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr (norm_nonneg x)), ← div_eq_inv_mul] at hby
  exact (div_le_iff₀ hx₀).mp hby

omit [CompleteSpace X] in
private theorem opNorm_eq_iSup_dense_closedBall
    {Y : Type*} [NormedAddCommGroup Y] [NormedSpace ℝ Y]
    (B : X →L[ℝ] Y) (d : ℕ → Metric.closedBall (0 : X) 1) (hd : DenseRange d) :
    ‖B‖ = ⨆ n, ‖B (d n)‖ := by
  have h (n : ℕ) : ‖B (d n)‖ ≤ ‖B‖ := (B.le_opNorm _).trans (by
    simpa only [mul_one] using
      mul_le_mul_of_nonneg_left (mem_closedBall_zero_iff.mp (d n).2) (norm_nonneg B))
  have hz : BddAbove (Set.range fun n => ‖B (d n)‖) := ⟨_, Set.forall_mem_range.mpr h⟩
  apply le_antisymm (opNorm_le_of_dense_closedBall B d hd _
    ((norm_nonneg _).trans (le_ciSup hz 0)) (le_ciSup hz))
  exact ciSup_le h

omit [CompleteSpace X] in
private theorem OVM.scalarDensity_abs_le_one
    (μ : OVM Ω X) [SigmaFinite μ.operatorVariationMeasure]
    (A : Ω → X →L[ℝ] X) (x : X) (hx : ‖x‖ ≤ 1) (f : Dual X) (hf : ‖f‖ ≤ 1)
    (hi : Integrable (fun t => f (A t x)) μ.operatorVariationMeasure)
    (he : ∀ E : MeasSet Ω, f (μ.val E x) = ∫ t in E.1, f (A t x) ∂μ.operatorVariationMeasure) :
    ∀ᵐ t ∂μ.operatorVariationMeasure, |f (A t x)| ≤ 1 := by
  let ν := μ.operatorVariationMeasure
  obtain ⟨B, _, hcover, hfin⟩ := μ.exists_operatorVariation_partition
  have hb (s : ℝ) (hs : |s| ≤ 1) (E : MeasSet Ω) (hE : ν E.1 ≠ ⊤) :
      (∫ t in E.1, s * f (A t x) ∂ν) ≤ (ν E.1).toReal := by
    rw [integral_const_mul, ← he E]
    have hval : ‖μ.val E‖ ≤ (ν E.1).toReal := by
      have h := ENNReal.toReal_mono hE (μ.enorm_val_le_operatorVariation E |>.trans_eq
        (μ.operatorVariationMeasure_apply E).symm)
      rwa [ENNReal.toReal_ofReal (norm_nonneg _)] at h
    have hscalar : |f (μ.val E x)| ≤ ‖μ.val E‖ := by
      exact (f.le_opNorm _).trans (((mul_le_mul_of_nonneg_right hf (norm_nonneg _)).trans_eq (one_mul _)).trans
        (((μ.val E).le_opNorm x).trans (by
          simpa only [mul_one] using mul_le_mul_of_nonneg_left hx (norm_nonneg _))))
    exact (le_abs_self _).trans (by
      rw [abs_mul]
      exact ((mul_le_mul_of_nonneg_right hs (abs_nonneg _)).trans_eq (one_mul _)).trans (hscalar.trans hval))
  have hloc (n : ℕ) (s : ℝ) (hs : |s| ≤ 1) :
      ∀ᵐ t ∂ν.restrict (B n).1, s * f (A t x) ≤ 1 := by
    let _ : IsFiniteMeasure (ν.restrict (B n).1) := ⟨by
      rw [Measure.restrict_apply_univ]
      exact (μ.operatorVariationMeasure_apply (B n)).trans_lt (hfin n)⟩
    apply ae_le_of_forall_setIntegral_le (hi.const_mul s).restrict (integrable_const (1 : ℝ))
    intro E hE _
    rw [Measure.restrict_restrict hE, setIntegral_const, smul_eq_mul, mul_one]
    apply hb s hs ⟨E ∩ (B n).1, hE.inter (B n).2⟩
    exact ne_of_lt ((measure_mono inter_subset_right).trans_lt
      ((μ.operatorVariationMeasure_apply (B n)).trans_lt (hfin n)))
  have hlocAbs (n : ℕ) : ∀ᵐ t ∂ν.restrict (B n).1, |f (A t x)| ≤ 1 := by
    filter_upwards [hloc n 1 (by norm_num), hloc n (-1) (by norm_num)] with t h₁ h₂
    exact abs_le.mpr ⟨by linarith, by linarith⟩
  have hcover' : (⋃ n, (B n).1) = univ := congrArg Subtype.val hcover
  have ha := (ae_restrict_iUnion_iff (μ := ν) (fun n => (B n).1) (fun t => |f (A t x)| ≤ 1)).mpr hlocAbs
  rwa [hcover', Measure.restrict_univ] at ha

/-- All locally integrable scalar orbit coefficients of the density
are bounded by the original operator variation. In particular the
density is a contraction outside a single null set. -/
theorem OVM.operatorDensity_norm_le_one_ae [TopologicalSpace.SeparableSpace X]
    (μ : OVM Ω X) [SigmaFinite μ.operatorVariationMeasure]
    (A : Ω → X →L[ℝ] X)
    (hi : ∀ x (f : Dual X), Integrable (fun t => f (A t x)) μ.operatorVariationMeasure)
    (he : ∀ (E : MeasSet Ω) x (f : Dual X),
      f (μ.val E x) = ∫ t in E.1, f (A t x) ∂μ.operatorVariationMeasure) :
    ∀ᵐ t ∂μ.operatorVariationMeasure, ‖A t‖ ≤ 1 := by
  let U := Metric.closedBall (0 : X) 1
  let _ : Nonempty U := ⟨⟨0, mem_closedBall_zero_iff.mpr (by simp)⟩⟩
  let d : ℕ → U := TopologicalSpace.denseSeq U
  obtain ⟨g, hg, hNorm⟩ := exists_countable_norming_family (TopologicalSpace.denseSeq X)
    (TopologicalSpace.denseRange_denseSeq X)
  have hb (i j : ℕ) : ∀ᵐ t ∂μ.operatorVariationMeasure, |g j (A t (d i))| ≤ 1 :=
    μ.scalarDensity_abs_le_one A (d i) (mem_closedBall_zero_iff.mp (d i).2)
      (g j) (hg j) (hi _ _) (fun E => he E _ _)
  filter_upwards [ae_all_iff.mpr fun i => ae_all_iff.mpr (hb i)] with t ht
  exact opNorm_le_of_dense_closedBall (A t) d (TopologicalSpace.denseRange_denseSeq U) 1 (by norm_num)
    (fun i => hNorm _ 1 (ht i))

#print axioms OVM.operatorDensity_norm_le_one_ae




private theorem measurable_operatorNorm_of_orbits [TopologicalSpace.SeparableSpace X]
    {Y : Type*} [NormedAddCommGroup Y] [NormedSpace ℝ Y] (A : Ω → X →L[ℝ] Y)
    (hm : ∀ x, Measurable (fun t => ‖A t x‖)) :
    Measurable (fun t => ‖A t‖) := by
  let U := Metric.closedBall (0 : X) 1
  let _ : Nonempty U := ⟨⟨0, mem_closedBall_zero_iff.mpr (by simp)⟩⟩
  let d : ℕ → U := TopologicalSpace.denseSeq U
  have he : (fun t => ‖A t‖) = fun t => ⨆ n, ‖A t (d n)‖ :=
    funext fun t => opNorm_eq_iSup_dense_closedBall (A t) d (TopologicalSpace.denseRange_denseSeq U)
  rw [he]
  exact Measurable.iSup fun n => hm (d n)

private theorem OVM.operatorDensity_variation_le_integral_norm [TopologicalSpace.SeparableSpace X]
    (μ : OVM Ω X) (A : Ω → X →L[ℝ] X)
    (hm : ∀ x, StronglyMeasurable (fun t => A t x))
    (hA : ∀ᵐ t ∂μ.operatorVariationMeasure, ‖A t‖ ≤ 1)
    (he : ∀ (E : MeasSet Ω) x (f : Dual X),
      f (μ.val E x) = ∫ t in E.1, f (A t x) ∂μ.operatorVariationMeasure)
    (E : MeasSet Ω) (hE : μ.operatorVariationMeasure E.1 < ⊤) :
    (μ.operatorVariationMeasure E.1).toReal ≤ ∫ t in E.1, ‖A t‖ ∂μ.operatorVariationMeasure := by
  let ν := μ.operatorVariationMeasure
  have hMeas : Measurable (fun t => ‖A t‖) :=
    measurable_operatorNorm_of_orbits A (fun x => (continuous_norm.comp_stronglyMeasurable (hm x)).measurable)
  have hi (D : MeasSet Ω) (hD : D.1 ⊆ E.1) : IntegrableOn (fun t => ‖A t‖) D.1 ν := by
    let _ : IsFiniteMeasure (ν.restrict D.1) := ⟨by
      rw [Measure.restrict_apply_univ]
      exact (measure_mono hD).trans_lt hE⟩
    apply (integrable_const (1 : ℝ)).mono' hMeas.aestronglyMeasurable
    filter_upwards [ae_restrict_of_ae hA] with t ht
    simpa only [Real.norm_of_nonneg (norm_nonneg (A t))] using ht
  have hnorm (D : MeasSet Ω) (hD : D.1 ⊆ E.1) : ‖μ.val D‖ ≤ ∫ t in D.1, ‖A t‖ ∂ν := by
    apply ContinuousLinearMap.opNorm_le_bound _ (integral_nonneg (fun _ => norm_nonneg _))
    intro x
    have hnormInt := (hi D hD).mul_const ‖x‖
    have hdom (t : Ω) : ‖A t x‖ ≤ ‖A t‖ * ‖x‖ := (A t).le_opNorm x
    have hix : IntegrableOn (fun t => A t x) D.1 ν :=
      hnormInt.mono' (hm x).aestronglyMeasurable (Eventually.of_forall hdom)
    have hEq : μ.val D x = ∫ t in D.1, A t x ∂ν := by
      apply eq_of_dual_eval
      intro f
      rw [he, ← f.integral_comp_comm hix]
    rw [hEq, ← integral_mul_const]
    exact (norm_integral_le_integral_norm _).trans
      (integral_mono_ae hix.norm hnormInt (Eventually.of_forall hdom))
  have hz : 0 ≤ ∫ t in E.1, ‖A t‖ ∂ν := integral_nonneg (fun _ => norm_nonneg _)
  apply (ENNReal.ofReal_le_ofReal_iff hz).mp
  rw [ENNReal.ofReal_toReal hE.ne, μ.operatorVariationMeasure_apply]
  apply sSup_le
  rintro _ ⟨D, I, hd, hD, rfl⟩
  have hsub (i : ℕ) (hi₀ : i ∈ I) : (D i).1 ⊆ E.1 := fun _ ht =>
    hD ▸ mem_iUnion₂.mpr ⟨i, hi₀, ht⟩
  have hsum : (∑ i ∈ I, ∫ t in (D i).1, ‖A t‖ ∂ν) = ∫ t in E.1, ‖A t‖ ∂ν := by
    rw [← integral_biUnion_finset I (fun n _ => (D n).2) hd (fun i h => hi (D i) (hsub i h))]
    exact congrArg (fun D₀ : MeasSet Ω => ∫ t in D₀.1, ‖A t‖ ∂ν) hD
  calc
    _ ≤ ∑ i ∈ I, ENNReal.ofReal (∫ t in (D i).1, ‖A t‖ ∂ν) :=
      Finset.sum_le_sum fun i hh => ENNReal.ofReal_le_ofReal (hnorm _ (hsub i hh))
    _ = _ := by
      rw [← ENNReal.ofReal_sum_of_nonneg (f := fun i => ∫ t in (D i).1, ‖A t‖ ∂ν)
        (fun _ _ => integral_nonneg fun _ => norm_nonneg _), hsum]

/-- The density has norm one for its own operator-norm variation. -/
theorem OVM.operatorDensity_norm_eq_one_ae [TopologicalSpace.SeparableSpace X]
    (μ : OVM Ω X) [SigmaFinite μ.operatorVariationMeasure]
    (A : Ω → X →L[ℝ] X)
    (hm : ∀ x, StronglyMeasurable (fun t => A t x))
    (hi : ∀ x (f : Dual X), Integrable (fun t => f (A t x)) μ.operatorVariationMeasure)
    (he : ∀ (E : MeasSet Ω) x (f : Dual X),
      f (μ.val E x) = ∫ t in E.1, f (A t x) ∂μ.operatorVariationMeasure) :
    ∀ᵐ t ∂μ.operatorVariationMeasure, ‖A t‖ = 1 := by
  let ν := μ.operatorVariationMeasure
  have hA := μ.operatorDensity_norm_le_one_ae A hi he
  have hMeas : Measurable (fun t => ‖A t‖) :=
    measurable_operatorNorm_of_orbits A (fun x => (continuous_norm.comp_stronglyMeasurable (hm x)).measurable)
  obtain ⟨B, _, hB, hfin⟩ := μ.exists_operatorVariation_partition
  have hloc (n : ℕ) : ∀ᵐ t ∂ν.restrict (B n).1, 1 ≤ ‖A t‖ := by
    have hn : ν (B n).1 < ⊤ := (μ.operatorVariationMeasure_apply (B n)).trans_lt (hfin n)
    let _ : IsFiniteMeasure (ν.restrict (B n).1) := ⟨by rw [Measure.restrict_apply_univ]; exact hn⟩
    have hc : Integrable (fun _ : Ω => (1 : ℝ)) (ν.restrict (B n).1) := integrable_const _
    have hnorm : Integrable (fun t => ‖A t‖) (ν.restrict (B n).1) := by
      apply hc.mono' hMeas.aestronglyMeasurable
      filter_upwards [ae_restrict_of_ae hA] with t ht
      simpa only [Real.norm_of_nonneg (norm_nonneg (A t))] using ht
    apply ae_le_of_forall_setIntegral_le hc hnorm
    intro E hE _
    rw [Measure.restrict_restrict hE, setIntegral_const, smul_eq_mul, mul_one]
    exact μ.operatorDensity_variation_le_integral_norm A hm hA he ⟨E ∩ (B n).1, hE.inter (B n).2⟩
      ((measure_mono inter_subset_right).trans_lt hn)
  have hu : (⋃ n, (B n).1) = univ := congrArg Subtype.val hB
  have hg := (ae_restrict_iUnion_iff (μ := ν) (fun n => (B n).1) (fun t => 1 ≤ ‖A t‖)).mpr hloc
  rw [hu, Measure.restrict_univ] at hg
  filter_upwards [hg, hA] with t h t'
  exact le_antisymm t' h

#print axioms OVM.operatorDensity_norm_eq_one_ae

end OperatorDensityNorm


noncomputable section CyclicRankOneDensity

open MeasureTheory
open scoped ENNReal

universe uΩ uX

variable {Ω : Type uΩ} {X : Type uX} [MeasurableSpace Ω]
  [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X]

/-- The scalar Radon–Nikodým change-of-measure formula, including the
strict positivity of the derivative almost everywhere for the dominated
measure. The dominated measure may be σ-finite. -/
axiom citeScalarRNChangeOfMeasure (ν₀ ρ : Measure Ω) [SigmaFinite ν₀] [IsFiniteMeasure ρ]
    (hac : ∀ E : MeasSet Ω, ρ E.1 = 0 → ν₀ E.1 = 0) :
    ∃ a : Ω → ℝ, Measurable a ∧ (∀ᵐ t ∂ν₀, 0 < a t) ∧
      ∀ (f : Ω → ℝ), Integrable f ν₀ →
        Integrable (fun t => a t * f t) ρ ∧ ∀ E : MeasSet Ω,
        (∫ t in E.1, f t ∂ν₀) = ∫ t in E.1, a t * f t ∂ρ

/-- Li and Li (2017), Theorem 2.6, applied to the σ-finite
operator-norm variation of a strongly countably additive OVM. -/
axiom citeLiLi2017OperatorDensity [TopologicalSpace.SeparableSpace X]
    (μ : OVM Ω X) [SigmaFinite μ.operatorVariationMeasure]
    (hR : HasRadonNikodymProperty.{uΩ} X) :
    ∃ A : Ω → X →L[ℝ] X, (∀ x, StronglyMeasurable (fun t => A t x)) ∧
      (∀ x (f : Dual X), Integrable (fun t => f (A t x)) μ.operatorVariationMeasure) ∧
      ∀ (E : MeasSet Ω) x (f : Dual X), f (μ.val E x) =
        ∫ t in E.1, f (A t x) ∂μ.operatorVariationMeasure

private theorem ae_of_ae_on_measurable_null_domination {ρ ν₀ : Measure Ω}
    (hac : ∀ E : MeasSet Ω, ρ E.1 = 0 → ν₀ E.1 = 0) {p : Ω → Prop}
    (hp : MeasurableSet {t | p t}) (h : ∀ᵐ t ∂ρ, p t) : ∀ᵐ t ∂ν₀, p t := by
  rw [ae_iff] at h ⊢
  exact hac ⟨_, hp.compl⟩ h

private theorem OVM.cyclic_density_coefficients_factor
    (μ : OVM Ω X) (hμ : μ.Normalized) (hcyc : μ.alphaPVM.Cyclic)
    [SigmaFinite μ.operatorVariationMeasure] (A : Ω → X →L[ℝ] X)
    (hi : ∀ x (f : Dual X), Integrable (fun t => f (A t x)) μ.operatorVariationMeasure)
    (hm : ∀ x, StronglyMeasurable (fun t => A t x))
    (he : ∀ (E : MeasSet Ω) x (f : Dual X), f (μ.val E x) =
      ∫ t in E.1, f (A t x) ∂μ.operatorVariationMeasure) :
    ∃ (a : Ω → ℝ) (H : X → Ω → ℝ) (K : Dual X → Ω → ℝ),
      (∀ᵐ t ∂μ.operatorVariationMeasure, 0 < a t) ∧
      ∀ x f, ∀ᵐ t ∂μ.operatorVariationMeasure, a t * f (A t x) = H x t * K f t := by
  obtain ⟨u, hu⟩ := hcyc
  let D := μ.alphaDilation hμ
  let m := D.cyclicVectorMeasure u
  let h₀ := D.cyclicVectorMeasure_empty u
  let hσ := D.cyclicVectorMeasure_hasSum u
  let M := standardVectorMeasureL1 m h₀ hσ
  let _ := M.normedGroup
  let _ := M.normedScalar
  let _ := M.isComplete
  let C := Classical.choice (citeVectorMeasureL1NormCoordinates m h₀ hσ)
  let ρ := C.ρ
  let _ : IsFiniteMeasure ρ := C.finite
  let ν₀ := μ.operatorVariationMeasure
  obtain ⟨_, D₀, _, _, hp, hs, _, _, _⟩ := D.vectorMeasureL1_dilation u hu M.data
  have hcomp (x : X) (f : Dual X) (E : MeasSet Ω) :
      f (μ.val E x) = ∫ t in E.1, C.scalar.repr (D₀.T x) t * C.k f t ∂ρ := by
    rw [← C.evaluate]
    rw [← hp, ← hs]
    exact (congrArg f (DFunLike.congr_fun (D₀.compress E) x)).symm
  have hac (E : MeasSet Ω) (hE : ρ E.1 = 0) : ν₀ E.1 = 0 := by
    rw [μ.operatorVariationMeasure_apply]
    apply le_antisymm _ bot_le
    apply sSup_le
    rintro _ ⟨F, I, _, hF, rfl⟩
    apply le_of_eq
    apply Finset.sum_eq_zero
    intro i hi₀
    have hsub : (F i).1 ⊆ E.1 := fun t ht => hF ▸ mem_iUnion₂.mpr ⟨i, hi₀, ht⟩
    have hzero : μ.val (F i) = 0 := by
      apply ContinuousLinearMap.ext
      intro x
      apply eq_of_dual_eval
      intro f
      rw [hcomp, Measure.restrict_eq_zero.mpr (measure_mono_null hsub hE),
        integral_zero_measure, zero_apply, map_zero]
    rw [hzero, norm_zero, ENNReal.ofReal_zero]
  obtain ⟨a, ha, hpos, hchange⟩ := citeScalarRNChangeOfMeasure ν₀ ρ hac
  refine ⟨a, fun x t => C.scalar.repr (D₀.T x) t, C.k, hpos, fun x f => ?_⟩
  obtain ⟨hi₁, hchanges⟩ := hchange (fun t => f (A t x)) (hi x f)
  have hi₂ := C.integrable (D₀.T x) f
  apply ae_of_ae_on_measurable_null_domination hac
  · exact measurableSet_eq_fun
      (ha.mul (f.continuous.comp_stronglyMeasurable (hm x)).measurable)
      ((C.scalar.repr (D₀.T x)).stronglyMeasurable.measurable.mul (C.measurable_density f))
  · apply ae_eq_from_cut_integrals ρ hi₁ hi₂
    intro E
    rw [← hchanges E, ← he, hcomp]

/-- The countably many scalar minors vanish on a measurable conull set.
After modifying the field on its complement the density is pointwise
rank at most one. -/
theorem OVM.exists_ae_rankOne_density_of_cyclic [TopologicalSpace.SeparableSpace X]
    (μ : OVM Ω X) (hμ : μ.Normalized) (hcyc : μ.alphaPVM.Cyclic)
    [SigmaFinite μ.operatorVariationMeasure] (A : Ω → X →L[ℝ] X)
    (hi : ∀ x (f : Dual X), Integrable (fun t => f (A t x)) μ.operatorVariationMeasure)
    (hm : ∀ x, StronglyMeasurable (fun t => A t x))
    (he : ∀ (E : MeasSet Ω) x (f : Dual X), f (μ.val E x) =
      ∫ t in E.1, f (A t x) ∂μ.operatorVariationMeasure) :
    ∃ A₀ : Ω → X →L[ℝ] X, A₀ =ᵐ[μ.operatorVariationMeasure] A ∧
      (∀ x, StronglyMeasurable (fun t => A₀ t x)) ∧
      ∀ t, ∃ (v : X) (f : Dual X), A₀ t = f.smulRight v := by
  classical
  obtain ⟨a, H, K, ha, hEq⟩ := μ.cyclic_density_coefficients_factor hμ hcyc A hi hm he
  let d := TopologicalSpace.denseSeq X
  have hd := TopologicalSpace.denseRange_denseSeq X
  obtain ⟨g, _, hnorm⟩ := exists_countable_norming_family d hd
  let c (i j : ℕ) (t : Ω) := g j (A t (d i))
  let G : Set Ω := {t | ∀ i k j l : ℕ, c i j t * c k l t = c k j t * c i l t}
  have hc (i j : ℕ) : Measurable (c i j) :=
    ((g j).continuous.comp_stronglyMeasurable (hm (d i))).measurable
  have hG : MeasurableSet G := by
    have heG : G = ⋂ i, ⋂ k, ⋂ j, ⋂ l, {t | c i j t * c k l t = c k j t * c i l t} := by
      ext t
      simp only [G, Set.mem_ofPred_eq, mem_iInter]
    rw [heG]
    exact MeasurableSet.iInter fun i => MeasurableSet.iInter fun k => MeasurableSet.iInter fun j =>
      MeasurableSet.iInter fun l => measurableSet_eq_fun ((hc i j).mul (hc k l)) ((hc k j).mul (hc i l))
  have haG : ∀ᵐ t ∂μ.operatorVariationMeasure, t ∈ G := by
    filter_upwards [ha, ae_all_iff.mpr fun i => ae_all_iff.mpr fun j => hEq (d i) (g j)] with t hat ht
    intro i k j l
    apply mul_left_cancel₀ (mul_ne_zero hat.ne' hat.ne')
    have hx : (a t * c i j t) * (a t * c k l t) = (a t * c k j t) * (a t * c i l t) := by
      have h₁ := ht i j
      have h₂ := ht k l
      have h₃ := ht k j
      have h₄ := ht i l
      change a t * c i j t = _ at h₁
      change a t * c k l t = _ at h₂
      change a t * c k j t = _ at h₃
      change a t * c i l t = _ at h₄
      rw [h₁, h₂, h₃, h₄]
      ring
    convert hx using 1 <;> ring
  let A₀ := G.piecewise A (fun _ => 0)
  have hA₀ : A₀ =ᵐ[μ.operatorVariationMeasure] A := by
    filter_upwards [haG] with t ht
    exact piecewise_eq_of_mem G A _ ht
  refine ⟨A₀, hA₀, fun x => ?_, fun t => ?_⟩
  · have h : StronglyMeasurable (G.piecewise (fun t => A t x) (fun _ => (0 : X))) :=
      (hm x).piecewise hG stronglyMeasurable_const
    convert h using 1
    funext t
    by_cases ht : t ∈ G <;> simp [A₀, ht]
  · by_cases ht : t ∈ G
    · by_cases hzero : A t = 0
      · exact ⟨0, 0, by simp [A₀, ht, hzero]⟩
      · have hn : ∃ i j, c i j t ≠ 0 := by
          by_contra h
          push Not at h
          apply hzero
          apply eq_of_eq_on_dense_linear d hd
          intro i
          rw [zero_apply]
          exact eq_zero_of_norming_family g hnorm _ (h i)
        obtain ⟨i, j, hij⟩ := hn
        refine ⟨A t (d i), (c i j t)⁻¹ • (g j).comp (A t), ?_⟩
        rw [show A₀ t = A t from piecewise_eq_of_mem G A _ ht]
        exact rankOne_formula_of_coeffMinors (A t) d hd g hnorm ht i j hij
    · exact ⟨0, 0, by simp [A₀, ht]⟩

#print axioms OVM.exists_ae_rankOne_density_of_cyclic

end CyclicRankOneDensity



noncomputable section FrameRepresentationFromDensity

open MeasureTheory
open scoped ENNReal

universe uΩ uX
variable {Ω : Type uΩ} {X : Type uX} [MeasurableSpace Ω]
  [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X]
  [TopologicalSpace.SeparableSpace X]

private theorem stronglyMeasurable_of_weakStar_of_separable_dual
    (f : Ω → Dual X) (hf : ∀ x, Measurable (fun t => f t x))
    [TopologicalSpace.SeparableSpace (Dual X)] :
    StronglyMeasurable f := by
  let d := TopologicalSpace.denseSeq (Dual X)
  have hd := TopologicalSpace.denseRange_denseSeq (Dual X)
  have hdist (j : ℕ) : Measurable (fun t => dist (f t) (d j)) := by
    simp only [dist_eq_norm]
    apply measurable_operatorNorm_of_orbits (fun t => f t - d j)
    intro x
    exact ((hf x).sub measurable_const).norm
  let ε (n : ℕ) := (1 / 2 : ℝ) ^ n
  have he (n : ℕ) : 0 < ε n := by dsimp [ε]; positivity
  have hp (n : ℕ) : ∃ j : Ω → ℕ, Measurable j ∧ ∀ t, dist (f t) (d (j t)) < ε n := by
    let B (k : ℕ) : Set Ω := {t | dist (f t) (d k) < ε n}
    apply measurable_first_cover B (fun k => measurableSet_lt (hdist k) measurable_const)
    intro t
    obtain ⟨_, ⟨k, rfl⟩, hk⟩ := Metric.mem_closure_iff.mp (hd (f t)) (ε n) (he n)
    exact ⟨k, hk⟩
  choose j hj hEval using hp
  have hsm (n : ℕ) : StronglyMeasurable (fun t => d (j n t)) := by
    let : MeasurableSpace (Dual X) := borel (Dual X)
    let : BorelSpace (Dual X) := ⟨rfl⟩
    exact ((measurable_of_countable d).comp (hj n)).stronglyMeasurable
  apply stronglyMeasurable_of_tendsto atTop hsm
  apply tendsto_pi_nhds.mpr
  intro t
  apply tendsto_iff_dist_tendsto_zero.mpr
  apply squeeze_zero (fun n => dist_nonneg)
    (fun n => (show dist (d (j n t)) (f t) < ε n by rw [dist_comm]; exact hEval n t).le)
  exact tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num) (by norm_num)

omit [CompleteSpace X] [TopologicalSpace.SeparableSpace X] in
private theorem OVM.eq_of_value_eq (μ ν : OVM Ω X) (h : μ.val = ν.val) : μ = ν := by
  cases μ
  cases ν
  cases h
  rfl

private theorem OVM.exists_continuous_frame_of_rankOne_density
    (μ : OVM Ω X) (hμ : μ.Normalized) (A : Ω → X →L[ℝ] X)
    (hr : ∀ t, ∃ (v : X) (f : Dual X), A t = f.smulRight v)
    (hm : ∀ x, StronglyMeasurable (fun t => A t x))
    (hi : ∀ x (f : Dual X), Integrable (fun t => f (A t x)) μ.operatorVariationMeasure)
    (he : ∀ (E : MeasSet Ω) x (f : Dual X),
      f (μ.val E x) = ∫ t in E.1, f (A t x) ∂μ.operatorVariationMeasure)
    (hnorm : ∀ᵐ t ∂μ.operatorVariationMeasure, ‖A t‖ = 1) :
    ∃ F : ContinuousSchauderFrame (X := X) μ.operatorVariationMeasure,
      F.operatorMeasure = μ ∧ (∀ᵐ t ∂μ.operatorVariationMeasure, ‖F.vector t‖ * ‖F.functional t‖ = 1) ∧
      StronglyMeasurable F.vector ∧
      (TopologicalSpace.SeparableSpace (Dual X) → StronglyMeasurable F.functional) := by
  obtain ⟨v, f, hv, hf, hF⟩ := exists_measurable_rankOne_factors A hm hr
  have hAe (t : Ω) (x : X) : A t x = f t x • v t := DFunLike.congr_fun (hF t) x
  have hcoeff (E : MeasSet Ω) (x : X) (g : Dual X) :
      g (μ.val E x) = ∫ t in E.1, f t x * g (v t) ∂μ.operatorVariationMeasure := by
    simpa only [hAe, map_smul, smul_eq_mul] using he E x g
  let F : ContinuousSchauderFrame (X := X) μ.operatorVariationMeasure :=
    { vector := v
      functional := f
      weaklyMeasurable := fun g => (g.continuous.comp_stronglyMeasurable hv).measurable
      weakStarMeasurable := hf
      pettis := fun x =>
        ⟨fun g => ⟨by
          have hh := (hf x).mul (g.continuous.comp_stronglyMeasurable hv).measurable
          change Measurable (fun t => f t x * g (v t)) at hh
          simpa only [map_smul, smul_eq_mul] using hh, by
          simpa only [hAe, map_smul, smul_eq_mul] using hi x g⟩,
        fun E => ⟨μ.val E x, fun g => by simpa only [map_smul, smul_eq_mul] using hcoeff E x g⟩⟩
      reconstruction := fun x g => by
        have h := hcoeff MeasSet.whole x g
        rwa [hμ, ContinuousLinearMap.id_apply, MeasSet.whole, setIntegral_univ] at h }
  refine ⟨F, ?_, ?_, hv, fun h => ?_⟩
  · have hval : F.operatorMeasure.val = μ.val := by
      funext E
      apply ContinuousLinearMap.ext
      intro x
      apply eq_of_dual_eval
      intro g
      exact (F.operatorMeasure_coeff E x g).trans (hcoeff E x g).symm
    exact F.operatorMeasure.eq_of_value_eq μ hval
  · filter_upwards [hnorm] with t ht
    change ‖v t‖ * ‖f t‖ = 1
    rwa [hF t, ContinuousLinearMap.norm_smulRight_apply, mul_comm] at ht
  · let _ := h
    exact stronglyMeasurable_of_weakStar_of_separable_dual f hf

/-- The normalization and measurability claims of the continuous frame
representation theorem, on the actual operator-norm variation measure. -/
theorem OVM.exists_continuous_frame_on_operatorVariation (μ : OVM Ω X)
    (hμ : μ.Normalized) (hcyc : μ.alphaPVM.Cyclic) (hc₀ : ¬ ContainsCopy CZero X)
    [SigmaFinite μ.operatorVariationMeasure] :
    ∃ F : ContinuousSchauderFrame (X := X) μ.operatorVariationMeasure,
      F.operatorMeasure = μ ∧ (∀ᵐ t ∂μ.operatorVariationMeasure, ‖F.vector t‖ * ‖F.functional t‖ = 1) ∧
      StronglyMeasurable F.vector ∧
      (TopologicalSpace.SeparableSpace (Dual X) → StronglyMeasurable F.functional) := by
  have hR : HasRadonNikodymProperty.{uΩ} X :=
    μ.hasRadonNikodymProperty_of_cyclic_sigmaFinite_variation hμ hcyc hc₀
  obtain ⟨A, hm, hi, he⟩ := citeLiLi2017OperatorDensity μ hR
  have hnorm := μ.operatorDensity_norm_eq_one_ae A hm hi he
  obtain ⟨A₀, hAE, hm₀, hr⟩ := μ.exists_ae_rankOne_density_of_cyclic hμ hcyc A hi hm he
  have hc (x : X) (f : Dual X) :
      (fun t => f (A t x)) =ᵐ[μ.operatorVariationMeasure] fun t => f (A₀ t x) := by
    filter_upwards [hAE] with t ht
    rw [ht]
  apply μ.exists_continuous_frame_of_rankOne_density hμ A₀ hr hm₀
    (fun x f => (hi x f).congr (hc x f))
  · intro E x f
    exact (he E x f).trans (integral_congr_ae (ae_restrict_of_ae (hc x f)))
  · filter_upwards [hAE, hnorm] with t ht hn
    rwa [ht]

/-- Manuscript, thm:continuous-frame-representation and intro:frame.
The cyclicity of the minimal dilation is equivalent to the existence of
a cyclic dilation by prop:minimal-cyclic. -/
theorem OVM.continuous_frame_representation_iff (μ : OVM Ω X)
    (hμ : μ.Normalized) (hc₀ : ¬ ContainsCopy CZero X) :
    (∃ ρ : Measure Ω, SigmaFinite ρ ∧
      ∃ F : ContinuousSchauderFrame (X := X) ρ, F.operatorMeasure = μ) ↔
      μ.alphaPVM.Cyclic ∧ SigmaFinite μ.operatorVariationMeasure := by
  constructor
  · rintro ⟨ρ, hρ, F, rfl⟩
    let _ := hρ
    obtain ⟨_, _, _, _, _, _, _, _, _, M, D, _, _, _, _, hc⟩ := F.exists_cyclic_dilation_weightedL1
    let _ := M.model.normedGroup
    let _ := M.model.normedScalar
    let _ := M.model.isComplete
    exact ⟨D.cyclic_alphaPVM ⟨_, hc⟩, F.operatorVariation_sigmaFinite⟩
  · rintro ⟨hcyc, hσ⟩
    let _ := hσ
    obtain ⟨F, hF, _, _, _⟩ := μ.exists_continuous_frame_on_operatorVariation hμ hcyc hc₀
    exact ⟨μ.operatorVariationMeasure, hσ, F, hF⟩

#print axioms OVM.exists_continuous_frame_on_operatorVariation
#print axioms OVM.continuous_frame_representation_iff

end FrameRepresentationFromDensity



noncomputable section DisjointSumPVM

open MeasureTheory

variable {Ω₁ Ω₂ X Y : Type*} [MeasurableSpace Ω₁] [MeasurableSpace Ω₂]
  [NormedAddCommGroup X] [NormedSpace ℝ X] [NormedAddCommGroup Y] [NormedSpace ℝ Y]

def MeasSet.sumLeft (E : MeasSet (Ω₁ ⊕ Ω₂)) : MeasSet Ω₁ :=
  ⟨Sum.inl ⁻¹' E.1, measurable_inl E.2⟩

def MeasSet.sumRight (E : MeasSet (Ω₁ ⊕ Ω₂)) : MeasSet Ω₂ :=
  ⟨Sum.inr ⁻¹' E.1, measurable_inr E.2⟩

def MeasSet.onSumLeft (E : MeasSet Ω₁) : MeasSet (Ω₁ ⊕ Ω₂) :=
  ⟨Sum.inl '' E.1, E.2.inl_image⟩

def MeasSet.onSumRight (E : MeasSet Ω₂) : MeasSet (Ω₁ ⊕ Ω₂) :=
  ⟨Sum.inr '' E.1, E.2.inr_image⟩

private theorem MeasSet.sumLeft_onSumLeft (A : MeasSet Ω₁) :
    (A.onSumLeft (Ω₂ := Ω₂)).sumLeft = A :=
  Subtype.ext (Sum.inl_injective.preimage_image _)

private theorem MeasSet.sumRight_onSumLeft (A : MeasSet Ω₁) :
    (A.onSumLeft (Ω₂ := Ω₂)).sumRight = MeasSet.empty := Subtype.ext (by
  ext t
  simp [MeasSet.onSumLeft, MeasSet.sumRight, MeasSet.empty])

private theorem MeasSet.sumLeft_onSumRight (A : MeasSet Ω₂) :
    (A.onSumRight (Ω₁ := Ω₁)).sumLeft = MeasSet.empty := Subtype.ext (by
  ext t
  simp [MeasSet.onSumRight, MeasSet.sumLeft, MeasSet.empty])

private theorem MeasSet.sumRight_onSumRight (A : MeasSet Ω₂) :
    (A.onSumRight (Ω₁ := Ω₁)).sumRight = A :=
  Subtype.ext (Sum.inr_injective.preimage_image _)

/-- The coordinate PVM of two measurable summands. -/
def PVM.disjointSum (P : PVM Ω₁ X) (Q : PVM Ω₂ Y) : PVM (Ω₁ ⊕ Ω₂) (X × Y) where
  val E := (P.val E.sumLeft).prodMap (Q.val E.sumRight)
  empty_eq := by
    apply ContinuousLinearMap.ext
    intro z
    change (P.val MeasSet.empty z.1, Q.val MeasSet.empty z.2) = (0, 0)
    rw [P.empty_eq, Q.empty_eq, zero_apply, zero_apply]
  countably_additive := fun E hE z => by
    have h₁ : MeasSet.DisjointSeq (fun n => (E n).sumLeft) :=
      fun i j hij => (hE hij).preimage Sum.inl
    have h₂ : MeasSet.DisjointSeq (fun n => (E n).sumRight) :=
      fun i j hij => (hE hij).preimage Sum.inr
    have hL : MeasSet.iUnion (fun n => (E n).sumLeft) = (MeasSet.iUnion E).sumLeft :=
      Subtype.ext (preimage_iUnion.symm)
    have hR : MeasSet.iUnion (fun n => (E n).sumRight) = (MeasSet.iUnion E).sumRight :=
      Subtype.ext (preimage_iUnion.symm)
    have h := (P.countably_additive _ h₁ z.1).prodMk (Q.countably_additive _ h₂ z.2)
    rwa [hL, hR] at h
  normalized := by
    apply ContinuousLinearMap.ext
    intro z
    change (P.val MeasSet.whole z.1, Q.val MeasSet.whole z.2) = z
    rw [P.normalized, Q.normalized, ContinuousLinearMap.id_apply, ContinuousLinearMap.id_apply]
  mul_eq E F := by
    apply ContinuousLinearMap.ext
    intro z
    change (P.val E.sumLeft (P.val F.sumLeft z.1), Q.val E.sumRight (Q.val F.sumRight z.2)) =
      (P.val (E.sumLeft.inter F.sumLeft) z.1, Q.val (E.sumRight.inter F.sumRight) z.2)
    rw [show P.val E.sumLeft (P.val F.sumLeft z.1) = _ from DFunLike.congr_fun (P.mul_eq _ _) z.1,
      show Q.val E.sumRight (Q.val F.sumRight z.2) = _ from DFunLike.congr_fun (Q.mul_eq _ _) z.2]

theorem PVM.disjointSum_cyclicVector (P : PVM Ω₁ X) (Q : PVM Ω₂ Y) (u : X) (v : Y)
    (hu : P.CyclicVector u) (hv : Q.CyclicVector v) :
    (P.disjointSum Q).CyclicVector (u, v) := by
  let G := Set.range fun E : MeasSet (Ω₁ ⊕ Ω₂) => (P.disjointSum Q).val E (u, v)
  let C := (Submodule.span ℝ G).topologicalClosure
  have hgen (E : MeasSet (Ω₁ ⊕ Ω₂)) : (P.disjointSum Q).val E (u, v) ∈ C :=
    subset_closure (Submodule.subset_span ⟨E, rfl⟩)
  let L := ContinuousLinearMap.inl ℝ X Y
  let R := ContinuousLinearMap.inr ℝ X Y
  have hL (E : MeasSet Ω₁) : (P.val E u, 0) ∈ C := by
    have hh := hgen (E.onSumLeft (Ω₂ := Ω₂))
    change (P.val (E.onSumLeft (Ω₂ := Ω₂)).sumLeft u, Q.val (E.onSumLeft (Ω₂ := Ω₂)).sumRight v) ∈ C at hh
    rwa [MeasSet.sumLeft_onSumLeft, MeasSet.sumRight_onSumLeft, Q.empty_eq, zero_apply] at hh
  have hR (E : MeasSet Ω₂) : (0, Q.val E v) ∈ C := by
    have hh := hgen (E.onSumRight (Ω₁ := Ω₁))
    change (P.val (E.onSumRight (Ω₁ := Ω₁)).sumLeft u, Q.val (E.onSumRight (Ω₁ := Ω₁)).sumRight v) ∈ C at hh
    rwa [MeasSet.sumLeft_onSumRight, MeasSet.sumRight_onSumRight, P.empty_eq, zero_apply] at hh
  have hC : IsClosed (C : Set (X × Y)) := Submodule.isClosed_topologicalClosure _
  have hL' (x : X) : (x, 0) ∈ C := by
    apply closure_minimal (s := (Submodule.span ℝ (Set.range fun E => P.val E u) : Set X))
      (t := (C.comap L.toLinearMap : Set X)) _ (hC.preimage L.continuous) (hu x)
    apply Submodule.span_le.mpr
    rintro _ ⟨E, rfl⟩
    exact hL E
  have hR' (y : Y) : (0, y) ∈ C := by
    apply closure_minimal (s := (Submodule.span ℝ (Set.range fun E => Q.val E v) : Set Y))
      (t := (C.comap R.toLinearMap : Set Y)) _ (hC.preimage R.continuous) (hv y)
    apply Submodule.span_le.mpr
    rintro _ ⟨E, rfl⟩
    exact hR E
  intro z
  change z ∈ C
  simpa using C.add_mem (hL' z.1) (hR' z.2)

#print axioms PVM.disjointSum_cyclicVector

end DisjointSumPVM


section TransportProductReflexivity

variable {X Y : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]
    [NormedAddCommGroup Y] [NormedSpace ℝ Y]

theorem IsReflexive.of_continuousLinearEquiv (e : X ≃L[ℝ] Y) (hY : IsReflexive Y) : IsReflexive X := by
  intro ξ
  obtain ⟨y, hy⟩ := hY (secondAdjoint e.toContinuousLinearMap ξ)
  refine ⟨e.symm y, ?_⟩
  ext f
  have h := DFunLike.congr_fun hy (f.comp e.symm.toContinuousLinearMap)
  change f (e.symm y) = ξ ((f.comp e.symm.toContinuousLinearMap).comp e.toContinuousLinearMap) at h
  have heq : (f.comp e.symm.toContinuousLinearMap).comp e.toContinuousLinearMap = f := by
    ext x
    change f (e.symm (e x)) = f x
    rw [e.symm_apply_apply]
  rwa [heq] at h

theorem IsReflexive.prod (hX : IsReflexive X) (hY : IsReflexive Y) : IsReflexive (X × Y) := by
  intro ξ
  let L := ContinuousLinearMap.fst ℝ X Y
  let R := ContinuousLinearMap.snd ℝ X Y
  let eL := ContinuousLinearMap.inl ℝ X Y
  let eR := ContinuousLinearMap.inr ℝ X Y
  obtain ⟨x, hx⟩ := hX (secondAdjoint L ξ)
  obtain ⟨y, hy⟩ := hY (secondAdjoint R ξ)
  refine ⟨(x, y), ?_⟩
  ext f
  have hf : f = (f.comp eL).comp L + (f.comp eR).comp R := by
    apply ContinuousLinearMap.ext
    intro z
    change f z = f (z.1, 0) + f (0, z.2)
    rw [← map_add]
    congr
    ext <;> simp
  have hL := DFunLike.congr_fun hx (f.comp eL)
  have hR := DFunLike.congr_fun hy (f.comp eR)
  change f (x, 0) = ξ ((f.comp eL).comp L) at hL
  change f (0, y) = ξ ((f.comp eR).comp R) at hR
  rw [J_apply]
  calc
    f (x, y) = f (x, 0) + f (0, y) := by rw [← map_add]; congr <;> simp
    _ = ξ f := by rw [hL, hR, ← map_add, ← hf]

variable {Ω : Type*} [MeasurableSpace Ω]

def PVM.transportByEquiv (P : PVM Ω Y) (e : X ≃L[ℝ] Y) : PVM Ω X where
  val E := e.symm.toContinuousLinearMap.comp ((P.val E).comp e.toContinuousLinearMap)
  empty_eq := by
    apply ContinuousLinearMap.ext
    intro x
    change e.symm (P.val MeasSet.empty (e x)) = 0
    rw [P.empty_eq, zero_apply, map_zero]
  countably_additive := fun E hE x =>
    e.symm.toContinuousLinearMap.hasSum (P.countably_additive E hE (e x))
  normalized := by
    apply ContinuousLinearMap.ext
    intro x
    change e.symm (P.val MeasSet.whole (e x)) = x
    rw [P.normalized, ContinuousLinearMap.id_apply, e.symm_apply_apply]
  mul_eq E F := by
    apply ContinuousLinearMap.ext
    intro x
    change e.symm (P.val E (e (e.symm (P.val F (e x))))) = e.symm (P.val (E.inter F) (e x))
    rw [e.apply_symm_apply]
    exact congrArg e.symm (DFunLike.congr_fun (P.mul_eq E F) (e x))

theorem PVM.transportByEquiv_cyclicVector (P : PVM Ω Y) (e : X ≃L[ℝ] Y) (y : Y)
    (hy : P.CyclicVector y) : (P.transportByEquiv e).CyclicVector (e.symm y) := by
  apply P.cyclicVector_of_dense_intertwining (P.transportByEquiv e) e.symm.toContinuousLinearMap
    _ e.symm.surjective.denseRange hy
  intro E
  apply ContinuousLinearMap.ext
  intro z
  change e.symm (P.val E z) = e.symm (P.val E (e (e.symm z)))
  rw [e.apply_symm_apply]

#print axioms PVM.transportByEquiv_cyclicVector
#print axioms IsReflexive.prod

end TransportProductReflexivity



noncomputable section OrbitVariationFrameExampleConstruction

open MeasureTheory
open scoped ENNReal Classical

/-- The classical orthonormal Rademacher system and its ℓ² synthesis,
restricted to the Lebesgue probability interval. -/
structure RademacherLTwoSynthesis where
  sign : ℕ → boundedMeasurableAlgebra ℝ
  sign_abs : ∀ n t, |(sign n).1 t| = 1
  synthesis : LTwo →ₗᵢ[ℝ] WalshL2
  basis_density : ∀ n, (fun t => synthesis (lTwoUnit n) t) =ᵐ[lebesgueUnitInterval] (sign n).1
  mean_zero : ∀ x, (∫ t, synthesis x t ∂lebesgueUnitInterval) = 0

axiom citeRademacherLTwoSynthesis : Nonempty RademacherLTwoSynthesis

/-- The standard coordinate projections associated to the unconditional
unit-vector basis of ℓ² on its discrete index space. -/
axiom citeLTwoCoordinatePVM :
    TopologicalSpace.SeparableSpace LTwo ∧ ∃ Q : PVM ℕ LTwo, (∀ E x n, (Q.val E x) n = if n ∈ E.1 then x n else 0) ∧
      (∀ E, ‖Q.val E‖ ≤ 1) ∧
      ∃ v : LTwo, (∀ n, v n = (1 / 2 : ℝ) ^ n) ∧ Q.CyclicVector v

private abbrev RademacherSumSpace := WithLp 2 (WalshL2 × LTwo)

private def rademacherSumEquiv : RademacherSumSpace ≃L[ℝ] (WalshL2 × LTwo) :=
  WithLp.prodContinuousLinearEquiv 2 ℝ WalshL2 LTwo

private def RademacherLTwoSynthesis.disjointAnalysis (B : RademacherLTwoSynthesis) :
    LTwo →L[ℝ] RademacherSumSpace :=
  rademacherSumEquiv.symm.toContinuousLinearMap.comp
    (B.synthesis.toContinuousLinearMap.prod (ContinuousLinearMap.id ℝ LTwo))

private def rademacherDisjointSynthesis : RademacherSumSpace →L[ℝ] LTwo :=
  (((probabilityScalarIntegral (ρ := lebesgueUnitInterval) 2).smulRight (lTwoUnit 0)).comp
    (ContinuousLinearMap.fst ℝ WalshL2 LTwo) + ContinuousLinearMap.snd ℝ WalshL2 LTwo).comp
    rademacherSumEquiv.toContinuousLinearMap

private theorem RademacherLTwoSynthesis.disjointAnalysis_norm (B : RademacherLTwoSynthesis) :
    ‖B.disjointAnalysis‖ ≤ Real.sqrt 2 := by
  apply ContinuousLinearMap.opNorm_le_bound _ (Real.sqrt_nonneg _)
  intro x
  rw [WithLp.prod_norm_eq_of_L2]
  change Real.sqrt (‖B.synthesis x‖ ^ 2 + ‖x‖ ^ 2) ≤ _
  rw [B.synthesis.norm_map, ← two_mul, Real.sqrt_mul (by norm_num : (0 : ℝ) ≤ 2), Real.sqrt_sq (norm_nonneg _)]

private theorem add_le_sqrt_two_mul_sqrt_sq (a b : ℝ) (ha : 0 ≤ a) (hb : 0 ≤ b) :
    a + b ≤ Real.sqrt 2 * Real.sqrt (a ^ 2 + b ^ 2) := by
  rw [← Real.sqrt_mul (by norm_num : (0 : ℝ) ≤ 2), ← Real.sqrt_sq (add_nonneg ha hb)]
  apply Real.sqrt_le_sqrt
  nlinarith [sq_nonneg (a - b)]

set_option maxHeartbeats 800000 in
private theorem rademacherDisjointSynthesis_norm : ‖rademacherDisjointSynthesis‖ ≤ Real.sqrt 2 := by
  apply ContinuousLinearMap.opNorm_le_bound _ (Real.sqrt_nonneg _)
  intro z
  let h : WalshL2 := (rademacherSumEquiv z).1
  let x : LTwo := (rademacherSumEquiv z).2
  change ‖(probabilityScalarIntegral 2 h) • lTwoUnit 0 + x‖ ≤ _
  have hh : ‖(probabilityScalarIntegral 2 h) • lTwoUnit 0‖ ≤ ‖h‖ := by
    rw [norm_smul, norm_lTwoUnit, mul_one]
    exact citeProbabilityLpIntegralBound 2 h
  have he : ‖z‖ = Real.sqrt (‖h‖ ^ 2 + ‖x‖ ^ 2) := WithLp.prod_norm_eq_of_L2 z
  rw [he]
  exact (norm_add_le _ _).trans ((add_le_add hh (le_refl ‖x‖)).trans
    (add_le_sqrt_two_mul_sqrt_sq _ _ (norm_nonneg h) (norm_nonneg x)))
private def rademacherDisjointProjection (Q : PVM ℕ LTwo) :
    PVM (ℝ ⊕ ℕ) RademacherSumSpace :=
  ((FiniteSignedMeasure.probabilityLpPVM (ρ := lebesgueUnitInterval) (p := 2)
    (by norm_num)).disjointSum Q).transportByEquiv rademacherSumEquiv

private def RademacherLTwoSynthesis.disjointOperatorMeasure (B : RademacherLTwoSynthesis)
    (Q : PVM ℕ LTwo) : OVM (ℝ ⊕ ℕ) LTwo :=
  (rademacherDisjointProjection Q).compressed rademacherDisjointSynthesis B.disjointAnalysis

private theorem RademacherLTwoSynthesis.disjointOperatorMeasure_apply (B : RademacherLTwoSynthesis)
    (Q : PVM ℕ LTwo) (E : MeasSet (ℝ ⊕ ℕ)) (x : LTwo) :
    (B.disjointOperatorMeasure Q).val E x =
      (∫ t in E.sumLeft.1, B.synthesis x t ∂lebesgueUnitInterval) • lTwoUnit 0 + Q.val E.sumRight x := by
  let P := FiniteSignedMeasure.probabilityLpPVM (ρ := lebesgueUnitInterval) (p := 2) (by norm_num)
  let e := rademacherSumEquiv
  change rademacherDisjointSynthesis
      (e.symm (((P.disjointSum Q).val E) (e (e.symm (B.synthesis x, x))))) = _
  rw [e.apply_symm_apply]
  change rademacherDisjointSynthesis (e.symm (P.val E.sumLeft (B.synthesis x), Q.val E.sumRight x)) = _
  have h (z : WalshL2 × LTwo) : rademacherDisjointSynthesis (e.symm z) =
      (probabilityScalarIntegral 2 z.1) • lTwoUnit 0 + z.2 := by
    change (probabilityScalarIntegral 2 (e (e.symm z)).1) • lTwoUnit 0 + (e (e.symm z)).2 = _
    rw [e.apply_symm_apply]
  rw [h, probabilityScalarIntegral_cut 2 (by norm_num) E.sumLeft (B.synthesis x)]
private theorem RademacherLTwoSynthesis.disjointOperatorMeasure_normalized
    (B : RademacherLTwoSynthesis) (Q : PVM ℕ LTwo) :
    (B.disjointOperatorMeasure Q).Normalized := by
  apply ContinuousLinearMap.ext
  intro x
  rw [B.disjointOperatorMeasure_apply]
  change (∫ t in (univ : Set ℝ), B.synthesis x t ∂lebesgueUnitInterval) • lTwoUnit 0 +
    Q.val MeasSet.whole x = x
  rw [setIntegral_univ, B.mean_zero, zero_smul, zero_add, Q.normalized, ContinuousLinearMap.id_apply]

private theorem RademacherLTwoSynthesis.exists_reflexive_cyclic_disjoint_dilation
    (B : RademacherLTwoSynthesis) (Q : PVM ℕ LTwo) (v : LTwo) (hv : Q.CyclicVector v) :
    ∃ D : Dilation (B.disjointOperatorMeasure Q) RademacherSumSpace,
      IsReflexive RademacherSumSpace ∧ D.P.Cyclic ∧ ‖D.T‖ ≤ Real.sqrt 2 ∧ ‖D.S‖ ≤ Real.sqrt 2 := by
  let P := FiniteSignedMeasure.probabilityLpPVM (ρ := lebesgueUnitInterval) (p := 2) (by norm_num)
  let D : Dilation (B.disjointOperatorMeasure Q) RademacherSumSpace :=
    { P := rademacherDisjointProjection Q
      T := B.disjointAnalysis
      S := rademacherDisjointSynthesis
      compress := fun _ => rfl
      split := by
        rw [← B.disjointOperatorMeasure_normalized Q]
        rw [show (B.disjointOperatorMeasure Q).val MeasSet.whole =
          rademacherDisjointSynthesis.comp ((rademacherDisjointProjection Q).val MeasSet.whole |>.comp B.disjointAnalysis)
          from rfl, (rademacherDisjointProjection Q).normalized, ContinuousLinearMap.id_comp] }
  have hL : IsReflexive WalshL2 := citeProbabilityLpReflexive 2 (by norm_num) (by norm_num)
  have hcyc := P.disjointSum_cyclicVector Q (probabilityScalarOne (ρ := lebesgueUnitInterval) 2) v
    (probabilityScalarOne_cyclic 2 (by norm_num)) hv
  exact ⟨D, IsReflexive.of_continuousLinearEquiv rademacherSumEquiv (hL.prod citeLTwoHilbertDuality),
    ⟨_, (P.disjointSum Q).transportByEquiv_cyclicVector rademacherSumEquiv _ hcyc⟩,
    B.disjointAnalysis_norm, rademacherDisjointSynthesis_norm⟩

#print axioms RademacherLTwoSynthesis.disjointOperatorMeasure_apply
#print axioms RademacherLTwoSynthesis.exists_reflexive_cyclic_disjoint_dilation




private theorem disjoint_image_injective {α β : Type*} (f : α → β) (hf : Function.Injective f)
    {A B : Set α} (hd : Disjoint A B) : Disjoint (f '' A) (f '' B) := by
  apply Set.disjoint_left.mpr
  rintro _ ⟨a, ha, rfl⟩ ⟨b, hb, he⟩
  exact Set.disjoint_left.mp hd ha (hf he ▸ hb)

private def RademacherLTwoSynthesis.leftOperatorMeasure (B : RademacherLTwoSynthesis) : OVM ℝ LTwo :=
  (FiniteSignedMeasure.probabilityLpPVM (ρ := lebesgueUnitInterval) (p := 2) (by norm_num)).compressed
    ((probabilityScalarIntegral 2).smulRight (lTwoUnit 0)) B.synthesis.toContinuousLinearMap

private theorem RademacherLTwoSynthesis.leftOperatorMeasure_onLeft (B : RademacherLTwoSynthesis)
    (Q : PVM ℕ LTwo) (E : MeasSet ℝ) :
    (B.disjointOperatorMeasure Q).val (E.onSumLeft (Ω₂ := ℕ)) = B.leftOperatorMeasure.val E := by
  apply ContinuousLinearMap.ext
  intro x
  rw [B.disjointOperatorMeasure_apply, MeasSet.sumLeft_onSumLeft, MeasSet.sumRight_onSumLeft,
    Q.empty_eq, zero_apply, add_zero]
  change _ = (probabilityScalarIntegral 2
    ((FiniteSignedMeasure.probabilityLpPVM (ρ := lebesgueUnitInterval) (p := 2) (by norm_num)).val E
      (B.synthesis x))) • lTwoUnit 0
  rw [probabilityScalarIntegral_cut 2 (by norm_num) E (B.synthesis x)]

private theorem RademacherLTwoSynthesis.leftVariation_le (B : RademacherLTwoSynthesis)
    (Q : PVM ℕ LTwo) (E : MeasSet ℝ) :
    B.leftOperatorMeasure.operatorVariation E ≤
      (B.disjointOperatorMeasure Q).operatorVariation (E.onSumLeft (Ω₂ := ℕ)) := by
  apply sSup_le
  rintro _ ⟨C, I, hd, hc, rfl⟩
  let A (i : ℕ) := (C i).onSumLeft (Ω₂ := ℕ)
  have eA : MeasSet.finiteUnion A I = E.onSumLeft (Ω₂ := ℕ) := by
    apply Subtype.ext
    change (⋃ i ∈ I, Sum.inl '' (C i).1) = Sum.inl '' E.1
    simp_rw [← image_iUnion]
    exact congrArg (fun C₀ : MeasSet ℝ => Sum.inl '' C₀.1) hc
  have hdA : (↑I : Set ℕ).Pairwise (fun i j => Disjoint (A i).1 (A j).1) :=
    fun i hi j hj hij => disjoint_image_injective Sum.inl Sum.inl_injective (hd hi hj hij)
  have hh : (∑ i ∈ I, ENNReal.ofReal ‖(B.disjointOperatorMeasure Q).val (A i)‖) ≤
      (B.disjointOperatorMeasure Q).operatorVariation (E.onSumLeft (Ω₂ := ℕ)) :=
    le_sSup ⟨A, I, hdA, eA, rfl⟩
  simpa only [A, B.leftOperatorMeasure_onLeft] using hh

private def LTwo.initialCut (Q : PVM ℕ LTwo) (N : ℕ) : LTwo →L[ℝ] LTwo :=
  Q.val ⟨(↑(Finset.range N) : Set ℕ), MeasurableSet.of_discrete⟩

private theorem LTwo.initialCut_apply (Q : PVM ℕ LTwo)
    (hQ : ∀ E x n, (Q.val E x) n = if n ∈ E.1 then x n else 0)
    (N : ℕ) (x : LTwo) : LTwo.initialCut Q N x = ∑ j ∈ Finset.range N, x j • lTwoUnit j := by
  apply Subtype.ext
  funext i
  change (Q.val _ x) i = _
  rw [hQ]
  have he (j : ℕ) : ((x j • lTwoUnit j : LTwo) i) = if i = j then x i else 0 := by
    simp only [lp.coeFn_smul, Pi.smul_apply, lTwoUnit_apply, smul_eq_mul]
    split <;> simp_all
  have hs : ((∑ j ∈ Finset.range N, x j • lTwoUnit j : LTwo) i) =
      ∑ j ∈ Finset.range N, if i = j then x i else 0 := by
    simp only [lp.coeFn_sum, Finset.sum_apply, he]
  rw [hs, Finset.sum_ite_eq]
  by_cases h : i ∈ Finset.range N
  · rw [ite_eq_left (show i ∈ (↑(Finset.range N) : Set ℕ) from h), ite_eq_left h]
  · rw [ite_eq_right (show i ∉ (↑(Finset.range N) : Set ℕ) from h), ite_eq_right h]

private def RademacherLTwoSynthesis.truncatedDensity (B : RademacherLTwoSynthesis) (N : ℕ)
    (t : ℝ) : LTwo →L[ℝ] LTwo :=
  ∑ j ∈ Finset.range N, (B.sign j).1 t • (lTwoCoordinate j).smulRight (lTwoUnit 0)

private theorem RademacherLTwoSynthesis.sign_integrable (B : RademacherLTwoSynthesis) (j : ℕ) :
    Integrable (B.sign j).1 lebesgueUnitInterval := by
  apply (integrable_const (1 : ℝ)).mono' (B.sign j).2.aestronglyMeasurable
  exact Eventually.of_forall fun t => by rw [Real.norm_eq_abs, B.sign_abs]

private theorem RademacherLTwoSynthesis.truncatedDensity_integrable (B : RademacherLTwoSynthesis) (N : ℕ) :
    Integrable (B.truncatedDensity N) lebesgueUnitInterval :=
  integrable_finsetSum _ fun j _ => (B.sign_integrable j).smul_const _

private theorem RademacherLTwoSynthesis.truncatedDensity_norm (B : RademacherLTwoSynthesis) (N : ℕ) (t : ℝ) :
    ‖B.truncatedDensity N t‖ = Real.sqrt N := by
  let f : Dual LTwo := ∑ j ∈ Finset.range N, (B.sign j).1 t • lTwoCoordinate j
  have hF : B.truncatedDensity N t = f.smulRight (lTwoUnit 0) := by
    apply ContinuousLinearMap.ext
    intro x
    change (∑ j ∈ Finset.range N, (B.sign j).1 t • (lTwoCoordinate j).smulRight (lTwoUnit 0)) x =
      f x • lTwoUnit 0
    simp only [f, sum_apply, smul_apply, ContinuousLinearMap.smulRight_apply, smul_smul, smul_eq_mul,
      Finset.sum_smul]
  rw [hF, ContinuousLinearMap.norm_smulRight_apply, norm_lTwoUnit, mul_one]
  obtain ⟨R, hR⟩ := citeLTwoRieszCoordinate
  have hunit (j : ℕ) : R (lTwoCoordinate j) = lTwoUnit j := by
    apply Subtype.ext
    funext i
    change R (lTwoCoordinate j) i = lTwoUnit j i
    rw [hR, lTwoCoordinate_apply, lTwoUnit_apply, lTwoUnit_apply]
    by_cases h : i = j <;> simp_all [eq_comm]
  rw [← R.norm_map]
  have hRf : R f = ∑ j ∈ Finset.range N, lp.single 2 j ((B.sign j).1 t) := by
    simp only [f, map_sum, map_smul, hunit, lp_two_single_real_smul]
  rw [hRf]
  have hN := lp.norm_sum_single (p := 2) (by norm_num)
    (fun j => (B.sign j).1 t) (Finset.range N)
  have hsq : ‖∑ j ∈ Finset.range N, (lp.single 2 j ((B.sign j).1 t) : LTwo)‖ ^ 2 = (N : ℝ) := by
    simpa [Real.rpow_two, Real.norm_eq_abs, B.sign_abs] using hN
  nlinarith [norm_nonneg (∑ j ∈ Finset.range N, (lp.single 2 j ((B.sign j).1 t) : LTwo)),
    Real.sqrt_nonneg (N : ℝ), Real.sq_sqrt (by positivity : 0 ≤ (N : ℝ))]

private theorem RademacherLTwoSynthesis.truncatedDensity_cut (B : RademacherLTwoSynthesis)
    (Q : PVM ℕ LTwo) (hQ : ∀ E x n, (Q.val E x) n = if n ∈ E.1 then x n else 0)
    (N : ℕ) (E : MeasSet ℝ) :
    (B.leftOperatorMeasure.val E).comp (LTwo.initialCut Q N) =
      ∫ t in E.1, B.truncatedDensity N t ∂lebesgueUnitInterval := by
  have hL (j : ℕ) : B.leftOperatorMeasure.val E (lTwoUnit j) =
      (∫ t in E.1, (B.sign j).1 t ∂lebesgueUnitInterval) • lTwoUnit 0 := by
    change (probabilityScalarIntegral 2
      ((FiniteSignedMeasure.probabilityLpPVM (ρ := lebesgueUnitInterval) (p := 2)
        (by norm_num)).val E (B.synthesis (lTwoUnit j)))) • lTwoUnit 0 = _
    rw [probabilityScalarIntegral_cut]
    exact congrArg (fun a : ℝ => a • lTwoUnit 0)
      (integral_congr_ae (ae_restrict_of_ae (B.basis_density j)))
  have hD : (∫ t in E.1, B.truncatedDensity N t ∂lebesgueUnitInterval) =
      ∑ j ∈ Finset.range N, (∫ t in E.1, (B.sign j).1 t ∂lebesgueUnitInterval) •
        (lTwoCoordinate j).smulRight (lTwoUnit 0) := by
    change (∫ t in E.1, ∑ j ∈ Finset.range N, (B.sign j).1 t •
      (lTwoCoordinate j).smulRight (lTwoUnit 0) ∂lebesgueUnitInterval) = _
    rw [integral_finsetSum (Finset.range N) (fun j _ => ((B.sign_integrable j).smul_const _).restrict)]
    simp only [integral_smul_const]
  rw [hD]
  apply ContinuousLinearMap.ext
  intro x
  change B.leftOperatorMeasure.val E (LTwo.initialCut Q N x) = _
  rw [LTwo.initialCut_apply Q hQ, map_sum, sum_apply]
  simp only [map_smul, hL, smul_apply, ContinuousLinearMap.smulRight_apply, lTwoCoordinate_apply, smul_smul]
  exact Finset.sum_congr rfl (fun j _ => by rw [mul_comm])

private theorem RademacherLTwoSynthesis.operatorVariation_lower (B : RademacherLTwoSynthesis)
    (Q : PVM ℕ LTwo) (hQ : ∀ E x n, (Q.val E x) n = if n ∈ E.1 then x n else 0)
    (hNorm : ∀ E, ‖Q.val E‖ ≤ 1) (N : ℕ) (E : MeasSet ℝ) :
    ENNReal.ofReal (Real.sqrt N * (lebesgueUnitInterval E.1).toReal) ≤
      (B.disjointOperatorMeasure Q).operatorVariation (E.onSumLeft (Ω₂ := ℕ)) := by
  apply le_trans _ (B.leftVariation_le Q E)
  have hv := citeBochnerDensityVariation lebesgueUnitInterval (B.truncatedDensity N)
    (B.truncatedDensity_integrable N) E
  simp_rw [B.truncatedDensity_norm] at hv
  rw [setIntegral_const, smul_eq_mul, mul_comm] at hv
  change _ = ENNReal.ofReal (Real.sqrt N * (lebesgueUnitInterval E.1).toReal) at hv
  rw [← hv]
  apply sSup_le
  rintro _ ⟨C, I, hc, he, rfl⟩
  simp_rw [← B.truncatedDensity_cut Q hQ]
  have hb : ‖LTwo.initialCut Q N‖ ≤ 1 := hNorm _
  have hsum : (∑ j ∈ I, ‖(B.leftOperatorMeasure.val (C j)).comp (LTwo.initialCut Q N)‖) ≤
      ∑ j ∈ I, ‖B.leftOperatorMeasure.val (C j)‖ := Finset.sum_le_sum fun j _ =>
    ((B.leftOperatorMeasure.val (C j)).opNorm_comp_le _).trans (by
      simpa only [mul_one] using mul_le_mul_of_nonneg_left hb (norm_nonneg _))
  apply (ENNReal.ofReal_le_ofReal hsum).trans
  rw [ENNReal.ofReal_sum_of_nonneg fun _ _ => norm_nonneg _]
  exact le_sSup ⟨C, I, hc, he, rfl⟩

#print axioms RademacherLTwoSynthesis.operatorVariation_lower



private def rademacherFrameExamplePartition : ℕ → MeasSet (ℝ ⊕ ℕ)
  | 0 => (MeasSet.whole : MeasSet ℝ).onSumLeft
  | n + 1 => (MeasSet.natAtom n).onSumRight

private theorem rademacherFrameExamplePartition_disjoint : MeasSet.DisjointSeq rademacherFrameExamplePartition := by
  intro i j hij
  cases i <;> cases j
  · exact (hij rfl).elim
  · exact Set.disjoint_left.mpr (by rintro _ ⟨a, _, rfl⟩ ⟨b, _, hb⟩; cases hb)
  · exact Set.disjoint_left.mpr (by rintro _ ⟨a, _, rfl⟩ ⟨b, _, hb⟩; cases hb)
  · exact (disjoint_image_injective Sum.inr Sum.inr_injective (disjoint_singleton.mpr
      (fun h => hij (congrArg Nat.succ h))))

private theorem rademacherFrameExamplePartition_cover :
    MeasSet.iUnion rademacherFrameExamplePartition = MeasSet.whole := by
  apply Subtype.ext
  apply eq_univ_of_forall
  rintro (a | b)
  · exact mem_iUnion.mpr ⟨0, a, mem_univ _, rfl⟩
  · exact mem_iUnion.mpr ⟨b + 1, b, mem_singleton _, rfl⟩

private theorem RademacherLTwoSynthesis.disjointOrbitVariation_left_finite
    (B : RademacherLTwoSynthesis) (Q : PVM ℕ LTwo) (x : LTwo) :
    (B.disjointOperatorMeasure Q).orbitVariation x
      ((MeasSet.whole : MeasSet ℝ).onSumLeft (Ω₂ := ℕ)) =
      ENNReal.ofReal (∫ t, |B.synthesis x t| ∂lebesgueUnitInterval) := by
  let A := (MeasSet.whole : MeasSet ℝ).onSumLeft (Ω₂ := ℕ)
  let f (t : ℝ) := B.synthesis x t
  have hf : Integrable f lebesgueUnitInterval := integrable_probabilityLp (B.synthesis x)
  have hv := citeBochnerDensityVariation lebesgueUnitInterval f hf (MeasSet.whole : MeasSet ℝ)
  have ev (D : MeasSet (ℝ ⊕ ℕ)) (hD : D.1 ⊆ A.1) :
      ‖(B.disjointOperatorMeasure Q).val D x‖ = ‖∫ t in D.sumLeft.1, f t ∂lebesgueUnitInterval‖ := by
    have hr : D.sumRight = MeasSet.empty := Subtype.ext (eq_empty_iff_forall_notMem.mpr fun t ht => by
      obtain ⟨a, _, he⟩ := hD ht
      cases he)
    rw [B.disjointOperatorMeasure_apply, hr, Q.empty_eq, zero_apply, add_zero, norm_smul, norm_lTwoUnit, mul_one]
  have eqV : (B.disjointOperatorMeasure Q).orbitVariation x A =
      sSup {r | ∃ (D : ℕ → MeasSet ℝ) (I : Finset ℕ),
      (↑I : Set ℕ).Pairwise (fun i j => Disjoint (D i).1 (D j).1) ∧
      MeasSet.finiteUnion D I = MeasSet.whole ∧
      r = ENNReal.ofReal (∑ i ∈ I, ‖∫ t in (D i).1, f t ∂lebesgueUnitInterval‖)} := by
    apply le_antisymm
    · apply sSup_le
      rintro _ ⟨D, I, hd, hI, rfl⟩
      have hsub (i : ℕ) (hi : i ∈ I) : (D i).1 ⊆ A.1 := fun _ ht =>
        hI ▸ mem_iUnion₂.mpr ⟨i, hi, ht⟩
      have hUnion : MeasSet.finiteUnion (fun i => (D i).sumLeft) I = MeasSet.whole := by
        have he := congrArg MeasSet.sumLeft hI
        rw [MeasSet.sumLeft_onSumLeft] at he
        apply Subtype.ext
        change (⋃ i ∈ I, Sum.inl ⁻¹' (D i).1) = univ
        simp_rw [← preimage_iUnion]
        exact congrArg Subtype.val he
      refine le_sSup ⟨fun i => (D i).sumLeft, I, fun i hi j hj hij => (hd hi hj hij).preimage Sum.inl, hUnion, ?_⟩
      apply congrArg ENNReal.ofReal
      exact Finset.sum_congr rfl (fun i hi => ev (D i) (hsub i hi))
    · apply sSup_le
      rintro _ ⟨D, I, hd, hI, rfl⟩
      let C (i : ℕ) := (D i).onSumLeft (Ω₂ := ℕ)
      have hUnion : MeasSet.finiteUnion C I = A := by
        apply Subtype.ext
        change (⋃ i ∈ I, Sum.inl '' (D i).1) = Sum.inl '' (univ : Set ℝ)
        simp_rw [← image_iUnion]
        exact congrArg (fun s : MeasSet ℝ => Sum.inl '' s.1) hI
      refine le_sSup ⟨C, I, fun i hi j hj hij => disjoint_image_injective Sum.inl Sum.inl_injective (hd hi hj hij), hUnion, ?_⟩
      apply congrArg ENNReal.ofReal
      apply Finset.sum_congr rfl
      intro i hi
      have he : (C i).1 ⊆ A.1 := fun _ ht => hUnion ▸ mem_iUnion₂.mpr ⟨i, hi, ht⟩
      rw [ev (C i) he, show (C i).sumLeft = D i from (D i).sumLeft_onSumLeft]
  rw [eqV, hv, MeasSet.whole, setIntegral_univ]
  rfl

private theorem OVM.orbitVariation_eq_of_singleton_set
    {Ω : Type*} [MeasurableSpace Ω] {Y : Type*} [NormedAddCommGroup Y] [NormedSpace ℝ Y]
    (μ : OVM Ω Y) (x : Y) (A : MeasSet Ω) {t : Ω} (hA : A.1 = {t}) :
    μ.orbitVariation x A = ENNReal.ofReal ‖μ.val A x‖ := by
  apply le_antisymm
  · apply sSup_le
    rintro _ ⟨D, I, hD, hI, rfl⟩
    have ht : t ∈ (MeasSet.finiteUnion D I).1 := by rw [hI, hA]; exact mem_singleton _
    obtain ⟨k, hk, htk⟩ := mem_iUnion₂.mp ht
    have hsub (i : ℕ) (hi : i ∈ I) : (D i).1 ⊆ A.1 := fun _ ht =>
      hI ▸ mem_iUnion₂.mpr ⟨i, hi, ht⟩
    have hk' : D k = A := Subtype.ext ((hsub k hk).antisymm (by rw [hA]; exact singleton_subset_iff.mpr htk))
    rw [Finset.sum_eq_single_of_mem k hk, hk']
    intro j hj hjk
    have he : D j = MeasSet.empty := Subtype.ext (eq_empty_iff_forall_notMem.mpr fun s hs => by
      have hm := hsub j hj hs
      rw [hA] at hm
      have h : s = t := hm
      exact Set.disjoint_left.mp (hD hj hk hjk) hs (h ▸ htk))
    rw [he, μ.empty_eq, zero_apply, norm_zero]
  · apply le_sSup
    refine ⟨fun _ => A, {0}, by simp, ?_, by simp⟩
    apply Subtype.ext
    change (⋃ i ∈ ({0} : Finset ℕ), A.1) = A.1
    simp

private theorem RademacherLTwoSynthesis.localOrbitVariation_on_disjointPartition
    (B : RademacherLTwoSynthesis) (Q : PVM ℕ LTwo) (n : ℕ) (x : LTwo) :
    (B.disjointOperatorMeasure Q).orbitVariation x (rademacherFrameExamplePartition n) < ⊤ := by
  cases n with
  | zero =>
    rw [rademacherFrameExamplePartition, B.disjointOrbitVariation_left_finite]
    exact ENNReal.ofReal_lt_top
  | succ n =>
    rw [rademacherFrameExamplePartition, OVM.orbitVariation_eq_of_singleton_set
      (t := Sum.inr n) _ _ _ (by change Sum.inr '' ({n} : Set ℕ) = _; simp)]
    exact ENNReal.ofReal_lt_top

private theorem RademacherLTwoSynthesis.operatorVariation_top_on_pos_left
    (B : RademacherLTwoSynthesis) (Q : PVM ℕ LTwo)
    (hQ : ∀ E x n, (Q.val E x) n = if n ∈ E.1 then x n else 0)
    (hNorm : ∀ E, ‖Q.val E‖ ≤ 1) (E : MeasSet ℝ) (hE : 0 < lebesgueUnitInterval E.1) :
    (B.disjointOperatorMeasure Q).operatorVariation (E.onSumLeft (Ω₂ := ℕ)) = ⊤ := by
  by_contra hn
  let c := ((B.disjointOperatorMeasure Q).operatorVariation (E.onSumLeft (Ω₂ := ℕ))).toReal
  let m := (lebesgueUnitInterval E.1).toReal
  have hm : 0 < m := ENNReal.toReal_pos hE.ne' (measure_ne_top _ _)
  obtain ⟨N, hN⟩ := exists_nat_gt ((c / m) ^ 2)
  have h := ENNReal.toReal_mono hn (B.operatorVariation_lower Q hQ hNorm N E)
  rw [ENNReal.toReal_ofReal (by positivity)] at h
  change Real.sqrt N * m ≤ c at h
  have hs := pow_le_pow_left₀ (Real.sqrt_nonneg (N : ℝ)) ((le_div_iff₀ hm).mpr h) 2
  rw [Real.sq_sqrt (by positivity)] at hs
  exact (not_lt_of_ge hs) hN

private theorem RademacherLTwoSynthesis.operatorVariation_not_sigmaFinite
    (B : RademacherLTwoSynthesis) (Q : PVM ℕ LTwo)
    (hQ : ∀ E x n, (Q.val E x) n = if n ∈ E.1 then x n else 0)
    (hNorm : ∀ E, ‖Q.val E‖ ≤ 1) :
    ¬ SigmaFinite (B.disjointOperatorMeasure Q).operatorVariationMeasure := by
  intro h
  let _ := h
  obtain ⟨E, _, hc, hf⟩ := (B.disjointOperatorMeasure Q).exists_operatorVariation_partition
  have hl : (⋃ n, (E n).sumLeft.1) = univ := by
    change (⋃ n, Sum.inl ⁻¹' (E n).1) = univ
    have he := congrArg (fun D : MeasSet (ℝ ⊕ ℕ) => Sum.inl ⁻¹' D.1) hc
    simpa only [MeasSet.iUnion, preimage_iUnion, MeasSet.whole, preimage_univ] using he
  have hp : ∃ n, 0 < lebesgueUnitInterval (E n).sumLeft.1 := by
    by_contra hh
    push Not at hh
    have h₀ : lebesgueUnitInterval (⋃ n, (E n).sumLeft.1) = 0 :=
      measure_iUnion_null fun n => le_zero_iff.mp (hh n)
    simp [hl] at h₀
  obtain ⟨n, hn⟩ := hp
  have hz := B.operatorVariation_top_on_pos_left Q hQ hNorm (E n).sumLeft hn
  have hSub : ((E n).sumLeft.onSumLeft (Ω₂ := ℕ)).1 ⊆ (E n).1 := by
    rintro _ ⟨a, ha, rfl⟩
    exact ha
  have he := (B.disjointOperatorMeasure Q).operatorVariation_mono hSub
  rw [hz] at he
  exact (hf n).not_ge he

private theorem RademacherLTwoSynthesis.no_continuous_frame_disjoint
    (B : RademacherLTwoSynthesis) (Q : PVM ℕ LTwo)
    (hQ : ∀ E x n, (Q.val E x) n = if n ∈ E.1 then x n else 0)
    (hNorm : ∀ E, ‖Q.val E‖ ≤ 1) :
    ¬ ∃ ρ : Measure (ℝ ⊕ ℕ), SigmaFinite ρ ∧
      ∃ F : ContinuousSchauderFrame (X := LTwo) ρ, F.operatorMeasure = B.disjointOperatorMeasure Q := by
  rintro ⟨ρ, hρ, F, hF⟩
  let _ := hρ
  apply B.operatorVariation_not_sigmaFinite Q hQ hNorm
  rw [← hF]
  let _ := citeLTwoCoordinatePVM.1
  exact F.operatorVariation_sigmaFinite

