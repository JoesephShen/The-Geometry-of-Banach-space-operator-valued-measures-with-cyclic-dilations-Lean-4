/-- The even part for homogeneous ReLU synthesis, with all sphere directions retained. -/
def homogeneousEven (d : ℕ) :
    FiniteSignedMeasure (BarronSphere d) →ₗ[ℝ] FiniteSignedMeasure (BarronSphere d) :=
  (1 / 2 : ℝ) • (LinearMap.id + (pushforward (reflection d)).toLinearMap)

/-- Half of the homogeneous first moment. -/
def homogeneousMoments (d : ℕ) :
    FiniteSignedMeasure (BarronSphere d) →ₗ[ℝ] ((Fin d → ℝ) × ℝ) :=
  (1 / 2 : ℝ) •
    ((LinearMap.pi fun i => (signedIntegral (weightSymbol i)).toLinearMap).prod
      (signedIntegral (biasSymbol d)).toLinearMap)

/-- The signed difference of the two atoms in each coordinate direction. -/
def homogeneousAtoms (d : ℕ) : ((Fin d → ℝ) × ℝ) →ₗ[ℝ] FiniteSignedMeasure (BarronSphere d) :=
  affineAtoms d -
    (LinearMap.snd ℝ (Fin d → ℝ) ℝ).smulRight (pointMass (poleMinus d))

theorem homogeneousEven_fixed (μ : FiniteSignedMeasure (BarronSphere d)) :
    homogeneousEven d (homogeneousEven d μ) = homogeneousEven d μ ∧
      pushforward (reflection d) (homogeneousEven d μ) = homogeneousEven d μ := by
  let P := (pushforward (reflection d)).toLinearMap
  have hP : P (P μ) = μ :=
    pushforward_involutive (reflection d) (reflection_involutive d) μ
  have he : P ((1 / 2 : ℝ) • (μ + P μ)) = (1 / 2 : ℝ) • (μ + P μ) := by
    rw [map_smul, map_add, hP, add_comm (P μ) μ]
  refine ⟨?_, he⟩
  change (1 / 2 : ℝ) • ((1 / 2 : ℝ) • (μ + P μ) + P ((1 / 2 : ℝ) • (μ + P μ))) =
    (1 / 2 : ℝ) • (μ + P μ)
  rw [he, ← two_smul ℝ _, smul_smul]
  norm_num

theorem homogeneousSynthesis_even_decomposition (μ : FiniteSignedMeasure (BarronSphere d))
    (x : Fin d → ℝ) (t : ℝ) :
    homogeneousSynthesis μ x t =
      homogeneousSynthesis (homogeneousEven d μ) x t +
        (∑ i, (homogeneousMoments d μ).1 i * x i) + (homogeneousMoments d μ).2 * t := by
  let I := (signedIntegral (ridgeSymbol x t)).toLinearMap
  let r := reflection d
  have hR := signedIntegral_pushforward r (ridgeSymbol x t) (ridgeSymbol (-x) (-t))
    (fun θ => (reflect_ridge x t θ).symm) μ
  have hI : homogeneousSynthesis (homogeneousEven d μ) x t =
      (1 / 2 : ℝ) * (homogeneousSynthesis μ x t + homogeneousSynthesis μ (-x) (-t)) := by
    change I ((1 / 2 : ℝ) • (μ + pushforward r μ)) = _
    rw [map_smul, map_add]
    change (1 / 2 : ℝ) * (homogeneousSynthesis μ x t + signedIntegral (ridgeSymbol x t) (pushforward r μ)) = _
    rw [hR]
    rfl
  rw [hI]
  have hD := homogeneousSynthesis_difference μ x t
  change homogeneousSynthesis μ x t =
    (1 / 2 : ℝ) * (homogeneousSynthesis μ x t + homogeneousSynthesis μ (-x) (-t)) +
    (∑ i, (1 / 2 : ℝ) * signedIntegral (weightSymbol i) μ * x i) +
      (1 / 2 : ℝ) * signedIntegral (biasSymbol d) μ * t
  simp_rw [mul_assoc, ← Finset.mul_sum]
  linarith

theorem homogeneousSynthesis_atoms (a : (Fin d → ℝ) × ℝ)
    (x : Fin d → ℝ) (t : ℝ) :
    homogeneousSynthesis (homogeneousAtoms d a) x t = (∑ i, a.1 i * x i) + a.2 * t := by
  let I := (signedIntegral (ridgeSymbol x t)).toLinearMap
  have hAxis (i : Fin d) : I (pointMass (axis i) - pointMass (axisMinus i)) = x i := by
    rw [show I (pointMass (axis i) - pointMass (axisMinus i)) =
      I (pointMass (axis i)) - I (pointMass (axisMinus i)) from map_sub I _ _]
    change signedIntegral (ridgeSymbol x t) (pointMass (axis i)) -
      signedIntegral (ridgeSymbol x t) (pointMass (axisMinus i)) = x i
    rw [signedIntegral_pointMass, signedIntegral_pointMass]
    change max (linearForm x t (axis i)) 0 - max (linearForm x t (reflection d (axis i))) 0 = x i
    rw [linearForm_reflection, linearForm_axis, max_sub_max_neg]
  have hp : I (pointMass (polePlus d)) = max t 0 := by
    change signedIntegral (ridgeSymbol x t) (pointMass (polePlus d)) = _
    rw [signedIntegral_pointMass]
    change max (linearForm x t (polePlus d)) 0 = _
    rw [linearForm_polePlus]
  have hn : I (pointMass (poleMinus d)) = max (-t) 0 := by
    change signedIntegral (ridgeSymbol x t) (pointMass (poleMinus d)) = _
    rw [signedIntegral_pointMass]
    change max (linearForm x t (poleMinus d)) 0 = _
    rw [linearForm_poleMinus]
  change I (affineAtoms d a - a.2 • pointMass (poleMinus d)) = _
  rw [show I (affineAtoms d a - a.2 • pointMass (poleMinus d)) =
      I (affineAtoms d a) - I (a.2 • pointMass (poleMinus d)) from map_sub I _ _,
    affineAtoms_apply, map_add, map_sum, map_smul]
  simp only [map_smul, hAxis, hp, hn, smul_eq_mul]
  rw [add_sub_assoc, ← mul_sub, max_sub_max_neg]

/-- Canonical projection for positively homogeneous Barron functions. -/
def homogeneousProjection (d : ℕ) :
    FiniteSignedMeasure (BarronSphere d) →ₗ[ℝ] FiniteSignedMeasure (BarronSphere d) :=
  homogeneousEven d + (homogeneousAtoms d).comp (homogeneousMoments d)

theorem homogeneousSynthesis_projection (μ : FiniteSignedMeasure (BarronSphere d))
    (x : Fin d → ℝ) (t : ℝ) :
    homogeneousSynthesis (homogeneousProjection d μ) x t = homogeneousSynthesis μ x t := by
  let I := (signedIntegral (ridgeSymbol x t)).toLinearMap
  change I (homogeneousEven d μ + homogeneousAtoms d (homogeneousMoments d μ)) = _
  rw [map_add]
  change homogeneousSynthesis (homogeneousEven d μ) x t +
    homogeneousSynthesis (homogeneousAtoms d (homogeneousMoments d μ)) x t = _
  rw [homogeneousSynthesis_atoms, ← add_assoc, ← homogeneousSynthesis_even_decomposition]

theorem homogeneousProjection_kernel (hd : 1 ≤ d) (μ : FiniteSignedMeasure (BarronSphere d)) :
    homogeneousProjection d μ = 0 ↔ ∀ (x : Fin d → ℝ) (t : ℝ), homogeneousSynthesis μ x t = 0 := by
  constructor
  · intro h x t
    rw [← homogeneousSynthesis_projection, h]
    exact map_zero (signedIntegral (ridgeSymbol x t)).toLinearMap
  · intro h
    obtain ⟨he, hm, hb⟩ := (citeEWojtowytschHomogeneousKernel d hd μ).mp h
    have hC : homogeneousEven d μ = 0 := by
      change (1 / 2 : ℝ) • (μ + pushforward (reflection d) μ) = 0
      rw [he, add_neg_cancel, smul_zero]
    have hA : homogeneousMoments d μ = 0 := by
      change ((1 / 2 : ℝ) • ((fun i => signedIntegral (weightSymbol i) μ),
        signedIntegral (biasSymbol d) μ)) = 0
      have hz : ((fun i => signedIntegral (weightSymbol i) μ), signedIntegral (biasSymbol d) μ) =
          (0 : (Fin d → ℝ) × ℝ) := Prod.ext (funext hm) hb
      rw [hz, smul_zero]
    change homogeneousEven d μ + homogeneousAtoms d (homogeneousMoments d μ) = 0
    rw [hA, hC, map_zero, zero_add]


theorem homogeneousProjection_idempotent (hd : 1 ≤ d)
    (μ : FiniteSignedMeasure (BarronSphere d)) :
    homogeneousProjection d (homogeneousProjection d μ) = homogeneousProjection d μ := by
  have h := (homogeneousProjection_kernel hd (homogeneousProjection d μ - μ)).mpr (fun x t => by
    let I := (signedIntegral (ridgeSymbol x t)).toLinearMap
    change I (homogeneousProjection d μ - μ) = 0
    rw [show I (homogeneousProjection d μ - μ) = I (homogeneousProjection d μ) - I μ
      from map_sub I _ _]
    exact sub_eq_zero.mpr (homogeneousSynthesis_projection μ x t))
  exact sub_eq_zero.mp ((map_sub (homogeneousProjection d) _ _).symm.trans h)

