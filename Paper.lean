open MeasureTheory
open scoped ENNReal

abbrev LTwo := lp (fun _ : ℕ => ℝ) (2 : ℝ≥0∞)

private def lTwoUnit (n : ℕ) : LTwo := lp.single 2 n 1

private def lTwoCoordinate (n : ℕ) : Dual LTwo :=
  LinearMap.mkContinuous
    { toFun := fun x => x n
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl } 1 (fun x => by
        rw [one_mul]
        exact lp.norm_apply_le_norm (by norm_num : (2 : ℝ≥0∞) ≠ 0) x n)

private theorem norm_lTwoCoordinate_le (n : ℕ) : ‖lTwoCoordinate n‖ ≤ 1 :=
  LinearMap.mkContinuous_norm_le _ zero_le_one _

private theorem norm_lTwoUnit (n : ℕ) : ‖lTwoUnit n‖ = 1 := by
  simp [lTwoUnit, lp.norm_single]

/-- Real Hilbert space duality for ℓ² via its coordinate pairing. -/
axiom citeLTwoHilbertDuality : IsReflexive LTwo

/-- The elementary Hilbertian identification of a tensor of two ℓ²
vectors with a square summable array of coordinate products. -/
axiom citeLTwoProductCoordinates
    (I : Type) (i j : I → ℕ) (h : Function.Injective fun q => (i q, j q)) :
    ∃ U : LTwo →L[ℝ] LTwo →L[ℝ] lp (fun _ : I => ℝ) (2 : ℝ≥0∞),
      ‖U‖ ≤ 1 ∧ ∀ x y q, U x y q = x (i q) * y (j q)

/-- Riesz representation for the continuous real coordinate dual of ℓ². -/
axiom citeLTwoRieszCoordinate :
    ∃ R : Dual LTwo ≃ₗᵢ[ℝ] LTwo, ∀ f j, R f j = f (lTwoUnit j)

private abbrev OffDiagonal := {q : ℕ × ℕ // q.1 < q.2}
private abbrev WalshIndex := Option OffDiagonal

private def walshIndexBasis (q : WalshIndex) :
    lp (fun _ : WalshIndex => ℝ) (2 : ℝ≥0∞) := lp.single 2 q 1

/-- The Walsh orthogonal functions of order zero and two, built from
the independent Lebesgue Rademacher signs. -/
structure RademacherWalshCoordinates where
  r : ℕ → boundedMeasurableAlgebra ℝ
  signs : ∀ j t, (r j).1 t = 1 ∨ (r j).1 t = -1
  synthesis : lp (fun _ : WalshIndex => ℝ) (2 : ℝ≥0∞) →ₗᵢ[ℝ]
    Lp ℝ (2 : ℝ≥0∞) lebesgueUnitInterval
  synthesis_const : synthesis (walshIndexBasis none) = probabilityScalarOne 2
  synthesis_pair : ∀ q : OffDiagonal,
    (fun t => synthesis (walshIndexBasis (some q)) t) =ᵐ[lebesgueUnitInterval]
      fun t => (r q.1.1).1 t * (r q.1.2).1 t
  integral_synthesis : ∀ a, (∫ t, synthesis a t ∂lebesgueUnitInterval) = a none
  orthogonality : ∀ j n, (∫ t, (r j).1 t * (r n).1 t ∂lebesgueUnitInterval) =
    if j = n then 1 else 0

/-- Walsh orthogonality for products of independent Rademacher signs
on the Lebesgue probability space. -/
axiom citeRademacherWalshOrthogonality : Nonempty RademacherWalshCoordinates

/-- Cauchy–Schwarz against the indicator of a measurable set. -/
axiom citeLTwoSetIntegralBound (ρ : Measure ℝ) [IsProbabilityMeasure ρ]
    (g : Lp ℝ (2 : ℝ≥0∞) ρ) (E : MeasSet ℝ) :
    |∫ t in E.1, g t ∂ρ| ≤ Real.sqrt (ρ E.1).toReal * ‖g‖

/-- The square variation estimate follows on every finite disjoint family
from the square-root mass bound at each measurable set. -/
theorem squareVariation_le_of_sqrt_measure_bound
    {Ω X : Type*} [MeasurableSpace Ω] [NormedAddCommGroup X] [NormedSpace ℝ X]
    (μ : OVM Ω X) (ρ : Measure Ω) [IsProbabilityMeasure ρ]
    (hbound : ∀ E : MeasSet Ω, ‖μ.val E‖ ≤ Real.sqrt (2 * (ρ E.1).toReal))
    (A : ℕ → MeasSet Ω) (I : Finset ℕ)
    (hA : (↑I : Set ℕ).Pairwise (fun i j => Disjoint (A i).1 (A j).1))
    (x : X) : ∑ i ∈ I, ‖μ.val (A i) x‖ ^ 2 ≤ 2 * ‖x‖ ^ 2 := by
  have hm : ∑ i ∈ I, (ρ (A i).1).toReal ≤ 1 := by
    have he : ρ (MeasSet.finiteUnion A I).1 = ∑ i ∈ I, ρ (A i).1 :=
      measure_biUnion_finset hA (fun i _ => (A i).2)
    rw [← ENNReal.toReal_sum (fun i _ => measure_ne_top ρ (A i).1), ← he]
    simpa using ENNReal.toReal_mono (measure_ne_top ρ univ)
      (measure_mono (subset_univ (MeasSet.finiteUnion A I).1))
  calc
    _ ≤ ∑ i ∈ I, (Real.sqrt (2 * (ρ (A i).1).toReal) * ‖x‖) ^ 2 := by
      apply Finset.sum_le_sum
      intro i _
      exact pow_le_pow_left₀ (norm_nonneg _) (((μ.val (A i)).le_opNorm x).trans
        (mul_le_mul_of_nonneg_right (hbound (A i)) (norm_nonneg _))) 2
    _ = (∑ i ∈ I, (ρ (A i).1).toReal) * (2 * ‖x‖ ^ 2) := by
      rw [Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro i _
      rw [mul_pow, Real.sq_sqrt (by positivity)]
      ring
    _ ≤ _ := by
      simpa only [one_mul] using mul_le_mul_of_nonneg_right hm (by positivity : 0 ≤ 2 * ‖x‖ ^ 2)

#print axioms squareVariation_le_of_sqrt_measure_bound




private abbrev OffCoefficients := lp (fun _ : OffDiagonal => ℝ) (2 : ℝ≥0∞)
private abbrev WalshCoefficients := lp (fun _ : WalshIndex => ℝ) (2 : ℝ≥0∞)
private abbrev WalshL2 := Lp ℝ (2 : ℝ≥0∞) lebesgueUnitInterval

/-- Decomposition of square summable coefficients under adjoining one
more coordinate to an index set. -/
axiom citeLTwoAdjoinCoordinate (I : Type) :
    ∃ L : (ℝ × lp (fun _ : I => ℝ) (2 : ℝ≥0∞)) →ₗ[ℝ]
        lp (fun _ : Option I => ℝ) (2 : ℝ≥0∞),
      (∀ c a, L (c, a) none = c) ∧ (∀ c a i, L (c, a) (some i) = a i) ∧
      ∀ c a, ‖L (c, a)‖ ^ 2 = c ^ 2 + ‖a‖ ^ 2

private structure WalshBilinearData where
  W : RademacherWalshCoordinates
  R : Dual LTwo ≃ₗᵢ[ℝ] LTwo
  R_eval : ∀ f j, R f j = f (lTwoUnit j)
  U : LTwo →L[ℝ] LTwo →L[ℝ] OffCoefficients
  U_norm : ‖U‖ ≤ 1
  U_eval : ∀ x y q, U x y q = x q.1.2 * y q.1.1
  L : (ℝ × OffCoefficients) →ₗ[ℝ] WalshCoefficients
  L_none : ∀ c a, L (c, a) none = c
  L_some : ∀ c a i, L (c, a) (some i) = a i
  L_norm : ∀ c a, ‖L (c, a)‖ ^ 2 = c ^ 2 + ‖a‖ ^ 2

private theorem exists_walshBilinearData : Nonempty WalshBilinearData := by
  obtain ⟨W⟩ := citeRademacherWalshOrthogonality
  obtain ⟨R, hR⟩ := citeLTwoRieszCoordinate
  obtain ⟨U, hU, hUe⟩ := citeLTwoProductCoordinates OffDiagonal (fun q => q.1.2) (fun q => q.1.1)
    (by intro q p h; exact Subtype.ext (Prod.ext (congrArg Prod.snd h) (congrArg Prod.fst h)))
  obtain ⟨L, hL0, hL1, hL⟩ := citeLTwoAdjoinCoordinate OffDiagonal
  exact ⟨⟨W, R, hR, U, hU, hUe, L, hL0, hL1, hL⟩⟩

private def WalshBilinearData.coeff (D : WalshBilinearData) (x : LTwo) (f : Dual LTwo) :
    WalshCoefficients := D.L (f x, D.U x (D.R f))

private def WalshBilinearData.density (D : WalshBilinearData) (x : LTwo) (f : Dual LTwo) :
    WalshL2 := D.W.synthesis (D.coeff x f)

private theorem WalshBilinearData.density_add_x (D : WalshBilinearData) (x y : LTwo) (f : Dual LTwo) :
    D.density (x + y) f = D.density x f + D.density y f := by
  simp only [WalshBilinearData.density, WalshBilinearData.coeff, map_add,
    add_apply, ← Prod.mk_add_mk]

private theorem WalshBilinearData.density_smul_x (D : WalshBilinearData) (c : ℝ) (x : LTwo) (f : Dual LTwo) :
    D.density (c • x) f = c • D.density x f := by
  simp only [WalshBilinearData.density, WalshBilinearData.coeff, map_smul,
    smul_apply, ← Prod.smul_mk]

private theorem WalshBilinearData.density_add_f (D : WalshBilinearData) (x : LTwo) (f g : Dual LTwo) :
    D.density x (f + g) = D.density x f + D.density x g := by
  simp only [WalshBilinearData.density, WalshBilinearData.coeff, map_add,
    add_apply, ← Prod.mk_add_mk]

private theorem WalshBilinearData.density_smul_f (D : WalshBilinearData) (c : ℝ) (x : LTwo) (f : Dual LTwo) :
    D.density x (c • f) = c • D.density x f := by
  simp only [WalshBilinearData.density, WalshBilinearData.coeff, map_smul,
    smul_apply, ← Prod.smul_mk]

private theorem WalshBilinearData.density_norm (D : WalshBilinearData) (x : LTwo) (f : Dual LTwo) :
    ‖D.density x f‖ ≤ Real.sqrt 2 * (‖x‖ * ‖f‖) := by
  have hU : ‖D.U x (D.R f)‖ ≤ ‖x‖ * ‖f‖ := by
    apply ((D.U x).le_opNorm _).trans
    rw [D.R.norm_map]
    exact mul_le_mul_of_nonneg_right ((D.U.le_opNorm x).trans
      (by simpa only [one_mul] using mul_le_mul_of_nonneg_right D.U_norm (norm_nonneg x))) (norm_nonneg f)
  have hf : ‖f x‖ ≤ ‖x‖ * ‖f‖ := by simpa only [mul_comm] using f.le_opNorm x
  have h₁ := pow_le_pow_left₀ (norm_nonneg _) hf 2
  have h₂ := pow_le_pow_left₀ (norm_nonneg _) hU 2
  have hEq (r : ℝ) : r ^ 2 = ‖r‖ ^ 2 := by rw [Real.norm_eq_abs, sq_abs]
  have hbound : ‖D.density x f‖ ^ 2 ≤ (Real.sqrt 2 * (‖x‖ * ‖f‖)) ^ 2 := by
    rw [WalshBilinearData.density, D.W.synthesis.norm_map, WalshBilinearData.coeff, D.L_norm,
      hEq (f x), mul_pow, Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 2)]
    linarith
  nlinarith [norm_nonneg (D.density x f), show 0 ≤ Real.sqrt 2 * (‖x‖ * ‖f‖) by positivity]

private def walshSetIntegral (E : MeasSet ℝ) : WalshL2 →L[ℝ] ℝ :=
  (probabilityScalarIntegral 2).comp
    ((FiniteSignedMeasure.probabilityLpPVM (ρ := lebesgueUnitInterval) (p := 2) (by norm_num)).val E)

private theorem walshSetIntegral_apply (E : MeasSet ℝ) (g : WalshL2) :
    walshSetIntegral E g = ∫ t in E.1, g t ∂lebesgueUnitInterval :=
  probabilityScalarIntegral_cut 2 (by norm_num) E g

private def WalshBilinearData.bidual (D : WalshBilinearData) (E : MeasSet ℝ) (x : LTwo) :
    Bidual LTwo :=
  LinearMap.mkContinuous
    { toFun := fun f => walshSetIntegral E (D.density x f)
      map_add' := fun f g => by rw [D.density_add_f, map_add]
      map_smul' := fun c f => by rw [D.density_smul_f, map_smul]; rfl }
    (Real.sqrt (2 * (lebesgueUnitInterval E.1).toReal) * ‖x‖) (by
      intro f
      change |walshSetIntegral E (D.density x f)| ≤ _
      rw [walshSetIntegral_apply]
      apply (citeLTwoSetIntegralBound _ _ E).trans
      have hb := mul_le_mul_of_nonneg_left (D.density_norm x f) (Real.sqrt_nonneg (lebesgueUnitInterval E.1).toReal)
      convert hb using 1
      rw [Real.sqrt_mul (by norm_num : (0 : ℝ) ≤ 2)]
      ring)

private def WalshBilinearData.operatorValue (D : WalshBilinearData) (E : MeasSet ℝ) :
    LTwo →L[ℝ] LTwo := by
  choose y hy using fun x => citeLTwoHilbertDuality (D.bidual E x)
  have he (x : LTwo) (f : Dual LTwo) : f (y x) = walshSetIntegral E (D.density x f) :=
    DFunLike.congr_fun (hy x) f
  refine LinearMap.mkContinuous
    { toFun := y
      map_add' := fun x z => eq_of_dual_eval fun f => by rw [he, D.density_add_x, map_add, map_add, he, he]
      map_smul' := fun c x => eq_of_dual_eval fun f => by rw [he, D.density_smul_x, map_smul, map_smul, he]; rfl }
    (Real.sqrt (2 * (lebesgueUnitInterval E.1).toReal)) (fun x => by
      change ‖y x‖ ≤ _
      rw [← norm_J, hy]
      exact LinearMap.mkContinuous_norm_le _ (by positivity) _)

private theorem WalshBilinearData.operatorValue_coeff (D : WalshBilinearData) (E : MeasSet ℝ)
    (x : LTwo) (f : Dual LTwo) :
    f (D.operatorValue E x) = ∫ t in E.1, D.density x f t ∂lebesgueUnitInterval := by
  rw [← walshSetIntegral_apply]
  exact DFunLike.congr_fun (Classical.choose_spec (citeLTwoHilbertDuality (D.bidual E x))) f

private theorem WalshBilinearData.operatorValue_bound (D : WalshBilinearData) (E : MeasSet ℝ) :
    ‖D.operatorValue E‖ ≤ Real.sqrt (2 * (lebesgueUnitInterval E.1).toReal) :=
  ContinuousLinearMap.opNorm_le_bound _ (Real.sqrt_nonneg _) fun x => by
    have he : J (D.operatorValue E x) = D.bidual E x :=
      Classical.choose_spec (citeLTwoHilbertDuality (D.bidual E x))
    rw [← norm_J, he]
    exact LinearMap.mkContinuous_norm_le _ (by positivity) _

#print axioms WalshBilinearData.operatorValue_coeff
#print axioms WalshBilinearData.operatorValue_bound



private theorem WalshBilinearData.operatorValue_hasSum (D : WalshBilinearData)
    (A : ℕ → MeasSet ℝ) (hA : MeasSet.DisjointSeq A) :
    HasSum (fun n => D.operatorValue (A n)) (D.operatorValue (MeasSet.iUnion A)) := by
  let U := MeasSet.iUnion A
  let H (I : Finset ℕ) := MeasSet.finiteUnion A I
  let R (I : Finset ℕ) := U.diff (H I)
  have hsub (I : Finset ℕ) : (H I).1 ⊆ U.1 := by
    intro t ht
    obtain ⟨i, _, hi⟩ := mem_iUnion₂.mp ht
    exact mem_iUnion.mpr ⟨i, hi⟩
  have hdiff (I : Finset ℕ) (x : LTwo) (f : Dual LTwo) :
      (∫ t in U.1, D.density x f t ∂lebesgueUnitInterval) =
      (∫ t in (H I).1, D.density x f t ∂lebesgueUnitInterval) +
      (∫ t in (R I).1, D.density x f t ∂lebesgueUnitInterval) := by
    have hd : Disjoint (H I).1 (R I).1 := disjoint_sdiff_right
    have hU : (H I).1 ∪ (R I).1 = U.1 := by simpa only [R, MeasSet.diff, union_comm] using sdiff_union_of_subset (hsub I)
    rw [← hU, setIntegral_union hd (R I).2
      (integrable_probabilityLp (D.density x f)).integrableOn
      (integrable_probabilityLp (D.density x f)).integrableOn]
  have hfin (I : Finset ℕ) :
      D.operatorValue U - ∑ n ∈ I, D.operatorValue (A n) = D.operatorValue (R I) := by
    apply ContinuousLinearMap.ext
    intro x
    apply eq_of_dual_eval
    intro f
    rw [sub_apply, sum_apply, map_sub, map_sum]
    simp_rw [D.operatorValue_coeff]
    rw [hdiff I x f, ← integral_biUnion_finset I (fun n _ => (A n).2)
      (fun i _ j _ hij => hA hij)
      (fun n _ => (integrable_probabilityLp (D.density x f)).integrableOn)]
    exact add_sub_cancel_left _ _
  have hmass : HasSum (fun n => (lebesgueUnitInterval (A n).1).toReal)
      (lebesgueUnitInterval U.1).toReal := by
    have h : lebesgueUnitInterval U.1 = ∑' n, lebesgueUnitInterval (A n).1 :=
      measure_iUnion hA (fun n => (A n).2)
    have hfinite : (∑' n, lebesgueUnitInterval (A n).1) ≠ ⊤ := by
      rw [← h]
      exact measure_ne_top _ _
    rw [h, ENNReal.tsum_toReal_eq (fun n => measure_ne_top lebesgueUnitInterval (A n).1)]
    exact ENNReal.hasSum_toReal hfinite
  have hmassfin (I : Finset ℕ) :
      (lebesgueUnitInterval (R I).1).toReal =
        (lebesgueUnitInterval U.1).toReal - ∑ n ∈ I, (lebesgueUnitInterval (A n).1).toReal := by
    have he : lebesgueUnitInterval (H I).1 = ∑ i ∈ I, lebesgueUnitInterval (A i).1 :=
      measure_biUnion_finset (fun i _ j _ hij => hA hij) (fun i _ => (A i).2)
    have hr := measureReal_sdiff (μ := lebesgueUnitInterval) (hsub I) (H I).2
    change (lebesgueUnitInterval (R I).1).toReal = (lebesgueUnitInterval U.1).toReal -
      (lebesgueUnitInterval (H I).1).toReal at hr
    rw [hr, ← ENNReal.toReal_sum (fun n _ => measure_ne_top lebesgueUnitInterval (A n).1), ← he]
  have ht : Tendsto (fun I => (lebesgueUnitInterval (R I).1).toReal) atTop (𝓝 0) := by
    simp_rw [hmassfin]
    have hc : Tendsto (fun _ : Finset ℕ => (lebesgueUnitInterval U.1).toReal) atTop
        (𝓝 (lebesgueUnitInterval U.1).toReal) := tendsto_const_nhds
    simpa only [sub_self] using hc.sub hmass
  have ht' : Tendsto (fun I => Real.sqrt (2 * (lebesgueUnitInterval (R I).1).toReal))
      atTop (𝓝 0) := by
    have he : Tendsto (fun I => 2 * (lebesgueUnitInterval (R I).1).toReal) atTop (𝓝 0) := by
      simpa only [mul_zero] using (tendsto_const_nhds (x := (2 : ℝ))).mul ht
    have hs := (Real.continuous_sqrt.tendsto 0).comp he
    change Tendsto (fun I => Real.sqrt (2 * (lebesgueUnitInterval (R I).1).toReal))
      atTop (𝓝 (Real.sqrt 0)) at hs
    rwa [Real.sqrt_zero] at hs
  change Tendsto (fun I : Finset ℕ => ∑ n ∈ I, D.operatorValue (A n)) atTop (𝓝 (D.operatorValue U))
  rw [Metric.tendsto_nhds]
  intro ε hε
  filter_upwards [Metric.tendsto_nhds.mp ht' ε hε] with I hI
  rw [dist_eq_norm, norm_sub_rev, hfin]
  have hi : Real.sqrt (2 * (lebesgueUnitInterval (R I).1).toReal) < ε := by
    rwa [Real.dist_eq, sub_zero, abs_of_nonneg (Real.sqrt_nonneg _)] at hI
  exact (D.operatorValue_bound _).trans_lt hi

private def WalshBilinearData.operatorMeasure (D : WalshBilinearData) : OVM ℝ LTwo where
  val := D.operatorValue
  empty_eq := by
    apply ContinuousLinearMap.ext
    intro x
    apply eq_of_dual_eval
    intro f
    rw [D.operatorValue_coeff, zero_apply, map_zero]
    simp [MeasSet.empty]
  countably_additive := fun A hA x =>
    (ContinuousLinearMap.apply ℝ LTwo x).hasSum (D.operatorValue_hasSum A hA)

private theorem WalshBilinearData.operatorMeasure_normalized (D : WalshBilinearData) :
    D.operatorMeasure.Normalized := by
  apply ContinuousLinearMap.ext
  intro x
  apply eq_of_dual_eval
  intro f
  change f (D.operatorValue MeasSet.whole x) = f x
  rw [D.operatorValue_coeff, MeasSet.whole, setIntegral_univ, WalshBilinearData.density,
    D.W.integral_synthesis, WalshBilinearData.coeff, D.L_none]

#print axioms WalshBilinearData.operatorValue_hasSum
#print axioms WalshBilinearData.operatorMeasure_normalized



local instance (priority := 2000) : Semiring (boundedMeasurableAlgebra ℝ) :=
  (boundedMeasurableAlgebra ℝ).toRing.toSemiring

private theorem lTwoUnit_apply (j k : ℕ) : lTwoUnit j k = if k = j then 1 else 0 := by
  by_cases h : k = j
  · subst k; simp [lTwoUnit]
  · simpa only [ite_eq_right h, lTwoUnit] using
      lp.single_apply_ne (E := fun _ : ℕ => ℝ) 2 j 1 h

private theorem lTwoCoordinate_apply (j : ℕ) (x : LTwo) : lTwoCoordinate j x = x j := rfl

private theorem WalshBilinearData.r_abs (D : WalshBilinearData) (j : ℕ) (t : ℝ) :
    |(D.W.r j).1 t| = 1 := by
  rcases D.W.signs j t with h | h <;> rw [h] <;> norm_num

private theorem WalshBilinearData.r_norm_le (D : WalshBilinearData) (j : ℕ) :
    ‖(D.W.r j).1‖ ≤ 1 := by
  let : TopologicalSpace ℝ := ⊥
  apply (BoundedContinuousFunction.norm_le zero_le_one).mpr
  intro t
  rw [Real.norm_eq_abs, D.r_abs]

private theorem WalshBilinearData.density_basis (D : WalshBilinearData) (j n : ℕ) :
    (fun t => D.density (lTwoUnit n) (lTwoCoordinate j) t) =ᵐ[lebesgueUnitInterval]
      fun t => if j ≤ n then (D.W.r j).1 t * (D.W.r n).1 t else 0 := by
  let a := D.coeff (lTwoUnit n) (lTwoCoordinate j)
  have ha0 : a none = if j = n then 1 else 0 := by
    change D.L _ none = _
    rw [D.L_none, lTwoCoordinate_apply, lTwoUnit_apply]
  have ha1 (q : OffDiagonal) : a (some q) =
      if q.1.1 = j ∧ q.1.2 = n then 1 else 0 := by
    change D.L _ (some q) = _
    rw [D.L_some, D.U_eval, D.R_eval, lTwoCoordinate_apply, lTwoUnit_apply, lTwoUnit_apply]
    by_cases h1 : q.1.1 = j <;> by_cases h2 : q.1.2 = n
    all_goals simp [h1, h2, eq_comm (a := j) (b := q.1.1)]
  rcases lt_trichotomy j n with h | h | h
  · let p := (⟨(j, n), h⟩ : OffDiagonal)
    have he : a = walshIndexBasis (some p) := by
      apply Subtype.ext
      funext q
      cases q with
      | none => simpa [walshIndexBasis, lp.single_apply, Pi.single_eq_of_ne, ne_of_lt h] using ha0
      | some q =>
        have hq : q = p ↔ q.1.1 = j ∧ q.1.2 = n := ⟨fun e => by subst q; exact ⟨rfl, rfl⟩,
          fun e => Subtype.ext (Prod.ext e.1 e.2)⟩
        by_cases hqp : q = p
        · subst q
          simpa [walshIndexBasis, p] using ha1 p
        · have hcon := mt hq.mpr hqp
          have he := ha1 q
          rw [ite_eq_right hcon] at he
          have hne : some q ≠ some p := fun h => hqp (Option.some.inj h)
          exact he.trans (lp.single_apply_ne (E := fun _ : WalshIndex => ℝ) 2 (some p) 1 hne).symm
    change (fun t => D.W.synthesis a t) =ᵐ[lebesgueUnitInterval] _
    rw [he]
    simpa only [ite_eq_left h.le, p] using D.W.synthesis_pair p
  · subst n
    have he : a = walshIndexBasis none := by
      apply Subtype.ext
      funext q
      cases q with
      | none => simpa [walshIndexBasis] using ha0
      | some q =>
        have hcon : ¬ (q.1.1 = j ∧ q.1.2 = j) := by
          rintro ⟨h1, h2⟩
          have ht := q.2
          rw [h1, h2] at ht
          exact (lt_irrefl _ ht)
        simpa [walshIndexBasis, lp.single_apply, Pi.single_eq_of_ne, hcon] using ha1 q
    change (fun t => D.W.synthesis a t) =ᵐ[lebesgueUnitInterval] _
    rw [he, D.W.synthesis_const]
    apply (probabilityScalarOne_ae 2).trans
    apply ae_of_all
    intro t
    change (1 : ℝ) = (if j ≤ j then (D.W.r j).1 t * (D.W.r j).1 t else 0)
    rw [ite_eq_left le_rfl]
    rcases D.W.signs j t with hsign | hsign <;> rw [hsign] <;> norm_num
  · have he : a = 0 := by
      apply Subtype.ext
      funext q
      cases q with
      | none => simpa [ne_of_gt h] using ha0
      | some q =>
        have hcon : ¬ (q.1.1 = j ∧ q.1.2 = n) := by
          rintro ⟨h1, h2⟩
          have ht := q.2
          rw [h1, h2] at ht
          exact (not_lt_of_ge h.le ht)
        simpa [hcon] using ha1 q
    change (fun t => D.W.synthesis a t) =ᵐ[lebesgueUnitInterval] _
    rw [he, map_zero]
    filter_upwards [Lp.coeFn_zero ℝ 2 lebesgueUnitInterval] with t ht
    exact ht.trans (ite_eq_right (not_le_of_gt h)).symm

private theorem WalshBilinearData.triangular_moments (D : WalshBilinearData) (j n : ℕ) :
    lTwoCoordinate j (D.operatorMeasure.boundedMeasurableMultiplier (D.W.r j * D.W.r n) (lTwoUnit n)) =
      if j ≤ n then 1 else 0 := by
  have hi := integrable_probabilityLp (D.density (lTwoUnit n) (lTwoCoordinate j))
  have hcoeff := D.operatorValue_coeff
  have h := D.operatorMeasure.boundedMeasurableMultiplier_orbit
    (D.W.r j * D.W.r n) (lTwoUnit n) (lTwoCoordinate j) lebesgueUnitInterval
    (D.density (lTwoUnit n) (lTwoCoordinate j)) hi (fun E => hcoeff E _ _)
  rw [h]
  have hr : (fun t => (↑(D.W.r j * D.W.r n) : DiscreteBoundedRealFunctions ℝ) t *
      D.density (lTwoUnit n) (lTwoCoordinate j) t) =ᵐ[lebesgueUnitInterval]
      fun _ => if j ≤ n then (1 : ℝ) else 0 := by
    filter_upwards [D.density_basis j n] with t ht
    change (D.W.r j).1 t * (D.W.r n).1 t * D.density (lTwoUnit n) (lTwoCoordinate j) t = _
    rw [ht]
    by_cases hj : j ≤ n
    · simp only [ite_eq_left hj]
      rcases D.W.signs j t with hJ | hJ <;> rcases D.W.signs n t with hN | hN <;>
        rw [hJ, hN] <;> norm_num
    · simp [hj]
  rw [integral_congr_ae hr, integral_const]
  have hρ : lebesgueUnitInterval.real univ = 1 := by
    change (lebesgueUnitInterval univ).toReal = 1
    rw [measure_univ, ENNReal.toReal_one]
  rw [hρ, one_smul]

private theorem WalshBilinearData.no_reflexive_dilation (D : WalshBilinearData)
    {Z : Type*} [NormedAddCommGroup Z] [NormedSpace ℝ Z] [CompleteSpace Z]
    (F : Dilation D.operatorMeasure Z) :
    ¬ IsReflexive Z :=
  D.operatorMeasure.no_reflexive_dilation_of_triangular_moments D.W.r lTwoUnit lTwoCoordinate
    D.r_norm_le (fun n => (norm_lTwoUnit n).le) norm_lTwoCoordinate_le D.triangular_moments F

#print axioms WalshBilinearData.triangular_moments
#print axioms WalshBilinearData.no_reflexive_dilation



private def WalshBilinearData.vectorDensity (D : WalshBilinearData) (n : ℕ) (t : ℝ) : LTwo :=
  ∑ j ∈ Finset.range (n + 1), lp.single 2 j ((D.W.r j).1 t * (D.W.r n).1 t)

private theorem lp_two_single_real_smul (j : ℕ) (c : ℝ) :
    (lp.single 2 j c : LTwo) = c • lTwoUnit j := by
  let S := lp.singleContinuousLinearMap (𝕜 := ℝ) (E := fun _ : ℕ => ℝ) (p := 2) j
  change S c = c • S 1
  rw [← map_smul]
  simp

private theorem WalshBilinearData.vectorDensity_integrable (D : WalshBilinearData) (n : ℕ) :
    Integrable (D.vectorDensity n) lebesgueUnitInterval := by
  apply integrable_finsetSum
  intro j _
  simp_rw [lp_two_single_real_smul]
  have hg : Integrable (fun t => (D.W.r j).1 t * (D.W.r n).1 t) lebesgueUnitInterval := by
    apply Integrable.bdd_mul (c := 1)
      ((integrable_const (1 : ℝ)).mono (D.W.r n).2.aestronglyMeasurable
        (ae_of_all _ fun t => by rw [Real.norm_eq_abs, D.r_abs]; norm_num))
      (D.W.r j).2.aestronglyMeasurable
    exact ae_of_all _ fun t => by change ‖(D.W.r j).1 t‖ ≤ 1; rw [Real.norm_eq_abs, D.r_abs]
  exact hg.smul_const _

private theorem WalshBilinearData.vectorDensity_coord (D : WalshBilinearData) (n j : ℕ) (t : ℝ) :
    lTwoCoordinate j (D.vectorDensity n t) =
      if j ≤ n then (D.W.r j).1 t * (D.W.r n).1 t else 0 := by
  rw [WalshBilinearData.vectorDensity, map_sum]
  simp only [lTwoCoordinate_apply]
  by_cases h : j ≤ n
  · rw [ite_eq_left h, Finset.sum_eq_single_of_mem j (Finset.mem_range.mpr (Nat.lt_succ_iff.mpr h))]
    · exact lp.single_apply_self 2 j _
    · intro i _ hi
      exact lp.single_apply_ne 2 i _ (Ne.symm hi)
  · rw [ite_eq_right h]
    apply Finset.sum_eq_zero
    intro i hi
    exact lp.single_apply_ne 2 i _ (fun e => h (e ▸ Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)))

private theorem WalshBilinearData.vectorDensity_norm (D : WalshBilinearData) (n : ℕ) (t : ℝ) :
    ‖D.vectorDensity n t‖ = Real.sqrt (n + 1) := by
  have he := lp.norm_sum_single (p := 2) (by norm_num)
    (fun j => (D.W.r j).1 t * (D.W.r n).1 t) (Finset.range (n + 1))
  have h : ‖D.vectorDensity n t‖ ^ 2 = (n : ℝ) + 1 := by
    simpa [WalshBilinearData.vectorDensity, Real.rpow_two, Real.norm_eq_abs, abs_mul, D.r_abs] using he
  nlinarith [norm_nonneg (D.vectorDensity n t), Real.sqrt_nonneg ((n : ℝ) + 1),
    Real.sq_sqrt (by positivity : 0 ≤ (n : ℝ) + 1)]

private theorem WalshBilinearData.vectorDensity_integral (D : WalshBilinearData)
    (n : ℕ) (E : MeasSet ℝ) :
    D.operatorMeasure.val E (lTwoUnit n) = ∫ t in E.1, D.vectorDensity n t ∂lebesgueUnitInterval := by
  apply Subtype.ext
  funext j
  change lTwoCoordinate j (D.operatorValue E (lTwoUnit n)) =
    lTwoCoordinate j (∫ t in E.1, D.vectorDensity n t ∂lebesgueUnitInterval)
  rw [D.operatorValue_coeff,
    ← (lTwoCoordinate j).integral_comp_comm (D.vectorDensity_integrable n).restrict]
  apply integral_congr_ae
  filter_upwards [ae_restrict_of_ae (D.density_basis j n)] with t ht
  exact ht.trans (D.vectorDensity_coord n j t).symm

/-- The variation formula for an indefinite Bochner integral (Diestel–Uhl,
Chapter II), expressed with finite measurable partitions of each set. -/
axiom citeBochnerDensityVariation {Ω X : Type*} [MeasurableSpace Ω]
    [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X]
    (ρ : Measure Ω) (h : Ω → X) (hi : Integrable h ρ) (E : MeasSet Ω) :
    sSup {r | ∃ (A : ℕ → MeasSet Ω) (I : Finset ℕ),
      (↑I : Set ℕ).Pairwise (fun i j => Disjoint (A i).1 (A j).1) ∧
      MeasSet.finiteUnion A I = E ∧
      r = ENNReal.ofReal (∑ n ∈ I, ‖∫ t in (A n).1, h t ∂ρ‖)} =
      ENNReal.ofReal (∫ t in E.1, ‖h t‖ ∂ρ)

private theorem WalshBilinearData.orbitVariation_basis (D : WalshBilinearData) (n : ℕ)
    (E : MeasSet ℝ) :
    D.operatorMeasure.orbitVariation (lTwoUnit n) E =
      ENNReal.ofReal (Real.sqrt (n + 1) * (lebesgueUnitInterval E.1).toReal) := by
  rw [OVM.orbitVariation]
  simp_rw [D.vectorDensity_integral n]
  rw [citeBochnerDensityVariation _ _ (D.vectorDensity_integrable n), show
    (fun t => ‖D.vectorDensity n t‖) = (fun _ => Real.sqrt (n + 1)) from funext (D.vectorDensity_norm n),
    setIntegral_const, smul_eq_mul, mul_comm]
  rfl

private theorem WalshBilinearData.not_orbitVariation_finite_on_positive (D : WalshBilinearData)
    (E : MeasSet ℝ) (hE : 0 < lebesgueUnitInterval E.1) :
    ¬ ∀ x, D.operatorMeasure.orbitVariation x E < ⊤ := by
  intro hf
  obtain ⟨C, hC, hV⟩ := D.operatorMeasure.uniform_orbitVariation E hf
  let m := (lebesgueUnitInterval E.1).toReal
  have hm : 0 < m := ENNReal.toReal_pos hE.ne' (measure_ne_top _ _)
  obtain ⟨n, hn⟩ := exists_nat_gt ((C / m) ^ 2)
  have he := hV (lTwoUnit n)
  rw [D.orbitVariation_basis, norm_lTwoUnit, mul_one] at he
  have ha := (ENNReal.ofReal_le_ofReal_iff hC).mp he
  change Real.sqrt ((n : ℝ) + 1) * m ≤ C at ha
  have hdiv := (le_div_iff₀ hm).mpr ha
  have hsq := pow_le_pow_left₀ (Real.sqrt_nonneg ((n : ℝ) + 1)) hdiv 2
  rw [Real.sq_sqrt (by positivity)] at hsq
  linarith

private theorem WalshBilinearData.operatorVariation_top (D : WalshBilinearData)
    (E : MeasSet ℝ) (hE : 0 < lebesgueUnitInterval E.1) :
    D.operatorMeasure.operatorVariation E = ⊤ := by
  by_contra hh
  apply D.not_orbitVariation_finite_on_positive E hE
  intro x
  exact (D.operatorMeasure.orbitVariation_le_operatorVariation x E).trans_lt
    (ENNReal.mul_lt_top ENNReal.ofReal_lt_top (lt_top_iff_ne_top.mpr hh))

/-- The actual Rademacher OVM on real ℓ² from the manuscript. -/
def rademacherOperatorMeasure : OVM ℝ LTwo :=
  (Classical.choice exists_walshBilinearData).operatorMeasure

/-- The manuscript's Rademacher OVM is normalized, countably additive
in operator norm, has bounded square variation, and has no reflexive
dilation. Every set of positive Lebesgue mass has infinite operator
variation and fails pointwise finiteness of all orbit variations. -/
theorem rademacherOperatorMeasure_properties :
    let μ := rademacherOperatorMeasure
    μ.Normalized ∧
    (∀ A : ℕ → MeasSet ℝ, MeasSet.DisjointSeq A → HasSum (fun n => μ.val (A n)) (μ.val (MeasSet.iUnion A))) ∧
    (∀ (A : ℕ → MeasSet ℝ) (I : Finset ℕ),
      (↑I : Set ℕ).Pairwise (fun i j => Disjoint (A i).1 (A j).1) →
      ∀ x : LTwo, ∑ i ∈ I, ‖μ.val (A i) x‖ ^ 2 ≤ 2 * ‖x‖ ^ 2) ∧
    (¬ ∃ M : DilationSpace μ, letI := M.normedGroup; letI := M.normedScalar; IsReflexive M.carrier) ∧
    (∀ E : MeasSet ℝ, 0 < lebesgueUnitInterval E.1 →
      μ.operatorVariation E = ⊤ ∧ ¬ ∀ x, μ.orbitVariation x E < ⊤) := by
  let D := Classical.choice exists_walshBilinearData
  exact ⟨D.operatorMeasure_normalized, D.operatorValue_hasSum,
    squareVariation_le_of_sqrt_measure_bound _ _ D.operatorValue_bound,
    fun ⟨F, hF⟩ => by
      let _ := F.normedGroup
      let _ := F.normedScalar
      let _ := F.complete
      exact D.no_reflexive_dilation F.dilation hF,
    fun E hE => ⟨D.operatorVariation_top E hE, D.not_orbitVariation_finite_on_positive E hE⟩⟩

#print axioms rademacherOperatorMeasure_properties



/-- The sign sequence used to construct the Rademacher operator measure. -/
def rademacherSign : ℕ → boundedMeasurableAlgebra ℝ :=
  (Classical.choice exists_walshBilinearData).W.r

/-- The manuscript's triangular matrix entries, on the canonical ℓ² vectors. -/
theorem rademacherOperatorMeasure_entry (E : MeasSet ℝ) (j n : ℕ) :
    (rademacherOperatorMeasure.val E (lTwoUnit n)) j =
      if j ≤ n then ∫ t in E.1, (rademacherSign j).1 t * (rademacherSign n).1 t ∂lebesgueUnitInterval
        else 0 := by
  let D := Classical.choice exists_walshBilinearData
  change lTwoCoordinate j (D.operatorValue E (lTwoUnit n)) = _
  rw [D.operatorValue_coeff, integral_congr_ae (ae_restrict_of_ae (D.density_basis j n))]
  by_cases hj : j ≤ n <;> simp [hj, rademacherSign, D]

/-- The defining series for the coordinates of the operator measure on
arbitrary ℓ² vectors, obtained from its continuous extension. -/
theorem rademacherOperatorMeasure_coordinate_series (E : MeasSet ℝ) (x : LTwo) (j : ℕ) :
    HasSum (fun n => if j ≤ n then x n *
      (∫ t in E.1, (rademacherSign j).1 t * (rademacherSign n).1 t ∂lebesgueUnitInterval) else 0)
      ((rademacherOperatorMeasure.val E x) j) := by
  let f := (lTwoCoordinate j).comp (rademacherOperatorMeasure.val E)
  have h := f.hasSum (lp.hasSum_single (by norm_num : (2 : ℝ≥0∞) ≠ ⊤) x)
  have he (n : ℕ) :
      f (lp.single 2 n (x n)) = if j ≤ n then x n *
        (∫ t in E.1, (rademacherSign j).1 t * (rademacherSign n).1 t ∂lebesgueUnitInterval) else 0 := by
    rw [lp_two_single_real_smul, map_smul]
    change x n * (rademacherOperatorMeasure.val E (lTwoUnit n)) j = _
    rw [rademacherOperatorMeasure_entry]
    by_cases hj : j ≤ n <;> simp [hj]
  change HasSum _ (f x)
  simpa only [he] using h

/-- Neither local orbit variation nor operator-norm variation is
finite on a countable measurable partition of the interval. -/
theorem rademacherOperatorMeasure_no_localVariationPartition
    (B : ℕ → MeasSet ℝ) (hcover : MeasSet.iUnion B = MeasSet.whole) :
    (¬ ∀ j x, rademacherOperatorMeasure.orbitVariation x (B j) < ⊤) ∧
    (¬ ∀ j, rademacherOperatorMeasure.operatorVariation (B j) < ⊤) := by
  have hex : ∃ j, 0 < lebesgueUnitInterval (B j).1 := by
    by_contra hn
    push Not at hn
    have hz : lebesgueUnitInterval (MeasSet.iUnion B).1 = 0 :=
      measure_iUnion_null fun j => le_zero_iff.mp (hn j)
    simp [hcover, MeasSet.whole] at hz
  obtain ⟨j, hj⟩ := hex
  have hf := rademacherOperatorMeasure_properties.2.2.2.2 (B j) hj
  exact ⟨fun h => hf.2 (h j), fun h => (h j).ne hf.1⟩

#print axioms rademacherOperatorMeasure_coordinate_series
#print axioms rademacherOperatorMeasure_no_localVariationPartition

end RademacherDilationExample


noncomputable section OperatorVariationMeasure

open MeasureTheory
open scoped ENNReal

variable {Ω X : Type*} [MeasurableSpace Ω] [NormedAddCommGroup X] [NormedSpace ℝ X]

private theorem OVM.operatorVariation_partition_le (μ : OVM Ω X)
    (A B : MeasSet Ω) (D : ℕ → MeasSet Ω) (E : ℕ → MeasSet Ω)
    (I J : Finset ℕ)
    (hD : (↑I : Set ℕ).Pairwise (fun i j => Disjoint (D i).1 (D j).1))
    (hE : (↑J : Set ℕ).Pairwise (fun i j => Disjoint (E i).1 (E j).1))
    (hI : MeasSet.finiteUnion D I = A) (hJ : MeasSet.finiteUnion E J = B)
    (hAB : Disjoint A.1 B.1) :
    (∑ i ∈ I, ENNReal.ofReal ‖μ.val (D i)‖) + (∑ j ∈ J, ENNReal.ofReal ‖μ.val (E j)‖) ≤
      μ.operatorVariation (A.union B) := by
  let e : ℕ ⊕ ℕ ≃ ℕ := Equiv.natSumNatEquivNat
  let F : ℕ ⊕ ℕ → MeasSet Ω := Sum.elim D E
  let S := I.disjSum J
  let G := F ∘ e.symm
  have hDsub (i : ℕ) (hi : i ∈ I) : (D i).1 ⊆ A.1 := fun _ ht =>
    hI ▸ mem_iUnion₂.mpr ⟨i, hi, ht⟩
  have hEsub (i : ℕ) (hi : i ∈ J) : (E i).1 ⊆ B.1 := fun _ ht =>
    hJ ▸ mem_iUnion₂.mpr ⟨i, hi, ht⟩
  have hdis : (↑S : Set (ℕ ⊕ ℕ)).Pairwise (fun i j => Disjoint (F i).1 (F j).1) := by
    rintro (i | i) hi (j | j) hj hij
    · exact hD (Finset.inl_mem_disjSum.mp hi) (Finset.inl_mem_disjSum.mp hj)
        (fun h => hij (congrArg Sum.inl h))
    · exact hAB.mono (hDsub i (Finset.inl_mem_disjSum.mp hi)) (hEsub j (Finset.inr_mem_disjSum.mp hj))
    · exact hAB.symm.mono (hEsub i (Finset.inr_mem_disjSum.mp hi)) (hDsub j (Finset.inl_mem_disjSum.mp hj))
    · exact hE (Finset.inr_mem_disjSum.mp hi) (Finset.inr_mem_disjSum.mp hj)
        (fun h => hij (congrArg Sum.inr h))
  have hdis' : (↑(S.map e.toEmbedding) : Set ℕ).Pairwise
      (fun i j => Disjoint (G i).1 (G j).1) := by
    intro i hi j hj hij
    obtain ⟨i', hi', rfl⟩ := Finset.mem_map.mp hi
    obtain ⟨j', hj', rfl⟩ := Finset.mem_map.mp hj
    simpa [G] using hdis hi' hj' (fun h => hij (congrArg e h))
  have hcover : MeasSet.finiteUnion G (S.map e.toEmbedding) = A.union B := by
    apply Subtype.ext
    ext t
    change (t ∈ ⋃ i ∈ S.map e.toEmbedding, (G i).1) ↔ t ∈ A.1 ∪ B.1
    constructor
    · intro h
      obtain ⟨i, hi, ht⟩ := mem_iUnion₂.mp h
      obtain ⟨i', hi', rfl⟩ := Finset.mem_map.mp hi
      have ht' : t ∈ (F i').1 := by simpa [G] using ht
      cases i' with
      | inl k => exact Or.inl (hDsub k (Finset.inl_mem_disjSum.mp hi') ht')
      | inr k => exact Or.inr (hEsub k (Finset.inr_mem_disjSum.mp hi') ht')
    · rintro (ha | hb)
      · rw [← hI] at ha
        obtain ⟨i, hi, ht⟩ := mem_iUnion₂.mp ha
        exact mem_iUnion₂.mpr ⟨e (Sum.inl i), Finset.mem_map.mpr
          ⟨Sum.inl i, Finset.inl_mem_disjSum.mpr hi, rfl⟩, by simpa [G, F] using ht⟩
      · rw [← hJ] at hb
        obtain ⟨j, hj, ht⟩ := mem_iUnion₂.mp hb
        exact mem_iUnion₂.mpr ⟨e (Sum.inr j), Finset.mem_map.mpr
          ⟨Sum.inr j, Finset.inr_mem_disjSum.mpr hj, rfl⟩, by simpa [G, F] using ht⟩
  have hle : (∑ i ∈ S.map e.toEmbedding, ENNReal.ofReal ‖μ.val (G i)‖) ≤
      μ.operatorVariation (A.union B) := le_sSup ⟨_, _, hdis', hcover, rfl⟩
  rw [Finset.sum_map] at hle
  simp only [G, Function.comp_apply, Equiv.toEmbedding_apply, Equiv.symm_apply_apply] at hle
  rwa [Finset.sum_disjSum] at hle

theorem OVM.operatorVariation_add_le (μ : OVM Ω X) (A B : MeasSet Ω)
    (hAB : Disjoint A.1 B.1) :
    μ.operatorVariation A + μ.operatorVariation B ≤ μ.operatorVariation (A.union B) := by
  have hNE (A₀ : MeasSet Ω) : {r | ∃ (D : ℕ → MeasSet Ω) (I : Finset ℕ),
      (↑I : Set ℕ).Pairwise (fun i j => Disjoint (D i).1 (D j).1) ∧
      MeasSet.finiteUnion D I = A₀ ∧ r = ∑ n ∈ I, ENNReal.ofReal ‖μ.val (D n)‖}.Nonempty := by
    refine ⟨ENNReal.ofReal ‖μ.val A₀‖, fun _ => A₀, {0}, by simp, ?_, by simp⟩
    apply Subtype.ext
    change (⋃ i ∈ ({0} : Finset ℕ), A₀.1) = A₀.1
    simp
  rw [OVM.operatorVariation, OVM.operatorVariation, ENNReal.sSup_add (hNE A)]
  refine iSup_le fun a => iSup_le fun ha => ?_
  obtain ⟨D, I, hd, hI, rfl⟩ := ha
  rw [ENNReal.add_sSup (hNE B)]
  refine iSup_le fun b => iSup_le fun hb => ?_
  obtain ⟨E, J, he, hJ, rfl⟩ := hb
  exact μ.operatorVariation_partition_le A B D E I J hd he hI hJ hAB

theorem OVM.operatorVariation_mono (μ : OVM Ω X) {A B : MeasSet Ω}
    (hAB : A.1 ⊆ B.1) : μ.operatorVariation A ≤ μ.operatorVariation B := by
  have he : A.union (B.diff A) = B := Subtype.ext (by
    change A.1 ∪ (B.1 \ A.1) = B.1
    rw [union_comm, sdiff_union_of_subset hAB])
  have hd : Disjoint A.1 (B.diff A).1 := disjoint_sdiff_right
  exact le_add_right le_rfl |>.trans ((μ.operatorVariation_add_le A (B.diff A) hd).trans_eq (congrArg μ.operatorVariation he))

private theorem OVM.operatorVariation_empty (μ : OVM Ω X) :
    μ.operatorVariation MeasSet.empty = 0 := by
  apply le_antisymm _ bot_le
  apply sSup_le
  rintro _ ⟨D, I, _, hI, rfl⟩
  apply le_of_eq
  apply Finset.sum_eq_zero
  intro i hi
  have hu : D i = MeasSet.empty := Subtype.ext (eq_empty_iff_forall_notMem.mpr fun t ht => by
    have hin : t ∈ (MeasSet.finiteUnion D I).1 := mem_iUnion₂.mpr ⟨i, hi, ht⟩
    rw [hI] at hin
    exact hin)
  rw [hu, μ.empty_eq, norm_zero, ENNReal.ofReal_zero]

private theorem OVM.ofReal_norm_iUnion_le (μ : OVM Ω X) (D : ℕ → MeasSet Ω)
    (hD : MeasSet.DisjointSeq D) :
    ENNReal.ofReal ‖μ.val (MeasSet.iUnion D)‖ ≤ ∑' n, ENNReal.ofReal ‖μ.val (D n)‖ := by
  let c := ∑' n, ENNReal.ofReal ‖μ.val (D n)‖
  by_cases hc : c = ⊤
  · change _ ≤ c
    rw [hc]
    exact le_top
  rw [show (∑' n, ENNReal.ofReal ‖μ.val (D n)‖) = ENNReal.ofReal c.toReal from
    (ENNReal.ofReal_toReal hc).symm]
  apply ENNReal.ofReal_le_ofReal
  apply ContinuousLinearMap.opNorm_le_bound _ ENNReal.toReal_nonneg
  intro x
  have h := (continuous_norm.tendsto _).comp (μ.countably_additive D hD x).tendsto_sum_nat
  apply le_of_tendsto h
  refine Eventually.of_forall fun N => ?_
  calc
    _ ≤ ∑ n ∈ Finset.range N, ‖μ.val (D n) x‖ := norm_sum_le _ _
    _ ≤ (∑ n ∈ Finset.range N, ‖μ.val (D n)‖) * ‖x‖ := by
      rw [Finset.sum_mul]
      exact Finset.sum_le_sum fun i _ => (μ.val (D i)).le_opNorm x
    _ ≤ c.toReal * ‖x‖ := by
      apply mul_le_mul_of_nonneg_right _ (norm_nonneg _)
      have hs : (∑ n ∈ Finset.range N, ENNReal.ofReal ‖μ.val (D n)‖) ≤ c :=
        sum_le_tsum _
      simpa only [ENNReal.toReal_sum (fun _ _ => ENNReal.ofReal_ne_top),
        ENNReal.toReal_ofReal (norm_nonneg _)] using ENNReal.toReal_mono hc hs

theorem OVM.operatorVariation_iUnion (μ : OVM Ω X) (B : ℕ → MeasSet Ω)
    (hB : MeasSet.DisjointSeq B) :
    μ.operatorVariation (MeasSet.iUnion B) = ∑' n, μ.operatorVariation (B n) := by
  classical
  apply le_antisymm
  · apply sSup_le
    rintro _ ⟨D, I, hd, hI, rfl⟩
    have hsub (i : ℕ) (hi : i ∈ I) : (D i).1 ⊆ (MeasSet.iUnion B).1 := fun _ ht =>
      hI ▸ mem_iUnion₂.mpr ⟨i, hi, ht⟩
    let C (i n : ℕ) := (D i).inter (B n)
    have hcut (i : ℕ) (hi : i ∈ I) : MeasSet.iUnion (C i) = D i := by
      apply Subtype.ext
      change (⋃ n, (D i).1 ∩ (B n).1) = (D i).1
      rw [← inter_iUnion]
      exact inter_eq_left.mpr (hsub i hi)
    have hcover (n : ℕ) : MeasSet.finiteUnion (fun i => C i n) I = B n := by
      apply Subtype.ext
      ext t
      change (t ∈ ⋃ i ∈ I, (D i).1 ∩ (B n).1) ↔ t ∈ (B n).1
      constructor
      · intro h; obtain ⟨_, _, hh⟩ := mem_iUnion₂.mp h; exact hh.2
      · intro h
        have ht : t ∈ (MeasSet.finiteUnion D I).1 := hI.symm ▸ mem_iUnion.mpr ⟨n, h⟩
        obtain ⟨i, hi, hz⟩ := mem_iUnion₂.mp ht
        exact mem_iUnion₂.mpr ⟨i, hi, hz, h⟩
    calc
      _ ≤ ∑ i ∈ I, ∑' n, ENNReal.ofReal ‖μ.val (C i n)‖ := Finset.sum_le_sum fun i hi => by
        simpa only [hcut i hi] using μ.ofReal_norm_iUnion_le (C i)
          (fun j k h => (hB h).mono inter_subset_right inter_subset_right)
      _ = ∑' n, ∑ i ∈ I, ENNReal.ofReal ‖μ.val (C i n)‖ := (Summable.tsum_finsetSum fun _ _ => CompleteLattice.summable).symm
      _ ≤ _ := by
        apply tsum_le_tsum
        intro n
        exact le_sSup ⟨_, I,
        fun i hi j hj hij => (hd hi hj hij).mono inter_subset_left inter_subset_left, hcover n, rfl⟩
  · rw [tsum_eq_iSup_sum]
    apply iSup_le
    intro I
    have hfin : (∑ n ∈ I, μ.operatorVariation (B n)) ≤ μ.operatorVariation (MeasSet.finiteUnion B I) := by
      induction I using Finset.induction_on with
      | empty => simp
      | insert n I hn ih =>
        have he : MeasSet.finiteUnion B (insert n I) = (B n).union (MeasSet.finiteUnion B I) := by
          apply Subtype.ext
          change (⋃ i ∈ insert n I, (B i).1) = (B n).1 ∪ ⋃ i ∈ I, (B i).1
          simp
        have hd : Disjoint (B n).1 (MeasSet.finiteUnion B I).1 := Set.disjoint_left.mpr fun t ht hu => by
          obtain ⟨i, hi, hti⟩ := mem_iUnion₂.mp hu
          exact Set.disjoint_left.mp (hB (fun heq : n = i => hn (heq ▸ hi))) ht hti
        rw [Finset.sum_insert hn, he]
        exact (add_le_add (le_refl _) ih).trans (μ.operatorVariation_add_le (B n) (MeasSet.finiteUnion B I) hd)
    exact hfin.trans (μ.operatorVariation_mono fun t ht => by
      obtain ⟨i, _, hi⟩ := mem_iUnion₂.mp ht
      exact mem_iUnion.mpr ⟨i, hi⟩)

/-- The extended operator variation used in §4 and §5 is an actual
positive measure even when the OVM is only strongly countably additive. -/
def OVM.operatorVariationMeasure (μ : OVM Ω X) : Measure Ω :=
  Measure.ofMeasurable (fun s hs => μ.operatorVariation ⟨s, hs⟩)
    μ.operatorVariation_empty (by
      intro f hf hd
      exact μ.operatorVariation_iUnion (fun i => ⟨f i, hf i⟩) hd)

theorem OVM.operatorVariationMeasure_apply (μ : OVM Ω X) (A : MeasSet Ω) :
    μ.operatorVariationMeasure A.1 = μ.operatorVariation A :=
  Measure.ofMeasurable_apply A.1 A.2

#print axioms OVM.operatorVariation_iUnion
#print axioms OVM.operatorVariationMeasure_apply




/-- A σ-finite operator variation supplies the disjoint finite-variation
partition used in the local-variation theorem. -/
theorem OVM.exists_operatorVariation_partition (μ : OVM Ω X)
    [SigmaFinite μ.operatorVariationMeasure] :
    ∃ B : ℕ → MeasSet Ω, MeasSet.DisjointSeq B ∧ MeasSet.iUnion B = MeasSet.whole ∧
      ∀ n, μ.operatorVariation (B n) < ⊤ := by
  let ν := μ.operatorVariationMeasure
  let A := spanningSets ν
  let B (n : ℕ) : MeasSet Ω :=
    ⟨disjointed A n, MeasurableSet.disjointed (measurableSet_spanningSets ν) n⟩
  refine ⟨B, disjoint_disjointed A, Subtype.ext (iUnion_disjointed.trans (iUnion_spanningSets ν)), fun n => ?_⟩
  rw [← μ.operatorVariationMeasure_apply]
  exact (measure_mono (disjointed_subset A n)).trans_lt (measure_spanningSets_lt_top ν n)

theorem OVM.sigmaFinite_operatorVariation_reflexive_dilation [CompleteSpace X]
    (μ : OVM Ω X) (hμ : μ.Normalized) [SigmaFinite μ.operatorVariationMeasure] :
    (∃ F : DilationSpace μ, letI := F.normedGroup; letI := F.normedScalar; IsReflexive F.carrier) ↔
      IsReflexive X := by
  obtain ⟨B, hB, hcover, hfin⟩ := μ.exists_operatorVariation_partition
  exact μ.operatorVariation_reflexive_dilation hμ B hB hcover hfin

#print axioms OVM.sigmaFinite_operatorVariation_reflexive_dilation

end OperatorVariationMeasure
noncomputable section DiscreteReflexiveFrame

open MeasureTheory
open scoped ENNReal

variable {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X]

private theorem MeasSet.natAtom_partition {E : ℕ → MeasSet ℕ} {I : Finset ℕ} {n : ℕ}
    (hE : (↑I : Set ℕ).Pairwise (fun i j => Disjoint (E i).1 (E j).1))
    (hI : MeasSet.finiteUnion E I = MeasSet.natAtom n) :
    ∃ k ∈ I, E k = MeasSet.natAtom n ∧ ∀ j ∈ I, j ≠ k → E j = MeasSet.empty := by
  have hn : n ∈ (MeasSet.finiteUnion E I).1 := by rw [hI]; exact mem_singleton n
  obtain ⟨k, hk, hnk⟩ := mem_iUnion₂.mp hn
  have hsub (i : ℕ) (hi : i ∈ I) : (E i).1 ⊆ ({n} : Set ℕ) := by
    intro t ht
    have hu : t ∈ (MeasSet.finiteUnion E I).1 := mem_iUnion₂.mpr ⟨i, hi, ht⟩
    rw [hI] at hu
    exact hu
  refine ⟨k, hk, Subtype.ext (Subset.antisymm (hsub _ hk) (singleton_subset_iff.mpr hnk)),
    fun j hj hjk => Subtype.ext (eq_empty_iff_forall_notMem.mpr fun t ht => ?_)⟩
  have htn : t = n := hsub _ hj ht
  exact Set.disjoint_left.mp (hE hj hk hjk) ht (htn ▸ hnk)

omit [CompleteSpace X] in
theorem OVM.operatorVariation_natAtom (μ : OVM ℕ X) (n : ℕ) :
    μ.operatorVariation (MeasSet.natAtom n) = ENNReal.ofReal ‖μ.val (MeasSet.natAtom n)‖ := by
  let A := MeasSet.natAtom n
  apply le_antisymm
  · apply sSup_le
    rintro _ ⟨E, I, hd, hI, rfl⟩
    obtain ⟨k, hk, he, hrest⟩ := MeasSet.natAtom_partition hd hI
    rw [Finset.sum_eq_single_of_mem k hk, he]
    intro j hj hjk
    rw [hrest j hj hjk, μ.empty_eq, norm_zero, ENNReal.ofReal_zero]
  · apply le_sSup
    refine ⟨fun _ => A, {0}, ?_, ?_, by simp [A]⟩
    · simp
    · apply Subtype.ext
      change (⋃ j ∈ ({0} : Finset ℕ), A.1) = A.1
      simp

omit [CompleteSpace X] in
theorem OVM.orbitVariation_natAtom (μ : OVM ℕ X) (x : X) (n : ℕ) :
    μ.orbitVariation x (MeasSet.natAtom n) = ENNReal.ofReal ‖μ.val (MeasSet.natAtom n) x‖ := by
  let A := MeasSet.natAtom n
  apply le_antisymm
  · apply sSup_le
    rintro _ ⟨E, I, hd, hI, rfl⟩
    obtain ⟨k, hk, he, hrest⟩ := MeasSet.natAtom_partition hd hI
    rw [Finset.sum_eq_single_of_mem k hk, he]
    intro j hj hjk
    rw [hrest j hj hjk, μ.empty_eq, zero_apply, norm_zero]
  · apply le_sSup
    refine ⟨fun _ => A, {0}, ?_, ?_, by simp [A]⟩
    · simp
    · apply Subtype.ext
      change (⋃ j ∈ ({0} : Finset ℕ), A.1) = A.1
      simp

private theorem MeasSet.natAtom_disjointSeq : MeasSet.DisjointSeq MeasSet.natAtom := by
  intro i j hij
  exact disjoint_singleton.mpr hij

private theorem MeasSet.natAtom_iUnion : MeasSet.iUnion MeasSet.natAtom = MeasSet.whole := by
  apply Subtype.ext
  exact iUnion_singleton_eq_range id |>.trans range_id

private theorem OVM.nat_alphaOrbit_relativelyWeaklyCompact (μ : OVM ℕ X) (hX : IsReflexive X) :
    RelativelyWeaklyCompact μ.alphaMultiplierOrbit := by
  apply μ.alphaOrbit_relativelyWeaklyCompact_of_localVariation MeasSet.natAtom
    MeasSet.natAtom_disjointSeq MeasSet.natAtom_iUnion _ hX
  intro j x
  rw [μ.orbitVariation_natAtom]
  exact ENNReal.ofReal_lt_top
private theorem Dilation.natAtom_range_equiv_alpha {Z : Type*}
    [NormedAddCommGroup Z] [NormedSpace ℝ Z] {μ : OVM ℕ X}
    (D : Dilation μ Z) (J₀ : Z →L[ℝ] μ.alphaSubmodule) (hJ : Function.Injective J₀)
    (hT : J₀.comp D.T = μ.alphaAnalysis)
    (hP : ∀ E : MeasSet ℕ, J₀.comp (D.P.val E) = (μ.alphaPVM.val E).comp J₀)
    (n : ℕ) [Module.Finite ℝ (μ.val (MeasSet.natAtom n)).toLinearMap.range] :
    Nonempty ((D.P.val (MeasSet.natAtom n)).toLinearMap.range ≃ₗ[ℝ]
      (μ.val (MeasSet.natAtom n)).toLinearMap.range) := by
  let A := MeasSet.natAtom n
  let Y := (D.P.val A).toLinearMap.range
  let W := (μ.alphaPVM.val A).toLinearMap.range
  let R := (μ.val A).toLinearMap.range
  let e : W ≃ₗᵢ[ℝ] R := μ.alphaAtomIsometry n
  have hmaps (y : Y) : J₀ y.1 ∈ W := by
    obtain ⟨z, hz⟩ := y.2
    refine ⟨J₀ z, ?_⟩
    exact (DFunLike.congr_fun (hP A) z).symm.trans (congrArg J₀ hz)
  let L : Y →ₗ[ℝ] W := (J₀.toLinearMap.comp Y.subtype).codRestrict W hmaps
  have hSR (x : X) : (e (L ⟨D.P.val A (D.T x), ⟨D.T x, rfl⟩⟩)).1 = μ.val A x := by
    have h := DFunLike.congr_fun (hP A) (D.T x)
    change J₀ (D.P.val A (D.T x)) = μ.alphaPVM.val A (J₀ (D.T x)) at h
    rw [show J₀ (D.T x) = μ.alphaAnalysis x from DFunLike.congr_fun hT x] at h
    change μ.alphaSynthesis (J₀ (D.P.val A (D.T x))) = μ.val A x
    rw [h]
    exact DFunLike.congr_fun (μ.alphaCompression A) x
  have hi : Function.Injective (e.toLinearMap.comp L) := by
    intro y y' h
    apply Subtype.ext
    exact hJ (congrArg Subtype.val (e.injective h))
  have hs : Function.Surjective (e.toLinearMap.comp L) := by
    rintro ⟨_, x, rfl⟩
    exact ⟨⟨D.P.val A (D.T x), ⟨D.T x, rfl⟩⟩, Subtype.ext (hSR x)⟩
  exact ⟨LinearEquiv.ofBijective (e.toLinearMap.comp L) ⟨hi, hs⟩⟩




/-- The reflexive dilation and its atomic decomposition use the same
DFJP lift, so each finite-rank coordinate has exactly the requisite dimension. -/
theorem OVM.nat_reflexive_dilation_with_decomposition (μ : OVM ℕ X) (hμ : μ.Normalized) :
    IsReflexive X ↔
      ∃ F : DilationSpace μ,
        letI := F.normedGroup
        letI := F.normedScalar
        IsReflexive F.carrier ∧
          (∀ z : F.carrier, ∃! v : ℕ → F.carrier,
            (∀ n, v n ∈ (F.dilation.P.val (MeasSet.natAtom n)).toLinearMap.range) ∧ HasSum v z) ∧
          (∀ n, Module.Finite ℝ (μ.val (MeasSet.natAtom n)).toLinearMap.range →
            Nonempty ((F.dilation.P.val (MeasSet.natAtom n)).toLinearMap.range ≃ₗ[ℝ]
              (μ.val (MeasSet.natAtom n)).toLinearMap.range)) := by
  constructor
  · intro hX
    obtain ⟨M, D, hT, hP⟩ := μ.exists_alphaDFJP_with_cuts hμ
    let : NormedAddCommGroup M.carrier := M.normedGroup
    let : NormedSpace ℝ M.carrier := M.normedScalar
    have hr := M.reflexive (citeKreinClosedConvexHull (μ.nat_alphaOrbit_relativelyWeaklyCompact hX))
    refine ⟨⟨M.carrier, M.normedGroup, M.normedScalar, M.complete, D⟩,
      hr, D.P.nat_unconditionalDecomposition, fun n hn => ?_⟩
    let _ := hn
    exact D.natAtom_range_equiv_alpha M.inclusion M.injective hT hP n
  · rintro ⟨F, hF, _, _⟩
    let _ := F.normedGroup
    let _ := F.normedScalar
    exact F.dilation.reflexive_underlying_of_reflexive hF

#print axioms OVM.operatorVariation_natAtom
#print axioms OVM.orbitVariation_natAtom
#print axioms OVM.nat_reflexive_dilation_with_decomposition

end DiscreteReflexiveFrame


noncomputable section RadonNikodymAssembly

open MeasureTheory
open scoped ENNReal

universe uΛ uX

variable {Λ : Type uΛ} {X : Type uX}
  [MeasurableSpace Λ] [NormedAddCommGroup X] [NormedSpace ℝ X]

def BoundedVectorVariation (v : MeasSet Λ → X) : Prop :=
  ∃ M : ℝ, ∀ (D : ℕ → MeasSet Λ), MeasSet.DisjointSeq D →
    ∀ I : Finset ℕ, ∑ n ∈ I, ‖v (D n)‖ ≤ M

/-- The Radon–Nikodým property, tested against arbitrary finite positive
measures and absolutely continuous vector measures of bounded variation. -/
def HasRadonNikodymProperty (X : Type uX) [NormedAddCommGroup X] [NormedSpace ℝ X] : Prop :=
  ∀ (Λ : Type uΛ) [MeasurableSpace Λ] (ρ : Measure Λ) [IsFiniteMeasure ρ]
    (v : MeasSet Λ → X), v MeasSet.empty = 0 →
    (∀ D : ℕ → MeasSet Λ, MeasSet.DisjointSeq D →
      HasSum (fun n => v (D n)) (v (MeasSet.iUnion D))) →
    (∀ A : MeasSet Λ, ρ A.1 = 0 → v A = 0) →
    BoundedVectorVariation v →
    ∃ g : Λ → X, Integrable g ρ ∧ ∀ E : MeasSet Λ, v E = ∫ t in E.1, g t ∂ρ

/-- Scalar Radon–Nikodým applied to the finite positive variation of a
vector measure, Diestel–Uhl, Vector Measures, Chapters I–II. -/
axiom citeScalarDensityOfVectorVariation (ρ : Measure Λ) [IsFiniteMeasure ρ]
    (v : MeasSet Λ → X) (h₀ : v MeasSet.empty = 0)
    (hσ : ∀ D : ℕ → MeasSet Λ, MeasSet.DisjointSeq D →
      HasSum (fun n => v (D n)) (v (MeasSet.iUnion D)))
    (hρ : ∀ E : MeasSet Λ, ρ E.1 = 0 → v E = 0) (hv : BoundedVectorVariation v) :
    ∃ r : Λ → ℝ, Integrable r ρ ∧ (∀ᵐ t ∂ρ, 0 ≤ r t) ∧ ∀ (E : MeasSet Λ) (D : ℕ → MeasSet Λ) (I : Finset ℕ),
      (↑I : Set ℕ).Pairwise (fun i j => Disjoint (D i).1 (D j).1) →
      MeasSet.finiteUnion D I = E → ∑ n ∈ I, ‖v (D n)‖ ≤ ∫ t in E.1, r t ∂ρ

structure ReflexiveOperatorFactorization (T : X →L[ℝ] X) where
  carrier : Type uX
  group : NormedAddCommGroup carrier
  scalar : letI := group; NormedSpace ℝ carrier
  complete : letI := group; CompleteSpace carrier
  reflexive : letI := group; letI := scalar; IsReflexive carrier
  analysis : letI := group; letI := scalar; X →L[ℝ] carrier
  synthesis : letI := group; letI := scalar; carrier →L[ℝ] X
  factorization : letI := group; letI := scalar; synthesis.comp analysis = T

/-- Davis–Figiel–Johnson–Pełczyński factorization of a weakly compact
operator through a reflexive Banach space. -/
axiom citeDFJPWeaklyCompactOperator [CompleteSpace X] (T : X →L[ℝ] X)
    (hT : RelativelyWeaklyCompact (T '' Metric.closedBall 0 1)) :
    Nonempty (ReflexiveOperatorFactorization T)

variable [CompleteSpace X]

omit [CompleteSpace X] in
private theorem boundedVectorVariation_comp
    {Y : Type*} [NormedAddCommGroup Y] [NormedSpace ℝ Y]
    {v : MeasSet Λ → X} (hv : BoundedVectorVariation v) (T : X →L[ℝ] Y) :
    BoundedVectorVariation (fun E => T (v E)) := by
  obtain ⟨M, hM⟩ := hv
  refine ⟨‖T‖ * M, fun D hD I => ?_⟩
  calc
    _ ≤ ∑ n ∈ I, ‖T‖ * ‖v (D n)‖ := Finset.sum_le_sum fun n _ => T.le_opNorm _
    _ = ‖T‖ * ∑ n ∈ I, ‖v (D n)‖ := (Finset.mul_sum _ _ _).symm
    _ ≤ _ := mul_le_mul_of_nonneg_left (hM D hD I) (norm_nonneg _)

private theorem ReflexiveOperatorFactorization.orbit_density (T : X →L[ℝ] X)
    (F : ReflexiveOperatorFactorization T) (ρ : Measure Λ) [IsFiniteMeasure ρ]
    (v : MeasSet Λ → X) (h₀ : v MeasSet.empty = 0)
    (hσ : ∀ D : ℕ → MeasSet Λ, MeasSet.DisjointSeq D →
      HasSum (fun n => v (D n)) (v (MeasSet.iUnion D)))
    (hρ : ∀ E : MeasSet Λ, ρ E.1 = 0 → v E = 0) (hv : BoundedVectorVariation v) :
    ∃ g : Λ → X, Integrable g ρ ∧ ∀ E : MeasSet Λ, T (v E) = ∫ t in E.1, g t ∂ρ := by
  let _ := F.group
  let _ := F.scalar
  let _ := F.complete
  obtain ⟨h, hi, he⟩ := citeReflexiveVectorRadonNikodym ρ F.reflexive
    (fun E => F.analysis (v E)) (by rw [h₀, map_zero])
    (fun D hD => F.analysis.hasSum (hσ D hD))
    (fun E hn => by rw [hρ E hn, map_zero]) (boundedVectorVariation_comp hv F.analysis)
  refine ⟨fun t => F.synthesis (h t), F.synthesis.integrable_comp hi, fun E => ?_⟩
  rw [F.synthesis.integral_comp_comm hi.restrict, ← he E]
  exact (DFunLike.congr_fun F.factorization (v E)).symm

/-- Assemble the vector Radon–Nikodým density from a resolution of the
identity by weakly compact operators with uniformly bounded finite
subsums. The absence of c₀ supplies unconditional convergence a.e. -/
theorem hasRadonNikodymProperty_of_weaklyCompact_resolution
    (hX : ¬ ContainsCopy CZero X) (A : ℕ → X →L[ℝ] X)
    (hA : ∀ n, RelativelyWeaklyCompact (A n '' Metric.closedBall 0 1))
    (hId : ∀ x, HasSum (fun n => A n x) x)
    (C : ℝ) (hC : 0 ≤ C) (hB : ∀ I : Finset ℕ, ‖∑ n ∈ I, A n‖ ≤ C) :
    HasRadonNikodymProperty.{uΛ} X := by
  classical
  intro Λ _ ρ _ v h₀ hσ hρ hv
  let F (n : ℕ) := Classical.choice (citeDFJPWeaklyCompactOperator (A n) (hA n))
  choose g hg hG using fun n => (F n).orbit_density (A n) ρ v h₀ hσ hρ hv
  obtain ⟨r, hr, hr₀, hR⟩ := citeScalarDensityOfVectorVariation ρ v h₀ hσ hρ hv
  let U (I : Finset ℕ) (t : Λ) := ∑ n ∈ I, g n t
  have hUi (I : Finset ℕ) : Integrable (U I) ρ := integrable_finsetSum I fun n _ => hg n
  have hEval (I : Finset ℕ) (E : MeasSet Λ) :
      (∫ t in E.1, U I t ∂ρ) = (∑ n ∈ I, A n) (v E) := by
    change (∫ t in E.1, ∑ n ∈ I, g n t ∂ρ) = _
    rw [integral_finsetSum I (fun n _ => (hg n).restrict), sum_apply]
    exact Finset.sum_congr rfl (fun n _ => (hG n E).symm)
  have hbound (I : Finset ℕ) : ∀ᵐ t ∂ρ, ‖U I t‖ ≤ C * r t := by
    apply ae_le_of_forall_setIntegral_le (hUi I).norm (hr.const_mul C)
    intro E hE _
    rw [integral_const_mul]
    apply (ENNReal.ofReal_le_ofReal_iff (mul_nonneg hC (integral_nonneg_of_ae (ae_restrict_of_ae hr₀)))).mp
    rw [← citeBochnerDensityVariation ρ (U I) (hUi I) ⟨E, hE⟩]
    apply sSup_le
    rintro _ ⟨D, J, hd, hD, rfl⟩
    apply ENNReal.ofReal_le_ofReal
    calc
      _ ≤ ∑ n ∈ J, C * ‖v (D n)‖ := Finset.sum_le_sum fun n _ => by
        rw [hEval]
        exact ((∑ i ∈ I, A i).le_opNorm _).trans (mul_le_mul_of_nonneg_right (hB I) (norm_nonneg _))
      _ ≤ _ := by
        rw [← Finset.mul_sum]
        exact mul_le_mul_of_nonneg_left (hR ⟨E, hE⟩ D J hd hD) hC
  have hAll : ∀ᵐ t ∂ρ, ∀ I : Finset ℕ, ‖U I t‖ ≤ C * r t := ae_all_iff.mpr hbound
  let G (t : Λ) := ∑' n, g n t
  have hconv : ∀ᵐ t ∂ρ, Tendsto (fun N => U (Finset.range N) t) atTop (𝓝 (G t)) := by
    filter_upwards [hAll] with t ht
    have hs : Summable (fun n => g n t) := by
      apply summable_of_not_contains_cZero hX
      intro f
      apply summable_of_sum_le (fun _ => abs_nonneg _)
      intro I
      apply real_abs_finite_subsum_le
      intro J
      rw [← map_sum, ← Real.norm_eq_abs]
      exact (f.le_opNorm _).trans (mul_le_mul_of_nonneg_left (ht J) (norm_nonneg _))
    exact hs.hasSum.tendsto_sum_nat
  have hGi : Integrable G ρ := by
    have hm : AEStronglyMeasurable G ρ :=
      aestronglyMeasurable_of_tendsto_ae _ (fun n => (hUi (Finset.range n)).aestronglyMeasurable) hconv
    apply (hr.const_mul C).mono' hm
    filter_upwards [hAll, hconv] with t hb ht
    exact le_of_tendsto ((continuous_norm.tendsto _).comp ht)
      (Eventually.of_forall fun n => hb (Finset.range n))
  refine ⟨G, hGi, fun E => ?_⟩
  have hlim := tendsto_integral_of_dominated_convergence (μ := ρ.restrict E.1)
    (fun t => C * r t) (fun n => (hUi (Finset.range n)).aestronglyMeasurable.restrict)
    (hr.const_mul C).restrict (fun n => ae_restrict_of_ae (hbound (Finset.range n))) (ae_restrict_of_ae hconv)
  simp_rw [hEval] at hlim
  have he := (hId (v E)).tendsto_sum_nat
  simp_rw [sum_apply] at hlim
  exact tendsto_nhds_unique he hlim

#print axioms hasRadonNikodymProperty_of_weaklyCompact_resolution

end RadonNikodymAssembly



noncomputable section VectorMeasureNormCoordinates

open MeasureTheory
open scoped ENNReal

universe uΩ uX uΛ

variable {Ω : Type uΩ} {X : Type uX} [MeasurableSpace Ω]
  [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X]

/-- Scalar coordinates of the standard vector-measure L¹ model with
its variation norm tested against the scalar Radon–Nikodým derivatives. -/
structure VectorMeasureNormCoordinates (m : MeasSet Ω → X) (M : VectorMeasureL1Model m) where
  ρ : Measure Ω
  finite : IsFiniteMeasure ρ
  scalar : letI := M.normedGroup; letI := M.normedScalar; KotheScalarSpace ρ M.carrier
  cut_repr : letI := M.normedGroup; letI := M.normedScalar; ∀ E y,
    (scalar.repr (M.data.multiplication.val E y) : Ω → ℝ) =ᵐ[ρ] E.1.indicator (scalar.repr y)
  k : Dual X → Ω → ℝ
  measurable_density : ∀ f, Measurable (k f)
  integrable : letI := M.normedGroup; letI := M.normedScalar; ∀ y f,
    Integrable (fun t => scalar.repr y t * k f t) ρ
  evaluate : letI := M.normedGroup; letI := M.normedScalar; ∀ y f (E : MeasSet Ω),
    f (M.data.integration (M.data.multiplication.val E y)) =
      ∫ t in E.1, scalar.repr y t * k f t ∂ρ
  norm_bound : letI := M.normedGroup; letI := M.normedScalar; ∀ y (C : ℝ), 0 ≤ C →
    (∀ f : Dual X, ‖f‖ ≤ 1 → (∫ t, |scalar.repr y t * k f t| ∂ρ) ≤ C) → ‖y‖ ≤ C

/-- The standard control measure, scalar Radon–Nikodým formulas and norm
formula for L¹(m), using the same completion of simple functions as the
vector-measure integration theorem. -/
axiom citeVectorMeasureL1NormCoordinates (m : MeasSet Ω → X)
    (h₀ : m MeasSet.empty = 0)
    (hσ : ∀ D : ℕ → MeasSet Ω, MeasSet.DisjointSeq D →
      HasSum (fun n => m (D n)) (m (MeasSet.iUnion D))) :
    Nonempty (VectorMeasureNormCoordinates m (standardVectorMeasureL1 m h₀ hσ))

variable {Y : Type*} [NormedAddCommGroup Y] [NormedSpace ℝ Y] {ρ : Measure Ω}

private def KotheScalarSpace.orderInterval (S : KotheScalarSpace ρ Y) (H : Y) : Set Y :=
  {y | ∀ᵐ t ∂ρ, |S.repr y t| ≤ S.repr H t}

/-- Closedness of the positive cone in a Banach lattice and weak compactness
of order intervals in an order-continuous Banach lattice. -/
axiom citeOrderContinuousKotheIntervals (S : KotheScalarSpace ρ Y) :
    (∀ y : Y, IsClosed {H : Y | y ∈ S.orderInterval H}) ∧
    ∀ H : Y, IsClosed (S.orderInterval H) ∧ RelativelyWeaklyCompact (S.orderInterval H)

private theorem KotheScalarSpace.exists_abs (S : KotheScalarSpace ρ Y) (x : Y) :
    ∃ v : Y, (fun t => S.repr v t) =ᵐ[ρ] fun t => |S.repr x t| := by
  let a := AEEqFun.comp abs continuous_abs (S.repr x)
  have ha : (a : Ω → ℝ) =ᵐ[ρ] fun t => |S.repr x t| :=
    AEEqFun.coeFn_comp abs continuous_abs (S.repr x)
  obtain ⟨v, hv, _⟩ := S.solid x a (by
    filter_upwards [ha] with t ht
    rw [ht, abs_abs])
  exact ⟨v, by rw [hv]; exact ha⟩

private theorem KotheScalarSpace.exists_max_abs (S : KotheScalarSpace ρ Y)
    (x y : Y) (hx : ∀ᵐ t ∂ρ, 0 ≤ S.repr x t) :
    ∃ z : Y, (fun t => S.repr z t) =ᵐ[ρ] fun t => max (S.repr x t) |S.repr y t| := by
  obtain ⟨v, hv⟩ := S.exists_abs y
  let w (t : Ω) := max (S.repr x t) |S.repr y t|
  have hw : StronglyMeasurable w := ((S.repr x).stronglyMeasurable.measurable.sup
    (continuous_abs.measurable.comp (S.repr y).stronglyMeasurable.measurable)).stronglyMeasurable
  let a : Ω →ₘ[ρ] ℝ := AEEqFun.mk w hw.aestronglyMeasurable
  have ha : (a : Ω → ℝ) =ᵐ[ρ] w := AEEqFun.coeFn_mk _ _
  have hadd : (S.repr (x + v) : Ω → ℝ) =ᵐ[ρ] fun t => S.repr x t + S.repr v t := by
    rw [map_add]
    exact AEEqFun.coeFn_add _ _
  obtain ⟨z, hz, _⟩ := S.solid (x + v) a (by
    filter_upwards [ha, hadd, hv, hx] with t ha hc hb hp
    rw [ha, hc, hb]
    change abs (max (S.repr x t) (abs (S.repr y t))) ≤ abs (S.repr x t + abs (S.repr y t))
    rw [abs_of_nonneg (hp.trans (le_max_left _ _)),
      abs_of_nonneg (add_nonneg hp (abs_nonneg _))]
    exact max_le (le_add_of_nonneg_right (abs_nonneg _)) (le_add_of_nonneg_left hp))
  exact ⟨z, by rw [hz]; exact ha⟩

private theorem KotheScalarSpace.exists_maxAbsSeq (S : KotheScalarSpace ρ Y) (y : ℕ → Y) :
    ∃ H : ℕ → Y, H 0 = 0 ∧
      (∀ n, ∀ᵐ t ∂ρ, 0 ≤ S.repr (H n) t) ∧
      ∀ n, (fun t => S.repr (H (n + 1)) t) =ᵐ[ρ]
        fun t => max (S.repr (H n) t) |S.repr (y n) t| := by
  have hz : (fun t => S.repr 0 t) =ᵐ[ρ] fun _ => 0 := by
    rw [map_zero]
    exact AEEqFun.coeFn_zero
  let Acc := {v : Y // ∀ᵐ t ∂ρ, 0 ≤ S.repr v t}
  let next (n : ℕ) (v : Acc) : Acc := by
    let z := (S.exists_max_abs v.1 (y n) v.2).choose
    refine ⟨z, ?_⟩
    filter_upwards [(S.exists_max_abs v.1 (y n) v.2).choose_spec] with t ht
    rw [ht]
    exact (abs_nonneg _).trans (le_max_right _ _)
  let G (n : ℕ) : Acc := Nat.rec ⟨0, by filter_upwards [hz] with t ht; rw [ht]⟩ next n
  refine ⟨fun n => (G n).1, rfl, fun n => (G n).2, fun n => ?_⟩
  exact (S.exists_max_abs (G n).1 (y n) (G n).2).choose_spec

private theorem RelativelyWeaklyCompact.subset_of_relativelyWeaklyCompact {K L : Set Y}
    (hL : RelativelyWeaklyCompact L) (hKL : K ⊆ L) : RelativelyWeaklyCompact K := by
  exact hL.of_isClosed_subset isClosed_closure (closure_mono (Set.image_mono hKL))

private theorem finite_measure_integral_max_le (ρ ν : Measure Ω) [IsFiniteMeasure ν]
    (a b : Ω → ℝ) (ha : Integrable a ρ) (hb : Integrable b ρ) (hm : MeasurableSet {t | b t ≤ a t})
    (hA : ∀ E : MeasSet Ω, (∫ t in E.1, a t ∂ρ) ≤ (ν E.1).toReal)
    (hB : ∀ E : MeasSet Ω, (∫ t in E.1, b t ∂ρ) ≤ (ν E.1).toReal)
    (E : MeasSet Ω) :
    (∫ t in E.1, max (a t) (b t) ∂ρ) ≤ (ν E.1).toReal := by
  let D : MeasSet Ω := ⟨{t | b t ≤ a t}, hm⟩
  let U := E.inter D
  let V := E.diff D
  have hUV : U.union V = E := Subtype.ext (inter_union_sdiff E.1 D.1)
  have hdis : Disjoint U.1 V.1 := disjoint_sdiff_right.mono_left inter_subset_right
  have hi : Integrable (fun t => max (a t) (b t)) ρ := ha.sup hb
  have h₁ : (∫ t in U.1, max (a t) (b t) ∂ρ) = ∫ t in U.1, a t ∂ρ :=
    setIntegral_congr_fun U.2 (fun t ht => max_eq_left ht.2)
  have h₂ : (∫ t in V.1, max (a t) (b t) ∂ρ) = ∫ t in V.1, b t ∂ρ :=
    setIntegral_congr_fun V.2 (fun t ht => max_eq_right ((lt_of_not_ge ht.2).le))
  calc
    _ = (∫ t in U.1, a t ∂ρ) + ∫ t in V.1, b t ∂ρ := by
      rw [← hUV, show (U.union V).1 = U.1 ∪ V.1 from rfl,
        setIntegral_union hdis V.2 hi.integrableOn hi.integrableOn, h₁, h₂]
    _ ≤ (ν U.1).toReal + (ν V.1).toReal := add_le_add (hA U) (hB V)
    _ = _ := by
      rw [← ENNReal.toReal_add (measure_ne_top ν _) (measure_ne_top ν _), ← measure_union hdis V.2]
      rw [show U.1 ∪ V.1 = E.1 from congrArg Subtype.val hUV]




set_option maxHeartbeats 900000 in
/-- The local weak compactness step in prop:variation-rnp. The finite
running maxima of the moduli of a dense sequence of cut analyses have
bounded L¹(m) norm. The KB limit gives a single weakly compact interval. -/
theorem OVM.weaklyCompact_cut_of_cyclic_variation [TopologicalSpace.SeparableSpace X]
    (μ : OVM Ω X) (hμ : μ.Normalized) (hcyc : μ.alphaPVM.Cyclic)
    (hc₀ : ¬ ContainsCopy CZero X) (D : MeasSet Ω) (hfin : μ.operatorVariation D < ⊤) :
    RelativelyWeaklyCompact (μ.val D '' Metric.closedBall 0 1) := by
  obtain ⟨u, hu⟩ := hcyc
  let A := μ.alphaDilation hμ
  let m := A.cyclicVectorMeasure u
  let h₀ := A.cyclicVectorMeasure_empty u
  let hσ := A.cyclicVectorMeasure_hasSum u
  let M := standardVectorMeasureL1 m h₀ hσ
  let _ := M.normedGroup
  let _ := M.normedScalar
  let _ := M.isComplete
  let C := Classical.choice (citeVectorMeasureL1NormCoordinates m h₀ hσ)
  let ρ := C.ρ
  let S := C.scalar
  let Q := M.data.multiplication
  let R := M.data.integration
  obtain ⟨_, D₀, _, _, hp, hs, _, _, _⟩ := A.vectorMeasureL1_dilation u hu M.data
  let T₀ := D₀.T
  have hcomp (E : MeasSet Ω) (x : X) : R (Q.val E (T₀ x)) = μ.val E x := by
    change M.data.integration (M.data.multiplication.val E (D₀.T x)) = _
    rw [← hs, ← hp]
    exact DFunLike.congr_fun (D₀.compress E) x
  have hkb₀ : M.data.IsKB := (A.exists_vectorMeasureL1_KB_dilation u hu hc₀).1
  have hkb : KotheKB S := (citeKotheKB S).mp ((citeKitoverOrhon2017_L1_KB m h₀ hσ).mp hkb₀)
  let U := Metric.closedBall (0 : X) 1
  let _ : Nonempty U := ⟨⟨0, mem_closedBall_zero_iff.mpr (by simp)⟩⟩
  let d : ℕ → U := TopologicalSpace.denseSeq U
  let L := (Q.val D).comp T₀
  let y (n : ℕ) := L (d n)
  let ν := μ.operatorVariationMeasure.restrict D.1
  have hν (E : MeasSet Ω) : ν E.1 = μ.operatorVariation (E.inter D) := by
    rw [show ν = μ.operatorVariationMeasure.restrict D.1 from rfl, Measure.restrict_apply E.2]
    exact μ.operatorVariationMeasure_apply (E.inter D)
  let _ : IsFiniteMeasure ν := ⟨by
    rw [show ν univ = ν MeasSet.whole.1 from rfl, hν,
      show MeasSet.whole.inter D = D from Subtype.ext (univ_inter _)]
    exact hfin⟩
  have hcoef (n : ℕ) (f : Dual X) (E : MeasSet Ω) :
      (∫ t in E.1, S.repr (y n) t * C.k f t ∂ρ) = f (μ.val (E.inter D) (d n)) := by
    rw [← C.evaluate]
    change f (R (Q.val E (Q.val D (T₀ (d n))))) = _
    have h := DFunLike.congr_fun (Q.mul_eq E D) (T₀ (d n))
    change Q.val E (Q.val D (T₀ (d n))) = Q.val (E.inter D) (T₀ (d n)) at h
    rw [h, hcomp]
  have hbasic (n : ℕ) (f : Dual X) (hf : ‖f‖ ≤ 1) (E : MeasSet Ω) :
      (∫ t in E.1, |S.repr (y n) t * C.k f t| ∂ρ) ≤ (ν E.1).toReal := by
    have hh := citeBochnerDensityVariation ρ (fun t => S.repr (y n) t * C.k f t)
      (C.integrable (y n) f) E
    simp only [Real.norm_eq_abs] at hh
    apply (ENNReal.ofReal_le_ofReal_iff ENNReal.toReal_nonneg).mp
    rw [← hh, ENNReal.ofReal_toReal (measure_ne_top ν _), hν]
    apply sSup_le
    rintro _ ⟨B, I, hB, hI, rfl⟩
    let F (i : ℕ) := (B i).inter D
    have hF : MeasSet.finiteUnion F I = E.inter D := by
      apply Subtype.ext
      change (⋃ i ∈ I, (B i).1 ∩ D.1) = E.1 ∩ D.1
      simp_rw [← iUnion_inter]
      exact congrArg (fun J : MeasSet Ω => J.1 ∩ D.1) hI
    have hsF : (∑ i ∈ I, ENNReal.ofReal ‖μ.val (F i)‖) ≤ μ.operatorVariation (E.inter D) :=
      le_sSup ⟨F, I, fun i hi j hj hij => (hB hi hj hij).mono inter_subset_left inter_subset_left, hF, rfl⟩
    apply le_trans _ hsF
    change ENNReal.ofReal (∑ i ∈ I, ‖∫ t in (B i).1, S.repr (y n) t * C.k f t ∂ρ‖) ≤ _
    rw [ENNReal.ofReal_sum_of_nonneg (fun i _ => norm_nonneg _)]
    apply Finset.sum_le_sum
    intro i hi
    apply ENNReal.ofReal_le_ofReal
    rw [hcoef]
    have hx : ‖(d n : X)‖ ≤ 1 := mem_closedBall_zero_iff.mp (d n).2
    exact (f.le_opNorm _).trans ((mul_le_mul_of_nonneg_right hf (norm_nonneg _)).trans_eq (one_mul _) |>.trans
      (((μ.val (F i)).le_opNorm _).trans
        ((mul_le_mul_of_nonneg_left hx (norm_nonneg _)).trans_eq (mul_one _))))
  obtain ⟨H, hH0, hpos, hstep⟩ := S.exists_maxAbsSeq y
  have hInt (n : ℕ) (f : Dual X) (hf : ‖f‖ ≤ 1) (E : MeasSet Ω) :
      (∫ t in E.1, |S.repr (H n) t * C.k f t| ∂ρ) ≤ (ν E.1).toReal := by
    induction n generalizing E with
    | zero =>
      have hzero : (fun t => S.repr (H 0) t) =ᵐ[ρ] fun _ => 0 := by
        rw [hH0, map_zero]
        exact AEEqFun.coeFn_zero
      have he : (fun t => |S.repr (H 0) t * C.k f t|) =ᵐ[ρ.restrict E.1] fun _ => 0 := by
        filter_upwards [ae_restrict_of_ae hzero] with t ht
        rw [ht, zero_mul, abs_zero]
      rw [integral_congr_ae he, integral_zero]
      exact ENNReal.toReal_nonneg
    | succ n ih =>
      let a (t : Ω) := |S.repr (H n) t * C.k f t|
      let b (t : Ω) := |S.repr (y n) t * C.k f t|
      have he : (fun t => |S.repr (H (n + 1)) t * C.k f t|) =ᵐ[ρ.restrict E.1]
          fun t => max (a t) (b t) := by
        filter_upwards [ae_restrict_of_ae (hstep n), ae_restrict_of_ae (hpos n)] with t ht hp₀
        rw [ht, abs_mul, abs_of_nonneg (hp₀.trans (le_max_left _ _))]
        change _ = max (abs (S.repr (H n) t * C.k f t)) (abs (S.repr (y n) t * C.k f t))
        rw [abs_mul, abs_of_nonneg hp₀, abs_mul, max_mul_of_nonneg _ _ (abs_nonneg _)]
      rw [integral_congr_ae he]
      exact finite_measure_integral_max_le ρ ν a b (C.integrable (H n) f).abs (C.integrable (y n) f).abs
        (measurableSet_le
          (continuous_abs.measurable.comp ((S.repr (y n)).stronglyMeasurable.measurable.mul (C.measurable_density f)))
          (continuous_abs.measurable.comp ((S.repr (H n)).stronglyMeasurable.measurable.mul (C.measurable_density f))))
        ih (hbasic n f hf) E
  have hnorm (n : ℕ) : ‖H n‖ ≤ (ν univ).toReal := by
    apply C.norm_bound _ _ ENNReal.toReal_nonneg
    intro f hf
    simpa only [MeasSet.whole, setIntegral_univ] using hInt n f hf MeasSet.whole
  have hmono : ∀ i j, i ≤ j → ∀ᵐ t ∂ρ, S.repr (H i) t ≤ S.repr (H j) t := by
    have hM : ∀ᵐ t ∂ρ, ∀ n, S.repr (H n) t ≤ S.repr (H (n + 1)) t :=
      ae_all_iff.mpr (fun n => by filter_upwards [hstep n] with t ht; rw [ht]; exact le_max_left _ _)
    intro i j hij
    filter_upwards [hM] with t ht
    exact monotone_nat_of_le_succ ht hij
  obtain ⟨Hlim, hH⟩ := hkb H hpos hmono ⟨_, hnorm⟩
  obtain ⟨hclosedUpper, hIntervals⟩ := citeOrderContinuousKotheIntervals S
  obtain ⟨hIntervalClosed, hIntervalCompact⟩ := hIntervals Hlim
  have hy (n : ℕ) : y n ∈ S.orderInterval Hlim := by
    apply (hclosedUpper (y n)).mem_of_tendsto hH
    filter_upwards [eventually_ge_atTop (n + 1)] with j hj
    filter_upwards [hstep n, hmono (n + 1) j hj] with t ht hh
    exact (le_max_right _ _).trans (ht ▸ hh)
  have hBall : L '' U ⊆ S.orderInterval Hlim := by
    rintro _ ⟨x, hx, rfl⟩
    let F : U → M.carrier := fun z => L z
    have hcl : IsClosed (F ⁻¹' S.orderInterval Hlim) :=
      hIntervalClosed.preimage (L.continuous.comp continuous_subtype_val)
    have hD : Set.range d ⊆ F ⁻¹' S.orderInterval Hlim := by rintro _ ⟨n, rfl⟩; exact hy n
    have hxcl : (⟨x, hx⟩ : U) ∈ closure (Set.range d) := (TopologicalSpace.denseRange_denseSeq U) ⟨x, hx⟩
    have hmem : (⟨x, hx⟩ : U) ∈ F ⁻¹' S.orderInterval Hlim := closure_minimal hD hcl hxcl
    exact hmem
  have hImage : μ.val D '' U = R '' (L '' U) := by
    rw [Set.image_image]
    exact Set.image_congr fun x _ => (hcomp D x).symm
  rw [hImage]
  exact relativelyWeaklyCompact_image (hIntervalCompact.subset_of_relativelyWeaklyCompact hBall) R

/-- Manuscript, prop:variation-rnp. Cyclicity and σ-finite operator
variation yield a weakly compact resolution of the identity. -/
theorem OVM.hasRadonNikodymProperty_of_cyclic_sigmaFinite_variation
    [TopologicalSpace.SeparableSpace X] (μ : OVM Ω X) (hμ : μ.Normalized)
    (hcyc : μ.alphaPVM.Cyclic) (hc₀ : ¬ ContainsCopy CZero X)
    [SigmaFinite μ.operatorVariationMeasure] :
    HasRadonNikodymProperty.{uΛ} X := by
  obtain ⟨B, hB, hcover, hfin⟩ := μ.exists_operatorVariation_partition
  refine hasRadonNikodymProperty_of_weaklyCompact_resolution hc₀ (fun n => μ.val (B n))
    (fun n => μ.weaklyCompact_cut_of_cyclic_variation hμ hcyc hc₀ (B n) (hfin n))
    ?_ (2 * μ.uniformNorm) (mul_nonneg (by norm_num) μ.uniformNorm_nonneg) ?_
  · intro x
    have h := μ.countably_additive B hB x
    rwa [hcover, hμ, ContinuousLinearMap.id_apply] at h
  · intro I
    simpa only [one_smul] using μ.opNorm_finite_multiplier_le B hB I (fun _ => 1) (by simp)

theorem Dilation.hasRadonNikodymProperty_of_cyclic_sigmaFinite_variation
    {Z : Type*} [NormedAddCommGroup Z] [NormedSpace ℝ Z] [CompleteSpace Z]
    [TopologicalSpace.SeparableSpace X] {μ : OVM Ω X} (D : Dilation μ Z)
    (hcyc : D.P.Cyclic) (hc₀ : ¬ ContainsCopy CZero X)
    [SigmaFinite μ.operatorVariationMeasure] :
    HasRadonNikodymProperty.{uΛ} X :=
  μ.hasRadonNikodymProperty_of_cyclic_sigmaFinite_variation D.normalized_ovm
    (D.cyclic_alphaPVM hcyc) hc₀

