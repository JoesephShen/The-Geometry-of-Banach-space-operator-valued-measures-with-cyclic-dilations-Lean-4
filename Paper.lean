theorem symmetric_hyperplaneLift_rightInverse_isometric (hd : 1 ≤ d) (ρ : BarronControl d)
    {p : ℝ≥0∞} [Fact (1 ≤ p)] (hp : p ≠ ⊤)
    (g : Lp ℝ p (hyperplaneMeasure hd ρ.1)) :
    let Q := barronStage hd ρ p hp
    let U := Q.synthesis (hyperplaneLiftCoefficient hd g)
    foldStage hd ρ hp U = g ∧ ‖U‖ = ‖g‖ := by
  let Q := barronStage hd ρ p hp
  let a := hyperplaneLiftCoefficient hd g
  have he : foldStage hd ρ hp (Q.synthesis a) = g := by
    rw [foldStage_synthesis, show a = hyperplaneLiftCoefficient hd g from rfl, foldedLp_lift]
  refine ⟨he, le_antisymm ?_ ?_⟩
  · exact (Submodule.Quotient.norm_mk_le Q.synthesisToOriginal.ker a).trans_eq
      (hyperplaneLiftCoefficient_norm hd g)
  · have h := foldStage_contractive hd ρ hp (Q.synthesis a)
    rwa [he] at h

private theorem homogeneousEven_eq_of_even (μ : FiniteSignedMeasure (BarronSphere d))
    (h : pushforward (reflection d) μ = μ) : homogeneousEven d μ = μ := by
  change (1 / 2 : ℝ) • (μ + pushforward (reflection d) μ) = μ
  rw [h, ← two_smul ℝ μ, smul_smul]
  norm_num

private theorem homogeneousEven_contractive (μ : FiniteSignedMeasure (BarronSphere d)) :
    ‖homogeneousEven d μ‖ ≤ ‖μ‖ := by
  change ‖(1 / 2 : ℝ) • (μ + pushforward (reflection d) μ)‖ ≤ _
  rw [norm_smul, Real.norm_of_nonneg (by norm_num : (0 : ℝ) ≤ 1 / 2)]
  have h := norm_add_le μ (pushforward (reflection d) μ)
  linarith [norm_reflect_le μ]

private theorem homogeneousEven_eq_zero_of_synthesis (d : ℕ) (μ : FiniteSignedMeasure (BarronSphere d))
    (h : ∀ x t, homogeneousSynthesis μ x t = 0) : homogeneousEven d μ = 0 := by
  cases d with
  | zero => rw [homogeneousSynthesis_zero_dim_injective μ h, map_zero]
  | succ n =>
    have he := ((citeEWojtowytschHomogeneousKernel n.succ (Nat.succ_le_succ (Nat.zero_le n)) μ).mp h).1
    change (1 / 2 : ℝ) • (μ + pushforward (reflection n.succ) μ) = 0
    rw [he, add_neg_cancel, smul_zero]

/-- The even measure depends only on the homogeneous synthesis. -/
def homogeneousEvenPart (d : ℕ) :
    HomogeneousBarronBanach d →L[ℝ] FiniteSignedMeasure (BarronSphere d) :=
  (homogeneousProjectionCLM d).ker.liftQL
    ((homogeneousEven d).mkContinuous 1 (by simpa only [one_mul] using homogeneousEven_contractive)) (by
      intro μ h
      change homogeneousProjectionCLM d μ = 0 at h
      rw [homogeneousProjectionCLM_apply] at h
      exact homogeneousEven_eq_zero_of_synthesis d μ ((homogeneousProjection_kernel_all_dimensions d μ).mp h))

private theorem homogeneousEvenPart_quotient (μ : FiniteSignedMeasure (BarronSphere d)) :
    homogeneousEvenPart d (homogeneousQuotient d μ) = homogeneousEven d μ := rfl

private theorem homogeneousEvenPart_contractive (z : HomogeneousBarronBanach d) :
    ‖homogeneousEvenPart d z‖ ≤ ‖z‖ := by
  refine le_of_forall_pos_le_add fun ε hε => ?_
  obtain ⟨μ, hμ, hn⟩ := Submodule.Quotient.norm_mk_lt z hε
  change homogeneousQuotient d μ = z at hμ
  calc
    ‖homogeneousEvenPart d z‖ = ‖homogeneousEven d μ‖ := by
      rw [← hμ, homogeneousEvenPart_quotient]
    _ ≤ ‖μ‖ := homogeneousEven_contractive μ
    _ ≤ ‖z‖ + ε := hn.le

private theorem homogeneousQuotient_norm_even (μ : FiniteSignedMeasure (BarronSphere d))
    (h : pushforward (reflection d) μ = μ) : ‖homogeneousQuotient d μ‖ = ‖μ‖ := by
  refine le_antisymm (Submodule.Quotient.norm_mk_le (homogeneousProjectionCLM d).ker μ) ?_
  have hc := homogeneousEvenPart_contractive (homogeneousQuotient d μ)
  rwa [homogeneousEvenPart_quotient, homogeneousEven_eq_of_even μ h] at hc

theorem homogeneous_localization_norm_exact (E : MeasSet (BarronSphere d))
    (hE : reflection d ⁻¹' E.1 = E.1) (μ : FiniteSignedMeasure (BarronSphere d)) :
    let γ := homogeneousEven d μ
    let μE := cut E γ + homogeneousAtoms d (homogeneousMoments d μ)
    ‖homogeneousQuotient d μ - homogeneousQuotient d μE‖ = eval ⟨E.1ᶜ, E.2.compl⟩ (modulus γ) := by
  let γ := homogeneousEven d μ
  let A := homogeneousAtoms d (homogeneousMoments d μ)
  let F : MeasSet (BarronSphere d) := ⟨E.1ᶜ, E.2.compl⟩
  have hf : (⟨reflection d ⁻¹' F.1, (reflection d).measurable F.2⟩ : MeasSet (BarronSphere d)) = F := by
    apply Subtype.ext
    change reflection d ⁻¹' (E.1ᶜ) = E.1ᶜ
    rw [preimage_compl, hE]
  have hγ : pushforward (reflection d) γ = γ := (homogeneousEven_fixed μ).2
  have hfγ := pushforward_cut (reflection d) F γ
  rw [hf, hγ] at hfγ
  have hP : homogeneousQuotient d (γ + A) = homogeneousQuotient d μ :=
    (homogeneousQuotient_eq_iff _ _).mpr (homogeneousSynthesis_projection μ)
  change ‖homogeneousQuotient d μ - homogeneousQuotient d (cut E γ + A)‖ = eval F (modulus γ)
  rw [← hP, ← map_sub]
  have hsub : γ + A - (cut E γ + A) = cut F γ := by
    rw [show γ + A - (cut E γ + A) = γ - cut E γ by abel]
    exact sub_eq_of_eq_add ((cut_add_cut_complement E γ).symm.trans (add_comm _ _))
  rw [hsub, homogeneousQuotient_norm_even _ hfγ.symm, eval_modulus_eq_norm_cut]

