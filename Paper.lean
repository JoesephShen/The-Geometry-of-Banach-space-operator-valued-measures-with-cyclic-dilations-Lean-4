#print axioms BarronSphere.reflectedEven_affineAtoms


def affineFunction (a : (Fin d → ℝ) × ℝ) (x : Fin d → ℝ) : ℝ :=
  (∑ i, a.1 i * x i) + a.2

def linearForm (x : Fin d → ℝ) (t : ℝ) (θ : BarronSphere d) : ℝ :=
  (∑ i, θ.weight i * x i) + θ.bias * t

private theorem linearForm_measurable (x : Fin d → ℝ) (t : ℝ) :
    Measurable (linearForm x t) :=
  (Finset.measurable_sum _ fun i _ => (weightSymbol i).2.mul_const (x i)).add
    ((biasSymbol d).2.mul_const t)

private theorem norm_linearForm_le (x : Fin d → ℝ) (t : ℝ) (θ : BarronSphere d) :
    ‖linearForm x t θ‖ ≤ (∑ i, ‖x i‖) + ‖t‖ := by
  unfold linearForm
  calc
    _ ≤ (∑ i, ‖θ.weight i * x i‖) + ‖θ.bias * t‖ :=
      (norm_add_le ..).trans (add_le_add_left (norm_sum_le _ _) _)
    _ ≤ _ := by
      simp only [norm_mul]
      exact add_le_add (Finset.sum_le_sum fun i _ => mul_le_of_le_one_left (norm_nonneg _)
        (norm_weight_le θ i)) (mul_le_of_le_one_left (norm_nonneg _) (norm_bias_le θ))

def linearFormSymbol (x : Fin d → ℝ) (t : ℝ) : boundedMeasurableAlgebra (BarronSphere d) :=
  boundedSymbol (linearForm x t) (linearForm_measurable x t)
    ((∑ i, ‖x i‖) + ‖t‖) (norm_linearForm_le x t)

def ridgeSymbol (x : Fin d → ℝ) (t : ℝ) : boundedMeasurableAlgebra (BarronSphere d) :=
  boundedSymbol (fun θ => max (linearForm x t θ) 0)
    ((linearForm_measurable x t).max measurable_const) ((∑ i, ‖x i‖) + ‖t‖) (fun θ => by
      rw [Real.norm_of_nonneg (le_max_right _ _)]
      exact (max_le (Real.le_norm_self _) (norm_nonneg _)).trans (norm_linearForm_le x t θ))

def homogeneousSynthesis (μ : FiniteSignedMeasure (BarronSphere d))
    (x : Fin d → ℝ) (t : ℝ) : ℝ := signedIntegral (ridgeSymbol x t) μ

def synthesis (μ : FiniteSignedMeasure (BarronSphere d)) (x : Fin d → ℝ) : ℝ :=
  homogeneousSynthesis μ x 1

theorem synthesis_pointwise_bound (μ : FiniteSignedMeasure (BarronSphere d)) (x : Fin d → ℝ) :
    ‖synthesis μ x‖ ≤ ((∑ i, ‖x i‖) + 1) * ‖μ‖ := by
  unfold synthesis homogeneousSynthesis
  apply signedIntegral_norm_le
  intro θ
  change ‖max (linearForm x 1 θ) 0‖ ≤ _
  rw [Real.norm_of_nonneg (le_max_right _ _)]
  simpa using (max_le (Real.le_norm_self (linearForm x 1 θ)) (norm_nonneg _)).trans
    (norm_linearForm_le x 1 θ)

private theorem linearForm_reflection (x : Fin d → ℝ) (t : ℝ) (θ : BarronSphere d) :
    linearForm x t (reflection d θ) = -linearForm x t θ := by
  simp [linearForm, weight_reflection, bias_reflection, Finset.sum_neg_distrib, add_comm]

private theorem linearForm_polePlus (x : Fin d → ℝ) (t : ℝ) : linearForm x t (polePlus d) = t := by
  simp [linearForm, weight, bias, polePlus]

private theorem linearForm_poleMinus (x : Fin d → ℝ) (t : ℝ) : linearForm x t (poleMinus d) = -t := by
  simp [linearForm, weight, bias, poleMinus]

private theorem linearForm_axis (x : Fin d → ℝ) (t : ℝ) (i : Fin d) : linearForm x t (axis i) = x i := by
  classical
  simp only [linearForm, weight_axis, bias_axis, zero_mul, add_zero]
  rw [Finset.sum_eq_single i]
  · simp
  · intro j _ hj
    simp [hj]
  · simp

private theorem max_sub_max_neg (a : ℝ) : max a 0 - max (-a) 0 = a := by
  rcases le_total a 0 with h | h
  · rw [max_eq_right h, max_eq_left (neg_nonneg.mpr h), zero_sub, neg_neg]
  · rw [max_eq_left h, max_eq_right (neg_nonpos.mpr h), sub_zero]

theorem synthesis_affineAtoms (a : (Fin d → ℝ) × ℝ) (x : Fin d → ℝ) :
    synthesis (affineAtoms d a) x = affineFunction a x := by
  unfold synthesis homogeneousSynthesis affineFunction
  let I := (signedIntegral (ridgeSymbol x 1)).toLinearMap
  change I (affineAtoms d a) = _
  rw [affineAtoms_apply, map_add, map_sum, map_smul]
  have hi (i : Fin d) : I (pointMass (axis i) - pointMass (axisMinus i)) = x i := by
    rw [show I (pointMass (axis i) - pointMass (axisMinus i)) =
      I (pointMass (axis i)) - I (pointMass (axisMinus i)) from map_sub I _ _]
    change signedIntegral (ridgeSymbol x 1) (pointMass (axis i)) -
      signedIntegral (ridgeSymbol x 1) (pointMass (axisMinus i)) = x i
    rw [signedIntegral_pointMass, signedIntegral_pointMass]
    change max (linearForm x 1 (axis i)) 0 - max (linearForm x 1 (reflection d (axis i))) 0 = x i
    rw [linearForm_reflection, linearForm_axis, max_sub_max_neg]
  have hp : I (pointMass (polePlus d)) = 1 := by
    change signedIntegral (ridgeSymbol x 1) (pointMass (polePlus d)) = 1
    rw [signedIntegral_pointMass]
    change max (linearForm x 1 (polePlus d)) 0 = 1
    rw [linearForm_polePlus, max_eq_left zero_le_one]
  simp only [map_smul, hi, hp, smul_eq_mul, mul_one]

#print axioms BarronSphere.synthesis_pointwise_bound
#print axioms BarronSphere.synthesis_affineAtoms


private theorem signedIntegral_indicator_eq_eval (E : MeasSet (BarronSphere d))
    (μ : FiniteSignedMeasure (BarronSphere d)) :
    signedIntegral (measurableIndicator E) μ = eval E μ := by
  unfold signedIntegral
  rw [PVM.boundedMeasurableRepresentation_indicator]
  change eval MeasSet.whole (cut E μ) = _
  rw [eval_cut, show MeasSet.whole.inter E = E from Subtype.ext (univ_inter _)]

private theorem signedIntegral_finite_sum (x : Fin d → ℝ) (μ : FiniteSignedMeasure (BarronSphere d))
    (B : Fin d → boundedMeasurableAlgebra (BarronSphere d)) (F : Finset (Fin d)) :
    signedIntegral (∑ i ∈ F, x i • B i) μ = ∑ i ∈ F, x i * signedIntegral (B i) μ := by
  classical
  induction F using Finset.induction_on with
  | empty =>
      simp only [Finset.sum_empty]
      rw [show (0 : boundedMeasurableAlgebra (BarronSphere d)) =
        (0 : ℝ) • measurableIndicator (MeasSet.whole : MeasSet (BarronSphere d)) from (zero_smul _ _).symm]
      rw [signedIntegral_smul, zero_mul]
  | insert i F hi ih =>
      rw [Finset.sum_insert hi, Finset.sum_insert hi, signedIntegral_add, signedIntegral_smul, ih]

private theorem signedIntegral_linearForm (x : Fin d → ℝ) (t : ℝ)
    (μ : FiniteSignedMeasure (BarronSphere d)) :
    signedIntegral (linearFormSymbol x t) μ =
      (∑ i, signedIntegral (weightSymbol i) μ * x i) + signedIntegral (biasSymbol d) μ * t := by
  classical
  rw [signedIntegral_congr (c := (∑ i : Fin d, x i • weightSymbol i) + t • biasSymbol d)
    (fun θ => by
      simp only [linearFormSymbol, boundedSymbol_apply, linearForm]
      simp [weightSymbol, biasSymbol, mul_comm]
      rfl)]
  rw [signedIntegral_add, signedIntegral_smul, signedIntegral_finite_sum]
  simp only [mul_comm]

private theorem reflect_ridge (x : Fin d → ℝ) (t : ℝ) (θ : BarronSphere d) :
    (ridgeSymbol x t).1 (reflection d θ) = (ridgeSymbol (-x) (-t)).1 θ := by
  change max (linearForm x t (reflection d θ)) 0 = max (linearForm (-x) (-t) θ) 0
  rw [linearForm_reflection]
  congr 1
  simp [linearForm, Finset.sum_neg_distrib, add_comm]

theorem homogeneousSynthesis_difference (μ : FiniteSignedMeasure (BarronSphere d))
    (x : Fin d → ℝ) (t : ℝ) :
    homogeneousSynthesis μ x t - homogeneousSynthesis μ (-x) (-t) =
      (∑ i, signedIntegral (weightSymbol i) μ * x i) + signedIntegral (biasSymbol d) μ * t := by
  rw [← signedIntegral_linearForm]
  unfold homogeneousSynthesis
  rw [signedIntegral_congr (b := linearFormSymbol x t) (c := ridgeSymbol x t + (-1 : ℝ) • ridgeSymbol (-x) (-t))
    (fun θ => by
      change linearForm x t θ = max (linearForm x t θ) 0 + (-1) * max (linearForm (-x) (-t) θ) 0
      have hh := reflect_ridge x t θ
      change max (linearForm x t (reflection d θ)) 0 = max (linearForm (-x) (-t) θ) 0 at hh
      rw [linearForm_reflection] at hh
      rw [← hh, neg_one_mul, ← sub_eq_add_neg, max_sub_max_neg])]
  rw [signedIntegral_add, signedIntegral_smul, neg_one_mul, sub_eq_add_neg]

#print axioms BarronSphere.homogeneousSynthesis_difference


private theorem synthesis_split_poles (μ : FiniteSignedMeasure (BarronSphere d))
    (x : Fin d → ℝ) :
    synthesis μ x = synthesis (cut (nonPole d) μ) x +
      eval ⟨{polePlus d}, measurableSet_singleton _⟩ μ := by
  let Q : MeasSet (BarronSphere d) := ⟨{polePlus d}, measurableSet_singleton _⟩
  have he : signedIntegral (ridgeSymbol x 1) =
      signedIntegral (ridgeSymbol x 1 * measurableIndicator (nonPole d) + measurableIndicator Q) := by
    apply signedIntegral_congr
    intro θ
    change max (linearForm x 1 θ) 0 =
      max (linearForm x 1 θ) 0 * (measurableIndicator (nonPole d)).1 θ + (measurableIndicator Q).1 θ
    rw [measurableIndicator_apply, measurableIndicator_apply]
    by_cases hp : θ = polePlus d
    · subst θ
      have h : polePlus d ∉ (nonPole d).1 := fun h => h.1 rfl
      simp [Q, h, linearForm_polePlus]
    · by_cases hm : θ = poleMinus d
      · subst θ
        have h : poleMinus d ∉ (nonPole d).1 := fun h => h.2 rfl
        simp [Q, h, hp, linearForm_poleMinus]
      · have hn : θ ∈ (nonPole d).1 := by
          rw [nonPole_eq_compl]
          simp [hp, hm]
        rw [Set.indicator_of_mem hn]
        simp [Q, hp]
  unfold synthesis homogeneousSynthesis
  calc
    _ = signedIntegral (ridgeSymbol x 1 * measurableIndicator (nonPole d) + measurableIndicator Q) μ :=
      congrArg (fun L => L μ) he
    _ = _ := by rw [signedIntegral_add, ← signedIntegral_cut, signedIntegral_indicator_eq_eval]

private theorem synthesis_reflectedEven (μ : FiniteSignedMeasure (BarronSphere d))
    (x : Fin d → ℝ) :
    synthesis (reflectedEven d μ) x = (1 / 2 : ℝ) * (synthesis (cut (nonPole d) μ) x +
      homogeneousSynthesis (cut (nonPole d) μ) (-x) (-1)) := by
  let E := nonPole d
  have hp : (⟨reflection d ⁻¹' E.1, (reflection d).measurable E.2⟩ : MeasSet (BarronSphere d)) = E :=
    Subtype.ext (reflection_preimage_nonPole d)
  have h := pushforward_cut (reflection d) E μ
  rw [hp] at h
  rw [reflectedEven_apply]
  rw [h]
  unfold synthesis homogeneousSynthesis
  have hadd : signedIntegral (ridgeSymbol x 1) ((1 / 2 : ℝ) •
      (cut E μ + pushforward (reflection d) (cut E μ))) =
      (1 / 2 : ℝ) * (signedIntegral (ridgeSymbol x 1) (cut E μ) +
      signedIntegral (ridgeSymbol x 1) (pushforward (reflection d) (cut E μ))) := by
    let I := (signedIntegral (ridgeSymbol x 1)).toLinearMap
    change I ((1 / 2 : ℝ) • (cut E μ + pushforward (reflection d) (cut E μ))) = _
    rw [map_smul, map_add]
    rfl
  rw [hadd, signedIntegral_pushforward (reflection d) (ridgeSymbol x 1) (ridgeSymbol (-x) (-1))
    (fun θ => (reflect_ridge x 1 θ).symm)]

theorem synthesis_even_add_affine (μ : FiniteSignedMeasure (BarronSphere d)) (x : Fin d → ℝ) :
    synthesis μ x = synthesis (reflectedEven d μ) x + affineFunction (affineCoefficients d μ) x := by
  rw [synthesis_split_poles μ x, synthesis_reflectedEven, affineCoefficients_apply]
  have h := homogeneousSynthesis_difference (cut (nonPole d) μ) x 1
  change synthesis (cut (nonPole d) μ) x - _ = _ at h
  unfold affineFunction
  simp only [mul_one] at h
  simp_rw [mul_assoc, ← Finset.mul_sum]
  linarith

theorem synthesis_canonicalProjection (μ : FiniteSignedMeasure (BarronSphere d)) (x : Fin d → ℝ) :
    synthesis (canonicalProjection d μ) x = synthesis μ x := by
  let I := (signedIntegral (ridgeSymbol x 1)).toLinearMap
  change I (reflectedEven d μ + affineAtoms d (affineCoefficients d μ)) = synthesis μ x
  rw [map_add]
  change synthesis (reflectedEven d μ) x + synthesis (affineAtoms d (affineCoefficients d μ)) x = _
  rw [synthesis_affineAtoms, ← synthesis_even_add_affine]

#print axioms BarronSphere.synthesis_even_add_affine
#print axioms BarronSphere.synthesis_canonicalProjection


open scoped BoundedContinuousFunction

local instance (Ω : Type*) [MeasurableSpace Ω] : NormedAddCommGroup (FiniteSignedMeasure Ω) :=
  inferInstanceAs (NormedAddCommGroup (finiteSignedMeasureSubmodule Ω))

local instance (Ω : Type*) [MeasurableSpace Ω] : NormedSpace ℝ (FiniteSignedMeasure Ω) :=
  inferInstanceAs (NormedSpace ℝ (finiteSignedMeasureSubmodule Ω))

private theorem homogeneousSynthesis_nonnegative_scale (μ : FiniteSignedMeasure (BarronSphere d))
    (x : Fin d → ℝ) (t a : ℝ) (ha : 0 ≤ a) :
    homogeneousSynthesis μ (a • x) (a * t) = a * homogeneousSynthesis μ x t := by
  unfold homogeneousSynthesis
  rw [signedIntegral_congr (b := ridgeSymbol (a • x) (a * t)) (c := a • ridgeSymbol x t)
    (fun θ => by
      change max (linearForm (a • x) (a * t) θ) 0 = a * max (linearForm x t θ) 0
      have h : linearForm (a • x) (a * t) θ = a * linearForm x t θ := by
        simp only [linearForm, Pi.smul_apply, smul_eq_mul, mul_add, Finset.mul_sum]
        congr 1
        · apply Finset.sum_congr rfl
          intro i _
          ring
        · ring
      rw [h, mul_max_of_nonneg _ _ ha, mul_zero]), signedIntegral_smul]

private theorem homogeneousSynthesis_bias_lipschitz (μ : FiniteSignedMeasure (BarronSphere d))
    (x : Fin d → ℝ) : LipschitzWith ⟨‖μ‖, norm_nonneg _⟩ (homogeneousSynthesis μ x) := by
  apply LipschitzWith.of_dist_le_mul
  intro t s
  rw [Real.dist_eq, Real.dist_eq, ← Real.norm_eq_abs]
  change ‖homogeneousSynthesis μ x t - homogeneousSynthesis μ x s‖ ≤ ‖μ‖ * |t - s|
  have hsub : homogeneousSynthesis μ x t - homogeneousSynthesis μ x s =
      signedIntegral (ridgeSymbol x t + (-1 : ℝ) • ridgeSymbol x s) μ := by
    rw [homogeneousSynthesis, homogeneousSynthesis, signedIntegral_add, signedIntegral_smul,
      neg_one_mul, sub_eq_add_neg]
  rw [hsub, mul_comm]
  apply signedIntegral_norm_le
  intro θ
  change ‖max (linearForm x t θ) 0 + (-1) * max (linearForm x s θ) 0‖ ≤ _
  rw [Real.norm_eq_abs, neg_one_mul, ← sub_eq_add_neg]
  refine (abs_max_sub_max_le_abs ..).trans ?_
  have he : linearForm x t θ - linearForm x s θ = θ.bias * (t - s) := by
    unfold linearForm
    ring
  rw [he, abs_mul, ← Real.norm_eq_abs θ.bias]
  exact mul_le_of_le_one_left (abs_nonneg _) (norm_bias_le θ)

private theorem homogeneousSynthesis_zero_nonnegative {μ : FiniteSignedMeasure (BarronSphere d)}
    (h : ∀ x, synthesis μ x = 0) (x : Fin d → ℝ) (t : ℝ) (ht : 0 ≤ t) :
    homogeneousSynthesis μ x t = 0 := by
  have hp : Ioi (0 : ℝ) ⊆ {s | homogeneousSynthesis μ x s = 0} := by
    intro s hs
    have hs' : 0 < s := hs
    have hscale := homogeneousSynthesis_nonnegative_scale μ (s⁻¹ • x) 1 s hs'.le
    rw [mul_one, smul_smul, mul_inv_cancel₀ (ne_of_gt hs'), one_smul] at hscale
    change homogeneousSynthesis μ x s = 0
    exact hscale.trans (by change s * synthesis μ (s⁻¹ • x) = 0; rw [h, mul_zero])
  have hz : IsClosed {s | homogeneousSynthesis μ x s = 0} :=
    isClosed_eq (homogeneousSynthesis_bias_lipschitz μ x).continuous continuous_const
  have hc := closure_minimal hp hz
  rw [closure_Ioi] at hc
  exact hc ht

/-- E and Wojtowytsch, Remark 4.6, for the homogeneous ReLU transform on a Euclidean sphere. -/
axiom citeEWojtowytschHomogeneousKernel (d : ℕ) (hd : 1 ≤ d)
    (μ : FiniteSignedMeasure (BarronSphere d)) :
    (∀ (x : Fin d → ℝ) (t : ℝ), homogeneousSynthesis μ x t = 0) ↔
      pushforward (reflection d) μ = -μ ∧
      (∀ i : Fin d, signedIntegral (weightSymbol i) μ = 0) ∧
      signedIntegral (biasSymbol d) μ = 0

private theorem reflectedEven_odd_zero (μ : FiniteSignedMeasure (BarronSphere d))
    (hm : pushforward (reflection d) μ = -μ) : reflectedEven d μ = 0 := by
  rw [reflectedEven_apply, hm]
  have hc : cut (nonPole d) (-μ) = -(cut (nonPole d) μ) :=
    map_neg (cut (nonPole d)).toLinearMap _
  rw [hc, show cut (nonPole d) μ + -(cut (nonPole d) μ) = 0 from add_neg_cancel _, smul_zero]

private theorem reflectedEven_poleMinus_zero : reflectedEven d (pointMass (poleMinus d)) = 0 := by
  have hs : reflection d (polePlus d) = poleMinus d := by
    apply Subtype.ext
    exact Prod.ext (neg_zero : -(0 : Fin d → ℝ) = 0) rfl
  have hr : reflection d (poleMinus d) = polePlus d :=
    hs ▸ reflection_involutive d (polePlus d)
  rw [reflectedEven_apply, pushforward_pointMass, hr, cut_pointMass, cut_pointMass]
  have hp : polePlus d ∉ (nonPole d).1 := fun h => h.1 rfl
  have hm : poleMinus d ∉ (nonPole d).1 := fun h => h.2 rfl
  simp [hp, hm]

theorem reflectedEven_zero_of_synthesis_zero (hd : 1 ≤ d) (μ : FiniteSignedMeasure (BarronSphere d))
    (h : ∀ x, synthesis μ x = 0) : reflectedEven d μ = 0 := by
  let β := signedIntegral (biasSymbol d) μ
  have hpos := homogeneousSynthesis_zero_nonnegative h
  have hweight (i : Fin d) : signedIntegral (weightSymbol i) μ = 0 := by
    have hdiff := homogeneousSynthesis_difference μ (Pi.single i 1) 0
    rw [neg_zero, hpos _ _ le_rfl, hpos _ _ le_rfl, sub_zero, mul_zero, add_zero] at hdiff
    have hsum : (∑ j : Fin d, signedIntegral (weightSymbol j) μ * (Pi.single i (1 : ℝ) : Fin d → ℝ) j) =
        signedIntegral (weightSymbol i) μ := by
      classical
      rw [Finset.sum_eq_single i]
      · simp
      · intro j _ hj
        rw [Pi.single_eq_of_ne hj, mul_zero]
      · simp
    rw [hsum] at hdiff
    exact hdiff.symm
  have hF (x : Fin d → ℝ) (t : ℝ) :
      homogeneousSynthesis μ x t = -(β * max (-t) 0) := by
    rcases le_total 0 t with ht | ht
    · rw [hpos _ _ ht, max_eq_right (neg_nonpos.mpr ht), mul_zero, neg_zero]
    · have hdiff := homogeneousSynthesis_difference μ x t
      rw [hpos _ _ (neg_nonneg.mpr ht), sub_zero] at hdiff
      simp only [hweight, zero_mul, Finset.sum_const_zero, zero_add] at hdiff
      rw [hdiff, max_eq_left (neg_nonneg.mpr ht)]
      change β * t = -(β * -t)
      ring
  have hcorrect (x : Fin d → ℝ) (t : ℝ) :
      homogeneousSynthesis (μ + β • pointMass (poleMinus d)) x t = 0 := by
    let I := (signedIntegral (ridgeSymbol x t)).toLinearMap
    change I (μ + β • pointMass (poleMinus d)) = 0
    rw [map_add, map_smul]
    change homogeneousSynthesis μ x t + β * signedIntegral (ridgeSymbol x t) (pointMass (poleMinus d)) = 0
    rw [hF, signedIntegral_pointMass]
    change -(β * max (-t) 0) + β * max (linearForm x t (poleMinus d)) 0 = 0
    rw [linearForm_poleMinus, neg_add_cancel]
  have hodd := (citeEWojtowytschHomogeneousKernel d hd _).mp hcorrect
  have hz := reflectedEven_odd_zero _ hodd.1
  rw [map_add, map_smul, reflectedEven_poleMinus_zero, smul_zero, add_zero] at hz
  exact hz

private theorem affineFunction_zero (a : (Fin d → ℝ) × ℝ)
    (h : ∀ x, affineFunction a x = 0) : a = 0 := by
  have hc : a.2 = 0 := by simpa [affineFunction] using h 0
  apply Prod.ext
  · funext i
    have hi := h (Pi.single i (1 : ℝ))
    unfold affineFunction at hi
    rw [hc, add_zero, Finset.sum_eq_single i] at hi
    · simpa using hi
    · intro j _ hj
      rw [Pi.single_eq_of_ne hj, mul_zero]
    · simp
  · exact hc

theorem canonicalProjection_kernel_eq_synthesis_kernel (hd : 1 ≤ d)
    (μ : FiniteSignedMeasure (BarronSphere d)) :
    canonicalProjection d μ = 0 ↔ ∀ x, synthesis μ x = 0 := by
  constructor
  · intro h x
    rw [← synthesis_canonicalProjection, h]
    exact map_zero (signedIntegral (ridgeSymbol x 1)).toLinearMap
  · intro h
    have he := reflectedEven_zero_of_synthesis_zero hd μ h
    have ha := affineFunction_zero (affineCoefficients d μ) (fun x => by
      have hs := synthesis_even_add_affine μ x
      rw [h x, he] at hs
      change 0 = signedIntegral (ridgeSymbol x 1) 0 + affineFunction (affineCoefficients d μ) x at hs
      rw [show signedIntegral (ridgeSymbol x 1) (0 : FiniteSignedMeasure (BarronSphere d)) = 0
        from map_zero (signedIntegral (ridgeSymbol x 1)).toLinearMap, zero_add] at hs
      exact hs.symm)
    change reflectedEven d μ + affineAtoms d (affineCoefficients d μ) = 0
    rw [he, ha, map_zero, zero_add]

#print axioms BarronSphere.canonicalProjection_kernel_eq_synthesis_kernel

theorem norm_cut_le (E : MeasSet (BarronSphere d)) (μ : FiniteSignedMeasure (BarronSphere d)) :
    ‖cut E μ‖ ≤ ‖μ‖ := by
  obtain ⟨φ, hφ, rfl⟩ := exists_charge μ
  rw [norm_cut_ofCharge, norm_ofCharge, ScalarCharge.totalVariationMass]
  exact add_le_add (φ.positivePart.val_mono φ.positivePart_positive (subset_univ E.1))
    (φ.neg.positivePart.val_mono φ.neg.positivePart_positive (subset_univ E.1))

private theorem norm_reflect_le (μ : FiniteSignedMeasure (BarronSphere d)) :
    ‖pushforward (reflection d) μ‖ ≤ ‖μ‖ := by
  change ‖(pushforward (reflection d) μ).1‖ ≤ ‖μ.1‖
  apply (BoundedContinuousFunction.norm_le (norm_nonneg _)).mpr
  rintro ⟨E, F⟩
  let r := reflection d
  let pre (A : MeasSet (BarronSphere d)) : MeasSet (BarronSphere d) := ⟨r ⁻¹' A.1, r.measurable A.2⟩
  obtain ⟨ψ, hψ, hpush⟩ := exists_charge (pushforward r μ)
  rw [← hpush]
  change ‖ψ.val E - ψ.val F‖ ≤ ‖μ.1‖
  rw [← eval_ofCharge ψ hψ E, ← eval_ofCharge ψ hψ F, hpush, eval_pushforward, eval_pushforward]
  obtain ⟨φ, hφ, rfl⟩ := exists_charge μ
  rw [eval_ofCharge, eval_ofCharge]
  exact (ofCharge φ hφ).1.norm_coe_le_norm (pre E, pre F)

theorem reflectedEven_contractive (μ : FiniteSignedMeasure (BarronSphere d)) :
    ‖reflectedEven d μ‖ ≤ ‖μ‖ := by
  rw [reflectedEven_apply, norm_smul, Real.norm_of_nonneg (by norm_num : 0 ≤ (1 / 2 : ℝ))]
  have h₁ := norm_cut_le (nonPole d) μ
  have h₂ := (norm_cut_le (nonPole d) (pushforward (reflection d) μ)).trans (norm_reflect_le μ)
  calc
    _ ≤ (1 / 2 : ℝ) * (‖cut (nonPole d) μ‖ + ‖cut (nonPole d) (pushforward (reflection d) μ)‖) :=
      mul_le_mul_of_nonneg_left (norm_add_le ..) (by norm_num)
    _ ≤ ‖μ‖ := by linarith

theorem norm_affineAtoms_le_l1 (a : (Fin d → ℝ) × ℝ) :
    ‖affineAtoms d a‖ ≤ (∑ i, 2 * ‖a.1 i‖) + ‖a.2‖ := by
  rw [affineAtoms_apply]
  calc
    _ ≤ (∑ i : Fin d, ‖a.1 i • (pointMass (axis i) - pointMass (axisMinus i))‖) +
        ‖a.2 • pointMass (polePlus d)‖ :=
      (norm_add_le ..).trans (add_le_add_left (norm_sum_le _ _) _)
    _ ≤ _ := by
      rw [norm_smul, norm_pointMass, mul_one]
      refine add_le_add_left (Finset.sum_le_sum (fun i _ => ?_)) _
      rw [norm_smul, mul_comm 2]
      refine mul_le_mul_of_nonneg_left ((norm_sub_le ..).trans_eq ?_) (norm_nonneg _)
      rw [norm_pointMass, norm_pointMass]
      norm_num

#print axioms BarronSphere.reflectedEven_contractive
#print axioms BarronSphere.norm_affineAtoms_le_l1


theorem reflectedEven_eq_of_even_supported (μ : FiniteSignedMeasure (BarronSphere d))
    (he : pushforward (reflection d) μ = μ) (hn : cut (nonPole d) μ = μ) :
    reflectedEven d μ = μ := by
  rw [reflectedEven_apply, he, hn, ← two_smul ℝ μ, smul_smul]
  norm_num

private theorem cut_cut_comm (E F : MeasSet (BarronSphere d))
    (μ : FiniteSignedMeasure (BarronSphere d)) :
    cut E (cut F μ) = cut F (cut E μ) := by
  apply FiniteSignedMeasure.ext
  intro A
  simp only [eval_cut]
  rw [show (A.inter E).inter F = (A.inter F).inter E from Subtype.ext (inter_right_comm _ _ _)]

theorem cut_preserves_even_supported (E : MeasSet (BarronSphere d))
    (hE : reflection d ⁻¹' E.1 = E.1) (μ : FiniteSignedMeasure (BarronSphere d))
    (he : pushforward (reflection d) μ = μ) (hn : cut (nonPole d) μ = μ) :
    reflectedEven d (cut E μ) = cut E μ := by
  apply reflectedEven_eq_of_even_supported
  · have h := pushforward_cut (reflection d) E μ
    rw [he, show (⟨reflection d ⁻¹' E.1, (reflection d).measurable E.2⟩ :
      MeasSet (BarronSphere d)) = E from Subtype.ext hE] at h
    exact h.symm
  · rw [cut_cut_comm, hn]

private theorem reflectedEven_canonicalProjection (μ : FiniteSignedMeasure (BarronSphere d)) :
    reflectedEven d (canonicalProjection d μ) = reflectedEven d μ := by
  change reflectedEven d (reflectedEven d μ + affineAtoms d (affineCoefficients d μ)) = _
  rw [map_add, reflectedEven_idempotent, reflectedEven_affineAtoms, add_zero]

private theorem affineCoefficients_canonicalProjection (μ : FiniteSignedMeasure (BarronSphere d)) :
    affineCoefficients d (canonicalProjection d μ) = affineCoefficients d μ := by
  change affineCoefficients d (reflectedEven d μ + affineAtoms d (affineCoefficients d μ)) = _
  rw [map_add, affineCoefficients_reflectedEven, affineCoefficients_affineAtoms, zero_add]

theorem canonicalProjection_eq_of_synthesis_eq (hd : 1 ≤ d)
    {μ ν : FiniteSignedMeasure (BarronSphere d)} (h : synthesis μ = synthesis ν) :
    canonicalProjection d μ = canonicalProjection d ν := by
  have hk := (canonicalProjection_kernel_eq_synthesis_kernel hd (μ - ν)).mpr (fun x => by
    let I := (signedIntegral (ridgeSymbol x 1)).toLinearMap
    change I (μ - ν) = 0
    rw [show I (μ - ν) = I μ - I ν from map_sub I _ _]
    exact sub_eq_zero.mpr (congrFun h x))
  apply sub_eq_zero.mp
  exact (map_sub (canonicalProjection d) μ ν).symm.trans hk

theorem coefficients_unique (hd : 1 ≤ d) {μ ν : FiniteSignedMeasure (BarronSphere d)}
    (h : synthesis μ = synthesis ν) :
    reflectedEven d μ = reflectedEven d ν ∧ affineCoefficients d μ = affineCoefficients d ν := by
  have he := canonicalProjection_eq_of_synthesis_eq hd h
  exact ⟨by simpa only [reflectedEven_canonicalProjection] using congrArg (reflectedEven d) he,
    by simpa only [affineCoefficients_canonicalProjection] using congrArg (affineCoefficients d) he⟩

/-- The manuscript's quotient norm, on functions represented by the synthesis map. -/
def synthesisQuotientNorm (f : (Fin d → ℝ) → ℝ) : ℝ :=
  sInf {a | ∃ μ : FiniteSignedMeasure (BarronSphere d), synthesis μ = f ∧ a = ‖μ‖}

/-- The quotient norm after affine functions are factored out. -/
def affineQuotientNorm (f : (Fin d → ℝ) → ℝ) : ℝ :=
  sInf {a | ∃ (μ : FiniteSignedMeasure (BarronSphere d)) (v : (Fin d → ℝ) × ℝ),
    (∀ x, synthesis μ x + affineFunction v x = f x) ∧ a = ‖μ‖}

theorem synthesisQuotientNorm_even (hd : 1 ≤ d) (γ : FiniteSignedMeasure (BarronSphere d))
    (hc : reflectedEven d γ = γ) : synthesisQuotientNorm (synthesis γ) = ‖γ‖ := by
  unfold synthesisQuotientNorm
  let V : Set ℝ := {a | ∃ μ : FiniteSignedMeasure (BarronSphere d), synthesis μ = synthesis γ ∧ a = ‖μ‖}
  have hmem : ‖γ‖ ∈ V := ⟨γ, rfl, rfl⟩
  have hb : ‖γ‖ ∈ lowerBounds V := by
    rintro a ⟨ν, hν, rfl⟩
    rw [← hc, ← (coefficients_unique hd hν).1]
    exact reflectedEven_contractive ν
  exact le_antisymm (csInf_le ⟨‖γ‖, hb⟩ hmem) (le_csInf ⟨‖γ‖, hmem⟩ hb)

theorem affineQuotientNorm_eq (hd : 1 ≤ d) (μ : FiniteSignedMeasure (BarronSphere d)) :
    affineQuotientNorm (synthesis μ) = ‖reflectedEven d μ‖ := by
  let V : Set ℝ := {a | ∃ (ν : FiniteSignedMeasure (BarronSphere d)) (v : (Fin d → ℝ) × ℝ),
    (∀ x, synthesis ν x + affineFunction v x = synthesis μ x) ∧ a = ‖ν‖}
  have hmem : ‖reflectedEven d μ‖ ∈ V :=
    ⟨reflectedEven d μ, affineCoefficients d μ, fun x => (synthesis_even_add_affine μ x).symm, rfl⟩
  have hb : ‖reflectedEven d μ‖ ∈ lowerBounds V := by
    rintro a ⟨ν, v, hν, rfl⟩
    have hrepr : synthesis (ν + affineAtoms d v) = synthesis μ := by
      funext x
      let I := (signedIntegral (ridgeSymbol x 1)).toLinearMap
      change I (ν + affineAtoms d v) = synthesis μ x
      rw [map_add]
      change synthesis ν x + synthesis (affineAtoms d v) x = _
      rw [synthesis_affineAtoms, hν]
    have hc := (coefficients_unique hd hrepr).1
    rw [map_add, reflectedEven_affineAtoms, add_zero] at hc
    rw [← hc]
    exact reflectedEven_contractive ν
  exact le_antisymm (csInf_le ⟨_, hb⟩ hmem) (le_csInf ⟨_, hmem⟩ hb)

theorem affineQuotientNorm_even (hd : 1 ≤ d) (γ : FiniteSignedMeasure (BarronSphere d))
    (hc : reflectedEven d γ = γ) : affineQuotientNorm (synthesis γ) = ‖γ‖ := by
  rw [affineQuotientNorm_eq hd, hc]

#print axioms BarronSphere.coefficients_unique
#print axioms BarronSphere.affineQuotientNorm_eq
#print axioms BarronSphere.synthesisQuotientNorm_even


private theorem cut_add_cut_complement (E : MeasSet (BarronSphere d))
    (μ : FiniteSignedMeasure (BarronSphere d)) :
    cut E μ + cut ⟨E.1ᶜ, E.2.compl⟩ μ = μ := by
  apply FiniteSignedMeasure.ext
  intro A
  rw [map_add, eval_cut, eval_cut]
  obtain ⟨φ, hφ, rfl⟩ := exists_charge μ
  simp only [eval_ofCharge]
  let F : MeasSet (BarronSphere d) := ⟨E.1ᶜ, E.2.compl⟩
  have hdisj : Disjoint (A.inter E).1 (A.inter F).1 :=
    disjoint_compl_right.mono inter_subset_right inter_subset_right
  have hU : (A.inter E).union (A.inter F) = A := by
    apply Subtype.ext
    change (A.1 ∩ E.1) ∪ (A.1 ∩ E.1ᶜ) = A.1
    rw [← inter_union_distrib_left, union_compl_self, inter_univ]
  rw [← φ.add_union _ _ hdisj, hU]

/-- The localized function keeps the original affine part and restricts the even measure. -/
def localizedSynthesis (E : MeasSet (BarronSphere d)) (μ : FiniteSignedMeasure (BarronSphere d))
    (x : Fin d → ℝ) : ℝ :=
  synthesis (cut E (reflectedEven d μ)) x + affineFunction (affineCoefficients d μ) x

private theorem localizedSynthesis_difference (E : MeasSet (BarronSphere d))
    (μ : FiniteSignedMeasure (BarronSphere d)) :
    (fun x => synthesis μ x - localizedSynthesis E μ x) =
      synthesis (cut ⟨E.1ᶜ, E.2.compl⟩ (reflectedEven d μ)) := by
  funext x
  unfold localizedSynthesis
  rw [synthesis_even_add_affine μ x]
  let γ := reflectedEven d μ
  let I := (signedIntegral (ridgeSymbol x 1)).toLinearMap
  have h := congrArg I (cut_add_cut_complement E γ)
  rw [map_add] at h
  change (I γ + affineFunction (affineCoefficients d μ) x) -
    (I (cut E γ) + affineFunction (affineCoefficients d μ) x) =
    I (cut ⟨E.1ᶜ, E.2.compl⟩ γ)
  linarith

private theorem reflectedEven_cut_complement (E : MeasSet (BarronSphere d))
    (hE : reflection d ⁻¹' E.1 = E.1) (μ : FiniteSignedMeasure (BarronSphere d)) :
    reflectedEven d (cut ⟨E.1ᶜ, E.2.compl⟩ (reflectedEven d μ)) =
      cut ⟨E.1ᶜ, E.2.compl⟩ (reflectedEven d μ) := by
  apply cut_preserves_even_supported _ _ _ (reflectedEven_even μ) (reflectedEven_supported μ)
  change reflection d ⁻¹' E.1ᶜ = E.1ᶜ
  rw [preimage_compl, hE]

theorem localization_norm_exact (hd : 1 ≤ d) (E : MeasSet (BarronSphere d))
    (hE : reflection d ⁻¹' E.1 = E.1) (μ : FiniteSignedMeasure (BarronSphere d)) :
    let f := fun x => synthesis μ x - localizedSynthesis E μ x
    let F : MeasSet (BarronSphere d) := (nonPole d).inter ⟨E.1ᶜ, E.2.compl⟩
    affineQuotientNorm f = synthesisQuotientNorm f ∧
      synthesisQuotientNorm f = eval F (modulus (reflectedEven d μ)) := by
  dsimp only
  rw [localizedSynthesis_difference]
  have hc := reflectedEven_cut_complement E hE μ
  rw [affineQuotientNorm_even hd _ hc, synthesisQuotientNorm_even hd _ hc]
  constructor
  · rfl
  · rw [eval_modulus_eq_norm_cut]
    congr 1
    apply FiniteSignedMeasure.ext
    intro A
    simp only [eval_cut]
    have h := congrArg (fun μ' => eval (A.inter ⟨E.1ᶜ, E.2.compl⟩) μ') (reflectedEven_supported μ)
    rw [eval_cut] at h
    have hsets : (A.inter ⟨E.1ᶜ, E.2.compl⟩).inter (nonPole d) =
        A.inter ((nonPole d).inter ⟨E.1ᶜ, E.2.compl⟩) :=
      Subtype.ext ((inter_assoc _ _ _).trans (congrArg (fun B => A.1 ∩ B) (inter_comm _ _)))
    rw [hsets] at h
    exact h.symm

private theorem norm_linearForm_euclidean (x : Fin d → ℝ) (t : ℝ) (θ : BarronSphere d) :
    ‖linearForm x t θ‖ ≤ Real.sqrt ((∑ i, (x i)^2) + t^2) := by
  let W : Option (Fin d) → ℝ := fun i => i.elim θ.bias θ.weight
  let X : Option (Fin d) → ℝ := fun i => i.elim t x
  have h := Finset.sum_mul_sq_le_sq_mul_sq Finset.univ W X
  simp only [Fintype.sum_option] at h
  change (θ.bias * t + ∑ i, θ.weight i * x i)^2 ≤
    (θ.bias^2 + ∑ i, (θ.weight i)^2) * (t^2 + ∑ i, (x i)^2) at h
  have hs : (∑ i, (θ.weight i)^2) + θ.bias^2 = 1 := θ.2
  rw [add_comm (θ.bias^2) _, hs, one_mul, add_comm (t^2) _] at h
  rw [Real.norm_eq_abs, ← Real.sqrt_sq_eq_abs]
  apply Real.sqrt_le_sqrt
  simpa [linearForm, add_comm] using h

private theorem synthesis_even_euclidean_bound (γ : FiniteSignedMeasure (BarronSphere d))
    (he : pushforward (reflection d) γ = γ) (x : Fin d → ℝ) :
    ‖synthesis γ x‖ ≤ (1 / 2) * Real.sqrt (1 + ∑ i, (x i)^2) * ‖γ‖ := by
  have hSym := signedIntegral_pushforward (reflection d) (ridgeSymbol x 1) (ridgeSymbol (-x) (-1))
    (fun θ => (reflect_ridge x 1 θ).symm) γ
  rw [he] at hSym
  have hval : synthesis γ x =
      signedIntegral ((1 / 2 : ℝ) • (ridgeSymbol x 1 + ridgeSymbol (-x) (-1))) γ := by
    change signedIntegral (ridgeSymbol x 1) γ = _
    rw [signedIntegral_smul, signedIntegral_add, ← hSym]
    ring
  rw [hval]
  apply signedIntegral_norm_le
  intro θ
  change ‖(1 / 2 : ℝ) * (max (linearForm x 1 θ) 0 + max (linearForm (-x) (-1) θ) 0)‖ ≤ _
  have hh := reflect_ridge x 1 θ
  change max (linearForm x 1 (reflection d θ)) 0 = max (linearForm (-x) (-1) θ) 0 at hh
  rw [linearForm_reflection] at hh
  rw [← hh]
  have hAbs (a : ℝ) : max a 0 + max (-a) 0 = |a| := by
    rcases le_total 0 a with h | h
    · rw [max_eq_left h, max_eq_right (neg_nonpos.mpr h), add_zero, abs_of_nonneg h]
    · rw [max_eq_right h, max_eq_left (neg_nonneg.mpr h), zero_add, abs_of_nonpos h]
  rw [hAbs, Real.norm_of_nonneg (mul_nonneg (by norm_num) (abs_nonneg _)), ← Real.norm_eq_abs]
  apply mul_le_mul_of_nonneg_left _ (by norm_num)
  simpa [add_comm] using norm_linearForm_euclidean x 1 θ

theorem localization_pointwise_bound (E : MeasSet (BarronSphere d))
    (hE : reflection d ⁻¹' E.1 = E.1) (μ : FiniteSignedMeasure (BarronSphere d)) (x : Fin d → ℝ) :
    ‖synthesis μ x - localizedSynthesis E μ x‖ ≤
      (1 / 2) * Real.sqrt (1 + ∑ i, (x i)^2) *
        ‖cut ⟨E.1ᶜ, E.2.compl⟩ (reflectedEven d μ)‖ := by
  rw [congrFun (localizedSynthesis_difference E μ) x]
  apply synthesis_even_euclidean_bound
  rw [← reflectedEven_cut_complement E hE μ, reflectedEven_even]

#print axioms BarronSphere.localization_norm_exact
#print axioms BarronSphere.localization_pointwise_bound


/-- The Euclidean norm of the affine coefficients. -/
def affineEuclideanNorm (a : (Fin d → ℝ) × ℝ) : ℝ :=
  Real.sqrt ((∑ i, (a.1 i)^2) + a.2^2)

theorem norm_affineAtoms_euclidean (a : (Fin d → ℝ) × ℝ) :
    ‖affineAtoms d a‖ ≤ Real.sqrt (4 * (d : ℝ) + 1) * affineEuclideanNorm a := by
  refine (norm_affineAtoms_le_l1 a).trans ?_
  let W : Option (Fin d) → ℝ := fun i => i.elim 1 (fun _ => 2)
  let X : Option (Fin d) → ℝ := fun i => i.elim ‖a.2‖ (fun j => ‖a.1 j‖)
  have h := Finset.sum_mul_sq_le_sq_mul_sq Finset.univ W X
  simp only [Fintype.sum_option] at h
  change (1 * ‖a.2‖ + ∑ i, 2 * ‖a.1 i‖)^2 ≤
    ((1 : ℝ)^2 + ∑ _ : Fin d, (2 : ℝ)^2) * (‖a.2‖^2 + ∑ i, ‖a.1 i‖^2) at h
  simp only [one_mul, one_pow, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
    nsmul_eq_mul, Real.norm_eq_abs, sq_abs] at h
  have h0 : 0 ≤ (∑ i, 2 * ‖a.1 i‖) + ‖a.2‖ :=
    add_nonneg (Finset.sum_nonneg (fun _ _ => mul_nonneg (by norm_num) (norm_nonneg _))) (norm_nonneg _)
  have h1 := Real.sqrt_le_sqrt h
  rw [Real.sqrt_sq_eq_abs, abs_of_nonneg (show 0 ≤ |a.2| + ∑ i, 2 * |a.1 i| by simpa [Real.norm_eq_abs, add_comm] using h0),
    Real.sqrt_mul (by positivity)] at h1
  unfold affineEuclideanNorm
  simpa [Real.norm_eq_abs, add_comm, mul_comm, show (2 : ℝ)^2 = 4 by norm_num] using h1

private theorem moment_euclidean_le (μ : FiniteSignedMeasure (BarronSphere d)) :
    affineEuclideanNorm (fun i => signedIntegral (weightSymbol i) μ,
      signedIntegral (biasSymbol d) μ) ≤ ‖μ‖ := by
  let a : (Fin d → ℝ) × ℝ := (fun i => signedIntegral (weightSymbol i) μ,
      signedIntegral (biasSymbol d) μ)
  let r := affineEuclideanNorm a
  have h0 : 0 ≤ (∑ i, (a.1 i)^2) + a.2^2 :=
    add_nonneg (Finset.sum_nonneg (fun _ _ => sq_nonneg _)) (sq_nonneg _)
  have hs : r ^ 2 = (∑ i, (a.1 i)^2) + a.2^2 := Real.sq_sqrt h0
  have hb : ‖signedIntegral (linearFormSymbol a.1 a.2) μ‖ ≤ r * ‖μ‖ :=
    signedIntegral_norm_le _ _ r (norm_linearForm_euclidean a.1 a.2)
  rw [signedIntegral_linearForm] at hb
  change ‖(∑ i, a.1 i * a.1 i) + a.2 * a.2‖ ≤ r * ‖μ‖ at hb
  simp only [← sq, ← hs] at hb
  rw [Real.norm_of_nonneg (sq_nonneg r), sq] at hb
  by_cases hr : 0 < r
  · exact (mul_le_mul_iff_right₀ hr).mp hb
  · exact (le_of_not_gt hr).trans (norm_nonneg _)

private theorem euclidean_half_add_constant (a : (Fin d → ℝ) × ℝ) (c : ℝ) :
    affineEuclideanNorm (fun i => (1 / 2 : ℝ) * a.1 i, (1 / 2 : ℝ) * a.2 + c) ≤
      (1 / 2 : ℝ) * affineEuclideanNorm a + ‖c‖ := by
  let s := ∑ i, (a.1 i)^2
  let r := affineEuclideanNorm a
  have hs : 0 ≤ s := Finset.sum_nonneg (fun _ _ => sq_nonneg _)
  have hr : 0 ≤ r := Real.sqrt_nonneg _
  have hr2 : r^2 = s + a.2^2 := Real.sq_sqrt (add_nonneg hs (sq_nonneg _))
  have hs' : (∑ i, ((1 / 2 : ℝ) * a.1 i)^2) = (1 / 2 : ℝ)^2 * s := by
    simp only [mul_pow, Finset.mul_sum, s]
  have hab : ‖a.2‖ ≤ r := by
    rw [Real.norm_eq_abs, ← Real.sqrt_sq_eq_abs]
    exact Real.sqrt_le_sqrt (le_add_of_nonneg_left hs)
  have hprod : a.2 * c ≤ r * ‖c‖ :=
    (Real.le_norm_self _).trans (by rw [norm_mul]; exact mul_le_mul_of_nonneg_right hab (norm_nonneg _))
  have hc2 : ‖c‖^2 = c^2 := by rw [Real.norm_eq_abs, sq_abs]
  have hright : 0 ≤ (1 / 2 : ℝ) * r + ‖c‖ := by positivity
  change Real.sqrt ((∑ i, ((1 / 2 : ℝ) * a.1 i)^2) + ((1 / 2 : ℝ) * a.2 + c)^2) ≤ _
  rw [hs', ← abs_of_nonneg hright, ← Real.sqrt_sq_eq_abs]
  apply Real.sqrt_le_sqrt
  nlinarith

set_option maxHeartbeats 1000000 in
theorem norm_affineCoefficients_euclidean (μ : FiniteSignedMeasure (BarronSphere d)) :
    affineEuclideanNorm (affineCoefficients d μ) ≤
      (1 / 2 : ℝ) * ‖cut (nonPole d) μ‖ +
        ‖eval ⟨{polePlus d}, measurableSet_singleton _⟩ μ‖ := by
  let ξ := cut (nonPole d) μ
  let a : (Fin d → ℝ) × ℝ := (fun i => signedIntegral (weightSymbol i) ξ,
    signedIntegral (biasSymbol d) ξ)
  let c := eval (⟨{polePlus d}, measurableSet_singleton _⟩ : MeasSet (BarronSphere d)) μ
  change affineEuclideanNorm (fun i => (1 / 2 : ℝ) * a.1 i, (1 / 2 : ℝ) * a.2 + c) ≤
    (1 / 2 : ℝ) * ‖ξ‖ + ‖c‖
  exact (euclidean_half_add_constant a c).trans (add_le_add_left
    (mul_le_mul_of_nonneg_left (moment_euclidean_le ξ) (by norm_num)) _)

private theorem norm_cut_add_abs_eval_le (μ : FiniteSignedMeasure (BarronSphere d)) :
    ‖cut (nonPole d) μ‖ + ‖eval ⟨{polePlus d}, measurableSet_singleton _⟩ μ‖ ≤ ‖μ‖ := by
  let P : MeasSet (BarronSphere d) := ⟨{polePlus d}, measurableSet_singleton _⟩
  have hd : Disjoint (nonPole d).1 P.1 := by
    apply Set.disjoint_left.mpr
    intro θ hn hP
    change θ = polePlus d at hP
    subst θ
    exact hn.1 rfl
  change ‖cut (nonPole d) μ‖ + ‖eval P μ‖ ≤ _
  have hb := abs_eval_le_modulus μ P
  rw [← Real.norm_eq_abs] at hb
  refine (add_le_add_right hb _).trans ?_
  rw [← eval_modulus_eq_norm_cut]
  obtain ⟨φ, hφ, he⟩ := exists_charge (modulus μ)
  rw [← he, eval_ofCharge, eval_ofCharge, ← φ.add_union _ _ hd]
  have hp : φ.Positive := by
    intro E
    rw [← eval_ofCharge φ hφ E, he]
    exact modulus_positive μ E
  rw [← norm_modulus μ, ← he, norm_ofCharge, ScalarCharge.totalVariationMass]
  have hle : φ.val ((nonPole d).union P) ≤ φ.val MeasSet.whole :=
    φ.val_mono hp (subset_univ ((nonPole d).union P).1)
  have hv := φ.val_le_upperVariation (A := MeasSet.whole) (B := MeasSet.whole) (subset_refl _)
  have hz := φ.neg.upperVariation_nonneg MeasSet.whole
  linarith

theorem norm_canonicalProjection_le (μ : FiniteSignedMeasure (BarronSphere d)) :
    ‖canonicalProjection d μ‖ ≤ (1 + Real.sqrt (4 * (d : ℝ) + 1)) * ‖μ‖ := by
  have ha := norm_affineCoefficients_euclidean μ
  have hb := norm_cut_add_abs_eval_le μ
  have hγ : 0 ≤ ‖cut (nonPole d) μ‖ := norm_nonneg _
  have hA : affineEuclideanNorm (affineCoefficients d μ) ≤ ‖μ‖ := by linarith
  change ‖reflectedEven d μ + affineAtoms d (affineCoefficients d μ)‖ ≤ _
  refine (norm_add_le ..).trans ?_
  rw [add_mul, one_mul]
  exact add_le_add (reflectedEven_contractive μ)
    ((norm_affineAtoms_euclidean _).trans (mul_le_mul_of_nonneg_left hA (Real.sqrt_nonneg _)))

#print axioms BarronSphere.norm_affineAtoms_euclidean
#print axioms BarronSphere.norm_affineCoefficients_euclidean
#print axioms BarronSphere.norm_canonicalProjection_le


/-- ReLU synthesis with target the space of real functions on the input space. -/
def synthesisLinear (d : ℕ) : FiniteSignedMeasure (BarronSphere d) →ₗ[ℝ] ((Fin d → ℝ) → ℝ) :=
  LinearMap.pi fun x => (signedIntegral (ridgeSymbol x 1)).toLinearMap

/-- The range is exactly the space of functions with a finite signed ReLU representation. -/
abbrev BarronFunctions (d : ℕ) := LinearMap.range (synthesisLinear d)

def synthesisRange (d : ℕ) : FiniteSignedMeasure (BarronSphere d) →ₗ[ℝ] BarronFunctions d :=
  (synthesisLinear d).rangeRestrict

private theorem synthesisRange_surjective (d : ℕ) : Function.Surjective (synthesisRange d) := by
  intro f
  obtain ⟨μ, hμ⟩ := f.2
  exact ⟨μ, Subtype.ext hμ⟩

/-- The canonical right inverse of synthesis, taking values in the signed-measure space. -/
def canonicalAnalysis (d : ℕ) (hd : 1 ≤ d) :
    BarronFunctions d →ₗ[ℝ] FiniteSignedMeasure (BarronSphere d) where
  toFun f := canonicalProjection d ((synthesisRange_surjective d f).choose)
  map_add' f g := by
    have hf := (synthesisRange_surjective d f).choose_spec
    have hg := (synthesisRange_surjective d g).choose_spec
    have hfg := (synthesisRange_surjective d (f + g)).choose_spec
    let μ := (synthesisRange_surjective d f).choose
    let ν := (synthesisRange_surjective d g).choose
    let ζ := (synthesisRange_surjective d (f + g)).choose
    change canonicalProjection d ζ = canonicalProjection d μ + canonicalProjection d ν
    rw [← map_add]
    apply canonicalProjection_eq_of_synthesis_eq hd
    have h : synthesisRange d ζ = synthesisRange d (μ + ν) := by
      rw [map_add, hf, hg]
      exact hfg
    exact congrArg Subtype.val h
  map_smul' c f := by
    have hf := (synthesisRange_surjective d f).choose_spec
    have hcf := (synthesisRange_surjective d (c • f)).choose_spec
    let μ := (synthesisRange_surjective d f).choose
    let ν := (synthesisRange_surjective d (c • f)).choose
    change canonicalProjection d ν = c • canonicalProjection d μ
    rw [← map_smul]
    apply canonicalProjection_eq_of_synthesis_eq hd
    have h : synthesisRange d ν = synthesisRange d (c • μ) := by
      rw [map_smul, hf]
      exact hcf
    exact congrArg Subtype.val h

theorem canonicalAnalysis_synthesis (hd : 1 ≤ d) (μ : FiniteSignedMeasure (BarronSphere d)) :
    canonicalAnalysis d hd (synthesisRange d μ) = canonicalProjection d μ :=
  canonicalProjection_eq_of_synthesis_eq hd
    (congrArg Subtype.val (synthesisRange_surjective d (synthesisRange d μ)).choose_spec)

theorem synthesis_canonicalAnalysis (hd : 1 ≤ d) (f : BarronFunctions d) :
    synthesisRange d (canonicalAnalysis d hd f) = f := by
  obtain ⟨μ, rfl⟩ := synthesisRange_surjective d f
  rw [canonicalAnalysis_synthesis]
  apply Subtype.ext
  exact funext (synthesis_canonicalProjection μ)

theorem norm_canonicalAnalysis_le (hd : 1 ≤ d) (f : BarronFunctions d) :
    ‖canonicalAnalysis d hd f‖ ≤ (1 + Real.sqrt (4 * (d : ℝ) + 1)) * synthesisQuotientNorm f.1 := by
  let k := 1 + Real.sqrt (4 * (d : ℝ) + 1)
  have hk : 0 < k := by unfold k; positivity
  have hV : ({a | ∃ μ : FiniteSignedMeasure (BarronSphere d), synthesis μ = f.1 ∧ a = ‖μ‖} :
      Set ℝ).Nonempty := by
    obtain ⟨μ, hμ⟩ := synthesisRange_surjective d f
    exact ⟨‖μ‖, μ, congrArg Subtype.val hμ, rfl⟩
  change ‖canonicalAnalysis d hd f‖ ≤ k * synthesisQuotientNorm f.1
  rw [mul_comm k, ← div_le_iff₀ hk]
  apply le_csInf hV
  rintro _ ⟨μ, hμ, rfl⟩
  apply (div_le_iff₀ hk).mpr
  have hf : synthesisRange d μ = f := Subtype.ext hμ
  rw [← hf, canonicalAnalysis_synthesis, mul_comm]
  exact norm_canonicalProjection_le μ

#print axioms BarronSphere.canonicalAnalysis_synthesis
#print axioms BarronSphere.synthesis_canonicalAnalysis
#print axioms BarronSphere.norm_canonicalAnalysis_le


private theorem canonicalProjection_even (γ : FiniteSignedMeasure (BarronSphere d))
    (hγ : reflectedEven d γ = γ) : canonicalProjection d γ = γ := by
  have hA := affineCoefficients_reflectedEven γ
  rw [hγ] at hA
  change reflectedEven d γ + affineAtoms d (affineCoefficients d γ) = γ
  rw [hγ, hA, map_zero, add_zero]

private theorem canonicalProjection_affineAtoms (a : (Fin d → ℝ) × ℝ) :
    canonicalProjection d (affineAtoms d a) = affineAtoms d a := by
  change reflectedEven d (affineAtoms d a) + affineAtoms d (affineCoefficients d (affineAtoms d a)) = _
  rw [reflectedEven_affineAtoms, affineCoefficients_affineAtoms, zero_add]

private theorem cut_affineAtoms (E : MeasSet (BarronSphere d))
    (hE : reflection d ⁻¹' E.1 = E.1) (a : (Fin d → ℝ) × ℝ) :
    cut E (affineAtoms d a) = affineAtoms d
      (fun i => if axis i ∈ E.1 then a.1 i else 0, if polePlus d ∈ E.1 then a.2 else 0) := by
  let L := (cut E).toLinearMap
  change L (affineAtoms d a) = _
  rw [affineAtoms_apply, map_add, map_sum, map_smul, affineAtoms_apply]
  congr 1
  · apply Finset.sum_congr rfl
    intro i _
    have hmem : axisMinus i ∈ E.1 ↔ axis i ∈ E.1 := by
      change axis i ∈ reflection d ⁻¹' E.1 ↔ _
      rw [hE]
    rw [map_smul, show L (pointMass (axis i) - pointMass (axisMinus i)) =
      L (pointMass (axis i)) - L (pointMass (axisMinus i)) from map_sub L _ _]
    change a.1 i • (cut E (pointMass (axis i)) - cut E (pointMass (axisMinus i))) =
      (if axis i ∈ E.1 then a.1 i else 0) • (pointMass (axis i) - pointMass (axisMinus i))
    rw [cut_pointMass, cut_pointMass]
    by_cases hi : axis i ∈ E.1
    · simp [hi, hmem.mpr hi]
    · simp [hi, hmem.not.mpr hi]
  · change a.2 • cut E (pointMass (polePlus d)) =
      (if polePlus d ∈ E.1 then a.2 else 0) • pointMass (polePlus d)
    rw [cut_pointMass]
    split <;> simp

theorem symmetric_cut_preserves_canonical (E : MeasSet (BarronSphere d))
    (hE : reflection d ⁻¹' E.1 = E.1) (μ : FiniteSignedMeasure (BarronSphere d)) :
    canonicalProjection d (cut E (canonicalProjection d μ)) = cut E (canonicalProjection d μ) := by
  let L := (cut E).toLinearMap
  change canonicalProjection d (L (reflectedEven d μ + affineAtoms d (affineCoefficients d μ))) =
    L (reflectedEven d μ + affineAtoms d (affineCoefficients d μ))
  rw [map_add, map_add]
  change canonicalProjection d (cut E (reflectedEven d μ)) +
      canonicalProjection d (cut E (affineAtoms d (affineCoefficients d μ))) =
    cut E (reflectedEven d μ) + cut E (affineAtoms d (affineCoefficients d μ))
  rw [canonicalProjection_even _ (cut_preserves_even_supported E hE _
    (reflectedEven_even μ) (reflectedEven_supported μ)), cut_affineAtoms E hE,
    canonicalProjection_affineAtoms]

/-- The measurable operator value obtained by compressing the concrete restriction map. -/
def compressedRestriction (hd : 1 ≤ d) (E : MeasSet (BarronSphere d)) :
    BarronFunctions d →ₗ[ℝ] BarronFunctions d :=
  (synthesisRange d).comp ((cut E).toLinearMap.comp (canonicalAnalysis d hd))

theorem compressedRestriction_symmetric_mul (hd : 1 ≤ d) (E F : MeasSet (BarronSphere d))
    (hF : reflection d ⁻¹' F.1 = F.1) (f : BarronFunctions d) :
    compressedRestriction hd E (compressedRestriction hd F f) =
      compressedRestriction hd (E.inter F) f := by
  obtain ⟨μ, rfl⟩ := synthesisRange_surjective d f
  unfold compressedRestriction
  simp only [LinearMap.comp_apply, canonicalAnalysis_synthesis]
  change synthesisRange d (cut E (canonicalProjection d (cut F (canonicalProjection d μ)))) =
    synthesisRange d (cut (E.inter F) (canonicalProjection d μ))
  rw [symmetric_cut_preserves_canonical F hF]
  congr 1
  apply FiniteSignedMeasure.ext
  intro H
  simp only [eval_cut]
  rw [show (H.inter E).inter F = H.inter (E.inter F) from Subtype.ext (inter_assoc _ _ _)]

#print axioms BarronSphere.symmetric_cut_preserves_canonical
#print axioms BarronSphere.compressedRestriction_symmetric_mul


instance synthesisKernel_closed (d : ℕ) :
    IsClosed ((synthesisLinear d).ker : Set (FiniteSignedMeasure (BarronSphere d))) := by
  have he : ((synthesisLinear d).ker : Set (FiniteSignedMeasure (BarronSphere d))) =
      ⋂ x : Fin d → ℝ, ((signedIntegral (ridgeSymbol x 1)).ker : Set (FiniteSignedMeasure (BarronSphere d))) := by
    ext μ
    rw [Set.mem_iInter]
    change (fun x => signedIntegral (ridgeSymbol x 1) μ) = 0 ↔
      ∀ x : Fin d → ℝ, signedIntegral (ridgeSymbol x 1) μ = 0
    exact ⟨fun h x => congrFun h x, fun h => funext h⟩
  rw [he]
  exact isClosed_iInter fun x => (signedIntegral (ridgeSymbol x 1)).isClosed_ker

/-- The complete normed realization with the quotient of the variation norm. -/
abbrev BarronBanach (d : ℕ) := (FiniteSignedMeasure (BarronSphere d)) ⧸ (synthesisLinear d).ker

def synthesisQuotient (d : ℕ) : FiniteSignedMeasure (BarronSphere d) →L[ℝ] BarronBanach d :=
  (synthesisLinear d).ker.mkQL

def canonicalProjectionCLM (d : ℕ) :
    FiniteSignedMeasure (BarronSphere d) →L[ℝ] FiniteSignedMeasure (BarronSphere d) :=
  (canonicalProjection d).mkContinuous (1 + Real.sqrt (4 * (d : ℝ) + 1)) norm_canonicalProjection_le

def canonicalSection (hd : 1 ≤ d) : BarronBanach d →L[ℝ] FiniteSignedMeasure (BarronSphere d) :=
  (synthesisLinear d).ker.liftQL (canonicalProjectionCLM d) (fun μ h => by
    change canonicalProjection d μ = 0
    apply (canonicalProjection_kernel_eq_synthesis_kernel hd μ).mpr
    exact fun x => congrFun (LinearMap.mem_ker.mp h) x)

theorem canonicalSection_synthesisQuotient (hd : 1 ≤ d) (μ : FiniteSignedMeasure (BarronSphere d)) :
    canonicalSection hd (synthesisQuotient d μ) = canonicalProjection d μ := rfl

theorem synthesisQuotient_canonicalSection (hd : 1 ≤ d) (z : BarronBanach d) :
    synthesisQuotient d (canonicalSection hd z) = z := by
  obtain ⟨μ, rfl⟩ := (synthesisLinear d).ker.mkQ_surjective z
  change synthesisQuotient d (canonicalSection hd (synthesisQuotient d μ)) = synthesisQuotient d μ
  rw [canonicalSection_synthesisQuotient]
  apply (Submodule.Quotient.eq _).mpr
  apply LinearMap.mem_ker.mpr
  rw [map_sub]
  exact sub_eq_zero.mpr (funext (synthesis_canonicalProjection μ))

theorem norm_synthesisQuotient_eq (μ : FiniteSignedMeasure (BarronSphere d)) :
    ‖synthesisQuotient d μ‖ = synthesisQuotientNorm (synthesis μ) := by
  let Q := (synthesisLinear d).ker
  let V : Set ℝ := {a | ∃ ν : FiniteSignedMeasure (BarronSphere d), synthesis ν = synthesis μ ∧ a = ‖ν‖}
  have hV : V.Nonempty := ⟨‖μ‖, μ, rfl, rfl⟩
  have he (ν : FiniteSignedMeasure (BarronSphere d)) :
      synthesisQuotient d ν = synthesisQuotient d μ ↔ synthesis ν = synthesis μ := by
    change (Submodule.Quotient.mk ν : BarronBanach d) = Submodule.Quotient.mk μ ↔ _
    rw [Submodule.Quotient.eq, LinearMap.mem_ker, map_sub, sub_eq_zero]
    rfl
  change ‖Q.mkQ μ‖ = sInf V
  have hb : ‖Q.mkQ μ‖ ∈ lowerBounds V := by
    rintro _ ⟨ν, hν, rfl⟩
    have hh := (he ν).mpr hν
    change Q.mkQ ν = Q.mkQ μ at hh
    rw [← hh]
    exact Submodule.Quotient.norm_mk_le Q ν
  refine le_antisymm (le_csInf hV hb) (le_of_forall_pos_le_add fun ε hε => ?_)
  obtain ⟨ν, hν, hn⟩ := Submodule.Quotient.norm_mk_lt (Q.mkQ μ) hε
  exact (csInf_le ⟨_, hb⟩ ⟨ν, (he ν).mp hν, rfl⟩).trans hn.le

/-- The manuscript's signed-measure compression on the Banach quotient. -/
def barronOperatorMeasure (hd : 1 ≤ d) : OVM (BarronSphere d) (BarronBanach d) :=
  (restrictionPVM (BarronSphere d)).compressed (synthesisQuotient d) (canonicalSection hd)

theorem barronOperatorMeasure_normalized (hd : 1 ≤ d) : (barronOperatorMeasure hd).Normalized :=
  (restrictionPVM (BarronSphere d)).compressed_normalized _ _ (synthesisQuotient_canonicalSection hd)

theorem barronOperatorMeasure_symmetric_mul (hd : 1 ≤ d) (E F : MeasSet (BarronSphere d))
    (hF : reflection d ⁻¹' F.1 = F.1) (z : BarronBanach d) :
    (barronOperatorMeasure hd).val E ((barronOperatorMeasure hd).val F z) =
      (barronOperatorMeasure hd).val (E.inter F) z := by
  obtain ⟨μ, rfl⟩ := (synthesisLinear d).ker.mkQ_surjective z
  change synthesisQuotient d (cut E (canonicalSection hd
      (synthesisQuotient d (cut F (canonicalSection hd (synthesisQuotient d μ)))))) =
    synthesisQuotient d (cut (E.inter F) (canonicalSection hd (synthesisQuotient d μ)))
  rw [canonicalSection_synthesisQuotient, canonicalSection_synthesisQuotient,
    symmetric_cut_preserves_canonical F hF]
  congr 1
  apply FiniteSignedMeasure.ext
  intro A
  simp only [eval_cut]
  rw [show (A.inter E).inter F = A.inter (E.inter F) from Subtype.ext (inter_assoc _ _ _)]

