private theorem intervalLpOne_integrable (x : IntervalL1) : Integrable x lebesgueUnitInterval :=
  memLp_one_iff_integrable.mp (Lp.memLp x)

private theorem intervalNorm_eq_integral (x : IntervalL1) :
    ‖x‖ = ∫ t, |x t| ∂lebesgueUnitInterval := by
  have hx := intervalLpOne_integrable x
  rw [Lp.norm_def, eLpNorm_one_eq_lintegral_eNorm hx.aestronglyMeasurable,
    ← ofReal_integral_norm_eq_lintegral_eNorm hx, ENNReal.toReal_ofReal (integral_nonneg fun _ => norm_nonneg _)]
  rfl

private theorem intervalL1_finsetSum_ae (z : ℕ → IntervalL1) (I : Finset ℕ) :
    (fun t => (∑ n ∈ I, z n) t) =ᵐ[lebesgueUnitInterval] fun t => ∑ n ∈ I, z n t := by
  classical
  induction I using Finset.induction_on with
  | empty =>
    filter_upwards [Lp.coeFn_zero ℝ (1 : ℝ≥0∞) lebesgueUnitInterval] with t ht
    rw [Finset.sum_empty, Finset.sum_empty]
    exact ht
  | @insert n I hn ih =>
    simp only [Finset.sum_insert hn]
    filter_upwards [Lp.coeFn_add (z n) (∑ j ∈ I, z j), ih] with t ht hi
    rw [ht]
    change z n t + (∑ j ∈ I, z j) t = _
    rw [hi]

theorem intervalL1_disjoint_norm_sum (D : ℕ → MeasSet ℝ) (z : ℕ → IntervalL1)
    (hD : MeasSet.DisjointSeq D) (hz : ∀ n, intervalL1PVM.val (D n) (z n) = z n)
    (I : Finset ℕ) : ‖∑ n ∈ I, z n‖ = ∑ n ∈ I, ‖z n‖ := by
  classical
  have hsupport (n : ℕ) : ∀ᵐ t ∂lebesgueUnitInterval, t ∉ (D n).1 → z n t = 0 := by
    have he := FiniteSignedMeasure.lpCut_ae (D n) (z n)
    change (fun t => intervalL1PVM.val (D n) (z n) t) =ᵐ[lebesgueUnitInterval] _ at he
    rw [hz] at he
    filter_upwards [he] with t ht hnt
    exact ht.trans (indicator_of_notMem hnt _)
  simp_rw [intervalNorm_eq_integral]
  rw [← integral_finsetSum I (fun n _ => (intervalLpOne_integrable (z n)).abs)]
  apply integral_congr_ae
  filter_upwards [intervalL1_finsetSum_ae z I, ae_all_iff.mpr hsupport] with t ht hst
  rw [ht]
  by_cases h : ∃ n ∈ I, t ∈ (D n).1
  · obtain ⟨n, hn, ht⟩ := h
    have hzj (j : ℕ) (hj : j ≠ n) : z j t = 0 :=
      hst j (fun h => (Set.disjoint_left.mp (hD hj)) h ht)
    rw [Finset.sum_eq_single_of_mem n hn (fun j _ hj => hzj j hj),
      Finset.sum_eq_single_of_mem n hn (fun j _ hj => by rw [hzj j hj, abs_zero])]
  · have hz' (n : ℕ) (hn : n ∈ I) : z n t = 0 := hst n (fun H => h ⟨n,hn,H⟩)
    rw [Finset.sum_eq_zero hz', abs_zero]
    symm
    exact Finset.sum_eq_zero (fun n hn => by rw [hz' n hn, abs_zero])

private theorem intervalL1_cut_norm_sum_le (D : ℕ → MeasSet ℝ)
    (hD : MeasSet.DisjointSeq D) (I : Finset ℕ) (x : IntervalL1) :
    ∑ n ∈ I, ‖intervalL1PVM.val (D n) x‖ ≤ ‖x‖ := by
  classical
  simp_rw [intervalNorm_eq_integral]
  rw [← integral_finsetSum I (fun n _ => (intervalLpOne_integrable (intervalL1PVM.val (D n) x)).abs)]
  apply integral_mono_ae (integrable_finsetSum I (fun n _ => (intervalLpOne_integrable (intervalL1PVM.val (D n) x)).abs))
    (intervalLpOne_integrable x).abs
  have hcut (n : ℕ) : (fun t => intervalL1PVM.val (D n) x t) =ᵐ[lebesgueUnitInterval]
      (D n).1.indicator x := FiniteSignedMeasure.lpCut_ae (D n) x
  filter_upwards [ae_all_iff.mpr hcut] with t ht
  by_cases h : ∃ n ∈ I, t ∈ (D n).1
  · obtain ⟨n, hn, htn⟩ := h
    rw [Finset.sum_eq_single_of_mem n hn (fun j _ hj => by
      rw [ht,indicator_of_notMem (fun H => (Set.disjoint_left.mp (hD hj)) H htn), abs_zero]),
      ht, indicator_of_mem htn]
  · rw [Finset.sum_eq_zero (fun n hn => by
      rw [ht,indicator_of_notMem (fun H => h ⟨n,hn,H⟩),abs_zero])]
    exact abs_nonneg _

theorem intervalL1_boundedlyComplete_disjoint : intervalL1PVM.BoundedlyComplete := by
  intro D z hD hz hbound
  obtain ⟨C, hC⟩ := hbound
  have hsum : Summable (fun n => ‖z n‖) :=
    summable_of_sum_range_le (fun _ => norm_nonneg _) (fun N => by
      rw [← intervalL1_disjoint_norm_sum D z hD hz]
      exact hC N)
  exact ⟨∑' n, z n, (hsum.of_norm.hasSum).tendsto_sum_nat⟩

private theorem intervalL1_simpleIntegral_eq (a : MeasSet ℝ →₀ ℝ) (E : MeasSet ℝ) :
    vectorSimpleIntegral intervalL1VectorMeasure a E =
      intervalL1PVM.val E (Finsupp.linearCombination ℝ intervalL1VectorMeasure a) := by
  unfold vectorSimpleIntegral
  simp only [Finsupp.linearCombination_apply,Finsupp.sum,map_sum]
  apply Finset.sum_congr rfl
  intro B _
  rw [map_smul]
  unfold intervalL1VectorMeasure
  have h := congrArg (fun L : IntervalL1 →L[ℝ] IntervalL1 => L (intervalL1Indicator MeasSet.whole))
    (intervalL1PVM.mul_eq E B)
  exact congrArg (a B • ·) h.symm

theorem intervalL1_indicators_dense :
    Dense (Submodule.span ℝ (Set.range intervalL1VectorMeasure) : Set IntervalL1) := by
  let W := Submodule.span ℝ (Set.range intervalL1VectorMeasure)
  have hsimple' (a : Lp.simpleFunc ℝ (1 : ℝ≥0∞) lebesgueUnitInterval) :
      (a : IntervalL1) ∈ W := by
    apply Lp.simpleFunc.induction one_ne_zero ENNReal.one_ne_top
      (P := fun f => (f : IntervalL1) ∈ W) _ _ a
    · intro c E hE hfin
      let A : MeasSet ℝ := ⟨E,hE⟩
      change (indicatorConstLp 1 A.2 (measure_ne_top _ _) c : IntervalL1) ∈ W
      have he : (indicatorConstLp 1 A.2 (measure_ne_top _ _) c : IntervalL1) =
          c • intervalL1VectorMeasure A := by
        rw [intervalL1VectorMeasure_indicator]
        apply Lp.ext
        filter_upwards [indicatorConstLp_coeFn (p := 1) (hs := A.2)
          (hμs := measure_ne_top lebesgueUnitInterval A.1) (c := c),
          indicatorConstLp_coeFn (p := 1) (hs := A.2)
          (hμs := measure_ne_top lebesgueUnitInterval A.1) (c := (1 : ℝ)),
          Lp.coeFn_smul c (intervalL1Indicator A)] with t hc h1 ht
        rw [hc, ht]
        change A.1.indicator (fun _ => c) t = c * intervalL1Indicator A t
        have hh : intervalL1Indicator A t = _ := h1
        rw [hh]
        by_cases H : t ∈ A.1 <;> simp [H]
      rw [he]
      exact W.smul_mem _ (Submodule.subset_span ⟨A,rfl⟩)
    · intro f g _ _ _ hf hg
      exact W.add_mem hf hg
  exact (Lp.simpleFunc.dense ENNReal.one_ne_top).mono (fun f hf => hsimple' ⟨f,hf⟩)

theorem intervalL1_cyclic_one : intervalL1PVM.CyclicVector (intervalL1Indicator MeasSet.whole) :=
  intervalL1_indicators_dense

theorem intervalL1_vectorIntegration_isometry {Y : Type*} [NormedAddCommGroup Y]
    [NormedSpace ℝ Y] [CompleteSpace Y] (M : VectorMeasureL1Data intervalL1VectorMeasure Y) :
    (∀ y, ‖M.integration y‖ = ‖y‖) ∧ Function.Surjective M.integration := by
  have hsimple (a : MeasSet ℝ →₀ ℝ) :
      ‖M.integration (Finsupp.linearCombination ℝ M.indicator a)‖ =
        ‖Finsupp.linearCombination ℝ M.indicator a‖ := by
    have hi : M.integration (Finsupp.linearCombination ℝ M.indicator a) =
      Finsupp.linearCombination ℝ intervalL1VectorMeasure a := by
      simp only [Finsupp.linearCombination_apply,Finsupp.sum,map_sum,map_smul,M.integration_indicator]
    apply le_antisymm
    · exact (M.integration.le_opNorm _).trans (by
        simpa only [one_mul] using mul_le_mul_of_nonneg_right M.norm_integration_le_one (norm_nonneg _))
    · rw [M.norm_simple, hi]
      apply csSup_le
      · exact ⟨0,0,by simp,fun _ => MeasSet.empty,fun _ _ _ => by simp [MeasSet.empty],∅,by simp⟩
      · rintro r ⟨g,hg,D,hD,I,rfl⟩
        simp_rw [intervalL1_simpleIntegral_eq]
        refine (Finset.sum_le_sum fun n _ => ?_).trans (intervalL1_cut_norm_sum_le D hD I _)
        simpa only [Real.norm_eq_abs,one_mul] using
          (g.le_opNorm (intervalL1PVM.val (D n) (Finsupp.linearCombination ℝ intervalL1VectorMeasure a))).trans
            (mul_le_mul_of_nonneg_right hg (norm_nonneg _))
  have hd := M.dense_indicators
  have hclosed : IsClosed {y : Y | ‖M.integration y‖ = ‖y‖} :=
    isClosed_eq M.integration.continuous.norm continuous_norm
  have hn (y : Y) : ‖M.integration y‖ = ‖y‖ := by
    have hsub : (Submodule.span ℝ (Set.range M.indicator) : Set Y) ⊆
        {y | ‖M.integration y‖ = ‖y‖} := by
      rw [← Finsupp.range_linearCombination]
      rintro _ ⟨a,rfl⟩
      exact hsimple a
    exact closure_minimal hsub hclosed (hd y)
  refine ⟨hn, ?_⟩
  have hisom : Isometry M.integration := AddMonoidHomClass.isometry_of_norm M.integration hn
  have hc : IsClosed (Set.range M.integration) := hisom.antilipschitzWith.isClosedEmbedding hisom.uniformContinuous |>.isClosed_range
  have hs : (Submodule.span ℝ (Set.range intervalL1VectorMeasure) : Set IntervalL1) ⊆ Set.range M.integration := by
    change Submodule.span ℝ (Set.range intervalL1VectorMeasure) ≤ M.integration.toLinearMap.range
    apply Submodule.span_le.mpr
    rintro _ ⟨E,rfl⟩
    exact ⟨M.indicator E,M.integration_indicator E⟩
  exact fun x => closure_minimal hs hc (intervalL1_indicators_dense x)

#print axioms intervalL1_cyclic_one
#print axioms intervalL1_disjoint_norm_sum
#print axioms intervalL1_boundedlyComplete_disjoint
#print axioms intervalL1_vectorIntegration_isometry

