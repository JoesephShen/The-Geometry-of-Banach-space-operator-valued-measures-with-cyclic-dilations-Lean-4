noncomputable section SectionSevenMultiplicity

open MeasureTheory Set Filter
open scoped Topology ENNReal

variable {Ω X : Type} [MeasurableSpace Ω] [NormedAddCommGroup X] [NormedSpace ℝ X]

/-- Finite generation on a spectral piece, written in the ambient space. -/
def PVM.FinitelyGeneratedOn (P : PVM Ω X) (E : MeasSet Ω) : Prop :=
  ∃ (r : ℕ) (v : Fin r → X), (∀ i, P.val E (v i) = v i) ∧
    closure (Submodule.span ℝ (P.generatorOrbit v) : Set X) = Set.range (P.val E)

def PVM.HasFiniteMultiplicity (P : PVM Ω X) : Prop :=
  ∃ A : ℕ → MeasSet Ω, MeasSet.DisjointSeq A ∧ MeasSet.iUnion A = MeasSet.whole ∧
    ∀ n, (A n).1.Nonempty → P.FinitelyGeneratedOn (A n)

theorem PVM.finiteMultiplicity_of_finitelyGenerated (P : PVM Ω X) (h : P.FinitelyGenerated) :
    P.HasFiniteMultiplicity := by
  classical
  let A (n : ℕ) : MeasSet Ω := if n = 0 then MeasSet.whole else MeasSet.empty
  have ha : A 0 = MeasSet.whole := by simp [A]
  have hcover : MeasSet.iUnion A = MeasSet.whole := by
    ext t
    change (t ∈ ⋃ n, (A n).1) ↔ t ∈ Set.univ
    exact ⟨fun _ => mem_univ _,fun _ => mem_iUnion.mpr ⟨0,by simp [ha,MeasSet.whole]⟩⟩
  refine ⟨A,?_,hcover,fun n hn => ?_⟩
  · intro i j hij
    by_cases hi : i = 0
    · have hj : j ≠ 0 := by
        intro h
        exact hij (hi.trans h.symm)
      simp [A,hj,MeasSet.empty]
    · simp [A,hi,MeasSet.empty]
  · have he : n = 0 := by
      by_contra h
      simp [A,h,MeasSet.empty] at hn
    subst n
    rw [ha]
    obtain ⟨r,v,hv⟩ := h
    refine ⟨r,v,fun i => ?_,?_⟩
    · rw [show P.val MeasSet.whole = ContinuousLinearMap.id ℝ X from P.normalized]
      rfl
    · rw [hv.closure_eq,show P.val MeasSet.whole = ContinuousLinearMap.id ℝ X from P.normalized]
      exact Set.range_id.symm

variable {Y : Type} [NormedAddCommGroup Y] [NormedSpace ℝ Y]

theorem SequenceCoordinates.nonempty_not_finitelyGeneratedOn {W : Type}
    [NormedAddCommGroup W] [NormedSpace ℝ W]
    (S : SequenceCoordinates W Y) (hY : ¬ FiniteDimensional ℝ Y)
    (A : MeasSet ℕ) (hA : A.1.Nonempty) :
    ¬ S.pvm.FinitelyGeneratedOn A := by
  classical
  obtain ⟨j,hj⟩ := hA
  rintro ⟨r,v,_,hv⟩
  let V := Submodule.span ℝ (Set.range fun i : Fin r => S.eval j (v i))
  have hF : FiniteDimensional ℝ V := FiniteDimensional.span_of_finite ℝ (Set.finite_range _)
  have hc : IsClosed (V : Set Y) := Submodule.isClosed_of_finiteDimensional V
  have hspan : (Submodule.span ℝ (S.pvm.generatorOrbit v) : Set W) ⊆ S.eval j ⁻¹' (V : Set Y) := by
    change Submodule.span ℝ (S.pvm.generatorOrbit v) ≤ V.comap (S.eval j).toLinearMap
    apply Submodule.span_le.mpr
    rintro _ ⟨i,E,rfl⟩
    change S.eval j (S.cut E.1 (v i)) ∈ V
    rw [S.cut_eval]
    by_cases h : j ∈ E.1
    · rw [ite_eq_left h]
      exact Submodule.subset_span ⟨i,rfl⟩
    · rw [ite_eq_right h]
      exact V.zero_mem
  have ht (y : Y) : y ∈ V := by
    have hr : S.single j y ∈ Set.range (S.pvm.val A) := by
      refine ⟨S.single j y,?_⟩
      apply S.separates
      intro k
      change S.eval k (S.cut A.1 (S.single j y)) = S.eval k (S.single j y)
      rw [S.cut_eval,S.single_eval]
      by_cases h : k = j
      · subst k
        simp [hj]
      · simp [h]
    rw [← hv] at hr
    have h := closure_minimal hspan (hc.preimage (S.eval j).continuous) hr
    change S.eval j (S.single j y) ∈ V at h
    rwa [S.single_eval,ite_eq_left rfl] at h
  have htop : V = ⊤ := Submodule.eq_top_iff'.mpr ht
  have : FiniteDimensional ℝ (⊤ : Submodule ℝ Y) := htop ▸ hF
  let e : Y ≃ₗ[ℝ] (⊤ : Submodule ℝ Y) := Submodule.topEquiv.symm
  exact hY (FiniteDimensional.of_injective e.toLinearMap e.injective)

theorem SequenceCoordinates.no_finiteMultiplicity {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W]
    (S : SequenceCoordinates W Y) (hY : ¬ FiniteDimensional ℝ Y) :
    ¬ S.pvm.HasFiniteMultiplicity := by
  rintro ⟨A,_,hU,hA⟩
  obtain ⟨n,hn⟩ : ∃ n, 0 ∈ (A n).1 := by
    apply Set.mem_iUnion.mp
    change 0 ∈ (MeasSet.iUnion A).1
    rw [hU]
    exact mem_univ _
  exact S.nonempty_not_finitelyGeneratedOn hY (A n) ⟨0,hn⟩ (hA n ⟨0,hn⟩)

#print axioms PVM.finiteMultiplicity_of_finitelyGenerated
#print axioms SequenceCoordinates.nonempty_not_finitelyGeneratedOn
#print axioms SequenceCoordinates.no_finiteMultiplicity

end SectionSevenMultiplicity
end Paper


