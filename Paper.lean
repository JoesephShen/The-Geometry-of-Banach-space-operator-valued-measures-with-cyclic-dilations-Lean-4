theorem probability_localization_error (hd : 1 ≤ d) (E : MeasSet (BarronSphere d))
    (hE : reflection d ⁻¹' E.1 = E.1) (μ : FiniteSignedMeasure (BarronSphere d))
    (hμ : reflectedEven d μ ≠ 0) :
    let γ := reflectedEven d μ
    let F := (nonPole d).inter ⟨E.1ᶜ, E.2.compl⟩
    let ν := toMeasure (‖γ‖⁻¹ • modulus γ) (normalized_modulus γ hμ).1
    IsProbabilityMeasure ν ∧
      ν F.1 = ENNReal.ofReal
        (synthesisQuotientNorm (fun x => synthesis μ x - localizedSynthesis E μ x) / ‖γ‖) := by
  dsimp only
  refine ⟨toMeasure_isProbability _ _ (normalized_modulus _ hμ).2, ?_⟩
  rw [FiniteSignedMeasure.toMeasure_apply, map_smul, smul_eq_mul, (localization_norm_exact hd E hE μ).2]
  congr 1
  rw [div_eq_mul_inv, mul_comm]

private theorem sphere_zero_eq_one_of_poles (θ : BarronSphere 0) :
    θ = polePlus 0 ∨ θ = poleMinus 0 := by
  have hn : θ ∉ (nonPole 0).1 := fun h => by
    obtain ⟨i, _⟩ := nonPole_has_nonzero_weight θ h
    exact Fin.elim0 i
  rwa [nonPole_eq_compl, notMem_compl_iff, mem_insert_iff, mem_singleton_iff] at hn

theorem homogeneousSynthesis_zero_dim_injective (μ : FiniteSignedMeasure (BarronSphere 0))
    (h : ∀ (x : Fin 0 → ℝ) (t : ℝ), homogeneousSynthesis μ x t = 0) : μ = 0 := by
  let P : MeasSet (BarronSphere 0) := ⟨{polePlus 0}, measurableSet_singleton _⟩
  let N : MeasSet (BarronSphere 0) := ⟨{poleMinus 0}, measurableSet_singleton _⟩
  have hPN : polePlus 0 ≠ poleMinus 0 := by
    intro he
    have hb := congrArg bias he
    norm_num [polePlus, poleMinus, bias] at hb
  have hp : eval P μ = 0 := by
    have he : signedIntegral (ridgeSymbol (0 : Fin 0 → ℝ) 1) =
        signedIntegral (measurableIndicator P) := by
      apply signedIntegral_congr
      intro θ
      rcases sphere_zero_eq_one_of_poles θ with rfl | rfl
      · change max (linearForm 0 1 (polePlus 0)) 0 = P.1.indicator (fun _ => (1 : ℝ)) (polePlus 0)
        simp [P, linearForm_polePlus]
      · change max (linearForm 0 1 (poleMinus 0)) 0 = P.1.indicator (fun _ => (1 : ℝ)) (poleMinus 0)
        simp [P, linearForm_poleMinus, hPN.symm]
    rw [← signedIntegral_indicator_eq_eval, ← he]
    exact h 0 1
  have hn : eval N μ = 0 := by
    have he : signedIntegral (ridgeSymbol (0 : Fin 0 → ℝ) (-1)) =
        signedIntegral (measurableIndicator N) := by
      apply signedIntegral_congr
      intro θ
      rcases sphere_zero_eq_one_of_poles θ with rfl | rfl
      · change max (linearForm 0 (-1) (polePlus 0)) 0 = N.1.indicator (fun _ => (1 : ℝ)) (polePlus 0)
        simp [N, linearForm_polePlus, hPN]
      · change max (linearForm 0 (-1) (poleMinus 0)) 0 = N.1.indicator (fun _ => (1 : ℝ)) (poleMinus 0)
        simp [N, linearForm_poleMinus]
    rw [← signedIntegral_indicator_eq_eval, ← he]
    exact h 0 (-1)
  apply FiniteSignedMeasure.ext
  intro E
  rw [map_zero]
  have hpart : E = (E.inter P).union (E.inter N) := by
    apply Subtype.ext
    ext θ
    change θ ∈ E.1 ↔ (θ ∈ E.1 ∧ θ = polePlus 0) ∨ (θ ∈ E.1 ∧ θ = poleMinus 0)
    exact ⟨fun hE => (sphere_zero_eq_one_of_poles θ).elim
      (fun hp => Or.inl ⟨hE, hp⟩) (fun hn => Or.inr ⟨hE, hn⟩),
      fun hE => hE.elim And.left And.left⟩
  have hdisj : Disjoint (E.inter P).1 (E.inter N).1 := by
    rw [Set.disjoint_left]
    rintro θ ⟨_, h₁⟩ ⟨_, h₂⟩
    exact hPN ((show θ = polePlus 0 from h₁).symm.trans h₂)
  have hone (θ : BarronSphere 0) (A : MeasSet (BarronSphere 0))
      (hA : A.1 = {θ}) (hz : eval A μ = 0) : eval (E.inter A) μ = 0 := by
    by_cases hE : θ ∈ E.1
    · have he : E.inter A = A := Subtype.ext (inter_eq_right.mpr (by simp [hA, hE]))
      rwa [he]
    · have he : E.inter A = MeasSet.empty := by
        apply Subtype.ext
        change E.1 ∩ A.1 = ∅
        rw [hA, Set.inter_singleton_of_notMem hE]
      rw [he, eval_empty]
  rw [hpart, eval_union_disjoint _ _ hdisj]
  simp [hone _ P rfl hp, hone _ N rfl hn]

theorem homogeneousProjection_kernel_all_dimensions (d : ℕ) (μ : FiniteSignedMeasure (BarronSphere d)) :
    homogeneousProjection d μ = 0 ↔ ∀ (x : Fin d → ℝ) (t : ℝ), homogeneousSynthesis μ x t = 0 := by
  cases d with
  | succ n => exact homogeneousProjection_kernel (Nat.succ_le_succ (Nat.zero_le n)) μ
  | zero =>
    refine ⟨fun h x t => ?_, fun h => ?_⟩
    · rw [← homogeneousSynthesis_projection, h]
      exact map_zero (signedIntegral (ridgeSymbol x t)).toLinearMap
    · rw [homogeneousSynthesis_zero_dim_injective μ h, map_zero]


theorem homogeneousProjection_idempotent_all_dimensions (d : ℕ)
    (μ : FiniteSignedMeasure (BarronSphere d)) :
    homogeneousProjection d (homogeneousProjection d μ) = homogeneousProjection d μ := by
  have h := (homogeneousProjection_kernel_all_dimensions d (homogeneousProjection d μ - μ)).mpr (fun x t => by
    let I := (signedIntegral (ridgeSymbol x t)).toLinearMap
    change I (homogeneousProjection d μ - μ) = 0
    rw [map_sub]
    change homogeneousSynthesis (homogeneousProjection d μ) x t - homogeneousSynthesis μ x t = 0
    rw [homogeneousSynthesis_projection, sub_self])
  rwa [map_sub, sub_eq_zero] at h

