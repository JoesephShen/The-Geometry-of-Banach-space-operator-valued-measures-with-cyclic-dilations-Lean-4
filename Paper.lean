/-- Continuous point evaluation on the Barron quotient. -/
def quotientPointEval (x : Fin d → ℝ) : BarronBanach d →L[ℝ] ℝ :=
  (synthesisLinear d).ker.liftQL (signedIntegral (ridgeSymbol x 1)) (fun μ hm => by
    change synthesis μ x = 0
    exact congrFun (LinearMap.mem_ker.mp hm) x)

theorem quotientPointEval_synthesis (μ : FiniteSignedMeasure (BarronSphere d)) (x : Fin d → ℝ) :
    quotientPointEval x (synthesisQuotient d μ) = synthesis μ x := rfl

theorem barronStage_pointEval (hd : 1 ≤ d) (ρ : BarronControl d)
    (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≠ ⊤) (x : Fin d → ℝ) :
    Continuous (fun z => quotientPointEval x ((barronStage hd ρ p hp).inclusion z)) :=
  (quotientPointEval x).continuous.comp (barronStage hd ρ p hp).inclusion.continuous

theorem barronStage_normalized (hd : 1 ≤ d) (ρ : BarronControl d)
    (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≠ ⊤) :
    (barronStage hd ρ p hp).localOVM.Normalized := by
  let Q := barronStage hd ρ p hp
  exact Q.multiplication.compressed_normalized Q.synthesis Q.analysis
    (Q.synthesis_analysis (synthesisQuotient_canonicalSection hd))

theorem barronStage_projection_bound (hd : 1 ≤ d) (ρ : BarronControl d)
    {k : ℝ≥0∞} (hkfin : k < ∞) (hk : Measure.map (reflection d) ρ.1 ≤ k • ρ.1)
    {m : ℝ} (hm : 0 < m)
    (hA : ∀ i : Fin d, m ≤ (ρ.1 {axis i}).toReal ∧ m ≤ (ρ.1 {axisMinus i}).toReal)
    (hP : m ≤ (ρ.1 {polePlus d}).toReal) (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≠ ⊤) :
    ‖(barronStage hd ρ p hp).localProjection‖ ≤ (1 + Real.sqrt (4 * (d : ℝ) + 1)) ^ (1 / p.toReal) *
      (((1 + k.toReal) / 2) + 1 / (2 * m)) ^ (1 - 1 / p.toReal) := by
  let Q := barronStage hd ρ p hp
  obtain ⟨R, hR, hnorm⟩ := exists_canonicalLp ρ.2 hkfin hk hm hA hP p hp
  have he : Q.localProjection = R := by
    apply ContinuousLinearMap.ext
    intro a
    apply densityMap_injective (p := p) (ρ := ρ.1)
    exact ((exists_localBarronProjection ρ p hp).choose_spec a).trans (hR a).symm
  change ‖Q.localProjection‖ ≤ _
  rw [he]
  exact hnorm

theorem barronStage_fixed_coefficient (hd : 1 ≤ d) (ρ : BarronControl d)
    (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≠ ⊤)
    (z : (barronStage hd ρ p hp).Quotient) :
    let Q := barronStage hd ρ p hp
    Q.localProjection (Q.analysis z) = Q.analysis z ∧
    (∀ a, Q.localProjection a = a → Q.synthesis a = z → a = Q.analysis z) ∧
    (‖z‖ ≤ ‖Q.analysis z‖ ∧ ‖Q.analysis z‖ ≤ ‖Q.localProjection‖ * ‖z‖) := by
  let Q := barronStage hd ρ p hp
  have hST := synthesisQuotient_canonicalSection hd
  refine ⟨?_, ?_, Q.norm_analysis hST z⟩
  · obtain ⟨a, rfl⟩ := Q.synthesis_surjective z
    rw [Q.analysis_synthesis, Q.localProjection_idem hST]
  · intro a ha hz
    rw [← hz, Q.analysis_synthesis, ha]

