section FiniteSignedMeasures

variable {Ω : Type*} [MeasurableSpace Ω]

local instance : TopologicalSpace (MeasSet Ω × MeasSet Ω) := ⊥
local instance : DiscreteTopology (MeasSet Ω × MeasSet Ω) := ⟨rfl⟩
local instance : Nonempty (MeasSet Ω × MeasSet Ω) := ⟨(MeasSet.empty, MeasSet.empty)⟩
open scoped BoundedContinuousFunction

private abbrev SignedMeasureAmbient (Ω : Type*) [MeasurableSpace Ω] :=
  (MeasSet Ω × MeasSet Ω) →ᵇ ℝ

private noncomputable def ScalarCharge.testFunction (ν : ScalarCharge Ω) :
    SignedMeasureAmbient Ω :=
  BoundedContinuousFunction.mkOfBound
    ⟨fun (E, F) => ν.val E - ν.val F, continuous_of_discreteTopology⟩
    (4 * Classical.choose ν.bounded) (by
      intro E F
      have h := Classical.choose_spec ν.bounded
      change dist (ν.val E.1 - ν.val E.2) (ν.val F.1 - ν.val F.2) ≤ _
      rw [dist_eq_norm]
      calc
        _ ≤ ‖ν.val E.1 - ν.val E.2‖ + ‖ν.val F.1 - ν.val F.2‖ := norm_sub_le _ _
        _ ≤ (‖ν.val E.1‖ + ‖ν.val E.2‖) + (‖ν.val F.1‖ + ‖ν.val F.2‖) :=
          add_le_add (norm_sub_le _ _) (norm_sub_le _ _)
        _ ≤ _ := by simp only [Real.norm_eq_abs]; linarith [h E.1, h E.2, h F.1, h F.2])

private theorem ScalarCharge.testFunction_apply (ν : ScalarCharge Ω) (E F : MeasSet Ω) :
    ν.testFunction (E, F) = ν.val E - ν.val F := rfl

/-- The variation norm is the supremum of the differences of two measurable
evaluations, or equivalently the sum of the two Jordan masses. -/
private theorem ScalarCharge.norm_testFunction (ν : ScalarCharge Ω) :
    ‖ν.testFunction‖ = ν.totalVariationMass := by
  apply le_antisymm
  · apply (BoundedContinuousFunction.norm_le (f := ν.testFunction)
      (add_nonneg (ν.upperVariation_nonneg _) (ν.neg.upperVariation_nonneg _))).mpr
    intro ⟨E, F⟩
    change |ν.val E - ν.val F| ≤ _
    apply abs_le.mpr
    have hp (A : MeasSet Ω) := ν.val_le_upperVariation (A := MeasSet.whole) (B := A)
      (subset_univ _)
    have hn (A : MeasSet Ω) : -ν.val A ≤ ν.neg.upperVariation MeasSet.whole :=
      ν.neg.val_le_upperVariation (B := A) (subset_univ _)
    constructor <;> linarith [hp E, hp F, hn E, hn F]
  · have hb (E F : MeasSet Ω) : ν.val E - ν.val F ≤ ‖ν.testFunction‖ :=
      (le_abs_self _).trans (ν.testFunction.norm_coe_le_norm (E, F))
    have hp (F : MeasSet Ω) : ν.upperVariation MeasSet.whole ≤ ‖ν.testFunction‖ + ν.val F :=
      ν.upperVariation_le _ _ fun E _ => by linarith [hb E F]
    have hn : ν.neg.upperVariation MeasSet.whole ≤
        ‖ν.testFunction‖ - ν.upperVariation MeasSet.whole := by
      apply ν.neg.upperVariation_le
      intro F _
      change -ν.val F ≤ _
      linarith [hp F]
    unfold ScalarCharge.totalVariationMass
    linarith

/-- Finite signed countably additive measures embedded into the complete
supremum norm space by λ ↦ ((E,F) ↦ λ(E) - λ(F)). -/
noncomputable def finiteSignedMeasureSubmodule (Ω : Type*) [MeasurableSpace Ω] :
    Submodule ℝ (SignedMeasureAmbient Ω) where
  carrier := {f | ∃ ν : ScalarCharge Ω, ν.CountablyAdditive ∧ ν.testFunction = f}
  zero_mem' := by
    let ν : ScalarCharge Ω :=
      ⟨fun _ => 0, rfl, fun _ _ _ => by simp, ⟨0, fun _ => by simp⟩⟩
    refine ⟨ν, fun E _ => hasSum_zero, ?_⟩
    ext ⟨E, F⟩
    change (0 : ℝ) - 0 = 0
    exact sub_zero _
  add_mem' := by
    rintro _ _ ⟨ν, hν, rfl⟩ ⟨μ, hμ, rfl⟩
    refine ⟨ν.add μ, ScalarCharge.add_countablyAdditive hν hμ, ?_⟩
    ext ⟨E, F⟩
    change (ν.val E + μ.val E) - (ν.val F + μ.val F) =
      (ν.val E - ν.val F) + (μ.val E - μ.val F)
    ring
  smul_mem' := by
    rintro a _ ⟨ν, hν, rfl⟩
    refine ⟨ν.scale a, ScalarCharge.scale_countablyAdditive hν a, ?_⟩
    ext ⟨E, F⟩
    change a * ν.val E - a * ν.val F = a * (ν.val E - ν.val F)
    ring

/-- The concrete normed model of the finite signed measures in §6. -/
noncomputable abbrev FiniteSignedMeasure (Ω : Type*) [MeasurableSpace Ω] := finiteSignedMeasureSubmodule Ω

namespace FiniteSignedMeasure

noncomputable def ofCharge (ν : ScalarCharge Ω) (hν : ν.CountablyAdditive) :
    FiniteSignedMeasure Ω :=
  ⟨ν.testFunction, ⟨ν, hν, rfl⟩⟩

noncomputable def eval (E : MeasSet Ω) : FiniteSignedMeasure Ω →L[ℝ] ℝ :=
  LinearMap.mkContinuous
    { toFun := fun (μ : FiniteSignedMeasure Ω) => μ.1 (E, MeasSet.empty)
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
    1 (fun μ => by
      change ‖μ.1 (E, MeasSet.empty)‖ ≤ 1 * ‖μ.1‖
      rw [one_mul]
      exact μ.1.norm_coe_le_norm (E, MeasSet.empty))

@[simp] theorem eval_ofCharge (ν : ScalarCharge Ω) (hν : ν.CountablyAdditive)
    (E : MeasSet Ω) : eval E (ofCharge ν hν) = ν.val E := by
  change ν.val E - ν.val MeasSet.empty = ν.val E
  rw [ν.empty_eq, sub_zero]

theorem norm_ofCharge (ν : ScalarCharge Ω) (hν : ν.CountablyAdditive) :
    ‖ofCharge ν hν‖ = ν.totalVariationMass :=
  ν.norm_testFunction

theorem exists_charge (μ : FiniteSignedMeasure Ω) :
    ∃ ν : ScalarCharge Ω, ∃ hν : ν.CountablyAdditive, ofCharge ν hν = μ := by
  obtain ⟨ν, hν, he⟩ := μ.property
  exact ⟨ν, hν, Subtype.ext he⟩

@[ext] theorem ext {ν μ : FiniteSignedMeasure Ω}
    (h : ∀ E, eval E ν = eval E μ) : ν = μ := by
  obtain ⟨r, hr, rfl⟩ := (exists_charge ν)
  obtain ⟨s, hs, rfl⟩ := (exists_charge μ)
  have he : r = s := ScalarCharge.ext_val (fun E => by simpa only [eval_ofCharge] using h E)
  subst s
  rfl

private theorem submodule_closed : IsClosed (finiteSignedMeasureSubmodule Ω : Set (SignedMeasureAmbient Ω)) := by
  apply isSeqClosed_iff_isClosed.mp
  intro g' g hmem ht
  choose ν hν hνg using hmem
  let g₀ (E : MeasSet Ω) := g (E, MeasSet.empty)
  have hlim (E F : MeasSet Ω) :
      Tendsto (fun n => (ν n).val E - (ν n).val F) atTop (𝓝 (g (E,F))) := by
    let ev : SignedMeasureAmbient Ω →L[ℝ] ℝ := BoundedContinuousFunction.evalCLM ℝ (E,F)
    have hc := (ev.continuous.tendsto g).comp ht
    change Tendsto (fun n => g' n (E,F)) atTop (𝓝 (g (E,F))) at hc
    simpa only [← hνg, ScalarCharge.testFunction_apply] using hc
  have he (E : MeasSet Ω) :
      Tendsto (fun n => (ν n).val E) atTop (𝓝 (g₀ E)) := by
    have hz (n : ℕ) : (ν n).val E - (ν n).val MeasSet.empty = (ν n).val E := by
      rw [(ν n).empty_eq, sub_zero]
    simpa only [hz] using hlim E MeasSet.empty
  have hca :=
    citeVitaliHahnSaks1977 (ScalarCharge.sequenceControl ν) ν hν
      (ScalarCharge.variationMeasure_absolutelyContinuous_sequenceControl ν) g₀ he
  let μ : ScalarCharge Ω :=
    { val := g₀
      empty_eq := by
        apply tendsto_nhds_unique (he MeasSet.empty)
        simpa only [(ν _).empty_eq] using
          (tendsto_const_nhds (x := (0 : ℝ)) : Tendsto (fun _ : ℕ => (0 : ℝ)) atTop (𝓝 0))
      add_union := fun E F hEF => by
        refine tendsto_nhds_unique (he (E.union F)) ?_
        have h0 (n : ℕ) := (ν n).add_union E F hEF
        simpa only [h0] using (he E).add (he F)
      bounded := ⟨‖g‖, fun E => g.norm_coe_le_norm (E, MeasSet.empty)⟩ }
  refine ⟨μ, hca, ?_⟩
  apply BoundedContinuousFunction.ext
  rintro ⟨E, F⟩
  change g₀ E - g₀ F = g (E,F)
  exact tendsto_nhds_unique ((he E).sub (he F)) (hlim E F)

instance completeSpace : CompleteSpace (FiniteSignedMeasure Ω) :=
  submodule_closed.completeSpace_coe

end FiniteSignedMeasure

#print axioms FiniteSignedMeasure.norm_ofCharge
#print axioms FiniteSignedMeasure.completeSpace

end FiniteSignedMeasures



section SignedMeasureRestriction

variable {Ω : Type*} [MeasurableSpace Ω]

namespace ScalarCharge

theorem upperVariation_restrict (ν : ScalarCharge Ω) (A E : MeasSet Ω) :
    (ν.restrict E).upperVariation A = ν.upperVariation (A.inter E) := by
  apply le_antisymm
  · apply upperVariation_le
    intro B hB
    exact ν.val_le_upperVariation (inter_subset_inter_left _ hB)
  · apply upperVariation_le
    intro B hB
    have hBE : B.inter E = B := Subtype.ext (inter_eq_left.mpr (hB.trans inter_subset_right))
    simpa only [ScalarCharge.restrict, hBE] using
      (ν.restrict E).val_le_upperVariation (hB.trans inter_subset_left)

theorem totalVariationMass_restrict (ν : ScalarCharge Ω) (E : MeasSet Ω) :
    (ν.restrict E).totalVariationMass = ν.upperVariation E + ν.neg.upperVariation E := by
  have hn : (ν.restrict E).neg = ν.neg.restrict E := ScalarCharge.ext_val (fun _ => rfl)
  have he : (MeasSet.whole : MeasSet Ω).inter E = E := Subtype.ext (univ_inter _)
  rw [totalVariationMass, hn, upperVariation_restrict, upperVariation_restrict, he]

theorem totalVariationMass_of_positive (ν : ScalarCharge Ω) (hν : ν.Positive) :
    ν.totalVariationMass = ν.val MeasSet.whole := by
  have hp : ν.upperVariation MeasSet.whole = ν.val MeasSet.whole :=
    le_antisymm (ν.upperVariation_le _ _ (fun E _ => ν.val_mono hν (subset_univ E.1)))
      (ν.val_le_upperVariation Subset.rfl)
  have hn : ν.neg.upperVariation MeasSet.whole = 0 :=
    le_antisymm (ν.neg.upperVariation_le _ _ (fun E _ => neg_nonpos.mpr (hν E)))
      (ν.neg.upperVariation_nonneg _)
  rw [totalVariationMass, hp, hn, add_zero]

end ScalarCharge

namespace FiniteSignedMeasure

variable (E : MeasSet Ω)

private noncomputable def cutFun (E : MeasSet Ω) (μ : FiniteSignedMeasure Ω) : FiniteSignedMeasure Ω :=
  let ν := Classical.choose (exists_charge μ)
  let hν := Classical.choose (Classical.choose_spec (exists_charge μ))
  ofCharge (ν.restrict E) (ScalarCharge.restrict_countablyAdditive hν E)

private theorem eval_cutFun (μ : FiniteSignedMeasure Ω) (F : MeasSet Ω) :
    eval F (cutFun E μ) = eval (F.inter E) μ := by
  conv_rhs => rw [← Classical.choose_spec (Classical.choose_spec (exists_charge μ))]
  simp only [cutFun, eval_ofCharge]
  rfl

private theorem norm_cutFun_ofCharge (ν : ScalarCharge Ω) (hν : ν.CountablyAdditive) :
    ‖cutFun E (ofCharge ν hν)‖ = ν.upperVariation E + ν.neg.upperVariation E := by
  have h : cutFun E (ofCharge ν hν) =
      ofCharge (ν.restrict E) (ScalarCharge.restrict_countablyAdditive hν E) := by
    apply FiniteSignedMeasure.ext
    intro F
    rw [eval_cutFun, eval_ofCharge, eval_ofCharge]
    rfl
  rw [h, norm_ofCharge, ν.totalVariationMass_restrict]

/-- Restriction of a signed measure is a contraction for total variation. -/
noncomputable def cut (E : MeasSet Ω) : FiniteSignedMeasure Ω →L[ℝ] FiniteSignedMeasure Ω :=
  LinearMap.mkContinuous
    { toFun := cutFun E
      map_add' := by
        intro a b
        apply FiniteSignedMeasure.ext
        intro F
        rw [eval_cutFun, map_add, map_add, eval_cutFun, eval_cutFun]
      map_smul' := by
        intro c a
        apply FiniteSignedMeasure.ext
        intro F
        simp only [eval_cutFun, map_smul]
        rfl }
    1 (fun μ => by
      obtain ⟨ν, hν, rfl⟩ := (exists_charge μ)
      change ‖cutFun E (ofCharge ν hν)‖ ≤ 1 * ‖ofCharge ν hν‖
      rw [one_mul, norm_cutFun_ofCharge, norm_ofCharge, ScalarCharge.totalVariationMass]
      exact add_le_add (ν.positivePart.val_mono ν.positivePart_positive (subset_univ E.1))
        (ν.neg.positivePart.val_mono ν.neg.positivePart_positive (subset_univ E.1)))

@[simp] theorem eval_cut (μ : FiniteSignedMeasure Ω) (F : MeasSet Ω) :
    eval F (cut E μ) = eval (F.inter E) μ :=
  eval_cutFun E μ F

theorem norm_cut_ofCharge (ν : ScalarCharge Ω) (hν : ν.CountablyAdditive) :
    ‖cut E (ofCharge ν hν)‖ = ν.upperVariation E + ν.neg.upperVariation E :=
  norm_cutFun_ofCharge E ν hν

noncomputable def restrictionPVM (Ω : Type*) [MeasurableSpace Ω] :
    PVM Ω (FiniteSignedMeasure Ω) where
  val := cut
  empty_eq := by
    ext μ F
    change eval F (cut MeasSet.empty μ) = eval F 0
    rw [eval_cut, map_zero, show F.inter MeasSet.empty = MeasSet.empty from
      Subtype.ext (inter_empty _)]
    obtain ⟨ν, hν, rfl⟩ := (exists_charge μ)
    rw [eval_ofCharge, ν.empty_eq]
  normalized := by
    ext μ F
    rw [ContinuousLinearMap.id_apply, eval_cut, show F.inter MeasSet.whole = F from Subtype.ext (inter_univ _)]
  mul_eq A B := by
    ext μ F
    simp only [ContinuousLinearMap.comp_apply, eval_cut]
    rw [show (F.inter A).inter B = F.inter (A.inter B) from Subtype.ext (inter_assoc _ _ _)]
  countably_additive := by
    intro D hD μ
    obtain ⟨ν, hν, rfl⟩ := (exists_charge μ)
    have hsz : Summable fun n => ‖cut (D n) (ofCharge ν hν)‖ := by
      simp_rw [norm_cut_ofCharge]
      exact ((ν.positivePart_countablyAdditive hν) D hD).summable.add
        ((ν.neg.positivePart_countablyAdditive (ν.neg_countablyAdditive hν)) D hD).summable
    have hs := (Summable.of_norm hsz).hasSum
    have he : (∑' n, cut (D n) (ofCharge ν hν)) = cut (MeasSet.iUnion D) (ofCharge ν hν) := by
      apply FiniteSignedMeasure.ext
      intro F
      have h := (eval F).hasSum hs
      simp_rw [eval_cut, eval_ofCharge] at h ⊢
      let G (n : ℕ) := F.inter (D n)
      have hG : MeasSet.DisjointSeq G := fun i j hij =>
        (hD hij).mono inter_subset_right inter_subset_right
      have hU : MeasSet.iUnion G = F.inter (MeasSet.iUnion D) :=
        Subtype.ext (Set.inter_iUnion _ _).symm
      exact h.unique (hU ▸ hν G hG) 
    exact he ▸ hs

/-- The positive cone and the total mass of the signed measure model. -/
def Positive (μ : FiniteSignedMeasure Ω) : Prop :=
  ∀ E, 0 ≤ eval E μ

theorem positive_closed (Ω : Type*) [MeasurableSpace Ω] :
    IsClosed {μ : FiniteSignedMeasure Ω | Positive μ} := by
  have he : {μ : FiniteSignedMeasure Ω | Positive μ} =
      ⋂ E : MeasSet Ω, {μ | 0 ≤ eval E μ} := by
    ext μ
    simp [Positive]
  rw [he]
  exact isClosed_iInter fun E => isClosed_le continuous_const (eval E).continuous

theorem mass_eq_norm_of_positive {μ : FiniteSignedMeasure Ω} (hμ : Positive μ) :
    eval MeasSet.whole μ = ‖μ‖ := by
  obtain ⟨ν, hν, rfl⟩ := (exists_charge μ)
  have hνp : ν.Positive := fun E => by simpa only [eval_ofCharge] using hμ E
  rw [norm_ofCharge, ν.totalVariationMass_of_positive hνp, eval_ofCharge]

theorem norm_mono_of_positive {x y : FiniteSignedMeasure Ω} (hx : Positive x)
    (hd : Positive (y - x)) : ‖x‖ ≤ ‖y‖ := by
  have hxy (E : MeasSet Ω) : eval E x ≤ eval E y := by
    have hh : 0 ≤ eval E (y - x) := hd E
    exact sub_nonneg.mp ((map_sub (eval E) y x) ▸ hh)
  have hy : Positive y := fun E => (hx E).trans (hxy E)
  rw [← mass_eq_norm_of_positive hx, ← mass_eq_norm_of_positive hy]
  exact hxy _

/-- The class of probabilities constructed using the original majorant V
is cofinal and countably directed, on the concrete total variation space. -/
theorem resolvent_family (V : FiniteSignedMeasure Ω →L[ℝ] FiniteSignedMeasure Ω)
    (hV : ∀ ⦃ν⦄, Positive ν → Positive (V ν)) :
    (∀ η : FiniteSignedMeasure Ω, Positive η → eval MeasSet.whole η = 1 →
      ∃ ρ ∈ resolventProbabilities {ν | Positive ν} V, ∃ k : ℝ, 1 ≤ k ∧
        Positive (k • ρ - η)) ∧
    (∀ η : ℕ → FiniteSignedMeasure Ω, (∀ n, Positive (η n)) →
      (∀ n, eval MeasSet.whole (η n) = 1) →
      ∃ ρ ∈ resolventProbabilities {ν | Positive ν} V, ∃ k : ℝ, 1 ≤ k ∧
        ∀ n, Positive ((2^(n+1) * k : ℝ) • ρ - η n)) := by
  obtain ⟨hcofinal, hdir⟩ := resolventProbabilities_cofinal_countablyDirected
    {ν : FiniteSignedMeasure Ω | Positive ν} (positive_closed Ω)
    (by intro x y hx hy E; rw [map_add]; exact add_nonneg (hx E) (hy E))
    (by intro a x ha hx E; rw [map_smul, smul_eq_mul]; exact mul_nonneg ha (hx E))
    (by intro x y hx hy; exact norm_mono_of_positive hx hy)
    (eval MeasSet.whole) (fun _ h => mass_eq_norm_of_positive h) V (by intro x h; exact hV h)
  refine ⟨fun η hη hm => hcofinal η hη ((mass_eq_norm_of_positive hη).symm.trans hm), ?_⟩
  exact fun η hs hm => hdir η hs (fun n => (mass_eq_norm_of_positive (hs n)).symm.trans (hm n))

end FiniteSignedMeasure

#print axioms ScalarCharge.totalVariationMass_restrict
#print axioms FiniteSignedMeasure.restrictionPVM
#print axioms FiniteSignedMeasure.resolvent_family

end SignedMeasureRestriction




section SignedMeasureProbabilities

variable {Ω : Type*} [MeasurableSpace Ω]

namespace FiniteSignedMeasure

private theorem eval_empty (μ : FiniteSignedMeasure Ω) :
    eval MeasSet.empty μ = 0 := by
  obtain ⟨ν, hν, rfl⟩ := (exists_charge μ)
  rw [eval_ofCharge, ν.empty_eq]

/-- On the empty measurable space, a probability index does not exist. -/
theorem no_probability_of_isEmpty [IsEmpty Ω] :
    ∀ μ : FiniteSignedMeasure Ω, eval MeasSet.whole μ ≠ 1 := by
  intro μ
  rw [show (MeasSet.whole : MeasSet Ω) = MeasSet.empty from Subtype.ext (Set.univ_eq_empty_iff.mpr inferInstance),
    eval_empty]
  exact zero_ne_one

/-- A Dirac probability supplies an index on any nonempty measurable space. -/
theorem exists_probability [Nonempty Ω] :
    ∃ μ : FiniteSignedMeasure Ω, Positive μ ∧ eval MeasSet.whole μ = 1 := by
  obtain ⟨ω⟩ := (inferInstance : Nonempty Ω)
  let P := pointPVM ℝ ω
  let h := ContinuousLinearMap.id ℝ ℝ
  let ν := P.toOVM.orbitCharge (1 : ℝ) h
  have hs : ν.CountablyAdditive := fun E hd =>
    P.toOVM.normal_J (1 : ℝ) E hd h
  refine ⟨ofCharge ν hs, fun E => ?_, ?_⟩
  · rw [eval_ofCharge]
    change 0 ≤ pointOperator ℝ ω E 1
    by_cases he : ω ∈ E.1 <;> simp [pointOperator, he]
  · rw [eval_ofCharge]
    change pointOperator ℝ ω MeasSet.whole 1 = 1
    simp [pointOperator, MeasSet.whole]

/-- The positive measure given by the two Jordan parts. -/
noncomputable def modulus (μ : FiniteSignedMeasure Ω) : FiniteSignedMeasure Ω :=
  let ν := Classical.choose (exists_charge μ)
  let hν := Classical.choose (Classical.choose_spec (exists_charge μ))
  ofCharge (ν.positivePart.add ν.neg.positivePart)
    (ScalarCharge.add_countablyAdditive (ν.positivePart_countablyAdditive hν)
      (ν.neg.positivePart_countablyAdditive (ν.neg_countablyAdditive hν)))

private theorem modulus_ofCharge (ν : ScalarCharge Ω) (hν : ν.CountablyAdditive) :
    modulus (ofCharge ν hν) =
      ofCharge (ν.positivePart.add ν.neg.positivePart)
        (ScalarCharge.add_countablyAdditive (ν.positivePart_countablyAdditive hν)
          (ν.neg.positivePart_countablyAdditive (ν.neg_countablyAdditive hν))) := by
  let μ := ofCharge ν hν
  let q := Classical.choose (exists_charge μ)
  let hq := Classical.choose (Classical.choose_spec (exists_charge μ))
  have he : ofCharge q hq = ofCharge ν hν :=
    Classical.choose_spec (Classical.choose_spec (exists_charge μ))
  have hqν : q = ν := by
    apply ScalarCharge.ext_val
    intro E
    simpa only [eval_ofCharge] using congrArg (eval E) he
  have hproof (a : ScalarCharge Ω) (ha : a.CountablyAdditive) (h : a = ν) :
      ofCharge (a.positivePart.add a.neg.positivePart)
        (ScalarCharge.add_countablyAdditive (a.positivePart_countablyAdditive ha)
          (a.neg.positivePart_countablyAdditive (a.neg_countablyAdditive ha))) =
      ofCharge (ν.positivePart.add ν.neg.positivePart)
        (ScalarCharge.add_countablyAdditive (ν.positivePart_countablyAdditive hν)
          (ν.neg.positivePart_countablyAdditive (ν.neg_countablyAdditive hν))) := by
    subst a
    rfl
  exact hproof q hq hqν

theorem modulus_positive (μ : FiniteSignedMeasure Ω) : Positive (modulus μ) := by
  obtain ⟨ν, hν, rfl⟩ := (exists_charge μ)
  intro E
  rw [modulus_ofCharge, eval_ofCharge]
  exact add_nonneg (ν.positivePart_positive E) (ν.neg.positivePart_positive E)

@[simp] theorem norm_modulus (μ : FiniteSignedMeasure Ω) : ‖(modulus μ)‖ = ‖μ‖ := by
  have hm := mass_eq_norm_of_positive (modulus_positive μ)
  obtain ⟨ν, hν, rfl⟩ := (exists_charge μ)
  rw [← hm, modulus_ofCharge, eval_ofCharge, norm_ofCharge]
  rfl

/-- The probability used in norm and topology recovery is the normalized
variation of a nonzero representing measure. -/
theorem normalized_modulus (μ : FiniteSignedMeasure Ω) (hμ : μ ≠ 0) :
    Positive (‖μ‖⁻¹ • modulus μ) ∧ ‖‖μ‖⁻¹ • (modulus μ)‖ = 1 := by
  refine ⟨fun E => ?_, ?_⟩
  · rw [map_smul, smul_eq_mul]
    exact mul_nonneg (inv_nonneg.mpr (norm_nonneg μ)) ((modulus_positive μ) E)
  · change ‖(‖μ‖⁻¹ : ℝ) • (modulus μ).1‖ = 1
    rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr (norm_nonneg μ))]
    change ‖μ‖⁻¹ * ‖modulus μ‖ = 1
    rw [norm_modulus]
    exact inv_mul_cancel₀ (norm_ne_zero_iff.mpr (show μ.1 ≠ 0 from fun h => hμ (Subtype.ext h)))

end FiniteSignedMeasure

#print axioms FiniteSignedMeasure.no_probability_of_isEmpty
#print axioms FiniteSignedMeasure.exists_probability
#print axioms FiniteSignedMeasure.normalized_modulus

end SignedMeasureProbabilities




section SignedMeasureDensities

open MeasureTheory
variable {Ω : Type*} [MeasurableSpace Ω]

local instance : TopologicalSpace (MeasSet Ω × MeasSet Ω) := ⊥

namespace FiniteSignedMeasure

variable {ρ : Measure Ω} {f g : Ω → ℝ}

private noncomputable def densityCharge (hf : Integrable f ρ) : ScalarCharge Ω where
  val E := ∫ x in E.1, f x ∂ρ
  empty_eq := by simp [MeasSet.empty]
  add_union E F h := setIntegral_union h F.2 hf.integrableOn hf.integrableOn
  bounded := by
    refine ⟨∫ x, ‖f x‖ ∂ρ, fun E => ?_⟩
    rw [← Real.norm_eq_abs]
    exact (norm_integral_le_integral_norm f).trans
      (setIntegral_le_integral hf.norm (Eventually.of_forall fun x => norm_nonneg (f x)))

/-- The finite signed measure (f\rho) defined by an integrable density. -/
noncomputable def ofDensity (hf : Integrable f ρ) : FiniteSignedMeasure Ω :=
  ofCharge (densityCharge hf) (fun D hD =>
    hasSum_integral_iUnion (fun n => (D n).2) hD hf.integrableOn)

@[simp] theorem eval_ofDensity (hf : Integrable f ρ) (E : MeasSet Ω) :
    eval E (ofDensity hf) = ∫ x in E.1, f x ∂ρ := by
  exact eval_ofCharge (densityCharge hf) (fun D hD =>
    hasSum_integral_iUnion (fun n => (D n).2) hD hf.integrableOn) E

theorem ofDensity_congr (hf : Integrable f ρ) (hg : Integrable g ρ) (h : f =ᵐ[ρ] g) :
    ofDensity hf = ofDensity hg := by
  apply FiniteSignedMeasure.ext
  intro E
  rw [eval_ofDensity, eval_ofDensity]
  exact integral_congr_ae (ae_restrict_le h)

theorem cut_ofDensity (hf : Integrable f ρ) (E : MeasSet Ω) :
    cut E (ofDensity hf) = ofDensity (hf.indicator E.2) := by
  apply FiniteSignedMeasure.ext
  intro F
  rw [eval_cut, eval_ofDensity, eval_ofDensity, setIntegral_indicator E.2]
  rfl

/-- Total variation of a density measure is exactly the L¹ norm. -/
theorem norm_ofDensity (hf : Integrable f ρ) :
    ‖ofDensity hf‖ = ∫ x, ‖f x‖ ∂ρ := by
  let g := hf.aestronglyMeasurable.mk f
  have hfg : f =ᵐ[ρ] g := hf.aestronglyMeasurable.ae_eq_mk
  have hg : Integrable g ρ := hf.congr hfg
  have hgm : Measurable g := hf.aestronglyMeasurable.stronglyMeasurable_mk.measurable
  have hnorm : (fun x => ‖f x‖) =ᵐ[ρ] (fun x => ‖g x‖) :=
    hfg.mono (fun _ h => congrArg norm h)
  rw [ofDensity_congr hf hg hfg, integral_congr_ae hnorm]
  let E : MeasSet Ω := ⟨{x | 0 ≤ g x}, measurableSet_le measurable_const hgm⟩
  let F : MeasSet Ω := ⟨E.1ᶜ, E.2.compl⟩
  let ν := densityCharge hg
  change ‖ν.testFunction‖ = _
  apply le_antisymm
  · apply (BoundedContinuousFunction.norm_le (f := ν.testFunction)
      (integral_nonneg fun x => norm_nonneg (g x))).mpr
    intro ⟨A, B⟩
    change ‖(∫ x in A.1, g x ∂ρ) - ∫ x in B.1, g x ∂ρ‖ ≤ _
    rw [← integral_indicator A.2, ← integral_indicator B.2,
      ← integral_sub (hg.indicator A.2) (hg.indicator B.2)]
    refine (norm_integral_le_integral_norm _).trans
      (integral_mono_ae ((hg.indicator A.2).sub (hg.indicator B.2)).norm hg.norm
        (Eventually.of_forall fun x => ?_))
    by_cases ha : x ∈ A.1 <;> by_cases hb : x ∈ B.1 <;>
      simp [Set.indicator, ha, hb]
  · have hE : (∫ x in E.1, g x ∂ρ) = ∫ x in E.1, ‖g x‖ ∂ρ :=
      setIntegral_congr_fun E.2 fun x hx => (Real.norm_of_nonneg hx).symm
    have hF : -(∫ x in F.1, g x ∂ρ) = ∫ x in F.1, ‖g x‖ ∂ρ := by
      rw [← integral_neg]
      apply setIntegral_congr_fun F.2
      intro x hx
      exact (Real.norm_of_nonpos (le_of_not_ge hx)).symm
    have he : ν.testFunction (E,F) = ∫ x, ‖g x‖ ∂ρ := by
      change (∫ x in E.1, g x ∂ρ) - (∫ x in F.1, g x ∂ρ) = _
      rw [sub_eq_add_neg, hE, hF]
      exact integral_add_compl E.2 hg.norm
    have h := ν.testFunction.norm_coe_le_norm (E,F)
    rwa [he, Real.norm_of_nonneg (integral_nonneg fun x => norm_nonneg (g x))] at h

/-- Scalar Radon–Nikodym, stated on the concrete finite signed measure
model used by the restriction PVM. -/
theorem exists_density (μ : FiniteSignedMeasure Ω) (ρ : Measure Ω) [IsFiniteMeasure ρ]
    (hAC : ∀ E : MeasSet Ω, ρ E.1 = 0 → eval E μ = 0) :
    ∃ f : Ω → ℝ, Measurable f ∧ ∃ hf : Integrable f ρ, ofDensity hf = μ := by
  obtain ⟨ν, hν, rfl⟩ := exists_charge μ
  obtain ⟨f, hm, hf, hval⟩ := ν.exists_rnDensity hν ρ (by simpa only [eval_ofCharge] using hAC)
  refine ⟨f, hm, hf, ?_⟩
  apply FiniteSignedMeasure.ext
  intro E
  simpa only [eval_ofDensity, eval_ofCharge] using (hval E).symm

end FiniteSignedMeasure

#print axioms FiniteSignedMeasure.cut_ofDensity
#print axioms FiniteSignedMeasure.norm_ofDensity
#print axioms FiniteSignedMeasure.exists_density

end SignedMeasureDensities




section SignedLpDensities

open MeasureTheory
open scoped ENNReal

variable {Ω : Type*} [MeasurableSpace Ω]

local instance : TopologicalSpace (MeasSet Ω × MeasSet Ω) := ⊥

namespace FiniteSignedMeasure

variable {p : ℝ≥0∞} [Fact (1 ≤ p)] {ρ : Measure Ω} [IsProbabilityMeasure ρ]

private theorem integrable_Lp (a : Lp ℝ p ρ) : Integrable a ρ :=
  memLp_one_iff_integrable.mp ((Lp.memLp a).mono_exponent (Fact.out : 1 ≤ p))

/-- The map (a\mapsto a\rho) is a contraction from (L_p(\rho))
to the finite signed measures, for a probability measure (\rho). -/
noncomputable def densityMap : Lp ℝ p ρ →L[ℝ] FiniteSignedMeasure Ω :=
  LinearMap.mkContinuous
    { toFun := fun a => ofDensity (integrable_Lp a)
      map_add' := by
        intro a b
        apply FiniteSignedMeasure.ext
        intro E
        rw [map_add, eval_ofDensity, eval_ofDensity, eval_ofDensity]
        rw [integral_congr_ae (ae_restrict_le (Lp.coeFn_add a b))]
        exact integral_add (integrable_Lp a).restrict (integrable_Lp b).restrict
      map_smul' := by
        intro c a
        apply FiniteSignedMeasure.ext
        intro E
        rw [map_smul, eval_ofDensity, eval_ofDensity]
        rw [integral_congr_ae (ae_restrict_le (Lp.coeFn_smul c a))]
        exact integral_smul c (fun x => a x) }
    1 (fun a => by
      change ‖ofDensity (integrable_Lp a)‖ ≤ 1 * ‖a‖
      rw [one_mul, norm_ofDensity, Lp.norm_def]
      have hf := integrable_Lp a
      have he : (eLpNorm a 1 ρ).toReal = ∫ x, ‖a x‖ ∂ρ := by
        rw [eLpNorm_one_eq_lintegral_eNorm hf.aestronglyMeasurable,
          ← ofReal_integral_norm_eq_lintegral_eNorm hf,
          ENNReal.toReal_ofReal (integral_nonneg fun _ => norm_nonneg _)]
      rw [← he]
      exact ENNReal.toReal_mono (Lp.memLp a).eLpNorm_ne_top
        (eLpNorm_le_eLpNorm_of_exponent_le (Fact.out : 1 ≤ p)))

theorem eval_densityMap (a : Lp ℝ p ρ) (E : MeasSet Ω) :
    eval E (densityMap a) = ∫ x in E.1, a x ∂ρ :=
  eval_ofDensity (integrable_Lp a) E

theorem densityMap_injective :
    Function.Injective (densityMap (p := p) (ρ := ρ)) := by
  intro a b hab
  have h : densityMap (a - b) = 0 := by rw [map_sub, hab, sub_self]
  let c : Lp ℝ p ρ := a - b
  have hc : (∫ x, ‖c x‖ ∂ρ) = 0 := by
    rw [← norm_ofDensity (integrable_Lp c)]
    change ‖densityMap c‖ = 0
    have hc0 : (densityMap c : FiniteSignedMeasure Ω) = 0 := h
    have h0 : ‖(0 : SignedMeasureAmbient Ω)‖ = 0 := norm_zero
    exact (congrArg (fun z : FiniteSignedMeasure Ω => ‖z.1‖) hc0).trans h0
  have he : eLpNorm c 1 ρ = 0 := by
    have hi := integrable_Lp c
    rw [eLpNorm_one_eq_lintegral_eNorm hi.aestronglyMeasurable,
      ← ofReal_integral_norm_eq_lintegral_eNorm hi, hc, ENNReal.ofReal_zero]
  have ha := (eLpNorm_eq_zero_iff (p := 1) one_ne_zero).mp he
  exact sub_eq_zero.mp (Lp.ext (ha.trans (Lp.coeFn_zero (μ := ρ) (p := p) (E := ℝ)).symm))

end FiniteSignedMeasure

#print axioms FiniteSignedMeasure.eval_densityMap
#print axioms FiniteSignedMeasure.densityMap_injective

end SignedLpDensities



section SignedProbabilityMeasures

open MeasureTheory
open scoped ENNReal
variable {Ω : Type*} [MeasurableSpace Ω]

namespace FiniteSignedMeasure

/-- The variation measure of a measurable restriction. -/
theorem eval_modulus_eq_norm_cut (μ : FiniteSignedMeasure Ω) (E : MeasSet Ω) :
    eval E (modulus μ) = ‖cut E μ‖ := by
  obtain ⟨ν, hν, rfl⟩ := exists_charge μ
  rw [modulus_ofCharge, eval_ofCharge, norm_cut_ofCharge]
  rfl

/-- The positive measure underlying a positive finite signed measure. -/
noncomputable def toMeasure (μ : FiniteSignedMeasure Ω) (hμ : Positive μ) : Measure Ω :=
  let ν := Classical.choose (exists_charge μ)
  let hν := Classical.choose (Classical.choose_spec (exists_charge μ))
  let he := Classical.choose_spec (Classical.choose_spec (exists_charge μ))
  ν.toMeasure (fun E => by
    have h := hμ E
    change 0 ≤ eval E μ at h
    rw [← he, eval_ofCharge] at h
    exact h)

theorem toMeasure_apply (μ : FiniteSignedMeasure Ω) (hμ : Positive μ) (E : MeasSet Ω) :
    toMeasure μ hμ E.1 = ENNReal.ofReal (eval E μ) := by
  let ν := Classical.choose (exists_charge μ)
  let hν := Classical.choose (Classical.choose_spec (exists_charge μ))
  have he : ofCharge ν hν = μ :=
    Classical.choose_spec (Classical.choose_spec (exists_charge μ))
  let hνp : ν.Positive := fun F => by
    have h := hμ F
    change 0 ≤ eval F μ at h
    rwa [← he, eval_ofCharge] at h
  change ν.toMeasure hνp E.1 = _
  rw [ν.toMeasure_apply_charge hνp hν, ← he, eval_ofCharge]

instance toMeasure_isFiniteMeasure (μ : FiniteSignedMeasure Ω) (hμ : Positive μ) :
    IsFiniteMeasure (toMeasure μ hμ) := by
  constructor
  change toMeasure μ hμ MeasSet.whole.1 < ∞
  rw [toMeasure_apply]
  exact ENNReal.ofReal_lt_top

/-- The positive unit vectors used by the resolvent give probability measures
on the original measurable space. -/
theorem toMeasure_isProbability (μ : FiniteSignedMeasure Ω) (hμ : Positive μ)
    (hn : ‖μ‖ = 1) : IsProbabilityMeasure (toMeasure μ hμ) := by
  constructor
  change toMeasure μ hμ MeasSet.whole.1 = 1
  rw [toMeasure_apply, mass_eq_norm_of_positive hμ, hn, ENNReal.ofReal_one]

theorem eval_modulus_ofDensity {ρ : Measure Ω} {f : Ω → ℝ}
    (hf : Integrable f ρ) (E : MeasSet Ω) :
    eval E (modulus (ofDensity hf)) = ∫ x in E.1, ‖f x‖ ∂ρ := by
  rw [eval_modulus_eq_norm_cut, cut_ofDensity, norm_ofDensity]
  have he : (fun x => ‖E.1.indicator f x‖) = E.1.indicator (fun x => ‖f x‖) := by
    funext x
    by_cases hx : x ∈ E.1 <;> simp [Set.indicator, hx]
  rw [he, integral_indicator E.2]

end FiniteSignedMeasure

#print axioms FiniteSignedMeasure.toMeasure_isProbability
#print axioms FiniteSignedMeasure.eval_modulus_ofDensity

end SignedProbabilityMeasures




section PositiveMeasureMajorant

/-- The order assumptions characterizing a real AL-space, expressed in
terms of its cone and its positive part. The lattice operations for arbitrary
pairs are obtained by translation from the positive part. -/
structure ALPositivePart (E : Type*) [NormedAddCommGroup E] [NormedSpace ℝ E] where
  cone : Set E
  positivePart : E → E
  zero_mem : (0 : E) ∈ cone
  add_mem : ∀ ⦃x y⦄, x ∈ cone → y ∈ cone → x + y ∈ cone
  smul_mem : ∀ ⦃a : ℝ⦄ ⦃x⦄, 0 ≤ a → x ∈ cone → a • x ∈ cone
  pointed : ∀ x, x ∈ cone → -x ∈ cone → x = 0
  positivePart_mem : ∀ x, positivePart x ∈ cone
  le_positivePart : ∀ x, positivePart x - x ∈ cone
  positivePart_le : ∀ x y, y ∈ cone → y - x ∈ cone → y - positivePart x ∈ cone
  norm_absolute : ∀ x, ‖(2 : ℝ) • positivePart x - x‖ = ‖x‖
  norm_mono : ∀ ⦃x y⦄, x ∈ cone → y - x ∈ cone → ‖x‖ ≤ ‖y‖
  norm_add_positive : ∀ ⦃x y⦄, x ∈ cone → y ∈ cone → ‖x + y‖ = ‖x‖ + ‖y‖

/-- Dales–Laustsen–Oikhberg–Troitsky (2017), p. 82, Proposition 4.16
and the following AL-space case. Take the modulus of the operator and
use equality of the regular and operator norms. -/
axiom citeDalesLaustsenOikhbergTroitsky2017_AL
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    (L : ALPositivePart E) (R : E →L[ℝ] E) :
    ∃ V : E →L[ℝ] E, (∀ x ∈ L.cone, V x ∈ L.cone) ∧ ‖V‖ = ‖R‖ ∧
      ∀ x, V ((2 : ℝ) • L.positivePart x - x) -
        ((2 : ℝ) • L.positivePart (R x) - R x) ∈ L.cone

private noncomputable def measureOperatorNorm {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E] (R : E →L[ℝ] E) : ℝ :=
  ‖R‖

namespace FiniteSignedMeasure

variable {Ω : Type*} [MeasurableSpace Ω]

local instance : TopologicalSpace (MeasSet Ω × MeasSet Ω) := ⊥
local instance : Nonempty (MeasSet Ω × MeasSet Ω) := ⟨(MeasSet.empty, MeasSet.empty)⟩


private noncomputable def liftOnCharge (μ : FiniteSignedMeasure Ω)
    (f : (ν : ScalarCharge Ω) → ν.CountablyAdditive → FiniteSignedMeasure Ω) :
    FiniteSignedMeasure Ω :=
  f (Classical.choose (exists_charge μ))
    (Classical.choose (Classical.choose_spec (exists_charge μ)))

private theorem liftOnCharge_ofCharge
    (f : (ν : ScalarCharge Ω) → ν.CountablyAdditive → FiniteSignedMeasure Ω)
    (ν : ScalarCharge Ω) (hν : ν.CountablyAdditive) :
    liftOnCharge (ofCharge ν hν) f = f ν hν := by
  let μ := ofCharge ν hν
  let q := Classical.choose (exists_charge μ)
  let hq := Classical.choose (Classical.choose_spec (exists_charge μ))
  have he : ofCharge q hq = ofCharge ν hν :=
    Classical.choose_spec (Classical.choose_spec (exists_charge μ))
  have hqν : q = ν := by
    apply ScalarCharge.ext_val
    intro E
    simpa only [eval_ofCharge] using congrArg (eval E) he
  have hinv (s : ScalarCharge Ω) (hs : s.CountablyAdditive) (h : s = ν) :
      f s hs = f ν hν := by subst s; rfl
  exact hinv q hq hqν

private noncomputable def posPart (μ : FiniteSignedMeasure Ω) : FiniteSignedMeasure Ω :=
  liftOnCharge μ (fun ν hν => ofCharge ν.positivePart (ν.positivePart_countablyAdditive hν))

private theorem posPart_ofCharge (ν : ScalarCharge Ω) (hν : ν.CountablyAdditive) :
    posPart (ofCharge ν hν) = ofCharge ν.positivePart (ν.positivePart_countablyAdditive hν) :=
  liftOnCharge_ofCharge _ ν hν

private theorem posPart_pos (μ : FiniteSignedMeasure Ω) : Positive (posPart μ) := by
  obtain ⟨ν, hν, rfl⟩ := exists_charge μ
  intro E
  change 0 ≤ eval E (posPart (ofCharge ν hν))
  rw [posPart_ofCharge, eval_ofCharge]
  exact ν.positivePart_positive E

private theorem le_posPart (μ : FiniteSignedMeasure Ω) : Positive (posPart μ - μ) := by
  obtain ⟨ν, hν, rfl⟩ := exists_charge μ
  intro E
  change 0 ≤ eval E (posPart (ofCharge ν hν) - ofCharge ν hν)
  rw [map_sub (eval E), posPart_ofCharge, eval_ofCharge, eval_ofCharge, sub_nonneg]
  exact ν.val_le_upperVariation Subset.rfl

private theorem posPart_le (x y : FiniteSignedMeasure Ω) (hy : Positive y)
    (hxy : Positive (y - x)) : Positive (y - posPart x) := by
  obtain ⟨ν, hν, rfl⟩ := exists_charge x
  obtain ⟨μ, hμ, rfl⟩ := exists_charge y
  have h₁ : μ.Positive := fun E => by
    have h := hy E
    change 0 ≤ eval E (ofCharge μ hμ) at h
    rwa [eval_ofCharge] at h
  have h₂ (E : MeasSet Ω) : ν.val E ≤ μ.val E := by
    have h := hxy E
    change 0 ≤ eval E (ofCharge μ hμ - ofCharge ν hν) at h
    rwa [map_sub (eval E), eval_ofCharge, eval_ofCharge, sub_nonneg] at h
  intro E
  change 0 ≤ eval E (ofCharge μ hμ - posPart (ofCharge ν hν))
  rw [map_sub (eval E), posPart_ofCharge, eval_ofCharge, eval_ofCharge, sub_nonneg]
  exact ν.upperVariation_le E _ (fun F hFE => (h₂ F).trans (μ.val_mono h₁ hFE))

private theorem modulus_eq_two_posPart_sub (μ : FiniteSignedMeasure Ω) :
    modulus μ = (2 : ℝ) • posPart μ - μ := by
  obtain ⟨ν, hν, rfl⟩ := exists_charge μ
  rw [modulus_ofCharge, posPart_ofCharge]
  apply FiniteSignedMeasure.ext
  intro E
  rw [map_sub (eval E), map_smul (eval E), smul_eq_mul, eval_ofCharge,
    eval_ofCharge, eval_ofCharge]
  change ν.positivePart.val E + ν.neg.positivePart.val E =
    2 * ν.positivePart.val E - ν.val E
  linarith [ν.val_eq_positive_sub_negative E]

private noncomputable def alPositivePart (Ω : Type*) [MeasurableSpace Ω] :
    ALPositivePart (FiniteSignedMeasure Ω) where
  cone := {x | Positive x}
  positivePart := posPart
  zero_mem := fun E => by change 0 ≤ eval E 0; rw [map_zero]
  add_mem := by
    intro x y hx hy E
    change 0 ≤ eval E (x + y)
    rw [map_add (eval E)]
    exact add_nonneg (hx E) (hy E)
  smul_mem := by
    intro a x ha hx E
    change 0 ≤ eval E (a • x)
    rw [map_smul (eval E), smul_eq_mul]
    exact mul_nonneg ha (hx E)
  pointed := by
    intro x hx hnx
    apply FiniteSignedMeasure.ext
    intro E
    have h := hnx E
    change 0 ≤ eval E (-x) at h
    rw [map_neg (eval E), neg_nonneg] at h
    rw [map_zero]
    exact le_antisymm h (hx E)
  positivePart_mem := posPart_pos
  le_positivePart := le_posPart
  positivePart_le := posPart_le
  norm_absolute := fun x => by rw [← modulus_eq_two_posPart_sub, norm_modulus]
  norm_mono := by intro x y hx hy; exact norm_mono_of_positive hx hy
  norm_add_positive := by
    intro x y hx hy
    have hxy : Positive (x + y) := by
      intro E
      change 0 ≤ eval E (x + y)
      rw [map_add (eval E)]
      exact add_nonneg (hx E) (hy E)
    rw [← mass_eq_norm_of_positive hxy, ← mass_eq_norm_of_positive hx,
      ← mass_eq_norm_of_positive hy, map_add (eval MeasSet.whole)]

/-- Manuscript, lem:measure-positive-majorant, for the total-variation
space of finite signed countably additive measures. -/
theorem exists_positive_majorant (R : FiniteSignedMeasure Ω →L[ℝ] FiniteSignedMeasure Ω) :
    ∃ V : FiniteSignedMeasure Ω →L[ℝ] FiniteSignedMeasure Ω,
      (∀ ⦃μ⦄, Positive μ → Positive (V μ)) ∧
        measureOperatorNorm (E := FiniteSignedMeasure Ω) V =
          measureOperatorNorm (E := FiniteSignedMeasure Ω) R ∧
      ∀ μ, Positive (V (modulus μ) - modulus (R μ)) := by
  obtain ⟨V, hp, hn, hm⟩ :=
    citeDalesLaustsenOikhbergTroitsky2017_AL (alPositivePart Ω) R
  refine ⟨V, by intro μ h; exact hp μ h, hn, fun μ => ?_⟩
  have hh := hm μ
  change Positive (V ((2 : ℝ) • posPart μ - μ) -
    ((2 : ℝ) • posPart (R μ) - R μ)) at hh
  simpa only [← modulus_eq_two_posPart_sub] using hh

end FiniteSignedMeasure

#print axioms FiniteSignedMeasure.exists_positive_majorant

end PositiveMeasureMajorant



section BoundedMeasureDensities

open MeasureTheory
open scoped ENNReal

namespace FiniteSignedMeasure

variable {Ω : Type*} [MeasurableSpace Ω]

theorem abs_eval_le_modulus (μ : FiniteSignedMeasure Ω) (E : MeasSet Ω) :
    |eval E μ| ≤ eval E (modulus μ) := by
  obtain ⟨ν, hν, rfl⟩ := exists_charge μ
  rw [modulus_ofCharge, eval_ofCharge, eval_ofCharge, ν.val_eq_positive_sub_negative]
  change |ν.positivePart.val E - ν.neg.positivePart.val E| ≤
    ν.positivePart.val E + ν.neg.positivePart.val E
  apply abs_le.mpr
  constructor <;> linarith [ν.positivePart_positive E, ν.neg.positivePart_positive E]

/-- The bounded Radon–Nikodym density used in the norm-recovery proof. -/
theorem exists_bounded_density (μ : FiniteSignedMeasure Ω) (ρ : Measure Ω)
    [IsFiniteMeasure ρ] (C : ℝ) (hC : 0 ≤ C)
    (hdom : ∀ E : MeasSet Ω, eval E (modulus μ) ≤ C * ρ.real E.1) :
    ∃ f : Ω → ℝ, Measurable f ∧ ∃ hf : Integrable f ρ, ofDensity hf = μ ∧
      ∀ᵐ x ∂ρ, ‖f x‖ ≤ C := by
  obtain ⟨f, hmf, hf, he⟩ := exists_density μ ρ (fun E hE => by
    have hm := hdom E
    rw [measureReal_def, hE, ENNReal.toReal_zero, mul_zero] at hm
    exact abs_eq_zero.mp (le_antisymm ((abs_eval_le_modulus μ E).trans hm) (abs_nonneg _)))
  refine ⟨f, hmf, hf, he, ?_⟩
  let E : MeasSet Ω := ⟨{x | C < ‖f x‖}, measurableSet_lt measurable_const hmf.norm⟩
  have hE : ρ E.1 = 0 := by
    by_contra hpos
    have hlt := setIntegral_gt_gt (μ := ρ) (f := fun x => ‖f x‖) hC hf.norm.integrableOn hpos
    have hle := hdom E
    rw [← he, eval_modulus_ofDensity, mul_comm C] at hle
    exact (not_lt_of_ge hle) hlt
  rw [ae_iff]
  change ρ {x | ¬ ‖f x‖ ≤ C} = 0
  simpa only [not_le] using hE

/-- For a probability measure, bounded domination controls the norm of
the representing density by the scalar L¹--L∞ estimate in the manuscript. -/
theorem exists_densityMap_of_domination
    (μ : FiniteSignedMeasure Ω) (ρ : Measure Ω) [IsProbabilityMeasure ρ]
    (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≠ ∞)
    (C : ℝ) (hC : 0 ≤ C)
    (hdom : ∀ E : MeasSet Ω, eval E (modulus μ) ≤ C * ρ.real E.1) :
    ∃ a : Lp ℝ p ρ, densityMap a = μ ∧
      ‖a‖ ≤ C ^ (1 - 1 / p.toReal) * ‖μ‖ ^ (1 / p.toReal) := by
  obtain ⟨f, hmf, hf, he, hbound⟩ := exists_bounded_density μ ρ C hC hdom
  have hp₁ : 1 ≤ p := Fact.out
  have hp₀ : p ≠ 0 := ne_of_gt (zero_lt_one.trans_le hp₁)
  have hr₁ : 1 ≤ p.toReal := by
    simpa only [ENNReal.toReal_one] using ENNReal.toReal_mono hp hp₁
  have hr₀ : 0 < p.toReal := zero_lt_one.trans_le hr₁
  let s := ENNReal.ofReal C ^ (p.toReal - 1)
  have hs : s ≠ ∞ := ENNReal.rpow_ne_top_of_nonneg (sub_nonneg.mpr hr₁) ENNReal.ofReal_ne_top
  have hi : ∫⁻ x, ‖f x‖ₑ ∂ρ = ENNReal.ofReal ‖μ‖ := by
    rw [← ofReal_integral_norm_eq_lintegral_eNorm hf, ← norm_ofDensity hf, he]
  have hpw : (∫⁻ x, ‖f x‖ₑ ^ p.toReal ∂ρ) ≤ s * ENNReal.ofReal ‖μ‖ := by
    rw [← hi, ← lintegral_const_mul s hmf.eNorm]
    apply lintegral_mono_ae
    filter_upwards [hbound] with x hx
    have hx' : ‖f x‖ₑ ≤ ENNReal.ofReal C :=
      (ofReal_norm (f x)).symm ▸ ENNReal.ofReal_le_ofReal hx
    calc
      ‖f x‖ₑ ^ p.toReal = ‖f x‖ₑ ^ (p.toReal - 1) * ‖f x‖ₑ := by
        calc
          _ = ‖f x‖ₑ ^ ((p.toReal - 1) + 1) := by rw [sub_add_cancel]
          _ = _ := by rw [ENNReal.rpow_add_of_nonneg _ _ (sub_nonneg.mpr hr₁) zero_le_one,
            ENNReal.rpow_one]
      _ ≤ s * ‖f x‖ₑ :=
        mul_le_mul_of_nonneg_right (ENNReal.rpow_le_rpow hx' (sub_nonneg.mpr hr₁)) bot_le
  have ht : s * ENNReal.ofReal ‖μ‖ ≠ ∞ := ENNReal.mul_ne_top hs ENNReal.ofReal_ne_top
  have hb := ENNReal.rpow_le_rpow hpw (by positivity : 0 ≤ 1 / p.toReal)
  rw [← eLpNorm_eq_lintegral_rpow_eNorm_toReal hp₀ hp hf.aestronglyMeasurable] at hb
  have hbfin : (s * ENNReal.ofReal ‖μ‖) ^ (1 / p.toReal) ≠ ∞ :=
    ENNReal.rpow_ne_top_of_nonneg (by positivity) ht
  have hm : MemLp f p ρ := hb.trans_lt hbfin.lt_top
  let a := hm.toLp f
  have ha : (fun x => a x) =ᵐ[ρ] f := hm.coeFn_toLp
  refine ⟨a, (ofDensity_congr (integrable_Lp a) hf ha).trans he, ?_⟩
  rw [Lp.norm_def, eLpNorm_congr_ae ha]
  refine (ENNReal.toReal_mono hbfin hb).trans_eq ?_
  rw [← ENNReal.toReal_rpow, ENNReal.toReal_mul]
  change ((ENNReal.ofReal C ^ (p.toReal - 1)).toReal * (ENNReal.ofReal ‖μ‖).toReal) ^
    (1 / p.toReal) = _
  have hnorm : 0 ≤ ‖μ‖ := norm_nonneg μ
  rw [← ENNReal.toReal_rpow, ENNReal.toReal_ofReal hC, ENNReal.toReal_ofReal hnorm,
    Real.mul_rpow (Real.rpow_nonneg hC _) hnorm, ← Real.rpow_mul hC]
  rw [show (p.toReal - 1) * (1 / p.toReal) = 1 - 1 / p.toReal by field_simp]

end FiniteSignedMeasure

#print axioms FiniteSignedMeasure.exists_bounded_density
#print axioms FiniteSignedMeasure.exists_densityMap_of_domination

end BoundedMeasureDensities



section MeasureQuotientRecovery

open MeasureTheory
open scoped ENNReal

namespace FiniteSignedMeasure

variable {Ω X : Type*} [MeasurableSpace Ω]
  [NormedAddCommGroup X] [NormedSpace ℝ X]
local instance : TopologicalSpace (MeasSet Ω × MeasSet Ω) := ⊥
local instance : Nonempty (MeasSet Ω × MeasSet Ω) := ⟨(MeasSet.empty, MeasSet.empty)⟩

/-- The probability measure attached to a member of the resolvent family. -/
noncomputable def resolventBase
    {V : FiniteSignedMeasure Ω →L[ℝ] FiniteSignedMeasure Ω}
    (ρ : resolventProbabilities {x | Positive x} V) : Measure Ω :=
  toMeasure ρ.1 ρ.2.1

instance resolventBase_probability
    {V : FiniteSignedMeasure Ω →L[ℝ] FiniteSignedMeasure Ω}
    (ρ : resolventProbabilities {x | Positive x} V) :
    IsProbabilityMeasure (resolventBase ρ) :=
  toMeasure_isProbability ρ.1 ρ.2.1 ρ.2.2.1

private theorem resolventBase_real
    {V : FiniteSignedMeasure Ω →L[ℝ] FiniteSignedMeasure Ω}
    (ρ : resolventProbabilities {x | Positive x} V) (E : MeasSet Ω) :
    (resolventBase ρ).real E.1 = eval E ρ.1 := by
  rw [measureReal_def, resolventBase, toMeasure_apply, ENNReal.toReal_ofReal (ρ.2.1 E)]

private theorem normalized_modulus_domination (μ ρ : FiniteSignedMeasure Ω)
    (hμ : μ ≠ 0) (k : ℝ)
    (hh : Positive (k • ρ - ‖μ‖⁻¹ • modulus μ)) :
    Positive ((‖μ‖ * k) • ρ - modulus μ) := by
  intro E
  have h := hh E
  change 0 ≤ eval E (k • ρ - ‖μ‖⁻¹ • modulus μ) at h
  rw [map_sub (eval E), map_smul (eval E), map_smul (eval E),
    smul_eq_mul, smul_eq_mul] at h
  have hs : 0 < ‖μ‖ := by
    change 0 < ‖μ.1‖
    exact norm_pos_iff.mpr (fun he => hμ (Subtype.ext he))
  have hh' := mul_nonneg hs.le h
  rw [mul_sub, ← mul_assoc, ← mul_assoc, mul_inv_cancel₀ hs.ne', one_mul] at hh'
  change 0 ≤ eval E ((‖μ‖ * k) • ρ - modulus μ)
  rwa [map_sub (eval E), map_smul (eval E), smul_eq_mul]

private theorem exists_local_density_of_bound
    {V : FiniteSignedMeasure Ω →L[ℝ] FiniteSignedMeasure Ω}
    (ρ : resolventProbabilities {x | Positive x} V) (μ : FiniteSignedMeasure Ω)
    (hμ : μ ≠ 0) (k : ℝ) (hk : 1 ≤ k)
    (hh : Positive (k • ρ.1 - ‖μ‖⁻¹ • modulus μ))
    (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≠ ∞) :
    ∃ a : Lp ℝ p (resolventBase ρ), densityMap a = μ ∧
      ‖a‖ ≤ ‖μ‖ * k ^ (1 - 1 / p.toReal) := by
  have hpos := normalized_modulus_domination μ ρ.1 hμ k hh
  have hdom (E : MeasSet Ω) :
      eval E (modulus μ) ≤ (‖μ‖ * k) * (resolventBase ρ).real E.1 := by
    have h := hpos E
    change 0 ≤ eval E ((‖μ‖ * k) • ρ.1 - modulus μ) at h
    rwa [resolventBase_real, ← sub_nonneg, ← smul_eq_mul, ← map_smul (eval E), ← map_sub (eval E)]
  obtain ⟨a, ha, hn⟩ := exists_densityMap_of_domination μ (resolventBase ρ) p hp
    (‖μ‖ * k) (mul_nonneg (show 0 ≤ ‖μ.1‖ from norm_nonneg μ.1) (zero_le_one.trans hk)) hdom
  refine ⟨a, ha, hn.trans_eq ?_⟩
  have hs : 0 < ‖μ‖ := by
    change 0 < ‖μ.1‖
    exact norm_pos_iff.mpr (fun he => hμ (Subtype.ext he))
  rw [Real.mul_rpow hs.le (zero_le_one.trans hk)]
  calc
    _ = (‖μ‖ ^ (1 - 1 / p.toReal) * ‖μ‖ ^ (1 / p.toReal)) *
        k ^ (1 - 1 / p.toReal) := by ring
    _ = _ := by rw [← Real.rpow_add hs, sub_add_cancel, Real.rpow_one]


/-- The index from the resolvent can be chosen so that any continuous
function of its normalization scale is as close as needed to its value at one. -/
private theorem resolvent_index_near_one {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] [CompleteSpace E]
    (K : Set E) (hK : IsClosed K) (L : ALPositivePart E) (hLK : L.cone = K)
    (V : E →L[ℝ] E) (hV : ∀ ⦃x⦄, x ∈ K → V x ∈ K)
    (η : E) (hη : η ∈ K) (hηn : ‖η‖ = 1)
    (g : ℝ → ℝ) (hg : ContinuousAt g 1) (r : ℝ) (hr : g 1 < r) :
    ∃ (ρ : resolventProbabilities K V) (k : ℝ), 1 ≤ k ∧ g k < r ∧
      k • ρ.1 - η ∈ K := by
  subst K
  let v (b : ℝ) := ∑' n : ℕ, (b⁻¹)^n • (V ^ n) η
  let k (b : ℝ) := ‖v b‖
  have ht : Tendsto k atTop (𝓝 1) :=
    positive_resolvent_scale_tendsto_one L.cone hK L.add_mem L.smul_mem L.norm_mono
      V hV η hη hηn
  have hgt := hg.tendsto.comp ht
  have hlt := (tendsto_order.mp hgt).2 r hr
  obtain ⟨b, hb, hgb⟩ := ((eventually_gt_atTop ‖V‖).and hlt).exists
  obtain ⟨_, _, _, _, hk, _, hpos, hunit, hdom, hsub⟩ :=
    positive_resolvent_control L.cone hK L.add_mem L.smul_mem L.norm_mono V hV η hη hηn b hb
  have hb0 := (norm_nonneg V).trans_lt hb
  exact ⟨⟨(k b)⁻¹ • v b, hpos, hunit, b, hb0, hsub⟩, k b, hk, hgb, hdom⟩


/-- The resolvent indices give Lp representatives arbitrarily close to the
total-variation norm of each signed measure. -/
theorem exists_near_norm_density [Nonempty Ω]
    (V : FiniteSignedMeasure Ω →L[ℝ] FiniteSignedMeasure Ω)
    (hV : ∀ ⦃μ⦄, Positive μ → Positive (V μ))
    (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≠ ∞)
    (μ : FiniteSignedMeasure Ω) (ε : ℝ) (hε : 0 < ε) :
    ∃ (ρ : resolventProbabilities {x | Positive x} V) (a : Lp ℝ p (resolventBase ρ)),
      densityMap a = μ ∧ ‖a‖ < ‖μ‖ + ε := by
  by_cases hμ : μ = 0
  · obtain ⟨η, hη, hηm⟩ := exists_probability (Ω := Ω)
    obtain ⟨ρ, hρ, _⟩ := (resolvent_family V hV).1 η hη hηm
    refine ⟨⟨ρ, hρ⟩, 0, ?_, ?_⟩
    · rw [map_zero, hμ]
    · rw [hμ]
      change ‖(0 : Lp ℝ p (resolventBase ⟨ρ, hρ⟩))‖ < ‖(0 : SignedMeasureAmbient Ω)‖ + ε
      simpa only [norm_zero, zero_add] using hε
  · let K : Set (FiniteSignedMeasure Ω) := {ν | Positive ν}
    let L := alPositivePart Ω
    let η : FiniteSignedMeasure Ω := ‖μ‖⁻¹ • modulus μ
    obtain ⟨hη, hηn⟩ := normalized_modulus μ hμ
    let β : ℝ := 1 - 1 / p.toReal
    let g (k : ℝ) : ℝ := ‖μ‖ * k ^ β
    have hg : ContinuousAt g 1 :=
      continuousAt_const.mul (Real.continuousAt_rpow_const 1 β (.inl one_ne_zero))
    have hr : g 1 < ‖μ‖ + ε := by
      change ‖μ‖ * (1 : ℝ)^β < _
      rw [Real.one_rpow, mul_one]
      exact lt_add_of_pos_right _ hε
    obtain ⟨ρ, k, hk, hclose, hdom⟩ := resolvent_index_near_one K (positive_closed Ω)
      L rfl V (by intro x hx; exact hV hx) η hη hηn g hg (‖μ‖ + ε) hr
    obtain ⟨a, ha, hn⟩ := exists_local_density_of_bound ρ μ hμ k hk hdom p hp
    exact ⟨ρ, a, ha, hn.trans_lt hclose⟩


variable {V : FiniteSignedMeasure Ω →L[ℝ] FiniteSignedMeasure Ω}
  (S : FiniteSignedMeasure Ω →L[ℝ] X)
  (p : ℝ≥0∞) [Fact (1 ≤ p)]

/-- Synthesis from Lp through the density measure. -/
noncomputable def densitySynthesis (ρ : resolventProbabilities {x | Positive x} V) :
    Lp ℝ p (resolventBase ρ) →L[ℝ] X :=
  S.comp densityMap

noncomputable abbrev LocalMeasureQuotient (ρ : resolventProbabilities {x | Positive x} V) :=
  Lp ℝ p (resolventBase ρ) ⧸ (densitySynthesis S p ρ).ker

instance localMeasureQuotient_closed (ρ : resolventProbabilities {x | Positive x} V) :
    IsClosed ((densitySynthesis S p ρ).ker : Set (Lp ℝ p (resolventBase ρ))) :=
  (densitySynthesis S p ρ).isClosed_ker

noncomputable def localToOriginal (ρ : resolventProbabilities {x | Positive x} V) :
    LocalMeasureQuotient S p ρ →L[ℝ] X :=
  (densitySynthesis S p ρ).ker.liftQL (densitySynthesis S p ρ) le_rfl

private theorem norm_densityMap_le
    (ρ : resolventProbabilities {x | Positive x} V) (a : Lp ℝ p (resolventBase ρ)) :
    ‖densityMap a‖ ≤ ‖a‖ := by
  rw [show ‖densityMap a‖ = ‖ofDensity (integrable_Lp a)‖ from rfl, norm_ofDensity, Lp.norm_def]
  have hf := integrable_Lp a
  have he : (eLpNorm a 1 (resolventBase ρ)).toReal = ∫ x, ‖a x‖ ∂resolventBase ρ := by
    rw [eLpNorm_one_eq_lintegral_eNorm hf.aestronglyMeasurable,
      ← ofReal_integral_norm_eq_lintegral_eNorm hf,
      ENNReal.toReal_ofReal (integral_nonneg fun _ => norm_nonneg _)]
  rw [← he]
  exact ENNReal.toReal_mono (Lp.memLp a).eLpNorm_ne_top
    (eLpNorm_le_eLpNorm_of_exponent_le (Fact.out : 1 ≤ p))

/-- The union and quotient norm formula in part (iii) of
thm:measure-inductive-dilation. The two assumptions on S express the
given quotient norm by contraction and approximate representatives. -/
theorem measureQuotient_norm_recovery [Nonempty Ω]
    (hp : p ≠ ∞) (hV : ∀ ⦃μ⦄, Positive μ → Positive (V μ))
    (hS : ∀ μ, ‖S μ‖ ≤ ‖μ‖)
    (hrep : ∀ x : X, ∀ ε > 0, ∃ μ, S μ = x ∧ ‖μ‖ < ‖x‖ + ε) (x : X) :
    (∃ (ρ : resolventProbabilities {ν | Positive ν} V) (z : LocalMeasureQuotient S p ρ),
      localToOriginal S p ρ z = x) ∧
    ‖x‖ = sInf {r : ℝ | ∃ (ρ : resolventProbabilities {ν | Positive ν} V)
      (z : LocalMeasureQuotient S p ρ), localToOriginal S p ρ z = x ∧ ‖z‖ = r} := by
  let A : Set ℝ := {r : ℝ | ∃ (ρ : resolventProbabilities {ν | Positive ν} V)
    (z : LocalMeasureQuotient S p ρ), localToOriginal S p ρ z = x ∧ ‖z‖ = r}
  have hlow (ρ : resolventProbabilities {ν | Positive ν} V) (z : LocalMeasureQuotient S p ρ) :
      ‖localToOriginal S p ρ z‖ ≤ ‖z‖ := by
    refine le_of_forall_pos_le_add fun ε hε => ?_
    obtain ⟨a, ha, hn⟩ := Submodule.Quotient.norm_mk_lt z hε
    rw [← ha]
    change ‖S (densityMap a)‖ ≤ ‖(Submodule.Quotient.mk a : LocalMeasureQuotient S p ρ)‖ + ε
    exact ((hS _).trans (norm_densityMap_le p ρ a)).trans (by simpa only [ha] using hn.le)
  have hnear (ε : ℝ) (hε : 0 < ε) :
      ∃ (ρ : resolventProbabilities {ν | Positive ν} V) (z : LocalMeasureQuotient S p ρ),
        localToOriginal S p ρ z = x ∧ ‖z‖ < ‖x‖ + ε := by
    obtain ⟨μ, hμ, hmn⟩ := hrep x (ε / 2) (by positivity)
    obtain ⟨ρ, a, ha, han⟩ := exists_near_norm_density V hV p hp μ (ε / 2) (by positivity)
    refine ⟨ρ, Submodule.Quotient.mk a, ?_, ?_⟩
    · change S (densityMap a) = x
      rwa [ha]
    · refine (Submodule.Quotient.norm_mk_le (densitySynthesis S p ρ).ker a).trans_lt ?_
      linarith
  obtain ⟨ρ, z, hz, _⟩ := hnear 1 zero_lt_one
  refine ⟨⟨ρ, z, hz⟩, ?_⟩
  have hn : A.Nonempty := ⟨‖z‖, ρ, z, hz, rfl⟩
  have hb : ‖x‖ ∈ lowerBounds A := by
    rintro r ⟨ν, w, hw, rfl⟩
    simpa only [hw] using hlow ν w
  refine le_antisymm (le_csInf hn hb) (le_of_forall_pos_le_add fun ε hε => ?_)
  obtain ⟨ν, w, hw, hnw⟩ := hnear ε hε
  exact (csInf_le ⟨‖x‖, hb⟩ (show ‖w‖ ∈ A from ⟨ν, w, hw, rfl⟩)).trans hnw.le

end FiniteSignedMeasure

#print axioms FiniteSignedMeasure.exists_near_norm_density
#print axioms FiniteSignedMeasure.measureQuotient_norm_recovery

end MeasureQuotientRecovery



section MeasureQuotientTopology

open MeasureTheory
open scoped ENNReal

namespace FiniteSignedMeasure

variable {Ω X : Type*} [MeasurableSpace Ω]
  [NormedAddCommGroup X] [NormedSpace ℝ X]

/-- A sequence of rapidly vanishing representing measures has densities
converging to zero in a single local Lp space. -/
theorem exists_common_density_stage
    (V : FiniteSignedMeasure Ω →L[ℝ] FiniteSignedMeasure Ω)
    (hV : ∀ ⦃μ⦄, Positive μ → Positive (V μ))
    (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≠ ∞)
    (μ : ℕ → FiniteSignedMeasure Ω) (hμ : ∀ n, μ n ≠ 0)
    (hn : ∀ n, ‖μ n‖ ≤ (1 / 4 : ℝ)^n) :
    ∃ (ρ : resolventProbabilities {ν | Positive ν} V)
      (a : ℕ → Lp ℝ p (resolventBase ρ)), (∀ n, densityMap (a n) = μ n) ∧
        Tendsto a atTop (𝓝 0) := by
  let η (n : ℕ) := ‖μ n‖⁻¹ • modulus (μ n)
  have hη (n : ℕ) := normalized_modulus (μ n) (hμ n)
  obtain ⟨ρ, hρ, k, hk, hdom⟩ := (resolvent_family V hV).2 η
    (fun n => (hη n).1) (fun n => (mass_eq_norm_of_positive (hη n).1).trans (hη n).2)
  let r : resolventProbabilities {ν | Positive ν} V := ⟨ρ, hρ⟩
  let d (n : ℕ) := (2^(n+1) : ℝ) * k
  have hd (n : ℕ) : 1 ≤ d n := by
    calc
      1 ≤ (2^(n+1) : ℝ) := one_le_pow₀ (by norm_num)
      _ = 2^(n+1) * 1 := by rw [mul_one]
      _ ≤ d n := mul_le_mul_of_nonneg_left hk (by positivity)
  choose a ha hna using fun n =>
    exists_local_density_of_bound r (μ n) (hμ n) (d n) (hd n) (hdom n) p hp
  refine ⟨r, a, ha, ?_⟩
  have hβ : 1 - 1 / p.toReal ≤ 1 := by
    linarith [div_nonneg zero_le_one (ENNReal.toReal_nonneg : 0 ≤ p.toReal)]
  have hnd (n : ℕ) : ‖a n‖ ≤ (2 * k) * (1 / 2 : ℝ)^n := by
    have hr := Real.rpow_le_rpow_of_exponent_le (hd n) hβ
    rw [Real.rpow_one] at hr
    have hμn : 0 ≤ ‖μ n‖ := norm_nonneg (μ n)
    calc
      ‖a n‖ ≤ ‖μ n‖ * d n ^ (1 - 1 / p.toReal) := hna n
      _ ≤ ‖μ n‖ * d n := mul_le_mul_of_nonneg_left hr hμn
      _ ≤ (1 / 4 : ℝ)^n * d n :=
        mul_le_mul_of_nonneg_right (hn n) (zero_le_one.trans (hd n))
      _ = (2 * k) * (1 / 2 : ℝ)^n := by
        rw [show d n = (2 : ℝ)^n * 2 * k by change (2 : ℝ)^(n+1) * k = _; rw [pow_succ]]
        calc
          _ = (2 * k) * ((1 / 4 : ℝ)^n * (2 : ℝ)^n) := by ring
          _ = _ := by rw [← mul_pow]; norm_num
  have hg : Tendsto (fun n : ℕ => (2 * k) * (1 / 2 : ℝ)^n) atTop (𝓝 0) := by
    simpa only [mul_zero] using (tendsto_const_nhds (x := 2 * k)).mul
      (tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num : 0 ≤ (1/2 : ℝ)) (by norm_num))
  exact tendsto_zero_iff_norm_tendsto_zero.mpr (squeeze_zero (fun _ => norm_nonneg _) hnd hg)

/-- The locally convex final topology in part (iv), expressed by the
continuity of exactly the seminorms continuous on all local quotients. -/
theorem measureQuotient_seminorm_continuous_iff
    (V : FiniteSignedMeasure Ω →L[ℝ] FiniteSignedMeasure Ω)
    (hV : ∀ ⦃μ⦄, Positive μ → Positive (V μ))
    (S : FiniteSignedMeasure Ω →L[ℝ] X)
    (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≠ ∞)
    (hrep : ∀ x : X, ∀ ε > 0, ∃ μ, S μ = x ∧ ‖μ‖ < ‖x‖ + ε) (q : Seminorm ℝ X) :
    Continuous q ↔ ∀ ρ : resolventProbabilities {ν | Positive ν} V,
      Continuous (fun z : LocalMeasureQuotient S p ρ => q (localToOriginal S p ρ z)) := by
  constructor
  · intro h ρ
    exact h.comp (localToOriginal S p ρ).continuous
  · intro hq
    by_contra hn
    have hn₀ : ¬ ContinuousAt q 0 := fun h => hn (Seminorm.continuous_of_continuousAt_zero h)
    rw [Metric.continuousAt_iff] at hn₀
    push Not at hn₀
    obtain ⟨ε, hε, hδ⟩ := hn₀
    let w (n : ℕ) := (1 / 4 : ℝ)^n
    have hw (n : ℕ) : 0 < w n / 2 := by dsimp [w]; positivity
    choose x hx hbad using fun n => hδ (w n / 2) (hw n)
    have hxn (n : ℕ) : ‖x n‖ < w n / 2 := by simpa only [dist_zero_right] using hx n
    have hqε (n : ℕ) : ε ≤ q (x n) := by
      simpa only [map_zero, Real.dist_eq, sub_zero, abs_of_nonneg (apply_nonneg q (x n))] using hbad n
    choose μ hμ hmn using fun n => hrep (x n) (w n / 2) (hw n)
    have hnμ (n : ℕ) : μ n ≠ 0 := by
      intro h
      have hx0 : x n = 0 := (hμ n).symm.trans (h ▸ S.map_zero)
      exact (not_le_of_gt hε) (by simpa only [hx0, map_zero] using hqε n)
    have hμn (n : ℕ) : ‖μ n‖ ≤ w n := by linarith [hxn n, hmn n]
    obtain ⟨ρ, a, ha, hat⟩ := exists_common_density_stage V hV p hp μ hnμ hμn
    let mk : Lp ℝ p (resolventBase ρ) →L[ℝ] LocalMeasureQuotient S p ρ :=
      (densitySynthesis S p ρ).ker.mkQL
    have hmk := (mk.continuous.tendsto 0).comp hat
    have hmkt : Tendsto (fun n => mk (a n)) atTop (𝓝 0) := by
      simpa only [Function.comp_def, map_zero] using hmk
    have ht := ((hq ρ).tendsto 0).comp hmkt
    have hqe : Tendsto (fun n => q (x n)) atTop (𝓝 0) := by
      have he (n : ℕ) : localToOriginal S p ρ (mk (a n)) = x n := by
        change S (densityMap (a n)) = x n
        rw [ha n, hμ n]
      simpa only [Function.comp_def, he, map_zero] using ht
    obtain ⟨n, hlt⟩ := ((tendsto_order.mp hqe).2 ε hε).exists
    exact (not_lt_of_ge (hqε n)) hlt

end FiniteSignedMeasure

#print axioms FiniteSignedMeasure.exists_common_density_stage
#print axioms FiniteSignedMeasure.measureQuotient_seminorm_continuous_iff

end MeasureQuotientTopology



section DensityEndpoints

open MeasureTheory
open scoped ENNReal

private theorem measureOperatorNorm_bound {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E] (R : E →L[ℝ] E) (x : E) :
    ‖R x‖ ≤ measureOperatorNorm R * ‖x‖ := R.le_opNorm x

namespace FiniteSignedMeasure

variable {Ω : Type*} [MeasurableSpace Ω]

local instance : TopologicalSpace (MeasSet Ω × MeasSet Ω) := ⊥
local instance : Nonempty (MeasSet Ω × MeasSet Ω) := ⟨(MeasSet.empty, MeasSet.empty)⟩

/-- The endpoint estimates on bounded inputs in the proof of
eq:measure-density-bound. They come from the order domination by V,
and from the total variation norm of a density measure. -/
theorem bounded_density_endpoints
    {V R : FiniteSignedMeasure Ω →L[ℝ] FiniteSignedMeasure Ω}
    (hV : ∀ ⦃μ⦄, Positive μ → Positive (V μ))
    (hR : ∀ μ, Positive (V (modulus μ) - modulus (R μ)))
    (ρ : FiniteSignedMeasure Ω) (σ : Measure Ω) [IsFiniteMeasure σ]
    (hσ : ∀ E : MeasSet Ω, σ.real E.1 = eval E ρ)
    {b : ℝ} (hb : 0 < b) (hρ : Positive (b • ρ - V ρ))
    {f : Ω → ℝ} (hf : Integrable f σ)
    (C : ℝ) (hC : 0 ≤ C) (hbf : ∀ᵐ x ∂σ, ‖f x‖ ≤ C) :
    ∃ g : Ω → ℝ, Measurable g ∧ ∃ hg : Integrable g σ,
      ofDensity hg = R (ofDensity hf) ∧
      ∀ᵐ x ∂σ, ‖g x‖ ≤ b * C := by
  let μ := ofDensity hf
  have hμ : Positive (C • ρ - modulus μ) := by
    intro E
    have hlt := integral_mono_ae hf.norm.restrict (integrable_const C).restrict
      (ae_restrict_le hbf : ∀ᵐ x ∂σ.restrict E.1, ‖f x‖ ≤ C)
    rw [setIntegral_const, smul_eq_mul, hσ, mul_comm] at hlt
    change 0 ≤ eval E (C • ρ - modulus (ofDensity hf))
    rw [map_sub (eval E), map_smul (eval E), smul_eq_mul, eval_modulus_ofDensity, sub_nonneg]
    exact hlt
  have hdom (E : MeasSet Ω) :
      eval E (modulus (R μ)) ≤ (b * C) * σ.real E.1 := by
    have h₁ := hR μ E
    have h₂ := hV hμ E
    have h₃ := hρ E
    change 0 ≤ eval E (V (modulus μ) - modulus (R μ)) at h₁
    change 0 ≤ eval E (V (C • ρ - modulus μ)) at h₂
    change 0 ≤ eval E (b • ρ - V ρ) at h₃
    rw [map_sub (eval E), sub_nonneg] at h₁
    rw [map_sub V, map_smul V, map_sub (eval E), map_smul (eval E), smul_eq_mul, sub_nonneg] at h₂
    rw [map_sub (eval E), map_smul (eval E), smul_eq_mul, sub_nonneg] at h₃
    rw [hσ]
    exact h₁.trans (h₂.trans ((mul_le_mul_of_nonneg_left h₃ hC).trans_eq (by ring)))
  obtain ⟨g, hgm, hg, he, hbnd⟩ :=
    exists_bounded_density (R μ) σ (b * C) (mul_nonneg hb.le hC) hdom
  exact ⟨g, hgm, hg, he, hbnd⟩

theorem density_L1_operator_bound (R : FiniteSignedMeasure Ω →L[ℝ] FiniteSignedMeasure Ω)
    {σ : Measure Ω} {f g : Ω → ℝ} (hf : Integrable f σ) (hg : Integrable g σ)
    (he : ofDensity hg = R (ofDensity hf)) :
    (∫ x, ‖g x‖ ∂σ) ≤
      measureOperatorNorm (E := FiniteSignedMeasure Ω) R * (∫ x, ‖f x‖ ∂σ) := by
  have hh := measureOperatorNorm_bound (E := FiniteSignedMeasure Ω) R (ofDensity hf)
  calc
    (∫ x, ‖g x‖ ∂σ) = ‖ofDensity hg‖ := (norm_ofDensity hg).symm
    _ = ‖R (ofDensity hf)‖ := congrArg (fun μ : FiniteSignedMeasure Ω => ‖μ.1‖) he
    _ ≤ measureOperatorNorm (E := FiniteSignedMeasure Ω) R * ‖ofDensity hf‖ := hh
    _ = _ := congrArg (measureOperatorNorm (E := FiniteSignedMeasure Ω) R * ·) (norm_ofDensity hf)

end FiniteSignedMeasure

#print axioms FiniteSignedMeasure.bounded_density_endpoints
#print axioms FiniteSignedMeasure.density_L1_operator_bound

end DensityEndpoints



section ChangeProbabilityDensity

open MeasureTheory
open scoped ENNReal

namespace FiniteSignedMeasure

variable {Ω : Type*} [MeasurableSpace Ω]
  (ρ ν : Measure Ω) [IsProbabilityMeasure ρ] [IsProbabilityMeasure ν]
  (p : ℝ≥0∞) [Fact (1 ≤ p)]

private theorem change_density_exists (hp : p ≠ ∞) (C : ℝ) (hC : 0 < C)
    (hρν : ρ ≤ ENNReal.ofReal C • ν) (a : Lp ℝ p ρ) :
    ∃ b : Lp ℝ p ν, densityMap b = densityMap a ∧
      ((fun x => b x) =ᵐ[ν] fun x => (ρ.rnDeriv ν x).toReal • a x) ∧
      ‖b‖ ≤ C ^ (1 - 1 / p.toReal) * ‖a‖ := by
  have hac : ρ ≪ ν := Measure.absolutelyContinuous_of_le_smul hρν
  let h := ρ.rnDeriv ν
  have hmeas : Measurable h := ρ.measurable_rnDeriv ν
  have hh : h ≤ᵐ[ν] fun _ => ENNReal.ofReal C := by
    apply ae_le_of_forall_setLIntegral_le_of_sigmaFinite hmeas
    intro s hs _
    rw [lintegral_const, Measure.restrict_apply_univ]
    exact (Measure.setLIntegral_rnDeriv_le (μ := ρ) (ν := ν) s).trans (hρν s)
  let f (x : Ω) := (h x).toReal • a x
  have hmf : Measurable f := hmeas.ennreal_toReal.smul (Lp.stronglyMeasurable a).measurable
  let r := p.toReal
  have hp₁ : 1 ≤ p := Fact.out
  have hp₀ : p ≠ 0 := ne_of_gt (zero_lt_one.trans_le hp₁)
  have hr₁ : 1 ≤ r := by
    simpa only [ENNReal.toReal_one] using ENNReal.toReal_mono hp hp₁
  have hr₀ : 0 ≤ r := zero_le_one.trans hr₁
  let w := ENNReal.ofReal C ^ (r - 1)
  let g (x : Ω) : ℝ≥0∞ := ‖a x‖ₑ ^ r
  have hgm : Measurable g := (Lp.stronglyMeasurable a).measurable.eNorm.pow_const _
  have hpow :
      (∫⁻ x, ‖f x‖ₑ ^ r ∂ν) ≤ w * ∫⁻ x, g x ∂ρ := by
    have hInt := lintegral_const_mul (μ := ν) w
      (show Measurable (fun x => ρ.rnDeriv ν x * g x) from hmeas.mul hgm)
    rw [← lintegral_rnDeriv_mul hac hgm.aemeasurable, ← hInt]
    apply lintegral_mono_ae
    filter_upwards [hh] with x hx
    have hx' : h x ≠ ∞ := (hx.trans_lt ENNReal.ofReal_lt_top).ne
    have he : ‖(h x).toReal‖ₑ = h x := by
      rw [← ofReal_norm, Real.norm_of_nonneg ENNReal.toReal_nonneg, ENNReal.ofReal_toReal hx']
    calc
      ‖f x‖ₑ ^ r = (h x) ^ r * g x := by
        change ‖(h x).toReal • a x‖ₑ ^ r = _
        rw [eNorm_smul, he, ENNReal.mul_rpow_of_nonneg _ _ hr₀]
      _ = (h x) ^ (r - 1) * (h x * g x) := by
        nth_rw 1 [show r = (r - 1) + 1 from (sub_add_cancel r 1).symm]
        rw [ENNReal.rpow_add_of_nonneg _ _ (sub_nonneg.mpr hr₁) zero_le_one,
          ENNReal.rpow_one, mul_assoc]
      _ ≤ w * (h x * g x) :=
        mul_le_mul_of_nonneg_right (ENNReal.rpow_le_rpow hx (sub_nonneg.mpr hr₁)) bot_le
  have hw : w ≠ ∞ :=
    ENNReal.rpow_ne_top_of_nonneg (sub_nonneg.mpr hr₁) ENNReal.ofReal_ne_top
  have hwr : w ^ (1/r) ≠ ∞ := ENNReal.rpow_ne_top_of_nonneg (by positivity) hw
  have hb := ENNReal.rpow_le_rpow hpow (by positivity : 0 ≤ 1 / r)
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
    ← eLpNorm_eq_lintegral_rpow_eNorm_toReal hp₀ hp hmf.aestronglyMeasurable] at hb
  have ha' : (∫⁻ x, g x ∂ρ) ^ (1/r) = eLpNorm a p ρ :=
    (eLpNorm_eq_lintegral_rpow_eNorm_toReal hp₀ hp (Lp.stronglyMeasurable a).aestronglyMeasurable).symm
  rw [ha'] at hb
  have hbfin := ENNReal.mul_ne_top hwr (Lp.memLp a).eLpNorm_ne_top
  have hf : MemLp f p ν := hb.trans_lt hbfin.lt_top
  let b := hf.toLp f
  have hbf : (fun x => b x) =ᵐ[ν] f := hf.coeFn_toLp
  refine ⟨b, ?_, hbf, ?_⟩
  · apply FiniteSignedMeasure.ext
    intro E
    rw [eval_densityMap, eval_densityMap, integral_congr_ae (ae_restrict_le hbf)]
    exact setIntegral_rnDeriv_smul hac E.2
  · rw [Lp.norm_def, eLpNorm_congr_ae hbf, Lp.norm_def]
    refine (ENNReal.toReal_mono hbfin hb).trans_eq ?_
    rw [ENNReal.toReal_mul, ← ENNReal.toReal_rpow, show w = ENNReal.ofReal C ^ (r-1) from rfl,
      ← ENNReal.toReal_rpow, ENNReal.toReal_ofReal hC.le, ← Real.rpow_mul hC.le]
    rw [show (r - 1) * (1 / r) = 1 - 1 / r by field_simp]

/-- The connecting map is multiplication by the Radon–Nikodym density.
The pointwise norm bound is the one in the manuscript, part (ii). -/
theorem exists_density_change_map (hp : p ≠ ∞) (C : ℝ) (hC : 0 < C)
    (hρν : ρ ≤ ENNReal.ofReal C • ν) :
    ∃ j : Lp ℝ p ρ →L[ℝ] Lp ℝ p ν, (∀ a, densityMap (j a) = densityMap a) ∧
      (∀ a, (fun x => j a x) =ᵐ[ν] fun x => (ρ.rnDeriv ν x).toReal • a x) ∧
      ∀ a, ‖j a‖ ≤ C ^ (1 - 1 / p.toReal) * ‖a‖ := by
  choose b hb hbf hbn using change_density_exists ρ ν p hp C hC hρν
  let j : Lp ℝ p ρ →L[ℝ] Lp ℝ p ν :=
    LinearMap.mkContinuous
      { toFun := b
        map_add' := fun x y => by
          apply densityMap_injective (p := p) (ρ := ν)
          rw [hb, map_add (densityMap (ρ := ρ)), map_add (densityMap (ρ := ν)), hb, hb]
        map_smul' := fun c x => by
          apply densityMap_injective (p := p) (ρ := ν)
          simp only [map_smul, hb]
          rfl }
      (C ^ (1 - 1 / p.toReal)) hbn
  exact ⟨j, hb, hbf, hbn⟩

end FiniteSignedMeasure

#print axioms FiniteSignedMeasure.exists_density_change_map

end ChangeProbabilityDensity



section QuotientConnectingNorm

namespace MeasureDensityStage

variable {Ω X M Y Z : Type*} [MeasurableSpace Ω]
  [NormedAddCommGroup X] [NormedSpace ℝ X]
  [NormedAddCommGroup M] [NormedSpace ℝ M]
  [NormedAddCommGroup Y] [NormedSpace ℝ Y]
  [NormedAddCommGroup Z] [NormedSpace ℝ Z]
  {P : PVM Ω M} {S : M →L[ℝ] X} {T : X →L[ℝ] M}

theorem norm_connectingMap_le (Q : MeasureDensityStage P S T Y)
    (Q' : MeasureDensityStage P S T Z)
    (j : Y →L[ℝ] Z) (hj : ∀ a, Q'.density (j a) = Q.density a)
    (C : ℝ) (hC : 0 ≤ C) (hjn : ∀ a, ‖j a‖ ≤ C * ‖a‖)
    (x : Q.Quotient) :
    ‖Q.connectingMap Q' j hj x‖ ≤ C * ‖x‖ := by
  refine le_of_forall_pos_le_add fun ε hε => ?_
  let δ := ε / (C + 1)
  have hδ : 0 < δ := div_pos hε (by positivity)
  obtain ⟨a, ha, han⟩ := Submodule.Quotient.norm_mk_lt x hδ
  change Q.synthesis a = x at ha
  have hε' : C * δ ≤ ε := by
    have hd : δ * (C + 1) = ε := by
      dsimp [δ]
      exact div_mul_cancel₀ _ (by positivity)
    nlinarith [hδ.le]
  calc
    _ = ‖Q'.synthesis (j a)‖ := by rw [← ha, (Q.connectingMap_diagrams Q' j hj).1 a]
    _ ≤ ‖j a‖ := Submodule.Quotient.norm_mk_le Q'.synthesisToOriginal.ker (j a)
    _ ≤ C * ‖a‖ := hjn a
    _ ≤ C * (‖x‖ + δ) := mul_le_mul_of_nonneg_left han.le hC
    _ ≤ C * ‖x‖ + ε := by rw [mul_add]; gcongr

end MeasureDensityStage

#print axioms MeasureDensityStage.norm_connectingMap_le

end QuotientConnectingNorm



section ChangeDensityL1

open MeasureTheory
open scoped ENNReal
namespace FiniteSignedMeasure

variable {Ω : Type*} [MeasurableSpace Ω]
  {ρ ν : Measure Ω} [IsProbabilityMeasure ρ] [IsProbabilityMeasure ν]

theorem densityMap_norm_one (a : Lp ℝ (1 : ℝ≥0∞) ρ) :
    ‖densityMap a‖ = ‖a‖ := by
  have hf := integrable_Lp a
  rw [show ‖densityMap a‖ = ‖ofDensity hf‖ from rfl, norm_ofDensity, Lp.norm_def,
    eLpNorm_one_eq_lintegral_eNorm hf.aestronglyMeasurable, ← ofReal_integral_norm_eq_lintegral_eNorm hf,
    ENNReal.toReal_ofReal (integral_nonneg fun _ => norm_nonneg _)]

theorem density_change_isometry_one
    (j : Lp ℝ (1 : ℝ≥0∞) ρ →L[ℝ] Lp ℝ (1 : ℝ≥0∞) ν)
    (hj : ∀ a, densityMap (j a) = densityMap a) : Isometry j := by
  apply Isometry.of_dist_eq
  intro a b
  rw [dist_eq_norm, dist_eq_norm, ← map_sub j,
    ← densityMap_norm_one (j (a-b)), hj, densityMap_norm_one]

end FiniteSignedMeasure

#print axioms FiniteSignedMeasure.density_change_isometry_one

end ChangeDensityL1



section ProbabilityLpRestriction

open MeasureTheory
open scoped ENNReal

namespace FiniteSignedMeasure

variable {Ω : Type*} [MeasurableSpace Ω]
  {p : ℝ≥0∞} [Fact (1 ≤ p)] {ρ : Measure Ω} [IsProbabilityMeasure ρ]

private noncomputable def lpCutFun (E : MeasSet Ω) (a : Lp ℝ p ρ) : Lp ℝ p ρ :=
  ((Lp.memLp a).indicator E.2.nullMeasurableSet).toLp (E.1.indicator a)

omit [Fact (1 ≤ p)] [IsProbabilityMeasure ρ] in
private theorem lpCutFun_ae (E : MeasSet Ω) (a : Lp ℝ p ρ) :
    (fun x => lpCutFun E a x) =ᵐ[ρ] E.1.indicator a :=
  MemLp.coeFn_toLp ((Lp.memLp a).indicator E.2.nullMeasurableSet)

private theorem densityMap_lpCutFun (E : MeasSet Ω) (a : Lp ℝ p ρ) :
    densityMap (lpCutFun E a) = cut E (densityMap a) := by
  have ha := integrable_Lp a
  have he : densityMap (lpCutFun E a) = ofDensity (ha.indicator E.2) :=
    ofDensity_congr (integrable_Lp (lpCutFun E a)) (ha.indicator E.2) (lpCutFun_ae E a)
  exact he.trans (cut_ofDensity ha E).symm

/-- Multiplication by a measurable indicator on probability Lp, with the
restriction identity in the signed-measure representation. -/
noncomputable def lpCut (E : MeasSet Ω) : Lp ℝ p ρ →L[ℝ] Lp ℝ p ρ :=
  LinearMap.mkContinuous
    { toFun := lpCutFun E
      map_add' := by
        intro a b
        apply densityMap_injective (ρ := ρ) (p := p)
        rw [densityMap_lpCutFun, map_add (densityMap (ρ := ρ)), map_add (cut E),
          map_add (densityMap (ρ := ρ)), densityMap_lpCutFun, densityMap_lpCutFun]
      map_smul' := by
        intro c a
        apply densityMap_injective (ρ := ρ) (p := p)
        simp only [densityMap_lpCutFun, map_smul]
        rfl }
    1 (fun a => by
      change ‖lpCutFun E a‖ ≤ 1 * ‖a‖
      rw [one_mul, Lp.norm_def, Lp.norm_def, eLpNorm_congr_ae (lpCutFun_ae E a)]
      exact ENNReal.toReal_mono (Lp.memLp a).eLpNorm_ne_top
        (eLpNorm_indicator_le a E.2.nullMeasurableSet))

theorem lpCut_ae (E : MeasSet Ω) (a : Lp ℝ p ρ) :
    (fun x => lpCut E a x) =ᵐ[ρ] E.1.indicator a :=
  lpCutFun_ae E a

theorem densityMap_lpCut (E : MeasSet Ω) (a : Lp ℝ p ρ) :
    densityMap (lpCut E a) = cut E (densityMap a) :=
  densityMap_lpCutFun E a

end FiniteSignedMeasure

#print axioms FiniteSignedMeasure.densityMap_lpCut

end ProbabilityLpRestriction



section ResolventProbabilityDomination

open MeasureTheory
open scoped ENNReal

namespace FiniteSignedMeasure

variable {Ω : Type*} [MeasurableSpace Ω]
  {V : FiniteSignedMeasure Ω →L[ℝ] FiniteSignedMeasure Ω}

/-- The two presentations of bounded domination for the probabilities
used to index the local quotient spaces. -/
theorem resolventBase_le_smul_iff
    (ρ ν : resolventProbabilities {x | Positive x} V) {c : ℝ} (hc : 0 ≤ c) :
    resolventBase ρ ≤ ENNReal.ofReal c • resolventBase ν ↔
      Positive (c • ν.1 - ρ.1) := by
  rw [Measure.le_iff]
  have he (m : resolventProbabilities {x | Positive x} V) (E : MeasSet Ω) :
      resolventBase m E.1 = ENNReal.ofReal (eval E m.1) :=
    toMeasure_apply m.1 m.2.1 E
  constructor
  · intro h E
    have hd := h E.1 E.2
    rw [smul_apply, smul_eq_mul, he ρ E, he ν E, ← ENNReal.ofReal_mul hc] at hd
    change 0 ≤ eval E (c • ν.1 - ρ.1)
    rw [map_sub (eval E), map_smul (eval E), smul_eq_mul, sub_nonneg]
    exact (ENNReal.ofReal_le_ofReal_iff (mul_nonneg hc (ν.2.1 E))).mp hd
  · intro h A hA
    let E : MeasSet Ω := ⟨A, hA⟩
    change resolventBase ρ E.1 ≤ (ENNReal.ofReal c • resolventBase ν) E.1
    rw [smul_apply, smul_eq_mul, he ρ E, he ν E, ← ENNReal.ofReal_mul hc]
    apply ENNReal.ofReal_le_ofReal
    have hh := h E
    change 0 ≤ eval E (c • ν.1 - ρ.1) at hh
    rwa [map_sub (eval E), map_smul (eval E), smul_eq_mul, sub_nonneg] at hh

end FiniteSignedMeasure

#print axioms FiniteSignedMeasure.resolventBase_le_smul_iff

end ResolventProbabilityDomination



section ProbabilityLpPVM

open MeasureTheory
open scoped ENNReal

namespace FiniteSignedMeasure

variable {Ω : Type*} [MeasurableSpace Ω]
  {p : ℝ≥0∞} [Fact (1 ≤ p)] {ρ : Measure Ω} [IsProbabilityMeasure ρ]

private theorem lpCut_hasSum (hp : p ≠ ∞) (D : ℕ → MeasSet Ω) (hD : MeasSet.DisjointSeq D)
    (a : Lp ℝ p ρ) : HasSum (fun n => lpCut (D n) a) (lpCut (MeasSet.iUnion D) a) := by
  let U := MeasSet.iUnion D
  let F (I : Finset ℕ) := MeasSet.finiteUnion D I
  let r := p.toReal
  have hp₁ : 1 ≤ p := Fact.out
  have hp₀ : p ≠ 0 := ne_of_gt (zero_lt_one.trans_le hp₁)
  have hr₁ : 1 ≤ r := by
    simpa only [ENNReal.toReal_one] using ENNReal.toReal_mono hp hp₁
  have hr : 0 < r := zero_lt_one.trans_le hr₁
  have ha := (Lp.memLp a).integrable_norm_rpow hp₀ hp
  let m := densityCharge ha
  have hm : m.CountablyAdditive := fun B hB =>
    hasSum_integral_iUnion (fun n => (B n).2) hB ha.integrableOn
  have hsub (I : Finset ℕ) : (F I).1 ⊆ U.1 := by
    intro x hx
    obtain ⟨n, _, hn⟩ := mem_iUnion₂.mp hx
    exact mem_iUnion.mpr ⟨n, hn⟩
  have htail : Tendsto (fun I : Finset ℕ => m.val (U.diff (F I))) atTop (𝓝 0) := by
    have hs : Tendsto (fun I : Finset ℕ => ∑ n ∈ I, m.val (D n)) atTop
      (𝓝 (m.val U)) := hm D hD
    have h := (tendsto_const_nhds (x := m.val U)).sub hs
    have he (I : Finset ℕ) : m.val (U.diff (F I)) =
        m.val U - ∑ n ∈ I, m.val (D n) := by
      rw [← m.finite_add D hD I, m.add_diff U (F I) (hsub I)]
      ring
    simpa only [← he, sub_self] using h
  have hnorm (E : MeasSet Ω) : ‖lpCut E a‖ = (m.val E) ^ (1/r) := by
    have hAi : AEStronglyMeasurable (E.1.indicator a) ρ :=
      (Lp.stronglyMeasurable a).aestronglyMeasurable.indicator E.2
    rw [Lp.norm_def, eLpNorm_congr_ae (lpCut_ae E a),
      eLpNorm_eq_lintegral_rpow_eNorm_toReal hp₀ hp hAi, ← ENNReal.toReal_rpow]
    have he (x : Ω) : ‖E.1.indicator a x‖ₑ ^ r =
        E.1.indicator (fun t => ENNReal.ofReal (‖a t‖ ^ r)) x := by
      by_cases hx : x ∈ E.1
      · rw [Set.indicator_of_mem hx, Set.indicator_of_mem hx,
          ← ofReal_norm, ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hr.le]
      · have hz : E.1.indicator (fun t => a t) x = 0 := Set.indicator_of_notMem hx _
        have hz' : E.1.indicator (fun t => ENNReal.ofReal (‖a t‖ ^ r)) x = 0 :=
          Set.indicator_of_notMem hx _
        rw [hz, hz', eNorm_zero, ENNReal.zero_rpow_of_pos hr]
    have hEq : (∫⁻ x, ‖E.1.indicator a x‖ₑ ^ r ∂ρ) =
        ∫⁻ x, E.1.indicator (fun t => ENNReal.ofReal (‖a t‖ ^ r)) x ∂ρ :=
      lintegral_congr he
    change (∫⁻ x, ‖E.1.indicator a x‖ₑ ^ r ∂ρ).toReal ^ (1/r) = _
    rw [hEq, lintegral_indicator E.2,
      ← ofReal_integral_eq_lintegral_ofReal ha.restrict (ae_of_all _ fun _ => Real.rpow_nonneg (norm_nonneg _) _),
      ENNReal.toReal_ofReal (integral_nonneg fun _ => Real.rpow_nonneg (norm_nonneg _) _)]
    rfl
  have hfinite (I : Finset ℕ) : ∑ n ∈ I, lpCut (D n) a = lpCut (F I) a := by
    apply densityMap_injective (ρ := ρ) (p := p)
    rw [map_sum, densityMap_lpCut]
    simp_rw [densityMap_lpCut]
    exact ((restrictionPVM Ω).toOVM.apply_finite_union D hD I (densityMap a)).symm
  have htk (I : Finset ℕ) :
      lpCut (F I) a - lpCut U a = -lpCut (U.diff (F I)) a := by
    apply Lp.ext
    filter_upwards [Lp.coeFn_sub (lpCut (F I) a) (lpCut U a),
      Lp.coeFn_neg (lpCut (U.diff (F I)) a), lpCut_ae (F I) a, lpCut_ae U a,
      lpCut_ae (U.diff (F I)) a] with x hs hn hF hU hUF
    rw [hs, hn]
    change lpCut (F I) a x - lpCut U a x = -lpCut (U.diff (F I)) a x
    rw [hF, hU, hUF]
    by_cases hx : x ∈ (F I).1
    · simp [Set.indicator, hx, hsub I hx, MeasSet.diff]
    · by_cases hu : x ∈ U.1 <;> simp [Set.indicator, hx, hu, MeasSet.diff]
  have hh : Tendsto (fun I : Finset ℕ => (m.val (U.diff (F I))) ^ (1/r)) atTop (𝓝 0) := by
    have h := (Real.continuousAt_rpow_const 0 (1/r) (.inr (by positivity))).tendsto.comp htail
    simpa only [Function.comp_def, Real.zero_rpow (ne_of_gt (by positivity : 0 < 1/r))] using h
  change Tendsto (fun I : Finset ℕ => ∑ n ∈ I, lpCut (D n) a) atTop (𝓝 (lpCut U a))
  refine tendsto_iff_norm_sub_tendsto_zero.mpr ?_
  simp_rw [hfinite, htk, norm_neg, hnorm]
  exact hh

/-- The concrete normalized multiplication PVM on each probability Lp. -/
noncomputable def probabilityLpPVM (hp : p ≠ ∞) : PVM Ω (Lp ℝ p ρ) where
  val := lpCut
  empty_eq := by
    apply ContinuousLinearMap.ext
    intro a
    apply densityMap_injective (ρ := ρ) (p := p)
    rw [densityMap_lpCut, zero_apply, map_zero]
    exact congrArg (fun L : FiniteSignedMeasure Ω →L[ℝ] FiniteSignedMeasure Ω =>
      L (densityMap a)) (restrictionPVM Ω).empty_eq
  normalized := by
    apply ContinuousLinearMap.ext
    intro a
    apply densityMap_injective (ρ := ρ) (p := p)
    rw [densityMap_lpCut, ContinuousLinearMap.id_apply]
    exact congrArg (fun L : FiniteSignedMeasure Ω →L[ℝ] FiniteSignedMeasure Ω =>
      L (densityMap a)) (restrictionPVM Ω).normalized
  mul_eq E F := by
    apply ContinuousLinearMap.ext
    intro a
    apply densityMap_injective (ρ := ρ) (p := p)
    rw [ContinuousLinearMap.comp_apply, densityMap_lpCut, densityMap_lpCut, densityMap_lpCut]
    exact congrArg (fun L : FiniteSignedMeasure Ω →L[ℝ] FiniteSignedMeasure Ω =>
      L (densityMap a)) ((restrictionPVM Ω).mul_eq E F)
  countably_additive := lpCut_hasSum hp

end FiniteSignedMeasure

#print axioms FiniteSignedMeasure.probabilityLpPVM

end ProbabilityLpPVM



section ProbabilityLpCyclic

open MeasureTheory
open scoped ENNReal

namespace FiniteSignedMeasure

variable {Ω : Type*} [MeasurableSpace Ω]
  {p : ℝ≥0∞} [Fact (1 ≤ p)] {ρ : Measure Ω} [IsProbabilityMeasure ρ]

/-- The generator in the manuscript is the constant-one density. -/
theorem probabilityLpPVM_cyclic (hp : p ≠ ∞) :
    (probabilityLpPVM (ρ := ρ) hp).Cyclic := by
  let u := indicatorConstLp p MeasurableSet.univ (measure_ne_top ρ univ) (1 : ℝ)
  let P := probabilityLpPVM (ρ := ρ) hp
  refine ⟨u, ?_⟩
  let W := Submodule.span ℝ (Set.range fun E : MeasSet Ω => P.val E u)
  have hu : (fun x => u x) =ᵐ[ρ] fun _ => (1 : ℝ) := by
    have h : (fun x => u x) =ᵐ[ρ] univ.indicator (fun _ => (1 : ℝ)) :=
      indicatorConstLp_coeFn
    simpa only [Set.indicator_univ] using h
  have hconst (c : ℝ) (E : MeasSet Ω) :
      indicatorConstLp p E.2 (measure_ne_top ρ E.1) c = c • P.val E u := by
    change indicatorConstLp p E.2 (measure_ne_top ρ E.1) c = c • lpCut E u
    apply Lp.ext
    filter_upwards [indicatorConstLp_coeFn (p := p) (hs := E.2)
        (hμs := measure_ne_top ρ E.1) (c := c),
      Lp.coeFn_smul c (lpCut E u), lpCut_ae E u, hu] with x h1 h2 h3 h4
    rw [h1, h2]
    change E.1.indicator (fun _ => c) x = c • lpCut E u x
    rw [h3]
    by_cases hx : x ∈ E.1 <;> simp [Set.indicator, hx, h4]
  have hsimple (f : Lp.simpleFunc ℝ p ρ) : (f : Lp ℝ p ρ) ∈ W := by
    have hp₀ : p ≠ 0 := ne_of_gt (zero_lt_one.trans_le (Fact.out : 1 ≤ p))
    apply Lp.simpleFunc.induction hp₀ hp (P := fun f => (f : Lp ℝ p ρ) ∈ W) _ _ f
    · intro c E hE hEfin
      let A : MeasSet Ω := ⟨E, hE⟩
      change indicatorConstLp p A.2 (measure_ne_top ρ A.1) c ∈ W
      rw [hconst c A]
      exact W.smul_mem c (Submodule.subset_span ⟨A, rfl⟩)
    · intro f g hf hg _ hfW hgW
      exact W.add_mem hfW hgW
  change Dense (W : Set (Lp ℝ p ρ))
  exact (Lp.simpleFunc.dense hp).mono (fun f hf => hsimple ⟨f, hf⟩)

end FiniteSignedMeasure

#print axioms FiniteSignedMeasure.probabilityLpPVM_cyclic

end ProbabilityLpCyclic



section ProbabilityLpInterpolation

open MeasureTheory
open scoped ENNReal

local instance : Fact (1 ≤ (⊤ : ℝ≥0∞)) := ⟨le_top⟩

variable {Ω : Type*} [MeasurableSpace Ω] {σ : Measure Ω} [IsProbabilityMeasure σ]

/-- The inclusion of essentially bounded functions into finite-exponent spaces
over a probability measure. -/
noncomputable def probabilityLpFromTop (p : ℝ≥0∞) (a : Lp ℝ ⊤ σ) : Lp ℝ p σ :=
  ((Lp.memLp a).mono_exponent le_top).toLp a

theorem probabilityLpFromTop_ae (p : ℝ≥0∞) (a : Lp ℝ ⊤ σ) :
    (fun x => probabilityLpFromTop p a x) =ᵐ[σ] fun x => a x :=
  MemLp.coeFn_toLp _

private theorem probabilityLpFromTop_dense (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≠ ⊤) :
    DenseRange (probabilityLpFromTop (σ := σ) p) := by
  apply (Lp.simpleFunc.denseRange (E := ℝ) (μ := σ) hp).mono
  rintro x ⟨a, rfl⟩
  let f := Lp.simpleFunc.toSimpleFunc a
  have hf : f =ᵐ[σ] (fun t => (a : Lp ℝ p σ) t) :=
    Lp.simpleFunc.toSimpleFunc_eq_toFun a
  obtain ⟨C, hC⟩ : ∃ C : ℝ, ∀ t, ‖f t‖ ≤ C := by
    have hfin : (Set.range (fun t => ‖f t‖)).Finite := by
      apply (f.finite_range.image norm).subset
      rintro _ ⟨t, rfl⟩
      exact ⟨f t, ⟨t, rfl⟩, rfl⟩
    obtain ⟨C, hC⟩ := hfin.bddAbove
    exact ⟨C, fun t => hC (Set.mem_range_self t)⟩
  let b : Lp ℝ ⊤ σ := (memLp_top_of_bound f.measurable.aestronglyMeasurable C
    (Eventually.of_forall hC)).toLp f
  refine ⟨b, Lp.ext ((probabilityLpFromTop_ae p b).trans ?_)⟩
  exact (MemLp.coeFn_toLp _).trans hf

/-- Riesz–Thorin on one probability space at the equal-exponent endpoints
`(1,1)` and `(∞,∞)`. The real formulation follows by complexifying the
operator: the two equal-exponent endpoint bounds persist under complexification.
The conclusion includes agreement on the common domain. -/
axiom citeRieszThorinProbabilityLp
    (A : Lp ℝ ⊤ σ →L[ℝ] Lp ℝ ⊤ σ) (M₁ Mtop : ℝ)
    (h₁ : 0 ≤ M₁) (htop : 0 ≤ Mtop)
    (bound₁ : ∀ a, ‖probabilityLpFromTop 1 (A a)‖ ≤ M₁ * ‖probabilityLpFromTop 1 a‖)
    (boundTop : ∀ a, ‖A a‖ ≤ Mtop * ‖a‖)
    (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≠ ⊤) :
    ∃ B : Lp ℝ p σ →L[ℝ] Lp ℝ p σ,
      ‖B‖ ≤ M₁ ^ (1 / p.toReal) * Mtop ^ (1 - 1 / p.toReal) ∧
      ∀ a, B (probabilityLpFromTop p a) = probabilityLpFromTop p (A a)

/-- Canonical bidual reflexivity for real probability Lp, the usual
duality corollary for `1 < p < ∞`. -/
axiom citeProbabilityLpReflexive (p : ℝ≥0∞) [Fact (1 ≤ p)]
    (hp₁ : 1 < p) (hpTop : p ≠ ⊤) : IsReflexive (Lp ℝ p σ)

private theorem measureOperatorNorm_nonneg' {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] (R : E →L[ℝ] E) : 0 ≤ measureOperatorNorm R :=
  norm_nonneg R

namespace FiniteSignedMeasure

local instance : TopologicalSpace (MeasSet Ω × MeasSet Ω) := ⊥
local instance : Nonempty (MeasSet Ω × MeasSet Ω) := ⟨(MeasSet.empty, MeasSet.empty)⟩

private theorem densityMap_fromTop (p : ℝ≥0∞) [Fact (1 ≤ p)] (a : Lp ℝ ⊤ σ) :
    densityMap (probabilityLpFromTop p a) = densityMap a :=
  ofDensity_congr (integrable_Lp _) (integrable_Lp _) (probabilityLpFromTop_ae p a)

omit [IsProbabilityMeasure σ] in
private theorem ae_norm_le_Linfty (a : Lp ℝ ⊤ σ) :
    ∀ᵐ x ∂σ, ‖a x‖ ≤ ‖a‖ := by
  have hfin := (Lp.memLp a).eLpNorm_ne_top
  filter_upwards [ae_le_eLpNormEssSup (f := fun x => a x)] with x hx
  rw [Lp.norm_def]
  have h : ‖a x‖ₑ ≤ eLpNorm a ⊤ σ := by
    rwa [eLpNorm_exponent_top (Lp.memLp a).aestronglyMeasurable]
  simpa only [← ofReal_norm, ENNReal.toReal_ofReal (norm_nonneg _)] using
    ENNReal.toReal_mono hfin h

omit [IsProbabilityMeasure σ] in
private theorem norm_toLinfty_le {f : Ω → ℝ} (hf : MemLp f ⊤ σ)
    {C : ℝ} (hC : 0 ≤ C) (hbound : ∀ᵐ x ∂σ, ‖f x‖ ≤ C) : ‖hf.toLp f‖ ≤ C := by
  rw [Lp.norm_toLp, eLpNorm_exponent_top hf.aestronglyMeasurable]
  calc
    _ ≤ (ENNReal.ofReal C).toReal :=
      ENNReal.toReal_mono ENNReal.ofReal_ne_top (eLpNormEssSup_le_of_ae_bound hbound)
    _ = C := ENNReal.toReal_ofReal hC

/-- The bounded-density operator on L∞, including the endpoints used
in interpolation. -/
private theorem exists_Linfty_density_operator
    {V R : FiniteSignedMeasure Ω →L[ℝ] FiniteSignedMeasure Ω}
    (hV : ∀ ⦃μ⦄, Positive μ → Positive (V μ))
    (hR : ∀ μ, Positive (V (modulus μ) - modulus (R μ)))
    (ρ : resolventProbabilities {x | Positive x} V) {b : ℝ} (hb : 0 < b)
    (hρ : Positive (b • ρ.1 - V ρ.1)) :
    ∃ A : Lp ℝ ⊤ (resolventBase ρ) →L[ℝ] Lp ℝ ⊤ (resolventBase ρ),
      (∀ a, densityMap (A a) = R (densityMap a)) ∧ ∀ a, ‖A a‖ ≤ b * ‖a‖ := by
  have hex (a : Lp ℝ ⊤ (resolventBase ρ)) :
      ∃ z : Lp ℝ ⊤ (resolventBase ρ),
        densityMap z = R (densityMap a) ∧ ‖z‖ ≤ b * ‖a‖ := by
    obtain ⟨f, _, hf, he, hn⟩ := bounded_density_endpoints hV hR ρ.1 (resolventBase ρ)
      (resolventBase_real ρ) hb hρ (integrable_Lp a) ‖a‖ (norm_nonneg _) (ae_norm_le_Linfty a)
    let ht := memLp_top_of_bound hf.aestronglyMeasurable (b * ‖a‖) hn
    refine ⟨ht.toLp f, ?_, norm_toLinfty_le ht (mul_nonneg hb.le (norm_nonneg _)) hn⟩
    exact (ofDensity_congr (integrable_Lp (ht.toLp f)) hf (MemLp.coeFn_toLp ht)).trans he
  choose z he hn using hex
  let A : Lp ℝ ⊤ (resolventBase ρ) →L[ℝ] Lp ℝ ⊤ (resolventBase ρ) :=
    LinearMap.mkContinuous
      { toFun := z
        map_add' := fun a c => by
          apply densityMap_injective (p := ⊤) (ρ := resolventBase ρ)
          simp only [he, map_add]
        map_smul' := fun c a => by
          apply densityMap_injective (p := ⊤) (ρ := resolventBase ρ)
          simp only [he, map_smul, RingHom.id_apply] }
      b hn
  exact ⟨A, he, hn⟩

/-- The density operator (R_\rho) and the exact interpolation constant
in eq:measure-density-bound. Agreement on L∞ extends to every Lp input
by density and continuity of the signed-measure embedding. -/
theorem exists_interpolated_density_operator
    {V R : FiniteSignedMeasure Ω →L[ℝ] FiniteSignedMeasure Ω}
    (hV : ∀ ⦃μ⦄, Positive μ → Positive (V μ))
    (hR : ∀ μ, Positive (V (modulus μ) - modulus (R μ)))
    (ρ : resolventProbabilities {x | Positive x} V) {b : ℝ} (hb : 0 < b)
    (hρ : Positive (b • ρ.1 - V ρ.1))
    (M : ℝ) (hM : 0 ≤ M) (hRM : ∀ μ, ‖(R μ).1‖ ≤ M * ‖μ.1‖)
    (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≠ ⊤) :
    ∃ B : Lp ℝ p (resolventBase ρ) →L[ℝ] Lp ℝ p (resolventBase ρ),
      (∀ a, densityMap (B a) = R (densityMap a)) ∧
      ‖B‖ ≤ M ^ (1 / p.toReal) *
        b ^ (1 - 1 / p.toReal) := by
  obtain ⟨A, hA, hAtop⟩ := exists_Linfty_density_operator hV hR ρ hb hρ
  have hA₁ (a : Lp ℝ ⊤ (resolventBase ρ)) :
      ‖probabilityLpFromTop 1 (A a)‖ ≤ M * ‖probabilityLpFromTop 1 a‖ := by
    rw [← densityMap_norm_one, ← densityMap_norm_one, densityMap_fromTop, densityMap_fromTop,
      hA]
    exact hRM (densityMap a)
  obtain ⟨B, hn, hB⟩ := citeRieszThorinProbabilityLp A M b hM hb.le hA₁ hAtop p hp
  let K : Set (Lp ℝ p (resolventBase ρ)) := {a | densityMap (B a) = R (densityMap a)}
  have hclosed : IsClosed K := isClosed_eq
    ((densityMap (p := p)).continuous.comp B.continuous)
    (R.continuous.comp (densityMap (p := p)).continuous)
  have hrange : Set.range (probabilityLpFromTop (σ := resolventBase ρ) p) ⊆ K := by
    rintro _ ⟨x, rfl⟩
    change densityMap (B (probabilityLpFromTop p x)) = R (densityMap (probabilityLpFromTop p x))
    rw [hB, densityMap_fromTop, densityMap_fromTop, hA]
  exact ⟨B, fun a => closure_minimal hrange hclosed
    (probabilityLpFromTop_dense (σ := resolventBase ρ) p hp a), hn⟩


set_option maxHeartbeats 1000000 in
/-- The operator norm supplies the L¹ interpolation bound. Keeping the
ambient endomorphism as an explicit argument also makes the bound
available before any quotient-space structures are introduced. -/
private theorem exists_interpolated_density_operator_sharp
    {V : FiniteSignedMeasure Ω →L[ℝ] FiniteSignedMeasure Ω}
    (R : FiniteSignedMeasure Ω →L[ℝ] FiniteSignedMeasure Ω)
    (hV : ∀ ⦃μ⦄, Positive μ → Positive (V μ))
    (hR : ∀ μ, Positive (V (modulus μ) - modulus (R μ)))
    (ρ : resolventProbabilities {x | Positive x} V) {b : ℝ} (hb : 0 < b)
    (hρ : Positive (b • ρ.1 - V ρ.1))
    (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≠ ⊤) :
    let M := measureOperatorNorm (E := FiniteSignedMeasure Ω) R
    ∃ B : Lp ℝ p (resolventBase ρ) →L[ℝ] Lp ℝ p (resolventBase ρ),
      (∀ a, densityMap (B a) = R (densityMap a)) ∧
      ‖B‖ ≤ M ^ (1 / p.toReal) * b ^ (1 - 1 / p.toReal) := by
  have hn := measureOperatorNorm_nonneg' (E := FiniteSignedMeasure Ω) R
  have hRM := measureOperatorNorm_bound (E := FiniteSignedMeasure Ω) R
  exact exists_interpolated_density_operator (V := V) (R := R) hV hR ρ hb hρ _ hn hRM p hp


end FiniteSignedMeasure

#print axioms FiniteSignedMeasure.exists_interpolated_density_operator

end ProbabilityLpInterpolation



section ConcreteMeasureInductiveDilation

open MeasureTheory
open scoped ENNReal

namespace FiniteSignedMeasure

variable {Ω X : Type*} [MeasurableSpace Ω] [NormedAddCommGroup X] [NormedSpace ℝ X]

local instance : TopologicalSpace (MeasSet Ω × MeasSet Ω) := ⊥
local instance : Nonempty (MeasSet Ω × MeasSet Ω) := ⟨(MeasSet.empty, MeasSet.empty)⟩

/-- The countable directedness of the actual probability measures, ordered
by bounded domination. -/
theorem resolventBases_countablyDirected
    (V : FiniteSignedMeasure Ω →L[ℝ] FiniteSignedMeasure Ω)
    (hV : ∀ ⦃μ⦄, Positive μ → Positive (V μ))
    (s : ℕ → resolventProbabilities {x | Positive x} V) :
    ∃ ρ : resolventProbabilities {x | Positive x} V, ∀ n,
      ∃ c : ℝ, 0 < c ∧ resolventBase (s n) ≤ ENNReal.ofReal c • resolventBase ρ := by
  obtain ⟨τ, hτ, k, hk, hd⟩ := (resolvent_family V hV).2 (fun n => (s n).1)
    (fun n => (s n).2.1) (fun n => (mass_eq_norm_of_positive (s n).2.1).trans (s n).2.2.1)
  refine ⟨⟨τ, hτ⟩, fun n => ?_⟩
  have hkpos : 0 < k := zero_lt_one.trans_le hk
  let c : ℝ := 2^(n+1) * k
  have hc : 0 < c := by dsimp [c]; positivity
  exact ⟨c, hc, (resolventBase_le_smul_iff (s n) ⟨τ, hτ⟩ hc.le).mpr (hd n)⟩

variable (S : FiniteSignedMeasure Ω →L[ℝ] X) (T : X →L[ℝ] FiniteSignedMeasure Ω)
  {V : FiniteSignedMeasure Ω →L[ℝ] FiniteSignedMeasure Ω}
  (hV : ∀ ⦃μ⦄, Positive μ → Positive (V μ))
  (hR : ∀ μ, Positive (V (modulus μ) - modulus ((T.comp S) μ)))
  (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≠ ⊤)
  (ρ : resolventProbabilities {x | Positive x} V)

set_option maxHeartbeats 1000000 in
include hV hR hp in
private theorem exists_stage_projection :
    ∃ B : Lp ℝ p (resolventBase ρ) →L[ℝ] Lp ℝ p (resolventBase ρ),
      ∀ a, densityMap (B a) = T (S (densityMap a)) := by
  obtain ⟨b, hb, hρ⟩ := ρ.2.2.2
  obtain ⟨B, hB, _⟩ := exists_interpolated_density_operator_sharp (V := V) (T.comp S) hV hR ρ hb hρ p hp
  exact ⟨B, fun a => hB a⟩

/-- The canonical density embedding and indicator PVM together with the
interpolated local projection. Its quotient is exactly LocalMeasureQuotient. -/
noncomputable def resolventDensityStage :
    MeasureDensityStage (restrictionPVM Ω) S T (Lp ℝ p (resolventBase ρ)) where
  density := densityMap
  density_injective := densityMap_injective
  multiplication := probabilityLpPVM hp
  one := Classical.choose (probabilityLpPVM_cyclic (p := p) (ρ := resolventBase ρ) hp)
  cyclic_one := Classical.choose_spec (probabilityLpPVM_cyclic (p := p) (ρ := resolventBase ρ) hp)
  density_cut := densityMap_lpCut
  localProjection := Classical.choose (exists_stage_projection S T hV hR p hp ρ)
  density_projection := Classical.choose_spec (exists_stage_projection S T hV hR p hp ρ)

set_option maxHeartbeats 1000000 in
theorem resolventDensityStage_norm {b : ℝ} (hb : 0 < b)
    (hρ : Positive (b • ρ.1 - V ρ.1)) :
    ‖(resolventDensityStage S T hV hR p hp ρ).localProjection‖ ≤
      measureOperatorNorm (E := FiniteSignedMeasure Ω) (T.comp S) ^ (1 / p.toReal) *
        b ^ (1 - 1 / p.toReal) := by
  let Q := resolventDensityStage S T hV hR p hp ρ
  obtain ⟨B, hB, hn⟩ := exists_interpolated_density_operator_sharp (V := V) (T.comp S) hV hR ρ hb hρ p hp
  have he : Q.localProjection = B := by
    apply ContinuousLinearMap.ext
    intro a
    apply densityMap_injective (p := p) (ρ := resolventBase ρ)
    exact (Q.density_projection a).trans (hB a).symm
  change ‖Q.localProjection‖ ≤ _
  rwa [he]

/-- The stage inclusion has exactly the quotient presentation used in
the global norm and topology statements. -/
theorem resolventDensityStage_inclusion_canonical :
    (resolventDensityStage S T hV hR p hp ρ).inclusion = localToOriginal S p ρ := rfl

/-- Part (i), with the dilation on the exact quotient used in norm
recovery and with the canonical bidual reflexivity assertion. -/
theorem resolventDensityStage_local_dilation (hST : ∀ x, S (T x) = x) :
    let Q := resolventDensityStage S T hV hR p hp ρ
    Q.localOVM.Normalized ∧ (Q.localDilation hST).P.Cyclic ∧
      (∀ E x, Q.inclusion (Q.localOVM.val E x) =
        ((restrictionPVM Ω).compressed S T).val E (Q.inclusion x)) ∧
      (∀ x, densityMap (Q.analysis x) = T (Q.inclusion x)) ∧
      (1 < p → IsReflexive (Lp ℝ p (resolventBase ρ))) := by
  let Q := resolventDensityStage S T hV hR p hp ρ
  exact ⟨Q.multiplication.compressed_normalized Q.synthesis Q.analysis (Q.synthesis_analysis hST),
    Q.localDilation_cyclic hST, Q.inclusion_intertwines, Q.density_analysis,
    fun h => citeProbabilityLpReflexive p h hp⟩

/-- Part (ii), the actual Radon–Nikodym coordinate map and its induced
quotient map, with the synthesis, analysis and localization diagrams. -/
theorem resolventDensityStage_compatible
    (ν : resolventProbabilities {x | Positive x} V) {c : ℝ} (hc : 0 < c)
    (hdom : Positive (c • ν.1 - ρ.1)) :
    let Q := resolventDensityStage S T hV hR p hp ρ
    let Q' := resolventDensityStage S T hV hR p hp ν
    ∃ (j : Lp ℝ p (resolventBase ρ) →L[ℝ] Lp ℝ p (resolventBase ν))
      (i : Q.Quotient →L[ℝ] Q'.Quotient),
      (∀ a, (fun x => j a x) =ᵐ[resolventBase ν]
        fun x => ((resolventBase ρ).rnDeriv (resolventBase ν) x).toReal • a x) ∧
      (∀ a, ‖j a‖ ≤ c ^ (1 - 1 / p.toReal) * ‖a‖) ∧
      (∀ x, ‖i x‖ ≤ c ^ (1 - 1 / p.toReal) * ‖x‖) ∧
      (∀ a, i (Q.synthesis a) = Q'.synthesis (j a)) ∧
      (∀ x, Q'.inclusion (i x) = Q.inclusion x) ∧
      (∀ x, Q'.analysis (i x) = j (Q.analysis x)) ∧
      ∀ E a, j (Q.multiplication.val E a) = Q'.multiplication.val E (j a) := by
  obtain ⟨j, hj, hformula, hnorm⟩ := exists_density_change_map
    (resolventBase ρ) (resolventBase ν) p hp c hc
    ((resolventBase_le_smul_iff ρ ν hc.le).mpr hdom)
  let Q := resolventDensityStage S T hV hR p hp ρ
  let Q' := resolventDensityStage S T hV hR p hp ν
  let i := Q.connectingMap Q' j hj
  have hni := Q.norm_connectingMap_le Q' j hj _ (Real.rpow_nonneg hc.le _) hnorm
  obtain ⟨hs, hi, ha, hcut⟩ := Q.connectingMap_diagrams Q' j hj
  exact ⟨j, i, hformula, hnorm, hni, hs, hi, ha, hcut⟩

end FiniteSignedMeasure

#print axioms FiniteSignedMeasure.resolventBases_countablyDirected
#print axioms FiniteSignedMeasure.resolventDensityStage_norm
#print axioms FiniteSignedMeasure.resolventDensityStage_inclusion_canonical
#print axioms FiniteSignedMeasure.resolventDensityStage_local_dilation
#print axioms FiniteSignedMeasure.resolventDensityStage_compatible

end ConcreteMeasureInductiveDilation



section MeasureInductiveTheorem

open MeasureTheory
open scoped ENNReal

namespace FiniteSignedMeasure

variable {Ω X : Type*} [MeasurableSpace Ω] [Nonempty Ω]
  [NormedAddCommGroup X] [NormedSpace ℝ X]

local instance : TopologicalSpace (MeasSet Ω × MeasSet Ω) := ⊥
local instance : Nonempty (MeasSet Ω × MeasSet Ω) := ⟨(MeasSet.empty, MeasSet.empty)⟩

set_option maxHeartbeats 800000 in
/-- Manuscript, thm:measure-inductive-dilation. One family works for every
finite p, including the local dilations, the connecting maps, and the
recovery of the norm and locally convex topology. -/
theorem measure_inductive_dilation
    (S : FiniteSignedMeasure Ω →L[ℝ] X) (T : X →L[ℝ] FiniteSignedMeasure Ω)
    (hST : ∀ x, S (T x) = x) (hS : ∀ μ, ‖S μ‖ ≤ ‖μ‖)
    (hrep : ∀ x : X, ∀ ε > 0, ∃ μ, S μ = x ∧ ‖μ‖ < ‖x‖ + ε) :
    ∃ (V : FiniteSignedMeasure Ω →L[ℝ] FiniteSignedMeasure Ω)
      (hV : ∀ ⦃μ⦄, Positive μ → Positive (V μ))
      (hR : ∀ μ, Positive (V (modulus μ) - modulus ((T.comp S) μ))),
      (restrictionPVM Ω |>.compressed S T).Normalized ∧
      (∀ s : ℕ → resolventProbabilities {x | Positive x} V,
        ∃ ρ : resolventProbabilities {x | Positive x} V, ∀ n,
          ∃ c : ℝ, 0 < c ∧ resolventBase (s n) ≤ ENNReal.ofReal c • resolventBase ρ) ∧
      ∀ (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≠ ⊤),
        let Q := fun ρ : resolventProbabilities {x | Positive x} V =>
          resolventDensityStage S T hV hR p hp ρ
        (∀ ρ : resolventProbabilities {x | Positive x} V,
          (Q ρ).localOVM.Normalized ∧ ((Q ρ).localDilation hST).P.Cyclic ∧
          (∀ E x, (Q ρ).inclusion ((Q ρ).localOVM.val E x) =
            ((restrictionPVM Ω).compressed S T).val E ((Q ρ).inclusion x)) ∧
          (∀ x, densityMap ((Q ρ).analysis x) = T ((Q ρ).inclusion x)) ∧
          (1 < p → IsReflexive (Lp ℝ p (resolventBase ρ)))) ∧
        (∀ (ρ ν : resolventProbabilities {x | Positive x} V) (c : ℝ), 0 < c →
          Positive (c • ν.1 - ρ.1) →
          ∃ (j : Lp ℝ p (resolventBase ρ) →L[ℝ] Lp ℝ p (resolventBase ν))
            (i : (Q ρ).Quotient →L[ℝ] (Q ν).Quotient),
            (∀ a, (fun x => j a x) =ᵐ[resolventBase ν]
              fun x => ((resolventBase ρ).rnDeriv (resolventBase ν) x).toReal • a x) ∧
            (∀ a, ‖j a‖ ≤ c ^ (1 - 1 / p.toReal) * ‖a‖) ∧
            (∀ x, ‖i x‖ ≤ c ^ (1 - 1 / p.toReal) * ‖x‖) ∧
            (∀ a, i ((Q ρ).synthesis a) = (Q ν).synthesis (j a)) ∧
            (∀ x, (Q ν).inclusion (i x) = (Q ρ).inclusion x) ∧
            (∀ x, (Q ν).analysis (i x) = j ((Q ρ).analysis x)) ∧
            ∀ E a, j ((Q ρ).multiplication.val E a) = (Q ν).multiplication.val E (j a)) ∧
        (∀ x : X,
          (∃ (ρ : resolventProbabilities {ν | Positive ν} V) (z : LocalMeasureQuotient S p ρ),
            localToOriginal S p ρ z = x) ∧
          ‖x‖ = sInf {r : ℝ | ∃ (ρ : resolventProbabilities {ν | Positive ν} V)
            (z : LocalMeasureQuotient S p ρ), localToOriginal S p ρ z = x ∧ ‖z‖ = r}) ∧
        (∀ q : Seminorm ℝ X, Continuous q ↔
          ∀ ρ : resolventProbabilities {ν | Positive ν} V,
            Continuous (fun z : LocalMeasureQuotient S p ρ => q (localToOriginal S p ρ z))) := by
  obtain ⟨V, hV, _, hR⟩ := exists_positive_majorant (T.comp S)
  refine ⟨V, hV, hR, (restrictionPVM Ω).compressed_normalized S T hST,
    resolventBases_countablyDirected V hV, ?_⟩
  intro p _ hp
  exact ⟨fun ρ => resolventDensityStage_local_dilation S T hV hR p hp ρ hST,
    fun ρ ν _ hc hdom => resolventDensityStage_compatible S T hV hR p hp ρ ν hc hdom,
    measureQuotient_norm_recovery S p hp hV hS hrep,
    measureQuotient_seminorm_continuous_iff V hV S p hp hrep⟩

end FiniteSignedMeasure

#print axioms FiniteSignedMeasure.measure_inductive_dilation

end MeasureInductiveTheorem



section ContinuousFrameDefinition

open MeasureTheory
open scoped ENNReal

variable {Ω X : Type*} [MeasurableSpace Ω] [NormedAddCommGroup X] [NormedSpace ℝ X]

/-- Pettis integrability, expressed by the scalar integrals on all cuts. -/
def PettisIntegrable (η : Measure Ω) (H : Ω → X) : Prop :=
  (∀ g : Dual X, Measurable (fun t => g (H t)) ∧ Integrable (fun t => g (H t)) η) ∧
  ∀ E : MeasSet Ω, ∃ y : X, ∀ g : Dual X,
    g y = ∫ t in E.1, g (H t) ∂η

/-- The real continuous Schauder frame of the manuscript §5. -/
structure ContinuousSchauderFrame (η : Measure Ω) where
  vector : Ω → X
  functional : Ω → Dual X
  weaklyMeasurable : ∀ g : Dual X, Measurable (fun t => g (vector t))
  weakStarMeasurable : ∀ x : X, Measurable (fun t => functional t x)
  pettis : ∀ x : X, PettisIntegrable η (fun t => functional t x • vector t)
  reconstruction : ∀ (x : X) (g : Dual X),
    g x = ∫ t, functional t x * g (vector t) ∂η

namespace ContinuousSchauderFrame

variable {η : Measure Ω} (F : ContinuousSchauderFrame (X := X) η)

private theorem coefficient_integrable (x : X) (g : Dual X) :
    Integrable (fun t => F.functional t x * g (F.vector t)) η := by
  simpa only [map_smul, smul_eq_mul] using ((F.pettis x).1 g).2

/-- The unique Pettis integral on a measurable cut. -/
noncomputable def cutValue (E : MeasSet Ω) (x : X) : X :=
  Classical.choose ((F.pettis x).2 E)

theorem eval_cutValue (E : MeasSet Ω) (x : X) (g : Dual X) :
    g (F.cutValue E x) = ∫ t in E.1, F.functional t x * g (F.vector t) ∂η := by
  simpa only [map_smul, smul_eq_mul] using (show g (F.cutValue E x) = _ from Classical.choose_spec ((F.pettis x).2 E) g)

theorem cutValue_whole (x : X) : F.cutValue MeasSet.whole x = x := by
  apply eq_of_dual_eval
  intro g
  rw [F.eval_cutValue, F.reconstruction]
  exact setIntegral_univ

theorem cutValue_empty (x : X) : F.cutValue MeasSet.empty x = 0 := by
  apply eq_of_dual_eval
  intro g
  rw [F.eval_cutValue, map_zero]
  exact setIntegral_empty

/-- Strong countable additivity of the cutwise Pettis integral. -/
theorem cutValue_hasSum [CompleteSpace X] (D : ℕ → MeasSet Ω)
    (hD : MeasSet.DisjointSeq D) (x : X) :
    HasSum (fun n => F.cutValue (D n) x) (F.cutValue (MeasSet.iUnion D) x) := by
  let U (b : ℕ → Bool) (n : ℕ) := if b n then D n else MeasSet.empty
  have h (b : ℕ → Bool) (g : Dual X) :
      HasSum (fun n => if b n then g (F.cutValue (D n) x) else 0)
        (g (F.cutValue (MeasSet.iUnion (U b)) x)) := by
    have hU : MeasSet.DisjointSeq (U b) := by
      intro i j hij
      dsimp [U]
      split <;> split
      · exact hD hij
      all_goals simp [MeasSet.empty]
    have hs := hasSum_integral_iUnion (fun n => (U b n).2) hU
      (F.coefficient_integrable x g).integrableOn
    have he (n : ℕ) : (if b n then g (F.cutValue (D n) x) else 0) =
        ∫ t in (U b n).1, F.functional t x * g (F.vector t) ∂η := by
      cases hb : b n <;> simp [U, hb, F.eval_cutValue, MeasSet.empty]
    rw [show (fun n => if b n then g (F.cutValue (D n) x) else 0) = _ from funext he,
      F.eval_cutValue]
    exact hs
  simpa only [U, ite_true] using hasSum_of_weak_subseries
    (fun n => F.cutValue (D n) x)
    (fun b => F.cutValue (MeasSet.iUnion (U b)) x) h

private theorem coefficient_memLp (x : X) (g : Dual X) :
    MemLp (fun t => F.functional t x * g (F.vector t)) 1 η :=
  memLp_one_iff_integrable.mpr (F.coefficient_integrable x g)

private noncomputable def scalarAnalysisLinear (g : Dual X) : X →ₗ[ℝ] Lp ℝ 1 η where
  toFun x := (F.coefficient_memLp x g).toLp
    (fun t => F.functional t x * g (F.vector t))
  map_add' x y := by
    apply Lp.ext
    filter_upwards [Lp.coeFn_add ((F.coefficient_memLp x g).toLp _)
      ((F.coefficient_memLp y g).toLp _),
      MemLp.coeFn_toLp (F.coefficient_memLp (x + y) g),
      MemLp.coeFn_toLp (F.coefficient_memLp x g),
      MemLp.coeFn_toLp (F.coefficient_memLp y g)] with t ha hxy hx hy
    change _ = ((F.coefficient_memLp x g).toLp _ : Lp ℝ 1 η) t +
      ((F.coefficient_memLp y g).toLp _ : Lp ℝ 1 η) t at ha
    rw [ha, hxy, hx, hy, map_add, add_mul]
  map_smul' c x := by
    apply Lp.ext
    filter_upwards [Lp.coeFn_smul c ((F.coefficient_memLp x g).toLp _),
      MemLp.coeFn_toLp (F.coefficient_memLp (c • x) g),
      MemLp.coeFn_toLp (F.coefficient_memLp x g)] with t ha hcx hx
    change _ = ((c • (F.coefficient_memLp x g).toLp _) : Lp ℝ 1 η) t
    change _ = c * ((F.coefficient_memLp x g).toLp _ : Lp ℝ 1 η) t at ha
    rw [ha, hcx, hx, map_smul (F.functional t), smul_eq_mul, mul_assoc]

private theorem scalarAnalysisLinear_ae (x : X) (g : Dual X) :
    (fun t => F.scalarAnalysisLinear g x t) =ᵐ[η]
      fun t => F.functional t x * g (F.vector t) :=
  MemLp.coeFn_toLp (F.coefficient_memLp x g)

/-- The closed-graph step for (x\mapsto f_t(x)g(x_t)) in (L^1). -/
noncomputable def scalarAnalysis [CompleteSpace X] (g : Dual X) : X →L[ℝ] Lp ℝ 1 η :=
  ContinuousLinearMap.ofSeqClosedGraph (g := F.scalarAnalysisLinear g) (by
    intro u x y hu hy
    obtain ⟨v, hv, hlim⟩ := (tendstoInMeasure_of_tendsto_Lp hy).exists_seq_tendsto_ae
    have hall : ∀ᵐ t ∂η, ∀ n : ℕ, F.scalarAnalysisLinear g (u (v n)) t =
        F.functional t (u (v n)) * g (F.vector t) :=
      ae_all_iff.mpr fun n => F.scalarAnalysisLinear_ae (u (v n)) g
    apply Lp.ext
    filter_upwards [hlim, hall, F.scalarAnalysisLinear_ae x g] with t ht he hx
    have hp := (((F.functional t).continuous.tendsto x).comp (hu.comp hv.tendsto_atTop)).mul
      (tendsto_const_nhds (x := g (F.vector t)))
    have hq : Tendsto (fun n => F.scalarAnalysisLinear g (u (v n)) t)
        atTop (𝓝 (F.functional t x * g (F.vector t))) := by
      have hfun : (fun n => F.scalarAnalysisLinear g (u (v n)) t) =
          fun n => F.functional t (u (v n)) * g (F.vector t) := funext he
      rw [hfun]
      exact hp
    exact (tendsto_nhds_unique ht hq).trans hx.symm)

end ContinuousSchauderFrame

#print axioms ContinuousSchauderFrame.eval_cutValue
#print axioms ContinuousSchauderFrame.cutValue_hasSum
#print axioms ContinuousSchauderFrame.scalarAnalysis

end ContinuousFrameDefinition



section FrameOperatorMeasure

open MeasureTheory

namespace ContinuousSchauderFrame

variable {Ω X : Type*} [MeasurableSpace Ω] [NormedAddCommGroup X] [NormedSpace ℝ X]
  [CompleteSpace X] {η : Measure Ω} (F : ContinuousSchauderFrame (X := X) η)

private noncomputable def cutLinear (E : MeasSet Ω) : X →ₗ[ℝ] X where
  toFun := F.cutValue E
  map_add' x y := by
    apply eq_of_dual_eval
    intro g
    rw [map_add, F.eval_cutValue, F.eval_cutValue, F.eval_cutValue]
    simp_rw [map_add, add_mul]
    exact integral_add (F.coefficient_integrable x g).restrict
      (F.coefficient_integrable y g).restrict
  map_smul' c x := by
    apply eq_of_dual_eval
    intro g
    rw [map_smul, F.eval_cutValue, F.eval_cutValue]
    simp_rw [map_smul, RingHom.id_apply, smul_eq_mul, mul_assoc]
    exact integral_const_mul _ _

private theorem norm_eval_cut_le (E : MeasSet Ω) (x : X) (g : Dual X) :
    ‖g (F.cutValue E x)‖ ≤ ‖F.scalarAnalysis g‖ * ‖x‖ := by
  let f (t : Ω) := F.functional t x * g (F.vector t)
  have hf : Integrable f η := F.coefficient_integrable x g
  have he : ‖F.scalarAnalysis g x‖ = ∫ t, ‖f t‖ ∂η := by
    change ‖(F.coefficient_memLp x g).toLp f‖ = _
    rw [Lp.norm_toLp, eLpNorm_one_eq_lintegral_eNorm hf.aestronglyMeasurable,
      ← ofReal_integral_norm_eq_lintegral_eNorm hf,
      ENNReal.toReal_ofReal (integral_nonneg fun _ => norm_nonneg _)]
  rw [F.eval_cutValue]
  change ‖∫ t in E.1, f t ∂η‖ ≤ _
  have hh : ‖∫ t in E.1, f t ∂η‖ ≤ ∫ t, ‖f t‖ ∂η :=
    (norm_integral_le_integral_norm f).trans
      (setIntegral_le_integral hf.norm (ae_of_all _ fun _ => norm_nonneg _))
  exact hh.trans (he ▸ (F.scalarAnalysis g).le_opNorm x)

/-- Uniform boundedness on the dual gives boundedness of the Pettis
reconstruction maps, with a single bound for all measurable cuts. -/
private theorem cutLinear_bound :
    ∃ C : ℝ, ∀ E x, ‖F.cutLinear E x‖ ≤ C * ‖x‖ := by
  let A := MeasSet Ω × {x : X // ‖x‖ ≤ 1}
  obtain ⟨C, hC⟩ := banach_steinhaus (g := fun a : A => J (F.cutValue a.1 a.2.1))
    (fun g => ⟨‖F.scalarAnalysis g‖, fun a => by
      change ‖g (F.cutValue a.1 a.2.1)‖ ≤ _
      exact (F.norm_eval_cut_le a.1 _ g).trans
        ((mul_le_mul_of_nonneg_left a.2.2 (norm_nonneg _)).trans_eq (mul_one _))⟩)
  refine ⟨C, fun E x => ?_⟩
  by_cases hx : x = 0
  · rw [hx, map_zero, norm_zero, mul_zero]
  · have hxpos : 0 < ‖x‖ := norm_pos_iff.mpr hx
    let y := ‖x‖⁻¹ • x
    have hy : ‖y‖ ≤ 1 := by
      change ‖‖x‖⁻¹ • x‖ ≤ 1
      rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr hxpos.le), inv_mul_cancel₀ hxpos.ne']
    have hyx : ‖x‖ • y = x := by
      change ‖x‖ • (‖x‖⁻¹ • x) = x
      rw [smul_smul, mul_inv_cancel₀ hxpos.ne', one_smul]
    have h := hC (E, ⟨y, hy⟩)
    change ‖J (F.cutValue E y)‖ ≤ C at h
    rw [norm_J] at h
    change ‖F.cutLinear E y‖ ≤ C at h
    calc
      ‖F.cutLinear E x‖ = ‖F.cutLinear E (‖x‖ • y)‖ :=
        congrArg (fun z => ‖F.cutLinear E z‖) hyx.symm
      _ = ‖x‖ * ‖F.cutLinear E y‖ := by
        rw [map_smul, norm_smul, Real.norm_of_nonneg (norm_nonneg x)]
      _ ≤ C * ‖x‖ := by
        rw [mul_comm C]
        exact mul_le_mul_of_nonneg_left h (norm_nonneg x)

/-- The normalized, strongly countably additive OVM induced by a
continuous Schauder frame, the first assertion of prop:frame-dilation. -/
noncomputable def operatorMeasure : OVM Ω X where
  val E := (F.cutLinear E).mkContinuous F.cutLinear_bound.choose
    (F.cutLinear_bound.choose_spec E)
  empty_eq := by
    ext x
    exact F.cutValue_empty x
  countably_additive D hD x := F.cutValue_hasSum D hD x

theorem operatorMeasure_normalized : F.operatorMeasure.Normalized := by
  ext x
  exact F.cutValue_whole x

theorem operatorMeasure_coeff (E : MeasSet Ω) (x : X) (g : Dual X) :
    g (F.operatorMeasure.val E x) = ∫ t in E.1, F.functional t x * g (F.vector t) ∂η :=
  F.eval_cutValue E x g

end ContinuousSchauderFrame

#print axioms ContinuousSchauderFrame.operatorMeasure
#print axioms ContinuousSchauderFrame.operatorMeasure_normalized
#print axioms ContinuousSchauderFrame.operatorMeasure_coeff

end FrameOperatorMeasure



section FrameDiscretizationCorrection

variable {Ω X : Type*} [MeasurableSpace Ω] [NormedAddCommGroup X] [NormedSpace ℝ X]
  [CompleteSpace X]

/-- A real unconditional Schauder frame is specified by its synthesis
series converging over all finite subsets. -/
def IsUnconditionalSchauderFrame (y : ℕ → X) (g : ℕ → Dual X) : Prop :=
  ∀ x : X, HasSum (fun n => g n x • y n) x

/-- The invertible correction at the end of cor:frame-discretization.
The input estimate is the sum of the operator-norm errors on the cells. -/
theorem OVM.discretization_correction (K : OVM Ω X) (hK : K.Normalized)
    (D : ℕ → MeasSet Ω) (hD : MeasSet.DisjointSeq D) (hcover : MeasSet.iUnion D = MeasSet.whole)
    (y : ℕ → X) (g : ℕ → Dual X)
    (hs : Summable (fun n => ‖(g n).smulRight (y n) - K.val (D n)‖))
    (hsmall : (∑' n, ‖(g n).smulRight (y n) - K.val (D n)‖) < 1) :
    ∃ (A : (X →L[ℝ] X)ˣ), (∀ x : X, HasSum (fun n => g n x • y n) ((A : X →L[ℝ] X) x)) ∧
      IsUnconditionalSchauderFrame (fun n => ((↑(A⁻¹) : X →L[ℝ] X) (y n))) g := by
  let e (n : ℕ) := (g n).smulRight (y n) - K.val (D n)
  let B := ∑' n, e n
  have hB : ‖B‖ < 1 := (norm_tsum_le_tsum_norm hs).trans_lt hsmall
  let A : X →L[ℝ] X := 1 + B
  have hA : IsUnit A := by
    have hb : ‖-B‖ < 1 := by rwa [norm_neg]
    simpa only [A, sub_neg_eq_add] using IsUnit.one_sub_of_norm_lt_one hb
  obtain ⟨u, hu⟩ := hA
  have hsum (x : X) : HasSum (fun n => g n x • y n) (A x) := by
    have hD' := K.countably_additive D hD x
    rw [hcover, hK] at hD'
    let L := ContinuousLinearMap.apply ℝ X x
    have he := L.hasSum (Summable.of_norm hs).hasSum
    change HasSum (fun n => e n x) (B x) at he
    have h := he.add hD'
    have hf (n : ℕ) : e n x + K.val (D n) x = g n x • y n := by
      change (g n x • y n - K.val (D n) x) + K.val (D n) x = _
      abel
    simp_rw [hf] at h
    have hAeq : A x = B x + (ContinuousLinearMap.id ℝ X) x := by
      change x + B x = B x + x
      exact add_comm _ _
    rwa [hAeq]
  refine ⟨u, fun x => hu.symm ▸ hsum x, fun x => ?_⟩
  let C : X →L[ℝ] X := ↑(u⁻¹)
  have hh := C.hasSum (hu.symm ▸ hsum x : HasSum (fun n => g n x • y n)
    ((u : X →L[ℝ] X) x))
  have hCx : C ((u : X →L[ℝ] X) x) = x := by
    change (C * (u : X →L[ℝ] X)) x = x
    have he : C * (u : X →L[ℝ] X) = 1 := by
      dsimp only [C]
      simp
    rw [he]
    rfl
  simpa only [map_smul, hCx, C] using hh

#print axioms OVM.discretization_correction

end FrameDiscretizationCorrection



section FrameVariation

open MeasureTheory
open scoped ENNReal

variable {Ω X : Type*} [MeasurableSpace Ω] [NormedAddCommGroup X] [NormedSpace ℝ X]

/-- The operator-norm variation from the manuscript, allowing +∞. The
finite index set gives the measurable cells of each partition. -/
noncomputable def OVM.operatorVariation (K : OVM Ω X) (E : MeasSet Ω) : ℝ≥0∞ :=
  sSup {r | ∃ (D : ℕ → MeasSet Ω) (I : Finset ℕ),
    (↑I : Set ℕ).Pairwise (fun i j => Disjoint (D i).1 (D j).1) ∧
    MeasSet.finiteUnion D I = E ∧
    r = ∑ n ∈ I, ENNReal.ofReal ‖K.val (D n)‖}

namespace ContinuousSchauderFrame

variable [CompleteSpace X] {η : Measure Ω} (F : ContinuousSchauderFrame (X := X) η)

/-- The rank-one envelope bounds the norm of the Pettis reconstruction
operator on each set on which the envelope is integrable. -/
theorem norm_operatorMeasure_cut_le (E : MeasSet Ω)
    (hE : IntegrableOn (fun t => ‖F.vector t‖ * ‖F.functional t‖) E.1 η) :
    ‖F.operatorMeasure.val E‖ ≤ ∫ t in E.1, ‖F.vector t‖ * ‖F.functional t‖ ∂η := by
  have hnon : 0 ≤ ∫ t in E.1, ‖F.vector t‖ * ‖F.functional t‖ ∂η :=
    integral_nonneg fun _ => mul_nonneg (norm_nonneg _) (norm_nonneg _)
  refine ContinuousLinearMap.opNorm_le_bound _ hnon fun x => ?_
  let y := F.operatorMeasure.val E x
  change ‖y‖ ≤ _
  by_cases hy : y = 0
  · rw [hy, norm_zero]
    exact mul_nonneg hnon (norm_nonneg x)
  · obtain ⟨g, hg, hgy⟩ := exists_dual_vector ℝ y (norm_ne_zero_iff.mpr hy)
    have hd := F.operatorMeasure_coeff E x g
    change g y = _ at hd
    rw [hgy] at hd
    change ‖y‖ = _ at hd
    rw [hd, ← integral_mul_const]
    have hfact (t : Ω) :
        F.functional t x * g (F.vector t) ≤ (‖F.vector t‖ * ‖F.functional t‖) * ‖x‖ := by
      calc
        _ ≤ ‖F.functional t x * g (F.vector t)‖ := le_abs_self _
        _ = ‖F.functional t x‖ * ‖g (F.vector t)‖ := norm_mul _ _
        _ ≤ (‖F.functional t‖ * ‖x‖) * (‖g‖ * ‖F.vector t‖) :=
          mul_le_mul ((F.functional t).le_opNorm x) (g.le_opNorm _) (norm_nonneg _) (by positivity)
        _ = _ := by rw [hg, one_mul]; ring
    exact integral_mono_ae (F.coefficient_integrable x g).restrict (hE.mul_const _)
      (ae_of_all _ hfact)

/-- The exact operator-norm variation estimate used in prop:frame-dilation. -/
theorem operatorVariation_le_integral (E : MeasSet Ω)
    (hE : IntegrableOn (fun t => ‖F.vector t‖ * ‖F.functional t‖) E.1 η) :
    F.operatorMeasure.operatorVariation E ≤
      ENNReal.ofReal (∫ t in E.1, ‖F.vector t‖ * ‖F.functional t‖ ∂η) := by
  apply sSup_le
  rintro r ⟨D, I, hD, hcover, rfl⟩
  let H (t : Ω) := ‖F.vector t‖ * ‖F.functional t‖
  have hsub (n : ℕ) (hn : n ∈ I) : (D n).1 ⊆ E.1 := by
    intro t ht
    rw [← hcover]
    exact mem_iUnion₂.mpr ⟨n, hn, ht⟩
  have hInt (n : ℕ) (hn : n ∈ I) : IntegrableOn H (D n).1 η :=
    hE.mono_set (hsub n hn)
  have hsum :
      (∑ n ∈ I, ∫ t in (D n).1, H t ∂η) = ∫ t in E.1, H t ∂η := by
    rw [← integral_biUnion_finset I (fun n _ => (D n).2) hD hInt]
    exact congrArg (fun A : MeasSet Ω => ∫ t in A.1, H t ∂η) hcover
  calc
    _ ≤ ∑ n ∈ I, ENNReal.ofReal (∫ t in (D n).1, H t ∂η) :=
      Finset.sum_le_sum (fun n hn => ENNReal.ofReal_le_ofReal
        (F.norm_operatorMeasure_cut_le (D n) (hInt n hn)))
    _ = _ := by
      have hnon (n : ℕ) : 0 ≤ ∫ t in (D n).1, H t ∂η :=
        integral_nonneg fun _ => mul_nonneg (norm_nonneg _) (norm_nonneg _)
      have hconv (J : Finset ℕ) :
          (∑ n ∈ J, ENNReal.ofReal (∫ t in (D n).1, H t ∂η)) =
            ENNReal.ofReal (∑ n ∈ J, ∫ t in (D n).1, H t ∂η) := by
        classical
        induction J using Finset.induction_on with
        | empty => simp
        | insert n J hn ih =>
          rw [Finset.sum_insert hn, Finset.sum_insert hn, ih,
            ENNReal.ofReal_add (hnon n) (Finset.sum_nonneg fun i _ => hnon i)]
      rw [hconv, hsum]

end ContinuousSchauderFrame

#print axioms ContinuousSchauderFrame.norm_operatorMeasure_cut_le
#print axioms ContinuousSchauderFrame.operatorVariation_le_integral

end FrameVariation



section FrameMeasurablePartition

open MeasureTheory
open scoped ENNReal

variable {Ω X : Type*} [MeasurableSpace Ω] [NormedAddCommGroup X] [NormedSpace ℝ X]

/-- Pettis's pointwise measurability theorem for a separable real Banach
space, as in van Neerven, Functional Analysis, Theorem 4.21. -/
axiom citePettisMeasurability [CompleteSpace X] [TopologicalSpace.SeparableSpace X] (f : Ω → X)
    (hf : ∀ g : Dual X, Measurable (fun t => g (f t))) :
    StronglyMeasurable f

variable [CompleteSpace X] [TopologicalSpace.SeparableSpace X]

namespace ContinuousSchauderFrame

variable {η : Measure Ω} (F : ContinuousSchauderFrame (X := X) η)

/-- The norms of the weak-star measurable coefficient functionals are
measurable, using countably many tests from the closed unit ball. -/
theorem measurable_functional_norm : Measurable (fun t => ‖F.functional t‖) := by
  let U := {x : X | ‖x‖ ≤ 1}
  let : Nonempty U := ⟨⟨0, by simp [U]⟩⟩
  let d : ℕ → U := TopologicalSpace.denseSeq U
  have hd : DenseRange d := TopologicalSpace.denseRange_denseSeq U
  have hnorm (g : Dual X) : ‖g‖ = ⨆ n, ‖g (d n : X)‖ := by
    have hbd (n : ℕ) : ‖g (d n : X)‖ ≤ ‖g‖ :=
      (g.le_opNorm _).trans ((mul_le_mul_of_nonneg_left (d n).2 (norm_nonneg g)).trans_eq (mul_one _))
    have hb : BddAbove (Set.range (fun n => ‖g (d n : X)‖)) := ⟨‖g‖, by
      rintro _ ⟨n, rfl⟩
      exact hbd n⟩
    let C : ℝ := ⨆ n, ‖g (d n : X)‖
    have hC (n : ℕ) : ‖g (d n : X)‖ ≤ C := le_ciSup hb n
    apply le_antisymm
    · apply ContinuousLinearMap.opNorm_le_of_unit_norm ((norm_nonneg _).trans (hC 0))
      intro x hx
      let z : U := ⟨x, hx.le⟩
      have hc : IsClosed {y : U | ‖g (y : X)‖ ≤ C} :=
        isClosed_le (g.continuous.comp continuous_subtype_val).norm continuous_const
      have hr : Set.range d ⊆ {y : U | ‖g (y : X)‖ ≤ C} := by
        rintro _ ⟨n, rfl⟩
        exact hC n
      exact closure_minimal hr hc (hd z)
    · exact ciSup_le hbd
  have he : (fun t => ‖F.functional t‖) = fun t => ⨆ n, ‖F.functional t (d n : X)‖ :=
    funext fun t => hnorm (F.functional t)
  rw [he]
  exact Measurable.iSup (fun n => (F.weakStarMeasurable (d n : X)).norm)

/-- The finite-measure and bounded-norm cells in prop:frame-dilation
are obtained by disjointifying a measurable exhaustion. -/
theorem exists_bounded_measurable_partition [SigmaFinite η] :
    ∃ D : ℕ → MeasSet Ω, MeasSet.DisjointSeq D ∧ MeasSet.iUnion D = MeasSet.whole ∧
      ∀ n, η (D n).1 < ∞ ∧ ∀ t ∈ (D n).1,
        ‖F.vector t‖ ≤ (n : ℝ) ∧ ‖F.functional t‖ ≤ (n : ℝ) := by
  let : MeasurableSpace X := borel X
  let : BorelSpace X := ⟨rfl⟩
  have hv := (citePettisMeasurability F.vector F.weaklyMeasurable).measurable.norm
  have hf := F.measurable_functional_norm
  let A (n : ℕ) : Set Ω := spanningSets η n ∩
    ({t | ‖F.vector t‖ ≤ (n : ℝ)} ∩ {t | ‖F.functional t‖ ≤ (n : ℝ)})
  have hA (n : ℕ) : MeasurableSet (A n) :=
    (measurableSet_spanningSets η n).inter
      ((measurableSet_le hv measurable_const).inter (measurableSet_le hf measurable_const))
  have hcover : ⋃ n, A n = univ := by
    ext t
    constructor
    · intro _
      exact mem_univ _
    · intro _
      have ht : t ∈ ⋃ n, spanningSets η n := by rw [iUnion_spanningSets]; exact mem_univ _
      obtain ⟨m, hm⟩ := mem_iUnion.mp ht
      obtain ⟨k, hk⟩ := exists_nat_ge (max ‖F.vector t‖ ‖F.functional t‖)
      have hmk : (k : ℝ) ≤ ((max m k : ℕ) : ℝ) := by exact_mod_cast le_max_right m k
      refine mem_iUnion.mpr ⟨max m k, spanningSets_mono (le_max_left m k) hm, ?_, ?_⟩
      · exact ((le_max_left _ _).trans hk).trans hmk
      · exact ((le_max_right _ _).trans hk).trans hmk
  let D (n : ℕ) : MeasSet Ω := ⟨disjointed A n, MeasurableSet.disjointed hA n⟩
  refine ⟨D, disjoint_disjointed A, Subtype.ext (iUnion_disjointed.trans hcover), fun n => ?_⟩
  have hsub : (D n).1 ⊆ A n := disjointed_subset A n
  refine ⟨(measure_mono (hsub.trans inter_subset_left)).trans_lt (measure_spanningSets_lt_top η n), ?_⟩
  exact fun t ht => (hsub ht).2

end ContinuousSchauderFrame

#print axioms ContinuousSchauderFrame.measurable_functional_norm
#print axioms ContinuousSchauderFrame.exists_bounded_measurable_partition

end FrameMeasurablePartition



section FrameSimpleApproximation

open MeasureTheory
open scoped ENNReal

namespace ContinuousSchauderFrame

variable {Ω X : Type*} [MeasurableSpace Ω] [NormedAddCommGroup X] [NormedSpace ℝ X]
  [CompleteSpace X] {η : Measure Ω} (F : ContinuousSchauderFrame (X := X) η)

omit [CompleteSpace X] in
private theorem integrableOn_functional_apply (E : MeasSet Ω)
    (hE : IntegrableOn (fun t => ‖F.functional t‖) E.1 η) (x : X) :
    IntegrableOn (fun t => F.functional t x) E.1 η :=
  (hE.mul_const ‖x‖).mono' (F.weakStarMeasurable x).aestronglyMeasurable
    (Eventually.of_forall fun t => (F.functional t).le_opNorm x)

/-- The bounded functional obtained by averaging the coefficients on one
measurable cell, as in cor:frame-discretization. -/
noncomputable def averageFunctional (E : MeasSet Ω)
    (hE : IntegrableOn (fun t => ‖F.functional t‖) E.1 η) : Dual X :=
  LinearMap.mkContinuous
    { toFun := fun x => ∫ t in E.1, F.functional t x ∂η
      map_add' := fun x y => by
        simp_rw [map_add]
        exact integral_add (F.integrableOn_functional_apply E hE x)
          (F.integrableOn_functional_apply E hE y)
      map_smul' := fun c x => by
        simp_rw [map_smul (F.functional _), RingHom.id_apply, smul_eq_mul]
        exact integral_const_mul _ _ }
    (∫ t in E.1, ‖F.functional t‖ ∂η)
    (fun x => by
      change ‖∫ t in E.1, F.functional t x ∂η‖ ≤ (∫ t in E.1, ‖F.functional t‖ ∂η) * ‖x‖
      rw [← integral_mul_const]
      refine (norm_integral_le_integral_norm _).trans ?_
      exact integral_mono_ae (F.integrableOn_functional_apply E hE x).norm (hE.mul_const _)
        (Eventually.of_forall fun t => (F.functional t).le_opNorm x))

omit [CompleteSpace X] in
theorem averageFunctional_apply (E : MeasSet Ω)
    (hE : IntegrableOn (fun t => ‖F.functional t‖) E.1 η) (x : X) :
    F.averageFunctional E hE x = ∫ t in E.1, F.functional t x ∂η := rfl

private def simpleCell (E : MeasSet Ω) (s : SimpleFunc Ω X) (y : X) : MeasSet Ω :=
  ⟨E.1 ∩ s ⁻¹' {y}, E.2.inter (s.measurableSet_fiber y)⟩

omit [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X] in
private theorem simpleCell_subset (E : MeasSet Ω) (s : SimpleFunc Ω X) (y : X) :
    (simpleCell E s y).1 ⊆ E.1 := inter_subset_left

/-- Synthesis with a finite-valued simple vector function. -/
noncomputable def simpleCutOperator (E : MeasSet Ω) (s : SimpleFunc Ω X)
    (hE : IntegrableOn (fun t => ‖F.functional t‖) E.1 η) : X →L[ℝ] X :=
  ∑ y ∈ s.range, (F.averageFunctional (simpleCell E s y)
    (hE.mono_set (simpleCell_subset E s y))).smulRight y

omit [CompleteSpace X] in
private theorem compact_smulRight (g : Dual X) (y : X) :
    IsCompactOperator (g.smulRight y) := by
  have h : IsCompactOperator ((ContinuousLinearMap.id ℝ ℝ).smulRight y : ℝ →L[ℝ] X) :=
    isCompactOperator_of_locallyCompactSpace_rng _
  convert h.comp_clm g using 1
  funext x
  rfl

omit [CompleteSpace X] in
theorem simpleCutOperator_compact (E : MeasSet Ω) (s : SimpleFunc Ω X)
    (hE : IntegrableOn (fun t => ‖F.functional t‖) E.1 η) :
    IsCompactOperator (F.simpleCutOperator E s hE) := by
  classical
  unfold simpleCutOperator
  generalize s.range = J
  induction J using Finset.induction_on with
  | empty =>
    rw [Finset.sum_empty]
    exact isCompactOperator_zero
  | insert y J hy ih =>
    rw [Finset.sum_insert hy]
    exact (compact_smulRight _ y).add ih

omit [CompleteSpace X] in
private theorem integrableOn_simple_coeff (E : MeasSet Ω) (s : SimpleFunc Ω X)
    (hE : IntegrableOn (fun t => ‖F.functional t‖) E.1 η) (x : X) (g : Dual X) :
    IntegrableOn (fun t => F.functional t x * g (s t)) E.1 η := by
  classical
  let D (y : X) := simpleCell E s y
  let f (t : Ω) := F.functional t x * g (s t)
  have hu : (⋃ y ∈ s.range, (D y).1) = E.1 := by
    ext t
    constructor
    · intro ht
      obtain ⟨y, _, hy⟩ := mem_iUnion₂.mp ht
      exact hy.1
    · intro ht
      exact mem_iUnion₂.mpr ⟨s t, s.mem_range_self t, ht, rfl⟩
  have hi (y : X) : IntegrableOn f (D y).1 η := by
    have h := (F.integrableOn_functional_apply (D y) (hE.mono_set inter_subset_left) x).mul_const (g y)
    apply IntegrableOn.congr_fun h _ (D y).2
    intro t ht
    change _ = F.functional t x * g (s t)
    rw [show s t = y from ht.2]
  rw [← hu]
  exact integrableOn_finset_iUnion.mpr fun y _ => hi y

omit [CompleteSpace X] in
/-- Scalar testing of the finite-rank approximant on each fiber of the
simple function. -/
theorem simpleCutOperator_coeff (E : MeasSet Ω) (s : SimpleFunc Ω X)
    (hE : IntegrableOn (fun t => ‖F.functional t‖) E.1 η) (x : X) (g : Dual X) :
    g (F.simpleCutOperator E s hE x) = ∫ t in E.1, F.functional t x * g (s t) ∂η := by
  classical
  let D (y : X) := simpleCell E s y
  let f (t : Ω) := F.functional t x * g (s t)
  have hd : Set.Pairwise (↑s.range : Set X) (fun y z => Disjoint (D y).1 (D z).1) := by
    intro y _ z _ hyz
    apply Set.disjoint_left.mpr
    intro t hty htz
    exact hyz ((show s t = y from hty.2).symm.trans (show s t = z from htz.2))
  have hu : (⋃ y ∈ s.range, (D y).1) = E.1 := by
    ext t
    constructor
    · intro ht
      obtain ⟨y, _, hy⟩ := mem_iUnion₂.mp ht
      exact hy.1
    · intro ht
      exact mem_iUnion₂.mpr ⟨s t, s.mem_range_self t, ht, rfl⟩
  have hi (y : X) : IntegrableOn f (D y).1 η := by
    have h := (F.integrableOn_functional_apply (D y) (hE.mono_set inter_subset_left) x).mul_const (g y)
    apply IntegrableOn.congr_fun h _ (D y).2
    intro t ht
    change _ = F.functional t x * g (s t)
    rw [show s t = y from ht.2]
  rw [← hu, integral_biUnion_finset s.range (fun y _ => (D y).2) hd (fun y _ => hi y)]
  unfold simpleCutOperator
  simp only [sum_apply, map_sum, ContinuousLinearMap.smulRight_apply, map_smul,
    smul_eq_mul]
  apply Finset.sum_congr rfl
  intro y _
  rw [averageFunctional_apply, ← integral_mul_const]
  apply setIntegral_congr_fun (D y).2
  intro t ht
  change F.functional t x * g y = F.functional t x * g (s t)
  rw [show s t = y from ht.2]

end ContinuousSchauderFrame

#print axioms ContinuousSchauderFrame.averageFunctional_apply
#print axioms ContinuousSchauderFrame.simpleCutOperator_compact
#print axioms ContinuousSchauderFrame.simpleCutOperator_coeff

end FrameSimpleApproximation


section FrameLocalCompactness

open MeasureTheory Function
open scoped ENNReal

namespace ContinuousSchauderFrame

variable {Ω X : Type*} [MeasurableSpace Ω] [NormedAddCommGroup X] [NormedSpace ℝ X]
  [CompleteSpace X] {η : Measure Ω} (F : ContinuousSchauderFrame (X := X) η)

private theorem norm_sub_synthesis_le (E : MeasSet Ω) (s : Ω → X) (A : X →L[ℝ] X)
    (hErr : IntegrableOn (fun t => ‖F.vector t - s t‖ * ‖F.functional t‖) E.1 η)
    (hs : ∀ x (g : Dual X), IntegrableOn (fun t => F.functional t x * g (s t)) E.1 η)
    (hc : ∀ x (g : Dual X), g (A x) = ∫ t in E.1, F.functional t x * g (s t) ∂η) :
    ‖F.operatorMeasure.val E - A‖ ≤ ∫ t in E.1, ‖F.vector t - s t‖ * ‖F.functional t‖ ∂η := by
  have hnon : 0 ≤ ∫ t in E.1, ‖F.vector t - s t‖ * ‖F.functional t‖ ∂η :=
    integral_nonneg fun _ => by positivity
  refine ContinuousLinearMap.opNorm_le_bound _ hnon fun x => ?_
  let y := (F.operatorMeasure.val E - A) x
  change ‖y‖ ≤ _
  by_cases hy : y = 0
  · rw [hy, norm_zero]
    exact mul_nonneg hnon (norm_nonneg x)
  · obtain ⟨g, hg, hgy⟩ := exists_dual_vector ℝ y (norm_ne_zero_iff.mpr hy)
    have hK : IntegrableOn (fun t => F.functional t x * g (F.vector t)) E.1 η := by
      change Integrable _ (η.restrict E.1)
      simpa only [map_smul, smul_eq_mul] using (((F.pettis x).1 g).2.restrict :
        Integrable (fun t => g (F.functional t x • F.vector t)) (η.restrict E.1))
    have hS := hs x g
    have hdiff := hK.sub hS
    have hidentity : g y = ∫ t in E.1, F.functional t x * g (F.vector t - s t) ∂η := by
      change g (F.operatorMeasure.val E x - A x) = _
      rw [map_sub, F.operatorMeasure_coeff, hc, ← integral_sub hK hS]
      congr 1
      funext t
      simp only [map_sub, mul_sub]
    rw [hgy] at hidentity
    change ‖y‖ = _ at hidentity
    rw [hidentity, ← integral_mul_const]
    have hfact (t : Ω) :
        F.functional t x * g (F.vector t - s t) ≤
          (‖F.vector t - s t‖ * ‖F.functional t‖) * ‖x‖ := by
      calc
        _ ≤ ‖F.functional t x * g (F.vector t - s t)‖ := le_abs_self _
        _ = ‖F.functional t x‖ * ‖g (F.vector t - s t)‖ := norm_mul _ _
        _ ≤ (‖F.functional t‖ * ‖x‖) * (‖g‖ * ‖F.vector t - s t‖) :=
          mul_le_mul ((F.functional t).le_opNorm x) (g.le_opNorm _) (norm_nonneg _) (by positivity)
        _ = _ := by rw [hg, one_mul]; ring
    refine integral_mono_ae ?_ (hErr.mul_const _) (ae_of_all _ hfact)
    change Integrable (fun t => F.functional t x * g (F.vector t - s t)) (η.restrict E.1)
    simpa only [map_sub, mul_sub] using (show Integrable
      (fun t => F.functional t x * g (F.vector t) - F.functional t x * g (s t))
      (η.restrict E.1) from hdiff)

/-- The weighted L¹ error of simple synthesis bounds the operator-norm error. -/
theorem norm_sub_simpleCutOperator_le (E : MeasSet Ω) (s : SimpleFunc Ω X)
    (hF : IntegrableOn (fun t => ‖F.functional t‖) E.1 η)
    (hErr : IntegrableOn (fun t => ‖F.vector t - s t‖ * ‖F.functional t‖) E.1 η) :
    ‖F.operatorMeasure.val E - F.simpleCutOperator E s hF‖ ≤
      ∫ t in E.1, ‖F.vector t - s t‖ * ‖F.functional t‖ ∂η :=
  F.norm_sub_synthesis_le E s _ hErr (F.integrableOn_simple_coeff E s hF)
    (F.simpleCutOperator_coeff E s hF)

/-- On a fiber the local approximant is the single rank-one map given by the
fiber value and the averaged coefficient. -/
private theorem norm_sub_averageFiber_le (E : MeasSet Ω) (s : SimpleFunc Ω X) (y : X)
    (hF : IntegrableOn (fun t => ‖F.functional t‖) E.1 η)
    (hErr : IntegrableOn (fun t => ‖F.vector t - s t‖ * ‖F.functional t‖) E.1 η) :
    ‖(F.averageFunctional (simpleCell E s y) (hF.mono_set inter_subset_left)).smulRight y -
      F.operatorMeasure.val (simpleCell E s y)‖ ≤
      ∫ t in (simpleCell E s y).1, ‖F.vector t - s t‖ * ‖F.functional t‖ ∂η := by
  let B := simpleCell E s y
  have hFB := hF.mono_set (simpleCell_subset E s y)
  rw [norm_sub_rev]
  apply F.norm_sub_synthesis_le B s _ (hErr.mono_set (simpleCell_subset E s y))
  · exact F.integrableOn_simple_coeff B s hFB
  · intro x g
    simp only [ContinuousLinearMap.smulRight_apply, map_smul, smul_eq_mul, averageFunctional_apply]
    rw [← integral_mul_const]
    apply setIntegral_congr_fun B.2
    intro t ht
    change F.functional t x * g y = F.functional t x * g (s t)
    rw [show s t = y from ht.2]

variable [TopologicalSpace.SeparableSpace X]

private theorem integrableOn_functional_norm_of_bound (E : MeasSet Ω) (hfin : η E.1 < ∞)
    (C : ℝ) (hC : ∀ t ∈ E.1, ‖F.functional t‖ ≤ C) :
    IntegrableOn (fun t => ‖F.functional t‖) E.1 η := by
  apply IntegrableOn.of_bound hfin F.measurable_functional_norm.aestronglyMeasurable C
  filter_upwards [ae_restrict_mem E.2] with t ht
  simpa only [Real.norm_of_nonneg (norm_nonneg _)] using hC t ht

/-- The vector function on a bounded finite-measure cell admits simple
approximants in the error integral used in cor:frame-discretization. -/
theorem exists_simple_weighted_error (E : MeasSet Ω) (hfin : η E.1 < ∞)
    (C : ℝ) (hC₀ : 0 ≤ C)
    (hC : ∀ t ∈ E.1, ‖F.vector t‖ ≤ C ∧ ‖F.functional t‖ ≤ C)
    (ε : ℝ) (hε : 0 < ε) : ∃ s : SimpleFunc Ω X,
      IntegrableOn (fun t => ‖F.vector t - s t‖ * ‖F.functional t‖) E.1 η ∧
      (∫ t in E.1, ‖F.vector t - s t‖ * ‖F.functional t‖ ∂η) < ε := by
  have hv := citePettisMeasurability F.vector F.weaklyMeasurable
  have hV : IntegrableOn F.vector E.1 η := by
    apply IntegrableOn.of_bound hfin hv.aestronglyMeasurable C
    filter_upwards [ae_restrict_mem E.2] with t ht
    exact (hC t ht).1
  let δ := ε / (C + 1)
  have hδ : 0 < δ := div_pos hε (by positivity)
  have hm : MemLp F.vector 1 (η.restrict E.1) := memLp_one_iff_integrable.mpr hV
  obtain ⟨s, hs, hsInt⟩ := hm.exists_simpleFunc_eLpNorm_sub_lt (by simp)
    (ENNReal.ofReal_pos.mpr hδ).ne'
  have hsub : Integrable (F.vector - ⇑s) (η.restrict E.1) :=
    memLp_one_iff_integrable.mp (hm.sub hsInt)
  rw [eLpNorm_one_eq_lintegral_eNorm hsub.aestronglyMeasurable, ← ofReal_integral_norm_eq_lintegral_eNorm hsub] at hs
  have hL1 : (∫ t in E.1, ‖F.vector t - s t‖ ∂η) < δ := by
    have := (ENNReal.ofReal_lt_ofReal_iff hδ).mp hs
    exact this
  have hbound : ∀ᵐ t ∂η.restrict E.1,
      ‖F.vector t - s t‖ * ‖F.functional t‖ ≤ ‖F.vector t - s t‖ * C := by
    filter_upwards [ae_restrict_mem E.2] with t ht
    exact mul_le_mul_of_nonneg_left (hC t ht).2 (norm_nonneg _)
  have hInt : Integrable (fun t => ‖F.vector t - s t‖ * ‖F.functional t‖)
      (η.restrict E.1) := by
    refine (hsub.norm.mul_const C).mono' ((hsub.aestronglyMeasurable.norm).mul
      F.measurable_functional_norm.aestronglyMeasurable) ?_
    filter_upwards [hbound] with t ht
    change ‖‖F.vector t - s t‖ * ‖F.functional t‖‖ ≤ ‖F.vector t - s t‖ * C
    rwa [Real.norm_of_nonneg (mul_nonneg (norm_nonneg _) (norm_nonneg _))]
  refine ⟨s, hInt, ?_⟩
  calc
    _ ≤ ∫ t in E.1, ‖F.vector t - s t‖ * C ∂η :=
      integral_mono_ae hInt (show Integrable (fun t => ‖F.vector t - s t‖ * C)
        (η.restrict E.1) from hsub.norm.mul_const C) hbound
    _ = (∫ t in E.1, ‖F.vector t - s t‖ ∂η) * C := integral_mul_const _ _
    _ ≤ δ * C := mul_le_mul_of_nonneg_right hL1.le hC₀
    _ < ε := by
      have hident : δ * (C + 1) = ε := div_mul_cancel₀ _ (by positivity)
      linarith

/-- Every measurable cut inside a bounded finite-measure cell is compact,
by approximation in operator norm by finite sums of rank-one maps. -/
theorem compact_operatorMeasure_cut_of_bound (E : MeasSet Ω) (hfin : η E.1 < ∞)
    (C : ℝ) (hC₀ : 0 ≤ C)
    (hC : ∀ t ∈ E.1, ‖F.vector t‖ ≤ C ∧ ‖F.functional t‖ ≤ C) :
    IsCompactOperator (F.operatorMeasure.val E) := by
  have hF := F.integrableOn_functional_norm_of_bound E hfin C (fun t ht => (hC t ht).2)
  have happ (n : ℕ) := F.exists_simple_weighted_error E hfin C hC₀ hC ((1 / 2 : ℝ) ^ n)
    (by positivity)
  choose s hsi hse using happ
  let A (n : ℕ) := F.simpleCutOperator E (s n) hF
  apply isCompactOperator_of_tendsto (F := A) (l := atTop)
  · rw [tendsto_iff_norm_sub_tendsto_zero]
    refine squeeze_zero (fun _ => norm_nonneg _) (fun n => ?_)
      (tendsto_pow_atTop_nhds_zero_of_lt_one (show 0 ≤ (1 / 2 : ℝ) by norm_num) (by norm_num))
    rw [norm_sub_rev]
    exact (F.norm_sub_simpleCutOperator_le E (s n) hF (hsi n)).trans (hse n).le
  · exact Eventually.of_forall fun n => F.simpleCutOperator_compact E (s n) hF

/-- The localization in prop:frame-dilation gives finite variation on
each cell and compactness on every measurable subcut of that cell. -/
theorem exists_partition_locally_compact_operatorMeasure [SigmaFinite η] :
    ∃ D : ℕ → MeasSet Ω, Pairwise (Disjoint on fun n => (D n).1) ∧
      MeasSet.iUnion D = MeasSet.whole ∧
      ∀ n, η (D n).1 < ∞ ∧ F.operatorMeasure.operatorVariation (D n) < ∞ ∧
        ∀ E : MeasSet Ω, E.1 ⊆ (D n).1 → IsCompactOperator (F.operatorMeasure.val E) := by
  obtain ⟨D, hD, hc, hb⟩ := F.exists_bounded_measurable_partition
  refine ⟨D, hD, hc, fun n => ⟨(hb n).1, ?_, ?_⟩⟩
  · have hv := citePettisMeasurability F.vector F.weaklyMeasurable
    have hi : IntegrableOn (fun t => ‖F.vector t‖ * ‖F.functional t‖) (D n).1 η := by
      apply IntegrableOn.of_bound (hb n).1
        (hv.norm.aestronglyMeasurable.mul F.measurable_functional_norm.aestronglyMeasurable)
        ((n : ℝ) * n)
      filter_upwards [ae_restrict_mem (D n).2] with t ht
      change ‖‖F.vector t‖ * ‖F.functional t‖‖ ≤ (n : ℝ) * n
      rw [Real.norm_of_nonneg (mul_nonneg (norm_nonneg (F.vector t)) (norm_nonneg (F.functional t)))]
      exact mul_le_mul ((hb n).2 t ht).1 ((hb n).2 t ht).2 (norm_nonneg (F.functional t)) (by positivity)
    exact (F.operatorVariation_le_integral (D n) hi).trans_lt ENNReal.ofReal_lt_top
  · exact fun E hE => F.compact_operatorMeasure_cut_of_bound E
      ((measure_mono hE).trans_lt (hb n).1) n (by positivity) fun t ht => (hb n).2 t (hE ht)

end ContinuousSchauderFrame

#print axioms ContinuousSchauderFrame.norm_sub_simpleCutOperator_le

#print axioms ContinuousSchauderFrame.exists_simple_weighted_error
#print axioms ContinuousSchauderFrame.compact_operatorMeasure_cut_of_bound
#print axioms ContinuousSchauderFrame.exists_partition_locally_compact_operatorMeasure

end FrameLocalCompactness


section FrameDiscretization

open MeasureTheory Function
open scoped ENNReal

variable {Ω X : Type*} [MeasurableSpace Ω] [NormedAddCommGroup X] [NormedSpace ℝ X]
  [CompleteSpace X] {η : Measure Ω}

omit [CompleteSpace X] in
/-- Number the cells without changing the sum of the errors, inserting
empty cells at the unused indices. -/
private theorem OVM.number_discretization_cells {ι : Type*} (K : OVM Ω X)
    (e : ι → ℕ) (he : Injective e) (B : ι → MeasSet Ω)
    (hd : Pairwise (Disjoint on fun i => (B i).1)) (hc : (⋃ i, (B i).1) = univ)
    (y : ι → X) (g : ι → Dual X)
    (hs : Summable (fun i => ‖(g i).smulRight (y i) - K.val (B i)‖))
    (ε : ℝ) (hb : (∑' i, ‖(g i).smulRight (y i) - K.val (B i)‖) < ε) :
    ∃ (D : ℕ → MeasSet Ω) (v : ℕ → X) (f : ℕ → Dual X),
      MeasSet.DisjointSeq D ∧ MeasSet.iUnion D = MeasSet.whole ∧
      Summable (fun j => ‖(f j).smulRight (v j) - K.val (D j)‖) ∧
      (∑' j, ‖(f j).smulRight (v j) - K.val (D j)‖) < ε := by
  let D := extend e B (fun _ => MeasSet.empty)
  let v := extend e y 0
  let f := extend e g 0
  have hD : ∀ i, D (e i) = B i := he.extend_apply _ _
  have hv : ∀ i, v (e i) = y i := he.extend_apply _ _
  have hf : ∀ i, f (e i) = g i := he.extend_apply _ _
  have hDe (j : ℕ) (hj : j ∉ range e) : D j = MeasSet.empty := extend_apply' _ _ _ hj
  refine ⟨D, v, f, ?_, ?_, ?_⟩
  · intro j k hjk
    by_cases hj : j ∈ range e
    · obtain ⟨i, rfl⟩ := hj
      by_cases hk : k ∈ range e
      · obtain ⟨l, rfl⟩ := hk
        rw [hD, hD]
        exact hd (fun h => hjk (congrArg e h))
      · rw [hDe k hk]
        exact Set.disjoint_left.mpr fun _ _ h => h.elim
    · rw [hDe j hj]
      exact Set.disjoint_left.mpr fun _ h _ => h.elim
  · apply Subtype.ext
    change (⋃ j, (D j).1) = univ
    rw [← hc]
    ext t
    constructor
    · intro ht
      obtain ⟨j, hj⟩ := mem_iUnion.mp ht
      by_cases he' : j ∈ range e
      · obtain ⟨i, rfl⟩ := he'
        rw [hD] at hj
        exact mem_iUnion.mpr ⟨i, hj⟩
      · rw [hDe j he'] at hj
        exact hj.elim
    · intro ht
      obtain ⟨i, hi⟩ := mem_iUnion.mp ht
      exact mem_iUnion.mpr ⟨e i, by rwa [hD]⟩
  · let err (i : ι) := ‖(g i).smulRight (y i) - K.val (B i)‖
    have hErr : (fun j => ‖(f j).smulRight (v j) - K.val (D j)‖) = extend e err 0 := by
      funext j
      by_cases hj : j ∈ range e
      · obtain ⟨i, rfl⟩ := hj
        rw [hf, hv, hD, he.extend_apply]
      · rw [hDe j hj, K.empty_eq, extend_apply' _ _ _ hj]
        have hv' : v j = 0 := extend_apply' _ _ _ hj
        simp [hv']
    rw [hErr, tsum_extend_zero he]
    exact ⟨((hasSum_extend_zero he).mpr hs.hasSum).summable, hb⟩

namespace ContinuousSchauderFrame

variable [TopologicalSpace.SeparableSpace X] [SigmaFinite η] (F : ContinuousSchauderFrame (X := X) η)

/-- Enumerate the simple-function fibers so that their averaged rank-one
operators have arbitrarily small total error. -/
theorem exists_rankOne_discretization (ε : ℝ) (hε : 0 < ε) :
    ∃ (B : ℕ → MeasSet Ω) (y : ℕ → X) (g : ℕ → Dual X),
      MeasSet.DisjointSeq B ∧ MeasSet.iUnion B = MeasSet.whole ∧
      Summable (fun j => ‖(g j).smulRight (y j) - F.operatorMeasure.val (B j)‖) ∧
      (∑' j, ‖(g j).smulRight (y j) - F.operatorMeasure.val (B j)‖) < ε := by
  classical
  obtain ⟨D, hD, hcover, hDfinite⟩ := F.exists_bounded_measurable_partition
  let b (n : ℕ) := (ε / 4) * (1 / 2 : ℝ) ^ n
  have hb n : 0 < b n := by dsimp [b]; positivity
  have hbs : Summable b := (summable_geometric_of_lt_one
    (show 0 ≤ (1 / 2 : ℝ) by norm_num) (by norm_num)).mul_left _
  have hbt : (∑' n, b n) < ε := by
    unfold b
    rw [tsum_mul_left, tsum_geometric_of_lt_one (by norm_num) (by norm_num)]
    linarith
  have hF (n : ℕ) : IntegrableOn (fun t => ‖F.functional t‖) (D n).1 η :=
    F.integrableOn_functional_norm_of_bound (D n) (hDfinite n).1 n
      (fun t ht => ((hDfinite n).2 t ht).2)
  have hs (n : ℕ) := F.exists_simple_weighted_error (D n) (hDfinite n).1 n (by positivity)
    (hDfinite n).2 (b n) (hb n)
  choose s hi he using hs
  let ι := Σ n : ℕ, ↥(s n).range
  let B (i : ι) := simpleCell (D i.1) (s i.1) i.2
  let y (i : ι) : X := i.2
  let g (i : ι) := F.averageFunctional (B i) ((hF i.1).mono_set inter_subset_left)
  let w (n : ℕ) (t : Ω) := ‖F.vector t - s n t‖ * ‖F.functional t‖
  let err (i : ι) := ‖(g i).smulRight (y i) - F.operatorMeasure.val (B i)‖
  have hcell (i : ι) : err i ≤ ∫ t in (B i).1, w i.1 t ∂η :=
    F.norm_sub_averageFiber_le (D i.1) (s i.1) i.2 (hF i.1) (hi i.1)
  have hblock (n : ℕ) (t : Ω) (ht : t ∈ (D n).1) : t ∈ (B ⟨n, ⟨s n t, (s n).mem_range_self t⟩⟩).1 :=
    ⟨ht, rfl⟩
  have hd : Pairwise (Disjoint on fun i => (B i).1) := by
    rintro ⟨n, a⟩ ⟨m, c⟩ hne
    apply Set.disjoint_left.mpr
    intro t ht hu
    by_cases hnm : n = m
    · subst m
      apply hne
      have heq : a = c := Subtype.ext ((show s n t = a from ht.2).symm.trans
        (show s n t = c from hu.2))
      rw [heq]
    · exact Set.disjoint_left.mp (hD hnm) ht.1 hu.1
  have hc : (⋃ i, (B i).1) = univ := by
    apply univ_subset_iff.mp
    intro t _
    have ht : t ∈ ⋃ n, (D n).1 := by
      have h := congrArg Subtype.val hcover
      change (⋃ n, (D n).1) = univ at h
      rw [h]
      exact mem_univ _
    obtain ⟨n, hn⟩ := mem_iUnion.mp ht
    exact mem_iUnion.mpr ⟨⟨n, ⟨s n t, (s n).mem_range_self t⟩⟩, hblock n t hn⟩
  have hrow (n : ℕ) : (∑' a : ↥(s n).range, err ⟨n, a⟩) ≤ b n := by
    let C (a : X) := simpleCell (D n) (s n) a
    have hCov : (⋃ a ∈ (s n).range, (C a).1) = (D n).1 := by
      ext t
      constructor
      · intro ht
        obtain ⟨_, _, ha⟩ := mem_iUnion₂.mp ht
        exact ha.1
      · intro ht
        exact mem_iUnion₂.mpr ⟨s n t, (s n).mem_range_self t, ht, rfl⟩
    have hDis : Set.Pairwise (↑(s n).range : Set X) (fun a c => Disjoint (C a).1 (C c).1) := by
      intro a ha c hc' hne
      exact hd (show (⟨n, ⟨a, ha⟩⟩ : ι) ≠ ⟨n, ⟨c, hc'⟩⟩ from fun h =>
        hne (congrArg y h))
    calc
      _ = ∑ a : ↥(s n).range, err ⟨n, a⟩ := tsum_fintype _
      _ ≤ ∑ a : ↥(s n).range, ∫ t in (C a).1, w n t ∂η :=
        Finset.sum_le_sum fun a _ => hcell ⟨n, a⟩
      _ = ∫ t in (D n).1, w n t ∂η := by
        rw [← Finset.sum_subtype (s n).range (fun _ => Iff.rfl) (fun a => ∫ t in (C a).1, w n t ∂η),
          ← integral_biUnion_finset
          (s n).range (fun a _ => (C a).2) hDis (fun a _ => (hi n).mono_set inter_subset_left), hCov]
      _ ≤ b n := (he n).le
  have hrows : Summable (fun n => ∑' a : ↥(s n).range, err ⟨n, a⟩) :=
    hbs.of_nonneg_of_le (fun n => tsum_nonneg fun _ => norm_nonneg _) hrow
  have herr : Summable err := (summable_sigma_of_nonneg (fun _ => norm_nonneg _)).mpr
    ⟨fun _ => summable_of_ne_finset_zero (s := Finset.univ) (by simp), hrows⟩
  have herrlt : (∑' i, err i) < ε := by
    rw [herr.tsum_sigma]
    exact (hrows.tsum_le_tsum hrow hbs).trans_lt hbt
  let index (i : ι) : ℕ × ℕ := (i.1, ((s i.1).range.equivFin i.2).val)
  have hindex : Injective index := by
    rintro ⟨n, a⟩ ⟨m, c⟩ h
    have hnm : n = m := congrArg Prod.fst h
    subst m
    have hac : a = c := (s n).range.equivFin.injective (Fin.ext (congrArg Prod.snd h))
    rw [hac]
  exact F.operatorMeasure.number_discretization_cells (Nat.pairEquiv ∘ index)
    (Nat.pairEquiv.injective.comp hindex) B hd hc y g herr ε herrlt

include F in
/-- Corollary cor:frame-discretization. -/
theorem exists_unconditionalSchauderFrame :
    ∃ (y : ℕ → X) (g : ℕ → Dual X), IsUnconditionalSchauderFrame y g := by
  obtain ⟨B, y, g, hd, hc, hs, hb⟩ := F.exists_rankOne_discretization 1 zero_lt_one
  obtain ⟨A, _, hFrame⟩ := F.operatorMeasure.discretization_correction
    F.operatorMeasure_normalized B hd hc y g hs hb
  exact ⟨fun n => (↑(A⁻¹) : X →L[ℝ] X) (y n), g, hFrame⟩

end ContinuousSchauderFrame

#print axioms ContinuousSchauderFrame.exists_rankOne_discretization
#print axioms ContinuousSchauderFrame.exists_unconditionalSchauderFrame

