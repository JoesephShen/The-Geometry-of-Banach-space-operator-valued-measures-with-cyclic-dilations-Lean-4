private theorem sum_abs_le_lOneNorm (u : LOne) (s : Finset ℕ) :
    ∑ n ∈ s, |u n| ≤ ‖u‖ := by
  rw [← (lOne_hasSum_abs u).tsum_eq]
  exact (lOne_hasSum_abs u).summable.sum_le_tsum _ (fun _ _ => abs_nonneg _)

private theorem lOne_finite_tail (u : LOne) {r : ℝ} (hr : 0 < r) :
    ∃ K : ℕ, ∀ s : Finset ℕ, (∀ n ∈ s, K ≤ n) → ∑ n ∈ s, |u n| < r := by
  obtain ⟨t, ht⟩ := summable_iff_vanishing_norm.mp (lOne_hasSum_abs u).summable r hr
  obtain ⟨K, hK⟩ := t.exists_nat_subset_range
  refine ⟨K, fun s hs => (le_abs_self _).trans_lt ?_⟩
  rw [← Real.norm_eq_abs]
  exact ht s (Finset.disjoint_left.mpr fun n hn hnt =>
    (not_lt_of_ge (hs n hn)) (Finset.mem_range.mp (hK hnt)))

/-- Non-uniform tails on a bounded set produce coordinatewise null
images with norms bounded away from zero. -/
private theorem lOne_seminormalized_images_of_tails (A : X →L[ℝ] LOne) {δ : ℝ} (hδ : 0 < δ)
    (h : ∀ N : ℕ, ∃ x : X, ‖x‖ ≤ 1 ∧ ∃ s : Finset ℕ,
      (∀ n ∈ s, N ≤ n) ∧ δ ≤ ∑ n ∈ s, |A x n|) :
    ∃ y : ℕ → X, (∀ n, ‖y n‖ ≤ 2) ∧ (∀ n, δ / 2 ≤ ‖A (y n)‖) ∧
      ∀ i, Tendsto (fun n => A (y n) i) atTop (𝓝 0) := by
  choose x hx s hs hlarge using h
  let B : Set (ℕ → ℝ) := {v | ∀ i, v i ∈ Set.Icc (-‖A‖) ‖A‖}
  have hB : IsCompact B := isCompact_pi_infinite (fun _ => isCompact_Icc)
  have hm (n : ℕ) : (fun i => A (x n) i) ∈ B := by
    intro i
    apply abs_le.mp
    have hn := lp.norm_apply_le_norm (by simp : (1 : ℝ≥0∞) ≠ 0) (A (x n)) i
    rw [Real.norm_eq_abs] at hn
    refine hn.trans ((A.le_opNorm _).trans ?_)
    simpa only [mul_one] using mul_le_mul_of_nonneg_left (hx n) (norm_nonneg A)
  obtain ⟨z, _, φ, hφ, hlim⟩ := hB.tendsto_subseq hm
  have hnext (n : ℕ) : ∃ j ≥ n, δ / 2 ≤ ‖A (x (φ j) - x (φ n))‖ := by
    obtain ⟨K, hK⟩ := lOne_finite_tail (A (x (φ n))) (show 0 < δ / 2 by linarith)
    obtain ⟨j, hj⟩ := (((tendsto_atTop.mp hφ.tendsto_atTop) K).and
      (eventually_ge_atTop n)).exists
    refine ⟨j, hj.2, ?_⟩
    have htail := hK (s (φ j)) (fun i hi => hj.1.trans (hs (φ j) i hi))
    have hsum : (∑ i ∈ s (φ j), |A (x (φ j)) i|) ≤
        (∑ i ∈ s (φ j), |A (x (φ j) - x (φ n)) i|) +
          ∑ i ∈ s (φ j), |A (x (φ n)) i| := by
      rw [← Finset.sum_add_distrib]
      apply Finset.sum_le_sum
      intro i _
      rw [map_sub]
      change |A (x (φ j)) i| ≤ |A (x (φ j)) i - A (x (φ n)) i| + |A (x (φ n)) i|
      simpa only [sub_zero] using abs_sub_le (A (x (φ j)) i) (A (x (φ n)) i) (0 : ℝ)
    linarith [sum_abs_le_lOneNorm (A (x (φ j) - x (φ n))) (s (φ j)), hlarge (φ j)]
  choose j hj hjlarge using hnext
  refine ⟨fun n => x (φ (j n)) - x (φ n), fun n => ?_, hjlarge, fun i => ?_⟩
  · exact (norm_sub_le _ _).trans (by linarith [hx (φ (j n)), hx (φ n)])
  · have ht : Tendsto (fun n => A (x (φ n)) i) atTop (𝓝 (z i)) :=
      ((continuous_apply i).tendsto z).comp hlim
    have hj' : Tendsto j atTop atTop := tendsto_atTop.mpr fun N =>
      (eventually_ge_atTop N).mono fun n hn => hn.trans (hj n)
    have hd := (ht.comp hj').sub ht
    simpa only [map_sub, lp.coeFn_sub, Pi.sub_apply, Function.comp_apply, sub_self] using hd

private theorem lOne_weighted_summable [CompleteSpace X] (y : ℕ → X) (M : ℝ)
    (_hM : 0 ≤ M) (hy : ∀ n, ‖y n‖ ≤ M) (a : LOne) :
    Summable (fun n => a n • y n) := by
  apply Summable.of_norm
  apply ((lOne_hasSum_abs a).const_smul M).summable.of_nonneg_of_le (fun _ => norm_nonneg _)
  intro n
  rw [norm_smul, Real.norm_eq_abs]
  rw [smul_eq_mul, mul_comm M]
  exact mul_le_mul_of_nonneg_left (hy n) (abs_nonneg _)

private noncomputable def lOneSynthesis [CompleteSpace X] (y : ℕ → X) (M : ℝ)
    (hM : 0 ≤ M) (hy : ∀ n, ‖y n‖ ≤ M) : LOne →L[ℝ] X := by
  let hs := lOne_weighted_summable y M hM hy
  refine LinearMap.mkContinuous
    { toFun := fun a => ∑' n, a n • y n
      map_add' := fun a b => ?_
      map_smul' := fun c a => ?_ } M (fun a => ?_)
  · have ht := (hs a).hasSum.add (hs b).hasSum
    have e : (fun n => a n • y n + b n • y n) = fun n => (a + b) n • y n :=
      funext fun n => (add_smul (a n) (b n) (y n)).symm
    rw [e] at ht
    exact ht.tsum_eq
  · have ht := (hs a).hasSum.const_smul c
    have e : (fun n => c • (a n • y n)) = fun n => (c • a) n • y n :=
      funext fun n => (mul_smul c (a n) (y n)).symm
    rw [e] at ht
    exact ht.tsum_eq
  · apply le_of_tendsto (hs a).hasSum.norm
    exact Eventually.of_forall fun s => (norm_sum_le _ _).trans (by
      simp only [norm_smul, Real.norm_eq_abs]
      calc
        _ ≤ ∑ n ∈ s, |a n| * M := Finset.sum_le_sum fun n _ =>
          mul_le_mul_of_nonneg_left (hy n) (abs_nonneg _)
        _ ≤ M * ‖a‖ := by
          rw [← Finset.sum_mul, mul_comm M ‖a‖]
          exact mul_le_mul_of_nonneg_right (sum_abs_le_lOneNorm a s) hM)

private theorem contains_lOne_of_images [CompleteSpace X] (A : X →L[ℝ] LOne) (y : ℕ → X)
    (hy : ∀ n, ‖y n‖ ≤ 2) {δ : ℝ} (hδ : 0 < δ) (hlo : ∀ n, δ ≤ ‖A (y n)‖)
    (hweak : ∀ i, Tendsto (fun n => A (y n) i) atTop (𝓝 0)) : ContainsCopy LOne X := by
  classical
  obtain ⟨k, _, B, hB, herr⟩ := lOne_glidingHump (fun n => A (y n)) hweak
    (δ / 4) (by linarith)
  let u (n : ℕ) := y (k n)
  let U := lOneSynthesis u 2 (by norm_num) (fun n => hy (k n))
  have hC : 0 < ‖A‖ + 1 := by positivity
  refine ⟨U, (δ / 2) / (‖A‖ + 1), div_pos (by linarith) hC, fun a => ?_⟩
  let q (j : ℕ) := if hj : ∃ n, j ∈ B n then
    lOneSign (a (Classical.choose hj) * A (u (Classical.choose hj)) j) else 0
  have hq (j : ℕ) : |q j| ≤ 1 := by
    by_cases hj : ∃ n, j ∈ B n
    · simp only [q, dite_eq_left hj]
      exact abs_lOneSign _
    · simp [q, hj]
  let f := lOneBoundedEval q hq
  have hfnorm : ‖f‖ ≤ 1 := norm_lOneBoundedEval_le q hq
  have hdual (n : ℕ) : (δ / 2) * |a n| ≤ f (a n • A (u n)) := by
    let v := A (u n)
    let w := lOneCut (B n) v
    have hcut : f (a n • w) = |a n| * ‖w‖ := by
      have hcut' : a n • w = lOneCut (B n) (a n • v) := by
        ext j
        change a n * lOneCut (B n) v j = lOneCut (B n) (a n • v) j
        rw [lOneCut_apply, lOneCut_apply]
        change a n * (if j ∈ B n then v j else 0) =
          if j ∈ B n then a n * v j else 0
        by_cases hj : j ∈ B n <;> simp [hj]
      rw [hcut', lOneBoundedEval_cut, lOneCut_norm, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro j hj
      have he : ∃ i, j ∈ B i := ⟨n, hj⟩
      have hchoose : Classical.choose he = n := by
        by_contra hne
        exact (Finset.disjoint_left.mp (hB hne)) (Classical.choose_spec he) hj
      change q j * (a n * v j) = |a n| * |v j|
      rw [show q j = lOneSign (a n * v j) by simp only [q, dite_eq_left he, hchoose, v],
        lOneSign_mul, abs_mul]
    have hbound : ‖f‖ * ‖a n • (v - w)‖ ≤ |a n| * ‖v - w‖ := by
      rw [norm_smul, Real.norm_eq_abs]
      simpa only [one_mul] using mul_le_mul_of_nonneg_right hfnorm
        (mul_nonneg (abs_nonneg _) (norm_nonneg (v - w)))
    have hf := (f.le_opNorm (a n • (v - w))).trans hbound
    rw [smul_sub, map_sub, hcut, Real.norm_eq_abs] at hf
    have hd : δ / 2 ≤ ‖w‖ - ‖v - w‖ := by
      have hnorm := norm_le_insert' v w
      have hv : δ ≤ ‖v‖ := hlo (k n)
      have hh : ‖v - w‖ < δ / 4 := herr n
      linarith
    have hδ' := mul_le_mul_of_nonneg_left hd (abs_nonneg (a n))
    have hb := neg_le_abs (f (a n • v) - |a n| * ‖w‖)
    nlinarith
  have hu : HasSum (fun n => a n • u n) (U a) :=
    (lOne_weighted_summable u 2 (by norm_num) (fun n => hy (k n)) a).hasSum
  have hright : HasSum (fun n => f (a n • A (u n))) (f (A (U a))) := by
    simpa only [ContinuousLinearMap.comp_apply, map_smul] using (f.comp A).hasSum hu
  have hleft := (lOne_hasSum_abs a).const_smul (δ / 2)
  have hb : (δ / 2) * ‖a‖ ≤ f (A (U a)) := by
    apply le_of_tendsto_of_tendsto' hleft hright
    intro s
    exact Finset.sum_le_sum fun n _ => hdual n
  have he : f (A (U a)) ≤ (‖A‖ + 1) * ‖U a‖ := by
    have hfn : ‖f (A (U a))‖ ≤ ‖A (U a)‖ := by
      refine (f.le_opNorm _).trans ?_
      simpa only [one_mul] using mul_le_mul_of_nonneg_right hfnorm (norm_nonneg (A (U a)))
    exact (Real.le_norm_self _).trans (hfn.trans ((A.le_opNorm _).trans
      (mul_le_mul_of_nonneg_right (by linarith) (norm_nonneg _))))
  rw [div_mul_eq_mul_div, div_le_iff₀ hC, mul_comm (‖U a‖)]
  exact hb.trans he


/-- The coefficient operator of a disjoint measurable family, with
the \(2M_\mu\|f\|\) bound from the manuscript. -/
noncomputable def OVM.lOneCoefficientMap [CompleteSpace X] (μ : OVM Ω X)
    (B : ℕ → MeasSet Ω) (hB : MeasSet.DisjointSeq B) (f : Dual X) : X →L[ℝ] LOne := by
  let C := 2 * μ.uniformNorm * ‖f‖
  have hC (x : X) (s : Finset ℕ) : ∑ n ∈ s, |f (μ.val (B n) x)| ≤ C * ‖x‖ := by
    exact (μ.abs_finite_orbit_coefficients_le B hB x f s).trans_eq (by dsimp [C]; ring)
  let T (x : X) : LOne := ⟨fun n => f (μ.val (B n) x), memℓp_gen' (C := C * ‖x‖)
    (fun s => by simpa only [ENNReal.toReal_one, Real.rpow_one, Real.norm_eq_abs] using hC x s)⟩
  refine LinearMap.mkContinuous
    { toFun := T
      map_add' := fun x y => ?_
      map_smul' := fun c x => ?_ } C (fun x => ?_)
  · ext n
    change f (μ.val (B n) (x + y)) = f (μ.val (B n) x) + f (μ.val (B n) y)
    rw [map_add, map_add]
  · ext n
    change f (μ.val (B n) (c • x)) = c • f (μ.val (B n) x)
    rw [map_smul, map_smul]
  · exact le_of_tendsto (lOne_hasSum_abs (T x)) (Eventually.of_forall fun s => hC x s)

theorem OVM.norm_lOneCoefficientMap_le [CompleteSpace X] (μ : OVM Ω X)
    (B : ℕ → MeasSet Ω) (hB : MeasSet.DisjointSeq B) (f : Dual X) :
    ‖μ.lOneCoefficientMap B hB f‖ ≤ 2 * μ.uniformNorm * ‖f‖ := by
  unfold OVM.lOneCoefficientMap
  apply LinearMap.mkContinuous_norm_le
  exact mul_nonneg (mul_nonneg (by norm_num) μ.uniformNorm_nonneg) (norm_nonneg f)

/-- Manuscript, prop:no-l1-general. The coefficient operator is treated
by a direct gliding-hump argument for its finite tails. -/
theorem OVM.shrinking_of_not_contains_lOne_by_glidingHump [CompleteSpace X] (μ : OVM Ω X)
    (hX : ¬ ContainsCopy LOne X) : μ.Shrinking := by
  classical
  by_contra h
  unfold OVM.Shrinking at h
  push Not at h
  obtain ⟨B, hB, f, hbad⟩ := h
  let g (n : ℕ) := adjoint (μ.val (B n)) f
  have hns : ¬ Summable g := by
    intro hs
    apply hbad
    have hx (x : X) := ((J x).hasSum hs.hasSum).tendsto_sum_nat
    have hy (x : X) := ((μ.countably_additive B hB x).map f f.continuous).tendsto_sum_nat
    have he (x : X) : (fun n => J x (g n)) = fun n => f (μ.val (B n) x) := rfl
    have heq : ∑' n, g n = adjoint (μ.val (MeasSet.iUnion B)) f := by
      ext x
      have ht := tendsto_nhds_unique (he x ▸ hx x) (hy x)
      exact ht
    exact heq ▸ hs.hasSum
  rw [summable_iff_vanishing_norm] at hns
  push Not at hns
  obtain ⟨δ, hδ, hns⟩ := hns
  let A := μ.lOneCoefficientMap B hB f
  have htails (N : ℕ) : ∃ x : X, ‖x‖ ≤ 1 ∧ ∃ s : Finset ℕ,
      (∀ n ∈ s, N ≤ n) ∧ δ / 2 ≤ ∑ n ∈ s, |A x n| := by
    obtain ⟨s, hs, hslarge⟩ := hns (Finset.range N)
    let G := ∑ n ∈ s, g n
    have hselect : ∃ x : X, δ / 2 * ‖x‖ < ‖G x‖ := by
      by_contra! hh
      have hG := G.opNorm_le_bound (by linarith : 0 ≤ δ / 2) hh
      have hlarge : δ ≤ ‖G‖ := hslarge
      linarith
    obtain ⟨x, hx⟩ := hselect
    have hn : ‖x‖ ≠ 0 := by
      intro hn
      have hx0 := norm_eq_zero.mp hn
      simp [hx0] at hx
    let y := (‖x‖⁻¹ : ℝ) • x
    have hy : ‖y‖ = 1 := by
      rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr (norm_nonneg _)), inv_mul_cancel₀ hn]
    have hG : δ / 2 ≤ ‖G y‖ := by
      rw [map_smul, norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr (norm_nonneg _)),
        inv_mul_eq_div, le_div_iff₀ (lt_of_le_of_ne (norm_nonneg x) (Ne.symm hn))]
      exact hx.le
    refine ⟨y, hy.le, s, fun n hn => le_of_not_gt fun h =>
      Finset.disjoint_left.mp hs hn (Finset.mem_range.mpr h), hG.trans ?_⟩
    change ‖(∑ n ∈ s, g n) y‖ ≤ ∑ n ∈ s, |A y n|
    rw [sum_apply, Real.norm_eq_abs]
    exact Finset.abs_sum_le_sum_abs _ _
  obtain ⟨y, hy, hlarge, hweak⟩ := lOne_seminormalized_images_of_tails A (show 0 < δ / 2 by linarith) htails
  exact hX (contains_lOne_of_images A y hy (show 0 < δ / 2 / 2 by linarith) hlarge hweak)

/-- Rosenthal's subsequence conclusion, with the source manuscript's
no-copy hypothesis. The theorem establishing this implication is a separate dependency. -/
def RosenthalSubsequence (X : Type*) [NormedAddCommGroup X] [NormedSpace ℝ X] : Prop :=
  (¬ ContainsCopy LOne X) → ∀ x : ℕ → X, (∃ C : ℝ, ∀ n, ‖x n‖ ≤ C) →
    ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∀ f : Dual X, CauchySeq (fun n => f (x (φ n)))

/-- Schur applied to the image of a weakly Cauchy sequence. -/
theorem lOne_cauchySeq_of_weaklyCauchy (x : ℕ → LOne)
    (hx : ∀ f : Dual LOne, CauchySeq (fun n => f (x n))) : CauchySeq x := by
  by_contra h
  rw [Metric.cauchySeq_iff] at h
  push Not at h
  obtain ⟨ε, hε, hbad⟩ := h
  choose i hi j hj hd using hbad
  have hi' : Tendsto i atTop atTop := tendsto_atTop.mpr fun N =>
    (eventually_ge_atTop N).mono fun n hn => hn.trans (hi n)
  have hj' : Tendsto j atTop atTop := tendsto_atTop.mpr fun N =>
    (eventually_ge_atTop N).mono fun n hn => hn.trans (hj n)
  have ht : Tendsto (fun n => x (i n) - x (j n)) atTop (𝓝 0) := by
    apply lOne_tendsto_zero_of_weaklyNull
    intro f
    obtain ⟨a, ha⟩ := cauchySeq_tendsto_of_complete (hx f)
    simpa only [map_sub, sub_self, Function.comp_def] using (ha.comp hi').sub (ha.comp hj')
  obtain ⟨n, hn⟩ := ((tendsto_order.mp ht.norm).2 ε (by simpa only [norm_zero])).exists
  exact (by simpa only [dist_eq_norm] using hd n : ε ≤ ‖x (i n) - x (j n)‖).not_gt hn

theorem lOne_coefficient_compact_of_weaklyCauchy_subsequences (T : X →L[ℝ] LOne)
    (hX : ∀ x : ℕ → X, (∀ n, ‖x n‖ ≤ 1) →
      ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∀ f : Dual X, CauchySeq (fun n => f (x (φ n)))) :
    IsCompact (closure (T '' Metric.closedBall (0 : X) 1)) := by
  classical
  apply isCompact_iff_isSeqCompact.mpr
  intro y hy
  have hex (n : ℕ) : ∃ x : X, ‖x‖ ≤ 1 ∧ dist (T x) (y n) < 1 / ((n : ℝ) + 1) := by
    have hp : 0 < 1 / ((n : ℝ) + 1) := by positivity
    obtain ⟨z, ⟨x, hx, rfl⟩, hz⟩ := Metric.mem_closure_iff.mp (hy n) _ hp
    exact ⟨x, by simpa only [Metric.mem_closedBall, dist_zero_right] using hx,
      by simpa only [dist_comm] using hz⟩
  choose x hx hxy using hex
  obtain ⟨φ, hφ, hw⟩ := hX x hx
  obtain ⟨a, ha⟩ := cauchySeq_tendsto_of_complete
    (lOne_cauchySeq_of_weaklyCauchy (fun n => T (x (φ n))) (fun f => hw (f.comp T)))
  have hin (n : ℕ) : T (x (φ n)) ∈ T '' Metric.closedBall (0 : X) 1 :=
    ⟨_, by simpa only [Metric.mem_closedBall, dist_zero_right] using hx (φ n), rfl⟩
  refine ⟨a, isClosed_closure.mem_of_tendsto ha (Eventually.of_forall fun n =>
    subset_closure (hin n)), φ, hφ, ?_⟩
  have hd : Tendsto (fun n => dist (T (x (φ n))) (y (φ n))) atTop (𝓝 0) := by
    refine squeeze_zero (fun _ => dist_nonneg) (fun n => (hxy (φ n)).le) ?_
    exact tendsto_one_div_add_atTop_nhds_zero_nat.comp hφ.tendsto_atTop
  apply tendsto_iff_dist_tendsto_zero.mpr
  refine squeeze_zero (fun _ => dist_nonneg)
    (fun n => dist_triangle (y (φ n)) (T (x (φ n))) a) ?_
  have hdy : Tendsto (fun n => dist (y (φ n)) (T (x (φ n)))) atTop (𝓝 0) := by
    simpa only [dist_comm] using hd
  simpa only [dist_self, add_zero] using
    hdy.add (ha.dist (tendsto_const_nhds (x := a)))

private noncomputable def lOneTailMap (N : ℕ) : LOne →L[ℝ] LOne :=
  ContinuousLinearMap.id ℝ LOne - ∑ i ∈ Finset.range N,
    (lp.singleContinuousLinearMap (𝕜 := ℝ) (E := fun _ : ℕ => ℝ) (p := 1) i).comp
      (lp.evalCLM ℝ (fun _ : ℕ => ℝ) 1 i)

private theorem lOneTailMap_apply (N : ℕ) (u : LOne) :
    lOneTailMap N u = u - lOneCut (Finset.range N) u := by
  simp only [lOneTailMap, lOneCut, sub_apply, ContinuousLinearMap.id_apply,
    sum_apply, ContinuousLinearMap.comp_apply]
  rfl

private theorem lOne_cut_remainder_norm (u : LOne) (I : Finset ℕ) :
    ‖u - lOneCut I u‖ = ‖u‖ - ∑ i ∈ I, |u i| := by
  simpa only [lOneCut, ENNReal.toReal_one, Real.rpow_one, Real.norm_eq_abs] using
    lp.norm_compl_sum_single (p := 1) (by simp) u I

private theorem lOneTailMap_norm_le (N : ℕ) (u : LOne) : ‖lOneTailMap N u‖ ≤ ‖u‖ := by
  rw [lOneTailMap_apply, lOne_cut_remainder_norm]
  exact sub_le_self _ (Finset.sum_nonneg fun _ _ => abs_nonneg _)

private theorem lOneTailMap_tendsto_zero (u : LOne) :
    Tendsto (fun N => lOneTailMap N u) atTop (𝓝 0) := by
  simpa only [lOneTailMap_apply, sub_self] using
    (tendsto_const_nhds (x := u)).sub (lOneCut_hasSum u)

theorem lOne_uniform_tails_of_compact (T : X →L[ℝ] LOne)
    (hT : IsCompact (closure (T '' Metric.closedBall (0 : X) 1))) :
    Tendsto (fun N => ‖(lOneTailMap N).comp T‖) atTop (𝓝 0) := by
  classical
  rw [Metric.tendsto_atTop]
  intro ε hε
  obtain ⟨t, _, ht, hcover⟩ := hT.finite_cover_balls (half_pos hε)
  have hlocal : ∀ v ∈ ht.toFinset, ∀ᶠ N in atTop, ‖lOneTailMap N v‖ < ε / 4 := by
    intro v _
    have h := (lOneTailMap_tendsto_zero v).norm
    rw [norm_zero] at h
    exact (tendsto_order.mp h).2 (ε / 4) (by positivity)
  obtain ⟨N, hN⟩ := eventually_atTop.mp ((Finset.eventually_all _).mpr hlocal)
  refine ⟨N, fun n hn => ?_⟩
  rw [Real.dist_eq, sub_zero, abs_of_nonneg (norm_nonneg _)]
  refine (ContinuousLinearMap.opNorm_le_of_unit_norm (by positivity : 0 ≤ 3 * ε / 4) ?_).trans_lt
    (by linarith)
  intro x hx
  have hx' : T x ∈ closure (T '' Metric.closedBall (0 : X) 1) :=
    subset_closure ⟨x, by rw [Metric.mem_closedBall, dist_zero_right, hx], rfl⟩
  obtain ⟨v, hv, hvx⟩ := mem_iUnion₂.mp (hcover hx')
  have hd := Metric.mem_ball.mp hvx
  have htail := hN n hn v (ht.mem_toFinset.mpr hv)
  change ‖lOneTailMap n (T x)‖ ≤ 3 * ε / 4
  have he : lOneTailMap n (T x) = lOneTailMap n (T x - v) + lOneTailMap n v := by
    rw [map_sub, sub_add_cancel]
  rw [he]
  apply (norm_add_le _ _).trans
  have hb := lOneTailMap_norm_le n (T x - v)
  rw [dist_eq_norm] at hd
  linarith

/-- Manuscript, prop:no-l1-general. This proof uses Rosenthal, Schur,
compactness of the coefficient operator, and uniform tail decay, in the
order of the manuscript. The external Rosenthal theorem is explicit. -/
theorem OVM.shrinking_of_not_contains_lOne_using_rosenthal [CompleteSpace X]
    (μ : OVM Ω X) (rosenthal : RosenthalSubsequence X)
    (hX : ¬ ContainsCopy LOne X) : μ.Shrinking := by
  intro B hB f
  let T := μ.lOneCoefficientMap B hB f
  have hc := lOne_coefficient_compact_of_weaklyCauchy_subsequences T
    (fun x hx => rosenthal hX x ⟨1, hx⟩)
  have ht := lOne_uniform_tails_of_compact T hc
  let S : Dual LOne := lp.tsumCLM (α := ℕ) (𝕜 := ℝ) (E := ℝ)
  have hS (u : LOne) : ‖S u‖ ≤ ‖u‖ := lp.norm_tsum_le u
  have hsum (x : X) : S (T x) = f (μ.val (MeasSet.iUnion B) x) := by
    change (∑' n, f (μ.val (B n) x)) = _
    exact ((μ.countably_additive B hB x).map f f.continuous).tsum_eq
  have hsingle (i : ℕ) (a : ℝ) : S ((lp.single 1 i a : LOne)) = a := by
    change (∑' n, (lp.single 1 i a : LOne) n) = a
    rw [tsum_eq_single i]
    · exact lp.single_apply_self (E := fun _ : ℕ => ℝ) 1 i a
    · exact fun _ hi => lp.single_apply_ne (E := fun _ : ℕ => ℝ) 1 i a hi
  have hremainder (I : Finset ℕ) (x : X) :
      (adjoint (μ.val (MeasSet.iUnion B)) f - ∑ n ∈ I, adjoint (μ.val (B n)) f) x =
        S (T x - lOneCut I (T x)) := by
    rw [lOneCut, map_sub, map_sum, hsum]
    simp only [sub_apply, sum_apply, hsingle]
    rfl
  unfold HasSum
  rw [Metric.tendsto_nhds]
  intro ε hε
  obtain ⟨N, hN⟩ := ((tendsto_order.mp ht).2 ε hε).exists
  filter_upwards [eventually_ge_atTop (Finset.range N)] with I hI
  rw [dist_eq_norm, norm_sub_rev]
  refine (ContinuousLinearMap.opNorm_le_of_unit_norm (norm_nonneg ((lOneTailMap N).comp T)) ?_).trans_lt hN
  intro x hx
  rw [hremainder]
  apply (hS _).trans
  have hi : ‖T x - lOneCut I (T x)‖ ≤ ‖lOneTailMap N (T x)‖ := by
    rw [lOneTailMap_apply, lOne_cut_remainder_norm, lOne_cut_remainder_norm]
    exact sub_le_sub_left (Finset.sum_le_sum_of_subset_of_nonneg hI (fun _ _ _ => abs_nonneg _)) _
  exact hi.trans (by
    change ‖((lOneTailMap N).comp T) x‖ ≤ ‖(lOneTailMap N).comp T‖
    simpa only [hx, mul_one] using ((lOneTailMap N).comp T).le_opNorm x)

