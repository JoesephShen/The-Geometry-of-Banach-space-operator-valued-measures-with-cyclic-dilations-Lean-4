/-- A measurable choice of orientation: the first nonzero weight is positive. -/
def positiveOrientation (d : ℕ) : Set (BarronSphere d) :=
  {θ | ∃ i : Fin d, 0 < θ.weight i ∧ ∀ j : Fin d, j < i → θ.weight j = 0}

theorem measurableSet_positiveOrientation (d : ℕ) : MeasurableSet (positiveOrientation d) := by
  classical
  have he : positiveOrientation d =
      ⋃ i : Fin d, {θ : BarronSphere d | 0 < θ.weight i} ∩
        ⋂ j : Fin d, if j < i then {θ : BarronSphere d | θ.weight j = 0} else univ := by
    ext θ
    simp only [positiveOrientation, mem_ofPred_eq, mem_iUnion, mem_inter_iff, mem_iInter]
    apply exists_congr
    intro i
    constructor
    · rintro ⟨hi, hj⟩
      refine ⟨hi, fun j => ?_⟩
      by_cases h : j < i
      · simpa [h] using hj j h
      · simp [h]
    · rintro ⟨hi, hj⟩
      exact ⟨hi, fun j h => by simpa [h] using hj j⟩
  rw [he]
  apply MeasurableSet.iUnion
  intro i
  apply MeasurableSet.inter (measurableSet_lt measurable_const (weightSymbol i).2)
  apply MeasurableSet.iInter
  intro j
  split
  · exact measurableSet_eq_fun (weightSymbol j).2 measurable_const
  · exact MeasurableSet.univ

private theorem nonPole_has_nonzero_weight (θ : BarronSphere d) (hθ : θ ∈ (nonPole d).1) :
    ∃ i : Fin d, θ.weight i ≠ 0 := by
  by_contra! hn
  have hs : (∑ i, (θ.weight i)^2) + θ.bias^2 = 1 := θ.2
  simp only [hn, zero_pow (by decide : 2 ≠ 0), Finset.sum_const_zero, zero_add] at hs
  have he : θ.bias = 1 ∨ θ.bias = -1 := by
    have h : θ.bias ^ 2 = (1 : ℝ)^2 := hs.trans (one_pow _).symm
    exact (sq_eq_sq_iff_eq_or_eq_neg).mp h
  exact he.elim hθ.1 hθ.2

theorem positiveOrientation_subset_nonPole (d : ℕ) : positiveOrientation d ⊆ (nonPole d).1 := by
  intro θ hθ
  obtain ⟨i, hi, _⟩ := hθ
  rw [nonPole_eq_compl]
  simp only [mem_compl_iff, mem_insert_iff, mem_singleton_iff, not_or]
  constructor
  · intro h
    rw [h, weight_polePlus] at hi
    exact (lt_irrefl (0 : ℝ)) hi
  · intro h
    rw [h, weight_poleMinus] at hi
    exact (lt_irrefl (0 : ℝ)) hi

theorem positiveOrientation_iff_reflection_notMem (θ : BarronSphere d) (hθ : θ ∈ (nonPole d).1) :
    θ ∈ positiveOrientation d ↔ reflection d θ ∉ positiveOrientation d := by
  classical
  have hdisj (u : BarronSphere d) (hu : u ∈ positiveOrientation d) :
      reflection d u ∉ positiveOrientation d := by
    obtain ⟨i, hi, hprev⟩ := hu
    rintro ⟨j, hj, hjprev⟩
    rw [weight_reflection] at hj
    rcases lt_trichotomy i j with hij | hij | hij
    · have h := hjprev i hij
      rw [weight_reflection, neg_eq_zero] at h
      exact hi.ne' h
    · subst j
      linarith
    · exact hj.ne' (by simp [hprev j hij])
  constructor
  · exact hdisj θ
  · intro hn
    have hnon := nonPole_has_nonzero_weight θ hθ
    let F : Finset (Fin d) := Finset.univ.filter fun i => θ.weight i ≠ 0
    have hF : F.Nonempty := by
      obtain ⟨i, hi⟩ := hnon
      exact ⟨i, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hi⟩⟩
    let i := F.min' hF
    have hi := (Finset.mem_filter.mp (Finset.min'_mem F hF)).2
    have hprev : ∀ j : Fin d, j < i → θ.weight j = 0 := by
      intro j hj
      by_contra hj0
      have hl := Finset.min'_le F j (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hj0⟩)
      exact (not_lt_of_ge hl) hj
    rcases lt_or_gt_of_ne hi with h | h
    · exfalso
      apply hn
      exact ⟨i, by rw [weight_reflection]; linarith, fun j hj => by rw [weight_reflection, hprev j hj, neg_zero]⟩
    · exact ⟨i, h, hprev⟩

/-- The selected representatives of unoriented affine hyperplanes. -/
abbrev BarronHyperplanes (d : ℕ) := {θ : BarronSphere d // θ ∈ positiveOrientation d}

/-- The quotient map on the sphere without the two constant-activation poles. -/
def hyperplaneQuotient (d : ℕ) : {θ : BarronSphere d // θ ∈ (nonPole d).1} → BarronHyperplanes d :=
  fun θ => if h : θ.1 ∈ positiveOrientation d then ⟨θ.1, h⟩
    else ⟨reflection d θ.1, not_not.mp (mt (positiveOrientation_iff_reflection_notMem θ.1 θ.2).mpr h)⟩

theorem measurable_hyperplaneQuotient (d : ℕ) : Measurable (hyperplaneQuotient d) := by
  apply Measurable.subtype_mk
  change Measurable (fun θ : {θ : BarronSphere d // θ ∈ (nonPole d).1} =>
    (if h : θ.1 ∈ positiveOrientation d then (⟨θ.1, h⟩ : BarronHyperplanes d)
      else ⟨reflection d θ.1, not_not.mp (mt (positiveOrientation_iff_reflection_notMem θ.1 θ.2).mpr h)⟩).1)
  have e : ∀ θ : {θ : BarronSphere d // θ ∈ (nonPole d).1},
      (hyperplaneQuotient d θ).1 =
        if θ.1 ∈ positiveOrientation d then θ.1 else reflection d θ.1 := by
    intro θ
    unfold hyperplaneQuotient
    split <;> rfl
  change Measurable (fun θ => (hyperplaneQuotient d θ).1)
  simp_rw [e]
  exact measurable_subtype_coe.ite ((measurableSet_positiveOrientation d).preimage measurable_subtype_coe)
    ((reflection d).measurable.comp measurable_subtype_coe)

theorem hyperplaneQuotient_fibres (d : ℕ)
    (θ θ' : {θ : BarronSphere d // θ ∈ (nonPole d).1}) :
    hyperplaneQuotient d θ = hyperplaneQuotient d θ' ↔ θ.1 = θ'.1 ∨ θ.1 = reflection d θ'.1 := by
  unfold hyperplaneQuotient
  split <;> split
  · exact ⟨fun he => Or.inl (congrArg (fun u : BarronHyperplanes d => u.1) he), by
      rintro (he | he)
      · exact Subtype.ext he
      · exfalso
        rename_i hθ hθ'
        rw [he] at hθ
        exact ((positiveOrientation_iff_reflection_notMem θ'.1 θ'.2).mp hθ') hθ⟩
  · rename_i hθ hθ'
    constructor
    · intro he
      exact Or.inr (congrArg (fun u : BarronHyperplanes d => u.1) he)
    · rintro (he | he)
      · exact False.elim (hθ' (he ▸ hθ))
      · exact Subtype.ext he
  · rename_i hθ hθ'
    constructor
    · intro he
      have he' := congrArg (fun u : BarronHyperplanes d => u.1) he
      exact Or.inr ((reflection_involutive d θ.1).symm.trans (congrArg (reflection d) he'))
    · rintro (he | he)
      · exact False.elim (hθ (he.symm ▸ hθ'))
      · apply Subtype.ext
        change reflection d θ.1 = θ'.1
        rw [he, reflection_involutive]
  · rename_i hθ hθ'
    constructor
    · intro he
      exact Or.inl ((reflection d).injective (congrArg (fun u : BarronHyperplanes d => u.1) he))
    · rintro (he | he)
      · exact Subtype.ext (congrArg (reflection d) he)
      · exfalso
        have h' := not_not.mp (mt (positiveOrientation_iff_reflection_notMem θ'.1 θ'.2).mpr hθ')
        exact hθ (he ▸ h')

#print axioms BarronSphere.measurable_hyperplaneQuotient
#print axioms BarronSphere.hyperplaneQuotient_fibres


def firstAxisIndex (hd : 1 ≤ d) : Fin d := ⟨0, zero_lt_one.trans_le hd⟩

private theorem first_axis_positive (hd : 1 ≤ d) : axis (firstAxisIndex hd) ∈ positiveOrientation d := by
  refine ⟨firstAxisIndex hd, ?_, ?_⟩
  · rw [weight_axis]
    simp
  · intro j hj
    exact False.elim (Nat.not_lt_zero j.1 hj)

/-- Total extension of the quotient map. Its incidental value at the poles is discarded by restriction. -/
def hyperplaneFold (hd : 1 ≤ d) (θ : BarronSphere d) : BarronHyperplanes d :=
  if h : θ ∈ positiveOrientation d then ⟨θ, h⟩
  else if h' : reflection d θ ∈ positiveOrientation d then ⟨reflection d θ, h'⟩
  else ⟨axis (firstAxisIndex hd), first_axis_positive hd⟩


private theorem hyperplaneFold_val (hd : 1 ≤ d) (θ : BarronSphere d) :
    (hyperplaneFold hd θ).1 =
      if θ ∈ positiveOrientation d then θ
      else if reflection d θ ∈ positiveOrientation d then reflection d θ
      else axis (firstAxisIndex hd) := by
  unfold hyperplaneFold
  split
  · rfl
  · split <;> rfl

theorem measurable_hyperplaneFold (hd : 1 ≤ d) : Measurable (hyperplaneFold hd) := by
  apply Measurable.subtype_mk
  change Measurable (fun θ => (hyperplaneFold hd θ).1)
  simp_rw [hyperplaneFold_val]
  exact measurable_id.ite (measurableSet_positiveOrientation d)
    ((reflection d).measurable.ite ((measurableSet_positiveOrientation d).preimage (reflection d).measurable)
      measurable_const)

theorem hyperplaneFold_section (hd : 1 ≤ d) (v : BarronHyperplanes d) :
    hyperplaneFold hd v.1 = v := by
  apply Subtype.ext
  rw [hyperplaneFold_val, ite_eq_left v.2]

theorem hyperplaneFold_reflection (hd : 1 ≤ d) (θ : BarronSphere d) :
    hyperplaneFold hd (reflection d θ) = hyperplaneFold hd θ := by
  apply Subtype.ext
  simp only [hyperplaneFold_val, reflection_involutive d θ]
  by_cases hp : θ ∈ positiveOrientation d
  · have hn : reflection d θ ∉ positiveOrientation d :=
      (positiveOrientation_iff_reflection_notMem θ (positiveOrientation_subset_nonPole d hp)).mp hp
    simp [hp, hn]
  · by_cases hr : reflection d θ ∈ positiveOrientation d <;> simp [hp, hr]

theorem hyperplaneFold_nonPole (hd : 1 ≤ d) (θ : BarronSphere d) (hθ : θ ∈ (nonPole d).1) :
    hyperplaneFold hd θ = hyperplaneQuotient d ⟨θ, hθ⟩ := by
  unfold hyperplaneFold hyperplaneQuotient
  by_cases hp : θ ∈ positiveOrientation d
  · rw [dite_eq_left hp, dite_eq_left hp]
  · rw [dite_eq_right hp, dite_eq_right hp, dite_eq_left
     (not_not.mp (mt (positiveOrientation_iff_reflection_notMem θ hθ).mpr hp))]

theorem hyperplaneFold_subsets (hd : 1 ≤ d) (E : MeasSet (BarronSphere d))
    (hE : reflection d ⁻¹' E.1 = E.1) :
    ∀ θ ∈ (nonPole d).1, (hyperplaneFold hd θ).1 ∈ E.1 ↔ θ ∈ E.1 := by
  intro θ hθ
  rw [hyperplaneFold_nonPole hd θ hθ]
  unfold hyperplaneQuotient
  split
  · rfl
  · change θ ∈ reflection d ⁻¹' E.1 ↔ _
    rw [hE]

def hyperplaneMeasure (hd : 1 ≤ d) (ρ : Measure (BarronSphere d)) :
    Measure (BarronHyperplanes d) :=
  Measure.map (hyperplaneFold hd) (ρ.restrict (nonPole d).1)

#print axioms BarronSphere.hyperplaneFold_nonPole
#print axioms BarronSphere.hyperplaneFold_reflection
#print axioms BarronSphere.hyperplaneFold_subsets


/-- A symmetric cut on the sphere corresponding to a measurable quotient set. -/
def foldPreimage (hd : 1 ≤ d) (E : MeasSet (BarronHyperplanes d)) : MeasSet (BarronSphere d) :=
  (nonPole d).inter ⟨hyperplaneFold hd ⁻¹' E.1, (measurable_hyperplaneFold hd) E.2⟩

private theorem foldPreimage_symmetric (hd : 1 ≤ d) (E : MeasSet (BarronHyperplanes d)) :
    reflection d ⁻¹' (foldPreimage hd E).1 = (foldPreimage hd E).1 := by
  ext θ
  change (reflection d θ ∈ (nonPole d).1 ∧ hyperplaneFold hd (reflection d θ) ∈ E.1) ↔
    (θ ∈ (nonPole d).1 ∧ hyperplaneFold hd θ ∈ E.1)
  have h : reflection d θ ∈ (nonPole d).1 ↔ θ ∈ (nonPole d).1 := by
    change θ ∈ reflection d ⁻¹' (nonPole d).1 ↔ _
    rw [reflection_preimage_nonPole]
  rw [h, hyperplaneFold_reflection]

private theorem foldPreimage_inter_nonPole (hd : 1 ≤ d) (E : MeasSet (BarronHyperplanes d)) :
    (foldPreimage hd E).inter (nonPole d) = foldPreimage hd E :=
  Subtype.ext (inter_eq_left.mpr inter_subset_left)

private theorem eval_evenPart_foldPreimage (hd : 1 ≤ d) (E : MeasSet (BarronHyperplanes d))
    (μ : FiniteSignedMeasure (BarronSphere d)) :
    eval (foldPreimage hd E) (reflectedEven d μ) = eval (foldPreimage hd E) μ := by
  let A := foldPreimage hd E
  let L := (eval A).toLinearMap
  rw [reflectedEven_apply]
  change L ((1 / 2 : ℝ) • (cut (nonPole d) μ + cut (nonPole d) (pushforward (reflection d) μ))) = _
  rw [map_smul, map_add]
  change (1 / 2 : ℝ) * (eval A (cut (nonPole d) μ) +
    eval A (cut (nonPole d) (pushforward (reflection d) μ))) = eval A μ
  rw [eval_cut, eval_cut, foldPreimage_inter_nonPole, eval_pushforward,
    show (⟨reflection d ⁻¹' A.1, (reflection d).measurable A.2⟩ : MeasSet (BarronSphere d)) = A
      from Subtype.ext (foldPreimage_symmetric hd E)]
  ring

private theorem norm_comp_fold_indicator_eq {ρ : Measure (BarronSphere d)} (hd : 1 ≤ d)
    {p : ℝ≥0∞} {g : BarronHyperplanes d → ℝ} (hg : MemLp g p (hyperplaneMeasure hd ρ)) :
    eLpNorm ((nonPole d).1.indicator (g ∘ hyperplaneFold hd)) p ρ =
      eLpNorm g p (hyperplaneMeasure hd ρ) := by
  rw [eLpNorm_indicator_eq_eLpNorm_restrict (nonPole d).2.nullMeasurableSet]
  exact (eLpNorm_map_measure hg.aestronglyMeasurable (measurable_hyperplaneFold hd).aemeasurable).symm

private theorem memLp_comp_fold_indicator {ρ : Measure (BarronSphere d)} (hd : 1 ≤ d)
    {p : ℝ≥0∞} {g : BarronHyperplanes d → ℝ} (hg : MemLp g p (hyperplaneMeasure hd ρ)) :
    MemLp ((nonPole d).1.indicator (g ∘ hyperplaneFold hd)) p ρ :=
  (memLp_indicator_iff_restrict (nonPole d).2.nullMeasurableSet).mpr
    (hg.comp_of_map (measurable_hyperplaneFold hd).aemeasurable)

/-- Exact norm-preserving lift of a coefficient on the hyperplane quotient, zero at the poles. -/
def hyperplaneLiftCoefficient (hd : 1 ≤ d) {ρ : Measure (BarronSphere d)} {p : ℝ≥0∞}
    (g : Lp ℝ p (hyperplaneMeasure hd ρ)) : Lp ℝ p ρ :=
  (memLp_comp_fold_indicator hd (Lp.memLp g)).toLp ((nonPole d).1.indicator (g ∘ hyperplaneFold hd))

theorem hyperplaneLiftCoefficient_norm (hd : 1 ≤ d) {ρ : Measure (BarronSphere d)} {p : ℝ≥0∞}
    (g : Lp ℝ p (hyperplaneMeasure hd ρ)) : ‖hyperplaneLiftCoefficient hd g‖ = ‖g‖ := by
  rw [hyperplaneLiftCoefficient, Lp.norm_toLp, Lp.norm_def, norm_comp_fold_indicator_eq hd (Lp.memLp g)]

private theorem hyperplaneLiftCoefficient_ae (hd : 1 ≤ d) {ρ : Measure (BarronSphere d)} {p : ℝ≥0∞}
    (g : Lp ℝ p (hyperplaneMeasure hd ρ)) :
    (fun θ => hyperplaneLiftCoefficient hd g θ) =ᵐ[ρ] (nonPole d).1.indicator (g ∘ hyperplaneFold hd) :=
  MemLp.coeFn_toLp _

theorem hyperplaneLiftCoefficient_integral (hd : 1 ≤ d) {ρ : Measure (BarronSphere d)} {p : ℝ≥0∞}
    (g : Lp ℝ p (hyperplaneMeasure hd ρ)) (E : MeasSet (BarronHyperplanes d)) :
    (∫ h in E.1, g h ∂hyperplaneMeasure hd ρ) =
      ∫ θ in (foldPreimage hd E).1, hyperplaneLiftCoefficient hd g θ ∂ρ := by
  let π := hyperplaneFold hd
  rw [integral_congr_ae ((Measure.absolutelyContinuous_of_le Measure.restrict_le_self).ae_le
    (hyperplaneLiftCoefficient_ae hd g))]
  have he : (∫ θ in (foldPreimage hd E).1, (nonPole d).1.indicator (g ∘ π) θ ∂ρ) =
      ∫ θ in (foldPreimage hd E).1, g (π θ) ∂ρ := by
    apply setIntegral_congr_fun (foldPreimage hd E).2
    intro θ hθ
    exact indicator_of_mem hθ.1 _
  rw [he]
  change (∫ h in E.1, g h ∂Measure.map π (ρ.restrict (nonPole d).1)) = _
  rw [setIntegral_map E.2 (Lp.aestronglyMeasurable g) (measurable_hyperplaneFold hd).aemeasurable,
    Measure.restrict_restrict ((measurable_hyperplaneFold hd) E.2)]
  congr 2
  exact inter_comm _ _

#print axioms BarronSphere.hyperplaneLiftCoefficient_norm
#print axioms BarronSphere.hyperplaneLiftCoefficient_integral


private theorem eval_union_disjoint {μ : FiniteSignedMeasure (BarronSphere d)}
    (A B : MeasSet (BarronSphere d)) (hAB : Disjoint A.1 B.1) :
    eval (A.union B) μ = eval A μ + eval B μ := by
  obtain ⟨φ, hφ, rfl⟩ := exists_charge μ
  simp only [eval_ofCharge]
  exact φ.add_union A B hAB

private theorem foldPreimage_subset_positive_and_reflected (hd : 1 ≤ d)
    (A : MeasSet (BarronSphere d)) :
    let E : MeasSet (BarronHyperplanes d) :=
      ⟨Subtype.val ⁻¹' A.1, A.2.preimage measurable_subtype_coe⟩
    let P : MeasSet (BarronSphere d) := ⟨positiveOrientation d, measurableSet_positiveOrientation d⟩
    let B := A.inter P
    let B' : MeasSet (BarronSphere d) := ⟨reflection d ⁻¹' B.1, (reflection d).measurable B.2⟩
    (foldPreimage hd E) = B.union B' ∧ Disjoint B.1 B'.1 := by
  dsimp only
  constructor
  · apply Subtype.ext
    ext θ
    change (θ ∈ (nonPole d).1 ∧ (hyperplaneFold hd θ).1 ∈ A.1) ↔
      (θ ∈ A.1 ∧ θ ∈ positiveOrientation d) ∨
      (reflection d θ ∈ A.1 ∧ reflection d θ ∈ positiveOrientation d)
    have hN : reflection d θ ∈ (nonPole d).1 ↔ θ ∈ (nonPole d).1 := by
      change θ ∈ reflection d ⁻¹' (nonPole d).1 ↔ _
      rw [reflection_preimage_nonPole]
    by_cases hp : θ ∈ positiveOrientation d
    · have hθ : θ ∈ (nonPole d).1 := positiveOrientation_subset_nonPole d hp
      have hr := (positiveOrientation_iff_reflection_notMem θ hθ).mp hp
      simp [hyperplaneFold_val, hθ, hp, hr]
    · by_cases hr : reflection d θ ∈ positiveOrientation d
      · have hθ : θ ∈ (nonPole d).1 := hN.mp (positiveOrientation_subset_nonPole d hr)
        simp [hyperplaneFold_val, hp, hr, hθ]
      · have hn : θ ∉ (nonPole d).1 := fun hθ =>
          hp ((positiveOrientation_iff_reflection_notMem θ hθ).mpr hr)
        simp [hp, hr, hn]
  · apply Set.disjoint_left.mpr
    intro θ hθ hr
    exact (positiveOrientation_iff_reflection_notMem θ
      (positiveOrientation_subset_nonPole d hθ.2)).mp hθ.2 hr.2

theorem evenMeasure_determined_by_fold (hd : 1 ≤ d)
    (μ : FiniteSignedMeasure (BarronSphere d))
    (he : pushforward (reflection d) μ = μ) (hn : cut (nonPole d) μ = μ)
    (hz : ∀ E : MeasSet (BarronHyperplanes d), eval (foldPreimage hd E) μ = 0) : μ = 0 := by
  let P : MeasSet (BarronSphere d) := ⟨positiveOrientation d, measurableSet_positiveOrientation d⟩
  let P' : MeasSet (BarronSphere d) := ⟨reflection d ⁻¹' P.1, (reflection d).measurable P.2⟩
  have hreflection (B : MeasSet (BarronSphere d)) :
      eval ⟨reflection d ⁻¹' B.1, (reflection d).measurable B.2⟩ μ = eval B μ := by
    rw [← eval_pushforward, he]
  have hP (A : MeasSet (BarronSphere d)) : eval (A.inter P) μ = 0 := by
    let E : MeasSet (BarronHyperplanes d) := ⟨Subtype.val ⁻¹' A.1, A.2.preimage measurable_subtype_coe⟩
    let B := A.inter P
    let B' : MeasSet (BarronSphere d) := ⟨reflection d ⁻¹' B.1, (reflection d).measurable B.2⟩
    have h := hz E
    obtain ⟨he', hd'⟩ := foldPreimage_subset_positive_and_reflected hd A
    change foldPreimage hd E = B.union B' at he'
    change Disjoint B.1 B'.1 at hd'
    rw [he', eval_union_disjoint _ _ hd', hreflection B] at h
    change eval B μ = 0
    linarith
  have hP' (A : MeasSet (BarronSphere d)) : eval (A.inter P') μ = 0 := by
    let A' : MeasSet (BarronSphere d) := ⟨reflection d ⁻¹' A.1, (reflection d).measurable A.2⟩
    let B := A'.inter P
    have he' : (⟨reflection d ⁻¹' B.1, (reflection d).measurable B.2⟩ : MeasSet (BarronSphere d)) =
        A.inter P' := by
      apply Subtype.ext
      ext θ
      change (reflection d (reflection d θ) ∈ A.1 ∧ reflection d θ ∈ P.1) ↔
        (θ ∈ A.1 ∧ reflection d θ ∈ P.1)
      rw [reflection_involutive d θ]
    have hh := hreflection B
    rw [he'] at hh
    exact hh.trans (hP A')
  have hNP : P.union P' = nonPole d := by
    apply Subtype.ext
    ext θ
    have hR : reflection d θ ∈ (nonPole d).1 ↔ θ ∈ (nonPole d).1 := by
      change θ ∈ reflection d ⁻¹' (nonPole d).1 ↔ _
      rw [reflection_preimage_nonPole]
    change (θ ∈ positiveOrientation d ∨ reflection d θ ∈ positiveOrientation d) ↔ _
    constructor
    · rintro (hp | hp)
      · exact positiveOrientation_subset_nonPole d hp
      · exact hR.mp (positiveOrientation_subset_nonPole d hp)
    · intro hθ
      by_cases h : θ ∈ positiveOrientation d
      · exact Or.inl h
      · exact Or.inr (not_not.mp (mt (positiveOrientation_iff_reflection_notMem θ hθ).mpr h))
  have hDisj : Disjoint P.1 P'.1 := by
    apply Set.disjoint_left.mpr
    intro θ hθ hθ'
    exact (positiveOrientation_iff_reflection_notMem θ
      (positiveOrientation_subset_nonPole d hθ)).mp hθ hθ'
  apply FiniteSignedMeasure.ext
  intro A
  rw [map_zero]
  have hA : A.inter (nonPole d) = (A.inter P).union (A.inter P') :=
    Subtype.ext (by rw [← hNP]; exact inter_union_distrib_left _ _ _)
  have hv := congrArg (fun μ' => eval A μ') hn
  rw [eval_cut, hA, eval_union_disjoint _ _ (hDisj.mono inter_subset_right inter_subset_right),
    hP A, hP' A, add_zero] at hv
  exact hv.symm

#print axioms BarronSphere.evenMeasure_determined_by_fold



/-- Jensen and the defining set-integral formula for conditional expectation
on a finite measure space. See Mathlib's conditional expectation theorems
MemLp.condExp, MemLp.lpNorm_condExp_le_lpNorm, and setIntegral_condExp. -/
axiom citeConditionalExpectationLp
    {Ω : Type*} [m : MeasurableSpace Ω] (M : {M : MeasurableSpace Ω // M ≤ m})
    (ρ : Measure Ω) [IsFiniteMeasure ρ] {p : ℝ≥0∞} (hp : 1 ≤ p)
    {f : Ω → ℝ} (hf : MemLp f p ρ) (hi : Integrable f ρ) :
    ∃ u : Ω → ℝ, @Measurable Ω ℝ M.1 _ u ∧ MemLp u p ρ ∧ lpNorm u p ρ ≤ lpNorm f p ρ ∧
      ∀ E : Set Ω, @MeasurableSet Ω M.1 E → (∫ x in E, u x ∂ρ) = ∫ x in E, f x ∂ρ

private theorem exists_folded_coefficient (hd : 1 ≤ d)
    (ρ : Measure (BarronSphere d)) [IsFiniteMeasure ρ]
    {p : ℝ≥0∞} (hp₁ : 1 ≤ p) {f : BarronSphere d → ℝ} (hf : MemLp f p ρ)
    (hi : Integrable f ρ) :
    ∃ g : BarronHyperplanes d → ℝ,
      Measurable g ∧ MemLp g p (Measure.map (hyperplaneFold hd) ρ) ∧
      lpNorm g p (Measure.map (hyperplaneFold hd) ρ) ≤ lpNorm f p ρ ∧
      ∀ E : Set (BarronHyperplanes d), MeasurableSet E →
        (∫ h in E, g h ∂Measure.map (hyperplaneFold hd) ρ) =
          ∫ θ in hyperplaneFold hd ⁻¹' E, f θ ∂ρ := by
  let π := hyperplaneFold hd
  have hM := (measurable_hyperplaneFold hd).comap_le
  obtain ⟨u, hu, hug, hun, huE⟩ := citeConditionalExpectationLp ⟨_, hM⟩ ρ hp₁ hf hi
  let g : BarronHyperplanes d → ℝ := fun h => u h.1
  have hgm : Measurable g := (hu.mono hM le_rfl).comp measurable_subtype_coe
  have hEq (θ : BarronSphere d) : g (π θ) = u θ := by
    have hS : @MeasurableSet (BarronSphere d) (MeasurableSpace.comap π inferInstance) (u ⁻¹' {u θ}) :=
      hu (measurableSet_singleton _)
    obtain ⟨E, hE, he⟩ := hS
    have hθ : θ ∈ u ⁻¹' {u θ} := rfl
    have hπ : π θ ∈ E := by
      change θ ∈ π ⁻¹' E
      rwa [he]
    have hfold : (π θ).1 ∈ π ⁻¹' E := by
      change hyperplaneFold hd (hyperplaneFold hd θ).1 ∈ E
      rw [hyperplaneFold_section]
      exact hπ
    rw [he] at hfold
    exact hfold
  have hfg : g ∘ π = u := funext hEq
  have hgg : MemLp g p (Measure.map π ρ) :=
    (memLp_map_measure_iff hgm.aestronglyMeasurable (measurable_hyperplaneFold hd).aemeasurable).mpr
      (hfg ▸ hug)
  refine ⟨g, hgm, hgg, ?_, ?_⟩
  · have he := eLpNorm_map_measure (μ := ρ) (p := p) hgm.aestronglyMeasurable
      (measurable_hyperplaneFold hd).aemeasurable
    rw [hfg] at he
    change (eLpNorm g p (Measure.map π ρ)).toReal ≤ _
    rw [he]
    exact hun
  · intro E hE
    have hPre : @MeasurableSet (BarronSphere d) (MeasurableSpace.comap π inferInstance) (π ⁻¹' E) := ⟨E, hE, rfl⟩
    change (∫ h in E, g h ∂Measure.map π ρ) = _
    rw [setIntegral_map hE hgm.aestronglyMeasurable (measurable_hyperplaneFold hd).aemeasurable]
    change (∫ θ in π ⁻¹' E, (g ∘ π) θ ∂ρ) = _
    rw [hfg]
    exact huE _ hPre

#print axioms BarronSphere.exists_folded_coefficient


instance hyperplaneMeasure_finite (hd : 1 ≤ d) (ρ : Measure (BarronSphere d))
    [IsFiniteMeasure ρ] : IsFiniteMeasure (hyperplaneMeasure hd ρ) := by
  constructor
  change Measure.map (hyperplaneFold hd) (ρ.restrict (nonPole d).1) univ < ∞
  rw [Measure.map_apply (measurable_hyperplaneFold hd) MeasurableSet.univ, preimage_univ]
  exact measure_lt_top _ _

private theorem foldedCoefficient_unique {ρ : Measure (BarronSphere d)} [IsFiniteMeasure ρ]
    (hd : 1 ≤ d) {p : ℝ≥0∞} [Fact (1 ≤ p)]
    (g h : Lp ℝ p (hyperplaneMeasure hd ρ))
    (he : ∀ E : MeasSet (BarronHyperplanes d),
      (∫ u in E.1, g u ∂hyperplaneMeasure hd ρ) = ∫ u in E.1, h u ∂hyperplaneMeasure hd ρ) : g = h := by
  apply Lp.ext
  apply ae_eq_of_forall_setIntegral_eq_of_sigmaFinite
  · intro E _ _
    exact ((Lp.memLp g).integrable (Fact.out : 1 ≤ p)).integrableOn
  · intro E _ _
    exact ((Lp.memLp h).integrable (Fact.out : 1 ≤ p)).integrableOn
  · exact fun E hE _ => he ⟨E, hE⟩

private theorem exists_foldedLp (hd : 1 ≤ d)
    {ρ : Measure (BarronSphere d)} [IsProbabilityMeasure ρ]
    {p : ℝ≥0∞} [Fact (1 ≤ p)] (a : Lp ℝ p ρ) :
    ∃ g : Lp ℝ p (hyperplaneMeasure hd ρ),
      (∀ E : MeasSet (BarronHyperplanes d),
        (∫ h in E.1, g h ∂hyperplaneMeasure hd ρ) = eval (foldPreimage hd E) (densityMap a)) ∧
      ‖g‖ ≤ ‖a‖ := by
  let s := (nonPole d).1
  let π := hyperplaneFold hd
  obtain ⟨g, _, hgp, hnorm, h⟩ := exists_folded_coefficient hd (ρ.restrict s) (Fact.out : 1 ≤ p)
    ((Lp.memLp a).restrict s) ((Lp.memLp a).integrable (Fact.out : 1 ≤ p)).restrict
  let b : Lp ℝ p (hyperplaneMeasure hd ρ) := hgp.toLp g
  refine ⟨b, ?_, ?_⟩
  · intro E
    rw [eval_densityMap]
    have hbf : (fun x => b x) =ᵐ[hyperplaneMeasure hd ρ] g := MemLp.coeFn_toLp hgp
    rw [integral_congr_ae (ae_restrict_le hbf)]
    have h' := h E.1 E.2
    change (∫ u in E.1, g u ∂Measure.map π (ρ.restrict s)) = _
    rw [h', Measure.restrict_restrict ((measurable_hyperplaneFold hd) E.2)]
    congr 2
    exact inter_comm _ _
  · rw [show ‖b‖ = (eLpNorm g p (hyperplaneMeasure hd ρ)).toReal from Lp.norm_toLp g hgp,
      Lp.norm_def]
    exact hnorm.trans (ENNReal.toReal_mono (Lp.memLp a).eLpNorm_ne_top
      (eLpNorm_mono_measure _ Measure.restrict_le_self))

/-- The contractive pushed density on the unoriented parameter space. -/
def foldedLp (hd : 1 ≤ d) {ρ : Measure (BarronSphere d)} [IsProbabilityMeasure ρ]
    {p : ℝ≥0∞} [Fact (1 ≤ p)] :
    Lp ℝ p ρ →L[ℝ] Lp ℝ p (hyperplaneMeasure hd ρ) := by
  let z := fun a : Lp ℝ p ρ => (exists_foldedLp hd a).choose
  have he : ∀ a : Lp ℝ p ρ, ∀ E : MeasSet (BarronHyperplanes d),
      (∫ h in E.1, z a h ∂hyperplaneMeasure hd ρ) = eval (foldPreimage hd E) (densityMap a) :=
    fun a => (exists_foldedLp hd a).choose_spec.1
  refine LinearMap.mkContinuous { toFun := z, map_add' := ?_, map_smul' := ?_ } 1 ?_
  · intro a b
    apply foldedCoefficient_unique hd
    intro E
    rw [integral_congr_ae (ae_restrict_le (Lp.coeFn_add (z a) (z b)))]
    have ha := ((Lp.memLp (z a)).integrable (Fact.out : 1 ≤ p)).integrableOn (s := E.1)
    have hb := ((Lp.memLp (z b)).integrable (Fact.out : 1 ≤ p)).integrableOn (s := E.1)
    have hi := integral_add (μ := (hyperplaneMeasure hd ρ).restrict E.1) ha hb
    change (∫ h in E.1, z (a + b) h ∂hyperplaneMeasure hd ρ) =
      ∫ h in E.1, (z a h + z b h) ∂hyperplaneMeasure hd ρ
    rw [hi, he, he, he, map_add, map_add]
  · intro c a
    apply foldedCoefficient_unique hd
    intro E
    change (∫ h in E.1, z (c • a) h ∂hyperplaneMeasure hd ρ) =
      ∫ h in E.1, (c • z a) h ∂hyperplaneMeasure hd ρ
    rw [integral_congr_ae (ae_restrict_le (Lp.coeFn_smul c (z a)))]
    change (∫ h in E.1, z (c • a) h ∂hyperplaneMeasure hd ρ) =
      ∫ h in E.1, c • z a h ∂hyperplaneMeasure hd ρ
    rw [integral_smul, he, he, map_smul, map_smul]
  · intro a
    change ‖z a‖ ≤ 1 * ‖a‖
    rw [one_mul]
    exact (exists_foldedLp hd a).choose_spec.2

theorem foldedLp_integral (hd : 1 ≤ d) {ρ : Measure (BarronSphere d)} [IsProbabilityMeasure ρ]
    {p : ℝ≥0∞} [Fact (1 ≤ p)] (a : Lp ℝ p ρ) (E : MeasSet (BarronHyperplanes d)) :
    (∫ h in E.1, foldedLp hd a h ∂hyperplaneMeasure hd ρ) = eval (foldPreimage hd E) (densityMap a) :=
  (exists_foldedLp hd a).choose_spec.1 E

theorem foldedLp_contractive (hd : 1 ≤ d) {ρ : Measure (BarronSphere d)} [IsProbabilityMeasure ρ]
    {p : ℝ≥0∞} [Fact (1 ≤ p)] (a : Lp ℝ p ρ) : ‖foldedLp hd a‖ ≤ ‖a‖ :=
  (exists_foldedLp hd a).choose_spec.2

theorem foldedLp_lift (hd : 1 ≤ d) {ρ : Measure (BarronSphere d)} [IsProbabilityMeasure ρ]
    {p : ℝ≥0∞} [Fact (1 ≤ p)] (g : Lp ℝ p (hyperplaneMeasure hd ρ)) :
    foldedLp hd (hyperplaneLiftCoefficient hd g) = g := by
  apply foldedCoefficient_unique hd
  intro E
  rw [foldedLp_integral, eval_densityMap]
  exact (hyperplaneLiftCoefficient_integral hd g E).symm

theorem foldedLp_ker_iff (hd : 1 ≤ d) {ρ : Measure (BarronSphere d)} [IsProbabilityMeasure ρ]
    {p : ℝ≥0∞} [Fact (1 ≤ p)] (a : Lp ℝ p ρ) :
    foldedLp hd a = 0 ↔ reflectedEven d (densityMap a) = 0 := by
  constructor
  · intro h
    refine evenMeasure_determined_by_fold hd (reflectedEven d (densityMap a)) (reflectedEven_even _) (reflectedEven_supported _) ?_
    intro E
    rw [eval_evenPart_foldPreimage, ← foldedLp_integral hd a E, h]
    calc
      _ = ∫ u in E.1, (0 : ℝ) ∂hyperplaneMeasure hd ρ := by
        apply integral_congr_ae
        exact ae_restrict_le (Lp.coeFn_zero ℝ p (hyperplaneMeasure hd ρ))
      _ = 0 := integral_zero _ _
  · intro h
    apply foldedCoefficient_unique hd
    intro E
    rw [foldedLp_integral, ← eval_evenPart_foldPreimage, h, map_zero]
    symm
    calc
      _ = ∫ u in E.1, (0 : ℝ) ∂hyperplaneMeasure hd ρ := by
        apply integral_congr_ae
        exact ae_restrict_le (Lp.coeFn_zero ℝ p (hyperplaneMeasure hd ρ))
      _ = 0 := integral_zero _ _

#print axioms BarronSphere.foldedLp_lift
#print axioms BarronSphere.foldedLp_ker_iff



/-- Pullback to the non-pole sphere as a linear isometry. -/
def hyperplaneLift (hd : 1 ≤ d) {ρ : Measure (BarronSphere d)} {p : ℝ≥0∞}
    [Fact (1 ≤ p)] : Lp ℝ p (hyperplaneMeasure hd ρ) →ₗᵢ[ℝ] Lp ℝ p ρ := by
  let π := hyperplaneFold hd
  let s := (nonPole d).1
  have hm : Measurable π := measurable_hyperplaneFold hd
  refine { toFun := hyperplaneLiftCoefficient hd
           map_add' := ?_
           map_smul' := ?_
           norm_map' := hyperplaneLiftCoefficient_norm hd }
  · intro g h
    apply Lp.ext
    have hcomp := (ae_restrict_iff' (nonPole d).2).mp
      (ae_eq_comp (μ := ρ.restrict s) hm.aemeasurable (Lp.coeFn_add g h))
    filter_upwards [hyperplaneLiftCoefficient_ae hd (g + h),
      hyperplaneLiftCoefficient_ae hd g, hyperplaneLiftCoefficient_ae hd h,
      Lp.coeFn_add (hyperplaneLiftCoefficient hd g) (hyperplaneLiftCoefficient hd h),
      hcomp] with θ hI hG hH hS hC
    rw [hI, hS]
    change s.indicator ((⇑(g + h)) ∘ π) θ =
      hyperplaneLiftCoefficient hd g θ + hyperplaneLiftCoefficient hd h θ
    rw [hG, hH]
    by_cases ht : θ ∈ s
    · rw [indicator_of_mem ht, indicator_of_mem ht, indicator_of_mem ht]
      exact hC ht
    · rw [indicator_of_notMem ht, indicator_of_notMem ht, indicator_of_notMem ht, add_zero]
  · intro c g
    apply Lp.ext
    have hcomp := (ae_restrict_iff' (nonPole d).2).mp
      (ae_eq_comp (μ := ρ.restrict s) hm.aemeasurable (Lp.coeFn_smul c g))
    filter_upwards [hyperplaneLiftCoefficient_ae hd (c • g), hyperplaneLiftCoefficient_ae hd g,
      Lp.coeFn_smul c (hyperplaneLiftCoefficient hd g), hcomp] with θ hI hG hS hC
    simp only [RingHom.id_apply]
    rw [hI, hS]
    change s.indicator ((⇑(c • g)) ∘ π) θ = c • hyperplaneLiftCoefficient hd g θ
    rw [hG]
    by_cases ht : θ ∈ s
    · rw [indicator_of_mem ht, indicator_of_mem ht]
      exact hC ht
    · rw [indicator_of_notMem ht, indicator_of_notMem ht, smul_zero]

def foldStage (hd : 1 ≤ d) (ρ : BarronControl d) {p : ℝ≥0∞}
    [Fact (1 ≤ p)] (hp : p ≠ ⊤) :
    (barronStage hd ρ p hp).Quotient →L[ℝ] Lp ℝ p (hyperplaneMeasure hd ρ.1) := by
  let Q := barronStage hd ρ p hp
  refine Q.synthesisToOriginal.ker.liftQL (foldedLp hd) ?_
  intro a ha
  change synthesisQuotient d (densityMap a) = 0 at ha
  change foldedLp hd a = 0
  rw [foldedLp_ker_iff, ← evenPart_synthesisQuotient hd, ha, map_zero]

theorem foldStage_synthesis (hd : 1 ≤ d) (ρ : BarronControl d) {p : ℝ≥0∞}
    [Fact (1 ≤ p)] (hp : p ≠ ⊤) (a : Lp ℝ p ρ.1) :
    foldStage hd ρ hp ((barronStage hd ρ p hp).synthesis a) = foldedLp hd a := rfl

theorem foldStage_kernel (hd : 1 ≤ d) (ρ : BarronControl d) {p : ℝ≥0∞}
    [Fact (1 ≤ p)] (hp : p ≠ ⊤) (z : (barronStage hd ρ p hp).Quotient) :
    foldStage hd ρ hp z = 0 ↔ evenPart hd ((barronStage hd ρ p hp).inclusion z) = 0 := by
  let Q := barronStage hd ρ p hp
  obtain ⟨a, rfl⟩ := Q.synthesis_surjective z
  rw [foldStage_synthesis, foldedLp_ker_iff, Q.inclusion_synthesis, evenPart_synthesisQuotient]
  rfl

theorem foldStage_contractive (hd : 1 ≤ d) (ρ : BarronControl d) {p : ℝ≥0∞}
    [Fact (1 ≤ p)] (hp : p ≠ ⊤) (z : (barronStage hd ρ p hp).Quotient) :
    ‖foldStage hd ρ hp z‖ ≤ ‖z‖ := by
  let Q := barronStage hd ρ p hp
  refine le_of_forall_pos_le_add fun ε hε => ?_
  obtain ⟨a, ha, hn⟩ := Submodule.Quotient.norm_mk_lt z hε
  change Q.synthesis a = z at ha
  rw [← ha, foldStage_synthesis, ha]
  exact (foldedLp_contractive hd a).trans hn.le

instance foldStage_kernel_closed (hd : 1 ≤ d) (ρ : BarronControl d) {p : ℝ≥0∞}
    [Fact (1 ≤ p)] (hp : p ≠ ⊤) :
    IsClosed ((foldStage hd ρ hp).ker : Set (barronStage hd ρ p hp).Quotient) :=
  (foldStage hd ρ hp).isClosed_ker

abbrev BarronLocalAffineQuotient (hd : 1 ≤ d) (ρ : BarronControl d) {p : ℝ≥0∞}
    [Fact (1 ≤ p)] (hp : p ≠ ⊤) :=
  (barronStage hd ρ p hp).Quotient ⧸ (foldStage hd ρ hp).ker

/-- The induced coefficient map on the quotient by the affine subspace. -/
def quotientFoldStage (hd : 1 ≤ d) (ρ : BarronControl d) {p : ℝ≥0∞}
    [Fact (1 ≤ p)] (hp : p ≠ ⊤) :
    BarronLocalAffineQuotient hd ρ hp →L[ℝ] Lp ℝ p (hyperplaneMeasure hd ρ.1) :=
  (foldStage hd ρ hp).ker.liftQL (foldStage hd ρ hp) le_rfl

set_option maxHeartbeats 2000000 in
theorem quotientFoldStage_isometry_onto (hd : 1 ≤ d) (ρ : BarronControl d) {p : ℝ≥0∞}
    [Fact (1 ≤ p)] (hp : p ≠ ⊤) :
    (∀ z, ‖quotientFoldStage hd ρ hp z‖ = ‖z‖) ∧ Function.Surjective (quotientFoldStage hd ρ hp) := by
  let Q := barronStage hd ρ p hp
  let W := foldStage hd ρ hp
  let q := W.ker.mkQL
  let F := quotientFoldStage hd ρ hp
  have hF (z : Q.Quotient) : F (q z) = W z := rfl
  let U := fun g : Lp ℝ p (hyperplaneMeasure hd ρ.1) => Q.synthesis (hyperplaneLiftCoefficient hd g)
  have hU (g : Lp ℝ p (hyperplaneMeasure hd ρ.1)) : W (U g) = g := by
    rw [show U g = Q.synthesis (hyperplaneLiftCoefficient hd g) from rfl,
      foldStage_synthesis, foldedLp_lift]
  have hUn (g : Lp ℝ p (hyperplaneMeasure hd ρ.1)) : ‖U g‖ ≤ ‖g‖ := by
    exact (Submodule.Quotient.norm_mk_le Q.synthesisToOriginal.ker _).trans_eq
      (hyperplaneLiftCoefficient_norm hd g)
  constructor
  · intro z
    apply le_antisymm
    · refine le_of_forall_pos_le_add fun ε hε => ?_
      obtain ⟨y, hy, hn⟩ := Submodule.Quotient.norm_mk_lt z hε
      change q y = z at hy
      rw [← hy, hF, hy]
      exact (foldStage_contractive hd ρ hp y).trans hn.le
    · obtain ⟨y, rfl⟩ := W.ker.mkQ_surjective z
      let g := W y
      have ht : (Submodule.Quotient.mk (U g) : BarronLocalAffineQuotient hd ρ hp) =
          Submodule.Quotient.mk y := by
        apply (Submodule.Quotient.eq W.ker).mpr
        change W (U g - y) = 0
        rw [map_sub, hU]
        exact sub_self _
      change ‖(Submodule.Quotient.mk y : BarronLocalAffineQuotient hd ρ hp)‖ ≤ ‖g‖
      rw [← ht]
      exact (Submodule.Quotient.norm_mk_le W.ker (U g)).trans (hUn g)
  · intro g
    exact ⟨q (U g), (hF (U g)).trans (hU g)⟩

#print axioms BarronSphere.foldStage_kernel
#print axioms BarronSphere.quotientFoldStage_isometry_onto


private def hyperplaneCut (_hd : 1 ≤ d) (E : MeasSet (BarronSphere d)) :
    MeasSet (BarronHyperplanes d) :=
  ⟨Subtype.val ⁻¹' E.1, E.2.preimage measurable_subtype_coe⟩

private theorem foldPreimage_inter_hyperplaneCut (hd : 1 ≤ d) (E : MeasSet (BarronSphere d))
    (hE : reflection d ⁻¹' E.1 = E.1) (B : MeasSet (BarronHyperplanes d)) :
    foldPreimage hd (B.inter (hyperplaneCut hd E)) = (foldPreimage hd B).inter E := by
  apply Subtype.ext
  ext θ
  change (θ ∈ (nonPole d).1 ∧ (hyperplaneFold hd θ ∈ B.1 ∧ (hyperplaneFold hd θ).1 ∈ E.1)) ↔
    (θ ∈ (nonPole d).1 ∧ hyperplaneFold hd θ ∈ B.1) ∧ θ ∈ E.1
  constructor
  · rintro ⟨hn, hb, he⟩
    exact ⟨⟨hn, hb⟩, (hyperplaneFold_subsets hd E hE θ hn).mp he⟩
  · rintro ⟨⟨hn, hb⟩, he⟩
    exact ⟨hn, hb, (hyperplaneFold_subsets hd E hE θ hn).mpr he⟩

private theorem foldedLp_cut_formula (hd : 1 ≤ d) {ρ : Measure (BarronSphere d)} [IsProbabilityMeasure ρ]
    {p : ℝ≥0∞} [Fact (1 ≤ p)] (E : MeasSet (BarronSphere d)) (hE : reflection d ⁻¹' E.1 = E.1)
    (a : Lp ℝ p ρ) :
    (fun h => foldedLp hd (lpCut E a) h) =ᵐ[hyperplaneMeasure hd ρ]
      (hyperplaneCut hd E).1.indicator (⇑(foldedLp hd a)) := by
  let ν := hyperplaneMeasure hd ρ
  let G := hyperplaneCut hd E
  let f := foldedLp hd a
  apply ae_eq_of_forall_setIntegral_eq_of_sigmaFinite
  · intro s _ _
    exact ((Lp.memLp (foldedLp hd (lpCut E a))).integrable (Fact.out : 1 ≤ p)).integrableOn
  · intro s _ _
    exact (((Lp.memLp f).integrable (Fact.out : 1 ≤ p)).indicator G.2).integrableOn
  · intro s hs _
    let B : MeasSet (BarronHyperplanes d) := ⟨s, hs⟩
    rw [foldedLp_integral hd _ B, densityMap_lpCut, eval_cut]
    change _ = ∫ h in B.1, G.1.indicator (⇑f) h ∂ν
    rw [setIntegral_indicator G.2]
    change eval ((foldPreimage hd B).inter E) (densityMap a) =
      ∫ h in (B.inter G).1, foldedLp hd a h ∂hyperplaneMeasure hd ρ
    rw [foldedLp_integral hd a (B.inter G), foldPreimage_inter_hyperplaneCut hd E hE]

theorem foldStage_localOVM_cut (hd : 1 ≤ d) (ρ : BarronControl d)
    {p : ℝ≥0∞} [Fact (1 ≤ p)] (hp : p ≠ ⊤) (E : MeasSet (BarronSphere d))
    (hE : reflection d ⁻¹' E.1 = E.1) (z : (barronStage hd ρ p hp).Quotient) :
    (fun h => foldStage hd ρ hp ((barronStage hd ρ p hp).localOVM.val E z) h) =ᵐ[hyperplaneMeasure hd ρ.1]
      (hyperplaneCut hd E).1.indicator (⇑(foldStage hd ρ hp z)) := by
  let Q := barronStage hd ρ p hp
  let W := foldStage hd ρ hp
  let a := Q.analysis z
  have he : W (Q.localOVM.val E z) = foldedLp hd (lpCut E a) := rfl
  have hz : W z = foldedLp hd a := by
    rw [← Q.synthesis_analysis (synthesisQuotient_canonicalSection hd) z] at *
    exact foldStage_synthesis hd ρ hp _
  change (fun h => W (Q.localOVM.val E z) h) =ᵐ[hyperplaneMeasure hd ρ.1]
    (hyperplaneCut hd E).1.indicator (⇑(W z))
  rw [he, hz]
  exact foldedLp_cut_formula hd E hE a

theorem norm_localAffine_localization_exact (hd : 1 ≤ d) (ρ : BarronControl d)
    {p : ℝ≥0∞} [Fact (1 ≤ p)] (hp : p ≠ ⊤) (E : MeasSet (BarronSphere d))
    (hE : reflection d ⁻¹' E.1 = E.1) (z : (barronStage hd ρ p hp).Quotient) :
    let q := (foldStage hd ρ hp).ker.mkQL
    let ν := hyperplaneMeasure hd ρ.1
    ‖q (z - (barronStage hd ρ p hp).localOVM.val E z)‖ =
      (eLpNorm ((hyperplaneCut hd E).1ᶜ.indicator (⇑(foldStage hd ρ hp z))) p ν).toReal := by
  let Q := barronStage hd ρ p hp
  let W := foldStage hd ρ hp
  let ν := hyperplaneMeasure hd ρ.1
  let G := hyperplaneCut hd E
  let q := W.ker.mkQL
  let w := z - Q.localOVM.val E z
  have h := (quotientFoldStage_isometry_onto hd ρ hp).1 (q w)
  change ‖W w‖ = ‖q w‖ at h
  change ‖q w‖ = _
  rw [← h, Lp.norm_def]
  congr 1
  apply eLpNorm_congr_ae
  rw [show W w = W z - W (Q.localOVM.val E z) from map_sub W _ _]
  filter_upwards [Lp.coeFn_sub (W z) (W (Q.localOVM.val E z)),
    foldStage_localOVM_cut hd ρ hp E hE z] with θ hsub hcut
  rw [hsub]
  change W z θ - W (Q.localOVM.val E z) θ = G.1ᶜ.indicator (⇑(W z)) θ
  rw [hcut]
  by_cases hg : θ ∈ G.1
  · rw [indicator_of_mem hg, sub_self, indicator_of_notMem (by simpa using hg)]
  · rw [indicator_of_notMem hg, sub_zero, indicator_of_mem hg]

#print axioms BarronSphere.foldStage_localOVM_cut
#print axioms BarronSphere.norm_localAffine_localization_exact


private theorem exists_lp_pointMass (ρ : BarronControl d)
    {p : ℝ≥0∞} [Fact (1 ≤ p)] (u : BarronSphere d) (hu : ρ.1 {u} ≠ 0) :
    ∃ a : Lp ℝ p ρ.1, densityMap a = pointMass u := by
  let K := ((ρ.1 {u}).toReal)⁻¹
  let f := atomicDensity ρ.1 u
  obtain ⟨hf, he⟩ := pointMass_density u hu
  have htop : MemLp f ⊤ ρ.1 := by
    refine memLp_top_of_bound hf.aestronglyMeasurable K (Eventually.of_forall fun t => ?_)
    have hK : 0 ≤ K := inv_nonneg.mpr ENNReal.toReal_nonneg
    by_cases ht : t ∈ ({u} : Set (BarronSphere d))
    · change ‖({u} : Set (BarronSphere d)).indicator (fun _ => K) t‖ ≤ _
      rw [indicator_of_mem ht, Real.norm_of_nonneg hK]
    · change ‖({u} : Set (BarronSphere d)).indicator (fun _ => K) t‖ ≤ _
      rw [indicator_of_notMem ht, norm_zero]
      exact hK
  have h := htop.mono_exponent (show p ≤ (⊤ : ℝ≥0∞) from le_top)
  exact ⟨h.toLp f, (ofDensity_congr (integrable_Lp _) hf (MemLp.coeFn_toLp h)).trans he.symm⟩

theorem affineFunctions_in_barronStage (hd : 1 ≤ d) (ρ : BarronControl d)
    {p : ℝ≥0∞} [Fact (1 ≤ p)] (hp : p ≠ ⊤) (v : (Fin d → ℝ) × ℝ) :
    ∃ z : (barronStage hd ρ p hp).Quotient,
      (barronStage hd ρ p hp).inclusion z = synthesisQuotient d (affineAtoms d v) := by
  have hAxes (i : Fin d) := exists_lp_pointMass (p := p) ρ (axis i) (ρ.2.2.2.1 i).1.ne'
  have hAxes' (i : Fin d) := exists_lp_pointMass (p := p) ρ (axisMinus i) (ρ.2.2.2.1 i).2.ne'
  choose a ha using hAxes
  choose b hb using hAxes'
  obtain ⟨c, hc⟩ := exists_lp_pointMass (p := p) ρ (polePlus d) (ρ.2.2.2.2.1).ne'
  let y := (∑ i, v.1 i • (a i - b i)) + v.2 • c
  refine ⟨(barronStage hd ρ p hp).synthesis y, ?_⟩
  rw [MeasureDensityStage.inclusion_synthesis]
  change synthesisQuotient d (densityMap y) = synthesisQuotient d (affineAtoms d v)
  congr 1
  unfold y
  rw [affineAtoms_apply, map_add, map_sum, map_smul, hc]
  congr 1
  apply Finset.sum_congr rfl
  intro i _
  rw [map_smul, map_sub, ha, hb]

theorem foldStage_is_pushed_even_density (hd : 1 ≤ d) (ρ : BarronControl d)
    {p : ℝ≥0∞} [Fact (1 ≤ p)] (hp : p ≠ ⊤)
    (z : (barronStage hd ρ p hp).Quotient) (E : MeasSet (BarronHyperplanes d)) :
    (∫ h in E.1, foldStage hd ρ hp z h ∂hyperplaneMeasure hd ρ.1) =
      eval (foldPreimage hd E) (evenPart hd ((barronStage hd ρ p hp).inclusion z)) := by
  let Q := barronStage hd ρ p hp
  obtain ⟨a, rfl⟩ := Q.synthesis_surjective z
  rw [foldStage_synthesis, foldedLp_integral, Q.inclusion_synthesis, evenPart_synthesisQuotient]
  exact (eval_evenPart_foldPreimage hd E (densityMap a)).symm

#print axioms BarronSphere.affineFunctions_in_barronStage
#print axioms BarronSphere.foldStage_is_pushed_even_density

section FoldedMultiplierCompactness

variable {H : Type*} [MeasurableSpace H] {ν : Measure H} [IsFiniteMeasure ν]
  {p : ℝ≥0∞} [Fact (1 ≤ p)]

private theorem noncompact_of_disjoint_coefficient_cuts (pTop : p ≠ ⊤)
    (M : Lp ℝ p ν →L[ℝ] Lp ℝ p ν) (k : H → ℝ)
    (hM : ∀ g, (fun x => M g x) =ᵐ[ν] fun x => k x * g x)
    (A : ℕ → MeasSet H) (hA : MeasSet.DisjointSeq A)
    (hpos : ∀ n, 0 < ν (A n).1)
    (c : ℝ) (hc : 0 < c) (hk : ∀ n, ∀ x ∈ (A n).1, c ≤ k x) :
    ¬ IsCompactOperator M := by
  have hp0 : p ≠ 0 := ne_of_gt (zero_lt_one.trans_le (Fact.out : 1 ≤ p))
  let y (n : ℕ) := indicatorConstLp p (A n).2 (measure_ne_top ν (A n).1) (1 : ℝ)
  have hy (n : ℕ) : (fun t => y n t) =ᵐ[ν] (A n).1.indicator (fun _ => 1) := indicatorConstLp_coeFn
  have hpY (n : ℕ) : 0 < ‖y n‖ := by
    rw [show ‖y n‖ = ‖indicatorConstLp p (A n).2 (measure_ne_top ν (A n).1) (1 : ℝ)‖ from rfl,
      norm_indicatorConstLp hp0 pTop, norm_one, one_mul]
    exact Real.rpow_pos_of_pos (ENNReal.toReal_pos (hpos n).ne' (measure_ne_top ν _)) _
  let u (n : ℕ) := ‖y n‖⁻¹ • y n
  have hun (n : ℕ) : ‖u n‖ = 1 := by
    dsimp only [u]
    rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr (norm_nonneg _)), inv_mul_cancel₀ (hpY n).ne']
  have hu (n : ℕ) : (fun t => u n t) =ᵐ[ν] (A n).1.indicator (fun _ => ‖y n‖⁻¹) := by
    filter_upwards [Lp.coeFn_smul (‖y n‖⁻¹) (y n), hy n] with t h1 h2
    rw [show u n t = ‖y n‖⁻¹ * y n t from h1, h2]
    by_cases ht : t ∈ (A n).1 <;> simp [Set.indicator, ht]
  have hd (i j : ℕ) (hij : i ≠ j) : c ≤ dist (M (u i)) (M (u j)) := by
    have hae : ∀ᵐ t ∂ν, ‖(c • u i) t‖ ≤ ‖(M (u i) - M (u j)) t‖ := by
      filter_upwards [Lp.coeFn_smul c (u i), Lp.coeFn_sub (M (u i)) (M (u j)),
        hM (u i), hM (u j), hu i, hu j] with t hs hsub hI hJ hi hj
      rw [hs, hsub]
      change ‖c * u i t‖ ≤ ‖M (u i) t - M (u j) t‖
      rw [hI, hJ, hi, hj]
      by_cases ht : t ∈ (A i).1
      · have hn : t ∉ (A j).1 := fun hj' => Set.disjoint_left.mp (hA hij) ht hj'
        rw [indicator_of_mem ht, indicator_of_notMem hn, mul_zero, sub_zero]
        have hki := hk i t ht
        have hnorm : 0 ≤ ‖y i‖⁻¹ := inv_nonneg.mpr (norm_nonneg _)
        rw [Real.norm_of_nonneg (mul_nonneg hc.le hnorm),
          Real.norm_of_nonneg (mul_nonneg (hc.le.trans hki) hnorm)]
        exact mul_le_mul_of_nonneg_right hki hnorm
      · rw [indicator_of_notMem ht, mul_zero, norm_zero]
        exact norm_nonneg _
    have hnorm : ‖c • u i‖ ≤ ‖M (u i) - M (u j)‖ := by
      rw [Lp.norm_def, Lp.norm_def]
      exact ENNReal.toReal_mono (Lp.memLp _).eLpNorm_ne_top (eLpNorm_mono_ae (Lp.aestronglyMeasurable (c • u i)) hae)
    rw [norm_smul, Real.norm_of_nonneg hc.le, hun, mul_one, ← dist_eq_norm] at hnorm
    exact hnorm
  intro hCompact
  have hclosed := hCompact.isCompact_closure_image_closedBall (f := M.toLinearMap) 1
  have hm (n : ℕ) : M (u n) ∈ closure (M '' Metric.closedBall 0 1) :=
    subset_closure ⟨u n, mem_closedBall_zero_iff.mpr (hun n).le, rfl⟩
  obtain ⟨z, _, φ, hφ, hz⟩ := hclosed.isSeqCompact hm
  obtain ⟨N, hN⟩ := Metric.cauchySeq_iff.mp hz.cauchySeq c hc
  exact (not_lt_of_ge (hd (φ N) (φ (N + 1)) (hφ.injective.ne (by omega))))
    (hN N le_rfl (N + 1) (by omega))

#print axioms BarronSphere.noncompact_of_disjoint_coefficient_cuts

end FoldedMultiplierCompactness

/-- The average of the two indicators in an antipodal orbit. -/
def hyperplaneMultiplier (E : MeasSet (BarronSphere d)) (u : BarronHyperplanes d) : ℝ :=
  (1 / 2 : ℝ) * (E.1.indicator (fun _ => (1 : ℝ)) u.1 +
    E.1.indicator (fun _ => (1 : ℝ)) (reflection d u.1))

theorem measurable_hyperplaneMultiplier (E : MeasSet (BarronSphere d)) :
    Measurable (hyperplaneMultiplier E) := by
  let I := E.1.indicator (fun _ => (1 : ℝ))
  have hi : Measurable I := measurable_const.indicator E.2
  exact ((hi.comp measurable_subtype_coe).add
    (hi.comp ((reflection d).measurable.comp measurable_subtype_coe))).const_mul _

theorem hyperplaneMultiplier_nonneg_le_one (E : MeasSet (BarronSphere d)) (u : BarronHyperplanes d) :
    0 ≤ hyperplaneMultiplier E u ∧ hyperplaneMultiplier E u ≤ 1 := by
  unfold hyperplaneMultiplier
  by_cases h₁ : u.1 ∈ E.1 <;> by_cases h₂ : reflection d u.1 ∈ E.1 <;> norm_num [h₁, h₂]

private theorem hyperplaneMultiplier_comp_fold (hd : 1 ≤ d) (E : MeasSet (BarronSphere d))
    (θ : BarronSphere d) (hθ : θ ∈ (nonPole d).1) :
    hyperplaneMultiplier E (hyperplaneFold hd θ) =
      (1 / 2 : ℝ) * (E.1.indicator (fun _ => (1 : ℝ)) θ +
        E.1.indicator (fun _ => (1 : ℝ)) (reflection d θ)) := by
  unfold hyperplaneMultiplier
  rw [hyperplaneFold_nonPole hd θ hθ]
  unfold hyperplaneQuotient
  split
  · rfl
  · change (1 / 2 : ℝ) * (E.1.indicator (fun _ => (1 : ℝ)) (reflection d θ) +
        E.1.indicator (fun _ => (1 : ℝ)) (reflection d (reflection d θ))) = _
    rw [reflection_involutive d θ, add_comm]

private theorem setIntegral_reflection {ρ : Measure (BarronSphere d)}
    (hρ : Measure.map (reflection d) ρ = ρ) (E : MeasSet (BarronSphere d))
    {f : BarronSphere d → ℝ} (hf : StronglyMeasurable f) :
    (∫ θ in reflection d ⁻¹' E.1, f (reflection d θ) ∂ρ) = ∫ θ in E.1, f θ ∂ρ := by
  have h := setIntegral_map (μ := ρ) E.2 hf.aestronglyMeasurable (reflection d).measurable.aemeasurable
  rw [hρ] at h
  exact h.symm

private theorem hyperplaneLift_density_even (hd : 1 ≤ d)
    {ρ : Measure (BarronSphere d)} [IsProbabilityMeasure ρ]
    (hρ : Measure.map (reflection d) ρ = ρ) {p : ℝ≥0∞} [Fact (1 ≤ p)]
    (g : Lp ℝ p (hyperplaneMeasure hd ρ)) :
    let μ := densityMap (hyperplaneLiftCoefficient hd g)
    pushforward (reflection d) μ = μ ∧ cut (nonPole d) μ = μ := by
  let a := hyperplaneLiftCoefficient hd g
  let f := (nonPole d).1.indicator (g ∘ hyperplaneFold hd)
  have hf : StronglyMeasurable f :=
    ((Lp.stronglyMeasurable g).comp_measurable (measurable_hyperplaneFold hd)).indicator (nonPole d).2
  have hAE := hyperplaneLiftCoefficient_ae hd g
  have hs (θ : BarronSphere d) : f (reflection d θ) = f θ := by
    have hN : reflection d θ ∈ (nonPole d).1 ↔ θ ∈ (nonPole d).1 := by
      change θ ∈ reflection d ⁻¹' (nonPole d).1 ↔ _
      rw [reflection_preimage_nonPole]
    by_cases he : θ ∈ (nonPole d).1
    · unfold f
      rw [indicator_of_mem (hN.mpr he), indicator_of_mem he]
      change g (hyperplaneFold hd (reflection d θ)) = g (hyperplaneFold hd θ)
      rw [hyperplaneFold_reflection]
    · unfold f
      rw [indicator_of_notMem (fun hn => he (hN.mp hn)), indicator_of_notMem he]
  constructor
  · apply FiniteSignedMeasure.ext
    intro E
    rw [eval_pushforward, eval_densityMap, eval_densityMap]
    rw [integral_congr_ae (ae_restrict_le hAE), integral_congr_ae (ae_restrict_le hAE)]
    have h := setIntegral_reflection hρ E hf
    simp_rw [hs] at h
    exact h
  · have hcut : lpCut (nonPole d) a = a := by
      apply Lp.ext
      filter_upwards [lpCut_ae (nonPole d) a, hAE] with θ h1 h2
      rw [h1]
      by_cases ht : θ ∈ (nonPole d).1
      · rw [indicator_of_mem ht]
      · rw [indicator_of_notMem ht, h2]
        exact (indicator_of_notMem ht _).symm
    change cut (nonPole d) (densityMap a) = densityMap a
    rw [← densityMap_lpCut]
    exact congrArg densityMap hcut

theorem hyperplaneLift_local_fixed (hd : 1 ≤ d) (ρ : BarronControl d)
    (hρ : Measure.map (reflection d) ρ.1 = ρ.1) {p : ℝ≥0∞} [Fact (1 ≤ p)] (hp : p ≠ ⊤)
    (g : Lp ℝ p (hyperplaneMeasure hd ρ.1)) :
    (barronStage hd ρ p hp).localProjection (hyperplaneLiftCoefficient hd g) =
      hyperplaneLiftCoefficient hd g := by
  let a := hyperplaneLiftCoefficient hd g
  obtain ⟨he, hn⟩ := hyperplaneLift_density_even hd hρ g
  have hC := reflectedEven_eq_of_even_supported (densityMap a) he hn
  apply densityMap_injective (ρ := ρ.1) (p := p)
  exact ((exists_localBarronProjection ρ p hp).choose_spec a).trans
    (canonicalProjection_even _ hC)

/-- The exact compressed operator on hyperplane coefficients in the symmetric model. -/
def foldedLocalizedOperator (hd : 1 ≤ d) (ρ : BarronControl d)
    {p : ℝ≥0∞} [Fact (1 ≤ p)] (hp : p ≠ ⊤) (E : MeasSet (BarronSphere d)) :
    Lp ℝ p (hyperplaneMeasure hd ρ.1) →L[ℝ] Lp ℝ p (hyperplaneMeasure hd ρ.1) :=
  let Q := barronStage hd ρ p hp
  (foldStage hd ρ hp).comp ((Q.localOVM.val E).comp (Q.synthesis.comp (hyperplaneLift hd).toContinuousLinearMap))

#print axioms BarronSphere.hyperplaneLift_local_fixed


theorem foldedLocalizedOperator_is_multiplier (hd : 1 ≤ d) (ρ : BarronControl d)
    (hρ : Measure.map (reflection d) ρ.1 = ρ.1)
    {p : ℝ≥0∞} [Fact (1 ≤ p)] (hp : p ≠ ⊤) (E : MeasSet (BarronSphere d))
    (g : Lp ℝ p (hyperplaneMeasure hd ρ.1)) :
    (fun u => foldedLocalizedOperator hd ρ hp E g u) =ᵐ[hyperplaneMeasure hd ρ.1]
      fun u => hyperplaneMultiplier E u * g u := by
  let ν := hyperplaneMeasure hd ρ.1
  let a := hyperplaneLiftCoefficient hd g
  let F := (nonPole d).1.indicator ((⇑g) ∘ hyperplaneFold hd)
  let D := E.1.indicator F
  let D' := D ∘ reflection d
  have hsym (θ : BarronSphere d) : F (reflection d θ) = F θ := by
    have ht : reflection d θ ∈ (nonPole d).1 ↔ θ ∈ (nonPole d).1 := by
      change θ ∈ reflection d ⁻¹' (nonPole d).1 ↔ _
      rw [reflection_preimage_nonPole]
    unfold F
    by_cases hn : θ ∈ (nonPole d).1
    · rw [indicator_of_mem (ht.mpr hn), indicator_of_mem hn]
      change g (hyperplaneFold hd (reflection d θ)) = g (hyperplaneFold hd θ)
      rw [hyperplaneFold_reflection]
    · rw [indicator_of_notMem (fun hr => hn (ht.mp hr)), indicator_of_notMem hn]
  let Q := barronStage hd ρ p hp
  have hout : foldedLocalizedOperator hd ρ hp E g = foldedLp hd (lpCut E a) := by
    change foldStage hd ρ hp (Q.synthesis (Q.multiplication.val E (Q.analysis (Q.synthesis a)))) = _
    rw [Q.analysis_synthesis, hyperplaneLift_local_fixed hd ρ hρ hp g, foldStage_synthesis]
    rfl
  rw [hout]
  have hg : Integrable (⇑g) ν := (Lp.memLp g).integrable (Fact.out : 1 ≤ p)
  have hkm : StronglyMeasurable (fun u => hyperplaneMultiplier E u * g u) :=
    (measurable_hyperplaneMultiplier E).stronglyMeasurable.mul (Lp.stronglyMeasurable g)
  have hkg : Integrable (fun u => hyperplaneMultiplier E u * g u) ν := by
    apply hg.mono hkm.aestronglyMeasurable
    exact Eventually.of_forall (fun u => by
      rw [norm_mul, Real.norm_of_nonneg (hyperplaneMultiplier_nonneg_le_one E u).1]
      exact mul_le_of_le_one_left (norm_nonneg _) (hyperplaneMultiplier_nonneg_le_one E u).2)
  have hF : Integrable F ρ.1 := ((Lp.memLp a).integrable (Fact.out : 1 ≤ p)).congr
    (hyperplaneLiftCoefficient_ae hd g)
  have hD : Integrable D ρ.1 := hF.indicator E.2
  have hDm : StronglyMeasurable D :=
    (((Lp.stronglyMeasurable g).comp_measurable (measurable_hyperplaneFold hd)).indicator
      (nonPole d).2).indicator E.2
  have hD' : Integrable D' ρ.1 :=
    (integrable_map_measure hDm.aestronglyMeasurable (reflection d).measurable.aemeasurable).mp
      (hρ.symm ▸ hD)
  apply ae_eq_of_forall_setIntegral_eq_of_sigmaFinite
  · intro S _ _
    exact ((Lp.memLp (foldedLp hd (lpCut E a))).integrable (Fact.out : 1 ≤ p)).integrableOn
  · intro S _ _
    exact hkg.integrableOn
  · intro S hS _
    let B : MeasSet (BarronHyperplanes d) := ⟨S, hS⟩
    let A := foldPreimage hd B
    rw [foldedLp_integral hd _ B, eval_densityMap]
    have ha : (fun θ => lpCut E a θ) =ᵐ[ρ.1] D := by
      filter_upwards [lpCut_ae E a, hyperplaneLiftCoefficient_ae hd g] with θ h1 h2
      rw [h1]
      by_cases ht : θ ∈ E.1
      · rw [indicator_of_mem ht, show a θ = F θ from h2]
        exact (indicator_of_mem ht _).symm
      · exact (indicator_of_notMem ht _).trans (indicator_of_notMem ht _).symm
    rw [integral_congr_ae (ae_restrict_le ha)]
    change (∫ θ in A.1, D θ ∂ρ.1) =
      ∫ u in B.1, (hyperplaneMultiplier E u * g u) ∂ν
    have hν : (∫ u in B.1, (hyperplaneMultiplier E u * g u) ∂ν) =
        ∫ θ in A.1, (hyperplaneMultiplier E (hyperplaneFold hd θ) * g (hyperplaneFold hd θ)) ∂ρ.1 := by
      change (∫ u in B.1, (hyperplaneMultiplier E u * g u) ∂Measure.map (hyperplaneFold hd)
        (ρ.1.restrict (nonPole d).1)) = _
      rw [setIntegral_map B.2 hkm.aestronglyMeasurable (measurable_hyperplaneFold hd).aemeasurable,
        Measure.restrict_restrict ((measurable_hyperplaneFold hd) B.2)]
      congr 2
      exact inter_comm _ _
    rw [hν]
    have hvalue : (∫ θ in A.1, (hyperplaneMultiplier E (hyperplaneFold hd θ) * g (hyperplaneFold hd θ)) ∂ρ.1) =
        ∫ θ in A.1, (1 / 2 : ℝ) • (D θ + D' θ) ∂ρ.1 := by
      apply setIntegral_congr_fun A.2
      intro θ hθ
      have hN : θ ∈ (nonPole d).1 := hθ.1
      have hF₁ : F θ = g (hyperplaneFold hd θ) := indicator_of_mem hN _
      have hF₂ : F (reflection d θ) = g (hyperplaneFold hd θ) := (hsym θ).trans hF₁
      change hyperplaneMultiplier E (hyperplaneFold hd θ) * g (hyperplaneFold hd θ) = _
      rw [hyperplaneMultiplier_comp_fold hd E θ hN]
      change _ = (1 / 2 : ℝ) * (E.1.indicator F θ + E.1.indicator F (reflection d θ))
      by_cases h₁ : θ ∈ E.1 <;> by_cases h₂ : reflection d θ ∈ E.1 <;>
        simp [h₁, h₂, hF₁, hF₂]
      ring
    rw [hvalue, integral_smul, integral_add hD.integrableOn hD'.integrableOn]
    have hrefl := setIntegral_reflection hρ A hDm
    rw [foldPreimage_symmetric hd B] at hrefl
    change (∫ θ in A.1, D' θ ∂ρ.1) = _ at hrefl
    rw [hrefl]
    change _ = (1 / 2 : ℝ) * _
    ring

#print axioms BarronSphere.foldedLocalizedOperator_is_multiplier


open scoped Pointwise

private abbrev EuclideanParameters (d : ℕ) := EuclideanSpace ℝ (Option (Fin d))

local instance (d : ℕ) : MeasurableSpace (EuclideanParameters d) := borel _
local instance (d : ℕ) : BorelSpace (EuclideanParameters d) := ⟨rfl⟩

private abbrev NativeUnitSphere (d : ℕ) :=
  ↥(Metric.sphere (0 : EuclideanParameters d) 1)

private def toEuclidean {d : ℕ} (θ : BarronSphere d) : EuclideanParameters d :=
  WithLp.toLp 2 (fun i => i.elim θ.bias θ.weight)

private theorem norm_toEuclidean {d : ℕ} (θ : BarronSphere d) : ‖toEuclidean θ‖ = 1 := by
  rw [EuclideanSpace.norm_eq, Fintype.sum_option]
  change Real.sqrt (‖θ.bias‖^2 + ∑ i, ‖θ.weight i‖^2) = 1
  simp only [Real.norm_eq_abs, sq_abs]
  rw [add_comm, show (∑ i, (θ.weight i)^2) + θ.bias^2 = 1 from θ.2, Real.sqrt_one]

private def fromEuclidean {d : ℕ} (θ : NativeUnitSphere d) : BarronSphere d := by
  refine ⟨(fun i => θ.1.ofLp (some i), θ.1.ofLp none), ?_⟩
  have he : ‖θ.1‖ = 1 := by
    have h := Metric.mem_sphere.mp θ.2
    rwa [dist_zero_right] at h
  rw [EuclideanSpace.norm_eq, Fintype.sum_option] at he
  simp only [Real.norm_eq_abs, sq_abs] at he
  have h0 : 0 ≤ (θ.1.ofLp none)^2 + ∑ i, (θ.1.ofLp (some i))^2 :=
    add_nonneg (sq_nonneg _) (Finset.sum_nonneg fun _ _ => sq_nonneg _)
  have hs := Real.sq_sqrt h0
  rw [he, one_pow, add_comm] at hs
  exact hs.symm

private theorem continuous_toEuclidean {d : ℕ} : Continuous (@toEuclidean d) := by
  apply (PiLp.continuous_toLp 2 (fun _ : Option (Fin d) => ℝ)).comp
  apply continuous_pi
  intro i
  cases i
  · exact continuous_snd.comp continuous_subtype_val
  · exact (continuous_apply _).comp (continuous_fst.comp continuous_subtype_val)

private theorem continuous_fromEuclidean {d : ℕ} : Continuous (@fromEuclidean d) := by
  apply Continuous.subtype_mk
  apply Continuous.prodMk
  · apply continuous_pi
    intro i
    exact (continuous_apply (some i)).comp
      ((PiLp.continuous_ofLp 2 (fun _ : Option (Fin d) => ℝ)).comp continuous_subtype_val)
  · exact (continuous_apply none).comp
      ((PiLp.continuous_ofLp 2 (fun _ : Option (Fin d) => ℝ)).comp continuous_subtype_val)

def sphereCoordinateEquiv (d : ℕ) : NativeUnitSphere d ≃ᵐ BarronSphere d where
  toFun := fromEuclidean
  invFun θ := ⟨toEuclidean θ, Metric.mem_sphere.mpr (by rw [dist_zero_right, norm_toEuclidean])⟩
  left_inv θ := by
    apply Subtype.ext
    apply (WithLp.equiv 2 _).injective
    funext i
    cases i <;> rfl
  right_inv θ := by
    apply Subtype.ext
    rfl
  measurable_toFun := continuous_fromEuclidean.measurable
  measurable_invFun := (continuous_toEuclidean.subtype_mk _).measurable

private def nativeReflection {d : ℕ} (θ : NativeUnitSphere d) : NativeUnitSphere d :=
  ⟨-θ.1, by
    apply Metric.mem_sphere.mpr
    rw [dist_zero_right, norm_neg, ← dist_zero_right]
    exact Metric.mem_sphere.mp θ.2⟩

private theorem measurable_nativeReflection (d : ℕ) : Measurable (@nativeReflection d) :=
  (continuous_neg.comp continuous_subtype_val).measurable.subtype_mk

private theorem nativeReflection_coordinates {d : ℕ} (θ : NativeUnitSphere d) :
    fromEuclidean (nativeReflection θ) = reflection d (fromEuclidean θ) := by
  apply Subtype.ext
  rfl

private def euclideanHaar (d : ℕ) : Measure (EuclideanParameters d) := Measure.addHaar

private instance euclideanHaar_haar (d : ℕ) : (euclideanHaar d).IsAddHaarMeasure := by
  unfold euclideanHaar
  infer_instance

private theorem nativeSphereMeasure_reflection (d : ℕ) :
    Measure.map (@nativeReflection d) (euclideanHaar d).toSphere = (euclideanHaar d).toSphere := by
  let μ := euclideanHaar d
  ext A hA
  change Measure.map (@nativeReflection d) μ.toSphere A = μ.toSphere A
  rw [Measure.map_apply (measurable_nativeReflection d) hA, Measure.toSphere_apply' μ
    ((measurable_nativeReflection d) hA), Measure.toSphere_apply' μ hA]
  congr 1
  have he : Ioo (0 : ℝ) 1 • Subtype.val '' (nativeReflection ⁻¹' A) =
      Neg.neg ⁻¹' (Ioo (0 : ℝ) 1 • Subtype.val '' A) := by
    ext θ
    constructor
    · rintro ⟨c, hc, x, ⟨u, hu, rfl⟩, rfl⟩
      exact ⟨c, hc, (nativeReflection u).1, ⟨nativeReflection u, hu, rfl⟩, smul_neg c u.1⟩
    · rintro ⟨c, hc, x, ⟨u, hu, rfl⟩, hx⟩
      have hin : nativeReflection (nativeReflection u) = u := Subtype.ext (neg_neg _)
      refine ⟨c, hc, (nativeReflection u).1, ⟨nativeReflection u, ?_, rfl⟩, ?_⟩
      · change nativeReflection (nativeReflection u) ∈ A
        rwa [hin]
      · change c • u.1 = -θ at hx
        change c • (-u.1) = θ
        rw [smul_neg, hx, neg_neg]
  rw [he]
  exact ((euclideanHaar d).measurePreserving_neg).measure_preimage_emb measurableEmbedding_neg _

#print axioms BarronSphere.sphereCoordinateEquiv


private theorem nativeSphereMeasure_singleton (d : ℕ) (hd : 1 ≤ d) (θ : NativeUnitSphere d) :
    (euclideanHaar d).toSphere {θ} = 0 := by
  let μ := euclideanHaar d
  let E := EuclideanParameters d
  let L : Submodule ℝ E := Submodule.span ℝ {θ.1}
  have ht : θ.1 ≠ 0 := by
    have h := Metric.mem_sphere.mp θ.2
    rw [dist_zero_right] at h
    intro h0
    rw [h0, norm_zero] at h
    norm_num at h
  have hdim : 1 < Module.finrank ℝ E := by
    change 1 < Module.finrank ℝ (EuclideanSpace ℝ (Option (Fin d)))
    rw [finrank_euclideanSpace, Fintype.card_option, Fintype.card_fin]
    omega
  have hL : L ≠ ⊤ := by
    intro he
    have hl : Module.finrank ℝ L = 1 := finrank_span_singleton ht
    rw [he, finrank_top] at hl
    omega
  change μ.toSphere {θ} = 0
  rw [Measure.toSphere_apply' μ (measurableSet_singleton θ)]
  have hs : Ioo (0 : ℝ) 1 • (Subtype.val '' {θ} : Set E) ⊆ (L : Set E) := by
    rintro _ ⟨c, _, _, ⟨u, hu, rfl⟩, rfl⟩
    have h : u = θ := mem_singleton_iff.mp hu
    subst u
    exact L.smul_mem c (Submodule.subset_span (mem_singleton _))
  rw [measure_mono_null hs (μ.addHaar_submodule L hL), mul_zero]

private def rawSphereMeasure (d : ℕ) : Measure (BarronSphere d) :=
  Measure.map (sphereCoordinateEquiv d) (euclideanHaar d).toSphere

/-- Normalized surface measure on the Euclidean sphere in the manuscript's coordinates. -/
def uniformSphereProbability (d : ℕ) : Measure (BarronSphere d) :=
  ((rawSphereMeasure d) univ)⁻¹ • rawSphereMeasure d

private instance rawSphereMeasure_finite (d : ℕ) : IsFiniteMeasure (rawSphereMeasure d) := by
  unfold rawSphereMeasure
  infer_instance

theorem uniformSphereProbability_mass (d : ℕ) : uniformSphereProbability d univ = 1 := by
  let μ := euclideanHaar d
  have hne : (rawSphereMeasure d) univ ≠ 0 := by
    change Measure.map (sphereCoordinateEquiv d) μ.toSphere univ ≠ 0
    rw [Measure.map_apply (sphereCoordinateEquiv d).measurable MeasurableSet.univ,
      preimage_univ]
    exact fun h => μ.toSphere_ne_zero (Measure.measure_univ_eq_zero.mp h)
  change ((rawSphereMeasure d) univ)⁻¹ * (rawSphereMeasure d) univ = 1
  exact ENNReal.inv_mul_cancel hne (measure_ne_top _ _)

theorem uniformSphereProbability_reflection (d : ℕ) :
    Measure.map (reflection d) (uniformSphereProbability d) = uniformSphereProbability d := by
  unfold uniformSphereProbability
  rw [Measure.map_smul _ (reflection d).measurable.aemeasurable]
  congr 1
  unfold rawSphereMeasure
  rw [Measure.map_map (reflection d).measurable (sphereCoordinateEquiv d).measurable]
  have he : (reflection d : BarronSphere d → BarronSphere d) ∘ sphereCoordinateEquiv d =
      (sphereCoordinateEquiv d : NativeUnitSphere d → BarronSphere d) ∘ nativeReflection :=
    funext fun θ => (nativeReflection_coordinates θ).symm
  rw [he, ← Measure.map_map (sphereCoordinateEquiv d).measurable (measurable_nativeReflection d),
    nativeSphereMeasure_reflection]

theorem uniformSphereProbability_singleton (d : ℕ) (hd : 1 ≤ d) (θ : BarronSphere d) :
    uniformSphereProbability d {θ} = 0 := by
  change ((rawSphereMeasure d) univ)⁻¹ * (rawSphereMeasure d) {θ} = 0
  unfold rawSphereMeasure
  rw [Measure.map_apply (sphereCoordinateEquiv d).measurable (measurableSet_singleton θ)]
  have h : (sphereCoordinateEquiv d) ⁻¹' {θ} = {(sphereCoordinateEquiv d).symm θ} := by
    ext x
    change (sphereCoordinateEquiv d x = θ) ↔ x = (sphereCoordinateEquiv d).symm θ
    exact (sphereCoordinateEquiv d).toEquiv.eq_symm_apply.symm
  rw [h, nativeSphereMeasure_singleton d hd, mul_zero]

#print axioms BarronSphere.uniformSphereProbability_mass
#print axioms BarronSphere.uniformSphereProbability_reflection
#print axioms BarronSphere.uniformSphereProbability_singleton


/-- The probability used in the frame counterexample: half surface measure and half uniform atoms. -/
def barronCounterMeasure (d : ℕ) : Measure (BarronSphere d) :=
  (1 / 2 : ℝ≥0∞) • (uniformSphereProbability d + uniformAtomicProbability d)

theorem barronCounterMeasure_reflection (d : ℕ) :
    Measure.map (reflection d) (barronCounterMeasure d) = barronCounterMeasure d := by
  unfold barronCounterMeasure
  rw [Measure.map_smul _ (reflection d).measurable.aemeasurable,
    Measure.map_add _ _ (reflection d).measurable, uniformSphereProbability_reflection,
    uniformAtomicProbability_symmetric]

theorem barronCounterMeasure_compatible (d : ℕ) : CompatibleProbability d (barronCounterMeasure d) := by
  have hA (θ : BarronSphere d) (ht : 0 < uniformAtomicProbability d {θ}) :
      0 < barronCounterMeasure d {θ} := by
    change 0 < (1 / 2 : ℝ≥0∞) *
      (uniformSphereProbability d {θ} + uniformAtomicProbability d {θ})
    exact (ENNReal.mul_pos (a := (1 / 2 : ℝ≥0∞)) (by norm_num) ht.ne').trans_le
      (mul_le_mul_right le_add_self (1 / 2 : ℝ≥0∞))
  have hpos := uniformAtomicProbability_marked d none
  have hPole : reflection d (polePlus d) = poleMinus d := by
    apply Subtype.ext
    exact Prod.ext (neg_zero : -(0 : Fin d → ℝ) = 0) rfl
  refine ⟨?_, ⟨1, ENNReal.one_lt_top, ?_⟩, ?_, ?_⟩
  · change (1 / 2 : ℝ≥0∞) *
      (uniformSphereProbability d univ + uniformAtomicProbability d univ) = 1
    rw [uniformSphereProbability_mass, uniformAtomicProbability_mass, one_add_one_eq_two]
    exact ENNReal.div_mul_cancel (by norm_num) (by norm_num)
  · rw [barronCounterMeasure_reflection, one_smul]
  · intro i
    obtain ⟨hp, hm⟩ := uniformAtomicProbability_marked d (some i)
    exact ⟨hA _ hp, hA _ hm⟩
  · exact ⟨hA _ hpos.1, hA _ (by simpa [positiveAtom, hPole] using hpos.2)⟩

private def markedSphereAtoms (d : ℕ) : Set (BarronSphere d) :=
  Set.range (positiveAtom d) ∪ Set.range ((reflection d) ∘ positiveAtom d)

private theorem markedSphereAtoms_finite (d : ℕ) : (markedSphereAtoms d).Finite :=
  (Set.finite_range _).union (Set.finite_range _)

private theorem uniformAtomicProbability_null_off_marked (A : MeasSet (BarronSphere d))
    (hA : Disjoint A.1 (markedSphereAtoms d)) : uniformAtomicProbability d A.1 = 0 := by
  unfold uniformAtomicProbability
  simp only [smul_apply, smul_eq_mul, add_apply, Measure.sum_apply _ A.2]
  have h₁ (i : Option (Fin d)) : Measure.dirac (positiveAtom d i) A.1 = 0 := by
    rw [Measure.dirac_apply' _ A.2, indicator_of_notMem]
    exact fun h => Set.disjoint_left.mp hA h (Or.inl ⟨i, rfl⟩)
  have h₂ (i : Option (Fin d)) : Measure.dirac (reflection d (positiveAtom d i)) A.1 = 0 := by
    rw [Measure.dirac_apply' _ A.2, indicator_of_notMem]
    exact fun h => Set.disjoint_left.mp hA h (Or.inr ⟨i, rfl⟩)
  simp [h₁, h₂]

private theorem foldedSurfaceMeasure_singleton (hd : 1 ≤ d) (u : BarronHyperplanes d) :
    hyperplaneMeasure hd (uniformSphereProbability d) {u} = 0 := by
  let σ := uniformSphereProbability d
  change Measure.map (hyperplaneFold hd) (σ.restrict (nonPole d).1) {u} = 0
  rw [Measure.map_apply (measurable_hyperplaneFold hd) (measurableSet_singleton u),
    Measure.restrict_apply ((measurable_hyperplaneFold hd) (measurableSet_singleton u))]
  refine measure_mono_null (t := {u.1, reflection d u.1}) ?_ ?_
  · intro θ hθ
    have hu := positiveOrientation_subset_nonPole d u.2
    have he : hyperplaneQuotient d ⟨θ, hθ.2⟩ = hyperplaneQuotient d ⟨u.1, hu⟩ := by
      rw [← hyperplaneFold_nonPole hd θ hθ.2, ← hyperplaneFold_nonPole hd u.1 hu, hyperplaneFold_section]
      exact hθ.1
    rw [hyperplaneQuotient_fibres] at he
    simpa only [mem_insert_iff, mem_singleton_iff] using he
  · change σ ({u.1} ∪ {reflection d u.1}) = 0
    have h₁ : σ {u.1} = 0 := uniformSphereProbability_singleton d hd u.1
    have h₂ : σ {reflection d u.1} = 0 := uniformSphereProbability_singleton d hd (reflection d u.1)
    have hs : σ {u.1} + σ {reflection d u.1} = 0 := by rw [h₁, h₂, add_zero]
    exact le_antisymm ((measure_union_le (μ := σ) {u.1} {reflection d u.1}).trans_eq hs) bot_le

private theorem foldedCounterMeasure_null_off_marked (hd : 1 ≤ d) (u : BarronHyperplanes d)
    (hu : u ∉ hyperplaneFold hd '' markedSphereAtoms d) :
    hyperplaneMeasure hd (barronCounterMeasure d) {u} = 0 := by
  let π := hyperplaneFold hd
  let σ := uniformSphereProbability d
  let τ := uniformAtomicProbability d
  have hE : MeasurableSet (π ⁻¹' {u}) := (measurable_hyperplaneFold hd) (measurableSet_singleton u)
  let E : MeasSet (BarronSphere d) := ⟨(π ⁻¹' {u}) ∩ (nonPole d).1, hE.inter (nonPole d).2⟩
  have hτ : τ E.1 = 0 := uniformAtomicProbability_null_off_marked E (Set.disjoint_left.mpr
    (fun θ hθ ht => hu ⟨θ, ht, hθ.1⟩))
  have hσ : σ E.1 = 0 := by
    have h := foldedSurfaceMeasure_singleton hd u
    unfold hyperplaneMeasure at h
    rw [Measure.map_apply (measurable_hyperplaneFold hd) (measurableSet_singleton u), Measure.restrict_apply hE] at h
    exact h
  unfold hyperplaneMeasure
  rw [Measure.map_apply (measurable_hyperplaneFold hd) (measurableSet_singleton u), Measure.restrict_apply hE]
  change (1 / 2 : ℝ≥0∞) * (σ E.1 + τ E.1) = 0
  rw [hσ, hτ, add_zero, mul_zero]

#print axioms BarronSphere.barronCounterMeasure_compatible
#print axioms BarronSphere.foldedCounterMeasure_null_off_marked


/-- The exact coefficient-space stage used in the non-frame example. -/
def barronCounterControl (d : ℕ) : {ρ : Measure (BarronSphere d) // CompatibleProbability d ρ} :=
  ⟨barronCounterMeasure d, barronCounterMeasure_compatible d⟩

private theorem foldedMultiplier_positive_nonatomic_cut (hd : 1 ≤ d) (E : MeasSet (BarronSphere d))
    (hE : 0 < uniformSphereProbability d E.1) :
    ∃ B : MeasSet (BarronHyperplanes d), 0 < hyperplaneMeasure hd (barronCounterMeasure d) B.1 ∧
      (∀ u ∈ B.1, hyperplaneMeasure hd (barronCounterMeasure d) {u} = 0) ∧
      ∀ u ∈ B.1, (1 / 2 : ℝ) ≤ hyperplaneMultiplier E u := by
  let σ := uniformSphereProbability d
  let τ := uniformAtomicProbability d
  let ν₀ := hyperplaneMeasure hd σ
  let ν := hyperplaneMeasure hd (barronCounterMeasure d)
  let k := hyperplaneMultiplier E
  let K := hyperplaneFold hd '' markedSphereAtoms d
  let G := {u | (1 / 2 : ℝ) ≤ k u}
  have hG : MeasurableSet G := measurableSet_le measurable_const (measurable_hyperplaneMultiplier E)
  have hKfin : K.Finite := (markedSphereAtoms_finite d).image (hyperplaneFold hd)
  have hK : MeasurableSet K := hKfin.measurableSet
  let B : MeasSet (BarronHyperplanes d) := ⟨G \ K, hG.diff hK⟩
  have hnull : NullSingletonClass ν₀ := ⟨foldedSurfaceMeasure_singleton hd⟩
  have hK₀ : ν₀ K = 0 := hKfin.measure_zero ν₀
  have hnullNP : σ ((nonPole d).1ᶜ) = 0 := by
    rw [nonPole_eq_compl, compl_compl]
    change σ ({polePlus d} ∪ {poleMinus d}) = 0
    have h₁ : σ {polePlus d} = 0 := uniformSphereProbability_singleton d hd (polePlus d)
    have h₂ : σ {poleMinus d} = 0 := uniformSphereProbability_singleton d hd (poleMinus d)
    have hs : σ {polePlus d} + σ {poleMinus d} = 0 := by rw [h₁, h₂, add_zero]
    exact le_antisymm ((measure_union_le (μ := σ) {polePlus d} {poleMinus d}).trans_eq hs) bot_le
  have hcut : σ (E.1 ∩ (nonPole d).1) = σ E.1 := by
    have ht := measure_sdiff_null (s := E.1) hnullNP
    simpa only [Set.sdiff_eq, compl_compl] using ht
  have hν₀ : 0 < ν₀ B.1 := by
    change 0 < ν₀ (G \ K)
    rw [measure_sdiff_null hK₀]
    change 0 < Measure.map (hyperplaneFold hd) (σ.restrict (nonPole d).1) G
    rw [Measure.map_apply (measurable_hyperplaneFold hd) hG,
      Measure.restrict_apply ((measurable_hyperplaneFold hd) hG)]
    have hs : E.1 ∩ (nonPole d).1 ⊆ (hyperplaneFold hd ⁻¹' G) ∩ (nonPole d).1 := by
      intro θ hθ
      refine ⟨?_, hθ.2⟩
      change (1 / 2 : ℝ) ≤ k (hyperplaneFold hd θ)
      rw [show k = hyperplaneMultiplier E from rfl, hyperplaneMultiplier_comp_fold hd E θ hθ.2,
        indicator_of_mem hθ.1]
      by_cases h' : reflection d θ ∈ E.1 <;> norm_num [h']
    have hpos : 0 < σ (E.1 ∩ (nonPole d).1) := by rwa [hcut]
    exact hpos.trans_le (measure_mono hs)
  have hν : (1 / 2 : ℝ≥0∞) * ν₀ B.1 ≤ ν B.1 := by
    change (1 / 2 : ℝ≥0∞) * (Measure.map (hyperplaneFold hd) (σ.restrict (nonPole d).1)) B.1 ≤
      (Measure.map (hyperplaneFold hd) ((barronCounterMeasure d).restrict (nonPole d).1)) B.1
    rw [Measure.map_apply (measurable_hyperplaneFold hd) B.2,
      Measure.map_apply (measurable_hyperplaneFold hd) B.2,
      Measure.restrict_apply ((measurable_hyperplaneFold hd) B.2),
      Measure.restrict_apply ((measurable_hyperplaneFold hd) B.2)]
    change (1 / 2 : ℝ≥0∞) * σ _ ≤ (1 / 2 : ℝ≥0∞) * (σ _ + τ _)
    exact mul_le_mul_right le_self_add _
  exact ⟨B, ((ENNReal.mul_pos (a := (1 / 2 : ℝ≥0∞)) (by norm_num) hν₀.ne').trans_le hν),
    fun u hu => foldedCounterMeasure_null_off_marked hd u hu.2, fun u hu => hu.1⟩

#print axioms BarronSphere.foldedMultiplier_positive_nonatomic_cut


theorem barronCounter_cut_not_compact (hd : 1 ≤ d) (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≠ ⊤)
    (E : MeasSet (BarronSphere d)) (hE : 0 < uniformSphereProbability d E.1) :
    ¬ IsCompactOperator ((barronStage hd (barronCounterControl d) p hp).localOVM.val E) := by
  let ρ := barronCounterControl d
  let Q := barronStage hd ρ p hp
  let ν := hyperplaneMeasure hd ρ.1
  let M := foldedLocalizedOperator hd ρ hp E
  obtain ⟨B, hB, hB0, hkB⟩ := foldedMultiplier_positive_nonatomic_cut hd E hE
  obtain ⟨A, hA, hsub, hpositive⟩ := disjoint_positive_of_nonatomic_cut ν B hB hB0
  have hM := noncompact_of_disjoint_coefficient_cuts hp M (hyperplaneMultiplier E)
    (foldedLocalizedOperator_is_multiplier hd ρ (barronCounterMeasure_reflection d) hp E)
    A hA hpositive (1 / 2) (by norm_num) (fun n u hu => hkB u (hsub n hu))
  intro hc
  apply hM
  let U := Q.synthesis.comp (hyperplaneLift hd (ρ := ρ.1) (p := p)).toContinuousLinearMap
  exact (hc.comp_clm U).clm_comp (foldStage hd ρ hp)

theorem barronStage_separable (hd : 1 ≤ d) (ρ : BarronControl d)
    (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≠ ⊤) :
    TopologicalSpace.SeparableSpace (barronStage hd ρ p hp).Quotient := by
  have factHP : Fact (p ≠ ⊤) := ⟨hp⟩
  have factHG : MeasurableSpace.CountablyGenerated (BarronSphere d) := BorelSpace.countablyGenerated
  let Q := barronStage hd ρ p hp
  exact Q.synthesis_surjective.denseRange.separableSpace Q.synthesis.continuous

theorem barronCounter_no_continuous_frame (hd : 1 ≤ d) (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≠ ⊤)
    {m : Measure (BarronSphere d)} [SigmaFinite m]
    (F : ContinuousSchauderFrame (X := (barronStage hd (barronCounterControl d) p hp).Quotient) m) :
    F.operatorMeasure ≠ (barronStage hd (barronCounterControl d) p hp).localOVM := by
  intro he
  have hsep := barronStage_separable hd (barronCounterControl d) p hp
  obtain ⟨D, _, hD, hlocal⟩ := F.exists_partition_locally_compact_operatorMeasure
  have hnull (n : ℕ) : uniformSphereProbability d (D n).1 = 0 := by
    by_contra hn
    apply barronCounter_cut_not_compact hd p hp (D n) (pos_iff_ne_zero.mpr hn)
    rw [← he]
    exact (hlocal n).2.2 (D n) Subset.rfl
  have hZero : uniformSphereProbability d (MeasSet.iUnion D).1 = 0 :=
    measure_iUnion_null_iff.mpr hnull
  rw [hD] at hZero
  exact one_ne_zero ((uniformSphereProbability_mass d).symm.trans hZero)

#print axioms BarronSphere.barronCounter_cut_not_compact
#print axioms BarronSphere.barronCounter_no_continuous_frame


private theorem lTwo_norm_sq_integral {ρ : Measure (BarronSphere d)} (a : Lp ℝ 2 ρ) :
    ‖a‖^2 = ∫ θ, (a θ)^2 ∂ρ := by
  rw [Lp.norm_def, eLpNorm_eq_lintegral_rpow_eNorm_toReal (by norm_num) (by norm_num)
    (Lp.aestronglyMeasurable a)]
  norm_num [ENNReal.toReal_ofNat]
  rw [← ENNReal.toReal_rpow, ← Real.sqrt_eq_rpow, Real.sq_sqrt ENNReal.toReal_nonneg]
  rw [integral_eq_lintegral_of_nonneg_ae (Eventually.of_forall fun t => sq_nonneg (a t))
    ((Lp.stronglyMeasurable a).pow 2).aestronglyMeasurable]
  congr 1
  apply lintegral_congr_ae
  filter_upwards with θ
  rw [← ofReal_norm, ← ENNReal.ofReal_pow (norm_nonneg _) 2,
    Real.norm_eq_abs, sq_abs]

private theorem lTwo_square_integrable {ρ : Measure (BarronSphere d)} (a : Lp ℝ 2 ρ) :
    Integrable (fun θ => (a θ)^2) ρ := by
  have hi := (Lp.memLp a).integrable_norm_rpow (by norm_num) (by norm_num)
  simpa [Real.rpow_two, Real.norm_eq_abs, sq_abs] using hi

private theorem lTwo_parallelogram {ρ : Measure (BarronSphere d)} (a b : Lp ℝ 2 ρ) :
    ‖a + b‖^2 + ‖a - b‖^2 = 2 * ‖a‖^2 + 2 * ‖b‖^2 := by
  have hplus : (fun θ => ((a + b) θ)^2) =ᵐ[ρ] fun θ => (a θ + b θ)^2 :=
    (Lp.coeFn_add a b).mono (fun t h => congrArg (fun x : ℝ => x^2) h)
  have hminus : (fun θ => ((a - b) θ)^2) =ᵐ[ρ] fun θ => (a θ - b θ)^2 :=
    (Lp.coeFn_sub a b).mono (fun t h => congrArg (fun x : ℝ => x^2) h)
  have hp := (lTwo_square_integrable (a + b)).congr hplus
  have hm := (lTwo_square_integrable (a - b)).congr hminus
  rw [lTwo_norm_sq_integral, lTwo_norm_sq_integral, lTwo_norm_sq_integral, lTwo_norm_sq_integral,
    integral_congr_ae hplus, integral_congr_ae hminus, ← integral_add hp hm]
  calc
    _ = ∫ θ, ((2 : ℝ) * (a θ)^2 + 2 * (b θ)^2) ∂ρ := by
      apply integral_congr_ae
      filter_upwards with θ
      ring
    _ = _ := by
      rw [integral_add ((lTwo_square_integrable a).const_mul 2) ((lTwo_square_integrable b).const_mul 2),
        integral_const_mul, integral_const_mul]

private theorem quotient_parallelogram {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]
    (S : Submodule ℝ X) [IsClosed (S : Set X)]
    (h : ∀ a b : X, ‖a + b‖^2 + ‖a - b‖^2 = 2 * ‖a‖^2 + 2 * ‖b‖^2)
    (x y : X ⧸ S) :
    ‖x + y‖^2 + ‖x - y‖^2 = 2 * ‖x‖^2 + 2 * ‖y‖^2 := by
  have upper (x y : X ⧸ S) : ‖x + y‖^2 + ‖x - y‖^2 ≤ 2 * ‖x‖^2 + 2 * ‖y‖^2 := by
    let f (ε : ℝ) := 2 * (‖x‖ + ε)^2 + 2 * (‖y‖ + ε)^2
    have hf : Continuous f := by unfold f; fun_prop
    have hε : Ioi (0 : ℝ) ⊆ {ε | ‖x + y‖^2 + ‖x - y‖^2 ≤ f ε} := by
      intro ε hε
      have hε' : 0 < ε := hε
      obtain ⟨a, ha, ha'⟩ := Submodule.Quotient.norm_mk_lt x hε'
      obtain ⟨b, hb, hb'⟩ := Submodule.Quotient.norm_mk_lt y hε'
      have hp := Submodule.Quotient.norm_mk_le S (a + b)
      have hm := Submodule.Quotient.norm_mk_le S (a - b)
      change S.mkQL a = x at ha
      change S.mkQL b = y at hb
      change ‖S.mkQL (a + b)‖ ≤ _ at hp
      change ‖S.mkQL (a - b)‖ ≤ _ at hm
      rw [map_add, ha, hb] at hp
      rw [map_sub, ha, hb] at hm
      change ‖x + y‖^2 + ‖x - y‖^2 ≤ f ε
      unfold f
      calc
        _ ≤ ‖a + b‖^2 + ‖a - b‖^2 :=
          add_le_add (pow_le_pow_left₀ (norm_nonneg _) hp _) (pow_le_pow_left₀ (norm_nonneg _) hm _)
        _ = _ := h a b
        _ ≤ _ := add_le_add (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (norm_nonneg _) ha'.le _) (by norm_num))
          (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (norm_nonneg _) hb'.le _) (by norm_num))
    have hc := closure_minimal hε (isClosed_le continuous_const hf)
    rw [closure_Ioi] at hc
    have hh := hc (Set.mem_Ici.mpr (le_rfl : (0 : ℝ) ≤ 0))
    change ‖x + y‖^2 + ‖x - y‖^2 ≤ f 0 at hh
    simpa only [f, add_zero] using hh
  refine le_antisymm (upper x y) ?_
  have hu := upper (x + y) (x - y)
  rw [show (x + y) + (x - y) = (2 : ℝ) • x by module,
    show (x + y) - (x - y) = (2 : ℝ) • y by module,
    norm_smul, norm_smul, Real.norm_ofNat] at hu
  nlinarith

#print axioms BarronSphere.quotient_parallelogram

/-- The inner product recovered from the exact quotient norm at exponent two. -/
@[instance_reducible] def barronStageHilbert (hd : 1 ≤ d) (ρ : BarronControl d) (hp : (2 : ℝ≥0∞) ≠ ⊤) :
    InnerProductSpace ℝ (barronStage hd ρ 2 hp).Quotient :=
  InnerProductSpace.ofNorm (𝕜 := ℝ) (fun x y => by
    have h := quotient_parallelogram (barronStage hd ρ 2 hp).synthesisToOriginal.ker lTwo_parallelogram x y
    simpa only [pow_two, mul_add] using h)

theorem barronStage_is_RKHS (hd : 1 ≤ d) (ρ : BarronControl d) (hp : (2 : ℝ≥0∞) ≠ ⊤) :
    Nonempty (InnerProductSpace ℝ (barronStage hd ρ 2 hp).Quotient) ∧
      CompleteSpace (barronStage hd ρ 2 hp).Quotient ∧
      ∀ x : Fin d → ℝ, Continuous (fun z => quotientPointEval x ((barronStage hd ρ 2 hp).inclusion z)) :=
  ⟨⟨barronStageHilbert hd ρ hp⟩, inferInstance, fun x => barronStage_pointEval hd ρ 2 hp x⟩

#print axioms BarronSphere.barronStage_is_RKHS



private def absoluteRidge (x : Fin d → ℝ) : boundedMeasurableAlgebra (BarronSphere d) :=
  boundedSymbol (fun θ => ‖linearForm x 1 θ‖) (linearForm_measurable x 1).norm
    ((∑ i, ‖x i‖) + 1) (fun θ => by
      rw [Real.norm_of_nonneg (norm_nonneg _)]
      simpa using norm_linearForm_le x 1 θ)

theorem synthesis_even_half_abs (γ : FiniteSignedMeasure (BarronSphere d))
    (he : pushforward (reflection d) γ = γ) (x : Fin d → ℝ) :
    synthesis γ x = (1 / 2 : ℝ) * signedIntegral (absoluteRidge x) γ := by
  have hSym := signedIntegral_pushforward (reflection d) (ridgeSymbol x 1) (ridgeSymbol (-x) (-1))
    (fun θ => (reflect_ridge x 1 θ).symm) γ
  rw [he] at hSym
  have hAbs : signedIntegral (absoluteRidge x) =
      signedIntegral (ridgeSymbol x 1 + ridgeSymbol (-x) (-1)) := by
    apply signedIntegral_congr
    intro θ
    change |linearForm x 1 θ| =
      max (linearForm x 1 θ) 0 + max (linearForm (-x) (-1) θ) 0
    have h := reflect_ridge x 1 θ
    change max (linearForm x 1 (reflection d θ)) 0 = max (linearForm (-x) (-1) θ) 0 at h
    rw [linearForm_reflection] at h
    rw [← h]
    rcases le_total 0 (linearForm x 1 θ) with hθ | hθ
    · rw [abs_of_nonneg hθ, max_eq_left hθ, max_eq_right (neg_nonpos.mpr hθ), add_zero]
    · rw [abs_of_nonpos hθ, max_eq_right hθ, max_eq_left (neg_nonneg.mpr hθ), zero_add]
  change signedIntegral (ridgeSymbol x 1) γ = _
  rw [hAbs, signedIntegral_add, ← hSym]
  ring

theorem canonical_representation_formula (hd : 1 ≤ d) (z : BarronBanach d) (x : Fin d → ℝ) :
    quotientPointEval x z =
      (1 / 2 : ℝ) * signedIntegral (absoluteRidge x) (evenPart hd z) +
      affineFunction (affineCoefficients d (canonicalSection hd z)) x := by
  have he : quotientPointEval x z = synthesis (canonicalSection hd z) x :=
    (congrArg (quotientPointEval x) (synthesisQuotient_canonicalSection hd z)).symm.trans
      (quotientPointEval_synthesis (canonicalSection hd z) x)
  rw [he]
  rw [synthesis_even_add_affine (canonicalSection hd z) x, synthesis_even_half_abs (reflectedEven d (canonicalSection hd z))
    (reflectedEven_even _) x]
  rfl

theorem symmetric_localization_finite_atom (hd : 1 ≤ d) (E : MeasSet (BarronSphere d))
    (hE : reflection d ⁻¹' E.1 = E.1) (θ : BarronSphere d) :
    cut E (evenPart hd (synthesisQuotient d (pointMass θ))) =
      if θ ∈ E.1 then evenPart hd (synthesisQuotient d (pointMass θ)) else 0 := by
  rw [evenPart_synthesisQuotient, ← reflectedEven_cut_commute E hE, cut_pointMass]
  split <;> simp

