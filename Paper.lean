namespace Paper

noncomputable section SectionSevenHI

open Set Filter MeasureTheory
open scoped Topology ENNReal

def HasUnconditionalBasicSequence (X : Type) [NormedAddCommGroup X] [NormedSpace ℝ X] : Prop :=
  ∃ E : Submodule ℝ X, IsClosed (E : Set X) ∧ HasUnconditionalBasis E

def HasBanachLatticeOrder (X : Type) [NormedAddCommGroup X] [NormedSpace ℝ X] : Prop :=
  ∃ L : Lattice X, letI := L
    (∀ x y z : X, x ≤ y → z + x ≤ z + y) ∧
    (∀ a : ℝ, 0 ≤ a → ∀ x y : X, x ≤ y → a • x ≤ a • y) ∧
    ∀ x y : X, x ⊔ (-x) ≤ y ⊔ (-y) → ‖x‖ ≤ ‖y‖

def HereditarilyIndecomposable (X : Type) [NormedAddCommGroup X] [NormedSpace ℝ X] : Prop :=
  ¬ ∃ U V : Submodule ℝ X,
    IsClosed (U : Set X) ∧ IsClosed (V : Set X) ∧ Disjoint U V ∧
    IsClosed ((U ⊔ V : Submodule ℝ X) : Set X) ∧
    ¬ FiniteDimensional ℝ U ∧ ¬ FiniteDimensional ℝ V

def UniformConvexUnitBall (X : Type) [NormedAddCommGroup X] [NormedSpace ℝ X] : Prop :=
  ∀ ε : ℝ, 0 < ε → ∃ δ : ℝ, 0 < δ ∧
    ∀ x y : X, ‖x‖ ≤ 1 → ‖y‖ ≤ 1 → ε ≤ ‖x - y‖ → ‖(1/2 : ℝ) • (x + y)‖ ≤ 1 - δ

structure FerencziSpace where
  carrier : Type
  group : NormedAddCommGroup carrier
  space : letI := group; NormedSpace ℝ carrier
  complete : letI := group; CompleteSpace carrier
  separable : letI := group; TopologicalSpace.SeparableSpace carrier
  infinite : letI := group; letI := space; ¬ FiniteDimensional ℝ carrier
  uniformly_convex : letI := group; letI := space; UniformConvexUnitBall carrier
  reflexive : letI := group; letI := space; IsReflexive carrier
  hi : letI := group; letI := space; HereditarilyIndecomposable carrier
  no_unconditional_sequence : letI := group; letI := space; ¬ HasUnconditionalBasicSequence carrier

/-- Ferenczi, Israel Journal of Mathematics 102 (1997), 199–225. This
includes the standard consequences of uniform convexity and HI. -/
axiom citeFerencziUniformlyConvexHI : Nonempty FerencziSpace

/-- de Hevia–Tradacete, Complemented subspaces of Banach lattices, Section 1. -/
axiom citeDeHeviaTradaceteComplementedLatticeSequence {Y Z : Type}
    [NormedAddCommGroup Y] [NormedSpace ℝ Y] [CompleteSpace Y]
    [NormedAddCommGroup Z] [NormedSpace ℝ Z] [CompleteSpace Z]
    (hY : ¬ FiniteDimensional ℝ Y) (hZ : HasBanachLatticeOrder Z) :
    IsComplementedIn Y Z → HasUnconditionalBasicSequence Y

/-- A real Banach space with an unconditional basis admits an equivalent
Banach lattice norm. Lindenstrauss–Tzafriri, Classical Banach Spaces II. -/
axiom citeLindenstraussTzafririLatticeRenorm {Z : Type}
    [NormedAddCommGroup Z] [NormedSpace ℝ Z] [CompleteSpace Z] :
    HasUnconditionalBasis Z →
      ∃ (W : Type) (_ : NormedAddCommGroup W) (_ : NormedSpace ℝ W) (_ : CompleteSpace W),
        HasBanachLatticeOrder W ∧ Nonempty (Z ≃L[ℝ] W)

theorem IsComplementedIn.trans {X Y Z : Type}
    [NormedAddCommGroup X] [NormedSpace ℝ X] [NormedAddCommGroup Y] [NormedSpace ℝ Y]
    [NormedAddCommGroup Z] [NormedSpace ℝ Z]
    (h : IsComplementedIn X Y) (k : IsComplementedIn Y Z) : IsComplementedIn X Z := by
  obtain ⟨i,r,hi⟩ := h
  obtain ⟨j,s,hj⟩ := k
  refine ⟨j.comp i, r.comp s, ?_⟩
  ext x
  have he := congrArg (fun L : Y →L[ℝ] Y => L (i x)) hj
  change s (j (i x)) = i x at he
  change r (s (j (i x))) = x
  rw [he]
  exact congrArg (fun L : X →L[ℝ] X => L x) hi

theorem IsComplementedIn.of_equiv {X Z : Type}
    [NormedAddCommGroup X] [NormedSpace ℝ X] [NormedAddCommGroup Z] [NormedSpace ℝ Z]
    (e : X ≃L[ℝ] Z) : IsComplementedIn X Z := by
  refine ⟨e.toContinuousLinearMap,e.symm.toContinuousLinearMap,?_⟩
  ext x
  exact e.symm_apply_apply x

theorem no_lattice_equiv_of_complemented_HI {X Y : Type}
    [NormedAddCommGroup X] [NormedSpace ℝ X] [NormedAddCommGroup Y] [NormedSpace ℝ Y] [CompleteSpace Y]
    (hYi : ¬ FiniteDimensional ℝ Y) (hY : ¬ HasUnconditionalBasicSequence Y)
    (h : IsComplementedIn Y X)
    (Z : Type) [NormedAddCommGroup Z] [NormedSpace ℝ Z] [CompleteSpace Z] (hZ : HasBanachLatticeOrder Z) :
    ¬ Nonempty (X ≃L[ℝ] Z) := by
  rintro ⟨e⟩
  exact hY (citeDeHeviaTradaceteComplementedLatticeSequence hYi hZ (h.trans (.of_equiv e)))

theorem no_unconditionalFrame_of_complemented_HI {X Y : Type}
    [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X]
    [NormedAddCommGroup Y] [NormedSpace ℝ Y] [CompleteSpace Y]
    (hYi : ¬ FiniteDimensional ℝ Y) (hY : ¬ HasUnconditionalBasicSequence Y)
    (h : IsComplementedIn Y X) :
    ¬ ∃ (u : ℕ → X) (g : ℕ → Dual X), IsUnconditionalSchauderFrame u g := by
  rintro ⟨u,g,hf⟩
  obtain ⟨Z,_,_,_,hb,hi⟩ := citeHanLarsonLiuLiuUnconditionalBasis hf
  obtain ⟨W,_,_,_,hw,⟨e⟩⟩ := citeLindenstraussTzafririLatticeRenorm hb
  exact hY (citeDeHeviaTradaceteComplementedLatticeSequence hYi hw ((h.trans hi).trans (.of_equiv e)))

#print axioms no_lattice_equiv_of_complemented_HI
#print axioms no_unconditionalFrame_of_complemented_HI

end SectionSevenHI
end Paper


namespace Paper

noncomputable section SectionSevenCoordinateModel

open Set Filter
open scoped ENNReal Topology

structure SequenceCoordinates (X Y : Type) [NormedAddCommGroup X] [NormedSpace ℝ X]
    [NormedAddCommGroup Y] [NormedSpace ℝ Y] where
  eval : ℕ → X →L[ℝ] Y
  separates : ∀ x y, (∀ n, eval n x = eval n y) → x = y
  single : ℕ → Y →L[ℝ] X
  single_eval : ∀ n j y, eval j (single n y) = if j = n then y else 0
  single_norm : ∀ n y, ‖single n y‖ = ‖y‖
  cut : Set ℕ → X →L[ℝ] X
  cut_eval : ∀ A n x, eval n (cut A x) = (by classical exact if n ∈ A then eval n x else 0)
  cut_norm : ∀ A x, ‖cut A x‖ ≤ ‖x‖
  tail_small : ∀ x ε, 0 < ε → ∃ k : ℕ, ‖cut (Set.Ici k) x‖ < ε

namespace SequenceCoordinates

variable {X Y : Type} [NormedAddCommGroup X] [NormedSpace ℝ X]
  [NormedAddCommGroup Y] [NormedSpace ℝ Y]
variable (S : SequenceCoordinates X Y)

theorem cut_comp (A B : Set ℕ) (x : X) :
    S.cut A (S.cut B x) = S.cut (A ∩ B) x := by
  classical
  refine S.separates _ _ fun j => ?_
  simp only [S.cut_eval, Set.mem_inter_iff]
  by_cases ha : j ∈ A <;> by_cases hb : j ∈ B <;> simp [ha,hb]

theorem sum_cut (A : ℕ → MeasSet ℕ) (hA : MeasSet.DisjointSeq A)
    (F : Finset ℕ) (x : X) :
    (∑ n ∈ F, S.cut (A n).1 x) = S.cut (⋃ n ∈ F, (A n).1) x := by
  classical
  refine S.separates _ _ fun j => ?_
  simp only [map_sum,S.cut_eval,Set.mem_iUnion,exists_prop]
  by_cases h : ∃ n ∈ F, j ∈ (A n).1
  · obtain ⟨n,hn,hj⟩ := h
    rw [ite_eq_left ⟨n,hn,hj⟩, Finset.sum_eq_single_of_mem n hn]
    · simp [hj]
    · intro k _ hk
      exact ite_eq_right (fun hj' => Set.disjoint_left.mp (hA hk) hj' hj)
  · rw [ite_eq_right h]
    exact Finset.sum_eq_zero fun n hn => ite_eq_right (fun hj => h ⟨n,hn,hj⟩)

def pvm : PVM ℕ X where
  val E := S.cut E.1
  empty_eq := by
    ext x
    exact S.separates _ _ (fun n => by simp [S.cut_eval,MeasSet.empty])
  normalized := by
    ext x
    exact S.separates _ _ (fun n => by simp [S.cut_eval,MeasSet.whole])
  mul_eq A B := ContinuousLinearMap.ext (fun x => S.cut_comp A.1 B.1 x)
  countably_additive A hA x := by
    classical
    let U := ⋃ n, (A n).1
    have heq (F : Finset ℕ) :
        S.cut U x - (∑ n ∈ F, S.cut (A n).1 x) =
          S.cut (U \ ⋃ n ∈ F, (A n).1) x := by
      rw [S.sum_cut A hA]
      refine S.separates _ _ fun j => ?_
      simp only [map_sub, S.cut_eval, Set.mem_sdiff]
      by_cases hu : j ∈ U <;> by_cases hf : j ∈ ⋃ n ∈ F, (A n).1
      · simp [hu,hf]
      · simp [hu,hf]
      · obtain ⟨n,hn⟩ := Set.mem_iUnion.mp hf
        obtain ⟨_,hj⟩ := Set.mem_iUnion.mp hn
        exact (hu (Set.mem_iUnion.mpr ⟨n,hj⟩)).elim
      · simp [hu,hf]
    change Tendsto (fun F : Finset ℕ => ∑ n ∈ F, S.cut (A n).1 x) atTop (𝓝 (S.cut U x))
    rw [Metric.tendsto_nhds]
    intro ε hε
    obtain ⟨k,hk⟩ := S.tail_small x ε hε
    let owner (j : ℕ) := if h : j ∈ U then (Set.mem_iUnion.mp h).choose else 0
    have hown (j : ℕ) (h : j ∈ U) : j ∈ (A (owner j)).1 := by
      simp only [owner,dite_eq_left h]
      exact (Set.mem_iUnion.mp h).choose_spec
    filter_upwards [eventually_ge_atTop ((Finset.range k).image owner)] with F hF
    let Z := U \ ⋃ n ∈ F, (A n).1
    have hZ : Z ⊆ Set.Ici k := by
      intro j hj
      by_contra hj'
      have hlt : j < k := lt_of_not_ge hj'
      have ho : owner j ∈ F := hF (Finset.mem_image.mpr ⟨j,Finset.mem_range.mpr hlt,rfl⟩)
      exact hj.2 (mem_iUnion.mpr ⟨_,mem_iUnion.mpr ⟨ho,hown j hj.1⟩⟩)
    rw [dist_comm,dist_eq_norm,heq]
    have h : S.cut Z (S.cut (Set.Ici k) x) = S.cut Z x := by
      rw [S.cut_comp,inter_eq_left.mpr hZ]
    rw [← h]
    exact (S.cut_norm _ _).trans_lt hk

theorem singleton_factor (n : ℕ) :
    S.pvm.val (MeasSet.natAtom n) = (S.single n).comp (S.eval n) := by
  ext x
  apply S.separates
  intro j
  change S.eval j (S.cut {n} x) = S.eval j (S.single n (S.eval n x))
  rw [S.cut_eval,S.single_eval]
  by_cases h : j = n <;> simp [h]

theorem localizes (hY : IsReflexive Y) : S.pvm.Localizes := by
  apply S.pvm.localizes_of_exists_partition
  intro ξ _
  refine ⟨MeasSet.natAtom, fun _ _ h => Set.disjoint_singleton.mpr h, ?_, fun n => ?_⟩
  · ext k
    simp [MeasSet.iUnion,MeasSet.natAtom,MeasSet.whole]
  · obtain ⟨y,hy⟩ := hY (secondAdjoint (S.eval n) ξ)
    refine ⟨S.single n y, ?_⟩
    ext f
    have hh := congrArg (fun g : Bidual Y => g (adjoint (S.single n) f)) hy
    rw [secondAdjoint_apply,J_apply] at hh
    rw [S.singleton_factor]
    exact hh.symm

end SequenceCoordinates

#print axioms SequenceCoordinates.pvm
#print axioms SequenceCoordinates.localizes

end SectionSevenCoordinateModel
