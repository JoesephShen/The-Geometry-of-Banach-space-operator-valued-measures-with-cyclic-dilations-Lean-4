section FrameVectorMeasureWeight

open MeasureTheory Function
open scoped ENNReal

namespace ContinuousSchauderFrame

variable {Ω X : Type*} [MeasurableSpace Ω] [NormedAddCommGroup X] [NormedSpace ℝ X]
  [CompleteSpace X] [TopologicalSpace.SeparableSpace X]
  {η : Measure Ω} (F : ContinuousSchauderFrame (X := X) η)

/-- The positive weight in prop:frame-dilation gives a Bochner-integrable
vector density with total norm at most one. The natural-number indexing
starts at zero, so the geometric mass on cell n is 2^(-n-1). -/
theorem exists_integrable_vector_weight (D : ℕ → MeasSet Ω)
    (hd : MeasSet.DisjointSeq D) (hc : MeasSet.iUnion D = MeasSet.whole)
    (hfin : ∀ n, η (D n).1 < ∞) :
    ∃ w : Ω → ℝ, Measurable w ∧ (∀ t, 0 < w t) ∧
      (∀ n t, t ∈ (D n).1 → w t =
        ((1 / 2 : ℝ) * (1 / 2 : ℝ)^n) / ((1 + η.real (D n).1) * (1 + ‖F.vector t‖))) ∧
      Integrable (fun t => w t • F.vector t) η ∧
      (∫ t, ‖w t • F.vector t‖ ∂η) ≤ 1 := by
  classical
  have hcov : (⋃ n, (D n).1) = univ := congrArg Subtype.val hc
  have hn (t : Ω) : ∃ n, t ∈ (D n).1 := mem_iUnion.mp (hcov.symm ▸ mem_univ t)
  choose N hN using hn
  have hindex (n : ℕ) (t : Ω) (ht : t ∈ (D n).1) : N t = n := by
    by_contra hne
    exact Set.disjoint_left.mp (hd hne) (hN t) ht
  have hNm : Measurable N := by
    apply measurable_to_countable
    intro t
    have hpre : N ⁻¹' {N t} = (D (N t)).1 := by
      ext u
      change N u = N t ↔ u ∈ (D (N t)).1
      exact ⟨fun h => h ▸ hN u, hindex _ _⟩
    rw [hpre]
    exact (D (N t)).2
  let c (n : ℕ) := (1 / 2 : ℝ) * (1 / 2 : ℝ)^n
  let a (n : ℕ) := c n / (1 + η.real (D n).1)
  have ha n : 0 < a n := by
    have hmass : 0 ≤ η.real (D n).1 := ENNReal.toReal_nonneg
    dsimp [a, c]
    positivity
  let w (t : Ω) := a (N t) / (1 + ‖F.vector t‖)
  have hw (t : Ω) : 0 < w t := div_pos (ha _) (by positivity)
  have hv := citePettisMeasurability F.vector F.weaklyMeasurable
  let : MeasurableSpace X := borel X
  let : BorelSpace X := ⟨rfl⟩
  have hwm : Measurable w :=
    ((measurable_of_countable a).comp hNm).div (measurable_const.add hv.measurable.norm)
  have hdef (n : ℕ) (t : Ω) (ht : t ∈ (D n).1) :
      w t = c n / ((1 + η.real (D n).1) * (1 + ‖F.vector t‖)) := by
    dsimp [w, a]
    rw [hindex n t ht, div_div]
  let H (t : Ω) := w t • F.vector t
  have hHm : StronglyMeasurable H := hwm.stronglyMeasurable.smul hv
  have hbound (n : ℕ) (t : Ω) (ht : t ∈ (D n).1) : ‖H t‖ ≤ a n := by
    change ‖w t • F.vector t‖ ≤ a n
    rw [norm_smul, Real.norm_of_nonneg (hw t).le]
    simp only [w, hindex n t ht]
    rw [div_mul_eq_mul_div]
    apply (div_le_iff₀ (show 0 < 1 + ‖F.vector t‖ by positivity)).mpr
    exact mul_le_mul_of_nonneg_left (by linarith) (ha n).le
  have hi (n : ℕ) : IntegrableOn H (D n).1 η := by
    apply IntegrableOn.of_bound (hfin n) hHm.aestronglyMeasurable (a n)
    filter_upwards [ae_restrict_mem (D n).2] with t ht
    exact hbound n t ht
  have hrow (n : ℕ) : (∫ t in (D n).1, ‖H t‖ ∂η) ≤ c n := by
    have hconst : IntegrableOn (fun _ : Ω => a n) (D n).1 η :=
      integrableOn_const (hfin n).ne
    calc
      _ ≤ ∫ _ : Ω in (D n).1, a n ∂η := by
        apply integral_mono_ae (hi n).norm hconst
        filter_upwards [ae_restrict_mem (D n).2] with t ht
        exact hbound n t ht
      _ = η.real (D n).1 * a n := setIntegral_const _
      _ ≤ c n := by
        have hmass : 0 ≤ η.real (D n).1 := ENNReal.toReal_nonneg
        have hc₀ : 0 ≤ c n := by dsimp [c]; positivity
        change η.real (D n).1 * (c n / (1 + η.real (D n).1)) ≤ c n
        rw [← mul_div_assoc]
        apply (div_le_iff₀ (show 0 < 1 + η.real (D n).1 by linarith)).mpr
        rw [mul_comm (η.real (D n).1)]
        exact mul_le_mul_of_nonneg_left (by linarith) hc₀
  have hcs : Summable c := (summable_geometric_of_lt_one
    (show 0 ≤ (1 / 2 : ℝ) by norm_num) (by norm_num)).mul_left _
  have hct : (∑' n, c n) = 1 := by
    unfold c
    rw [tsum_mul_left, tsum_geometric_of_lt_one (by norm_num) (by norm_num)]
    norm_num
  have hsum : Summable (fun n => ∫ t in (D n).1, ‖H t‖ ∂η) :=
    hcs.of_nonneg_of_le (fun _ => integral_nonneg fun _ => norm_nonneg _) hrow
  have hI : Integrable H η := by
    have h := integrableOn_iUnion_of_summable_integral_norm hi hsum
    rwa [hcov, integrableOn_univ] at h
  refine ⟨w, hwm, hw, hdef, hI, ?_⟩
  change (∫ t, ‖H t‖ ∂η) ≤ 1
  have hJ : IntegrableOn (fun t => ‖H t‖) (⋃ n, (D n).1) η := hI.norm.integrableOn
  have he := integral_iUnion (fun n => (D n).2) hd hJ
  rw [hcov, setIntegral_univ] at he
  rw [he, ← hct]
  exact hsum.tsum_le_tsum hrow hcs

/-- The weighted densities give the vector measure and its exact
scalar density in the cyclic dilation construction. -/
theorem exists_weighted_vectorMeasure [SigmaFinite η] :
    ∃ (w : Ω → ℝ) (m : MeasSet Ω → X),
      Measurable w ∧ (∀ t, 0 < w t) ∧
      Integrable (fun t => w t • F.vector t) η ∧
      (∫ t, ‖w t • F.vector t‖ ∂η) ≤ 1 ∧
      (∀ E, m E = ∫ t in E.1, w t • F.vector t ∂η) ∧
      m MeasSet.empty = 0 ∧
      (∀ E : ℕ → MeasSet Ω, MeasSet.DisjointSeq E →
        HasSum (fun n => m (E n)) (m (MeasSet.iUnion E))) ∧
      ∀ (E : MeasSet Ω) (g : Dual X), g (m E) = ∫ t in E.1, w t * g (F.vector t) ∂η := by
  obtain ⟨D, hd, hc, hb⟩ := F.exists_bounded_measurable_partition
  obtain ⟨w, hwm, hwp, _, hi, hnorm⟩ := F.exists_integrable_vector_weight D hd hc (fun n => (hb n).1)
  let m (E : MeasSet Ω) := ∫ t in E.1, w t • F.vector t ∂η
  refine ⟨w, m, hwm, hwp, hi, hnorm, fun _ => rfl, ?_, ?_, ?_⟩
  · exact setIntegral_empty
  · intro E hE
    exact hasSum_integral_iUnion (fun n => (E n).2) hE hi.integrableOn
  · intro E g
    have h := (g.integral_comp_comm (hi.restrict (s := E.1))).symm
    simpa only [m, map_smul, smul_eq_mul] using h


omit [TopologicalSpace.SeparableSpace X] in
/-- The scalar coefficients of f_t(x)/w(t) against the weighted vector
density recover the original coefficients on every measurable cut. -/
theorem weighted_analysis_coeff (w : Ω → ℝ) (hwm : Measurable w)
    (hwp : ∀ t, 0 < w t) (x : X) (g : Dual X) :
    Measurable (fun t => F.functional t x / w t) ∧
      Integrable (fun t => |F.functional t x / w t| * |w t * g (F.vector t)|) η ∧
      ∀ E : MeasSet Ω, g (F.operatorMeasure.val E x) =
        ∫ t in E.1, (F.functional t x / w t) * (w t * g (F.vector t)) ∂η := by
  have hc (t : Ω) : (F.functional t x / w t) * (w t * g (F.vector t)) =
      F.functional t x * g (F.vector t) := by
    rw [← mul_assoc, div_mul_cancel₀ _ (hwp t).ne']
  have hi : Integrable (fun t => F.functional t x * g (F.vector t)) η := by
    simpa only [map_smul, smul_eq_mul] using ((F.pettis x).1 g).2
  refine ⟨(F.weakStarMeasurable x).div hwm, ?_, fun E => ?_⟩
  · have h := hi.norm
    simpa only [Real.norm_eq_abs, ← hc, abs_mul] using h
  · simp_rw [hc]
    exact F.operatorMeasure_coeff E x g

end ContinuousSchauderFrame

#print axioms ContinuousSchauderFrame.exists_integrable_vector_weight
#print axioms ContinuousSchauderFrame.exists_weighted_vectorMeasure

#print axioms ContinuousSchauderFrame.weighted_analysis_coeff

