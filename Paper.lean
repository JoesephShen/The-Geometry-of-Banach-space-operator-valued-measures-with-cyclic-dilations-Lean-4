/-- Manuscript, thm:representation-james (1), with the three original clauses. -/
theorem PVM.shrinking_james [CompleteSpace X] (P : PVM Ω X) (hP : P.Localizes) :
    (P.toOVM.Shrinking ↔ ¬ ContainsCopy LOne X) ∧
      (P.toOVM.Shrinking ↔ ∀ ξ : Bidual X, P.toOVM.Normal ξ) :=
  ⟨⟨P.not_contains_lOne_of_shrinking hP, P.toOVM.shrinking_of_not_contains_lOne⟩,
    P.toOVM.shrinking_iff_all_normal⟩

/-- Manuscript, prop:ovm-normal (1), with the original localization assumption. -/
theorem Dilation.shrinking_iff_not_contains_lOne [CompleteSpace X] [CompleteSpace Z]
    {μ : OVM Ω X} (D : Dilation μ Z) (hP : D.P.Localizes) :
    μ.Shrinking ↔ ¬ ContainsCopy LOne X :=
  ⟨D.not_contains_lOne_of_shrinking hP, μ.shrinking_of_not_contains_lOne⟩

/-- The two excluded copies used in the reverse reflexivity implications
of Theorem 3.4, Corollary 3.5 and Proposition 4.5. -/
theorem IsReflexive.excludes_lOne_and_cZero (hX : IsReflexive X) :
    (¬ ContainsCopy LOne X) ∧ (¬ ContainsCopy CZero X) := by
  have hB (ξ : Bidual X) : BaireOne ξ := by
    obtain ⟨x, rfl⟩ := hX ξ
    exact ⟨fun _ => x, fun _ => tendsto_const_nhds⟩
  have hW : WeaklySeqComplete X := by
    intro x hx
    obtain ⟨ξ, hξ⟩ := exists_baireOne_of_weakCauchy x hx
    obtain ⟨y, rfl⟩ := hX ξ
    exact ⟨y, hξ⟩
  exact ⟨not_contains_lOne_of_baireOne_all hB, hW.not_contains_cZero⟩

/-- All equivalences in the first main theorem of the manuscript. -/
theorem PVM.representation_james [CompleteSpace X] (P : PVM Ω X) (hP : P.Localizes) :
    (P.toOVM.Shrinking ↔ ¬ ContainsCopy LOne X) ∧
    (P.toOVM.Shrinking ↔ ∀ ξ : Bidual X, P.toOVM.Normal ξ) ∧
    (P.BoundedlyComplete ↔ ¬ ContainsCopy CZero X) ∧
    (P.BoundedlyComplete ↔ WeaklySeqComplete X) ∧
    (P.BoundedlyComplete ↔ {ξ : Bidual X | P.toOVM.Normal ξ} = Set.range (J : X → Bidual X)) ∧
    (IsReflexive X ↔ P.toOVM.Shrinking ∧ P.BoundedlyComplete) :=
  ⟨(P.shrinking_james hP).1, (P.shrinking_james hP).2,
    (P.boundedlyComplete_james hP).1, (P.boundedlyComplete_james hP).2.1,
    (P.boundedlyComplete_james hP).2.2,
    ⟨fun h => ⟨P.toOVM.shrinking_of_not_contains_lOne h.excludes_lOne_and_cZero.1,
        P.boundedlyComplete_of_not_contains_cZero h.excludes_lOne_and_cZero.2⟩,
      fun h => P.reflexive_of_shrinking_boundedlyComplete hP h.1 h.2⟩⟩

/-- All equivalences of prop:ovm-normal with the manuscript's hypotheses. -/
theorem Dilation.james [CompleteSpace X] [CompleteSpace Z] {μ : OVM Ω X}
    (D : Dilation μ Z) (hP : D.P.Localizes) :
    (μ.Shrinking ↔ ¬ ContainsCopy LOne X) ∧
    (μ.BoundedlyComplete ↔ ¬ ContainsCopy CZero X) ∧
    (IsReflexive X ↔ μ.Shrinking ∧ μ.BoundedlyComplete) :=
  ⟨D.shrinking_iff_not_contains_lOne hP, D.boundedlyComplete_iff_not_contains_cZero hP,
    ⟨fun h => ⟨μ.shrinking_of_not_contains_lOne h.excludes_lOne_and_cZero.1,
        μ.alpha_boundedlyComplete_of_not_contains_cZero h.excludes_lOne_and_cZero.2⟩,
      fun h => (D.shrinking_boundedlyComplete_iff_reflexive hP).mp h⟩⟩

