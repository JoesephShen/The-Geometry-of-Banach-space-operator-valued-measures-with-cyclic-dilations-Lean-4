namespace Paper

noncomputable section SectionSevenComplement

open Set Filter
open scoped Topology

theorem exponentialComplement_asymptotic (v : ℝ) (hv : Real.exp 4 ≤ v) :
    (1 / 2 : ℝ) * v * Real.sqrt (Real.log v) ≤ exponentialComplement v ∧
    exponentialComplement v ≤ 2 * v * Real.sqrt (Real.log v) := by
  let L := Real.log v
  let k := Real.sqrt L
  have hv₀ : 0 < v := (Real.exp_pos 4).trans_le hv
  have hv₁ : 1 ≤ v := (by
    have hh := Real.exp_le_exp.mpr (show (0 : ℝ) ≤ 4 by norm_num)
    rwa [Real.exp_zero] at hh :
    1 ≤ Real.exp 4).trans hv
  have hL : 4 ≤ L := by
    have h := Real.log_le_log (Real.exp_pos 4) hv
    rwa [Real.log_exp] at h
  have hL₀ : 0 ≤ L := by linarith
  have hk₀ : 0 ≤ k := Real.sqrt_nonneg _
  have hk₂ : k ^ 2 = L := Real.sq_sqrt hL₀
  have hk : 2 ≤ k := by
    by_contra! h
    have he := (mul_self_lt_mul_self hk₀ h)
    nlinarith
  let S := (fun u : ℝ => v * u - exponentialYoung u) '' Set.Ici 0
  have hb : 2 * v * k ∈ upperBounds S := by
    rintro _ ⟨u, hu, rfl⟩
    have hu₀ : 0 ≤ u := hu
    by_cases h : u ≤ 2 * k
    · have he : 0 ≤ exponentialYoung u := by
        change 0 ≤ Real.exp (u ^ 2) - 1
        have he := Real.exp_le_exp.mpr (sq_nonneg u)
        rw [Real.exp_zero] at he
        linarith
      have hm := mul_le_mul_of_nonneg_left h hv₀.le
      linarith
    · have hlu : L ≤ u ^ 2 / 2 := by
        have hle := mul_self_le_mul_self (show 0 ≤ 2 * k by positivity) (le_of_not_ge h)
        nlinarith
      have huc : u ≤ u ^ 2 / 2 := by
        have h2 : 2 ≤ u := by linarith
        have hu2 := mul_le_mul_of_nonneg_right h2 hu₀
        nlinarith
      have hev : v ≤ Real.exp (u ^ 2 / 2) := by
        have he := Real.exp_le_exp.mpr hlu
        simpa only [L, Real.exp_log hv₀] using he
      have heu : u + 1 ≤ Real.exp (u ^ 2 / 2) :=
        (add_le_add_left huc 1).trans (Real.add_one_le_exp _)
      have hm := mul_le_mul hev heu (by positivity : 0 ≤ u + 1) (Real.exp_pos _).le
      rw [← Real.exp_add, show u ^ 2 / 2 + u ^ 2 / 2 = u ^ 2 by ring] at hm
      have hz : v * u - exponentialYoung u ≤ 0 := by
        unfold exponentialYoung
        nlinarith
      exact hz.trans (by positivity)
  have hs : S.Nonempty := ⟨_, ⟨0, show (0 : ℝ) ≤ 0 from le_rfl, rfl⟩⟩
  constructor
  · have hmem : v * k - exponentialYoung k ∈ S := ⟨k, hk₀, rfl⟩
    have hsup : v * k - exponentialYoung k ≤ exponentialComplement v :=
      le_csSup ⟨_, hb⟩ hmem
    refine le_trans ?_ hsup
    unfold exponentialYoung
    rw [hk₂, Real.exp_log hv₀]
    have hm := mul_le_mul_of_nonneg_left hk hv₀.le
    nlinarith
  · exact csSup_le hs hb

theorem exponentialComplement_deltaTwo : DeltaTwoAtInfinity exponentialComplement := by
  refine ⟨16, Real.exp 4, fun v hv => ?_⟩
  have hv₀ : 0 < v := (Real.exp_pos 4).trans_le hv
  have h₂ : Real.exp 4 ≤ 2 * v := hv.trans (by linarith)
  have hlog : Real.log 2 ≤ Real.log v := by
    apply Real.log_le_log (by norm_num)
    have h := Real.add_one_le_exp (4 : ℝ)
    linarith
  have hL : 0 ≤ Real.log v := by
    have h := Real.log_le_log (Real.exp_pos 4) hv
    rw [Real.log_exp] at h
    linarith
  have hroot : Real.sqrt (Real.log (2 * v)) ≤ 2 * Real.sqrt (Real.log v) := by
    rw [Real.log_mul (by norm_num) hv₀.ne']
    have h := Real.sqrt_le_sqrt (show Real.log 2 + Real.log v ≤ 4 * Real.log v by linarith)
    simpa only [Real.sqrt_mul (by norm_num : (0 : ℝ) ≤ 4), show Real.sqrt 4 = 2 by
      rw [show (4 : ℝ) = 2 ^ 2 by norm_num, Real.sqrt_sq (by norm_num : (0 : ℝ) ≤ 2)]] using h
  have hm := mul_le_mul_of_nonneg_left hroot (show 0 ≤ 2 * (2 * v) by positivity)
  have hlo := (exponentialComplement_asymptotic v hv).1
  have hhi := (exponentialComplement_asymptotic (2 * v) h₂).2
  nlinarith

#print axioms exponentialComplement_asymptotic
#print axioms exponentialComplement_deltaTwo

