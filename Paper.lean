section MinimalGeometry

variable {Ω X : Type*} [MeasurableSpace Ω] [NormedAddCommGroup X] [NormedSpace ℝ X]

local instance : TopologicalSpace (MeasSet Ω) := ⊥
local instance : Nonempty (MeasSet Ω) := ⟨MeasSet.empty⟩

private theorem PVM.alphaAnalysis_value [CompleteSpace X] (P : PVM Ω X) (x : X) (E : MeasSet Ω) :
    (P.toOVM.alphaAnalysis x).1 E = P.val E x := by
  change P.val (MeasSet.whole.inter E) x = P.val E x
  rw [show MeasSet.whole.inter E = E from Subtype.ext (univ_inter _)]

/-- The isomorphism \(Ux(E)=P(E)x\) for the minimal dilation of a PVM. -/
noncomputable def PVM.alphaEquiv [CompleteSpace X] (P : PVM Ω X) :
    X ≃L[ℝ] P.toOVM.alphaSubmodule := by
  let μ := P.toOVM
  refine
    { toLinearEquiv :=
        { toFun := μ.alphaAnalysis
          invFun := μ.alphaSynthesis
          left_inv := fun x => congrArg (fun A : X →L[ℝ] X => A x)
            (μ.alphaDilation P.normalized).split
          right_inv := fun η => ?_
          map_add' := map_add _
          map_smul' := map_smul _ }
      continuous_toFun := μ.alphaAnalysis.continuous
      continuous_invFun := μ.alphaSynthesis.continuous }
  apply Subtype.ext
  ext E
  rw [P.alphaAnalysis_value]
  let L := (P.val E).comp (BoundedContinuousFunction.evalCLM ℝ
    (MeasSet.whole : MeasSet Ω) : AlphaAmbient Ω X →L[ℝ] X)
  let R : AlphaAmbient Ω X →L[ℝ] X := BoundedContinuousFunction.evalCLM ℝ E
  change L η.1 = R η.1
  apply μ.alpha_extension_eq L R _ η
  intro F x
  change P.val E (μ.alphaElementary F x MeasSet.whole) = μ.alphaElementary F x E
  rw [μ.alphaElementary_apply, μ.alphaElementary_apply]
  rw [show F.inter MeasSet.whole = F from Subtype.ext (inter_univ _),
    P.apply_inter, MeasSet.inter_comm E F]

theorem PVM.alphaEquiv_intertwines [CompleteSpace X] (P : PVM Ω X) (E : MeasSet Ω) (x : X) :
    P.alphaEquiv (P.val E x) = P.toOVM.alphaPVM.val E (P.alphaEquiv x) := by
  apply Subtype.ext
  ext F
  change (P.toOVM.alphaAnalysis (P.val E x)).1 F =
    (P.toOVM.alphaAnalysis x).1 (E.inter F)
  rw [P.alphaAnalysis_value, P.alphaAnalysis_value, P.apply_inter, MeasSet.inter_comm F E]

theorem PVM.alphaEquiv_norm_bounds [CompleteSpace X] (P : PVM Ω X) (x : X) :
    ‖x‖ ≤ ‖P.alphaEquiv x‖ ∧ ‖P.alphaEquiv x‖ ≤ P.toOVM.uniformNorm * ‖x‖ := by
  change ‖x‖ ≤ ‖P.toOVM.alphaAnalysis x‖ ∧ ‖P.toOVM.alphaAnalysis x‖ ≤ _
  constructor
  · have hx : (P.toOVM.alphaAnalysis x).1 MeasSet.whole = x := by
      rw [P.alphaAnalysis_value, show P.val MeasSet.whole = ContinuousLinearMap.id ℝ X from P.normalized]
      rfl
    calc
      ‖x‖ = ‖(P.toOVM.alphaAnalysis x).1 MeasSet.whole‖ := congrArg norm hx.symm
      _ ≤ _ := BoundedContinuousFunction.norm_coe_le_norm _ _
  · apply (BoundedContinuousFunction.norm_le (f := (P.toOVM.alphaAnalysis x).1)
      (mul_nonneg P.toOVM.uniformNorm_nonneg (norm_nonneg x))).mpr
    intro E
    rw [P.alphaAnalysis_value]
    exact ((P.val E).le_opNorm x).trans
      (mul_le_mul_of_nonneg_right (P.toOVM.opNorm_le_uniformNorm E) (norm_nonneg x))

/-- The Banach-space equivalences in cor:review-minimal-kb. -/
theorem OVM.minimal_cZero_equivalences [CompleteSpace X] (μ : OVM Ω X) (hμ : μ.Normalized)
    (hc : μ.alphaPVM.Cyclic) :
    (¬ ContainsCopy CZero μ.alphaSubmodule ↔ μ.BoundedlyComplete) ∧
      (μ.BoundedlyComplete ↔ ¬ ContainsCopy CZero X) := by
  have hl := μ.alphaPVM.localizes_of_cyclic hc
  exact ⟨(μ.alphaPVM.boundedlyComplete_james hl).1.symm,
    (μ.alphaDilation hμ).boundedlyComplete_iff_not_contains_cZero hl⟩

#print axioms PVM.alphaEquiv
#print axioms PVM.alphaEquiv_intertwines
#print axioms PVM.alphaEquiv_norm_bounds
#print axioms OVM.minimal_cZero_equivalences


private theorem PVM.boundedlyComplete_of_intertwined_equiv [CompleteSpace X]
    {Y : Type*} [NormedAddCommGroup Y] [NormedSpace ℝ Y]
    (P : PVM Ω X) (R : PVM Ω Y) (A : X ≃L[ℝ] Y)
    (hA : ∀ E x, A (P.val E x) = R.val E (A x))
    (hR : R.BoundedlyComplete) : P.BoundedlyComplete := by
  intro E z hE hz hb
  obtain ⟨C, hC⟩ := hb
  have hp (n : ℕ) : R.val (E n) (A (z n)) = A (z n) := by
    rw [← hA, hz]
  have hb' (N : ℕ) : ‖∑ n ∈ Finset.range N, A (z n)‖ ≤
      ‖A.toContinuousLinearMap‖ * C := by
    rw [← map_sum]
    exact (A.toContinuousLinearMap.le_opNorm _).trans
      (mul_le_mul_of_nonneg_left (hC N) (norm_nonneg _))
  obtain ⟨y, hy⟩ := hR E (fun n => A (z n)) hE hp ⟨_, hb'⟩
  refine ⟨A.symm y, ?_⟩
  have ht := (A.symm.continuous.tendsto y).comp hy
  have he : (fun N => A.symm (∑ n ∈ Finset.range N, A (z n))) =
      (fun N => ∑ n ∈ Finset.range N, z n) := by
    funext N
    rw [← map_sum, A.symm_apply_apply]
  change Tendsto (fun N => A.symm (∑ n ∈ Finset.range N, A (z n))) atTop
    (𝓝 (A.symm y)) at ht
  exact he ▸ ht

/-- The two definitions of bounded completeness agree for a PVM. -/
theorem PVM.boundedlyComplete_iff_alpha [CompleteSpace X] (P : PVM Ω X) :
    P.BoundedlyComplete ↔ P.toOVM.BoundedlyComplete := by
  change P.BoundedlyComplete ↔ P.toOVM.alphaPVM.BoundedlyComplete
  constructor
  · apply PVM.boundedlyComplete_of_intertwined_equiv _ P P.alphaEquiv.symm
    intro E y
    apply P.alphaEquiv.injective
    rw [P.alphaEquiv.apply_symm_apply, P.alphaEquiv_intertwines, P.alphaEquiv.apply_symm_apply]
  · exact P.boundedlyComplete_of_intertwined_equiv _ P.alphaEquiv P.alphaEquiv_intertwines

#print axioms PVM.boundedlyComplete_iff_alpha

end MinimalGeometry

section GeometricDilationSteps

variable {Ω X Z F : Type*} [MeasurableSpace Ω]
  [NormedAddCommGroup X] [NormedSpace ℝ X]
  [NormedAddCommGroup Z] [NormedSpace ℝ Z]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

/-- Weak precompactness of a bounded subset, in the sequential convention
of the manuscript, immediately before lem:multiplier-hull. -/
def WeaklyPrecompactSet (K : Set Z) : Prop :=
  (∃ C : ℝ, ∀ z ∈ K, ‖z‖ ≤ C) ∧
    ∀ z : ℕ → Z, (∀ n, z n ∈ K) →
      ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∀ f : Dual Z, CauchySeq (fun n => f (z (φ n)))

/-- Rosenthal applied to the seed `T₀(B_X) ∪ {1}` in the forward proof
of thm:dilation-geometry. The additional point is written as `u`. -/
theorem weaklyPrecompact_image_unitBall_union_singleton [CompleteSpace X]
    (T₀ : X →L[ℝ] Z) (u : Z) (hX : ¬ ContainsCopy LOne X) :
    WeaklyPrecompactSet (T₀ '' Metric.closedBall (0 : X) 1 ∪ {u}) := by
  constructor
  · refine ⟨max ‖T₀‖ ‖u‖, ?_⟩
    intro z hz
    rcases hz with ⟨x, hx, rfl⟩ | hzu
    · exact (T₀.le_opNorm_of_le (mem_closedBall_zero_iff.mp hx)).trans
        (by simpa only [mul_one] using le_max_left ‖T₀‖ ‖u‖)
    · rw [Set.mem_singleton_iff.mp hzu]
      exact le_max_right _ _
  · intro z hz
    by_cases hu : ∃ᶠ n in atTop, z n = u
    · obtain ⟨φ, hφ, he⟩ := extraction_of_frequently_atTop hu
      refine ⟨φ, hφ, fun f => ?_⟩
      have ht : Tendsto (fun n => f (z (φ n))) atTop (𝓝 (f u)) :=
        tendsto_const_nhds.congr (fun n => congrArg f (he n).symm)
      exact ht.cauchySeq
    · have he : ∀ᶠ n in atTop, z n ≠ u := not_frequently.mp hu
      obtain ⟨N, hN⟩ := eventually_atTop.mp he
      have hex (n : ℕ) : ∃ x : X, ‖x‖ ≤ 1 ∧ T₀ x = z (N + n) := by
        rcases hz (N + n) with ⟨x, hx, hEq⟩ | hzu
        · exact ⟨x, mem_closedBall_zero_iff.mp hx, hEq⟩
        · exact (hN _ (Nat.le_add_right N n) (Set.mem_singleton_iff.mp hzu)).elim
      choose x hx hxz using hex
      obtain ⟨φ, hφ, hc⟩ := citeRosenthal1974 X hX x ⟨1, hx⟩
      refine ⟨fun n => N + φ n, fun i j hij => Nat.add_lt_add_left (hφ hij) _, fun f => ?_⟩
      have hEq : (fun n => f (z (N + φ n))) = fun n => (f.comp T₀) (x (φ n)) :=
        funext fun n => congrArg f (hxz (φ n)).symm
      rw [hEq]
      exact hc (f.comp T₀)

/-- The last step of lem:multiplier-hull. For a norm-closed convex,
weakly precompact hull, weak sequential completeness and Eberlein–Šmulian
give compactness in the weak topology. -/
theorem WeaklyPrecompactSet.weaklyCompact_of_closed_convex [CompleteSpace Z]
    {K : Set Z} (hK : WeaklyPrecompactSet K) (hclosed : IsClosed K)
    (hconvex : Convex ℝ K) (hZ : WeaklySeqComplete Z) :
    IsCompact ((toWeakSpace ℝ Z) '' K) := by
  have hWclosed : IsClosed ((toWeakSpace ℝ Z) '' K) := by
    have hEq := hconvex.toWeakSpace_closure ℝ
    rw [hclosed.closure_eq] at hEq
    exact hEq.symm ▸ isClosed_closure
  apply ((citeEberleinSmulian Z).1 _).mpr
  intro v hv
  choose z hz he using hv
  obtain ⟨φ, hφ, hc⟩ := hK.2 z hz
  obtain ⟨y, hy⟩ := hZ (fun n => z (φ n)) hc
  have ht : Tendsto (fun n => toWeakSpace ℝ Z (z (φ n))) atTop
      (𝓝 (toWeakSpace ℝ Z y)) := by
    apply (WeakBilin.tendsto_iff_forall_eval_tendsto (topDualPairing ℝ Z).flip ?_).mpr
    · exact hy
    · intro x y' hxy
      exact eq_of_dual_eval fun f => DFunLike.congr_fun hxy f
  have hm : toWeakSpace ℝ Z y ∈ (toWeakSpace ℝ Z) '' K :=
    hWclosed.mem_of_tendsto ht (Eventually.of_forall fun n => ⟨_, hz (φ n), rfl⟩)
  refine ⟨toWeakSpace ℝ Z y, hm, φ, hφ, ?_⟩
  exact ht.congr (fun n => he (φ n))

/-- Lift the analysis operator into the interpolation space using the
unit-ball inclusion, then use the two intertwining identities in
thm:dilation-geometry to prove the dilation identities for `S_F=SJ`. -/
theorem Dilation.exists_lifted_analysis {μ : OVM Ω X} (D : Dilation μ Z)
    (Q : PVM Ω F) (J₀ : F →L[ℝ] Z) (hJ : Function.Injective J₀)
    (hinter : ∀ E : MeasSet Ω, J₀.comp (Q.val E) = (D.P.val E).comp J₀)
    (hball : ∀ x : X, ‖x‖ ≤ 1 → ∃ y : F, J₀ y = D.T x ∧ ‖y‖ ≤ 1) :
    ∃ D' : Dilation μ F, D'.P = Q ∧ D'.S = D.S.comp J₀ ∧ J₀.comp D'.T = D.T ∧ ‖D'.T‖ ≤ 1 := by
  classical
  have hlift (x : X) : ∃ y : F, J₀ y = D.T x ∧ ‖y‖ ≤ ‖x‖ := by
    by_cases hx : x = 0
    · subst x
      exact ⟨0, by simp, by simp⟩
    have hpos : 0 < ‖x‖ := norm_pos_iff.mpr hx
    have hu : ‖(‖x‖⁻¹ : ℝ) • x‖ = 1 := by
      rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr hpos.le), inv_mul_cancel₀ hpos.ne']
    obtain ⟨y, hy, hny⟩ := hball _ hu.le
    refine ⟨‖x‖ • y, ?_, ?_⟩
    · rw [map_smul, hy, map_smul, smul_smul, mul_inv_cancel₀ hpos.ne', one_smul]
    · rw [norm_smul, Real.norm_of_nonneg hpos.le]
      simpa only [mul_one] using mul_le_mul_of_nonneg_left hny hpos.le
  choose y hy hnorm using hlift
  let L : X →ₗ[ℝ] F :=
    { toFun := y
      map_add' := fun x z => hJ (by rw [map_add, hy, hy, hy, map_add])
      map_smul' := fun c x => hJ (by rw [map_smul, hy, hy, map_smul]; rfl) }
  have hL (x : X) : ‖L x‖ ≤ 1 * ‖x‖ := by
    change ‖y x‖ ≤ 1 * ‖x‖
    simpa only [one_mul] using hnorm x
  let T₁ := L.mkContinuous 1 hL
  have hT : J₀.comp T₁ = D.T := by
    ext x
    exact hy x
  let D₁ : Dilation μ F :=
    { P := Q
      S := D.S.comp J₀
      T := T₁
      split := by
        rw [ContinuousLinearMap.comp_assoc, hT]
        exact D.split
      compress := fun E => by
        ext x
        change D.S (J₀ (Q.val E (y x))) = μ.val E x
        have hE : J₀ (Q.val E (y x)) = D.P.val E (J₀ (y x)) :=
          congrArg (fun A : F →L[ℝ] Z => A (y x)) (hinter E)
        rw [hE, hy]
        exact congrArg (fun A : X →L[ℝ] X => A x) (D.compress E) }
  exact ⟨D₁, rfl, rfl, hT, LinearMap.mkContinuous_norm_le L zero_le_one hL⟩

#print axioms weaklyPrecompact_image_unitBall_union_singleton
#print axioms WeaklyPrecompactSet.weaklyCompact_of_closed_convex
#print axioms Dilation.exists_lifted_analysis

end GeometricDilationSteps

section VectorMeasureDilationSteps

variable {Ω X Z : Type*} [MeasurableSpace Ω]
  [NormedAddCommGroup X] [NormedSpace ℝ X]
  [NormedAddCommGroup Z] [NormedSpace ℝ Z]

/-- The actual vector measure (m(E)=SP(E)u) in prop:vector-measure-dilation. -/
def Dilation.cyclicVectorMeasure {μ : OVM Ω X} (D : Dilation μ Z) (u : Z)
    (E : MeasSet Ω) : X := D.S (D.P.val E u)

theorem Dilation.cyclicVectorMeasure_empty {μ : OVM Ω X} (D : Dilation μ Z) (u : Z) :
    D.cyclicVectorMeasure u MeasSet.empty = 0 := by
  simp [Dilation.cyclicVectorMeasure, D.P.empty_eq]

theorem Dilation.cyclicVectorMeasure_hasSum {μ : OVM Ω X} (D : Dilation μ Z) (u : Z)
    (E : ℕ → MeasSet Ω) (hE : MeasSet.DisjointSeq E) :
    HasSum (fun n => D.cyclicVectorMeasure u (E n))
      (D.cyclicVectorMeasure u (MeasSet.iUnion E)) :=
  D.S.hasSum (D.P.countably_additive E hE u)

/-- Integration of a simple function represented by measurable cells after
restriction to (E). The coefficient equality is valid for every finite
representation, and is independent of the choice of the scalar functional. -/
theorem Dilation.cyclicVectorMeasure_restricted_simple_integral {μ : OVM Ω X}
    (D : Dilation μ Z) (u : Z) (B : ℕ → MeasSet Ω) (a : ℕ → ℝ) (I : Finset ℕ)
    (E : MeasSet Ω) :
    ∑ j ∈ I, a j • D.cyclicVectorMeasure u (E.inter (B j)) =
      D.S (D.P.val E (∑ j ∈ I, a j • D.P.val (B j) u)) := by
  rw [map_sum, map_sum]
  apply Finset.sum_congr rfl
  intro j _
  rw [map_smul, map_smul]
  exact congrArg (fun v : Z => a j • D.S v) (D.P.apply_inter E (B j) u).symm

/-- The absolute sum over a disjoint test family in prop:vector-measure-dilation,
before taking the scalar total variation and the supremum over the unit dual ball. -/
theorem Dilation.cyclicVectorMeasure_simple_variation_bound [CompleteSpace Z]
    {μ : OVM Ω X} (D : Dilation μ Z) (u : Z) (B : ℕ → MeasSet Ω) (a : ℕ → ℝ) (I : Finset ℕ)
    (E : ℕ → MeasSet Ω) (hE : MeasSet.DisjointSeq E) (J : Finset ℕ) (g : Dual X) :
    ∑ i ∈ J, |g (∑ j ∈ I, a j • D.cyclicVectorMeasure u ((E i).inter (B j)))| ≤
      2 * D.P.toOVM.uniformNorm * ‖D.S‖ * ‖∑ j ∈ I, a j • D.P.val (B j) u‖ * ‖g‖ := by
  let w := ∑ j ∈ I, a j • D.P.val (B j) u
  simp_rw [D.cyclicVectorMeasure_restricted_simple_integral]
  change (∑ i ∈ J, |(g.comp D.S) (D.P.val (E i) w)|) ≤ _
  refine (D.P.toOVM.abs_finite_orbit_coefficients_le E hE w (g.comp D.S) J).trans ?_
  refine (mul_le_mul_of_nonneg_left (g.opNorm_comp_le D.S) ?_).trans_eq ?_
  · exact mul_nonneg (mul_nonneg (by norm_num) D.P.toOVM.uniformNorm_nonneg) (norm_nonneg w)
  · change 2 * D.P.toOVM.uniformNorm * ‖w‖ * (‖g‖ * ‖D.S‖) =
      2 * D.P.toOVM.uniformNorm * ‖D.S‖ * ‖w‖ * ‖g‖
    ring

#print axioms Dilation.cyclicVectorMeasure_hasSum
#print axioms Dilation.cyclicVectorMeasure_restricted_simple_integral
#print axioms Dilation.cyclicVectorMeasure_simple_variation_bound

end VectorMeasureDilationSteps






section VectorMeasureL1

universe uSource uValue

variable {S : Type uSource} {A : Type uValue} {Z Y : Type*} [MeasurableSpace S]
  [NormedAddCommGroup A] [NormedSpace ℝ A]
  [NormedAddCommGroup Z] [NormedSpace ℝ Z]

/-- The integral on a measurable set of a finite sum of indicator functions. -/
noncomputable def vectorSimpleIntegral (m : MeasSet S → A) (a : MeasSet S →₀ ℝ)
    (E : MeasSet S) : A :=
  Finsupp.linearCombination ℝ (fun F => m (E.inter F)) a

/-- The scalar total-variation expressions defining the norm of a simple
function in the vector-measure L¹ space. The outer supremum ranges over
the dual unit ball, and the inner one ranges over finite disjoint tests. -/
def vectorSimpleVariations (m : MeasSet S → A) (a : MeasSet S →₀ ℝ) : Set ℝ :=
  {r | ∃ g : Dual A, ‖g‖ ≤ 1 ∧ ∃ E : ℕ → MeasSet S, MeasSet.DisjointSeq E ∧
    ∃ I : Finset ℕ, r = ∑ n ∈ I, |g (vectorSimpleIntegral m a (E n))|}


/-- The nonnegative simple functions in a cyclic orbit. The coefficients
are nonnegative, and finite sums of indicators cover all such functions. -/
def positiveIndicatorSums (w : MeasSet S → Z) : Set Z :=
  {z | ∃ a : MeasSet S →₀ ℝ, (∀ E, 0 ≤ a E) ∧ Finsupp.linearCombination ℝ w a = z}


/-- Standard Banach-space data of the quotient L¹(m) used in
prop:vector-measure-dilation. The simple-function norm is the
supremum of the scalar variations. -/
structure VectorMeasureL1Data (m : MeasSet S → A) (Y : Type*)
    [NormedAddCommGroup Y] [NormedSpace ℝ Y] where
  multiplication : PVM S Y
  indicator : MeasSet S → Y
  integration : Y →L[ℝ] A
  dense_indicators : Dense (Submodule.span ℝ (Set.range indicator) : Set Y)
  multiplication_indicator : ∀ E F, multiplication.val E (indicator F) = indicator (E.inter F)
  integration_indicator : ∀ E, integration (indicator E) = m E
  norm_integration_le_one : ‖integration‖ ≤ 1
  norm_multiplication_le_one : ∀ E, ‖multiplication.val E‖ ≤ 1
  norm_simple : ∀ a : MeasSet S →₀ ℝ,
    ‖Finsupp.linearCombination ℝ indicator a‖ = sSup (vectorSimpleVariations m a)

  latticeOrder : Lattice Y
  positive_indicator_closure :
    closure (positiveIndicatorSums indicator) = (letI := latticeOrder; {y : Y | 0 ≤ y})

structure VectorMeasureL1Model (m : MeasSet S → A) where
  carrier : Type (max uSource uValue)
  normedGroup : NormedAddCommGroup carrier
  normedScalar : letI := normedGroup; NormedSpace ℝ carrier
  isComplete : letI := normedGroup; CompleteSpace carrier
  data : letI := normedGroup; letI := normedScalar; VectorMeasureL1Data m carrier

/-- Standard construction of the quotient L¹(m) for a countably additive
Banach-valued measure. See the vector-measure integration theorem in
Diestel–Uhl, *Vector Measures*, Chapter I, and the L¹(m) construction
recalled in Okada–Ricker–Sánchez Pérez, Dissertationes Math. 500 (2014),
Sections 2–3. Only the simple-function norm and the usual canonical
indicator, multiplication and integration operations are used here. -/
axiom citeVectorMeasureL1 [CompleteSpace A] (m : MeasSet S → A)
    (h0 : m MeasSet.empty = 0)
    (hσ : ∀ E : ℕ → MeasSet S, MeasSet.DisjointSeq E →
      HasSum (fun n => m (E n)) (m (MeasSet.iUnion E))) :
    Nonempty (VectorMeasureL1Model m)

/-- The simple-function restriction identity in the cyclic orbit. -/
theorem Dilation.vectorSimpleIntegral_eq_restricted_orbit {μ : OVM S A}
    (D : Dilation μ Z) (u : Z) (a : MeasSet S →₀ ℝ) (E : MeasSet S) :
    vectorSimpleIntegral (D.cyclicVectorMeasure u) a E =
      D.S (D.P.val E (Finsupp.linearCombination ℝ (fun B => D.P.val B u) a)) := by
  unfold vectorSimpleIntegral
  simp only [Finsupp.linearCombination_apply, Finsupp.sum, map_sum]
  apply Finset.sum_congr rfl
  intro B _
  rw [map_smul, map_smul]
  exact congrArg (fun v : Z => a B • D.S v) (D.P.apply_inter E B u).symm

variable [NormedAddCommGroup Y] [NormedSpace ℝ Y]

/-- Proposition prop:vector-measure-dilation, through the commuting
diagram. The simple-function map descends by the manuscript's variation
estimate and extends from the dense cyclic span. -/
theorem Dilation.vectorMeasureL1_comparison [CompleteSpace Z] [CompleteSpace Y] {μ : OVM S A}
    (D : Dilation μ Z) (u : Z) (hu : D.P.CyclicVector u)
    (M : VectorMeasureL1Data (D.cyclicVectorMeasure u) Y) :
    ∃ q : Z →L[ℝ] Y, DenseRange q ∧
      ‖q‖ ≤ 2 * D.P.toOVM.uniformNorm * ‖D.S‖ ∧
      (∀ E, q (D.P.val E u) = M.indicator E) ∧ q u = M.indicator MeasSet.whole ∧
      (∀ E, q.comp (D.P.val E) = (M.multiplication.val E).comp q) ∧
      M.integration.comp q = D.S := by
  classical
  let e := Finsupp.linearCombination ℝ (fun B : MeasSet S => D.P.val B u)
  let f := Finsupp.linearCombination ℝ M.indicator
  let C := 2 * D.P.toOVM.uniformNorm * ‖D.S‖
  have hC : 0 ≤ C := mul_nonneg (mul_nonneg (by norm_num) D.P.toOVM.uniformNorm_nonneg) (norm_nonneg _)
  have he : DenseRange e := by
    change Dense (LinearMap.range e : Set Z)
    rw [show e = Finsupp.linearCombination ℝ (fun B : MeasSet S => D.P.val B u) from rfl,
      Finsupp.range_linearCombination]
    exact hu
  have hf (a : MeasSet S →₀ ℝ) : ‖f a‖ ≤ C * ‖e a‖ := by
    change ‖Finsupp.linearCombination ℝ M.indicator a‖ ≤ _
    rw [M.norm_simple]
    apply csSup_le
    · refine ⟨0, 0, by simp, ?_⟩
      refine ⟨fun _ => MeasSet.empty, fun _ _ _ => ?_, ∅, by simp⟩
      change Disjoint (∅ : Set S) ∅
      simp
    · rintro r ⟨g, hg, E, hE, I, rfl⟩
      simp_rw [D.vectorSimpleIntegral_eq_restricted_orbit u a]
      change ∑ n ∈ I, |(g.comp D.S) (D.P.val (E n) (e a))| ≤ C * ‖e a‖
      refine (D.P.toOVM.abs_finite_orbit_coefficients_le E hE (e a) (g.comp D.S) I).trans ?_
      have hg' : ‖g.comp D.S‖ ≤ ‖D.S‖ :=
        (g.opNorm_comp_le D.S).trans (by
          simpa only [one_mul] using (mul_le_mul_of_nonneg_right hg (norm_nonneg D.S)))
      calc
        _ ≤ 2 * D.P.toOVM.uniformNorm * ‖e a‖ * ‖D.S‖ :=
          mul_le_mul_of_nonneg_left hg' (by positivity [D.P.toOVM.uniformNorm_nonneg])
        _ = C * ‖e a‖ := by dsimp [C]; ring
  let q := f.extendOfNorm e
  have hq (B : MeasSet S) : q (D.P.val B u) = M.indicator B := by
    have h := f.extendOfNorm_eq he ⟨C, hf⟩ (Finsupp.single B 1)
    simpa only [q, f, e, Finsupp.linearCombination_single, one_smul] using h
  have hdense : DenseRange q := by
    apply M.dense_indicators.mono
    rw [← Finsupp.range_linearCombination]
    rintro _ ⟨a, rfl⟩
    exact ⟨e a, f.extendOfNorm_eq he ⟨C, hf⟩ a⟩
  refine ⟨q, hdense, f.opNorm_extendOfNorm_le he hC hf, hq, ?_, ?_, ?_⟩
  · have h := hq MeasSet.whole
    rw [show D.P.val MeasSet.whole = ContinuousLinearMap.id ℝ Z from D.P.normalized,
      ContinuousLinearMap.id_apply] at h
    exact h
  · intro E
    apply ContinuousLinearMap.ext_on hu
    rintro _ ⟨B, rfl⟩
    change q (D.P.val E (D.P.val B u)) = M.multiplication.val E (q (D.P.val B u))
    rw [D.P.apply_inter, hq, hq, M.multiplication_indicator]
  · apply ContinuousLinearMap.ext_on hu
    rintro _ ⟨B, rfl⟩
    change M.integration (q (D.P.val B u)) = D.S (D.P.val B u)
    rw [hq, M.integration_indicator]
    rfl

/-- The synthesis and analysis in the new dilation are \(I_m\) and \(qT\).
The whole-space indicator is cyclic by the density of simple functions. -/
theorem Dilation.vectorMeasureL1_dilation [CompleteSpace Z] [CompleteSpace Y] {μ : OVM S A}
    (D : Dilation μ Z) (u : Z) (hu : D.P.CyclicVector u)
    (M : VectorMeasureL1Data (D.cyclicVectorMeasure u) Y) :
    ∃ (q : Z →L[ℝ] Y) (D₀ : Dilation μ Y), DenseRange q ∧
      q u = M.indicator MeasSet.whole ∧ D₀.P = M.multiplication ∧
      D₀.S = M.integration ∧ D₀.T = q.comp D.T ∧
      (∀ E, q.comp (D.P.val E) = (M.multiplication.val E).comp q) ∧
      M.multiplication.CyclicVector (M.indicator MeasSet.whole) := by
  obtain ⟨q, hq, _, _, hu', hmul, hS⟩ := D.vectorMeasureL1_comparison u hu M
  refine ⟨q, ⟨M.multiplication, M.integration, q.comp D.T, ?_, ?_⟩, hq, hu',
    rfl, rfl, rfl, hmul, ?_⟩
  · rw [← ContinuousLinearMap.comp_assoc, hS]
    exact D.split
  · intro E
    ext x
    have hin := congrArg (fun R : Z →L[ℝ] Y => R (D.T x)) (hmul E)
    have hOut := congrArg (fun R : Z →L[ℝ] A => R (D.P.val E (D.T x))) hS
    change M.integration (M.multiplication.val E (q (D.T x))) = μ.val E x
    change q (D.P.val E (D.T x)) = M.multiplication.val E (q (D.T x)) at hin
    rw [← hin]
    exact hOut.trans (congrArg (fun R : A →L[ℝ] A => R x) (D.compress E))
  · have h (E : MeasSet S) : M.multiplication.val E (M.indicator MeasSet.whole) = M.indicator E := by
      rw [M.multiplication_indicator, show E.inter MeasSet.whole = E from Subtype.ext (Set.inter_univ _)]
    unfold PVM.CyclicVector
    simp_rw [h]
    exact M.dense_indicators

#print axioms Dilation.vectorSimpleIntegral_eq_restricted_orbit
#print axioms Dilation.vectorMeasureL1_comparison
#print axioms Dilation.vectorMeasureL1_dilation




/-- The standard L¹(m) model provides the target of the comparison and
gives the cyclic dilation with the specified analysis and synthesis. -/
theorem Dilation.exists_vectorMeasureL1_dilation [CompleteSpace A] [CompleteSpace Z]
    {μ : OVM S A} (D : Dilation μ Z) (u : Z) (hu : D.P.CyclicVector u) :
    ∃ M : VectorMeasureL1Model (D.cyclicVectorMeasure u),
      letI := M.normedGroup
      letI := M.normedScalar
      ∃ (q : Z →L[ℝ] M.carrier) (D₀ : Dilation μ M.carrier),
        DenseRange q ∧ q u = M.data.indicator MeasSet.whole ∧
        D₀.P = M.data.multiplication ∧ D₀.S = M.data.integration ∧ D₀.T = q.comp D.T ∧
        (∀ E, q.comp (D.P.val E) = (M.data.multiplication.val E).comp q) ∧
        D₀.P.Cyclic := by
  let M := Classical.choice (citeVectorMeasureL1 (D.cyclicVectorMeasure u)
    (D.cyclicVectorMeasure_empty u) (D.cyclicVectorMeasure_hasSum u))
  let _ := M.normedGroup
  let _ := M.normedScalar
  let _ := M.isComplete
  obtain ⟨q, D₀, hq, hu₀, hP, hS, hT, hcut, hcyc⟩ := D.vectorMeasureL1_dilation u hu M.data
  refine ⟨M, q, D₀, hq, hu₀, hP, hS, hT, hcut, M.data.indicator MeasSet.whole, ?_⟩
  rw [hP]
  exact hcyc

#print axioms Dilation.exists_vectorMeasureL1_dilation


/-- The comparison sends the closure of the nonnegative cyclic sums to
the positive cone in L¹(m). This is the order comparison in the last
paragraph of prop:vector-measure-dilation. -/
theorem Dilation.vectorMeasureL1_image_positive_cone {μ : OVM S A}
    (D : Dilation μ Z) (u : Z) (M : VectorMeasureL1Data (D.cyclicVectorMeasure u) Y)
    (q : Z ≃L[ℝ] Y) (hq : ∀ E, q (D.P.val E u) = M.indicator E) :
    q '' closure (positiveIndicatorSums (fun E => D.P.val E u)) =
      (letI := M.latticeOrder; {y : Y | 0 ≤ y}) := by
  have he (a : MeasSet S →₀ ℝ) :
      q (Finsupp.linearCombination ℝ (fun E => D.P.val E u) a) =
        Finsupp.linearCombination ℝ M.indicator a := by
    simp only [Finsupp.linearCombination_apply, Finsupp.sum, map_sum, map_smul, hq]
  have hs : q '' positiveIndicatorSums (fun E => D.P.val E u) =
      positiveIndicatorSums M.indicator := by
    ext y
    constructor
    · rintro ⟨_, ⟨a, ha, rfl⟩, rfl⟩
      exact ⟨a, ha, (he a).symm⟩
    · rintro ⟨a, ha, rfl⟩
      exact ⟨_, ⟨a, ha, rfl⟩, he a⟩
  rw [q.image_closure, hs]
  exact M.positive_indicator_closure

#print axioms Dilation.vectorMeasureL1_image_positive_cone



/-- The identity dilation used in the proof of lem:multiplier-hull. -/
def PVM.identityDilation (P : PVM S A) : Dilation P.toOVM A where
  P := P
  S := ContinuousLinearMap.id ℝ A
  T := ContinuousLinearMap.id ℝ A
  split := by ext x; rfl
  compress := by intro E; ext x; rfl

/-- The first part of lem:multiplier-hull: for the identity dilation,
the dense cyclic comparison is an isomorphism, with inverse integration.
The isomorphism commutes with the measurable projections. -/
theorem PVM.identity_vectorMeasureL1_equivalence [CompleteSpace A] [CompleteSpace Y]
    (P : PVM S A) (u : A) (hu : P.CyclicVector u)
    (M : VectorMeasureL1Data (P.identityDilation.cyclicVectorMeasure u) Y) :
    ∃ q : A ≃L[ℝ] Y,
      (∀ E, q (P.val E u) = M.indicator E) ∧
      q.symm.toContinuousLinearMap = M.integration ∧
      (∀ E, q.toContinuousLinearMap.comp (P.val E) =
        (M.multiplication.val E).comp q.toContinuousLinearMap) ∧
      q '' closure (positiveIndicatorSums (fun E => P.val E u)) =
        (letI := M.latticeOrder; {y : Y | 0 ≤ y}) := by
  obtain ⟨q, hqd, _, hgen, _, hmul, hI⟩ := P.identityDilation.vectorMeasureL1_comparison u hu M
  have hleft (x : A) : M.integration (q x) = x :=
    congrArg (fun L : A →L[ℝ] A => L x) hI
  have hEqClosed : IsClosed {y : Y | q (M.integration y) = y} :=
    isClosed_eq (q.continuous.comp M.integration.continuous) continuous_id
  have hright (y : Y) : q (M.integration y) = y := by
    apply closure_minimal (s := Set.range q) ?_ hEqClosed (hqd y)
    rintro _ ⟨x, rfl⟩
    exact congrArg q (hleft x)
  let e : A ≃L[ℝ] Y :=
    { toLinearEquiv :=
        { toFun := q
          invFun := M.integration
          left_inv := hleft
          right_inv := hright
          map_add' := map_add q
          map_smul' := map_smul q }
      continuous_toFun := q.continuous
      continuous_invFun := M.integration.continuous }
  refine ⟨e, hgen, ?_, hmul, ?_⟩
  · ext x
    rfl
  · exact P.identityDilation.vectorMeasureL1_image_positive_cone u M e hgen

#print axioms PVM.identity_vectorMeasureL1_equivalence


section MinimalVectorMeasureL1

local instance : TopologicalSpace (MeasSet S) := ⊥
local instance : Nonempty (MeasSet S) := ⟨MeasSet.empty⟩

private theorem OVM.norm_alphaSynthesis_le_one [CompleteSpace A] (μ : OVM S A) :
    ‖μ.alphaSynthesis‖ ≤ 1 := by
  apply ContinuousLinearMap.opNorm_le_bound _ zero_le_one
  intro z
  change ‖z.1 MeasSet.whole‖ ≤ 1 * ‖z.1‖
  simpa only [one_mul] using z.1.norm_coe_le_norm MeasSet.whole

private theorem OVM.uniformNorm_alphaPVM_le_one [CompleteSpace A] (μ : OVM S A) :
    μ.alphaPVM.toOVM.uniformNorm ≤ 1 := by
  unfold OVM.uniformNorm
  refine csSup_le ⟨_, ⟨MeasSet.empty, rfl⟩⟩ ?_
  rintro _ ⟨E, rfl⟩
  apply ContinuousLinearMap.opNorm_le_bound _ zero_le_one
  intro z
  change ‖μ.alphaRestriction E z‖ ≤ 1 * ‖z‖
  simpa only [one_mul] using μ.norm_alphaRestriction_apply E z

/-- The lower and upper estimates in the minimal alpha-dilation are
\(\|z\|_\alpha\leq\|qz\|_{L^1(m)}\leq 2\|z\|_\alpha\).
The lower estimate uses the defining supremum of the alpha norm and
contractivity of integration and cut multiplication on \(L^1(m)\). -/
theorem OVM.alpha_vectorMeasureL1_equivalence [CompleteSpace A] [CompleteSpace Y]
    (μ : OVM S A) (hμ : μ.Normalized) (u : μ.alphaSubmodule) (hu : μ.alphaPVM.CyclicVector u)
    (M : VectorMeasureL1Data ((μ.alphaDilation hμ).cyclicVectorMeasure u) Y) :
    ∃ q : μ.alphaSubmodule ≃L[ℝ] Y,
      (∀ E, q (μ.alphaPVM.val E u) = M.indicator E) ∧
      (∀ E, q.toContinuousLinearMap.comp (μ.alphaPVM.val E) =
        (M.multiplication.val E).comp q.toContinuousLinearMap) ∧
      (∀ z, ‖z‖ ≤ ‖q z‖ ∧ ‖q z‖ ≤ 2 * ‖z‖) ∧
      (∀ y, ‖y‖ / 2 ≤ ‖q.symm y‖ ∧ ‖q.symm y‖ ≤ ‖y‖) := by
  let D := μ.alphaDilation hμ
  obtain ⟨q, hdense, hqnorm, hgen, _, hmul, hS⟩ := D.vectorMeasureL1_comparison u hu M
  have hq₂ : ‖q‖ ≤ 2 := by
    refine hqnorm.trans ?_
    change 2 * μ.alphaPVM.toOVM.uniformNorm * ‖μ.alphaSynthesis‖ ≤ 2
    calc
      _ ≤ 2 * μ.alphaPVM.toOVM.uniformNorm * 1 :=
        mul_le_mul_of_nonneg_left (μ.norm_alphaSynthesis_le_one)
          (mul_nonneg (by norm_num) μ.alphaPVM.toOVM.uniformNorm_nonneg)
      _ ≤ 2 := by
        simpa only [mul_one] using
          (mul_le_mul_of_nonneg_left μ.uniformNorm_alphaPVM_le_one (by norm_num : (0 : ℝ) ≤ 2))
  have hqlo (z : μ.alphaSubmodule) : ‖z‖ ≤ ‖q z‖ := by
    rw [μ.alpha_norm_eq_sSup_eval]
    refine csSup_le ⟨_, ⟨MeasSet.empty, rfl⟩⟩ ?_
    rintro _ ⟨E, rfl⟩
    have he := congrArg (fun L : μ.alphaSubmodule →L[ℝ] Y => L z) (hmul E)
    have hs := congrArg (fun L : μ.alphaSubmodule →L[ℝ] A => L (μ.alphaRestriction E z)) hS
    change q (μ.alphaRestriction E z) = M.multiplication.val E (q z) at he
    change M.integration (q (μ.alphaRestriction E z)) =
      μ.alphaSynthesis (μ.alphaRestriction E z) at hs
    change ‖μ.alphaSynthesis (μ.alphaRestriction E z)‖ ≤ ‖q z‖
    rw [← hs, he]
    calc
      _ ≤ ‖M.multiplication.val E (q z)‖ :=
        (M.integration.le_opNorm _).trans (by simpa only [one_mul] using (mul_le_mul_of_nonneg_right M.norm_integration_le_one (norm_nonneg _)))
      _ ≤ ‖q z‖ :=
        ((M.multiplication.val E).le_opNorm _).trans (by simpa only [one_mul] using (mul_le_mul_of_nonneg_right (M.norm_multiplication_le_one E) (norm_nonneg _)))
  have ha : AntilipschitzWith 1 q := AntilipschitzWith.of_le_mul_dist fun z w => by
    rw [dist_eq_norm, dist_eq_norm, ← map_sub, NNReal.coe_one, one_mul]
    exact hqlo (z - w)
  have hc := ha.isClosed_range q.lipschitzWith.uniformContinuous
  have hsurj : Function.Surjective q := Set.range_eq_univ.mp (hc.closure_eq.symm.trans hdense.closure_eq)
  let e₀ := LinearEquiv.ofBijective q.toLinearMap ⟨ha.injective, hsurj⟩
  have hb (y : Y) : ‖e₀.symm y‖ ≤ 1 * ‖y‖ := by
    rw [one_mul]
    have hb := hqlo (e₀.symm y)
    change ‖e₀.symm y‖ ≤ ‖e₀ (e₀.symm y)‖ at hb
    rw [e₀.apply_symm_apply] at hb
    exact hb
  let e : μ.alphaSubmodule ≃L[ℝ] Y :=
    { toLinearEquiv := e₀
      continuous_toFun := q.continuous
      continuous_invFun := (e₀.symm.toLinearMap.mkContinuous 1 hb).continuous }
  have hu' (z : μ.alphaSubmodule) : ‖q z‖ ≤ 2 * ‖z‖ :=
    (q.le_opNorm z).trans (mul_le_mul_of_nonneg_right hq₂ (norm_nonneg _))
  refine ⟨e, hgen, hmul, fun z => ⟨hqlo z, hu' z⟩, fun y => ?_⟩
  have he (y : Y) : q (e.symm y) = y := e.apply_symm_apply y
  have hh₁ := hqlo (e.symm y)
  have hh₂ := hu' (e.symm y)
  rw [he] at hh₁ hh₂
  exact ⟨by linarith, hh₁⟩

#print axioms OVM.alpha_vectorMeasureL1_equivalence

end MinimalVectorMeasureL1



/-- Increasing norm-bounded positive sequences converge in the L¹ lattice. -/
def VectorMeasureL1Data.IsKB {m : MeasSet S → A} (M : VectorMeasureL1Data m Y) : Prop :=
  letI := M.latticeOrder
  ∀ z : ℕ → Y, Monotone z → (∀ n, 0 ≤ z n) → (∃ C : ℝ, ∀ n, ‖z n‖ ≤ C) →
    ∃ y : Y, Tendsto z atTop (𝓝 y)

/-- A fixed standard L¹(m) model makes the subsequent cited facts refer
to the same space as the construction of the dilation. -/
noncomputable def standardVectorMeasureL1 [CompleteSpace A] (m : MeasSet S → A)
    (h0 : m MeasSet.empty = 0)
    (hσ : ∀ E : ℕ → MeasSet S, MeasSet.DisjointSeq E →
      HasSum (fun n => m (E n)) (m (MeasSet.iUnion E))) : VectorMeasureL1Model m :=
  Classical.choice (citeVectorMeasureL1 m h0 hσ)

/-- Okada–Ricker–Sánchez Pérez (2014), Corollary 4.4(iv), in the
real Banach-space case used in cor:review-minimal-kb. -/
axiom citeOkadaRickerSanchezPerez2014 [CompleteSpace A] (m : MeasSet S → A)
    (h0 : m MeasSet.empty = 0)
    (hσ : ∀ E : ℕ → MeasSet S, MeasSet.DisjointSeq E →
      HasSum (fun n => m (E n)) (m (MeasSet.iUnion E)))
    (hA : ¬ ContainsCopy CZero A) :
    let M := standardVectorMeasureL1 m h0 hσ
    letI := M.normedGroup
    letI := M.normedScalar
    ¬ ContainsCopy CZero M.carrier

/-- The KB criterion for the order-continuous Banach lattice L¹(m),
the specialization of the Banach lattice result cited in rem:lattice-james
(Kitover–Orhon, Theorem 2.18 and the proof of Lemma 2.19). -/
axiom citeKitoverOrhon2017_L1_KB [CompleteSpace A] (m : MeasSet S → A)
    (h0 : m MeasSet.empty = 0)
    (hσ : ∀ E : ℕ → MeasSet S, MeasSet.DisjointSeq E →
      HasSum (fun n => m (E n)) (m (MeasSet.iUnion E))) :
    let M := standardVectorMeasureL1 m h0 hσ
    letI := M.normedGroup
    letI := M.normedScalar
    M.data.IsKB ↔ WeaklySeqComplete M.carrier

/-- The forward implication of thm:dilation-geometry (2) on the standard
vector-measure L¹ space. Use the cited no-c₀ result, apply the James
characterization to its cyclic multiplication PVM, and conclude KB. -/
theorem Dilation.exists_vectorMeasureL1_KB_dilation [CompleteSpace A] [CompleteSpace Z]
    {μ : OVM S A} (D : Dilation μ Z) (u : Z) (hu : D.P.CyclicVector u)
    (hA : ¬ ContainsCopy CZero A) :
    let M := standardVectorMeasureL1 (D.cyclicVectorMeasure u)
      (D.cyclicVectorMeasure_empty u) (D.cyclicVectorMeasure_hasSum u)
    letI := M.normedGroup
    letI := M.normedScalar
    M.data.IsKB ∧ ∃ D₀ : Dilation μ M.carrier,
      D₀.P = M.data.multiplication ∧ D₀.P.Cyclic ∧ D₀.P.BoundedlyComplete := by
  let m := D.cyclicVectorMeasure u
  let h0 := D.cyclicVectorMeasure_empty u
  let hσ := D.cyclicVectorMeasure_hasSum u
  let M := standardVectorMeasureL1 m h0 hσ
  let _ := M.normedGroup
  let _ := M.normedScalar
  let _ := M.isComplete
  change M.data.IsKB ∧ ∃ D₀ : Dilation μ M.carrier,
    D₀.P = M.data.multiplication ∧ D₀.P.Cyclic ∧ D₀.P.BoundedlyComplete
  obtain ⟨_, D₀, _, _, hP, _, _, _, hcyclic⟩ := D.vectorMeasureL1_dilation u hu M.data
  have hcyc : D₀.P.Cyclic := ⟨M.data.indicator MeasSet.whole, hP.symm ▸ hcyclic⟩
  have hc₀ : ¬ ContainsCopy CZero M.carrier := citeOkadaRickerSanchezPerez2014 m h0 hσ hA
  have hb : D₀.P.BoundedlyComplete := D₀.P.boundedlyComplete_of_not_contains_cZero hc₀
  have hw := D₀.P.weaklySeqComplete_of_boundedlyComplete (D₀.P.localizes_of_cyclic hcyc) hb
  exact ⟨(citeKitoverOrhon2017_L1_KB m h0 hσ).mpr hw, D₀, hP, hcyc, hb⟩

#print axioms Dilation.exists_vectorMeasureL1_KB_dilation



section MinimalVectorMeasureKB

local instance : TopologicalSpace (MeasSet S) := ⊥
local instance : Nonempty (MeasSet S) := ⟨MeasSet.empty⟩

/-- Manuscript, cor:review-minimal-kb. The KB property is read in the
standard \(L^1(m)\) lattice, whose positive cone agrees via \(q\) with
the closure of the nonnegative simple sums from the cyclic orbit. -/
theorem OVM.minimal_vectorMeasureL1_KB_iff [CompleteSpace A]
    (μ : OVM S A) (hμ : μ.Normalized) (u : μ.alphaSubmodule)
    (hu : μ.alphaPVM.CyclicVector u) :
    let D := μ.alphaDilation hμ
    let m := D.cyclicVectorMeasure u
    let M := standardVectorMeasureL1 m (D.cyclicVectorMeasure_empty u)
      (D.cyclicVectorMeasure_hasSum u)
    letI := M.normedGroup
    letI := M.normedScalar
    ∃ q : μ.alphaSubmodule ≃L[ℝ] M.carrier,
      q '' closure (positiveIndicatorSums (fun E => μ.alphaPVM.val E u)) =
        (letI := M.data.latticeOrder; {y : M.carrier | 0 ≤ y}) ∧
      (M.data.IsKB ↔ μ.BoundedlyComplete) ∧
      (μ.BoundedlyComplete ↔ ¬ ContainsCopy CZero A) := by
  let D := μ.alphaDilation hμ
  let m := D.cyclicVectorMeasure u
  let h0 := D.cyclicVectorMeasure_empty u
  let hσ := D.cyclicVectorMeasure_hasSum u
  let M := standardVectorMeasureL1 m h0 hσ
  let _ := M.normedGroup
  let _ := M.normedScalar
  let _ := M.isComplete
  obtain ⟨q, hgen, hcomm, _, _⟩ := μ.alpha_vectorMeasureL1_equivalence hμ u hu M.data
  have hinter (E : MeasSet S) (z : μ.alphaSubmodule) :
      q (μ.alphaPVM.val E z) = M.data.multiplication.val E (q z) :=
    congrArg (fun L : μ.alphaSubmodule →L[ℝ] M.carrier => L z) (hcomm E)
  have hback (E : MeasSet S) (z : M.carrier) :
      q.symm (M.data.multiplication.val E z) = μ.alphaPVM.val E (q.symm z) := by
    apply q.injective
    rw [q.apply_symm_apply, hinter, q.apply_symm_apply]
  have hc : M.data.multiplication.Cyclic := by
    refine ⟨M.data.indicator MeasSet.whole, ?_⟩
    have he (E : MeasSet S) :
        M.data.multiplication.val E (M.data.indicator MeasSet.whole) = M.data.indicator E := by
      rw [M.data.multiplication_indicator, show E.inter MeasSet.whole = E from Subtype.ext (Set.inter_univ _)]
    unfold PVM.CyclicVector
    simp_rw [he]
    exact M.data.dense_indicators
  have hbc : M.data.multiplication.BoundedlyComplete ↔ μ.BoundedlyComplete :=
    ⟨μ.alphaPVM.boundedlyComplete_of_intertwined_equiv M.data.multiplication q hinter,
      M.data.multiplication.boundedlyComplete_of_intertwined_equiv μ.alphaPVM q.symm hback⟩
  refine ⟨q, D.vectorMeasureL1_image_positive_cone u M.data q hgen, ?_,
    (μ.minimal_cZero_equivalences hμ ⟨u, hu⟩).2⟩
  let hloc := M.data.multiplication.localizes_of_cyclic hc
  have hKW := citeKitoverOrhon2017_L1_KB m h0 hσ
  constructor
  · intro hk
    exact hbc.mp (((M.data.multiplication.boundedlyComplete_james hloc).2.1).mpr (hKW.mp hk))
  · intro hb
    have hA := (μ.minimal_cZero_equivalences hμ ⟨u, hu⟩).2.mp hb
    have hc₀ : ¬ ContainsCopy CZero M.carrier := citeOkadaRickerSanchezPerez2014 m h0 hσ hA
    have hBM := M.data.multiplication.boundedlyComplete_of_not_contains_cZero hc₀
    exact hKW.mpr (M.data.multiplication.weaklySeqComplete_of_boundedlyComplete hloc hBM)

#print axioms OVM.minimal_vectorMeasureL1_KB_iff

end MinimalVectorMeasureKB


end VectorMeasureL1




section CyclicInductiveVectorMeasure

variable {S A : Type*} [MeasurableSpace S]
  [NormedAddCommGroup A] [NormedSpace ℝ A] [CompleteSpace A]

/-- The generator of a cyclic subspace, regarded as an element of that subspace. -/
def PVM.cyclicGenerator (P : PVM S A) (u : A) : P.cyclicSubspace u :=
  ⟨u, by
    have h : P.val MeasSet.whole u ∈ P.cyclicSubspace u :=
      subset_closure (Submodule.subset_span ⟨MeasSet.whole, rfl⟩)
    rwa [P.normalized] at h⟩

/-- The measure in prop:cyclic-inductive, taking values in the closed orbit span. -/
def PVM.cyclicSubspaceMeasure (P : PVM S A) (u : A) (E : MeasSet S) :
    P.cyclicSubspace u :=
  (P.restrict _ (P.cyclicSubspace_invariant u)).val E (P.cyclicGenerator u)

/-- The cyclic subspaces are integrated copies of the vector-measure models.
The final topology statement is the universal property of the locally convex
inductive limit, expressed also for any topological target. -/
theorem PVM.cyclicInductive_vectorMeasure (P : PVM S A)
    (h : ∀ s : Set A, s.Countable → ∃ u, s ⊆ P.cyclicSubspace u)
    {Y : A → Type*}
    [ng : ∀ u, NormedAddCommGroup (Y u)] [ns : ∀ u, NormedSpace ℝ (Y u)]
    [∀ u, CompleteSpace (Y u)]
    (M : ∀ u, VectorMeasureL1Data (P.cyclicSubspaceMeasure u) (Y u)) :
    (∀ x : A, ∃ u, x ∈ P.cyclicSubspace u) ∧
    (∀ x : ℕ → A, ∃ v, ∀ n, P.cyclicSubspace (x n) ≤ P.cyclicSubspace v) ∧
    ∃ e : ∀ u, P.cyclicSubspace u ≃L[ℝ] Y u,
      (∀ u, (e u).symm.toContinuousLinearMap = (M u).integration) ∧
      (∀ u v (huv : P.cyclicSubspace u ≤ P.cyclicSubspace v) E (y : Y u),
        let j (a : Y u) := e v ⟨(e u).symm a, huv ((e u).symm a).property⟩
        j ((M u).multiplication.val E y) = (M v).multiplication.val E (j y)) ∧
      (∀ {W : Type*} [TopologicalSpace W] (f : A → W),
        Continuous f ↔ ∀ u, Continuous (fun y : Y u => f ((e u).symm y))) := by
  have hmodel (u : A) : ∃ e : P.cyclicSubspace u ≃L[ℝ] Y u,
      e.symm.toContinuousLinearMap = (M u).integration ∧
      ∀ E (x : P.cyclicSubspace u),
        e ((P.restrict _ (P.cyclicSubspace_invariant u)).val E x) =
          (M u).multiplication.val E (e x) := by
    let R := P.restrict _ (P.cyclicSubspace_invariant u)
    let _ : CompleteSpace (P.cyclicSubspace u) :=
      (Submodule.isClosed_topologicalClosure _).completeSpace_coe
    obtain ⟨e, _, hI, hcut, _⟩ := R.identity_vectorMeasureL1_equivalence
      (P.cyclicGenerator u) (P.cyclicVector_restrict_cyclicSubspace u (P.cyclicGenerator u).property)
      (M u)
    exact ⟨e, hI, fun E x => congrArg (fun L : P.cyclicSubspace u →L[ℝ] Y u => L x) (hcut E)⟩
  choose e hI hcut using hmodel
  refine ⟨fun x => ⟨x, (P.cyclicGenerator x).property⟩,
    P.cyclicSubspaces_countablyDirected h, e, hI, ?_, ?_⟩
  · intro u v huv E y
    let x := (e u).symm y
    change e v ⟨(e u).symm ((M u).multiplication.val E y), _⟩ =
      (M v).multiplication.val E (e v ⟨x, _⟩)
    have hx : e u x = y := (e u).apply_symm_apply y
    have hh : (e u).symm ((M u).multiplication.val E y) =
        (P.restrict _ (P.cyclicSubspace_invariant u)).val E x := by
      rw [← hx, ← hcut, ContinuousLinearEquiv.symm_apply_apply]
    rw [← hcut]
    congr 1
    apply Subtype.ext
    exact congrArg (fun z : P.cyclicSubspace u => (z : A)) hh
  · intro W _ f
    rw [P.continuous_iff_on_cyclicSubspaces h]
    constructor
    · intro hf u
      exact (hf u).comp (e u).symm.continuous
    · intro hf u
      simpa only [Function.comp_def, ContinuousLinearEquiv.symm_apply_apply] using
        (hf u).comp (e u).continuous

#print axioms PVM.cyclicInductive_vectorMeasure

end CyclicInductiveVectorMeasure


section PositiveResolvent

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]

/-- The positive resolvent in eq:resolvent-control. The cone is explicit
so this estimate can be applied to the total-variation norm on finite
signed measures. -/
theorem positive_resolvent_control (K : Set E) (hclosed : IsClosed K)
    (hadd : ∀ ⦃x y : E⦄, x ∈ K → y ∈ K → x + y ∈ K)
    (hsmul : ∀ ⦃a : ℝ⦄ ⦃x : E⦄, 0 ≤ a → x ∈ K → a • x ∈ K)
    (hmono : ∀ ⦃x y : E⦄, x ∈ K → y - x ∈ K → ‖x‖ ≤ ‖y‖)
    (V : E →L[ℝ] E) (hV : ∀ ⦃x : E⦄, x ∈ K → V x ∈ K)
    (η : E) (hη : η ∈ K) (hηnorm : ‖η‖ = 1)
    (b : ℝ) (hb : ‖V‖ < b) :
    let v := ∑' n : ℕ, (b⁻¹)^n • (V ^ n) η
    let k := ‖v‖
    let ρ := k⁻¹ • v
    Summable (fun n : ℕ => (b⁻¹)^n • (V ^ n) η) ∧
      v ∈ K ∧ v - η ∈ K ∧ V v = b • (v - η) ∧
      1 ≤ k ∧ k ≤ (1 - ‖V‖ * b⁻¹)⁻¹ ∧
      ρ ∈ K ∧ ‖ρ‖ = 1 ∧ k • ρ - η ∈ K ∧ b • ρ - V ρ ∈ K := by
  let w (n : ℕ) : E := (b⁻¹)^n • (V ^ n) η
  let v := ∑' n : ℕ, w n
  let k := ‖v‖
  let ρ := k⁻¹ • v
  change Summable w ∧ v ∈ K ∧ v - η ∈ K ∧ V v = b • (v - η) ∧
    1 ≤ k ∧ k ≤ (1 - ‖V‖ * b⁻¹)⁻¹ ∧
    ρ ∈ K ∧ ‖ρ‖ = 1 ∧ k • ρ - η ∈ K ∧ b • ρ - V ρ ∈ K
  have hb₀ : 0 < b := (norm_nonneg V).trans_lt hb
  have hinv := inv_nonneg.mpr hb₀.le
  have hr₀ : 0 ≤ ‖V‖ * b⁻¹ := mul_nonneg (norm_nonneg _) hinv
  have hr₁ : ‖V‖ * b⁻¹ < 1 := by
    rw [← div_eq_mul_inv]
    exact (div_lt_iff₀ hb₀).mpr (by simpa only [one_mul] using hb)
  have hrec (n : ℕ) : w (n + 1) = b⁻¹ • V (w n) := by
    dsimp only [w]
    rw [pow_succ' (b⁻¹ : ℝ), pow_succ' V, map_smul, smul_smul]
    rfl
  have hw0 : w 0 = η := by simp [w]
  have hbound (n : ℕ) : ‖w n‖ ≤ (‖V‖ * b⁻¹)^n := by
    induction n with
    | zero => rw [hw0, hηnorm, pow_zero]
    | succ n ih =>
      rw [hrec, norm_smul, Real.norm_of_nonneg hinv, pow_succ']
      calc
        _ ≤ b⁻¹ * (‖V‖ * ‖w n‖) := mul_le_mul_of_nonneg_left (V.le_opNorm _) hinv
        _ = (‖V‖ * b⁻¹) * ‖w n‖ := by ring
        _ ≤ _ := mul_le_mul_of_nonneg_left ih hr₀
  have hsNorm : Summable (fun n => ‖w n‖) :=
    (summable_geometric_of_lt_one hr₀ hr₁).of_nonneg_of_le (fun _ => norm_nonneg _) hbound
  have hs : Summable w := Summable.of_norm hsNorm
  have hmem (n : ℕ) : w n ∈ K := by
    induction n with
    | zero => rw [hw0]; exact hη
    | succ n ih => rw [hrec]; exact hsmul hinv (hV ih)
  have hz : (0 : E) ∈ K := by simpa only [zero_smul] using hsmul (a := (0 : ℝ)) le_rfl (x := η) hη
  have hsum_mem (a : ℕ → E) (ha : ∀ n, a n ∈ K) (ha' : Summable a) : (∑' n, a n) ∈ K := by
    apply hclosed.mem_of_tendsto ha'.hasSum
    refine Eventually.of_forall fun s => ?_
    induction s using Finset.induction_on with
    | empty => simpa only [Finset.sum_empty] using hz
    | insert i s hi hmem => rw [Finset.sum_insert hi]; exact hadd (ha i) hmem
  have hv : v ∈ K := hsum_mem w hmem hs
  have hsplit : v = η + ∑' n : ℕ, w (n + 1) := by
    exact hs.tsum_eq_zero_add.trans (congrArg (· + ∑' n : ℕ, w (n + 1)) hw0)
  have hdiff : v - η ∈ K := by
    have h := hsum_mem (fun n => w (n + 1)) (fun n => hmem (n + 1))
      ((summable_nat_add_iff 1).mpr hs)
    rwa [hsplit, add_sub_cancel_left] 
  have heq : V v = b • (v - η) := by
    have hsV := (V.hasSum hs.hasSum).const_smul (b⁻¹ : ℝ)
    have he (n : ℕ) : b⁻¹ • V (w n) = w (n + 1) := (hrec n).symm
    simp_rw [he] at hsV
    have ht : (∑' n : ℕ, w (n + 1)) = b⁻¹ • V v := hsV.tsum_eq
    have hd : v - η = ∑' n : ℕ, w (n + 1) := by
      rw [hsplit, add_sub_cancel_left]
    rw [hd, ht, smul_smul, mul_inv_cancel₀ hb₀.ne', one_smul]
  have hk₁ : 1 ≤ k := hηnorm ▸ hmono hη hdiff
  have hk : 0 < k := zero_lt_one.trans_le hk₁
  have hkle : k ≤ (1 - ‖V‖ * b⁻¹)⁻¹ := by
    change ‖∑' n, w n‖ ≤ _
    refine (norm_tsum_le_tsum_norm hsNorm).trans ?_
    exact ((hsNorm.tsum_le_tsum hbound (summable_geometric_of_lt_one hr₀ hr₁))).trans_eq
      (tsum_geometric_of_lt_one hr₀ hr₁)
  have hρ : ρ ∈ K := hsmul (inv_nonneg.mpr hk.le) hv
  have hρn : ‖ρ‖ = 1 := by
    change ‖k⁻¹ • v‖ = 1
    rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr hk.le)]
    exact inv_mul_cancel₀ hk.ne'
  have hincl : k • ρ - η ∈ K := by
    change k • (k⁻¹ • v) - η ∈ K
    rw [smul_smul, mul_inv_cancel₀ hk.ne', one_smul]
    exact hdiff
  have hdom : b • ρ - V ρ ∈ K := by
    change b • (k⁻¹ • v) - V (k⁻¹ • v) ∈ K
    rw [map_smul, heq, smul_comm b k⁻¹, ← smul_sub, ← smul_sub, sub_sub_cancel]
    exact hsmul (inv_nonneg.mpr hk.le) (hsmul hb₀.le hη)
  exact ⟨hs, hv, hdiff, heq, hk₁, hkle, hρ, hρn, hincl, hdom⟩

#print axioms positive_resolvent_control


/-- The resolvent normalization constants tend to one, as in
eq:resolvent-control in the manuscript. -/
theorem positive_resolvent_scale_tendsto_one (K : Set E) (hclosed : IsClosed K)
    (hadd : ∀ ⦃x y : E⦄, x ∈ K → y ∈ K → x + y ∈ K)
    (hsmul : ∀ ⦃a : ℝ⦄ ⦃x : E⦄, 0 ≤ a → x ∈ K → a • x ∈ K)
    (hmono : ∀ ⦃x y : E⦄, x ∈ K → y - x ∈ K → ‖x‖ ≤ ‖y‖)
    (V : E →L[ℝ] E) (hV : ∀ ⦃x : E⦄, x ∈ K → V x ∈ K)
    (η : E) (hη : η ∈ K) (hηnorm : ‖η‖ = 1) :
    Tendsto (fun b : ℝ => ‖∑' n : ℕ, (b⁻¹)^n • (V ^ n) η‖) atTop (𝓝 1) := by
  have hsmall : Tendsto (fun b : ℝ => ‖V‖ * b⁻¹) atTop (𝓝 0) := by
    simpa only [mul_zero] using
      (tendsto_const_nhds (x := ‖V‖)).mul (tendsto_inv_atTop_zero (𝕜 := ℝ))
  have hden : Tendsto (fun b : ℝ => 1 - ‖V‖ * b⁻¹) atTop (𝓝 1) := by
    simpa only [sub_zero] using (tendsto_const_nhds (x := (1 : ℝ))).sub hsmall
  have hu : Tendsto (fun b : ℝ => (1 - ‖V‖ * b⁻¹)⁻¹) atTop (𝓝 1) := by
    simpa only [inv_one] using hden.inv₀ one_ne_zero
  have hb : ∀ᶠ b : ℝ in atTop, ‖V‖ < b := eventually_gt_atTop ‖V‖
  refine tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds hu ?_ ?_
  · filter_upwards [hb] with b hb
    obtain ⟨_, _, _, _, h, _, _, _, _, _⟩ :=
      positive_resolvent_control K hclosed hadd hsmul hmono V hV η hη hηnorm b hb
    exact h
  · filter_upwards [hb] with b hb
    obtain ⟨_, _, _, _, _, h, _, _, _, _⟩ :=
      positive_resolvent_control K hclosed hadd hsmul hmono V hV η hη hηnorm b hb
    exact h

/-- Positive unit vectors dominated by their own scalar multiples under V.
For total variation on finite measures these are the probabilities in the
family indexed by R in thm:measure-inductive-dilation. -/
def resolventProbabilities (K : Set E) (V : E →L[ℝ] E) : Set E :=
  {ρ | ρ ∈ K ∧ ‖ρ‖ = 1 ∧ ∃ c : ℝ, 0 < c ∧ c • ρ - V ρ ∈ K}

/-- The half-geometric mixture of positive unit vectors has mass one and
dominates each summand. The mass functional is assumed to equal the norm
on the positive cone, as with total variation on positive measures. -/
theorem geometric_probability_mixture (K : Set E) (hclosed : IsClosed K)
    (hadd : ∀ ⦃x y : E⦄, x ∈ K → y ∈ K → x + y ∈ K)
    (hsmul : ∀ ⦃a : ℝ⦄ ⦃x : E⦄, 0 ≤ a → x ∈ K → a • x ∈ K)
    (mass : E →L[ℝ] ℝ) (hmass : ∀ x ∈ K, mass x = ‖x‖)
    (η : ℕ → E) (hη : ∀ n, η n ∈ K) (hηnorm : ∀ n, ‖η n‖ = 1) :
    let m := ∑' n : ℕ, ((1 / 2 : ℝ) / 2^n) • η n
    m ∈ K ∧ ‖m‖ = 1 ∧ ∀ n, m - ((1 / 2 : ℝ) / 2^n) • η n ∈ K := by
  let w (n : ℕ) : ℝ := (1 / 2) / 2^n
  let a (n : ℕ) : E := w n • η n
  let m : E := ∑' n, a n
  have hw (n : ℕ) : 0 ≤ w n := by dsimp [w]; positivity
  have hwform (n : ℕ) : w n = (1 / 2 : ℝ) * (1 / 2)^n := by
    change (1 / 2 : ℝ) / 2^n = (1 / 2 : ℝ) * (1 / 2)^n
    rw [div_eq_mul_inv, ← inv_pow, one_div]
  have hws : HasSum w 1 := by
    have hg := summable_geometric_of_lt_one (r := (1 / 2 : ℝ)) (by norm_num) (by norm_num)
    have h := hg.hasSum.mul_left (1 / 2 : ℝ)
    rw [tsum_geometric_of_lt_one (r := (1 / 2 : ℝ)) (by norm_num) (by norm_num)] at h
    norm_num at h
    change HasSum (fun n => w n) 1
    simp_rw [hwform]
    exact h
  have hn (n : ℕ) : ‖a n‖ = w n := by
    change ‖w n • η n‖ = w n
    rw [norm_smul, Real.norm_of_nonneg (hw n), hηnorm n, mul_one]
  have hs : Summable a := Summable.of_norm (by simpa only [hn] using hws.summable)
  have hz : (0 : E) ∈ K := by
    simpa only [zero_smul] using hsmul (a := (0 : ℝ)) le_rfl (hη 0)
  have hsum (f : ℕ → E) (hf : ∀ n, f n ∈ K) (hfs : Summable f) : (∑' n, f n) ∈ K := by
    apply hclosed.mem_of_tendsto hfs.hasSum
    refine Eventually.of_forall fun s => ?_
    induction s using Finset.induction_on with
    | empty => simpa only [Finset.sum_empty] using hz
    | insert i s hi ih => rw [Finset.sum_insert hi]; exact hadd (hf i) ih
  have ha (n : ℕ) : a n ∈ K := hsmul (hw n) (hη n)
  have hm : m ∈ K := hsum a ha hs
  have hn' : ‖m‖ = 1 := by
    have hma (n : ℕ) : mass (a n) = w n := by
      change mass (w n • η n) = w n
      rw [map_smul, hmass _ (hη n), hηnorm n, smul_eq_mul, mul_one]
    have he := mass.hasSum hs.hasSum
    simp_rw [hma] at he
    exact (hmass m hm).symm.trans (he.unique hws)
  refine ⟨hm, hn', fun n => ?_⟩
  change m - a n ∈ K
  let rest (i : ℕ) := if i = n then (0 : E) else a i
  have he : m - a n = ∑' i, rest i := by
    change (∑' i, a i) - a n = ∑' i, rest i
    rw [hs.tsum_eq_add_tsum_ite n, add_sub_cancel_left]
  rw [he]
  apply hsum rest
  · intro i
    by_cases hi : i = n
    · simpa only [rest, ite_eq_left hi] using hz
    · simpa only [rest, ite_eq_right hi] using ha i
  · have ht (i : ℕ) : ‖rest i‖ ≤ w i := by
      by_cases hi : i = n
      · simpa only [rest, ite_eq_left hi, norm_zero] using hw i
      · simp only [rest, ite_eq_right hi, hn, le_refl]
    exact Summable.of_norm (hws.summable.of_nonneg_of_le (fun _ => norm_nonneg _) ht)

/-- The same resolvent construction gives bounded domination of arbitrary
probabilities and a common dominating member for each countable family. -/
theorem resolventProbabilities_cofinal_countablyDirected (K : Set E) (hclosed : IsClosed K)
    (hadd : ∀ ⦃x y : E⦄, x ∈ K → y ∈ K → x + y ∈ K)
    (hsmul : ∀ ⦃a : ℝ⦄ ⦃x : E⦄, 0 ≤ a → x ∈ K → a • x ∈ K)
    (hmono : ∀ ⦃x y : E⦄, x ∈ K → y - x ∈ K → ‖x‖ ≤ ‖y‖)
    (mass : E →L[ℝ] ℝ) (hmass : ∀ x ∈ K, mass x = ‖x‖)
    (V : E →L[ℝ] E) (hV : ∀ ⦃x : E⦄, x ∈ K → V x ∈ K) :
    (∀ η ∈ K, ‖η‖ = 1 → ∃ ρ ∈ resolventProbabilities K V,
      ∃ k : ℝ, 1 ≤ k ∧ k • ρ - η ∈ K) ∧
    (∀ η : ℕ → E, (∀ n, η n ∈ K) → (∀ n, ‖η n‖ = 1) →
      ∃ ρ ∈ resolventProbabilities K V, ∃ k : ℝ, 1 ≤ k ∧
        ∀ n, (2^(n+1) * k : ℝ) • ρ - η n ∈ K) := by
  have hcofinal (η : E) (hη : η ∈ K) (hn : ‖η‖ = 1) :
      ∃ ρ ∈ resolventProbabilities K V, ∃ k : ℝ, 1 ≤ k ∧ k • ρ - η ∈ K := by
    let b := ‖V‖ + 1
    have hb : ‖V‖ < b := lt_add_one _
    have hb₀ : 0 < b := (norm_nonneg V).trans_lt hb
    obtain ⟨_, _, _, _, hk, _, hρ, hrn, hηρ, hVρ⟩ :=
      positive_resolvent_control K hclosed hadd hsmul hmono V hV η hη hn b hb
    exact ⟨_, ⟨hρ, hrn, b, hb₀, hVρ⟩, _, hk, hηρ⟩
  refine ⟨hcofinal, fun η hη hηn => ?_⟩
  let m := ∑' n : ℕ, ((1 / 2 : ℝ) / 2^n) • η n
  obtain ⟨hm, hmn, hsub⟩ := geometric_probability_mixture K hclosed hadd hsmul mass hmass η hη hηn
  obtain ⟨ρ, hρ, k, hk, hmk⟩ := hcofinal m hm hmn
  refine ⟨ρ, hρ, k, hk, fun n => ?_⟩
  have hh := hadd hmk (hsub n)
  have he : (k • ρ - m) + (m - ((1 / 2 : ℝ) / 2^n) • η n) =
      k • ρ - ((1 / 2 : ℝ) / 2^n) • η n := by abel
  rw [he] at hh
  have hz : 0 ≤ (2^(n+1) : ℝ) := by positivity
  have hh' := hsmul hz hh
  rwa [smul_sub, smul_smul, smul_smul, show (2^(n+1) : ℝ) * ((1 / 2 : ℝ) / 2^n) = 1 by
    rw [pow_succ]; field_simp, one_smul] at hh'

#print axioms positive_resolvent_scale_tendsto_one
#print axioms geometric_probability_mixture
#print axioms resolventProbabilities_cofinal_countablyDirected


end PositiveResolvent


section MeasureQuotient

variable {Ω X M : Type*} [MeasurableSpace Ω]
    [NormedAddCommGroup X] [NormedSpace ℝ X]
    [NormedAddCommGroup M] [NormedSpace ℝ M]

/-- Compression of the restriction PVM by the original splitting. -/
def PVM.compressed (P : PVM Ω M) (S : M →L[ℝ] X) (T : X →L[ℝ] M) : OVM Ω X where
  val E := S.comp ((P.val E).comp T)
  empty_eq := by ext x; simp [P.empty_eq]
  countably_additive E hE x := S.hasSum (P.countably_additive E hE (T x))

theorem PVM.compressed_normalized (P : PVM Ω M) (S : M →L[ℝ] X) (T : X →L[ℝ] M)
    (hST : ∀ x, S (T x) = x) : (P.compressed S T).Normalized := by
  ext x
  change S (P.val MeasSet.whole (T x)) = x
  rw [P.normalized]
  exact hST x

/-- Input from the density calculation preceding the local quotient step in
thm:measure-inductive-dilation. The quotient, its section and the dilation
are constructed from these data. -/
structure MeasureDensityStage (P : PVM Ω M) (S : M →L[ℝ] X) (T : X →L[ℝ] M)
    (Y : Type*) [NormedAddCommGroup Y] [NormedSpace ℝ Y] where
  density : Y →L[ℝ] M
  density_injective : Function.Injective density
  multiplication : PVM Ω Y
  one : Y
  cyclic_one : multiplication.CyclicVector one
  density_cut : ∀ E a, density (multiplication.val E a) = P.val E (density a)
  localProjection : Y →L[ℝ] Y
  density_projection : ∀ a, density (localProjection a) = T (S (density a))

namespace MeasureDensityStage

variable {P : PVM Ω M} {S : M →L[ℝ] X} {T : X →L[ℝ] M}
variable {Y Z : Type*} [NormedAddCommGroup Y] [NormedSpace ℝ Y]
  [NormedAddCommGroup Z] [NormedSpace ℝ Z]

def synthesisToOriginal (Q : MeasureDensityStage P S T Y) : Y →L[ℝ] X :=
  S.comp Q.density

abbrev Quotient (Q : MeasureDensityStage P S T Y) :=
  Y ⧸ Q.synthesisToOriginal.ker

instance (Q : MeasureDensityStage P S T Y) :
    IsClosed (Q.synthesisToOriginal.ker : Set Y) :=
  Q.synthesisToOriginal.isClosed_ker

theorem localProjection_idem (Q : MeasureDensityStage P S T Y)
    (hST : ∀ x, S (T x) = x) (a : Y) :
    Q.localProjection (Q.localProjection a) = Q.localProjection a := by
  apply Q.density_injective
  rw [Q.density_projection, Q.density_projection a, hST]

theorem synthesis_projection (Q : MeasureDensityStage P S T Y)
    (hST : ∀ x, S (T x) = x) (a : Y) :
    Q.synthesisToOriginal (Q.localProjection a) = Q.synthesisToOriginal a := by
  change S (Q.density (Q.localProjection a)) = S (Q.density a)
  rw [Q.density_projection, hST]

theorem synthesis_ker_le (Q : MeasureDensityStage P S T Y) :
    Q.synthesisToOriginal.ker ≤ Q.localProjection.ker := by
  intro a ha
  change S (Q.density a) = 0 at ha
  change Q.localProjection a = 0
  apply Q.density_injective
  rw [Q.density_projection, ha, map_zero, map_zero]

theorem synthesis_ker_eq (Q : MeasureDensityStage P S T Y)
    (hST : ∀ x, S (T x) = x) : Q.synthesisToOriginal.ker = Q.localProjection.ker := by
  refine le_antisymm Q.synthesis_ker_le ?_
  intro a ha
  change Q.localProjection a = 0 at ha
  change Q.synthesisToOriginal a = 0
  rw [← Q.synthesis_projection hST a, ha, map_zero]

def synthesis (Q : MeasureDensityStage P S T Y) : Y →L[ℝ] Q.Quotient :=
  Q.synthesisToOriginal.ker.mkQL

def analysis (Q : MeasureDensityStage P S T Y) : Q.Quotient →L[ℝ] Y :=
  Q.synthesisToOriginal.ker.liftQL Q.localProjection Q.synthesis_ker_le

def inclusion (Q : MeasureDensityStage P S T Y) : Q.Quotient →L[ℝ] X :=
  Q.synthesisToOriginal.ker.liftQL Q.synthesisToOriginal le_rfl

theorem synthesis_surjective (Q : MeasureDensityStage P S T Y) :
    Function.Surjective Q.synthesis :=
  Submodule.Quotient.mk_surjective _

@[simp] theorem analysis_synthesis (Q : MeasureDensityStage P S T Y) (a : Y) :
    Q.analysis (Q.synthesis a) = Q.localProjection a := rfl

@[simp] theorem inclusion_synthesis (Q : MeasureDensityStage P S T Y) (a : Y) :
    Q.inclusion (Q.synthesis a) = S (Q.density a) := rfl

theorem inclusion_injective (Q : MeasureDensityStage P S T Y) :
    Function.Injective Q.inclusion := by
  intro x y he
  obtain ⟨a, rfl⟩ := Q.synthesis_surjective x
  obtain ⟨b, rfl⟩ := Q.synthesis_surjective y
  change Q.synthesisToOriginal a = Q.synthesisToOriginal b at he
  change Submodule.Quotient.mk a = Submodule.Quotient.mk b
  apply (Submodule.Quotient.eq Q.synthesisToOriginal.ker).mpr
  change Q.synthesisToOriginal (a - b) = 0
  rw [map_sub, he, sub_self]

theorem synthesis_analysis (Q : MeasureDensityStage P S T Y) (hST : ∀ x, S (T x) = x)
    (x : Q.Quotient) : Q.synthesis (Q.analysis x) = x := by
  obtain ⟨a, rfl⟩ := Q.synthesis_surjective x
  rw [Q.analysis_synthesis]
  apply Q.inclusion_injective
  exact Q.synthesis_projection hST a

theorem density_analysis (Q : MeasureDensityStage P S T Y) (x : Q.Quotient) :
    Q.density (Q.analysis x) = T (Q.inclusion x) := by
  obtain ⟨a, rfl⟩ := Q.synthesis_surjective x
  rw [Q.analysis_synthesis, Q.inclusion_synthesis, Q.density_projection]

theorem norm_analysis (Q : MeasureDensityStage P S T Y) (hST : ∀ x, S (T x) = x)
    (x : Q.Quotient) :
    ‖x‖ ≤ ‖Q.analysis x‖ ∧ ‖Q.analysis x‖ ≤ ‖Q.localProjection‖ * ‖x‖ := by
  refine ⟨?_, ?_⟩
  · have h := Submodule.Quotient.norm_mk_le Q.synthesisToOriginal.ker (Q.analysis x)
    change ‖Q.synthesis (Q.analysis x)‖ ≤ _ at h
    rwa [Q.synthesis_analysis hST] at h
  · refine le_of_forall_pos_le_add fun ε hε => ?_
    let δ := ε / (‖Q.localProjection‖ + 1)
    have hδ : 0 < δ := div_pos hε (by positivity)
    obtain ⟨a, ha, hna⟩ := Submodule.Quotient.norm_mk_lt x hδ
    change Q.synthesis a = x at ha
    have hδε : ‖Q.localProjection‖ * δ ≤ ε := by
      have hd : δ * (‖Q.localProjection‖ + 1) = ε := by
        dsimp [δ]
        exact div_mul_cancel₀ _ (by positivity)
      nlinarith [hδ.le]
    calc
      ‖Q.analysis x‖ = ‖Q.localProjection a‖ := by rw [← ha, Q.analysis_synthesis]
      _ ≤ ‖Q.localProjection‖ * ‖a‖ := Q.localProjection.le_opNorm a
      _ ≤ ‖Q.localProjection‖ * (‖x‖ + δ) :=
        mul_le_mul_of_nonneg_left hna.le (norm_nonneg _)
      _ ≤ ‖Q.localProjection‖ * ‖x‖ + ε := by rw [mul_add]; gcongr

noncomputable def localOVM (Q : MeasureDensityStage P S T Y) : OVM Ω Q.Quotient :=
  Q.multiplication.compressed Q.synthesis Q.analysis

theorem inclusion_intertwines (Q : MeasureDensityStage P S T Y)
    (E : MeasSet Ω) (x : Q.Quotient) :
    Q.inclusion (Q.localOVM.val E x) = (P.compressed S T).val E (Q.inclusion x) := by
  change Q.inclusion (Q.synthesis (Q.multiplication.val E (Q.analysis x))) =
    S (P.val E (T (Q.inclusion x)))
  rw [Q.inclusion_synthesis, Q.density_cut, Q.density_analysis]

/-- The local quotient carries the restriction of the original OVM and
has the cyclic density-space dilation of the manuscript. -/
def localDilation (Q : MeasureDensityStage P S T Y) (hST : ∀ x, S (T x) = x) :
    Dilation Q.localOVM Y where
  P := Q.multiplication
  S := Q.synthesis
  T := Q.analysis
  split := by ext x; exact Q.synthesis_analysis hST x
  compress _ := rfl

theorem localDilation_cyclic (Q : MeasureDensityStage P S T Y) (hST : ∀ x, S (T x) = x) :
    (Q.localDilation hST).P.Cyclic :=
  ⟨Q.one, Q.cyclic_one⟩

variable (Q : MeasureDensityStage P S T Y) (Q' : MeasureDensityStage P S T Z)

/-- The connecting map of the local quotients, induced by changing density. -/
def connectingMap (j : Y →L[ℝ] Z) (hj : ∀ a, Q'.density (j a) = Q.density a) :
    Q.Quotient →L[ℝ] Q'.Quotient :=
  Q.synthesisToOriginal.ker.liftQL (Q'.synthesis.comp j) (by
    intro a ha
    change S (Q.density a) = 0 at ha
    change Submodule.Quotient.mk (j a) = 0
    apply (Submodule.Quotient.mk_eq_zero Q'.synthesisToOriginal.ker).mpr
    change S (Q'.density (j a)) = 0
    rwa [hj])

/-- The three commuting diagrams of the measure-quotient theorem follow
from the equality of the signed measures represented by both densities. -/
theorem connectingMap_diagrams (j : Y →L[ℝ] Z)
    (hj : ∀ a, Q'.density (j a) = Q.density a) :
    (∀ a, Q.connectingMap Q' j hj (Q.synthesis a) = Q'.synthesis (j a)) ∧
    (∀ x, Q'.inclusion (Q.connectingMap Q' j hj x) = Q.inclusion x) ∧
    (∀ x, Q'.analysis (Q.connectingMap Q' j hj x) = j (Q.analysis x)) ∧
    ∀ E a, j (Q.multiplication.val E a) = Q'.multiplication.val E (j a) := by
  refine ⟨fun _ => rfl, ?_, ?_, ?_⟩
  · intro x
    obtain ⟨a, rfl⟩ := Q.synthesis_surjective x
    change S (Q'.density (j a)) = S (Q.density a)
    rw [hj]
  · intro x
    obtain ⟨a, rfl⟩ := Q.synthesis_surjective x
    apply Q'.density_injective
    change Q'.density (Q'.localProjection (j a)) = Q'.density (j (Q.localProjection a))
    rw [Q'.density_projection, hj, hj, Q.density_projection]
  · intro E a
    apply Q'.density_injective
    rw [hj, Q.density_cut, Q'.density_cut, hj]

end MeasureDensityStage

