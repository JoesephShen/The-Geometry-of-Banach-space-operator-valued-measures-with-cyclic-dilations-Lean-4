private theorem integral_abs_WalshL2_le (a : WalshL2) :
    (∫ t, |a t| ∂lebesgueUnitInterval) ≤ ‖a‖ := by
  let h := (Lp.memLp a).norm
  let b : WalshL2 := h.toLp (fun t => ‖a t‖)
  have hnorm : ‖b‖ = ‖a‖ := by
    rw [show ‖b‖ = (eLpNorm (fun t => ‖a t‖) 2 lebesgueUnitInterval).toReal from Lp.norm_toLp _ h,
      eLpNorm_norm, Lp.norm_def]
    exact Lp.aestronglyMeasurable a
  have he := integral_congr_ae (MemLp.coeFn_toLp h)
  have hB := citeProbabilityLpIntegralBound 2 b
  rw [he, hnorm] at hB
  exact (le_abs_self _).trans (by simpa only [Real.norm_eq_abs] using hB)

private theorem RademacherLTwoSynthesis.no_functional_extends_signs
    (B : RademacherLTwoSynthesis) (t : ℝ) :
    ¬ ∃ f : Dual LTwo, ∀ n, f (lTwoUnit n) = (B.sign n).1 t := by
  rintro ⟨f, hf⟩
  obtain ⟨R, hR⟩ := citeLTwoRieszCoordinate
  have hs := (lp.hasSum_norm (p := 2) (by norm_num) (R f)).summable
  have hOne : Summable (fun _ : ℕ => (1 : ℝ)) := hs.congr fun n => by
    rw [hR, hf, Real.norm_eq_abs, B.sign_abs, Real.one_rpow]
  exact one_ne_zero (tendsto_nhds_unique tendsto_const_nhds hOne.tendsto_atTop_zero)



private theorem RademacherLTwoSynthesis.atom_orbitVariation
    (B : RademacherLTwoSynthesis) (Q : PVM ℕ LTwo)
    (hQ : ∀ E x n, (Q.val E x) n = if n ∈ E.1 then x n else 0) (x : LTwo) (n : ℕ) :
    (B.disjointOperatorMeasure Q).orbitVariation x ((MeasSet.natAtom n).onSumRight (Ω₁ := ℝ)) =
      ENNReal.ofReal |x n| := by
  rw [OVM.orbitVariation_eq_of_singleton_set (t := Sum.inr n) _ _ _
    (by change Sum.inr '' ({n} : Set ℕ) = _; simp), B.disjointOperatorMeasure_apply,
    MeasSet.sumLeft_onSumRight, MeasSet.sumRight_onSumRight]
  have he : Q.val (MeasSet.natAtom n) x = x n • lTwoUnit n := by
    apply Subtype.ext
    funext j
    change (Q.val (MeasSet.natAtom n) x) j = ((x n • lTwoUnit n : LTwo) j)
    rw [hQ, lp.coeFn_smul, Pi.smul_apply, lTwoUnit_apply, smul_eq_mul]
    by_cases hj : j = n
    · subst j
      rw [ite_eq_left (show n ∈ (MeasSet.natAtom n).1 from mem_singleton n), ite_eq_left rfl, mul_one]
    · rw [ite_eq_right (show j ∉ (MeasSet.natAtom n).1 from hj), ite_eq_right hj, mul_zero]
  rw [show (∫ t in MeasSet.empty.1, B.synthesis x t ∂lebesgueUnitInterval) = 0 by
    simp [MeasSet.empty], zero_smul, zero_add, he, norm_smul, norm_lTwoUnit, mul_one, Real.norm_eq_abs]

private theorem RademacherLTwoSynthesis.left_cut_rank_le_one
    (B : RademacherLTwoSynthesis) (Q : PVM ℕ LTwo) (E : MeasSet ℝ) :
    Module.rank ℝ ((B.disjointOperatorMeasure Q).val (E.onSumLeft (Ω₂ := ℕ))).toLinearMap.range ≤ 1 := by
  rw [B.leftOperatorMeasure_onLeft Q E]
  apply (rank_le_one_iff_exists_smulRight _).mpr
  let P := FiniteSignedMeasure.probabilityLpPVM (ρ := lebesgueUnitInterval) (p := 2) (by norm_num)
  exact ⟨lTwoUnit 0, ((probabilityScalarIntegral 2).comp (P.val E)).comp B.synthesis.toContinuousLinearMap, rfl⟩



/-- Manuscript, ex:orbit-variation-no-frame, using actual Rademacher
synthesis and the ℓ² sum dilation. The domain is the disjoint sum of
Lebesgue measure restricted to the unit interval and the natural numbers. -/
theorem exists_rademacher_localOrbitVariation_no_frame :
    ∃ (B : RademacherLTwoSynthesis) (Q : PVM ℕ LTwo),
      let μ := B.disjointOperatorMeasure Q
      μ.Normalized ∧
      (∀ E : MeasSet (ℝ ⊕ ℕ), ∀ x, μ.val E x =
        (∫ t in E.sumLeft.1, B.synthesis x t ∂lebesgueUnitInterval) • lTwoUnit 0 + Q.val E.sumRight x) ∧
      (∃ A : ℕ → MeasSet (ℝ ⊕ ℕ), MeasSet.DisjointSeq A ∧ MeasSet.iUnion A = MeasSet.whole ∧
        ∀ n x, μ.orbitVariation x (A n) < ⊤) ∧
      (∃ D : Dilation μ RademacherSumSpace,
        IsReflexive RademacherSumSpace ∧ D.P.Cyclic ∧ ‖D.T‖ ≤ Real.sqrt 2 ∧ ‖D.S‖ ≤ Real.sqrt 2) ∧
      (∀ x, μ.orbitVariation x ((MeasSet.whole : MeasSet ℝ).onSumLeft (Ω₂ := ℕ)) ≤ ENNReal.ofReal ‖x‖) ∧
      (∀ E : MeasSet ℝ, ∀ N : ℕ,
        ENNReal.ofReal (Real.sqrt N * (lebesgueUnitInterval E.1).toReal) ≤
          μ.operatorVariation (E.onSumLeft (Ω₂ := ℕ))) ∧
      (∀ (x : LTwo) (n : ℕ), μ.orbitVariation x ((MeasSet.natAtom n).onSumRight (Ω₁ := ℝ)) =
        ENNReal.ofReal |x n|) ∧
      (∀ E : MeasSet ℝ,
        Module.rank ℝ (μ.val (E.onSumLeft (Ω₂ := ℕ))).toLinearMap.range ≤ 1) ∧
      (¬ ∃ ρ : Measure (ℝ ⊕ ℕ), SigmaFinite ρ ∧
        ∃ F : ContinuousSchauderFrame (X := LTwo) ρ, F.operatorMeasure = μ) ∧
      ∀ t, ¬ ∃ f : Dual LTwo, ∀ n, f (lTwoUnit n) = (B.sign n).1 t := by
  obtain ⟨B⟩ := citeRademacherLTwoSynthesis
  obtain ⟨Q, hQ, hNorm, v, _, hv⟩ := citeLTwoCoordinatePVM.2
  refine ⟨B, Q, B.disjointOperatorMeasure_normalized Q, B.disjointOperatorMeasure_apply Q,
    ⟨rademacherFrameExamplePartition, rademacherFrameExamplePartition_disjoint,
      rademacherFrameExamplePartition_cover, B.localOrbitVariation_on_disjointPartition Q⟩,
    B.exists_reflexive_cyclic_disjoint_dilation Q v hv, ?_, fun E N => B.operatorVariation_lower Q hQ hNorm N E,
    B.atom_orbitVariation Q hQ, B.left_cut_rank_le_one Q,
    B.no_continuous_frame_disjoint Q hQ hNorm, B.no_functional_extends_signs⟩
  intro x
  rw [B.disjointOrbitVariation_left_finite]
  apply ENNReal.ofReal_le_ofReal
  exact (integral_abs_WalshL2_le (B.synthesis x)).trans_eq (B.synthesis.norm_map x)

#print axioms exists_rademacher_localOrbitVariation_no_frame

end OrbitVariationFrameExampleConstruction


noncomputable section CZeroFrameObstruction

open MeasureTheory
open scoped ENNReal ZeroAtInfty

/-- No c₀-valued coefficient can have scalar marginals with these
Rademacher integrals. The scalar variations are used directly, so the
argument applies to an arbitrary representation measure. -/
theorem no_cZero_density_with_sign_marginals
    (η ρ : Measure ℝ) [IsProbabilityMeasure ρ]
    (r : ℕ → ℝ → ℝ) (hr : ∀ n, Integrable (r n) ρ)
    (habs : ∀ n, ∀ᵐ t ∂ρ, |r n t| = 1)
    (a : ℝ → ℝ) (v : ℝ → CZero)
    (hi : ∀ n, Integrable (fun t => a t * v t n) η)
    (he : ∀ (E : MeasSet ℝ) n, (∫ t in E.1, a t * v t n ∂η) = ∫ t in E.1, r n t ∂ρ) :
    False := by
  let g (n : ℕ) (t : ℝ) := a t * v t n
  have hnorm (E : MeasSet ℝ) (n : ℕ) :
      (∫ t in E.1, |g n t| ∂η) = (ρ E.1).toReal := by
    have h₁ := citeBochnerDensityVariation η (g n) (hi n) E
    have h₂ := citeBochnerDensityVariation ρ (r n) (hr n) E
    have heq : ∀ E : MeasSet ℝ, (∫ t in E.1, g n t ∂η) = ∫ t in E.1, r n t ∂ρ :=
      fun E => he E n
    simp_rw [heq] at h₁
    have h := h₁.symm.trans h₂
    simp only [Real.norm_eq_abs] at h
    rw [integral_congr_ae (ae_restrict_of_ae (habs n)), setIntegral_const, smul_eq_mul, mul_one] at h
    exact (ENNReal.ofReal_eq_ofReal_iff (integral_nonneg fun _ => abs_nonneg _) ENNReal.toReal_nonneg).mp h
  have hsame (n : ℕ) : (fun t => |g n t|) =ᵐ[η] fun t => |g 0 t| := by
    apply Integrable.ae_eq_of_forall_setIntegral_eq _ _ (hi n).abs (hi 0).abs
    intro s hs _
    rw [hnorm ⟨s, hs⟩ n, hnorm ⟨s, hs⟩ 0]
  have hzero : (fun t => |g 0 t|) =ᵐ[η] fun _ => 0 := by
    filter_upwards [ae_all_iff.mpr hsame] with t ht
    have hlim : Tendsto (fun n => |g n t|) atTop (𝓝 0) := by
      have h := (tendsto_const_nhds (x := a t)).mul (cZero_tendsto (v t))
      have h' : Tendsto (fun n => g n t) atTop (𝓝 0) := by simpa only [g, mul_zero] using h
      simpa only [map_zero, abs_zero, Function.comp_def] using (continuous_abs.tendsto (0 : ℝ)).comp h'
    exact tendsto_nhds_unique (tendsto_const_nhds.congr fun n => (ht n).symm) hlim
  have hμ := hnorm MeasSet.whole 0
  rw [MeasSet.whole, setIntegral_univ, integral_congr_ae hzero, integral_zero, measure_univ,
    ENNReal.toReal_one] at hμ
  exact zero_ne_one hμ

#print axioms no_cZero_density_with_sign_marginals

end CZeroFrameObstruction



noncomputable section CZeroRademacherFrameExample

open MeasureTheory
open scoped ENNReal ZeroAtInfty Classical

/-- Bessel's inequality for the Rademacher orthonormal family, followed
by the canonical contraction from ℓ² to c₀. -/
axiom citeRademacherBesselIntoCZero (B : RademacherLTwoSynthesis) :
    ∃ V : WalshL2 →L[ℝ] CZero, ‖V‖ ≤ 1 ∧ ∀ h n,
      (V h) n = ∫ t, h t * (B.sign n).1 t ∂lebesgueUnitInterval

private def cZeroGeometric : CZero where
  toContinuousMap := ⟨fun j => (1 / 2 : ℝ) ^ j, continuous_of_discreteTopology⟩
  zero_at_infty' := by
    rw [cocompact_eq_atTop]
    exact tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num) (by norm_num)

private theorem cZeroCoordinatePVM_geometric_cyclic : cZeroCoordinatePVM.CyclicVector cZeroGeometric := by
  let P := cZeroCoordinatePVM
  let H := (Submodule.span ℝ (Set.range fun E => P.val E cZeroGeometric)).topologicalClosure
  have hclosed : IsClosed (H : Set CZero) := Submodule.isClosed_topologicalClosure _
  have hcoord (n : ℕ) (x : CZero) : P.val (MeasSet.natAtom n) x =
      (x n / ((1 / 2 : ℝ) ^ n)) • P.val (MeasSet.natAtom n) cZeroGeometric := by
    ext j
    change cZeroCoordinateCut {n} x j = (x n / ((1 / 2 : ℝ) ^ n)) * cZeroCoordinateCut {n} cZeroGeometric j
    rw [cZeroCoordinateCut_apply, cZeroCoordinateCut_apply]
    by_cases h : j = n
    · subst j
      rw [ite_eq_left (mem_singleton n), ite_eq_left (mem_singleton n)]
      change x n = x n / ((1 / 2 : ℝ) ^ n) * ((1 / 2 : ℝ) ^ n)
      rw [div_mul_cancel₀ _ (by positivity)]
    · rw [ite_eq_right (show j ∉ ({n} : Set ℕ) from h), ite_eq_right (show j ∉ ({n} : Set ℕ) from h), mul_zero]
  have hm (n : ℕ) (x : CZero) : P.val (MeasSet.natAtom n) x ∈ H := by
    rw [hcoord n x]
    exact H.smul_mem _ (subset_closure (Submodule.subset_span ⟨_, rfl⟩))
  intro x
  have hsum : HasSum (fun n => P.val (MeasSet.natAtom n) x) x := by
    have hh := P.toOVM.natAtom_hasSum MeasSet.whole x
    rw [P.normalized] at hh
    simpa only [MeasSet.whole, mem_univ, ite_true, ContinuousLinearMap.id_apply] using hh
  exact hclosed.mem_of_tendsto hsum (Eventually.of_forall fun I => Submodule.sum_mem _ fun n _ => hm n x)
private abbrev CZeroRademacherSum := WithLp 2 (WalshL2 × CZero)

private def cZeroRademacherSumEquiv : CZeroRademacherSum ≃L[ℝ] (WalshL2 × CZero) :=
  WithLp.prodContinuousLinearEquiv 2 ℝ WalshL2 CZero

private def cZeroRademacherAnalysis : CZero →L[ℝ] CZeroRademacherSum :=
  cZeroRademacherSumEquiv.symm.toContinuousLinearMap.comp
    (((cZeroCoordinateEval 0).smulRight (probabilityScalarOne (ρ := lebesgueUnitInterval) 2)).prod
      (ContinuousLinearMap.id ℝ CZero))

private def cZeroRademacherSynthesis (V : WalshL2 →L[ℝ] CZero) : CZeroRademacherSum →L[ℝ] CZero :=
  (V.comp (ContinuousLinearMap.fst ℝ WalshL2 CZero) + ContinuousLinearMap.snd ℝ WalshL2 CZero).comp
    cZeroRademacherSumEquiv.toContinuousLinearMap

private def cZeroRademacherProjection : PVM (ℝ ⊕ ℕ) CZeroRademacherSum :=
  ((FiniteSignedMeasure.probabilityLpPVM (ρ := lebesgueUnitInterval) (p := 2)
    (by norm_num)).disjointSum cZeroCoordinatePVM).transportByEquiv cZeroRademacherSumEquiv

private def cZeroRademacherOperatorMeasure (V : WalshL2 →L[ℝ] CZero) : OVM (ℝ ⊕ ℕ) CZero :=
  cZeroRademacherProjection.compressed (cZeroRademacherSynthesis V) cZeroRademacherAnalysis

private def cZeroRademacherVM (V : WalshL2 →L[ℝ] CZero) (E : MeasSet ℝ) : CZero :=
  V ((FiniteSignedMeasure.probabilityLpPVM (ρ := lebesgueUnitInterval) (p := 2) (by norm_num)).val E
    (probabilityScalarOne 2))

private theorem cZeroRademacherOperatorMeasure_apply (V : WalshL2 →L[ℝ] CZero)
    (E : MeasSet (ℝ ⊕ ℕ)) (x : CZero) :
    (cZeroRademacherOperatorMeasure V).val E x =
      x 0 • cZeroRademacherVM V E.sumLeft + cZeroCoordinatePVM.val E.sumRight x := by
  let e := cZeroRademacherSumEquiv
  let P := FiniteSignedMeasure.probabilityLpPVM (ρ := lebesgueUnitInterval) (p := 2) (by norm_num)
  change cZeroRademacherSynthesis V
    (e.symm (((P.disjointSum cZeroCoordinatePVM).val E)
      (e (e.symm (x 0 • probabilityScalarOne 2, x))))) = _
  rw [e.apply_symm_apply]
  change cZeroRademacherSynthesis V
    (e.symm (P.val E.sumLeft (x 0 • probabilityScalarOne 2), cZeroCoordinatePVM.val E.sumRight x)) = _
  have he (z : WalshL2 × CZero) : cZeroRademacherSynthesis V (e.symm z) = V z.1 + z.2 := by
    change V (e (e.symm z)).1 + (e (e.symm z)).2 = _
    rw [e.apply_symm_apply]
  rw [he, map_smul, map_smul]
  rfl

private theorem cZeroRademacherVM_coeff (B : RademacherLTwoSynthesis)
    (V : WalshL2 →L[ℝ] CZero) (hV : ∀ h n, (V h) n =
      ∫ t, h t * (B.sign n).1 t ∂lebesgueUnitInterval)
    (E : MeasSet ℝ) (n : ℕ) :
    cZeroRademacherVM V E n = ∫ t in E.1, (B.sign n).1 t ∂lebesgueUnitInterval := by
  rw [cZeroRademacherVM, hV, ← integral_indicator E.2]
  apply integral_congr_ae
  have hp := FiniteSignedMeasure.lpCut_ae E (probabilityScalarOne (ρ := lebesgueUnitInterval) 2)
  filter_upwards [hp, probabilityScalarOne_ae (ρ := lebesgueUnitInterval) 2] with t ht he
  change FiniteSignedMeasure.lpCut E (probabilityScalarOne 2) t * (B.sign n).1 t = _
  rw [ht]
  by_cases h : t ∈ E.1
  · rw [indicator_of_mem h, indicator_of_mem h, he, one_mul]
  · rw [indicator_of_notMem h, indicator_of_notMem h, zero_mul]

private theorem cZeroRademacherOperatorMeasure_normalized (B : RademacherLTwoSynthesis)
    (V : WalshL2 →L[ℝ] CZero) (hV : ∀ h n, (V h) n =
      ∫ t, h t * (B.sign n).1 t ∂lebesgueUnitInterval) :
    (cZeroRademacherOperatorMeasure V).Normalized := by
  apply ContinuousLinearMap.ext
  intro x
  have hmean (n : ℕ) : (∫ t, (B.sign n).1 t ∂lebesgueUnitInterval) = 0 :=
    (integral_congr_ae (B.basis_density n)).symm.trans (B.mean_zero (lTwoUnit n))
  have hzero : cZeroRademacherVM V (MeasSet.whole : MeasSet ℝ) = 0 := by
    ext n
    rw [cZeroRademacherVM_coeff B V hV, MeasSet.whole, setIntegral_univ, hmean]
    rfl
  rw [cZeroRademacherOperatorMeasure_apply]
  change x 0 • cZeroRademacherVM V MeasSet.whole + cZeroCoordinatePVM.val MeasSet.whole x = x
  rw [hzero, smul_zero, zero_add, cZeroCoordinatePVM.normalized, ContinuousLinearMap.id_apply]

private theorem cZeroRademacher_dilation (B : RademacherLTwoSynthesis) (V : WalshL2 →L[ℝ] CZero)
    (hV : ∀ h n, (V h) n = ∫ t, h t * (B.sign n).1 t ∂lebesgueUnitInterval) :
    ∃ D : Dilation (cZeroRademacherOperatorMeasure V) CZeroRademacherSum, D.P.Cyclic := by
  let P := FiniteSignedMeasure.probabilityLpPVM (ρ := lebesgueUnitInterval) (p := 2) (by norm_num)
  let D : Dilation (cZeroRademacherOperatorMeasure V) CZeroRademacherSum :=
    { P := cZeroRademacherProjection
      S := cZeroRademacherSynthesis V
      T := cZeroRademacherAnalysis
      compress := fun _ => rfl
      split := by
        rw [← cZeroRademacherOperatorMeasure_normalized B V hV]
        rw [show (cZeroRademacherOperatorMeasure V).val MeasSet.whole =
          (cZeroRademacherSynthesis V).comp (cZeroRademacherProjection.val MeasSet.whole |>.comp cZeroRademacherAnalysis)
          from rfl, cZeroRademacherProjection.normalized, ContinuousLinearMap.id_comp] }
  have hc := P.disjointSum_cyclicVector cZeroCoordinatePVM (probabilityScalarOne (ρ := lebesgueUnitInterval) 2)
    cZeroGeometric (probabilityScalarOne_cyclic 2 (by norm_num)) cZeroCoordinatePVM_geometric_cyclic
  refine ⟨D, ⟨cZeroRademacherSumEquiv.symm (probabilityScalarOne 2, cZeroGeometric), ?_⟩⟩
  exact (P.disjointSum cZeroCoordinatePVM).transportByEquiv_cyclicVector cZeroRademacherSumEquiv _ hc

#print axioms cZeroRademacherVM_coeff
#print axioms cZeroRademacher_dilation




private theorem cZeroRademacher_no_frame
    (B : RademacherLTwoSynthesis) (V : WalshL2 →L[ℝ] CZero)
    (hV : ∀ h n, (V h) n = ∫ t, h t * (B.sign n).1 t ∂lebesgueUnitInterval) :
    ¬ ∃ η : Measure (ℝ ⊕ ℕ), ∃ F : ContinuousSchauderFrame (X := CZero) η,
      F.operatorMeasure = cZeroRademacherOperatorMeasure V := by
  rintro ⟨η, F, hF⟩
  let e : ℝ → ℝ ⊕ ℕ := Sum.inl
  have hm : MeasurableEmbedding e := ⟨Sum.inl_injective, measurable_inl, fun _ hs => hs.inl_image⟩
  let e₀ := cZeroCoordinateVector 0
  let g (n : ℕ) (t : ℝ ⊕ ℕ) := F.functional t e₀ * cZeroCoordinateEval n (F.vector t)
  have hi (n : ℕ) : Integrable (g n) η := F.coefficient_integrable e₀ (cZeroCoordinateEval n)
  have hic (n : ℕ) : Integrable (fun t => g n (e t)) (η.comap e) := by
    exact hm.integrableOn_range_iff_comap.mp (hi n).integrableOn
  have hCut (E : MeasSet ℝ) (n : ℕ) :
      (∫ t in E.1, g n (e t) ∂(η.comap e)) = ∫ t in e '' E.1, g n t ∂η := by
    rw [hm.restrict_comap, ← hm.integral_map, hm.map_comap]
    rw [Measure.restrict_restrict hm.measurableSet_range]
    rw [inter_eq_right.mpr (Set.image_subset_range e E.1)]
  apply no_cZero_density_with_sign_marginals (η.comap e) lebesgueUnitInterval
    (fun n t => (B.sign n).1 t) B.sign_integrable (fun n => Eventually.of_forall (B.sign_abs n))
    (fun t => F.functional (e t) e₀) (fun t => F.vector (e t)) hic
  intro E n
  change (∫ t in E.1, g n (e t) ∂η.comap e) = _
  rw [hCut]
  have hh := F.operatorMeasure_coeff (E.onSumLeft (Ω₂ := ℕ)) e₀ (cZeroCoordinateEval n)
  change cZeroCoordinateEval n (F.operatorMeasure.val E.onSumLeft e₀) =
    ∫ t in e '' E.1, g n t ∂η at hh
  rw [← hh, hF, cZeroRademacherOperatorMeasure_apply, MeasSet.sumLeft_onSumLeft,
    MeasSet.sumRight_onSumLeft, cZeroCoordinatePVM.empty_eq, zero_apply, add_zero]
  change cZeroCoordinateEval n ((1 : ℝ) • cZeroRademacherVM V E) = _
  rw [one_smul]
  exact cZeroRademacherVM_coeff B V hV E n

private theorem cZeroRademacherVM_norm_le (B : RademacherLTwoSynthesis)
    (V : WalshL2 →L[ℝ] CZero) (hV : ∀ h n, (V h) n =
      ∫ t, h t * (B.sign n).1 t ∂lebesgueUnitInterval) (E : MeasSet ℝ) :
    ‖cZeroRademacherVM V E‖ ≤ (lebesgueUnitInterval E.1).toReal := by
  apply cZero_norm_le _ ENNReal.toReal_nonneg
  intro n
  rw [cZeroRademacherVM_coeff B V hV, ← Real.norm_eq_abs]
  apply (norm_integral_le_integral_norm _).trans
  simp_rw [Real.norm_eq_abs, B.sign_abs, setIntegral_const, smul_eq_mul, mul_one]
  exact le_rfl

private theorem cZeroCoordinateVector_norm_eq_one (n : ℕ) : ‖cZeroCoordinateVector n‖ = 1 := by
  apply le_antisymm
  · apply cZero_norm_le _ zero_le_one
    intro j
    change |(if j = n then (1 : ℝ) else 0)| ≤ 1
    split <;> norm_num
  · have h := cZero_apply_bound (cZeroCoordinateVector n) n
    change |(if n = n then (1 : ℝ) else 0)| ≤ _ at h
    simpa using h

private theorem cZeroRademacher_left_variation_eq (B : RademacherLTwoSynthesis)
    (V : WalshL2 →L[ℝ] CZero) (hV : ∀ h n, (V h) n =
      ∫ t, h t * (B.sign n).1 t ∂lebesgueUnitInterval) (A : MeasSet ℝ) :
    (cZeroRademacherOperatorMeasure V).operatorVariation (A.onSumLeft (Ω₂ := ℕ)) =
      lebesgueUnitInterval A.1 := by
  let E := A.onSumLeft (Ω₂ := ℕ)
  let μ := cZeroRademacherOperatorMeasure V
  have hvNorm (D : MeasSet (ℝ ⊕ ℕ)) (hD : D.1 ⊆ E.1) :
      ‖μ.val D‖ ≤ (lebesgueUnitInterval D.sumLeft.1).toReal := by
    have hr : D.sumRight = MeasSet.empty := Subtype.ext (eq_empty_iff_forall_notMem.mpr fun t ht => by
      obtain ⟨a, _, he⟩ := hD ht
      cases he)
    apply ContinuousLinearMap.opNorm_le_bound _ ENNReal.toReal_nonneg
    intro x
    change ‖(cZeroRademacherOperatorMeasure V).val D x‖ ≤ _
    rw [cZeroRademacherOperatorMeasure_apply, hr, cZeroCoordinatePVM.empty_eq, zero_apply, add_zero, norm_smul,
      Real.norm_eq_abs]
    rw [mul_comm]
    exact mul_le_mul (cZeroRademacherVM_norm_le B V hV D.sumLeft) (cZero_apply_bound x 0)
      (abs_nonneg _) ENNReal.toReal_nonneg
  apply le_antisymm
  · apply sSup_le
    rintro _ ⟨D, I, hd, hI, rfl⟩
    have hsub (i : ℕ) (hi : i ∈ I) : (D i).1 ⊆ E.1 := by
      intro t ht
      have hh : t ∈ (MeasSet.finiteUnion D I).1 := mem_iUnion₂.mpr ⟨i, hi, ht⟩
      rwa [hI] at hh
    have hUnion : MeasSet.finiteUnion (fun i => (D i).sumLeft) I = A := by
      have he := congrArg MeasSet.sumLeft hI
      rw [MeasSet.sumLeft_onSumLeft] at he
      apply Subtype.ext
      change (⋃ i ∈ I, Sum.inl ⁻¹' (D i).1) = A.1
      simp_rw [← preimage_iUnion]
      exact congrArg Subtype.val he
    have hsum : (∑ i ∈ I, lebesgueUnitInterval (D i).sumLeft.1) = lebesgueUnitInterval A.1 := by
      change (∑ i ∈ I, lebesgueUnitInterval (Sum.inl ⁻¹' (D i).1)) = lebesgueUnitInterval A.1
      rw [← measure_biUnion_finset (fun i hi j hj hij => (hd hi hj hij).preimage Sum.inl)
        (fun i _ => (D i).sumLeft.2)]
      exact congrArg (fun S : MeasSet ℝ => lebesgueUnitInterval S.1) hUnion
    rw [← hsum]
    apply Finset.sum_le_sum
    intro i hi
    have h := ENNReal.ofReal_le_ofReal (hvNorm (D i) (hsub i hi))
    rwa [ENNReal.ofReal_toReal (measure_ne_top _ _)] at h
  · have hv := citeBochnerDensityVariation lebesgueUnitInterval (B.sign 0).1 (B.sign_integrable 0) A
    simp only [Real.norm_eq_abs] at hv
    have hh : (fun t => |(B.sign 0).1 t|) = fun _ => 1 := funext (B.sign_abs 0)
    rw [hh, setIntegral_const, smul_eq_mul, mul_one] at hv
    change _ = ENNReal.ofReal (lebesgueUnitInterval A.1).toReal at hv
    rw [ENNReal.ofReal_toReal (measure_ne_top _ _)] at hv
    rw [← hv]
    apply sSup_le
    rintro _ ⟨D, I, hd, hI, rfl⟩
    let C (i : ℕ) := (D i).onSumLeft (Ω₂ := ℕ)
    have hUnion : MeasSet.finiteUnion C I = E := by
      apply Subtype.ext
      change (⋃ i ∈ I, Sum.inl '' (D i).1) = Sum.inl '' A.1
      simp_rw [← image_iUnion]
      exact congrArg (fun S : MeasSet ℝ => Sum.inl '' S.1) hI
    have hle : (∑ i ∈ I, ENNReal.ofReal ‖μ.val (C i)‖) ≤ μ.operatorVariation E :=
      le_sSup ⟨C, I, fun i hi j hj hij => disjoint_image_injective Sum.inl Sum.inl_injective (hd hi hj hij),
        hUnion, rfl⟩
    apply le_trans _ hle
    rw [ENNReal.ofReal_sum_of_nonneg (fun _ _ => abs_nonneg _)]
    apply Finset.sum_le_sum
    intro i hi
    apply ENNReal.ofReal_le_ofReal
    let x := cZeroCoordinateVector 0
    have he : μ.val (C i) x = cZeroRademacherVM V (D i) := by
      change (cZeroRademacherOperatorMeasure V).val (C i) x = _
      rw [cZeroRademacherOperatorMeasure_apply, MeasSet.sumLeft_onSumLeft, MeasSet.sumRight_onSumLeft,
        cZeroCoordinatePVM.empty_eq, zero_apply, add_zero]
      change (1 : ℝ) • cZeroRademacherVM V (D i) = _
      rw [one_smul]
    rw [← cZeroRademacherVM_coeff B V hV (D i), ← he]
    exact (cZero_apply_bound (μ.val (C i) x) 0).trans (by
      simpa only [x, cZeroCoordinateVector_norm_eq_one, mul_one] using (μ.val (C i)).le_opNorm x)

#print axioms cZeroRademacher_no_frame
#print axioms cZeroRademacher_left_variation_eq



private theorem OVM.operatorVariation_eq_of_singleton_set
    {Ω : Type*} [MeasurableSpace Ω] {Y : Type*} [NormedAddCommGroup Y] [NormedSpace ℝ Y]
    (μ : OVM Ω Y) (A : MeasSet Ω) {t : Ω} (hA : A.1 = {t}) :
    μ.operatorVariation A = ENNReal.ofReal ‖μ.val A‖ := by
  apply le_antisymm
  · apply sSup_le
    rintro _ ⟨D, I, hD, hI, rfl⟩
    have ht : t ∈ (MeasSet.finiteUnion D I).1 := by rw [hI, hA]; exact mem_singleton _
    obtain ⟨k, hk, htk⟩ := mem_iUnion₂.mp ht
    have hsub (i : ℕ) (hi : i ∈ I) : (D i).1 ⊆ A.1 := fun _ ht =>
      hI ▸ (show _ ∈ (MeasSet.finiteUnion D I).1 from mem_iUnion₂.mpr ⟨i, hi, ht⟩)
    have hk' : D k = A := Subtype.ext ((hsub k hk).antisymm (by rw [hA]; exact singleton_subset_iff.mpr htk))
    rw [Finset.sum_eq_single_of_mem k hk, hk']
    intro j hj hjk
    have he : D j = MeasSet.empty := Subtype.ext (eq_empty_iff_forall_notMem.mpr fun s hs => by
      have hm := hsub j hj hs
      rw [hA] at hm
      have h : s = t := hm
      exact Set.disjoint_left.mp (hD hj hk hjk) hs (h ▸ htk))
    rw [he, μ.empty_eq, norm_zero, ENNReal.ofReal_zero]
  · exact μ.enorm_val_le_operatorVariation A

private theorem cZeroRademacher_rightAtom_variation (V : WalshL2 →L[ℝ] CZero) (n : ℕ) :
    (cZeroRademacherOperatorMeasure V).operatorVariation ((MeasSet.natAtom n).onSumRight (Ω₁ := ℝ)) = 1 := by
  let A := (MeasSet.natAtom n).onSumRight (Ω₁ := ℝ)
  have hA : A.1 = {Sum.inr n} := by change Sum.inr '' ({n} : Set ℕ) = _; simp
  have hval : (cZeroRademacherOperatorMeasure V).val A = cZeroCoordinatePVM.val (MeasSet.natAtom n) := by
    apply ContinuousLinearMap.ext
    intro x
    rw [cZeroRademacherOperatorMeasure_apply, show A.sumLeft = MeasSet.empty from
      (MeasSet.natAtom n).sumLeft_onSumRight, show A.sumRight = MeasSet.natAtom n from
      (MeasSet.natAtom n).sumRight_onSumRight]
    have he : cZeroRademacherVM V (MeasSet.empty : MeasSet ℝ) = 0 := by
      let P := FiniteSignedMeasure.probabilityLpPVM (ρ := lebesgueUnitInterval) (p := 2) (by norm_num)
      change V (P.val MeasSet.empty (probabilityScalarOne 2)) = _
      rw [P.empty_eq, zero_apply, map_zero]
    rw [he, smul_zero, zero_add]
  rw [OVM.operatorVariation_eq_of_singleton_set _ A hA, hval]
  have hh : ‖cZeroCoordinatePVM.val (MeasSet.natAtom n)‖ = 1 := by
    apply le_antisymm
    · apply ContinuousLinearMap.opNorm_le_bound _ zero_le_one
      intro x
      rw [one_mul]
      apply cZero_norm_le _ (norm_nonneg _)
      intro j
      change |cZeroCoordinateCut {n} x j| ≤ ‖x‖
      rw [cZeroCoordinateCut_apply]
      split
      · exact cZero_apply_bound x j
      · rw [abs_zero]
        exact norm_nonneg _
    · let x := cZeroCoordinateVector n
      have he : cZeroCoordinatePVM.val (MeasSet.natAtom n) x = x := by
        ext j
        change cZeroCoordinateCut {n} x j = x j
        rw [cZeroCoordinateCut_apply]
        by_cases h : j = n
        · exact ite_eq_left (show j ∈ ({n} : Set ℕ) from h)
        · rw [ite_eq_right (show j ∉ ({n} : Set ℕ) from h)]
          change 0 = (if j = n then 1 else 0)
          rw [ite_eq_right h]
      have h := (cZeroCoordinatePVM.val (MeasSet.natAtom n)).le_opNorm x
      rwa [he, show ‖x‖ = 1 from cZeroCoordinateVector_norm_eq_one n, mul_one] at h
  rw [hh, ENNReal.ofReal_one]

private theorem cZeroRademacher_right_variation (V : WalshL2 →L[ℝ] CZero) (E : MeasSet ℕ) :
    (cZeroRademacherOperatorMeasure V).operatorVariation (E.onSumRight (Ω₁ := ℝ)) =
      ∑' n : ℕ, if n ∈ E.1 then 1 else 0 := by
  let D (n : ℕ) : MeasSet (ℝ ⊕ ℕ) :=
    if n ∈ E.1 then (MeasSet.natAtom n).onSumRight else MeasSet.empty
  have hD : MeasSet.DisjointSeq D := by
    intro i j hij
    by_cases hi : i ∈ E.1
    · rw [show D i = (MeasSet.natAtom i).onSumRight from ite_eq_left hi]
      by_cases hj : j ∈ E.1
      · rw [show D j = (MeasSet.natAtom j).onSumRight from ite_eq_left hj]
        exact disjoint_image_injective Sum.inr Sum.inr_injective (disjoint_singleton.mpr hij)
      · rw [show D j = MeasSet.empty from ite_eq_right hj]
        exact disjoint_empty _
    · rw [show D i = MeasSet.empty from ite_eq_right hi]
      exact empty_disjoint _
  have hUnion : MeasSet.iUnion D = E.onSumRight (Ω₁ := ℝ) := by
    apply Subtype.ext
    ext t
    change (t ∈ ⋃ n, (D n).1) ↔ t ∈ Sum.inr '' E.1
    constructor
    · intro ht
      obtain ⟨n, hn⟩ := mem_iUnion.mp ht
      by_cases ha : n ∈ E.1
      · simp only [D, ha, ite_true] at hn
        change t ∈ Sum.inr '' ({n} : Set ℕ) at hn
        exact Set.image_mono (singleton_subset_iff.mpr ha) hn
      · rw [show D n = MeasSet.empty from ite_eq_right ha] at hn
        exact hn.elim
    · rintro ⟨n, hn, rfl⟩
      apply mem_iUnion.mpr
      refine ⟨n, ?_⟩
      rw [show D n = (MeasSet.natAtom n).onSumRight from ite_eq_left hn]
      exact ⟨n, mem_singleton n, rfl⟩
  rw [← hUnion, OVM.operatorVariation_iUnion _ D hD]
  apply tsum_congr
  intro n
  by_cases hn : n ∈ E.1
  · rw [show D n = (MeasSet.natAtom n).onSumRight from ite_eq_left hn, ite_eq_left hn,
      cZeroRademacher_rightAtom_variation]
  · rw [show D n = MeasSet.empty from ite_eq_right hn, ite_eq_right hn, OVM.operatorVariation_empty]

private theorem cZeroRademacher_variationMeasure_eq
    (B : RademacherLTwoSynthesis) (V : WalshL2 →L[ℝ] CZero)
    (hV : ∀ h n, (V h) n = ∫ t, h t * (B.sign n).1 t ∂lebesgueUnitInterval) :
    (cZeroRademacherOperatorMeasure V).operatorVariationMeasure =
      Measure.map Sum.inl lebesgueUnitInterval + Measure.sum (fun n : ℕ => Measure.dirac (Sum.inr n)) := by
  apply Measure.ext
  intro s hs
  let E : MeasSet (ℝ ⊕ ℕ) := ⟨s, hs⟩
  let L := E.sumLeft.onSumLeft (Ω₂ := ℕ)
  let R := E.sumRight.onSumRight (Ω₁ := ℝ)
  let μ := cZeroRademacherOperatorMeasure V
  have hc : L.union R = E := by
    apply Subtype.ext
    ext z
    cases z <;> simp [L, R, MeasSet.sumLeft, MeasSet.sumRight, MeasSet.onSumLeft, MeasSet.onSumRight, MeasSet.union]
  have hd : Disjoint L.1 R.1 := Set.disjoint_left.mpr (by rintro _ ⟨a, _, rfl⟩ ⟨b, _, hm⟩; cases hm)
  change μ.operatorVariationMeasure E.1 =
    ((Measure.map Sum.inl lebesgueUnitInterval + Measure.sum (fun n : ℕ => Measure.dirac (Sum.inr n))) : Measure (ℝ ⊕ ℕ)) E.1
  have hsum : μ.operatorVariationMeasure E.1 =
      μ.operatorVariationMeasure L.1 + μ.operatorVariationMeasure R.1 := by
    rw [← hc, show (L.union R).1 = L.1 ∪ R.1 from rfl, measure_union hd R.2]
  rw [hsum, μ.operatorVariationMeasure_apply, μ.operatorVariationMeasure_apply,
    cZeroRademacher_left_variation_eq B V hV, cZeroRademacher_right_variation,
    add_apply, Measure.map_apply measurable_inl E.2, Measure.sum_apply _ E.2]
  congr 1
  apply tsum_congr
  intro n
  rw [Measure.dirac_apply' _ E.2]
  rfl

private theorem cZeroRademacher_variation_sigmaFinite (B : RademacherLTwoSynthesis)
    (V : WalshL2 →L[ℝ] CZero) (hV : ∀ h n, (V h) n =
      ∫ t, h t * (B.sign n).1 t ∂lebesgueUnitInterval) :
    SigmaFinite (cZeroRademacherOperatorMeasure V).operatorVariationMeasure := by
  apply Measure.sigmaFinite_of_countable (Set.countable_range fun n => (rademacherFrameExamplePartition n).1)
  · rintro _ ⟨n, rfl⟩
    rw [OVM.operatorVariationMeasure_apply]
    cases n with
    | zero =>
      rw [rademacherFrameExamplePartition, cZeroRademacher_left_variation_eq B V hV]
      exact measure_lt_top _ _
    | succ n => rw [rademacherFrameExamplePartition, cZeroRademacher_rightAtom_variation, lt_top_iff_ne_top]
                exact ENNReal.one_ne_top
  · rw [sUnion_range]
    exact congrArg Subtype.val rademacherFrameExamplePartition_cover

/-- Manuscript, ex:c0-variation-no-frame. The measure is normalized and
cyclic, its variation is Lebesgue measure plus the counting measure
on the second summand, and it has no continuous frame representation. -/
theorem exists_cZero_cyclic_sigmaFinite_no_frame :
    ∃ (B : RademacherLTwoSynthesis) (V : WalshL2 →L[ℝ] CZero),
      ‖V‖ ≤ 1 ∧
      (∀ h n, (V h) n = ∫ t, h t * (B.sign n).1 t ∂lebesgueUnitInterval) ∧
      let μ := cZeroRademacherOperatorMeasure V
      μ.Normalized ∧
      (∀ E : MeasSet (ℝ ⊕ ℕ), ∀ x : CZero, μ.val E x =
        x 0 • cZeroRademacherVM V E.sumLeft + cZeroCoordinatePVM.val E.sumRight x) ∧
      (∃ D : Dilation μ CZeroRademacherSum, D.P.Cyclic) ∧
      (μ.operatorVariationMeasure =
        Measure.map Sum.inl lebesgueUnitInterval + Measure.sum (fun n : ℕ => Measure.dirac (Sum.inr n))) ∧
      SigmaFinite μ.operatorVariationMeasure ∧
      ¬ ∃ η : Measure (ℝ ⊕ ℕ), ∃ F : ContinuousSchauderFrame (X := CZero) η, F.operatorMeasure = μ := by
  obtain ⟨B⟩ := citeRademacherLTwoSynthesis
  obtain ⟨V, hNorm, hV⟩ := citeRademacherBesselIntoCZero B
  exact ⟨B, V, hNorm, hV, cZeroRademacherOperatorMeasure_normalized B V hV, cZeroRademacherOperatorMeasure_apply V,
    cZeroRademacher_dilation B V hV, cZeroRademacher_variationMeasure_eq B V hV,
    cZeroRademacher_variation_sigmaFinite B V hV, cZeroRademacher_no_frame B V hV⟩

#print axioms exists_cZero_cyclic_sigmaFinite_no_frame



private theorem cZeroRademacherVM_countably_additive (V : WalshL2 →L[ℝ] CZero)
    (A : ℕ → MeasSet ℝ) (hA : MeasSet.DisjointSeq A) :
    HasSum (fun n => cZeroRademacherVM V (A n)) (cZeroRademacherVM V (MeasSet.iUnion A)) := by
  let P := FiniteSignedMeasure.probabilityLpPVM (ρ := lebesgueUnitInterval) (p := 2) (by norm_num)
  exact V.hasSum (P.countably_additive A hA (probabilityScalarOne 2))

private theorem cZeroRademacherVM_variation_eq (B : RademacherLTwoSynthesis)
    (V : WalshL2 →L[ℝ] CZero)
    (hV : ∀ h n, (V h) n = ∫ t, h t * (B.sign n).1 t ∂lebesgueUnitInterval)
    (E : MeasSet ℝ) :
    sSup {v | ∃ (D : ℕ → MeasSet ℝ) (I : Finset ℕ),
      (↑I : Set ℕ).Pairwise (fun i j => Disjoint (D i).1 (D j).1) ∧
      MeasSet.finiteUnion D I = E ∧ v = ENNReal.ofReal (∑ i ∈ I, ‖cZeroRademacherVM V (D i)‖)} =
      lebesgueUnitInterval E.1 := by
  apply le_antisymm
  · apply sSup_le
    rintro _ ⟨D, I, hD, hI, rfl⟩
    rw [ENNReal.ofReal_sum_of_nonneg (fun _ _ => norm_nonneg _)]
    have he : (∑ i ∈ I, lebesgueUnitInterval (D i).1) = lebesgueUnitInterval E.1 := by
      rw [← measure_biUnion_finset hD (fun i _ => (D i).2)]
      exact congrArg (fun A : MeasSet ℝ => lebesgueUnitInterval A.1) hI
    rw [← he]
    apply Finset.sum_le_sum
    intro i hi
    exact (ENNReal.ofReal_le_ofReal (cZeroRademacherVM_norm_le B V hV (D i))).trans_eq
      (ENNReal.ofReal_toReal (measure_ne_top _ _))
  · have h := citeBochnerDensityVariation lebesgueUnitInterval (B.sign 0).1 (B.sign_integrable 0) E
    simp only [Real.norm_eq_abs] at h
    have hh : (fun t => |(B.sign 0).1 t|) = fun _ => 1 := funext (B.sign_abs 0)
    rw [hh, setIntegral_const, smul_eq_mul, mul_one] at h
    change _ = ENNReal.ofReal (lebesgueUnitInterval E.1).toReal at h
    rw [ENNReal.ofReal_toReal (measure_ne_top _ _)] at h
    rw [← h]
    apply sSup_le
    rintro _ ⟨D, I, hD, hI, rfl⟩
    have hs : (∑ i ∈ I, |∫ t in (D i).1, (B.sign 0).1 t ∂lebesgueUnitInterval|) ≤
      ∑ i ∈ I, ‖cZeroRademacherVM V (D i)‖ := by
      apply Finset.sum_le_sum
      intro i hi
      rw [← cZeroRademacherVM_coeff B V hV (D i) 0]
      exact cZero_apply_bound _ _
    exact (ENNReal.ofReal_le_ofReal hs).trans (le_sSup ⟨_, _, hD, hI, rfl⟩)

#print axioms cZeroRademacherVM_variation_eq

end CZeroRademacherFrameExample


noncomputable section AssociatedFrameSpace

open MeasureTheory

universe uΩ uX uY
variable {Ω : Type uΩ} {X : Type uX} {Y : Type uY} [MeasurableSpace Ω]
  [NormedAddCommGroup X] [NormedSpace ℝ X]
  [NormedAddCommGroup Y] [NormedSpace ℝ Y] {η : Measure Ω}

/-- Manuscript, def:associated-space. The analysis uses the original
coefficient functions on the same measure space, and the synthesis is
defined by the corresponding Pettis integral. -/
structure FrameAssociatedSpace (F : ContinuousSchauderFrame (X := X) η) where
  repr : Y →ₗ[ℝ] (Ω →ₘ[η] ℝ)
  repr_injective : Function.Injective repr
  solid : ∀ y (h : Ω →ₘ[η] ℝ), (∀ᵐ t ∂η, |h t| ≤ |repr y t|) →
    ∃ z, repr z = h ∧ ‖z‖ ≤ ‖y‖
  positive : ∃ y : Y, ∀ᵐ t ∂η, 0 < repr y t
  analysis : X →L[ℝ] Y
  synthesis : Y →L[ℝ] X
  analysis_coeff : ∀ x, (fun t => repr (analysis x) t) =ᵐ[η] fun t => F.functional t x
  pettis : ∀ y, PettisIntegrable η (fun t => repr y t • F.vector t)
  synthesis_coeff : ∀ y (g : Dual X), g (synthesis y) =
    ∫ t, repr y t * g (F.vector t) ∂η

namespace FrameAssociatedSpace

variable {F : ContinuousSchauderFrame (X := X) η} (A : FrameAssociatedSpace (Y := Y) F)

theorem split : A.synthesis.comp A.analysis = ContinuousLinearMap.id ℝ X := by
  apply ContinuousLinearMap.ext
  intro x
  apply eq_of_dual_eval
  intro g
  change g (A.synthesis (A.analysis x)) = g x
  rw [A.synthesis_coeff, F.reconstruction x g]
  apply integral_congr_ae
  filter_upwards [A.analysis_coeff x] with t ht
  rw [ht]

theorem analysisEmbedding : ∃ c : ℝ, 0 < c ∧ ∀ x : X, c * ‖x‖ ≤ ‖A.analysis x‖ := by
  let C := ‖A.synthesis‖ + 1
  have hC : 0 < C := by dsimp only [C]; positivity
  refine ⟨C⁻¹, inv_pos.mpr hC, fun x => ?_⟩
  rw [← div_eq_inv_mul, div_le_iff₀ hC, mul_comm]
  have he : A.synthesis (A.analysis x) = x := DFunLike.congr_fun A.split x
  calc
    ‖x‖ = ‖A.synthesis (A.analysis x)‖ := congrArg norm he.symm
    _ ≤ ‖A.synthesis‖ * ‖A.analysis x‖ := A.synthesis.le_opNorm _
    _ ≤ _ := mul_le_mul_of_nonneg_right (le_add_of_nonneg_right zero_le_one) (norm_nonneg _)

theorem synthesis_surjective : Function.Surjective A.synthesis :=
  fun x => ⟨A.analysis x, DFunLike.congr_fun A.split x⟩

include A in
theorem containsCopy_of_underlying {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (h : ContainsCopy E X) : ContainsCopy E Y := by
  obtain ⟨T, c, hc, hT⟩ := h
  obtain ⟨d, hd, hA⟩ := A.analysisEmbedding
  refine ⟨A.analysis.comp T, d * c, mul_pos hd hc, fun x => ?_⟩
  rw [mul_assoc]
  exact (mul_le_mul_of_nonneg_left (hT x) hd.le).trans (hA (T x))

include A in
theorem reflexive_underlying (hY : IsReflexive Y) : IsReflexive X := by
  intro ξ
  obtain ⟨y, hy⟩ := hY (secondAdjoint A.analysis ξ)
  refine ⟨A.synthesis y, ?_⟩
  rw [← secondAdjoint_canonical, hy, secondAdjoint_comp, A.split]
  ext f
  rfl

include A in
theorem not_contains_lOne_of_associated (hY : ¬ ContainsCopy LOne Y) :
    ¬ ContainsCopy LOne X :=
  fun hX => hY (A.containsCopy_of_underlying hX)

include A in
theorem not_contains_cZero_of_weaklySeqComplete_associated (hY : WeaklySeqComplete Y) :
    ¬ ContainsCopy CZero X :=
  fun hX => hY.not_contains_cZero (A.containsCopy_of_underlying hX)



include A in
theorem not_contains_cZero_of_KB_associated [CompleteSpace Y] [Lattice Y]
    [IsOrderedAddMonoid Y] [PosSMulMono ℝ Y] [HasSolidNorm Y]
    (hY : OrderContinuousLatticeNorm Y)
    (hKB : ∀ u : ℕ → Y, Monotone u → (∀ n, 0 ≤ u n) →
      (∃ C : ℝ, ∀ n, ‖u n‖ ≤ C) → ∃ v : Y, Tendsto u atTop (𝓝 v)) :
    ¬ ContainsCopy CZero X :=
  A.not_contains_cZero_of_weaklySeqComplete_associated ((citeOrderContinuousLatticeKB hY).mpr hKB)



end FrameAssociatedSpace

#print axioms FrameAssociatedSpace.split
#print axioms FrameAssociatedSpace.analysisEmbedding
#print axioms FrameAssociatedSpace.not_contains_lOne_of_associated
#print axioms FrameAssociatedSpace.not_contains_cZero_of_weaklySeqComplete_associated
#print axioms FrameAssociatedSpace.reflexive_underlying
#print axioms FrameAssociatedSpace.not_contains_cZero_of_KB_associated

end AssociatedFrameSpace



noncomputable section AssociatedWeightSupport

open MeasureTheory

variable {Ω X : Type*} [MeasurableSpace Ω] [NormedAddCommGroup X] [NormedSpace ℝ X]
  [CompleteSpace X] [TopologicalSpace.SeparableSpace X] {η : Measure Ω}

/-- On the nonzero vector field of a fixed frame, null sets for the
weighted vector measure agree exactly with null sets of the original
measure. The condition on all subcuts is the vector-measure nullity. -/
theorem ContinuousSchauderFrame.weightedVectorMeasure_null_iff_on_nonzero
    (F : ContinuousSchauderFrame (X := X) η) (w : Ω → ℝ)
    (hw : ∀ t, 0 < w t) (hwi : Integrable (fun t => w t • F.vector t) η)
    (m : MeasSet Ω → X) (hm : ∀ E : MeasSet Ω, m E = ∫ t in E.1, w t • F.vector t ∂η)
    (E : MeasSet Ω) (hE : ∀ t ∈ E.1, F.vector t ≠ 0) :
    (∀ D : MeasSet Ω, D.1 ⊆ E.1 → m D = 0) ↔ η E.1 = 0 := by
  constructor
  · intro hnull
    obtain ⟨g, _, hnorm⟩ := exists_countable_norming_family
      (TopologicalSpace.denseSeq X) (TopologicalSpace.denseRange_denseSeq X)
    let ν := η.restrict E.1
    have hzero (n : ℕ) : (fun t => g n (w t • F.vector t)) =ᵐ[ν] fun _ => 0 := by
      apply Integrable.ae_eq_zero_of_forall_setIntegral_eq_zero ((g n).integrable_comp hwi).restrict
      intro B hB _
      rw [Measure.restrict_restrict hB]
      let D : MeasSet Ω := ⟨B ∩ E.1, hB.inter E.2⟩
      calc
        (∫ t in D.1, g n (w t • F.vector t) ∂η) =
            g n (∫ t in D.1, w t • F.vector t ∂η) :=
          (g n).integral_comp_comm (μ := η.restrict D.1) hwi.restrict
        _ = 0 := by rw [← hm D, hnull D inter_subset_right, map_zero]
    have hz : ∀ᵐ t ∂ν, F.vector t = 0 := by
      filter_upwards [ae_all_iff.mpr hzero] with t ht
      apply eq_zero_of_norming_family g hnorm
      intro n
      have hh := ht n
      change g n (w t • F.vector t) = 0 at hh
      rw [map_smul, smul_eq_mul] at hh
      exact (mul_eq_zero.mp hh).resolve_left (hw t).ne'
    have hn : ∀ᵐ t ∂ν, False := by
      filter_upwards [hz, ae_restrict_mem E.2] with t hz₀ ht
      exact hE t ht hz₀
    rw [ae_iff] at hn
    have hν : ν univ = 0 := by simpa only [not_false_eq_true, Set.ofPred_true] using hn
    change (η.restrict E.1) univ = 0 at hν
    rwa [Measure.restrict_apply_univ] at hν
  · intro hη D hDE
    rw [hm, Measure.restrict_eq_zero.mpr (measure_mono_null hDE hη), integral_zero_measure]

#print axioms ContinuousSchauderFrame.weightedVectorMeasure_null_iff_on_nonzero

end AssociatedWeightSupport


noncomputable section AssociatedZeroWeight

open MeasureTheory

open scoped ENNReal NNReal

variable {Ω X : Type*} [MeasurableSpace Ω] [NormedAddCommGroup X] [NormedSpace ℝ X]
  [CompleteSpace X] [TopologicalSpace.SeparableSpace X] {η : Measure Ω} [SigmaFinite η]

/-- A positive weight retaining the original analysis coefficients on
a zero-vector summand. The estimate also applies on each measurable cut. -/
theorem ContinuousSchauderFrame.exists_integrable_functional_weight
    (F : ContinuousSchauderFrame (X := X) η) :
    ∃ a : Ω → ℝ, Measurable a ∧ (∀ t, 0 < a t) ∧
      Integrable (fun t => a t * (1 + ‖F.functional t‖ ^ 2)) η ∧
      ∀ x : X, Integrable (fun t => a t * |F.functional t x| ^ 2) η := by
  obtain ⟨g, hg, hgm, hgi⟩ := exists_pos_lintegral_lt_of_sigmaFinite η
    (ε := 1) one_ne_zero
  have hgI : Integrable (fun t => (g t : ℝ)) η := by
    refine ⟨hgm.coe_nnreal_real.aestronglyMeasurable, ?_⟩
    simpa [HasFiniteIntegral, ← ofReal_norm] using hgi.trans_le (show (1 : ℝ≥0∞) ≤ ⊤ from le_top)
  have hm : Measurable (fun t => ‖F.functional t‖) :=
    measurable_operatorNorm_of_orbits F.functional fun x => (F.weakStarMeasurable x).norm
  let a (t : Ω) := (g t : ℝ) / (1 + ‖F.functional t‖ ^ 2)
  have ha (t : Ω) : 0 < a t := div_pos (hg t) (by positivity)
  have ham : Measurable a := hgm.coe_nnreal_real.div (measurable_const.add (hm.pow_const 2))
  have he (t : Ω) : a t * (1 + ‖F.functional t‖ ^ 2) = (g t : ℝ) :=
    div_mul_cancel₀ _ (by positivity)
  refine ⟨a, ham, ha, hgI.congr (Eventually.of_forall fun t => (he t).symm), fun x => ?_⟩
  have hcoeff : Measurable (fun t => |F.functional t x| ^ 2) := by
    simpa only [Real.norm_eq_abs] using (F.weakStarMeasurable x).norm.pow_const 2
  apply (hgI.mul_const (‖x‖ ^ 2)).mono' (ham.mul hcoeff).aestronglyMeasurable
  filter_upwards with t
  have hle := (F.functional t).le_opNorm x
  have hsq : |F.functional t x| ^ 2 ≤ (1 + ‖F.functional t‖ ^ 2) * ‖x‖ ^ 2 := by
    rw [← Real.norm_eq_abs] at *
    calc
      _ ≤ (‖F.functional t‖ * ‖x‖) ^ 2 := by gcongr
      _ = ‖F.functional t‖ ^ 2 * ‖x‖ ^ 2 := mul_pow _ _ _
      _ ≤ _ := by gcongr; linarith
  change ‖a t * |F.functional t x| ^ 2‖ ≤ (g t : ℝ) * ‖x‖ ^ 2
  rw [Real.norm_of_nonneg (mul_nonneg (ha t).le (sq_nonneg _)), ← he, mul_assoc]
  exact mul_le_mul_of_nonneg_left hsq (ha t).le

#print axioms ContinuousSchauderFrame.exists_integrable_functional_weight

end AssociatedZeroWeight


noncomputable section AssociatedGluing

open MeasureTheory

variable {Ω X Y Z : Type*} [MeasurableSpace Ω]
  [NormedAddCommGroup X] [NormedSpace ℝ X]
  [NormedAddCommGroup Y] [NormedSpace ℝ Y]
  [NormedAddCommGroup Z] [NormedSpace ℝ Z] {η : Measure Ω}

/-- One part of the analysis of the original frame, with coordinates
supported on the given measurable set. -/
structure FrameCoefficientPiece (F : ContinuousSchauderFrame (X := X) η)
    (A : MeasSet Ω) (Y : Type*) [NormedAddCommGroup Y] [NormedSpace ℝ Y] where
  repr : Y →ₗ[ℝ] (Ω →ₘ[η] ℝ)
  injective : Function.Injective repr
  solid : ∀ y (h : Ω →ₘ[η] ℝ), (∀ᵐ t ∂η, |h t| ≤ |repr y t|) →
    ∃ z, repr z = h ∧ ‖z‖ ≤ ‖y‖
  support : ∀ y, ∀ᵐ t ∂η, t ∉ A.1 → repr y t = 0
  one : Y
  positive : ∀ᵐ t ∂η, t ∈ A.1 → 0 < repr one t
  analysis : X →L[ℝ] Y
  analysis_coeff : ∀ x, (fun t => repr (analysis x) t) =ᵐ[η]
    A.1.indicator (fun t => F.functional t x)

def CoordinateOrderContinuous (q : Y →ₗ[ℝ] (Ω →ₘ[η] ℝ)) : Prop :=
  ∀ x : ℕ → Y, (∀ n, ∀ᵐ t ∂η, 0 ≤ q (x n) t) →
    (∀ i j, i ≤ j → ∀ᵐ t ∂η, q (x j) t ≤ q (x i) t) →
    (∀ᵐ t ∂η, Tendsto (fun n => q (x n) t) atTop (𝓝 0)) →
    Tendsto (fun n => ‖x n‖) atTop (𝓝 0)

def CoordinateKB (q : Y →ₗ[ℝ] (Ω →ₘ[η] ℝ)) : Prop :=
  ∀ x : ℕ → Y, (∀ n, ∀ᵐ t ∂η, 0 ≤ q (x n) t) →
    (∀ i j, i ≤ j → ∀ᵐ t ∂η, q (x i) t ≤ q (x j) t) →
    (∃ C : ℝ, ∀ n, ‖x n‖ ≤ C) → ∃ y, Tendsto x atTop (𝓝 y)

/-- Set indicator on an a.e. class, retaining the same reference measure. -/
private def associatedCut (A : MeasSet Ω) (h : Ω →ₘ[η] ℝ) : Ω →ₘ[η] ℝ :=
  AEEqFun.mk (A.1.indicator h) (h.aestronglyMeasurable.indicator A.2)

private theorem associatedCut_repr (A : MeasSet Ω) (h : Ω →ₘ[η] ℝ) :
    (associatedCut A h : Ω → ℝ) =ᵐ[η] A.1.indicator h :=
  AEEqFun.coeFn_mk _ _

/-- Reassemble the actual coefficient classes of a frame on complementary
measurable pieces using the Euclidean sum norm. The second component
does not contribute to synthesis. -/
theorem ContinuousSchauderFrame.exists_associated_of_complementary_pieces
    (F : ContinuousSchauderFrame (X := X) η) (A : MeasSet Ω)
    (L : FrameCoefficientPiece F A Y)
    (R : FrameCoefficientPiece F ⟨A.1ᶜ, A.2.compl⟩ Z)
    (hzero : ∀ t, t ∉ A.1 → F.vector t = 0)
    (S : Y →L[ℝ] X)
    (hP : ∀ y, PettisIntegrable η (fun t => L.repr y t • F.vector t))
    (hS : ∀ y (g : Dual X), g (S y) = ∫ t, L.repr y t * g (F.vector t) ∂η) :
    ∃ H : FrameAssociatedSpace (Y := WithLp 2 (Y × Z)) F,
      (CoordinateOrderContinuous L.repr → CoordinateOrderContinuous R.repr → CoordinateOrderContinuous H.repr) ∧
      (CoordinateKB L.repr → CoordinateKB R.repr → CoordinateKB H.repr) ∧
      ∃ v : WithLp 2 (Y × Z), (fun t => H.repr v t) =ᵐ[η]
        fun t => L.repr L.one t + R.repr R.one t := by
  classical
  let B : MeasSet Ω := ⟨A.1ᶜ, A.2.compl⟩
  let e := WithLp.prodContinuousLinearEquiv 2 ℝ Y Z
  let q : WithLp 2 (Y × Z) →ₗ[ℝ] (Ω →ₘ[η] ℝ) :=
    L.repr.comp ((ContinuousLinearMap.fst ℝ Y Z).comp e.toContinuousLinearMap).toLinearMap +
    R.repr.comp ((ContinuousLinearMap.snd ℝ Y Z).comp e.toContinuousLinearMap).toLinearMap
  have hq (z) : (fun t => q z t) =ᵐ[η] fun t => L.repr (e z).1 t + R.repr (e z).2 t :=
    AEEqFun.coeFn_add _ _
  have hqA (z) : ∀ᵐ t ∂η, t ∈ A.1 → q z t = L.repr (e z).1 t := by
    filter_upwards [hq z, R.support (e z).2] with t h ht hAt
    rw [h, ht (by simpa using hAt), add_zero]
  have hqB (z) : ∀ᵐ t ∂η, t ∉ A.1 → q z t = R.repr (e z).2 t := by
    filter_upwards [hq z, L.support (e z).1] with t h ht hn
    rw [h, ht hn, zero_add]
  have hqi : Function.Injective q := by
    intro z z' hz
    apply e.injective
    apply Prod.ext
    · apply L.injective
      apply AEEqFun.ext
      filter_upwards [hqA z, hqA z', L.support (e z).1, L.support (e z').1] with t h h' hn hn'
      by_cases ht : t ∈ A.1
      · rw [← h ht, ← h' ht, hz]
      · rw [hn ht, hn' ht]
    · apply R.injective
      apply AEEqFun.ext
      filter_upwards [hqB z, hqB z', R.support (e z).2, R.support (e z').2] with t h h' hn hn'
      by_cases ht : t ∈ A.1
      · rw [hn (by simpa using ht), hn' (by simpa using ht)]
      · rw [← h ht, ← h' ht, hz]
  have hsolid (z) (h : Ω →ₘ[η] ℝ) (hh : ∀ᵐ t ∂η, |h t| ≤ |q z t|) :
      ∃ u, q u = h ∧ ‖u‖ ≤ ‖z‖ := by
    have hL : ∀ᵐ t ∂η, |associatedCut A h t| ≤ |L.repr (e z).1 t| := by
      filter_upwards [associatedCut_repr A h, hqA z, hh] with t ht hq' hht
      rw [ht]
      by_cases hAt : t ∈ A.1
      · rw [indicator_of_mem hAt, ← hq' hAt]
        exact hht
      · rw [indicator_of_notMem hAt, abs_zero]
        exact abs_nonneg _
    have hR : ∀ᵐ t ∂η, |associatedCut B h t| ≤ |R.repr (e z).2 t| := by
      filter_upwards [associatedCut_repr B h, hqB z, hh] with t ht hq' hht
      rw [ht]
      by_cases hAt : t ∈ A.1
      · rw [indicator_of_notMem (show t ∉ B.1 from by simpa [B] using hAt), abs_zero]
        exact abs_nonneg _
      · rw [indicator_of_mem (show t ∈ B.1 from hAt), ← hq' hAt]
        exact hht
    obtain ⟨y, hy, hyn⟩ := L.solid (e z).1 (associatedCut A h) hL
    obtain ⟨v, hv, hvn⟩ := R.solid (e z).2 (associatedCut B h) hR
    let u := e.symm (y, v)
    have heu : e u = (y, v) := e.apply_symm_apply _
    refine ⟨u, AEEqFun.ext ?_, ?_⟩
    · have hqu := hq u
      rw [heu, hy, hv] at hqu
      filter_upwards [hqu, associatedCut_repr A h, associatedCut_repr B h] with t htu hA hB
      rw [htu, hA, hB]
      by_cases ht : t ∈ A.1 <;> simp [B, ht]
    · rw [WithLp.prod_norm_eq_of_L2, WithLp.prod_norm_eq_of_L2]
      change Real.sqrt (‖(e u).1‖ ^ 2 + ‖(e u).2‖ ^ 2) ≤
        Real.sqrt (‖(e z).1‖ ^ 2 + ‖(e z).2‖ ^ 2)
      rw [heu]
      gcongr
  let T := e.symm.toContinuousLinearMap.comp (L.analysis.prod R.analysis)
  let S' := S.comp ((ContinuousLinearMap.fst ℝ Y Z).comp e.toContinuousLinearMap)
  have hnonzero (z) : ∀ᵐ t ∂η, q z t • F.vector t = L.repr (e z).1 t • F.vector t := by
    filter_upwards [hqA z] with t ht
    by_cases hAt : t ∈ A.1
    · rw [ht hAt]
    · simp [hzero t hAt]
  let H : FrameAssociatedSpace (Y := WithLp 2 (Y × Z)) F := ⟨q, hqi, hsolid, ?_, T, S', ?_, ?_, ?_⟩
  · have hLle (u v) (h : ∀ᵐ t ∂η, q u t ≤ q v t) :
        ∀ᵐ t ∂η, L.repr (e u).1 t ≤ L.repr (e v).1 t := by
      filter_upwards [h, hqA u, hqA v, L.support (e u).1, L.support (e v).1] with t ht hu hv hLu hLv
      by_cases hAt : t ∈ A.1
      · rw [hu hAt, hv hAt] at ht
        exact ht
      · rw [hLu hAt, hLv hAt]
    have hRle (u v) (h : ∀ᵐ t ∂η, q u t ≤ q v t) :
        ∀ᵐ t ∂η, R.repr (e u).2 t ≤ R.repr (e v).2 t := by
      filter_upwards [h, hqB u, hqB v, R.support (e u).2, R.support (e v).2] with t ht hu hv hRu hRv
      by_cases hAt : t ∈ A.1
      · rw [hRu (by simpa using hAt), hRv (by simpa using hAt)]
      · rw [hu hAt, hv hAt] at ht
        exact ht
    have hLpos (z) (h : ∀ᵐ t ∂η, 0 ≤ q z t) :
        ∀ᵐ t ∂η, 0 ≤ L.repr (e z).1 t := by
      filter_upwards [h, hqA z, L.support (e z).1] with t ht hz hLz
      by_cases hAt : t ∈ A.1
      · rwa [← hz hAt]
      · rw [hLz hAt]
    have hRpos (z) (h : ∀ᵐ t ∂η, 0 ≤ q z t) :
        ∀ᵐ t ∂η, 0 ≤ R.repr (e z).2 t := by
      filter_upwards [h, hqB z, R.support (e z).2] with t ht hz hRz
      by_cases hAt : t ∈ A.1
      · rw [hRz (by simpa using hAt)]
      · rwa [← hz hAt]
    refine ⟨H, ?_, ?_, ?_⟩
    · intro hL hR x hpos hmono hzero'
      have h₁ : ∀ᵐ t ∂η, Tendsto (fun n => L.repr (e (x n)).1 t) atTop (𝓝 0) := by
        filter_upwards [hzero', ae_all_iff.mpr (fun n => hqA (x n)),
          ae_all_iff.mpr (fun n => L.support (e (x n)).1)] with t ht hxt hst
        by_cases hAt : t ∈ A.1
        · exact ht.congr' (Eventually.of_forall fun n => hxt n hAt)
        · simp only [hst _ hAt]
          exact tendsto_const_nhds
      have h₂ : ∀ᵐ t ∂η, Tendsto (fun n => R.repr (e (x n)).2 t) atTop (𝓝 0) := by
        filter_upwards [hzero', ae_all_iff.mpr (fun n => hqB (x n)),
          ae_all_iff.mpr (fun n => R.support (e (x n)).2)] with t ht hxt hst
        by_cases hAt : t ∈ A.1
        · simp only [hst _ (by simpa using hAt)]
          exact tendsto_const_nhds
        · exact ht.congr' (Eventually.of_forall fun n => hxt n hAt)
      have hL0 := hL (fun n => (e (x n)).1) (fun n => hLpos (x n) (hpos n))
        (fun i j hij => hLle (x j) (x i) (hmono i j hij)) h₁
      have hR0 := hR (fun n => (e (x n)).2) (fun n => hRpos (x n) (hpos n))
        (fun i j hij => hRle (x j) (x i) (hmono i j hij)) h₂
      have hnorm (n : ℕ) : ‖x n‖ = Real.sqrt (‖(e (x n)).1‖ ^ 2 + ‖(e (x n)).2‖ ^ 2) :=
        WithLp.prod_norm_eq_of_L2 (x n)
      simp_rw [hnorm]
      simpa only [zero_pow (show (2 : ℕ) ≠ 0 by decide), add_zero, Real.sqrt_zero] using
        ((hL0.pow 2).add (hR0.pow 2)).sqrt
    · intro hL hR x hpos hmono hb
      obtain ⟨C, hC⟩ := hb
      have hnorm (n : ℕ) : ‖x n‖ = Real.sqrt (‖(e (x n)).1‖ ^ 2 + ‖(e (x n)).2‖ ^ 2) :=
        WithLp.prod_norm_eq_of_L2 (x n)
      have hLbound n : ‖(e (x n)).1‖ ≤ C := by
        apply le_trans _ (hC n)
        rw [hnorm, Real.le_sqrt (norm_nonneg _) (by positivity)]
        exact le_add_of_nonneg_right (sq_nonneg _)
      have hRbound n : ‖(e (x n)).2‖ ≤ C := by
        apply le_trans _ (hC n)
        rw [hnorm, Real.le_sqrt (norm_nonneg _) (by positivity)]
        exact le_add_of_nonneg_left (sq_nonneg _)
      obtain ⟨y, hy⟩ := hL (fun n => (e (x n)).1)
        (fun n => hLpos (x n) (hpos n))
        (fun i j hij => hLle (x i) (x j) (hmono i j hij)) ⟨C, hLbound⟩
      obtain ⟨z, hz⟩ := hR (fun n => (e (x n)).2)
        (fun n => hRpos (x n) (hpos n))
        (fun i j hij => hRle (x i) (x j) (hmono i j hij)) ⟨C, hRbound⟩
      refine ⟨e.symm (y, z), ?_⟩
      simpa only [Function.comp_def, Prod.mk.eta, e.symm_apply_apply] using
        (e.symm.continuous.tendsto (y, z)).comp (hy.prodMk_nhds hz)
    · let v := e.symm (L.one, R.one)
      refine ⟨v, ?_⟩
      have h := hq v
      rwa [show e v = (L.one, R.one) from e.apply_symm_apply _] at h
  · let v := e.symm (L.one, R.one)
    refine ⟨v, ?_⟩
    have hev : e v = (L.one, R.one) := e.apply_symm_apply _
    have h₁ := hqA v
    have h₂ := hqB v
    rw [hev] at h₁ h₂
    filter_upwards [h₁, h₂, L.positive, R.positive] with t ht₁ ht₂ hp₁ hp₂
    by_cases hAt : t ∈ A.1
    · rw [ht₁ hAt]
      exact hp₁ hAt
    · rw [ht₂ hAt]
      exact hp₂ hAt
  · intro x
    have heT : e (T x) = (L.analysis x, R.analysis x) := e.apply_symm_apply _
    have h₁ := hqA (T x)
    have h₂ := hqB (T x)
    rw [heT] at h₁ h₂
    filter_upwards [h₁, h₂, L.analysis_coeff x, R.analysis_coeff x] with t ht₁ ht₂ hc₁ hc₂
    by_cases hAt : t ∈ A.1
    · rw [ht₁ hAt, hc₁, indicator_of_mem hAt]
    · rw [ht₂ hAt, hc₂, indicator_of_mem (show t ∈ A.1ᶜ from hAt)]
  · intro z
    have hp := hP (e z).1
    refine ⟨fun g => ⟨?_, ?_⟩, fun E => ?_⟩
    · simp only [map_smul, smul_eq_mul]
      change Measurable ((q z : Ω → ℝ) * fun t => g (F.vector t))
      exact (q z).stronglyMeasurable.measurable.mul (F.weaklyMeasurable g)
    · exact (hp.1 g).2.congr ((hnonzero z).mono fun t ht => congrArg g ht.symm)
    · obtain ⟨x, hx⟩ := hp.2 E
      refine ⟨x, fun g => (hx g).trans ?_⟩
      apply integral_congr_ae
      apply (ae_restrict_iff' E.2).mpr
      exact (hnonzero z).mono fun t ht _ => congrArg g ht.symm
  · intro z g
    change g (S (e z).1) = _
    rw [hS]
    apply integral_congr_ae
    filter_upwards [hnonzero z] with t ht
    simpa only [map_smul, smul_eq_mul] using (congrArg g ht).symm

#print axioms ContinuousSchauderFrame.exists_associated_of_complementary_pieces

end AssociatedGluing

noncomputable section AssociatedCoordinateTransport
open MeasureTheory

variable {Ω E : Type*} [MeasurableSpace Ω] [NormedAddCommGroup E] [NormedSpace ℝ E]
  {ρ η : Measure Ω}

/-- The weighted coordinates of the nonzero-vector component on the
original measure space, extended by zero off its support. -/
theorem KotheScalarSpace.exists_weightedCoordinates
    (S : KotheScalarSpace ρ E) (A : MeasSet Ω) (w : Ω → ℝ)
    (hwm : Measurable w) (hwp : ∀ t, 0 < w t)
    (h₁ : ρ ≪ η.restrict A.1) (h₂ : η.restrict A.1 ≪ ρ) :
    ∃ R : E →ₗ[ℝ] (Ω →ₘ[η] ℝ), Function.Injective R ∧
      (∀ e : E, (fun t => R e t) =ᵐ[η] A.1.indicator (fun t => w t * S.repr e t)) ∧
      (fun t => R S.one t) =ᵐ[η] A.1.indicator w := by
  classical
  let coord (e : E) : Ω → ℝ := A.1.indicator (fun t => w t * S.repr e t)
  have hm (e : E) : AEStronglyMeasurable (coord e) η :=
    (aestronglyMeasurable_indicator_iff A.2).mpr
      (hwm.aestronglyMeasurable.mul (AEStronglyMeasurable.mono_ac h₂ (S.repr e).aestronglyMeasurable))
  let f (e : E) : Ω →ₘ[η] ℝ := AEEqFun.mk (coord e) (hm e)
  have hf (e : E) : (fun t => f e t) =ᵐ[η] coord e := AEEqFun.coeFn_mk _ _
  have ha (x y : E) : f (x + y) = f x + f y := by
    apply AEEqFun.ext
    refine (hf _).trans ?_
    refine EventuallyEq.trans ?_ (AEEqFun.coeFn_add (f x) (f y)).symm
    have he := ae_restrict_iff' A.2 |>.mp
      (h₂.ae_le (show ∀ᵐ t ∂ρ, S.repr (x + y) t = S.repr x t + S.repr y t from by
        rw [map_add]; exact AEEqFun.coeFn_add _ _))
    filter_upwards [hf x, hf y, he] with t hx hy ht
    change coord (x + y) t = f x t + f y t
    rw [hx, hy]
    by_cases hmem : t ∈ A.1
    · simp only [coord, indicator_of_mem hmem, ht hmem, mul_add]
    · simp only [coord, indicator_of_notMem hmem, add_zero]
  have hs (c : ℝ) (x : E) : f (c • x) = c • f x := by
    apply AEEqFun.ext
    refine (hf _).trans ?_
    refine EventuallyEq.trans ?_ (AEEqFun.coeFn_smul c (f x)).symm
    have he := ae_restrict_iff' A.2 |>.mp
      (h₂.ae_le (show ∀ᵐ t ∂ρ, S.repr (c • x) t = c * S.repr x t from by
        rw [map_smul]; exact AEEqFun.coeFn_smul _ _))
    filter_upwards [hf x, he] with t hx ht
    change coord (c • x) t = c * f x t
    rw [hx]
    by_cases hmem : t ∈ A.1
    · simp only [coord, indicator_of_mem hmem, ht hmem, mul_left_comm]
    · simp only [coord, indicator_of_notMem hmem, mul_zero]
  let R : E →ₗ[ℝ] (Ω →ₘ[η] ℝ) := ⟨⟨f, ha⟩, hs⟩
  refine ⟨R, ?_, hf, ?_⟩
  · intro x y hxy
    apply S.injective
    apply AEEqFun.ext
    have he : coord x =ᵐ[η] coord y :=
      (hf x).symm.trans ((EventuallyEq.of_eq (congrArg (fun q : Ω →ₘ[η] ℝ => (q : Ω → ℝ))
        (show f x = f y from hxy))).trans (hf y))
    have hmem : ∀ᵐ t ∂(η.restrict A.1), t ∈ A.1 := ae_restrict_mem A.2
    apply h₁.ae_le
    filter_upwards [(ae_restrict_iff' A.2).mpr (he.mono fun _ ht _ => ht), hmem] with t ht hAt
    dsimp [coord] at ht
    rw [indicator_of_mem hAt, indicator_of_mem hAt] at ht
    exact (mul_left_cancel₀ (hwp t).ne' ht)
  · refine (hf _).trans ?_
    have he := ae_restrict_iff' A.2 |>.mp
      (h₂.ae_le (show ∀ᵐ t ∂ρ, S.repr S.one t = 1 from by
        rw [S.repr_one]; exact AEEqFun.coeFn_one))
    filter_upwards [he] with t ht
    by_cases hmem : t ∈ A.1
    · simp only [coord, indicator_of_mem hmem, ht hmem, mul_one]
    · simp only [coord, indicator_of_notMem hmem]

/-- Solidity is preserved by the positive change of coordinates and
extension by zero. -/
theorem KotheScalarSpace.solid_weightedCoordinates
    (S : KotheScalarSpace ρ E) (A : MeasSet Ω) (w : Ω → ℝ)
    (hwm : Measurable w) (hwp : ∀ t, 0 < w t)
    (h₁ : ρ ≪ η.restrict A.1) (h₂ : η.restrict A.1 ≪ ρ)
    (R : E →ₗ[ℝ] (Ω →ₘ[η] ℝ))
    (hR : ∀ e : E, (fun t => R e t) =ᵐ[η] A.1.indicator (fun t => w t * S.repr e t))
    (e : E) (h : Ω →ₘ[η] ℝ) (hdom : ∀ᵐ t ∂η, |h t| ≤ |R e t|) :
    ∃ z, R z = h ∧ ‖z‖ ≤ ‖e‖ := by
  classical
  let q : Ω → ℝ := fun t => h t / w t
  have hq : AEStronglyMeasurable q ρ :=
    AEStronglyMeasurable.mono_ac
      (h₁.trans (Measure.absolutelyContinuous_of_le Measure.restrict_le_self))
      (h.stronglyMeasurable.measurable.div hwm).aestronglyMeasurable
  let k : Ω →ₘ[ρ] ℝ := AEEqFun.mk q hq
  have hk : (fun t => k t) =ᵐ[ρ] q := AEEqFun.coeFn_mk _ _
  have hlocal : ∀ᵐ t ∂(η.restrict A.1), |q t| ≤ |S.repr e t| := by
    apply (ae_restrict_iff' A.2).mpr
    filter_upwards [hdom, hR e] with t ht hRt hAt
    rw [hRt, indicator_of_mem hAt, abs_mul, abs_of_pos (hwp t)] at ht
    change |h t / w t| ≤ |S.repr e t|
    rw [abs_div, abs_of_pos (hwp t), div_le_iff₀ (hwp t), mul_comm]
    exact ht
  have hkdom : ∀ᵐ t ∂ρ, |k t| ≤ |S.repr e t| := by
    filter_upwards [hk, h₁.ae_le hlocal] with t ht hu
    exact ht.symm ▸ hu
  obtain ⟨z, hz, hnorm⟩ := S.solid e k hkdom
  refine ⟨z, AEEqFun.ext ?_, hnorm⟩
  apply (hR z).trans
  have heq : ∀ᵐ t ∂η, t ∈ A.1 → S.repr z t = q t :=
    (ae_restrict_iff' A.2).mp (h₂.ae_le (by rwa [hz]))
  filter_upwards [heq, hdom, hR e] with t ht hdt hRt
  by_cases hAt : t ∈ A.1
  · rw [indicator_of_mem hAt, ht hAt]
    exact mul_div_cancel₀ (h t) (hwp t).ne'
  · rw [hRt, indicator_of_notMem hAt, abs_zero] at hdt
    rw [indicator_of_notMem hAt]
    exact (abs_eq_zero.mp (le_antisymm hdt (abs_nonneg _))).symm

#print axioms KotheScalarSpace.exists_weightedCoordinates
#print axioms KotheScalarSpace.solid_weightedCoordinates

end AssociatedCoordinateTransport



noncomputable section AssociatedLeft

open MeasureTheory

universe uΩ uX

variable {Ω : Type uΩ} {X : Type uX} [MeasurableSpace Ω]
  [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X] {η : Measure Ω}

/-- A representation of the nonzero-vector part in the scalar coordinates
of a cyclic dilation. Its integration identities use the original measure. -/
structure FrameLeftKotheDilation (F : ContinuousSchauderFrame (X := X) η)
    (A : MeasSet Ω) (w : Ω → ℝ) extends KotheDilationSpace F.operatorMeasure where
  control_le : ρ ≪ η.restrict A.1
  control_ge : η.restrict A.1 ≪ ρ
  analysis_repr : letI := normedGroup; letI := normedScalar;
    ∀ x, (fun t => scalar.repr (dilation.T x) t) =ᵐ[ρ] (fun t => F.functional t x / w t)
  integral_cut : letI := normedGroup; letI := normedScalar;
    ∀ y (g : Dual X), Integrable (fun t => scalar.repr y t * g (w t • F.vector t)) η ∧
      ∀ E : MeasSet Ω, g (dilation.S (dilation.P.val E y)) =
        ∫ t in E.1, scalar.repr y t * g (w t • F.vector t) ∂η

/-- The nonzero component has the expected coefficients and cutwise
Pettis synthesis after multiplication by the positive weight. -/
theorem FrameLeftKotheDilation.exists_coefficientPiece
    {F : ContinuousSchauderFrame (X := X) η} {A : MeasSet Ω} {w : Ω → ℝ}
    (D : FrameLeftKotheDilation F A w) (hwm : Measurable w) (hwp : ∀ t, 0 < w t)
    (hzero : ∀ t, t ∉ A.1 → F.vector t = 0) :
    let := D.normedGroup; letI := D.normedScalar;
    ∃ P : FrameCoefficientPiece F A D.carrier,
      P.analysis = D.dilation.T ∧
      (∀ y, PettisIntegrable η (fun t => P.repr y t • F.vector t)) ∧
      (∀ y (g : Dual X) (E : MeasSet Ω), g (D.dilation.S (D.dilation.P.val E y)) =
        ∫ t in E.1, P.repr y t * g (F.vector t) ∂η) ∧
      (∀ E y, (fun t => P.repr (D.dilation.P.val E y) t) =ᵐ[η]
        E.1.indicator (P.repr y)) ∧ CoordinateOrderContinuous P.repr ∧
      (KotheKB D.scalar → CoordinateKB P.repr) ∧
      (fun t => P.repr P.one t) =ᵐ[η] A.1.indicator w := by
  classical
  let := D.normedGroup
  let := D.normedScalar
  obtain ⟨R, hi, hR, hone⟩ := D.scalar.exists_weightedCoordinates
    A w hwm hwp D.control_le D.control_ge
  have hsupp y : ∀ᵐ t ∂η, t ∉ A.1 → R y t = 0 := by
    filter_upwards [hR y] with t ht hAt
    exact ht.trans (indicator_of_notMem hAt _)
  have hpositive : ∀ᵐ t ∂η, t ∈ A.1 → 0 < R D.scalar.one t := by
    filter_upwards [hone] with t ht hAt
    simpa only [ht, indicator_of_mem hAt] using hwp t
  have hT (x : X) : (fun t => R (D.dilation.T x) t) =ᵐ[η]
      A.1.indicator (fun t => F.functional t x) := by
    have h := (ae_restrict_iff' A.2).mp (D.control_ge.ae_le (D.analysis_repr x))
    filter_upwards [hR (D.dilation.T x), h] with t ht hu
    rw [ht]
    by_cases hAt : t ∈ A.1
    · rw [indicator_of_mem hAt, indicator_of_mem hAt, hu hAt]
      exact mul_div_cancel₀ _ (hwp t).ne'
    · rw [indicator_of_notMem hAt, indicator_of_notMem hAt]
  let P : FrameCoefficientPiece F A D.carrier :=
    ⟨R, hi, D.scalar.solid_weightedCoordinates A w hwm hwp D.control_le D.control_ge R hR,
      hsupp, D.scalar.one, hpositive, D.dilation.T, hT⟩
  have hscalar (y : D.carrier) (g : Dual X) :
      (fun t => D.scalar.repr y t * g (w t • F.vector t)) =ᵐ[η]
        fun t => R y t * g (F.vector t) := by
    filter_upwards [hR y] with t ht
    by_cases hAt : t ∈ A.1
    · rw [ht, indicator_of_mem hAt, map_smul, smul_eq_mul]
      ring
    · simp [hzero t hAt]
  have heval (y : D.carrier) (g : Dual X) (E : MeasSet Ω) :
      g (D.dilation.S (D.dilation.P.val E y)) = ∫ t in E.1, R y t * g (F.vector t) ∂η := by
    rw [(D.integral_cut y g).2 E]
    apply integral_congr_ae
    exact (ae_restrict_iff' E.2).mpr ((hscalar y g).mono fun _ ht _ => ht)
  have hRρ y : (fun t => R y t) =ᵐ[D.ρ] fun t => w t * D.scalar.repr y t := by
    apply D.control_le.ae_le
    apply (ae_restrict_iff' A.2).mpr
    filter_upwards [hR y] with t ht hAt
    exact ht.trans (indicator_of_mem hAt _)
  have hρ : D.ρ ≪ η := D.control_le.trans (Measure.absolutelyContinuous_of_le Measure.restrict_le_self)
  have hpos₀ (y) (hy : ∀ᵐ t ∂η, 0 ≤ R y t) : ∀ᵐ t ∂D.ρ, 0 ≤ D.scalar.repr y t := by
    filter_upwards [hρ.ae_le hy, hRρ y] with t ht hu
    rw [hu] at ht
    exact nonneg_of_mul_nonneg_right ht (hwp t)
  have hle₀ (x y) (hxy : ∀ᵐ t ∂η, R x t ≤ R y t) :
      ∀ᵐ t ∂D.ρ, D.scalar.repr x t ≤ D.scalar.repr y t := by
    filter_upwards [hρ.ae_le hxy, hRρ x, hRρ y] with t ht hx hy
    rw [hx, hy] at ht
    exact le_of_mul_le_mul_left ht (hwp t)
  refine ⟨P, rfl, ?_, heval, ?_, ?_, ?_, hone⟩
  · intro y
    refine ⟨fun g => ⟨?_, ?_⟩, fun E => ⟨D.dilation.S (D.dilation.P.val E y), fun g => ?_⟩⟩
    · simp only [map_smul, smul_eq_mul]
      change Measurable ((R y : Ω → ℝ) * fun t => g (F.vector t))
      exact (R y).stronglyMeasurable.measurable.mul (F.weaklyMeasurable g)
    · simpa only [map_smul, smul_eq_mul] using ((D.integral_cut y g).1.congr (hscalar y g))
    · simpa only [map_smul, smul_eq_mul] using heval y g E
  · intro E y
    change (fun t => R (D.dilation.P.val E y) t) =ᵐ[η] E.1.indicator (R y)
    have hc := (ae_restrict_iff' A.2).mp (D.control_ge.ae_le (D.cut_repr E y))
    filter_upwards [hR (D.dilation.P.val E y), hR y, hc] with t hpt hyt ht
    by_cases hAt : t ∈ A.1 <;> by_cases hEt : t ∈ E.1 <;> simp [hpt, hyt, hAt, hEt, ht]

  · intro x hpos hmono hlim
    apply D.scalar.order_continuous x (fun n => hpos₀ (x n) (hpos n))
      (fun i j hij => hle₀ (x j) (x i) (hmono i j hij))
    filter_upwards [hρ.ae_le hlim, ae_all_iff.mpr fun n => hRρ (x n)] with t ht hh
    have h := ht.const_mul (w t)⁻¹
    apply (show Tendsto (fun n => (w t)⁻¹ * R (x n) t) atTop (𝓝 0) from by simpa using h).congr'
    exact Eventually.of_forall fun n => by
      change (w t)⁻¹ * R (x n) t = D.scalar.repr (x n) t
      rw [hh n, ← mul_assoc, inv_mul_cancel₀ (hwp t).ne', one_mul]
  · intro hKB x hpos hmono hb
    exact hKB x (fun n => hpos₀ (x n) (hpos n))
      (fun i j hij => hle₀ (x i) (x j) (hmono i j hij)) hb

#print axioms FrameLeftKotheDilation.exists_coefficientPiece

end AssociatedLeft


noncomputable section AssociatedDensityBase

open MeasureTheory

universe uΩ uX

variable {Ω : Type uΩ} {X : Type uX} [MeasurableSpace Ω]
  [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X] {η : Measure Ω}

/-- Scalar coordinates and the integration formula of the usual L¹(m)
model when m has a Bochner density with respect to η. -/
structure VectorDensityL1Coordinates (v : Ω → X) (m : MeasSet Ω → X) where
  base : VectorDensityL1Realization η v m
  ρ : Measure Ω
  finite : IsFiniteMeasure ρ
  null_iff : ∀ E : MeasSet Ω, ρ E.1 = 0 ↔
    ∀ D : MeasSet Ω, D.1 ⊆ E.1 → m D = 0
  scalar : letI := base.model.normedGroup; letI := base.model.normedScalar;
    KotheScalarSpace ρ base.model.carrier
  cut_repr : letI := base.model.normedGroup; letI := base.model.normedScalar;
    ∀ E y, (fun t => scalar.repr (base.model.data.multiplication.val E y) t) =ᵐ[ρ]
      E.1.indicator (scalar.repr y)
  repr_of_representative : letI := base.model.normedGroup; letI := base.model.normedScalar;
    ∀ f : vectorDensityFunctions η v, (fun t => scalar.repr (base.represent f) t) =ᵐ[ρ] f.1
  integral_cut : letI := base.model.normedGroup; letI := base.model.normedScalar;
    ∀ y (g : Dual X), Integrable (fun t => scalar.repr y t * g (v t)) η ∧
      ∀ E, g (base.model.data.integration (base.model.data.multiplication.val E y)) =
        ∫ t in E.1, scalar.repr y t * g (v t) ∂η

/-- Standard L¹(m) over a Rybakov control measure, with its measurable
representatives, multiplication and scalar evaluation of the vector
integral. The scalar measure g m has the Bochner scalar density g ∘ v.
See Diestel–Uhl, Vector Measures, and Okada–Ricker–Sánchez Pérez (2014),
Sections 2–3. -/
axiom citeVectorDensityL1Coordinates (v : Ω → X) (hv : Integrable v η)
    (m : MeasSet Ω → X) (hm : ∀ E, m E = ∫ t in E.1, v t ∂η)
    (h₀ : m MeasSet.empty = 0)
    (hσ : ∀ E : ℕ → MeasSet Ω, MeasSet.DisjointSeq E →
      HasSum (fun n => m (E n)) (m (MeasSet.iUnion E))) :
    ∃ C : VectorDensityL1Coordinates (η := η) v m, C.base.model = standardVectorMeasureL1 m h₀ hσ

/-- The weighted vector-measure L¹ model on the nonzero frame vectors,
with the original measure class and coefficient fields tracked. -/
theorem ContinuousSchauderFrame.exists_weighted_left_base
    [TopologicalSpace.SeparableSpace X] [SigmaFinite η]
    (F : ContinuousSchauderFrame (X := X) η) :
    ∃ (A : MeasSet Ω) (w : Ω → ℝ) (D : FrameLeftKotheDilation F A w),
      A.1 = {t | F.vector t ≠ 0} ∧ Measurable w ∧ (∀ t, 0 < w t) ∧
      letI := D.normedGroup; letI := D.normedScalar;
      letI := D.complete;
      D.dilation.P.CyclicVector D.scalar.one ∧ (∀ E, ‖D.dilation.P.val E‖ ≤ 1) ∧
      IsFiniteMeasure D.ρ ∧ (¬ ContainsCopy CZero X → WeaklySeqComplete D.carrier) := by
  classical
  obtain ⟨w, m, hwm, hwp, hv, _, hm, h₀, hσ, _⟩ := F.exists_weighted_vectorMeasure
  obtain ⟨C, hmodel⟩ := citeVectorDensityL1Coordinates _ hv m hm h₀ hσ
  let M := C.base.model
  let := M.normedGroup
  let := M.normedScalar
  let := M.isComplete
  let P := M.data.multiplication
  let S := M.data.integration
  obtain ⟨T, hT, _, hEval⟩ := F.exists_weighted_analysis_map w hwm hwp C.base
  have hcompress E : S.comp ((P.val E).comp T) = F.operatorMeasure.val E := by
    ext x
    apply eq_of_dual_eval
    intro g
    change g (S (P.val E (T x))) = g (F.operatorMeasure.val E x)
    rw [hEval, F.operatorMeasure_coeff]
  let D : Dilation F.operatorMeasure M.carrier :=
    { P := P
      S := S
      T := T
      compress := hcompress
      split := by
        have hc := hcompress MeasSet.whole
        have hp : P.val MeasSet.whole = ContinuousLinearMap.id ℝ M.carrier := P.normalized
        have hf : F.operatorMeasure.val MeasSet.whole = ContinuousLinearMap.id ℝ X := F.operatorMeasure_normalized
        rwa [hp, ContinuousLinearMap.id_comp, hf] at hc }
  have hcv : P.CyclicVector C.scalar.one := citeKotheSimpleDensity C.scalar
    (fun E => P.val E C.scalar.one) (fun E => by
      refine (C.cut_repr E C.scalar.one).trans ?_
      have h : (fun t => C.scalar.repr C.scalar.one t) =ᵐ[C.ρ] fun _ => 1 := by
        rw [C.scalar.repr_one]
        exact AEEqFun.coeFn_one
      filter_upwards [h] with t ht
      by_cases hE : t ∈ E.1 <;> simp [hE, ht])
  have hsm := citePettisMeasurability F.vector F.weaklyMeasurable
  let A : MeasSet Ω := ⟨{t | F.vector t ≠ 0}, (hsm.measurableSet_eq_fun stronglyMeasurable_const).compl⟩
  let ν := η.restrict A.1
  have hac₁ : C.ρ ≪ ν := by
    apply Measure.AbsolutelyContinuous.mk
    intro E hE hEν
    apply (C.null_iff ⟨E, hE⟩).mpr
    intro B hB
    have hz : (η.restrict B.1) A.1 = 0 := by
      rw [Measure.restrict_apply A.2]
      rw [Measure.restrict_apply hE] at hEν
      have hsub : A.1 ∩ B.1 ⊆ E ∩ A.1 := fun _ ht => ⟨hB ht.2, ht.1⟩
      exact measure_mono_null hsub hEν
    have he : (fun t => w t • F.vector t) =ᵐ[η.restrict B.1] fun _ => (0 : X) := by
      have hn : ∀ᵐ t ∂η.restrict B.1, t ∉ A.1 := by
        rw [ae_iff, show {t | ¬ t ∉ A.1} = A.1 from Set.ext fun _ => not_not]
        exact hz
      filter_upwards [hn] with t ht
      have hvzero : F.vector t = 0 := by simpa [A] using ht
      simp [hvzero]
    rw [hm B, integral_congr_ae he, integral_zero]
  have hac₂ : ν ≪ C.ρ := by
    apply Measure.AbsolutelyContinuous.mk
    intro E hE hEρ
    rw [Measure.restrict_apply hE]
    let B : MeasSet Ω := ⟨E ∩ A.1, hE.inter A.2⟩
    apply (F.weightedVectorMeasure_null_iff_on_nonzero w hwp hv m hm B
      (fun _ ht => ht.2)).mp
    exact (C.null_iff B).mp (measure_mono_null inter_subset_left hEρ)
  let K : KotheDilationSpace F.operatorMeasure :=
    ⟨⟨M.carrier, M.normedGroup, M.normedScalar, M.isComplete, D⟩, C.ρ, C.scalar, C.cut_repr⟩
  let B : FrameLeftKotheDilation F A w := ⟨K, hac₁, hac₂, ?_, C.integral_cut⟩
  · refine ⟨A, w, B, rfl, hwm, hwp, hcv, M.data.norm_multiplication_le_one, C.finite, fun hx => ?_⟩
    let no_cZero (M₀ : VectorMeasureL1Model m) : Prop :=
      letI := M₀.normedGroup; letI := M₀.normedScalar; ¬ ContainsCopy CZero M₀.carrier
    have hnc₀ : no_cZero (standardVectorMeasureL1 m h₀ hσ) := citeOkadaRickerSanchezPerez2014 m h₀ hσ hx
    have hnc : no_cZero C.base.model := hmodel.symm ▸ hnc₀
    exact P.weaklySeqComplete_of_boundedlyComplete (P.localizes_of_cyclic ⟨_, hcv⟩)
      (P.boundedlyComplete_of_not_contains_cZero hnc)
  · intro x
    rw [show D.T x = T x from rfl, hT]
    exact C.repr_of_representative _

#print axioms ContinuousSchauderFrame.exists_weighted_left_base

end AssociatedDensityBase


noncomputable section AssociatedInterpolation

open MeasureTheory

universe uΩ uX

variable {Ω : Type uΩ} {X : Type uX} [MeasurableSpace Ω]
  [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X] {η : Measure Ω}

/-- Interpolate inside the weighted L¹ space, preserving its original
scalar coordinates and the cutwise integral of every vector. -/
theorem FrameLeftKotheDilation.exists_interpolated
    {F : ContinuousSchauderFrame (X := X) η} {A : MeasSet Ω} {w : Ω → ℝ}
    (B : FrameLeftKotheDilation F A w)
    (hcyclic : letI := B.normedGroup; letI := B.normedScalar; B.dilation.P.CyclicVector B.scalar.one)
    (hQ : letI := B.normedGroup; letI := B.normedScalar; ∀ E, ‖B.dilation.P.val E‖ ≤ 1)
    (hfinite : IsFiniteMeasure B.ρ)
    (hWSC : letI := B.normedGroup; letI := B.normedScalar;
      ¬ ContainsCopy CZero X → WeaklySeqComplete B.carrier)
    (hX : ¬ ContainsCopy LOne X) :
    ∃ B' : FrameLeftKotheDilation F A w, letI := B'.normedGroup; letI := B'.normedScalar;
      B'.dilation.P.CyclicVector B'.scalar.one ∧ (¬ ContainsCopy LOne B'.carrier) ∧
        (IsReflexive X → IsReflexive B'.carrier) := by
  let := B.normedGroup
  let := B.normedScalar
  let := B.complete
  let := hfinite
  let : TopologicalSpace Ω := ⊥
  let : TopologicalSpace Ω := ⊥
  let : TopologicalSpace Ω := ⊥
  let : TopologicalSpace Ω := ⊥
  let : TopologicalSpace Ω := ⊥
  let P := B.dilation.P
  let u := B.scalar.one
  have hu1 : B.scalar.repr u = 1 := B.scalar.repr_one
  have hsum (y : B.carrier) : ‖∫ t, B.scalar.repr y t ∂B.ρ‖ ≤ B.scalar.l1Bound * ‖y‖ :=
    (norm_integral_le_integral_norm _).trans (by simpa only [Real.norm_eq_abs] using (B.scalar.l1 y).2)
  let ell₀ : B.carrier →ₗ[ℝ] ℝ :=
    { toFun := fun y => ∫ t, B.scalar.repr y t ∂B.ρ
      map_add' := by
        intro y z
        rw [map_add]
        rw [integral_congr_ae (AEEqFun.coeFn_add _ _)]
        exact integral_add (B.scalar.l1 y).1 (B.scalar.l1 z).1
      map_smul' := by
        intro c y
        change (∫ t, B.scalar.repr (c • y) t ∂B.ρ) = c • (∫ t, B.scalar.repr y t ∂B.ρ)
        rw [map_smul, integral_congr_ae (AEEqFun.coeFn_smul _ _)]
        exact integral_smul c _ }
  let ell := ell₀.mkContinuous _ hsum
  have hcutInt (y : B.carrier) (E : MeasSet Ω) :
      ell (P.val E y) = ∫ t in E.1, B.scalar.repr y t ∂B.ρ := by
    change (∫ t, B.scalar.repr (P.val E y) t ∂B.ρ) = _
    rw [integral_congr_ae (B.cut_repr E y), integral_indicator E.2]
  have hmul (a : boundedMeasurableAlgebra Ω) (y : B.carrier) :
      (fun t => B.scalar.repr (P.boundedMeasurableRepresentation a y) t) =ᵐ[B.ρ]
        fun t => a.1 t * B.scalar.repr y t := by
    apply ae_eq_from_cut_integrals B.ρ (B.scalar.l1 _).1
      ((B.scalar.l1 y).1.bdd_mul (c := ‖a.1‖) a.2.aestronglyMeasurable
        (Eventually.of_forall fun t => BoundedContinuousFunction.norm_coe_le_norm a.1 t))
    intro E
    rw [← hcutInt]
    exact P.boundedMeasurableMultiplier_cut a y ell B.ρ _ (B.scalar.l1 y).1 (hcutInt y) E
  let K := B.dilation.T '' Metric.closedBall (0 : X) 1 ∪ {u}
  let W := P.multiplierHull K
  have huW : u ∈ W := P.subset_multiplierHull K (Or.inr rfl)
  have h₀ : 0 ∈ W := P.subset_multiplierHull K
    (Or.inl ⟨0, mem_closedBall_zero_iff.mpr (by simp), map_zero B.dilation.T⟩)
  have hK := weaklyPrecompact_image_unitBall_union_singleton B.dilation.T u hX
  have hW := P.multiplierHull_weaklyPrecompact ⟨u, hcyclic⟩ K hK
  obtain ⟨M⟩ := citeDFJPInterpolation W h₀ (convex_convexHull ℝ _).closure
    (P.multiplierHull_balanced K) isClosed_closure hW.1
  let := M.normedGroup
  let := M.normedScalar
  have hsolid (y : B.carrier) (hy : y ∈ W) (x : B.carrier)
      (hd : ∀ᵐ t ∂B.ρ, |B.scalar.repr x t| ≤ |B.scalar.repr y t|) : x ∈ W := by
    obtain ⟨a, ha, he⟩ := exists_boundedMultiplier_of_ae_domination B.ρ
      (B.scalar.repr x) (B.scalar.repr y) (B.scalar.repr x).stronglyMeasurable.measurable
      (B.scalar.repr y).stronglyMeasurable.measurable hd
    have heq := B.scalar.injective (AEEqFun.ext ((hmul a y).trans he.symm))
    exact heq ▸ P.maps_multiplierHull K a ha hy
  obtain ⟨S, hS⟩ := citeLatticeDFJPKothe B.scalar M hsolid ⟨u, huW, hu1⟩
  let Q := M.liftPVM P hQ (P.cut_maps_multiplierHull K)
  have hJ := M.inclusion_liftPVM P hQ (P.cut_maps_multiplierHull K)
  have hcut (E : MeasSet Ω) (x : M.carrier) :
      (fun t => S.repr (Q.val E x) t) =ᵐ[B.ρ] E.1.indicator (S.repr x) := by
    rw [hS, hS, show M.inclusion (Q.val E x) = P.val E (M.inclusion x) from DFunLike.congr_fun (hJ E) x]
    exact B.cut_repr E (M.inclusion x)
  obtain ⟨D, hDP, hDS, hDT, _⟩ := B.dilation.exists_lifted_analysis Q M.inclusion M.injective hJ
    (fun x hx => M.unit_contains _ (P.subset_multiplierHull K (Or.inl ⟨_, mem_closedBall_zero_iff.mpr hx, rfl⟩)))
  have hcutD : ∀ E x, (fun t => S.repr (D.P.val E x) t) =ᵐ[B.ρ] E.1.indicator (S.repr x) :=
    hDP ▸ hcut
  have hcv : D.P.CyclicVector S.one := citeKotheSimpleDensity S (fun E => D.P.val E S.one)
    (fun E => by
      have hc := hcutD E S.one
      rw [S.repr_one] at hc
      refine hc.trans ?_
      filter_upwards [show ((1 : Ω →ₘ[B.ρ] ℝ) : Ω → ℝ) =ᵐ[B.ρ] 1 from AEEqFun.coeFn_one] with t ht
      by_cases he : t ∈ E.1 <;> simp [he, ht])
  let BC : KotheDilationSpace F.operatorMeasure :=
    ⟨⟨M.carrier, M.normedGroup, M.normedScalar, M.complete, D⟩, B.ρ, S, hcutD⟩
  let B' : FrameLeftKotheDilation F A w := ⟨BC, B.control_le, B.control_ge, ?_, ?_⟩
  · refine ⟨B', hcv, M.no_lOne hW, fun hr => ?_⟩
    exact M.reflexive (P.multiplierHull_weaklyCompact ⟨u, hcyclic⟩ K hK
      (P.boundedlyComplete_of_weaklySeqComplete (hWSC hr.excludes_lOne_and_cZero.2)))
  · intro x
    change (fun t => S.repr (D.T x) t) =ᵐ[B.ρ] fun t => F.functional t x / w t
    rw [hS, show M.inclusion (D.T x) = B.dilation.T x from DFunLike.congr_fun hDT x]
    exact B.analysis_repr x
  · intro y g
    change Integrable (fun t => S.repr y t * g (w t • F.vector t)) η ∧
      ∀ E, g (D.S (D.P.val E y)) = ∫ t in E.1, S.repr y t * g (w t • F.vector t) ∂η
    rw [hS]
    refine ⟨(B.integral_cut (M.inclusion y) g).1, fun E => ?_⟩
    rw [hDS, hDP, ContinuousLinearMap.comp_apply]
    rw [show M.inclusion (Q.val E y) = P.val E (M.inclusion y) from DFunLike.congr_fun (hJ E) y]
    exact (B.integral_cut (M.inclusion y) g).2 E

#print axioms FrameLeftKotheDilation.exists_interpolated

end AssociatedInterpolation

noncomputable section AssociatedZeroMeasure
open MeasureTheory
open scoped ENNReal NNReal

variable {Ω : Type*} [MeasurableSpace Ω] {η : Measure Ω}

/-- Weighting a restricted measure by a positive integrable density
keeps its null sets and makes the prescribed function square-integrable. -/
theorem exists_finite_weighted_restriction (B : MeasSet Ω)
    (a g : Ω → ℝ) (ha : Measurable a) (hg : Measurable g)
    (ha_pos : ∀ t, 0 < a t)
    (hi : Integrable (fun t => a t * (1 + g t ^ 2)) η) :
    let ρ := (η.restrict B.1).withDensity (fun t => ENNReal.ofReal (a t))
    IsFiniteMeasure ρ ∧ ρ ≪ η.restrict B.1 ∧ η.restrict B.1 ≪ ρ ∧ MemLp g 2 ρ := by
  let ν := η.restrict B.1
  let ρ := ν.withDensity (fun t => ENNReal.ofReal (a t))
  change IsFiniteMeasure ρ ∧ ρ ≪ ν ∧ ν ≪ ρ ∧ MemLp g 2 ρ
  have haI : Integrable a ν := hi.restrict.mono' ha.aestronglyMeasurable
    (Eventually.of_forall fun t => by
      rw [Real.norm_of_nonneg (ha_pos t).le]
      nlinarith [mul_nonneg (ha_pos t).le (sq_nonneg (g t))])
  have hgI : Integrable (fun t => a t * g t ^ 2) ν :=
    hi.restrict.mono' (ha.mul (hg.pow_const 2)).aestronglyMeasurable (Eventually.of_forall fun t => by
      rw [Real.norm_of_nonneg (mul_nonneg (ha_pos t).le (sq_nonneg (g t)))]
      nlinarith [ha_pos t])
  have hρ : IsFiniteMeasure ρ := by
    constructor
    change ν.withDensity (fun t => ENNReal.ofReal (a t)) univ < ∞
    rw [withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ]
    have h := haI.hasFiniteIntegral
    unfold HasFiniteIntegral at h
    simp_rw [← ofReal_norm, Real.norm_of_nonneg (ha_pos _).le] at h
    exact h
  have h₁ : ρ ≪ ν := withDensity_absolutelyContinuous _ _
  have h₂ : ν ≪ ρ := withDensity_absolutelyContinuous' ha.ennreal_ofReal.aemeasurable
    (Eventually.of_forall fun t => (ENNReal.ofReal_pos.mpr (ha_pos t)).ne')
  refine ⟨hρ, h₁, h₂, ?_⟩
  have hsq : Integrable (fun t => g t ^ 2) ρ := by
    have ht (t : Ω) : ((Real.toNNReal (a t) : ℝ≥0) : ℝ≥0∞) = ENNReal.ofReal (a t) := rfl
    change Integrable (fun t => g t ^ 2) (ν.withDensity fun t => ENNReal.ofReal (a t))
    simp_rw [← ht]
    apply (integrable_withDensity_iff_integrable_smul ha.real_toNNReal).mpr
    simpa only [NNReal.smul_def, smul_eq_mul, Real.coe_toNNReal _ (ha_pos _).le] using hgI
  apply (memLp_norm_rpow_iff hg.aestronglyMeasurable (p := (2 : ℝ≥0∞)) two_ne_zero ENNReal.ofNat_ne_top).mp
  rw [div_eq_mul_inv, ENNReal.mul_inv_cancel two_ne_zero ENNReal.ofNat_ne_top, memLp_one_iff_integrable]
  simpa using hsq

#print axioms exists_finite_weighted_restriction

end AssociatedZeroMeasure


noncomputable section AssociatedL2Order
open MeasureTheory
open scoped ENNReal

variable {Ω : Type*} [MeasurableSpace Ω] {ρ : Measure Ω}

private theorem associatedL2_sq_integrable (x : Lp ℝ 2 ρ) :
    Integrable (fun t => x t ^ 2) ρ := by
  have h := (Lp.memLp x).norm_rpow (by norm_num) (by norm_num)
  simpa [memLp_one_iff_integrable] using h

private theorem associatedL2_norm_sq (x : Lp ℝ 2 ρ) :
    ‖x‖ ^ 2 = ∫ t, x t ^ 2 ∂ρ := by
  rw [Lp.norm_def, ← ENNReal.toReal_pow, eLpNorm_eq_lintegral_rpow_eNorm_toReal
    (by norm_num) (by norm_num) (Lp.aestronglyMeasurable x), ← ENNReal.rpow_natCast,
    ← ENNReal.rpow_mul]
  simp only [ENNReal.toReal_ofNat, Nat.cast_ofNat, show (1 / 2 : ℝ) * 2 = 1 by norm_num, ENNReal.rpow_one]
  rw [integral_eq_lintegral_of_nonneg_ae (Eventually.of_forall fun t => sq_nonneg (x t))
    (associatedL2_sq_integrable x).aestronglyMeasurable]
  congr 1
  apply lintegral_congr
  intro t
  rw [← ofReal_norm, ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) (by norm_num)]
  simp

private theorem associatedL2_orderContinuous (x : ℕ → Lp ℝ 2 ρ)
    (hpos : ∀ n, ∀ᵐ t ∂ρ, 0 ≤ x n t)
    (hmono : ∀ i j, i ≤ j → ∀ᵐ t ∂ρ, x j t ≤ x i t)
    (hlim : ∀ᵐ t ∂ρ, Tendsto (fun n => x n t) atTop (𝓝 0)) :
    Tendsto (fun n => ‖x n‖) atTop (𝓝 0) := by
  have h := tendsto_integral_of_dominated_convergence (μ := ρ)
    (fun t => x 0 t ^ 2) (fun n => (associatedL2_sq_integrable (x n)).aestronglyMeasurable)
    (associatedL2_sq_integrable (x 0)) (fun n => by
      filter_upwards [hpos n, hmono 0 n (Nat.zero_le n)] with t ht hu
      rw [Real.norm_of_nonneg (sq_nonneg _)]
      gcongr) (f := fun _ => (0 : ℝ)) (by
      filter_upwards [hlim] with t ht
      simpa only [zero_pow (show (2 : ℕ) ≠ 0 by decide)] using ht.pow 2)
  rw [integral_zero] at h
  have hn (n : ℕ) : ‖x n‖ = Real.sqrt (∫ t, x n t ^ 2 ∂ρ) := by
    rw [← associatedL2_norm_sq, Real.sqrt_sq (norm_nonneg _)]
  simp_rw [hn]
  simpa only [Real.sqrt_zero] using h.sqrt

private theorem associatedL2_KB (x : ℕ → Lp ℝ 2 ρ)
    (hpos : ∀ n, ∀ᵐ t ∂ρ, 0 ≤ x n t)
    (hmono : ∀ i j, i ≤ j → ∀ᵐ t ∂ρ, x i t ≤ x j t)
    (hb : ∃ C : ℝ, ∀ n, ‖x n‖ ≤ C) :
    ∃ y, Tendsto x atTop (𝓝 y) := by
  let a (n : ℕ) := ‖x n‖ ^ 2
  obtain ⟨C, hC⟩ := hb
  have ha : Monotone a := by
    intro i j hij
    apply pow_le_pow_left₀ (norm_nonneg _) _ 2
    apply Lp.norm_le_norm_of_ae_le
    filter_upwards [hpos i, hpos j, hmono i j hij] with t hi hj ht
    simpa only [Real.norm_of_nonneg hi, Real.norm_of_nonneg hj] using ht
  have haC : BddAbove (range a) := ⟨C ^ 2, by
    rintro _ ⟨n, rfl⟩
    exact pow_le_pow_left₀ (norm_nonneg _) (hC n) 2⟩
  let M := ⨆ n, a n
  have hM : Tendsto a atTop (𝓝 M) := tendsto_atTop_ciSup ha haC
  have hdiff (i j : ℕ) (hij : i ≤ j) :
      ‖x j - x i‖ ^ 2 ≤ a j - a i := by
    change ‖x j - x i‖ ^ 2 ≤ ‖x j‖ ^ 2 - ‖x i‖ ^ 2
    rw [associatedL2_norm_sq, associatedL2_norm_sq, associatedL2_norm_sq,
      ← integral_sub (associatedL2_sq_integrable _) (associatedL2_sq_integrable _)]
    apply integral_mono_ae (associatedL2_sq_integrable _)
      ((associatedL2_sq_integrable _).sub (associatedL2_sq_integrable _))
    filter_upwards [Lp.coeFn_sub (x j) (x i), hpos i, hmono i j hij] with t ht hp hm
    rw [ht]
    change (x j t - x i t) ^ 2 ≤ x j t ^ 2 - x i t ^ 2
    nlinarith [mul_nonneg hp (sub_nonneg.mpr hm)]
  have hd (n m N : ℕ) (hn : N ≤ n) (hm : N ≤ m) : dist (x n) (x m) ≤ Real.sqrt (M - a N) := by
    suffices h : ∀ i j : ℕ, N ≤ i → i ≤ j → dist (x j) (x i) ≤ Real.sqrt (M - a N) by
      rcases le_total n m with hh | hh
      · rw [dist_comm]
        exact h n m hn hh
      · exact h m n hm hh
    intro i j hi hij
    rw [dist_eq_norm, Real.le_sqrt (norm_nonneg _) (sub_nonneg.mpr (le_ciSup haC N))]
    exact (hdiff i j hij).trans (sub_le_sub (le_ciSup haC j) (ha hi))
  have ht : Tendsto (fun n => Real.sqrt (M - a n)) atTop (𝓝 0) := by
    simpa only [sub_self, Real.sqrt_zero] using
      (tendsto_const_nhds.sub hM : Tendsto (fun n => M - a n) atTop (𝓝 (M - M))).sqrt
  exact cauchySeq_tendsto_of_complete (cauchySeq_of_le_tendsto_0 _ hd ht)

#print axioms associatedL2_orderContinuous
#print axioms associatedL2_KB

end AssociatedL2Order



noncomputable section AssociatedL2

open MeasureTheory
open scoped ENNReal

variable {Ω X : Type*} [MeasurableSpace Ω]
  [NormedAddCommGroup X] [NormedSpace ℝ X] {η : Measure Ω}

/-- The zero-vector piece is the actual L² space of an equivalent finite
weighted measure on that piece. Analysis is bounded by the L² norm of
the field's functional norms. -/
theorem ContinuousSchauderFrame.exists_L2_coefficientPiece
    (F : ContinuousSchauderFrame (X := X) η) (B : MeasSet Ω)
    (ρ : Measure Ω) [IsFiniteMeasure ρ]
    (h₁ : ρ ≪ η.restrict B.1) (h₂ : η.restrict B.1 ≪ ρ)
    (hn : MemLp (fun t => ‖F.functional t‖) 2 ρ) :
    ∃ R : FrameCoefficientPiece F B (Lp ℝ 2 ρ),
      CoordinateOrderContinuous R.repr ∧ CoordinateKB R.repr ∧
      (fun t => R.repr R.one t) =ᵐ[η] B.1.indicator (fun _ => 1) := by
  classical
  let L := Lp ℝ 2 ρ
  let C (y : L) : Ω → ℝ := B.1.indicator y
  have hC (y : L) : AEStronglyMeasurable (C y) η :=
    (aestronglyMeasurable_indicator_iff B.2).mpr
      (AEStronglyMeasurable.mono_ac h₂ (Lp.memLp y).aestronglyMeasurable)
  let q (y : L) : Ω →ₘ[η] ℝ := AEEqFun.mk (C y) (hC y)
  have hq (y : L) : (fun t => q y t) =ᵐ[η] C y := AEEqFun.coeFn_mk _ _
  have add_q (y z : L) : q (y + z) = q y + q z := by
    apply AEEqFun.ext
    refine (hq _).trans ?_
    have h := (ae_restrict_iff' B.2).mp (h₂.ae_le (Lp.coeFn_add y z))
    filter_upwards [hq y, hq z, AEEqFun.coeFn_add (q y) (q z), h] with t hy hz ht hs
    rw [ht, Pi.add_apply, hy, hz]
    by_cases hB : t ∈ B.1
    · simpa only [C, indicator_of_mem hB, Pi.add_apply, Pi.smul_apply, smul_eq_mul] using hs hB
    · simp only [C, indicator_of_notMem hB, add_zero]
  have smul_q (c : ℝ) (y : L) : q (c • y) = c • q y := by
    apply AEEqFun.ext
    refine (hq _).trans ?_
    have h := (ae_restrict_iff' B.2).mp (h₂.ae_le (Lp.coeFn_smul c y))
    filter_upwards [hq y, AEEqFun.coeFn_smul c (q y), h] with t hy ht hs
    rw [ht, Pi.smul_apply, smul_eq_mul, hy]
    by_cases hB : t ∈ B.1
    · simpa only [C, indicator_of_mem hB, Pi.add_apply, Pi.smul_apply, smul_eq_mul] using hs hB
    · simp only [C, indicator_of_notMem hB, mul_zero]
  let Q : L →ₗ[ℝ] (Ω →ₘ[η] ℝ) := ⟨⟨q, add_q⟩, smul_q⟩
  have q_restrict (y : L) : (fun t => q y t) =ᵐ[ρ] y := by
    have he := (ae_restrict_iff' B.2).mpr ((hq y).mono fun t ht hB =>
      ht.trans (indicator_of_mem hB _))
    exact h₁.ae_le he
  have hinj : Function.Injective Q := by
    intro y z hyz
    apply Lp.ext
    exact (q_restrict y).symm.trans
      ((show (fun t => q y t) =ᵐ[ρ] fun t => q z t from by
        rw [show q y = q z from hyz]).trans (q_restrict z))
  have hdom (y : L) (f : Ω →ₘ[η] ℝ) (h : ∀ᵐ t ∂η, |f t| ≤ |q y t|) :
      ∃ z : L, q z = f ∧ ‖z‖ ≤ ‖y‖ := by
    have hac : ρ ≪ η := h₁.trans (Measure.absolutelyContinuous_of_le Measure.restrict_le_self)
    have hly : ∀ᵐ t ∂ρ, ‖f t‖ ≤ ‖y t‖ := by
      filter_upwards [hac.ae_le h, q_restrict y] with t ht hyt
      simpa only [Real.norm_eq_abs, hyt] using ht
    have hf : MemLp (fun t => f t) 2 ρ := (Lp.memLp y).of_le
      (AEStronglyMeasurable.mono_ac hac f.aestronglyMeasurable) hly
    let z := hf.toLp fun t => f t
    refine ⟨z, AEEqFun.ext ?_, Lp.norm_le_norm_of_ae_le ?_⟩
    · have hz := (ae_restrict_iff' B.2).mp (h₂.ae_le hf.coeFn_toLp)
      filter_upwards [hq z, hq y, h, hz] with t hqz hqy ht hzt
      by_cases hB : t ∈ B.1
      · simpa only [hqz, C, indicator_of_mem hB] using hzt hB
      · rw [hqy] at ht
        change |f t| ≤ |B.1.indicator (fun s => y s) t| at ht
        rw [indicator_of_notMem hB, abs_zero] at ht
        rw [hqz]
        change B.1.indicator (fun s => z s) t = f t
        rw [indicator_of_notMem hB]
        exact (abs_eq_zero.mp (le_antisymm ht (abs_nonneg _))).symm
    · have hzt : (fun t => z t) =ᵐ[ρ] fun t => f t := hf.coeFn_toLp
      filter_upwards [hly, hzt] with t ht hzt
      simpa only [hzt] using ht
  let A (x : X) := fun t => F.functional t x
  have hA (x : X) : MemLp (A x) 2 ρ :=
    hn.of_le_mul (F.weakStarMeasurable x).aestronglyMeasurable
      (Eventually.of_forall fun t => by simpa only [norm_norm, mul_comm] using (F.functional t).le_opNorm x)
  let T (x : X) := (hA x).toLp (A x)
  have hT (x : X) : (fun t => T x t) =ᵐ[ρ] A x := (hA x).coeFn_toLp
  let T₀ : X →ₗ[ℝ] L :=
    { toFun := T
      map_add' := fun x y => by
        apply Lp.ext
        filter_upwards [hT (x + y), hT x, hT y, Lp.coeFn_add (T x) (T y)] with t hxy hx hy ht
        rw [hxy, ht]
        change F.functional t (x + y) = T x t + T y t
        rw [hx, hy, map_add]
      map_smul' := fun c x => by
        apply Lp.ext
        filter_upwards [hT (c • x), hT x, Lp.coeFn_smul c (T x)] with t hcx hx ht
        change T (c • x) t = (c • T x) t
        rw [hcx, ht, Pi.smul_apply, smul_eq_mul]
        change F.functional t (c • x) = c • T x t
        rw [hx, map_smul] }
  let n := hn.toLp fun t => ‖F.functional t‖
  have hbound (x : X) : ‖T₀ x‖ ≤ ‖n‖ * ‖x‖ := by
    have h : ‖T x‖ ≤ ‖‖x‖ • n‖ := by
      apply Lp.norm_le_norm_of_ae_le
      filter_upwards [hT x, hn.coeFn_toLp, Lp.coeFn_smul ‖x‖ n] with t htx hnt hst
      rw [htx, hst]
      change ‖F.functional t x‖ ≤ ‖‖x‖ • n t‖
      rw [hnt, norm_smul, norm_norm, norm_norm, mul_comm ‖x‖]
      exact (F.functional t).le_opNorm x
    simpa only [T₀, LinearMap.coe_mk, AddHom.coe_mk, norm_smul, norm_norm, mul_comm ‖x‖] using h
  let one := (memLp_const (μ := ρ) (p := 2) (1 : ℝ)).toLp fun _ => 1
  let R : FrameCoefficientPiece F B (Lp ℝ 2 ρ) :=
    ⟨Q, hinj, hdom, ?_, one, ?_, T₀.mkContinuous ‖n‖ hbound, ?_⟩
  · have hac : ρ ≪ η := h₁.trans (Measure.absolutelyContinuous_of_le Measure.restrict_le_self)
    have hp (y : L) (h : ∀ᵐ t ∂η, 0 ≤ q y t) : ∀ᵐ t ∂ρ, 0 ≤ y t := by
      filter_upwards [hac.ae_le h, q_restrict y] with t ht he
      rwa [← he]
    have hm (u v : L) (h : ∀ᵐ t ∂η, q u t ≤ q v t) : ∀ᵐ t ∂ρ, u t ≤ v t := by
      filter_upwards [hac.ae_le h, q_restrict u, q_restrict v] with t ht hu hv
      rwa [← hu, ← hv]
    refine ⟨R, ?_, ?_, ?_⟩
    · intro x hpos hmono hlim
      apply associatedL2_orderContinuous x (fun n => hp (x n) (hpos n))
        (fun i j hij => hm (x j) (x i) (hmono i j hij))
      filter_upwards [hac.ae_le hlim, ae_all_iff.mpr fun n => q_restrict (x n)] with t ht he
      exact ht.congr' (Eventually.of_forall fun n => he n)
    · intro x hpos hmono hb
      exact associatedL2_KB x (fun n => hp (x n) (hpos n))
        (fun i j hij => hm (x i) (x j) (hmono i j hij)) hb
    · have hone := (ae_restrict_iff' B.2).mp
        (h₂.ae_le (memLp_const (μ := ρ) (p := 2) (1 : ℝ)).coeFn_toLp)
      filter_upwards [hq one, hone] with t ht hu
      change q one t = B.1.indicator (fun _ => 1) t
      rw [ht]
      by_cases hBt : t ∈ B.1
      · simpa only [C, indicator_of_mem hBt] using hu hBt
      · simp only [C, indicator_of_notMem hBt]
  · intro y
    filter_upwards [hq y] with t ht hBt
    exact ht.trans (indicator_of_notMem hBt _)
  · have hone := (ae_restrict_iff' B.2).mp
      (h₂.ae_le (memLp_const (μ := ρ) (p := 2) (1 : ℝ)).coeFn_toLp)
    filter_upwards [hq one, hone] with t ht hu hBt
    change 0 < q one t
    rw [ht]
    change 0 < B.1.indicator (fun s => one s) t
    rw [indicator_of_mem hBt, hu hBt]
    exact zero_lt_one
  · intro x
    have hAx := (ae_restrict_iff' B.2).mp (h₂.ae_le (hT x))
    filter_upwards [hq (T x), hAx] with t ht hx
    change q (T x) t = B.1.indicator (A x) t
    rw [ht]
    by_cases hBt : t ∈ B.1
    · simpa only [C, indicator_of_mem hBt] using hx hBt
    · simp only [C, indicator_of_notMem hBt]

#print axioms ContinuousSchauderFrame.exists_L2_coefficientPiece

end AssociatedL2


noncomputable section AssociatedWeightedAssembly

open MeasureTheory
open scoped ENNReal

universe uΩ uX

variable {Ω : Type uΩ} {X : Type uX} [MeasurableSpace Ω]
  [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X] {η : Measure Ω}

/-- The zero-vector region is filled in by the weighted L² space of
the manuscript, retaining the original frame coefficients. -/
theorem FrameLeftKotheDilation.exists_weighted_assembly
    [TopologicalSpace.SeparableSpace X] [SigmaFinite η]
    {F : ContinuousSchauderFrame (X := X) η} {A : MeasSet Ω} {w : Ω → ℝ}
    (D : FrameLeftKotheDilation F A w) (hwm : Measurable w) (hwp : ∀ t, 0 < w t)
    (hzero : ∀ t, t ∉ A.1 → F.vector t = 0) :
    ∃ (a : Ω → ℝ), Measurable a ∧ (∀ t, 0 < a t) ∧
      Integrable (fun t => a t * (1 + ‖F.functional t‖ ^ 2)) η ∧
      let ρ := (η.restrict A.1ᶜ).withDensity (fun t => ENNReal.ofReal (a t))
      IsFiniteMeasure ρ ∧
      letI := D.normedGroup; letI := D.normedScalar;
      ∃ H : FrameAssociatedSpace (Y := WithLp 2 (D.carrier × Lp ℝ 2 ρ)) F,
        CoordinateOrderContinuous H.repr ∧ (KotheKB D.scalar → CoordinateKB H.repr) ∧
        ∃ v : WithLp 2 (D.carrier × Lp ℝ 2 ρ), (fun t => H.repr v t) =ᵐ[η]
          fun t => A.1.indicator w t + A.1ᶜ.indicator (fun _ => 1) t := by
  let := D.normedGroup
  let := D.normedScalar
  obtain ⟨L, _, hP, hI, _, hLO, hLK, hLv⟩ := D.exists_coefficientPiece hwm hwp hzero
  obtain ⟨a, ham, hap, haI, _⟩ := F.exists_integrable_functional_weight
  let Z : MeasSet Ω := ⟨A.1ᶜ, A.2.compl⟩
  have hnorm : Measurable (fun t => ‖F.functional t‖) :=
    measurable_operatorNorm_of_orbits F.functional fun x => (F.weakStarMeasurable x).norm
  obtain ⟨hfin, h₁, h₂, hn⟩ := exists_finite_weighted_restriction Z a _ ham hnorm hap haI
  let ρ := (η.restrict Z.1).withDensity (fun t => ENNReal.ofReal (a t))
  let : IsFiniteMeasure ρ := hfin
  obtain ⟨R, hRO, hRK, hRv⟩ := F.exists_L2_coefficientPiece Z ρ h₁ h₂ hn
  have hS (y : D.carrier) (g : Dual X) : g (D.dilation.S y) =
      ∫ t, L.repr y t * g (F.vector t) ∂η := by
    have h := hI y g MeasSet.whole
    have hnrm : D.dilation.P.val MeasSet.whole = ContinuousLinearMap.id ℝ D.carrier :=
      D.dilation.P.normalized
    rw [hnrm, ContinuousLinearMap.id_apply] at h
    exact h.trans setIntegral_univ
  obtain ⟨H, hOC, hKB, v, hv⟩ := F.exists_associated_of_complementary_pieces A L R hzero D.dilation.S hP hS
  refine ⟨a, ham, hap, haI, hfin, H, hOC hLO hRO, fun h => hKB (hLK h) hRK, v, ?_⟩
  filter_upwards [hv, hLv, hRv] with t ht hL hR
  rw [ht, hL, hR]

structure FrameAssociatedModel (F : ContinuousSchauderFrame (X := X) η) where
  carrier : Type (max uΩ uX)
  normedGroup : NormedAddCommGroup carrier
  normedScalar : letI := normedGroup; NormedSpace ℝ carrier
  complete : letI := normedGroup; CompleteSpace carrier
  data : letI := normedGroup; letI := normedScalar; FrameAssociatedSpace (Y := carrier) F

/-- The concrete weighted associated space for every continuous
Schauder frame covered by the real measure-space hypotheses. -/
theorem ContinuousSchauderFrame.exists_associatedModel
    [TopologicalSpace.SeparableSpace X] [SigmaFinite η]
    (F : ContinuousSchauderFrame (X := X) η) :
    Nonempty (FrameAssociatedModel F) := by
  obtain ⟨A, w, D, hA, hwm, hwp, _⟩ := F.exists_weighted_left_base
  let := D.normedGroup
  let := D.normedScalar
  let := D.complete
  have hz (t : Ω) (ht : t ∉ A.1) : F.vector t = 0 := by simpa [hA] using ht
  obtain ⟨_, _, _, _, _, H, _, _⟩ := D.exists_weighted_assembly hwm hwp hz
  exact ⟨⟨_, inferInstance, inferInstance, inferInstance, H⟩⟩

#print axioms FrameLeftKotheDilation.exists_weighted_assembly
#print axioms ContinuousSchauderFrame.exists_associatedModel

end AssociatedWeightedAssembly


noncomputable section AssociatedFinalGeometry

open MeasureTheory
open scoped ENNReal

universe uΩ uX uY

/-- The canonical bidual reflexivity of the real Hilbert space L²,
the L² case of the usual Lp reflexivity theorem. -/
axiom citeLTwoMeasureReflexive {Ω : Type uΩ} [MeasurableSpace Ω]
    (ρ : Measure Ω) : IsReflexive (Lp ℝ 2 ρ)

private theorem not_contains_lOne_prod
    {Y : Type uX} {Z : Type uY}
    [NormedAddCommGroup Y] [NormedSpace ℝ Y] [CompleteSpace Y]
    [NormedAddCommGroup Z] [NormedSpace ℝ Z] [CompleteSpace Z]
    (hY : ¬ ContainsCopy LOne Y) (hZ : ¬ ContainsCopy LOne Z) :
    ¬ ContainsCopy LOne (Y × Z) := by
  intro h
  obtain ⟨E, _, ⟨e⟩⟩ := h.closed_range
  let A := E.subtypeL.comp e.toContinuousLinearMap
  let u (n : ℕ) : LOne := lOneUnit n
  obtain ⟨i, hi, h₁⟩ := citeRosenthal1974 Y hY (fun n => (A (u n)).1) ⟨‖A‖, fun n => by
    apply (norm_fst_le (A (u n))).trans
    simpa only [u, norm_lOneUnit, mul_one] using A.le_opNorm (u n)⟩
  obtain ⟨j, hj, h₂⟩ := citeRosenthal1974 Z hZ (fun n => (A (u (i n))).2) ⟨‖A‖, fun n => by
    apply (norm_snd_le (A (u (i n)))).trans
    simpa only [u, norm_lOneUnit, mul_one] using A.le_opNorm (u (i n))⟩
  have hweak (f : Dual (Y × Z)) : CauchySeq (fun n => f (A (u (i (j n))))) := by
    have hy := (h₁ (f.comp (ContinuousLinearMap.inl ℝ Y Z))).comp_tendsto hj.tendsto_atTop
    have hz := h₂ (f.comp (ContinuousLinearMap.inr ℝ Y Z))
    have he : (fun n => f ((A (u (i (j n)))).1, 0) + f (0, (A (u (i (j n)))).2)) =
        fun n => f (A (u (i (j n)))) := by
      funext n
      rw [← map_add]
      congr 1
      ext <;> simp
    have hh : CauchySeq (fun n => f ((A (u (i (j n)))).1, 0) + f (0, (A (u (i (j n)))).2)) :=
      hy.add hz
    rwa [he] at hh
  have hC := lOne_cauchySeq_of_weaklyCauchy (fun n => u (i (j n))) (fun f => by
    obtain ⟨g, hg, _⟩ := exists_extension_norm_eq E (f.comp e.symm.toContinuousLinearMap)
    have he (n : ℕ) : g (A (u (i (j n)))) = f (u (i (j n))) := by
      rw [show g (A (u (i (j n)))) = g (e (u (i (j n))) : Y × Z) from rfl,
        hg]
      simp
    simpa only [he] using hweak g)
  obtain ⟨N, hN⟩ := Metric.cauchySeq_iff.mp hC 1 zero_lt_one
  have hn : i (j N) ≠ i (j (N + 1)) := (hi.comp hj).injective.ne (by omega)
  have hdist := hN N (le_refl _) (N + 1) (by omega)
  rw [dist_eq_norm] at hdist
  have hcoord := lp.norm_apply_le_norm (by norm_num : (1 : ℝ≥0∞) ≠ 0)
    (u (i (j N)) - u (i (j (N + 1)))) (i (j N))
  have hval : (u (i (j N)) - u (i (j (N + 1)))) (i (j N)) = 1 := by
    simp [u, lOneUnit, lp.single_apply, Pi.single_eq_of_ne hn]
  rw [hval, norm_one] at hcoord
  exact (not_lt_of_ge hcoord) hdist

variable {Ω : Type uΩ} {X : Type uX} [MeasurableSpace Ω]
  [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X] {η : Measure Ω}

namespace FrameAssociatedModel

def IsOrderContinuous (F : ContinuousSchauderFrame (X := X) η) (M : FrameAssociatedModel F) : Prop :=
  letI := M.normedGroup; letI := M.normedScalar; CoordinateOrderContinuous M.data.repr

def IsKB (F : ContinuousSchauderFrame (X := X) η) (M : FrameAssociatedModel F) : Prop :=
  letI := M.normedGroup; letI := M.normedScalar; CoordinateKB M.data.repr

end FrameAssociatedModel

/-- The forward directions of the manuscript, cor:associated-spaces. The
analysis uses the given frame on the entire original measure space. -/
theorem ContinuousSchauderFrame.exists_associated_with_geometry
    [TopologicalSpace.SeparableSpace X] [SigmaFinite η]
    (F : ContinuousSchauderFrame (X := X) η) :
    ((¬ ContainsCopy LOne X) → ∃ M : FrameAssociatedModel F,
      M.IsOrderContinuous F ∧ (letI := M.normedGroup; letI := M.normedScalar;
        ¬ ContainsCopy LOne M.carrier)) ∧
    ((¬ ContainsCopy CZero X) → ∃ M : FrameAssociatedModel F, M.IsOrderContinuous F ∧ M.IsKB F) ∧
    (IsReflexive X → ∃ M : FrameAssociatedModel F, M.IsOrderContinuous F ∧
      (letI := M.normedGroup; letI := M.normedScalar; IsReflexive M.carrier)) := by
  obtain ⟨A, w, D, hA, hwm, hwp, hcyc, hQ, hf, hW⟩ := F.exists_weighted_left_base
  let := D.normedGroup
  let := D.normedScalar
  let := D.complete
  have hzero (t : Ω) (ht : t ∉ A.1) : F.vector t = 0 := by simpa [hA] using ht
  have hinter (hx : ¬ ContainsCopy LOne X) :
      ∃ M : FrameAssociatedModel F, M.IsOrderContinuous F ∧
        (letI := M.normedGroup; letI := M.normedScalar;
          (¬ ContainsCopy LOne M.carrier) ∧ (IsReflexive X → IsReflexive M.carrier)) := by
    obtain ⟨I, _, hi, hir⟩ := D.exists_interpolated hcyc hQ hf hW hx
    let := I.normedGroup
    let := I.normedScalar
    let := I.complete
    obtain ⟨a, _, _, _, _, H, ho, _⟩ := I.exists_weighted_assembly hwm hwp hzero
    let ρ := (η.restrict A.1ᶜ).withDensity (fun t => ENNReal.ofReal (a t))
    let L : Type _ := Lp ℝ 2 ρ
    let M : FrameAssociatedModel F := ⟨WithLp 2 (I.carrier × L), inferInstance, inferInstance, inferInstance, H⟩
    let e := WithLp.prodContinuousLinearEquiv 2 ℝ I.carrier L
    have hl := citeLTwoMeasureReflexive ρ
    refine ⟨M, ho, ?_, fun hr => ?_⟩
    · rintro ⟨T, c, hc, hT⟩
      apply not_contains_lOne_prod hi hl.excludes_lOne_and_cZero.1
      let C := ‖e.symm.toContinuousLinearMap‖ + 1
      have hC : 0 < C := by dsimp [C]; positivity
      refine ⟨e.toContinuousLinearMap.comp T, c / C, div_pos hc hC, fun x => ?_⟩
      rw [div_mul_eq_mul_div, div_le_iff₀ hC]
      have hh := e.symm.toContinuousLinearMap.le_opNorm (e (T x))
      change ‖e.symm (e (T x))‖ ≤ ‖e.symm.toContinuousLinearMap‖ * ‖e (T x)‖ at hh
      rw [e.symm_apply_apply] at hh
      exact (hT x).trans ((hh.trans (mul_le_mul_of_nonneg_right (le_add_of_nonneg_right zero_le_one)
        (norm_nonneg _))).trans_eq (mul_comm _ _))
    · exact IsReflexive.of_continuousLinearEquiv e ((hir hr).prod hl)
  refine ⟨fun h => ?_, fun h => ?_, fun h => ?_⟩
  · obtain ⟨M, hm, hn, _⟩ := hinter h
    exact ⟨M, hm, hn⟩
  · obtain ⟨_, _, _, _, _, H, ho, hk, _⟩ := D.exists_weighted_assembly hwm hwp hzero
    let M : FrameAssociatedModel F := ⟨_, inferInstance, inferInstance, inferInstance, H⟩
    exact ⟨M, ho, hk ((citeKotheKB D.scalar).mp (hW h))⟩
  · obtain ⟨M, hm, _, hr⟩ := hinter h.excludes_lOne_and_cZero.1
    exact ⟨M, hm, hr h⟩

#print axioms not_contains_lOne_prod
#print axioms ContinuousSchauderFrame.exists_associated_with_geometry

end AssociatedFinalGeometry


noncomputable section AssociatedMultiplication

open MeasureTheory

variable {Ω X Y : Type*} [MeasurableSpace Ω]
  [NormedAddCommGroup X] [NormedSpace ℝ X]
  [NormedAddCommGroup Y] [NormedSpace ℝ Y] {η : Measure Ω}

namespace FrameAssociatedSpace

variable {F : ContinuousSchauderFrame (X := X) η} (H : FrameAssociatedSpace (Y := Y) F)

private theorem abs_le_implies_norm_le (x y : Y)
    (h : ∀ᵐ t ∂η, |H.repr x t| ≤ |H.repr y t|) : ‖x‖ ≤ ‖y‖ := by
  obtain ⟨z, hz, hn⟩ := H.solid y (H.repr x) h
  exact H.repr_injective hz ▸ hn

private def cutVector (E : MeasSet Ω) (y : Y) : Y :=
  Classical.choose (H.solid y (associatedCut E (H.repr y)) (by
    filter_upwards [associatedCut_repr E (H.repr y)] with t ht
    rw [ht]
    by_cases hE : t ∈ E.1 <;> simp [hE]))

private theorem repr_cutVector (E : MeasSet Ω) (y : Y) :
    (fun t => H.repr (H.cutVector E y) t) =ᵐ[η] E.1.indicator (H.repr y) := by
  have h := (Classical.choose_spec (H.solid y (associatedCut E (H.repr y)) (by
    filter_upwards [associatedCut_repr E (H.repr y)] with t ht
    rw [ht]
    by_cases hE : t ∈ E.1 <;> simp [hE]))).1
  exact h.symm ▸ associatedCut_repr E (H.repr y)

/-- Restriction of the original a.e. coordinates to a measurable set. -/
def cut (E : MeasSet Ω) : Y →L[ℝ] Y := by
  let L : Y →ₗ[ℝ] Y :=
    { toFun := H.cutVector E
      map_add' := fun x y => by
        apply H.repr_injective
        apply AEEqFun.ext
        have h : (fun t => H.repr (x + y) t) =ᵐ[η] fun t => H.repr x t + H.repr y t := by
          rw [map_add]
          exact AEEqFun.coeFn_add _ _
        have he : (fun t => H.repr (H.cutVector E x + H.cutVector E y) t) =ᵐ[η]
            fun t => H.repr (H.cutVector E x) t + H.repr (H.cutVector E y) t := by
          rw [map_add]
          exact AEEqFun.coeFn_add _ _
        filter_upwards [H.repr_cutVector E (x + y), H.repr_cutVector E x, H.repr_cutVector E y, h, he]
          with t ht hx hy hxy hsum
        rw [ht, hsum, hx, hy]
        by_cases hE : t ∈ E.1
        · simpa only [indicator_of_mem hE] using hxy
        · simp only [indicator_of_notMem hE, add_zero]
      map_smul' := fun c y => by
        apply H.repr_injective
        apply AEEqFun.ext
        have h (v : Y) : (fun t => H.repr (c • v) t) =ᵐ[η] fun t => c * H.repr v t := by
          rw [map_smul]
          exact AEEqFun.coeFn_smul _ _
        filter_upwards [H.repr_cutVector E (c • y), H.repr_cutVector E y, h y, h (H.cutVector E y)]
          with t hcy hy hc hcut
        change H.repr (H.cutVector E (c • y)) t = H.repr (c • H.cutVector E y) t
        rw [hcy, hcut, hy]
        by_cases hE : t ∈ E.1
        · simpa only [indicator_of_mem hE] using hc
        · simp only [indicator_of_notMem hE, mul_zero] }
  exact L.mkContinuous 1 (fun y => by
    rw [one_mul]
    apply H.abs_le_implies_norm_le
    filter_upwards [H.repr_cutVector E y] with t ht
    change |H.repr (H.cutVector E y) t| ≤ |H.repr y t|
    rw [ht]
    by_cases hE : t ∈ E.1 <;> simp [hE])

theorem repr_cut (E : MeasSet Ω) (y : Y) :
    (fun t => H.repr (H.cut E y) t) =ᵐ[η] E.1.indicator (H.repr y) := H.repr_cutVector E y

theorem cut_contractive (E : MeasSet Ω) (y : Y) : ‖H.cut E y‖ ≤ ‖y‖ := by
  apply H.abs_le_implies_norm_le
  filter_upwards [H.repr_cut E y] with t ht
  rw [ht]
  by_cases hE : t ∈ E.1 <;> simp [hE]

private theorem cut_empty (y : Y) : H.cut MeasSet.empty y = 0 := by
  apply H.repr_injective
  apply AEEqFun.ext
  rw [map_zero]
  exact (H.repr_cut MeasSet.empty y).trans
    (by
      rw [show (MeasSet.empty : MeasSet Ω).1 = ∅ from rfl, Set.indicator_empty]
      exact AEEqFun.coeFn_zero.symm)

theorem cut_comp (E B : MeasSet Ω) (y : Y) : H.cut E (H.cut B y) = H.cut (E.inter B) y := by
  apply H.repr_injective
  apply AEEqFun.ext
  filter_upwards [H.repr_cut E (H.cut B y), H.repr_cut B y, H.repr_cut (E.inter B) y] with t ht hB hEB
  rw [ht, hEB]
  by_cases h₁ : t ∈ E.1 <;> by_cases h₂ : t ∈ B.1 <;> simp [MeasSet.inter, h₁, h₂, hB]

private theorem cut_union (E B : MeasSet Ω) (h : Disjoint E.1 B.1) (y : Y) :
    H.cut (E.union B) y = H.cut E y + H.cut B y := by
  apply H.repr_injective
  apply AEEqFun.ext
  rw [map_add]
  filter_upwards [H.repr_cut (E.union B) y, H.repr_cut E y, H.repr_cut B y,
    AEEqFun.coeFn_add (H.repr (H.cut E y)) (H.repr (H.cut B y))] with t ht he hb hab
  rw [ht, hab]
  change (E.union B).1.indicator (H.repr y) t = H.repr (H.cut E y) t + H.repr (H.cut B y) t
  rw [he, hb]
  by_cases h₁ : t ∈ E.1 <;> by_cases h₂ : t ∈ B.1
  · exact (Set.disjoint_left.mp h h₁ h₂).elim
  · simp [MeasSet.union, h₁, h₂]
  · simp [MeasSet.union, h₁, h₂]
  · simp [MeasSet.union, h₁, h₂]

theorem cut_tendsto_zero (A : ℕ → MeasSet Ω) (ha : Antitone (fun n => (A n).1))
    (hcap : (⋂ n, (A n).1) = ∅) (y : Y) (ho : CoordinateOrderContinuous H.repr) :
    Tendsto (fun n => ‖H.cut (A n) y‖) atTop (𝓝 0) := by
  let q := AEEqFun.comp abs continuous_abs (H.repr y)
  have hq : (fun t => q t) =ᵐ[η] fun t => |H.repr y t| :=
    AEEqFun.coeFn_comp abs continuous_abs (H.repr y)
  obtain ⟨v, hv, _⟩ := H.solid y q (by
    filter_upwards [hq] with t ht
    simp [ht])
  have hr : (fun t => H.repr v t) =ᵐ[η] fun t => |H.repr y t| := hv.symm ▸ hq
  have hrepr (n : ℕ) : (fun t => H.repr (H.cut (A n) v) t) =ᵐ[η]
      (A n).1.indicator (fun t => |H.repr y t|) := by
    filter_upwards [H.repr_cut (A n) v, hr] with t ht hu
    rw [ht]
    by_cases hn : t ∈ (A n).1 <;> simp [hn, hu]
  have ht := ho (fun n => H.cut (A n) v)
    (fun n => by
      filter_upwards [hrepr n] with t ht
      rw [ht]
      by_cases hn : t ∈ (A n).1 <;> simp [hn])
    (fun i j hij => by
      filter_upwards [hrepr i, hrepr j] with t hi hj
      rw [hi, hj]
      by_cases ht : t ∈ (A j).1
      · simp [ht, ha hij ht]
      · by_cases hti : t ∈ (A i).1 <;> simp [ht, hti])
    (by
      filter_upwards [ae_all_iff.mpr hrepr] with t ht
      have hex : ∃ n, t ∉ (A n).1 := by
        by_contra! hn
        have hh := Set.mem_iInter.mpr hn
        rw [hcap] at hh
        exact hh
      obtain ⟨N, hn⟩ := hex
      apply tendsto_const_nhds.congr'
      filter_upwards [eventually_ge_atTop N] with n hN
      exact ((ht n).trans (indicator_of_notMem (fun hn' => hn (ha hN hn')) _)).symm)
  apply squeeze_zero (fun _ => norm_nonneg _) (fun n => ?_) ht
  apply H.abs_le_implies_norm_le
  filter_upwards [hrepr n, H.repr_cut (A n) y] with t hv' hy'
  rw [hv', hy']
  by_cases hn : t ∈ (A n).1 <;> simp [hn]

/-- The multiplication projections on the original associated space. -/
def multiplication (ho : CoordinateOrderContinuous H.repr) : PVM Ω Y where
  val := H.cut
  empty_eq := ContinuousLinearMap.ext fun x => H.cut_empty x
  normalized := by
    apply ContinuousLinearMap.ext
    intro x
    change H.cut MeasSet.whole x = x
    apply H.repr_injective
    apply AEEqFun.ext
    simpa only [MeasSet.whole, Set.indicator_univ] using H.repr_cut MeasSet.whole x
  mul_eq := fun A B => ContinuousLinearMap.ext fun x => H.cut_comp A B x
  countably_additive A hA x := by
    let U := MeasSet.iUnion A
    let V (s : Finset ℕ) := MeasSet.finiteUnion A s
    let R (s : Finset ℕ) := U.diff (V s)
    let D (n : ℕ) := R (Finset.range n)
    have hV (s : Finset ℕ) : (V s).1 ⊆ U.1 := by
      intro t ht
      obtain ⟨n, _, hn⟩ := mem_iUnion₂.mp ht
      exact mem_iUnion.mpr ⟨n, hn⟩
    have hR {s t : Finset ℕ} (hst : s ⊆ t) : (R t).1 ⊆ (R s).1 := by
      intro u hu
      refine ⟨hu.1, fun hv => hu.2 ?_⟩
      obtain ⟨n, hs, hn⟩ := mem_iUnion₂.mp hv
      exact mem_iUnion₂.mpr ⟨n, hst hs, hn⟩
    have hda : Antitone (fun n => (D n).1) := fun _ _ h => hR (Finset.range_mono h)
    have hdz : (⋂ n, (D n).1) = ∅ := by
      apply Set.eq_empty_iff_forall_notMem.mpr
      intro t ht
      obtain ⟨n, hn⟩ := mem_iUnion.mp ((Set.mem_iInter.mp ht 0).1)
      exact (Set.mem_iInter.mp ht (n + 1)).2
        (mem_iUnion₂.mpr ⟨n, Finset.mem_range.mpr (Nat.lt_succ_self n), hn⟩)
    have hlim := H.cut_tendsto_zero D hda hdz x ho
    change Tendsto (fun s : Finset ℕ => ∑ n ∈ s, H.cut (A n) x) atTop (𝓝 (H.cut U x))
    rw [Metric.tendsto_nhds]
    intro ε hε
    obtain ⟨N, hN⟩ := Metric.tendsto_atTop.mp hlim ε hε
    have hn : ‖H.cut (D N) x‖ < ε := by
      simpa only [Real.dist_eq, sub_zero, abs_of_nonneg (norm_nonneg _)] using hN N le_rfl
    filter_upwards [eventually_ge_atTop (Finset.range N)] with s hs
    have hfin := MeasSet.finite_add_of_pair (fun E => H.cut E x) (H.cut_empty x)
      (fun E B h => H.cut_union E B h x) A hA s
    rw [← hfin, dist_eq_norm, norm_sub_rev]
    have huv : U = (V s).union (R s) := Subtype.ext (Set.union_sdiff_cancel (hV s)).symm
    have he : H.cut U x - H.cut (V s) x = H.cut (R s) x := by
      conv_lhs => rw [huv]
      rw [H.cut_union _ _ disjoint_sdiff_right, add_sub_cancel_left]
    rw [he]
    have hin : (R s).inter (D N) = R s := Subtype.ext (Set.inter_eq_left.mpr (hR hs))
    have hs' := H.cut_contractive (R s) (H.cut (D N) x)
    rw [H.cut_comp, hin] at hs'
    exact hs'.trans_lt hn

theorem compress_cut [CompleteSpace X] (E : MeasSet Ω) :
    H.synthesis.comp ((H.cut E).comp H.analysis) = F.operatorMeasure.val E := by
  apply ContinuousLinearMap.ext
  intro x
  apply eq_of_dual_eval
  intro g
  change g (H.synthesis (H.cut E (H.analysis x))) = g (F.operatorMeasure.val E x)
  rw [H.synthesis_coeff, F.operatorMeasure_coeff, ← integral_indicator E.2]
  apply integral_congr_ae
  filter_upwards [H.repr_cut E (H.analysis x), H.analysis_coeff x] with t ht hs
  rw [ht]
  by_cases hE : t ∈ E.1 <;> simp [hE, hs]

end FrameAssociatedSpace

#print axioms FrameAssociatedSpace.multiplication
#print axioms FrameAssociatedSpace.compress_cut

end AssociatedMultiplication


noncomputable section AssociatedCyclicity

open MeasureTheory

variable {Ω X Y : Type*} [MeasurableSpace Ω]
  [NormedAddCommGroup X] [NormedSpace ℝ X]
  [NormedAddCommGroup Y] [NormedSpace ℝ Y] {η : Measure Ω}

namespace FrameAssociatedSpace

variable {F : ContinuousSchauderFrame (X := X) η} (H : FrameAssociatedSpace (Y := Y) F)

private theorem repr_sum {ι : Type*} (s : Finset ι) (x : ι → Y) :
    (fun t => H.repr (∑ i ∈ s, x i) t) =ᵐ[η] fun t => ∑ i ∈ s, H.repr (x i) t := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    simp only [Finset.sum_empty, map_zero]
    exact AEEqFun.coeFn_zero
  | insert a s ha ih =>
    simp only [Finset.sum_insert ha, map_add]
    filter_upwards [AEEqFun.coeFn_add (H.repr (x a)) (H.repr (∑ i ∈ s, x i)), ih]
      with t ht hs
    rw [ht, Pi.add_apply, hs]

private theorem repr_sub (x y : Y) :
    (fun t => H.repr (x - y) t) =ᵐ[η] fun t => H.repr x t - H.repr y t := by
  rw [map_sub]
  exact AEEqFun.coeFn_sub _ _

private theorem repr_smul (c : ℝ) (x : Y) :
    (fun t => H.repr (c • x) t) =ᵐ[η] fun t => c * H.repr x t := by
  rw [map_smul]
  exact AEEqFun.coeFn_smul _ _

/-- A strictly positive vector in an order-continuous associated space
is cyclic for the multiplication projections. -/
theorem multiplication_cyclicVector (ho : CoordinateOrderContinuous H.repr)
    (v : Y) (hv : ∀ᵐ t ∂η, 0 < H.repr v t) :
    (H.multiplication ho).CyclicVector v := by
  classical
  let C := (Submodule.span ℝ (Set.range fun E : MeasSet Ω => H.cut E v)).topologicalClosure
  have hC : IsClosed (C : Set Y) := isClosed_closure
  have hcutC (E : MeasSet Ω) : H.cut E v ∈ C :=
    subset_closure (Submodule.subset_span ⟨E, rfl⟩)
  have hbdd (g : Ω → ℝ) (hg : Measurable g) (M : ℝ)
      (hbound : ∀ t, |g t| ≤ M) (z : Y)
      (hz : (fun t => H.repr z t) =ᵐ[η] fun t => g t * H.repr v t) : z ∈ C := by
    obtain ⟨p, hp⟩ := exists_uniform_simpleApprox g hg M hbound
    let E (n : ℕ) (c : ℝ) : MeasSet Ω := ⟨p n ⁻¹' {c}, (p n).measurableSet_fiber c⟩
    let zₙ (n : ℕ) := ∑ c ∈ (p n).range, c • H.cut (E n c) v
    have hzn (n : ℕ) : zₙ n ∈ C :=
      C.sum_mem fun c _ => C.smul_mem c (hcutC (E n c))
    have hrepr (n : ℕ) : (fun t => H.repr (zₙ n) t) =ᵐ[η] fun t => p n t * H.repr v t := by
      have hterm (c : ℝ) : (fun t => H.repr (c • H.cut (E n c) v) t) =ᵐ[η]
          fun t => c * (E n c).1.indicator (H.repr v) t := by
        filter_upwards [H.repr_smul c (H.cut (E n c) v), H.repr_cut (E n c) v] with t ht hc
        rw [ht, hc]
      filter_upwards [H.repr_sum (p n).range (fun c => c • H.cut (E n c) v),
        (Finset.eventually_all _).mpr fun c _ => hterm c] with t ht hc
      rw [ht]
      rw [Finset.sum_congr rfl (fun c hm => hc c hm)]
      rw [Finset.sum_eq_single (p n t)]
      · rw [indicator_of_mem (show t ∈ (E n (p n t)).1 from rfl)]
      · intro c _ hc'
        rw [indicator_of_notMem (show t ∉ (E n c).1 from fun ht' => hc' (Eq.symm ht')), mul_zero]
      · exact fun hn => (hn ((p n).mem_range_self t)).elim
    have hnorm (n : ℕ) : ‖zₙ n - z‖ ≤ (1 / ((n : ℝ) + 1)) * ‖v‖ := by
      let δ := (1 : ℝ) / ((n : ℝ) + 1)
      have h := H.abs_le_implies_norm_le (zₙ n - z) (δ • v) (by
        filter_upwards [H.repr_sub (zₙ n) z, hrepr n, hz, H.repr_smul δ v] with t ht hn hz' hδ
        have hδ₀ : 0 ≤ δ := by dsimp [δ]; positivity
        rw [ht, hn, hz', hδ, ← sub_mul, abs_mul (p n t - g t), abs_mul δ, abs_of_nonneg hδ₀]
        exact mul_le_mul_of_nonneg_right (hp n t) (abs_nonneg _))
      simpa only [norm_smul, Real.norm_of_nonneg (show 0 ≤ δ by dsimp [δ]; positivity)] using h
    have hlim : Tendsto zₙ atTop (𝓝 z) := by
      apply tendsto_iff_norm_sub_tendsto_zero.mpr
      exact squeeze_zero (fun _ => norm_nonneg _) hnorm (by
        simpa only [zero_mul] using tendsto_one_div_add_atTop_nhds_zero_nat.mul_const ‖v‖)
    exact hC.mem_of_tendsto hlim (Eventually.of_forall hzn)
  have hall (y : Y) : y ∈ C := by
    let a (t : Ω) := H.repr y t
    let b (t : Ω) := H.repr v t
    have ha : Measurable a := (H.repr y).stronglyMeasurable.measurable
    have hb : Measurable b := (H.repr v).stronglyMeasurable.measurable
    let D (n : ℕ) : MeasSet Ω :=
      ⟨{t | 0 < b t} ∩ {t | (n : ℝ) * b t < |a t|},
        (measurableSet_lt measurable_const hb).inter (measurableSet_lt (measurable_const.mul hb) ha.norm)⟩
    have hD : Antitone (fun n => (D n).1) := by
      intro i j hij t ht
      have hp : 0 < b t := ht.1
      have hlt : (j : ℝ) * b t < |a t| := ht.2
      refine ⟨hp, ?_⟩
      change (i : ℝ) * b t < |a t|
      exact lt_of_le_of_lt (mul_le_mul_of_nonneg_right (Nat.cast_le.mpr hij) hp.le) hlt
    have hempty : (⋂ n, (D n).1) = ∅ := by
      apply Set.eq_empty_iff_forall_notMem.mpr
      intro t ht
      have hp : 0 < b t := (Set.mem_iInter.mp ht 0).1
      obtain ⟨n, hn⟩ := exists_nat_gt (|a t| / b t)
      exact (not_lt_of_ge ((div_le_iff₀ hp).mp hn.le)) (Set.mem_iInter.mp ht n).2
    let u (n : ℕ) : Y := y - H.cut (D n) y
    have hC_u (n : ℕ) : u n ∈ C := by
      let S := {t | 0 < b t} ∩ (D n).1ᶜ
      have hS : MeasurableSet S := (measurableSet_lt measurable_const hb).inter (D n).2.compl
      let g := S.indicator (fun t => a t / b t)
      have hg : Measurable g := (ha.div hb).indicator hS
      have hbound (t : Ω) : |g t| ≤ (n : ℝ) := by
        by_cases ht : t ∈ S
        · have hp : 0 < b t := ht.1
          rw [show g t = a t / b t from indicator_of_mem ht _, abs_div, abs_of_pos hp,
            div_le_iff₀ hp]
          exact le_of_not_gt fun hn => ht.2 ⟨ht.1, hn⟩
        · simp only [g, indicator_of_notMem ht, abs_zero, Nat.cast_nonneg]
      apply hbdd g hg (n : ℝ) hbound
      filter_upwards [hv, H.repr_sub y (H.cut (D n) y), H.repr_cut (D n) y] with t ht hq hc
      rw [hq, hc]
      by_cases hn : t ∈ (D n).1
      · rw [indicator_of_mem hn, sub_self,
          show g t = 0 from indicator_of_notMem (show t ∉ S from fun h => h.2 hn) _, zero_mul]
      · have hs : t ∈ S := ⟨ht, hn⟩
        rw [indicator_of_notMem hn, sub_zero, show g t = a t / b t from indicator_of_mem hs _]
        exact (div_mul_cancel₀ _ ht.ne').symm
    have htU : Tendsto u atTop (𝓝 y) := by
      apply tendsto_iff_norm_sub_tendsto_zero.mpr
      have hz (n : ℕ) : ‖u n - y‖ = ‖H.cut (D n) y‖ := by
        dsimp [u]
        rw [sub_right_comm, sub_self, zero_sub, norm_neg]
      simp_rw [hz]
      exact H.cut_tendsto_zero D hD hempty y ho
    exact hC.mem_of_tendsto htU (Eventually.of_forall hC_u)
  intro y
  exact hall y

theorem multiplication_cyclic (ho : CoordinateOrderContinuous H.repr) :
    (H.multiplication ho).Cyclic := by
  obtain ⟨v, hv⟩ := H.positive
  exact ⟨v, H.multiplication_cyclicVector ho v hv⟩

end FrameAssociatedSpace

#print axioms FrameAssociatedSpace.multiplication_cyclicVector
#print axioms FrameAssociatedSpace.multiplication_cyclic

end AssociatedCyclicity


noncomputable section AssociatedKBDilation

open MeasureTheory

universe uΩ uX

variable {Ω : Type uΩ} {X : Type uX} {Y : Type*} [MeasurableSpace Ω]
  [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X]
  [NormedAddCommGroup Y] [NormedSpace ℝ Y] [CompleteSpace Y] {η : Measure Ω}

namespace FrameAssociatedSpace

variable {F : ContinuousSchauderFrame (X := X) η} (H : FrameAssociatedSpace (Y := Y) F)

/-- The multiplication PVM extends the original OVM. -/
def dilation (ho : CoordinateOrderContinuous H.repr) : Dilation F.operatorMeasure Y :=
  ⟨H.multiplication ho, H.synthesis, H.analysis, H.split, H.compress_cut⟩

omit [CompleteSpace X] in
/-- For a KB function space, disjointly supported partial sums converge
whenever their norms are bounded. -/
theorem multiplication_boundedlyComplete (ho : CoordinateOrderContinuous H.repr)
    (hk : CoordinateKB H.repr) : (H.multiplication ho).BoundedlyComplete := by
  classical
  intro A z hA hz hb
  let q (n : ℕ) := ∑ i ∈ Finset.range n, z i
  let E (n : ℕ) := MeasSet.finiteUnion A (Finset.range n)
  let P := H.multiplication ho
  have hc (i j : ℕ) (hij : i ≤ j) : H.cut (E i) (q j) = q i :=
    (P.finite_subsum_eq A hA z hz (Finset.range i) j (Finset.range_mono hij)).symm
  have hq (i j : ℕ) (hij : i ≤ j) : (fun t => H.repr (q i) t) =ᵐ[η]
      (E i).1.indicator (H.repr (q j)) := by rw [← hc i j hij]; exact H.repr_cut _ _
  have h_abs (n : ℕ) : ∃ w : Y, ((fun t => H.repr w t) =ᵐ[η] fun t => |H.repr (q n) t|) ∧
      ‖w‖ ≤ ‖q n‖ := by
    let b := AEEqFun.comp abs continuous_abs (H.repr (q n))
    have he : (fun t => b t) =ᵐ[η] fun t => |H.repr (q n) t| :=
      AEEqFun.coeFn_comp abs continuous_abs (H.repr (q n))
    obtain ⟨y, hy, hn⟩ := H.solid (q n) b (by
      filter_upwards [he] with t ht
      simp [ht])
    exact ⟨y, hy.symm ▸ he, hn⟩
  choose w hw hwn using h_abs
  have hwp (n : ℕ) : ∀ᵐ t ∂η, 0 ≤ H.repr (w n) t := by
    filter_upwards [hw n] with t ht
    rw [ht]
    exact abs_nonneg _
  have hwm (i j : ℕ) (hij : i ≤ j) : ∀ᵐ t ∂η, H.repr (w i) t ≤ H.repr (w j) t := by
    filter_upwards [hw i, hw j, hq i j hij] with t hi hj ht
    rw [hi, hj, ht]
    by_cases he : t ∈ (E i).1 <;> simp [he]
  obtain ⟨C, hC⟩ := hb
  obtain ⟨_, hlim⟩ := hk w hwp hwm ⟨C, fun n => (hwn n).trans (hC n)⟩
  have hdist (i j : ℕ) (hij : i ≤ j) : dist (q j) (q i) ≤ dist (w j) (w i) := by
    rw [dist_eq_norm, dist_eq_norm]
    apply H.abs_le_implies_norm_le
    filter_upwards [H.repr_sub (q j) (q i), H.repr_sub (w j) (w i), hw i, hw j, hq i j hij]
      with t hq' hw' hi hj he
    rw [hq', hw', hi, hj, he]
    by_cases hE : t ∈ (E i).1 <;> simp [hE]
  have hCau : CauchySeq q := by
    apply Metric.cauchySeq_iff.mpr
    intro ε hε
    obtain ⟨N, hN⟩ := Metric.cauchySeq_iff.mp hlim.cauchySeq ε hε
    refine ⟨N, fun i hi j hj => ?_⟩
    rcases le_total i j with h | h
    · rw [dist_comm]
      exact (hdist i j h).trans_lt (hN j hj i hi)
    · exact (hdist j i h).trans_lt (hN i hi j hj)
  exact cauchySeq_tendsto_of_complete hCau

theorem not_contains_cZero_of_coordinateKB (ho : CoordinateOrderContinuous H.repr)
    (hk : CoordinateKB H.repr) : ¬ ContainsCopy CZero X :=
  (H.dilation ho).not_contains_cZero_of_boundedlyComplete_cyclic
    (H.multiplication_cyclic ho) (H.multiplication_boundedlyComplete ho hk)

end FrameAssociatedSpace

/-- Manuscript, cor:associated-spaces, with both implications in each
assertion and the original coefficient and Pettis identities. -/
theorem ContinuousSchauderFrame.associated_geometry_iff
    [TopologicalSpace.SeparableSpace X] [SigmaFinite η]
    (F : ContinuousSchauderFrame (X := X) η) :
    ((¬ ContainsCopy LOne X) ↔ ∃ M : FrameAssociatedModel F,
      M.IsOrderContinuous F ∧ (letI := M.normedGroup; letI := M.normedScalar;
        ¬ ContainsCopy LOne M.carrier)) ∧
    ((¬ ContainsCopy CZero X) ↔ ∃ M : FrameAssociatedModel F, M.IsOrderContinuous F ∧ M.IsKB F) ∧
    (IsReflexive X ↔ ∃ M : FrameAssociatedModel F,
      letI := M.normedGroup; letI := M.normedScalar; IsReflexive M.carrier) := by
  obtain ⟨h₁, h₂, h₃⟩ := F.exists_associated_with_geometry
  refine ⟨⟨h₁, ?_⟩, ⟨h₂, ?_⟩, ⟨fun h => ?_, ?_⟩⟩
  · rintro ⟨M, _, hM⟩
    let := M.normedGroup
    let := M.normedScalar
    exact M.data.not_contains_lOne_of_associated hM
  · rintro ⟨M, ho, hk⟩
    let := M.normedGroup
    let := M.normedScalar
    let := M.complete
    exact M.data.not_contains_cZero_of_coordinateKB ho hk
  · obtain ⟨M, _, hr⟩ := h₃ h
    exact ⟨M, hr⟩
  · rintro ⟨M, hM⟩
    let := M.normedGroup
    let := M.normedScalar
    exact M.data.reflexive_underlying hM

#print axioms FrameAssociatedSpace.multiplication_boundedlyComplete
#print axioms ContinuousSchauderFrame.associated_geometry_iff

end AssociatedKBDilation


noncomputable section AssociatedDiscrete

open MeasureTheory

variable {Ω X Y : Type*} [MeasurableSpace Ω] [NormedAddCommGroup X] [NormedSpace ℝ X]
  [NormedAddCommGroup Y] [NormedSpace ℝ Y] [CompleteSpace Y] {η : Measure Ω}

theorem FrameAssociatedSpace.multiplication_shrinking
    {F : ContinuousSchauderFrame (X := X) η} (H : FrameAssociatedSpace (Y := Y) F)
    (ho : CoordinateOrderContinuous H.repr) (h : ¬ ContainsCopy LOne Y) :
    (H.multiplication ho).toOVM.Shrinking :=
  (H.multiplication ho).toOVM.shrinking_of_not_contains_lOne h

omit [CompleteSpace Y] in
/-- Over counting measure the vectors with the singleton indicator
coordinates form the unconditional associated basis. -/
theorem FrameAssociatedSpace.exists_unconditional_associated_basis
    {F : ContinuousSchauderFrame (X := X) (Measure.count (α := ℕ))}
    (H : FrameAssociatedSpace (Y := Y) F) (ho : CoordinateOrderContinuous H.repr) :
    ∃ e : ℕ → Y,
      (∀ n t, H.repr (e n) t = if t = n then 1 else 0) ∧
      (∀ n y, H.cut (MeasSet.natAtom n) y = H.repr y n • e n) ∧
      (∀ y, ∃! b : ℕ → ℝ, HasSum (fun n => b n • e n) y) ∧
      (∀ n, H.synthesis (e n) = F.vector n) ∧
      ∀ x, HasSum (fun n => F.functional n x • e n) (H.analysis x) := by
  classical
  obtain ⟨v, hv⟩ := H.positive
  have hpositive n := Measure.ae_count_iff.mp hv n
  let e (n : ℕ) : Y := (H.repr v n)⁻¹ • H.cut (MeasSet.natAtom n) v
  have he (n t : ℕ) : H.repr (e n) t = if t = n then 1 else 0 := by
    change H.repr ((H.repr v n)⁻¹ • H.cut (MeasSet.natAtom n) v) t = _
    have h₁ : ∀ t, H.repr (e n) t = (H.repr v n)⁻¹ * H.repr (H.cut (MeasSet.natAtom n) v) t :=
      Measure.ae_count_iff.mp (H.repr_smul (H.repr v n)⁻¹ (H.cut (MeasSet.natAtom n) v))
    have h₂ : ∀ t, H.repr (H.cut (MeasSet.natAtom n) v) t = (MeasSet.natAtom n).1.indicator (H.repr v) t :=
      Measure.ae_count_iff.mp (H.repr_cut (MeasSet.natAtom n) v)
    rw [h₁ t, h₂ t]
    by_cases ht : t = n
    · subst t
      simp only [ite_true, MeasSet.natAtom, indicator_of_mem (mem_singleton n)]
      exact inv_mul_cancel₀ (hpositive n).ne'
    · simp [MeasSet.natAtom, ht]
  have hp (n : ℕ) (y : Y) : H.cut (MeasSet.natAtom n) y = H.repr y n • e n := by
    apply H.repr_injective
    apply AEEqFun.ext
    apply Measure.ae_count_iff.mpr
    intro t
    have h₁ : ∀ t, H.repr (H.cut (MeasSet.natAtom n) y) t = (MeasSet.natAtom n).1.indicator (H.repr y) t :=
      Measure.ae_count_iff.mp (H.repr_cut (MeasSet.natAtom n) y)
    have h₂ : ∀ t, H.repr (H.repr y n • e n) t = H.repr y n * H.repr (e n) t :=
      Measure.ae_count_iff.mp (H.repr_smul (H.repr y n) (e n))
    rw [h₁ t, h₂ t, he]
    by_cases ht : t = n
    · subst t
      simp [MeasSet.natAtom]
    · simp [MeasSet.natAtom, ht]
  let P := H.multiplication ho
  have hs (y : Y) : HasSum (fun n => H.repr y n • e n) y := by
    have h := P.toOVM.natAtom_hasSum MeasSet.whole y
    have hn : P.val MeasSet.whole = ContinuousLinearMap.id ℝ Y := P.normalized
    rw [hn] at h
    simpa only [MeasSet.whole, Set.mem_univ, ite_true, ContinuousLinearMap.id_apply, P,
      FrameAssociatedSpace.multiplication, hp] using h
  refine ⟨e, he, hp, fun y => ⟨fun n => H.repr y n, hs y, ?_⟩, ?_, ?_⟩
  · intro b hb
    obtain ⟨z, _, huniq⟩ := P.nat_unconditionalDecomposition y
    have hR (n : ℕ) (c : ℝ) : c • e n ∈ (P.val (MeasSet.natAtom n)).toLinearMap.range := by
      refine ⟨c • e n, ?_⟩
      change H.cut (MeasSet.natAtom n) (c • e n) = c • e n
      rw [map_smul, hp, he, ite_eq_left rfl, one_smul]
    have hL := huniq (fun n => H.repr y n • e n) ⟨fun n => hR n _, hs y⟩
    have hB := huniq (fun n => b n • e n) ⟨fun n => hR n _, hb⟩
    funext n
    have ht := congrArg (fun y : Y => H.repr y n) (congrFun (hB.trans hL.symm) n)
    have hq (c : ℝ) : H.repr (c • e n) n = c := by
      have h : ∀ t, H.repr (c • e n) t = c * H.repr (e n) t :=
        Measure.ae_count_iff.mp (H.repr_smul c (e n))
      rw [h n, he, ite_eq_left rfl, mul_one]
    simpa only [hq] using ht
  · intro n
    apply eq_of_dual_eval
    intro g
    rw [H.synthesis_coeff]
    have h : (fun t => H.repr (e n) t * g (F.vector t)) =
        ({n} : Set ℕ).indicator (fun t => g (F.vector t)) := by
      funext t
      rw [he]
      by_cases ht : t = n <;> simp [ht]
    rw [h, integral_indicator (measurableSet_singleton n), integral_singleton]
    simp
  · intro x
    have h := hs (H.analysis x)
    have ht (n : ℕ) := Measure.ae_count_iff.mp (H.analysis_coeff x) n
    simpa only [ht] using h

#print axioms FrameAssociatedSpace.multiplication_shrinking
#print axioms FrameAssociatedSpace.exists_unconditional_associated_basis

end AssociatedDiscrete


noncomputable section AssociatedZeroSetConsequences

open MeasureTheory

variable {Ω X : Type*} [MeasurableSpace Ω]
  [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X] {η : Measure Ω}

/-- If the nonzero frame vectors have full measure, the first component
alone retains all analysis coefficients and Pettis synthesis. -/
theorem FrameLeftKotheDilation.exists_associated_without_zero_summand
    {F : ContinuousSchauderFrame (X := X) η} {A : MeasSet Ω} {w : Ω → ℝ}
    (D : FrameLeftKotheDilation F A w) (hwm : Measurable w) (hwp : ∀ t, 0 < w t)
    (hzero : ∀ t, t ∉ A.1 → F.vector t = 0) (ha : ∀ᵐ t ∂η, t ∈ A.1) :
    letI := D.normedGroup; letI := D.normedScalar;
    ∃ H : FrameAssociatedSpace (Y := D.carrier) F,
      H.analysis = D.dilation.T ∧ H.synthesis = D.dilation.S ∧
      CoordinateOrderContinuous H.repr ∧ (KotheKB D.scalar → CoordinateKB H.repr) := by
  let := D.normedGroup
  let := D.normedScalar
  obtain ⟨P, hT, hp, hi, _, hoc, hkb, _⟩ := D.exists_coefficientPiece hwm hwp hzero
  have hI (y : D.carrier) (g : Dual X) :
      g (D.dilation.S y) = ∫ t, P.repr y t * g (F.vector t) ∂η := by
    have h := hi y g MeasSet.whole
    have hn : D.dilation.P.val MeasSet.whole = ContinuousLinearMap.id ℝ D.carrier :=
      D.dilation.P.normalized
    rw [hn, ContinuousLinearMap.id_apply] at h
    exact h.trans setIntegral_univ
  let H : FrameAssociatedSpace (Y := D.carrier) F :=
    ⟨P.repr, P.injective, P.solid, ⟨P.one, by
      filter_upwards [P.positive, ha] with t ht hAt
      exact ht hAt⟩, P.analysis, D.dilation.S, fun x => by
        filter_upwards [P.analysis_coeff x, ha] with t ht hAt
        exact ht.trans (indicator_of_mem hAt _), hp, hI⟩
  exact ⟨H, hT, rfl, hoc, hkb⟩

/-- The specific cyclic vector of the weighted direct sum. -/
theorem FrameLeftKotheDilation.exists_cyclic_weighted_assembly
    [TopologicalSpace.SeparableSpace X] [SigmaFinite η]
    {F : ContinuousSchauderFrame (X := X) η} {A : MeasSet Ω} {w : Ω → ℝ}
    (D : FrameLeftKotheDilation F A w) (hwm : Measurable w) (hwp : ∀ t, 0 < w t)
    (hzero : ∀ t, t ∉ A.1 → F.vector t = 0) :
    ∃ a : Ω → ℝ, let ρ := (η.restrict A.1ᶜ).withDensity (fun t => ENNReal.ofReal (a t))
      letI := D.normedGroup; letI := D.normedScalar;
      ∃ (H : FrameAssociatedSpace (Y := WithLp 2 (D.carrier × Lp ℝ 2 ρ)) F)
        (ho : CoordinateOrderContinuous H.repr) (v : WithLp 2 (D.carrier × Lp ℝ 2 ρ)),
        ((fun t => H.repr v t) =ᵐ[η] fun t => A.1.indicator w t + A.1ᶜ.indicator (fun _ => 1) t) ∧
        (H.multiplication ho).CyclicVector v := by
  let := D.normedGroup
  let := D.normedScalar
  obtain ⟨a, _, _, _, _, H, ho, _, v, hv⟩ := D.exists_weighted_assembly hwm hwp hzero
  refine ⟨a, H, ho, v, hv, H.multiplication_cyclicVector ho v ?_⟩
  filter_upwards [hv] with t ht
  rw [ht]
  by_cases hA : t ∈ A.1
  · simpa [hA] using hwp t
  · simp [hA]

/-- A discrete unconditional frame is the same given coefficient and
vector fields over counting measure. -/
def IsUnconditionalSchauderFrame.countingFrame {y : ℕ → X} {g : ℕ → Dual X}
    (h : IsUnconditionalSchauderFrame y g) :
    ContinuousSchauderFrame (X := X) (Measure.count (α := ℕ)) where
  vector := y
  functional := g
  weaklyMeasurable k := measurable_of_countable _
  weakStarMeasurable x := measurable_of_countable _
  pettis x := by
    let z (n : ℕ) := g n x • y n
    have hh : HasSum z x := h x
    have hs (k : Dual X) : Summable (fun n => k (z n)) := (hh.map k k.continuous).summable
    have hi (k : Dual X) : Integrable (fun n => k (z n)) Measure.count :=
      integrable_count_iff.mpr (summable_norm_iff.mpr (hs k))
    refine ⟨fun k => ⟨measurable_of_countable _, hi k⟩, fun E => ?_⟩
    let u := E.1.indicator z
    have hu : Summable u := hh.summable.indicator E.1
    refine ⟨∑' n, u n, fun k => ?_⟩
    have he (n : ℕ) : k (u n) = E.1.indicator (fun m => k (z m)) n := by
      by_cases hn : n ∈ E.1 <;> simp [u, hn]
    rw [← integral_indicator E.2, integral_countable ((hi k).indicator E.2)]
    simp only [Measure.real, Measure.count_singleton, ENNReal.toReal_one, one_smul]
    calc
      k (∑' n, u n) = ∑' n, k (u n) := ((hu.hasSum.map k k.continuous).tsum_eq).symm
      _ = _ := tsum_congr he
  reconstruction x k := by
    let z (n : ℕ) := g n x • y n
    have hh : HasSum z x := h x
    have hs : HasSum (fun n => k (z n)) (k x) := hh.map k k.continuous
    have hi : Integrable (fun n => k (z n)) Measure.count :=
      integrable_count_iff.mpr (summable_norm_iff.mpr hs.summable)
    have hi' : Integrable (fun t => g t x * k (y t)) Measure.count := by
      simpa only [z, map_smul, smul_eq_mul] using hi
    rw [integral_countable hi']
    simp only [Measure.real, Measure.count_singleton, ENNReal.toReal_one, one_smul]
    simpa only [z, map_smul, smul_eq_mul] using hs.tsum_eq.symm

#print axioms FrameLeftKotheDilation.exists_associated_without_zero_summand
#print axioms FrameLeftKotheDilation.exists_cyclic_weighted_assembly
#print axioms IsUnconditionalSchauderFrame.countingFrame

end AssociatedZeroSetConsequences

noncomputable section SpectralFrameCompactness

variable {X Y : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]
  [NormedAddCommGroup Y] [NormedSpace ℝ Y]

/-- The compactness obstruction used by the diagonal of the Hardy
compression. It also applies after restriction of complex scalars. -/
theorem not_isCompactOperator_of_weaklyNull_norm_lower
    (T : X →L[ℝ] Y) (x : ℕ → X) (hx : ∀ n, ‖x n‖ ≤ 1)
    (hw : ∀ f : Dual X, Tendsto (fun n => f (x n)) atTop (𝓝 0))
    (c : ℝ) (hc : 0 < c) (hb : ∀ n, c ≤ ‖T (x n)‖) :
    ¬ IsCompactOperator T := by
  intro hT
  have hK := hT.isCompact_closure_image_closedBall (f := T.toLinearMap) 1
  have hm (n : ℕ) : T (x n) ∈ closure (T '' Metric.closedBall (0 : X) 1) :=
    subset_closure ⟨x n, mem_closedBall_zero_iff.mpr (hx n), rfl⟩
  obtain ⟨y, _, φ, hφ, hy⟩ := hK.isSeqCompact hm
  have hzero : y = 0 := by
    apply eq_of_dual_eval
    intro g
    have h₁ := (g.continuous.tendsto y).comp hy
    have h₂ := (hw (g.comp T)).comp hφ.tendsto_atTop
    exact (tendsto_nhds_unique h₁ h₂).trans (map_zero g).symm
  rw [hzero] at hy
  have hn : Tendsto (fun n => ‖T (x (φ n))‖) atTop (𝓝 0) := by
    simpa only [Function.comp_def, norm_zero] using hy.norm
  have hl : ∀ᶠ n in atTop, ‖T (x (φ n))‖ < c := (tendsto_order.mp hn).2 c hc
  obtain ⟨n, hn⟩ := hl.exists
  exact (not_lt_of_ge (hb (φ n))) hn

#print axioms not_isCompactOperator_of_weaklyNull_norm_lower

end SpectralFrameCompactness


noncomputable section ComplexLocalCompactness

open MeasureTheory
open scoped ENNReal

variable {Ω X : Type*} [MeasurableSpace Ω] [NormedAddCommGroup X]
  [NormedSpace ℂ X] [NormedSpace ℝ X] [IsScalarTower ℝ ℂ X] [CompleteSpace X]
  {η : Measure Ω}

private def complexIntegralOperator (v : Ω → X) (hv : Integrable v η)
    (f : Ω → X →L[ℂ] ℂ) (hf : ∀ x, Measurable (fun t => f t x))
    (C : ℝ) (hC : ∀ᵐ t ∂η, ‖f t‖ ≤ C) : X →L[ℂ] X := by
  have hi (x : X) : Integrable (fun t => f t x • v t) η :=
    hv.bdd_smul (C * ‖x‖) (hf x).aestronglyMeasurable
      (hC.mono fun t ht => ((f t).le_opNorm x).trans
        (mul_le_mul_of_nonneg_right ht (norm_nonneg x)))
  refine ({
    toFun := fun x => ∫ t, f t x • v t ∂η
    map_add' := fun x y => by
      simp_rw [map_add, add_smul]
      exact integral_add (hi x) (hi y)
    map_smul' := fun c x => by
      rw [← integral_smul]
      congr 1
      funext t
      rw [map_smul]
      exact mul_smul c (f t x) (v t)
    } : X →ₗ[ℂ] X).mkContinuous (C * ∫ t, ‖v t‖ ∂η) (fun x => ?_)
  change ‖∫ t, f t x • v t ∂η‖ ≤ _
  refine (norm_integral_le_integral_norm _).trans ?_
  rw [mul_right_comm, ← integral_const_mul]
  apply integral_mono_ae (hi x).norm (hv.norm.const_mul (C * ‖x‖))
  filter_upwards [hC] with t ht
  rw [norm_smul]
  exact mul_le_mul_of_nonneg_right (((f t).le_opNorm x).trans
    (mul_le_mul_of_nonneg_right ht (norm_nonneg x))) (norm_nonneg _)

omit [CompleteSpace X] in
private theorem complexIntegralOperator_apply (v : Ω → X) (hv : Integrable v η)
    (f : Ω → X →L[ℂ] ℂ) (hf : ∀ x, Measurable (fun t => f t x))
    (C : ℝ) (hC : ∀ᵐ t ∂η, ‖f t‖ ≤ C) (x : X) :
    complexIntegralOperator v hv f hf C hC x = ∫ t, f t x • v t ∂η := rfl

private theorem compact_complexIntegralOperator_simple (v : SimpleFunc Ω X) (hv : Integrable v η)
    (f : Ω → X →L[ℂ] ℂ) (hf : ∀ x, Measurable (fun t => f t x))
    (C : ℝ) (hC : ∀ᵐ t ∂η, ‖f t‖ ≤ C) :
    IsCompactOperator (complexIntegralOperator v hv f hf C hC) := by
  let W := Submodule.span ℂ (↑v.range : Set X)
  let : FiniteDimensional ℂ W := FiniteDimensional.span_of_finite ℂ v.range.finite_toSet
  let : IsClosed (W : Set X) := W.isClosed_of_finiteDimensional
  let q := W.mkQL.restrictScalars ℝ
  have hm (x : X) : complexIntegralOperator v hv f hf C hC x ∈ W := by
    apply (Submodule.Quotient.mk_eq_zero W).mp
    change q (complexIntegralOperator v hv f hf C hC x) = 0
    rw [complexIntegralOperator_apply, ← q.integral_comp_comm]
    · have hzero (t : Ω) : q (f t x • v t) = 0 :=
        (Submodule.Quotient.mk_eq_zero W).mpr
          (W.smul_mem _ (Submodule.subset_span (v.mem_range_self t)))
      simp only [hzero, integral_zero]
    · exact hv.bdd_smul (C * ‖x‖) (hf x).aestronglyMeasurable
        (hC.mono fun t ht => ((f t).le_opNorm x).trans
          (mul_le_mul_of_nonneg_right ht (norm_nonneg x)))
  have hinc := isCompactOperator_of_locallyCompactSpace_rng (σ₂₃ := RingHom.id ℂ) W.subtypeL
  convert hinc.comp_clm ((complexIntegralOperator v hv f hf C hC).codRestrict W hm) using 1
  rfl

/-- A weak-star measurable bounded field of scalar functionals and an
integrable vector field give a compact, operator-norm approximable map. -/
theorem compact_complexIntegralOperator (v : Ω → X) (hv : Integrable v η)
    (f : Ω → X →L[ℂ] ℂ) (hf : ∀ x, Measurable (fun t => f t x))
    (C : ℝ) (hC₀ : 0 ≤ C) (hC : ∀ᵐ t ∂η, ‖f t‖ ≤ C) :
    IsCompactOperator (complexIntegralOperator v hv f hf C hC) := by
  classical
  let T := complexIntegralOperator v hv f hf C hC
  let δ (n : ℕ) := (1 / 2 : ℝ) ^ n
  have hδ (n : ℕ) : 0 < δ n := by dsimp only [δ]; positivity
  have hm : MemLp v 1 η := memLp_one_iff_integrable.mpr hv
  have happrox (n : ℕ) : ∃ s : SimpleFunc Ω X, Integrable s η ∧
      (∫ t, ‖v t - s t‖ ∂η) < δ n := by
    obtain ⟨s, hs, hsi⟩ := hm.exists_simpleFunc_eLpNorm_sub_lt (by simp)
      (ENNReal.ofReal_pos.mpr (hδ n)).ne'
    have hsub := memLp_one_iff_integrable.mp (hm.sub hsi)
    rw [eLpNorm_one_eq_lintegral_eNorm hsub.aestronglyMeasurable,
      ← ofReal_integral_norm_eq_lintegral_eNorm hsub] at hs
    exact ⟨s, memLp_one_iff_integrable.mp hsi, (ENNReal.ofReal_lt_ofReal_iff (hδ n)).mp hs⟩
  choose s hs hse using happrox
  let A (n : ℕ) := complexIntegralOperator (s n) (hs n) f hf C hC
  have hb (n : ℕ) : ‖T - A n‖ ≤ C * δ n := by
    apply ContinuousLinearMap.opNorm_le_of_unit_norm (mul_nonneg hC₀ (hδ n).le)
    intro x hx
    have hi (u : Ω → X) (hu : Integrable u η) :
        Integrable (fun t => f t x • u t) η :=
      hu.bdd_smul C (hf x).aestronglyMeasurable (hC.mono fun t ht => by
        simpa only [hx, mul_one] using ((f t).le_opNorm x).trans
          (mul_le_mul_of_nonneg_right ht (norm_nonneg x)))
    change ‖T x - A n x‖ ≤ _
    simp only [T, A, complexIntegralOperator_apply]
    rw [← integral_sub (hi v hv) (hi (s n) (hs n))]
    simp_rw [← smul_sub]
    refine (norm_integral_le_integral_norm _).trans ?_
    have hu : Integrable (fun t => v t - s n t) η := hv.sub (hs n)
    calc
      _ ≤ ∫ t, C * ‖v t - s n t‖ ∂η := by
        apply integral_mono_ae (hi _ hu).norm (hu.norm.const_mul C)
        filter_upwards [hC] with t ht
        rw [norm_smul]
        exact mul_le_mul_of_nonneg_right (by
          simpa only [hx, mul_one] using ((f t).le_opNorm x).trans
            (mul_le_mul_of_nonneg_right ht (norm_nonneg x))) (norm_nonneg _)
      _ = C * ∫ t, ‖v t - s n t‖ ∂η := integral_const_mul _ _
      _ ≤ C * δ n := mul_le_mul_of_nonneg_left (hse n).le hC₀
  apply isCompactOperator_of_tendsto (F := A) (l := atTop)
  · rw [tendsto_iff_norm_sub_tendsto_zero]
    refine squeeze_zero (g := fun n => C * δ n) (fun _ => norm_nonneg _) (fun n => ?_) ?_
    · rw [norm_sub_rev]
      exact hb n
    · simpa only [mul_zero] using
        (tendsto_pow_atTop_nhds_zero_of_lt_one (show 0 ≤ (1 / 2 : ℝ) by norm_num) (by norm_num)).const_mul C
  · exact Eventually.of_forall fun n => compact_complexIntegralOperator_simple (s n) (hs n) f hf C hC

#print axioms compact_complexIntegralOperator

end ComplexLocalCompactness

noncomputable section ComplexFrameLocality

open MeasureTheory
open scoped ENNReal

variable {Ω X : Type*} [MeasurableSpace Ω] [NormedAddCommGroup X]
  [NormedSpace ℂ X] [NormedSpace ℝ X] [IsScalarTower ℝ ℂ X]

/-- Complex scalar Pettis evaluation of the rank-one field on the
given measurable space and with the given operator values. -/
structure ComplexSchauderRepresentation (η : Measure Ω)
    (μ : MeasSet Ω → X →L[ℂ] X) where
  vector : Ω → X
  functional : Ω → X →L[ℂ] ℂ
  weaklyMeasurable : ∀ g : X →L[ℂ] ℂ, Measurable (fun t => g (vector t))
  weakStarMeasurable : ∀ x : X, Measurable (fun t => functional t x)
  scalar_integrable : ∀ x (g : X →L[ℂ] ℂ),
    Integrable (fun t => functional t x * g (vector t)) η
  cut_apply : ∀ E x (g : X →L[ℂ] ℂ), g (μ E x) =
    ∫ t in E.1, functional t x * g (vector t) ∂η

omit [NormedSpace ℝ X] [IsScalarTower ℝ ℂ X] in
theorem complex_opNorm_measurable [TopologicalSpace.SeparableSpace X]
    (f : Ω → X →L[ℂ] ℂ) (hf : ∀ x, Measurable (fun t => f t x)) :
    Measurable (fun t => ‖f t‖) := by
  let U := {x : X | ‖x‖ ≤ 1}
  let : Nonempty U := ⟨⟨0, by simp [U]⟩⟩
  let d : ℕ → U := TopologicalSpace.denseSeq U
  have hd : DenseRange d := TopologicalSpace.denseRange_denseSeq U
  have hnorm (g : X →L[ℂ] ℂ) : ‖g‖ = ⨆ n, ‖g (d n : X)‖ := by
    have hbd (n : ℕ) : ‖g (d n : X)‖ ≤ ‖g‖ :=
      (g.le_opNorm _).trans ((mul_le_mul_of_nonneg_left (d n).2 (norm_nonneg g)).trans_eq (mul_one _))
    have hb : BddAbove (Set.range (fun n => ‖g (d n : X)‖)) := ⟨‖g‖, by
      rintro _ ⟨n, rfl⟩
      exact hbd n⟩
    let C : ℝ := ⨆ n, ‖g (d n : X)‖
    have hC (n : ℕ) : ‖g (d n : X)‖ ≤ C := le_ciSup hb n
    apply le_antisymm
    · apply ContinuousLinearMap.opNorm_le_of_unit_norm ((norm_nonneg _).trans (hC 0))
      intro x hx
      let z : U := ⟨x, hx.le⟩
      have hc : IsClosed {y : U | ‖g (y : X)‖ ≤ C} :=
        isClosed_le (g.continuous.comp continuous_subtype_val).norm continuous_const
      have hr : Set.range d ⊆ {y : U | ‖g (y : X)‖ ≤ C} := by
        rintro _ ⟨n, rfl⟩
        exact hC n
      exact closure_minimal hr hc (hd z)
    · exact ciSup_le hbd
  have he : (fun t => ‖f t‖) = fun t => ⨆ n, ‖f t (d n : X)‖ :=
    funext fun t => hnorm (f t)
  rw [he]
  exact Measurable.iSup fun n => (hf (d n : X)).norm

/-- The local compactness consequence of prop:frame-dilation over ℂ. -/
theorem ComplexSchauderRepresentation.exists_locally_compact_partition
    [CompleteSpace X] [TopologicalSpace.SeparableSpace X]
    {η : Measure Ω} [SigmaFinite η] {μ : MeasSet Ω → X →L[ℂ] X}
    (F : ComplexSchauderRepresentation η μ) :
    ∃ D : ℕ → MeasSet Ω, MeasSet.DisjointSeq D ∧ MeasSet.iUnion D = MeasSet.whole ∧
      ∀ n E, E.1 ⊆ (D n).1 → IsCompactOperator (μ E) := by
  have hV := citePettisMeasurability F.vector (fun g => by
    let g' : X →L[ℂ] ℂ := StrongDual.extendRCLike (𝕜 := ℂ) g
    have he (x : X) : (g' x).re = g x := StrongDual.re_extendRCLike_apply (𝕜 := ℂ) g x
    simp_rw [← he]
    exact Complex.continuous_re.measurable.comp (F.weaklyMeasurable g'))
  let : MeasurableSpace X := borel X
  let : BorelSpace X := ⟨rfl⟩
  have hv := hV.measurable.norm
  have hf := complex_opNorm_measurable F.functional F.weakStarMeasurable
  let A (n : ℕ) : Set Ω := spanningSets η n ∩
    ({t | ‖F.vector t‖ ≤ (n : ℝ)} ∩ {t | ‖F.functional t‖ ≤ (n : ℝ)})
  have hA (n : ℕ) : MeasurableSet (A n) :=
    (measurableSet_spanningSets η n).inter
      ((measurableSet_le hv measurable_const).inter (measurableSet_le hf measurable_const))
  have hcover : ⋃ n, A n = univ := by
    ext t
    constructor
    · intro _
      exact mem_univ _
    · intro _
      have ht : t ∈ ⋃ n, spanningSets η n := by rw [iUnion_spanningSets]; exact mem_univ _
      obtain ⟨m, hm⟩ := mem_iUnion.mp ht
      obtain ⟨k, hk⟩ := exists_nat_ge (max ‖F.vector t‖ ‖F.functional t‖)
      have hmk : (k : ℝ) ≤ ((max m k : ℕ) : ℝ) := by exact_mod_cast le_max_right m k
      refine mem_iUnion.mpr ⟨max m k, spanningSets_mono (le_max_left m k) hm, ?_, ?_⟩
      · exact ((le_max_left _ _).trans hk).trans hmk
      · exact ((le_max_right _ _).trans hk).trans hmk
  let D (n : ℕ) : MeasSet Ω := ⟨disjointed A n, MeasurableSet.disjointed hA n⟩
  refine ⟨D, disjoint_disjointed A, Subtype.ext (iUnion_disjointed.trans hcover), fun n E hE => ?_⟩
  have hsub : E.1 ⊆ A n := hE.trans (disjointed_subset A n)
  have hfin : η E.1 < ∞ :=
    (measure_mono (hsub.trans inter_subset_left)).trans_lt (measure_spanningSets_lt_top η n)
  have hvi : Integrable F.vector (η.restrict E.1) := by
    apply IntegrableOn.of_bound hfin hV.aestronglyMeasurable n
    filter_upwards [ae_restrict_mem E.2] with t ht
    exact (hsub ht).2.1
  have hfb : ∀ᵐ t ∂(η.restrict E.1), ‖F.functional t‖ ≤ (n : ℝ) := by
    filter_upwards [ae_restrict_mem E.2] with t ht
    exact (hsub ht).2.2
  let K := complexIntegralOperator F.vector hvi F.functional F.weakStarMeasurable n hfb
  have hK := compact_complexIntegralOperator F.vector hvi F.functional F.weakStarMeasurable
    n (by positivity) hfb
  have heq : μ E = K := by
    ext x
    apply eq_of_dual_eval
    intro g
    let g' : X →L[ℂ] ℂ := StrongDual.extendRCLike (𝕜 := ℂ) g
    have hg (y : X) : (g' y).re = g y := StrongDual.re_extendRCLike_apply (𝕜 := ℂ) g y
    rw [← hg, ← hg]
    congr 1
    rw [F.cut_apply, show K x = ∫ t in E.1, F.functional t x • F.vector t ∂η from rfl]
    have hi : Integrable (fun t => F.functional t x • F.vector t) (η.restrict E.1) :=
      hvi.bdd_smul ((n : ℝ) * ‖x‖) (F.weakStarMeasurable x).aestronglyMeasurable
        (hfb.mono fun t ht => ((F.functional t).le_opNorm x).trans
          (mul_le_mul_of_nonneg_right ht (norm_nonneg x)))
    rw [← g'.integral_comp_comm hi]
    simp_rw [map_smul, smul_eq_mul]
  exact heq ▸ hK

#print axioms ComplexSchauderRepresentation.exists_locally_compact_partition

end ComplexFrameLocality


noncomputable section ComplexLTwoMultiplication

open MeasureTheory
open scoped ENNReal

variable {Ω : Type*} [MeasurableSpace Ω]

abbrev ComplexLTwo (ρ : Measure Ω) := Lp ℂ 2 ρ

/-- Multiplication by an actual bounded measurable complex symbol. -/
def complexLTwoMultiplier (ρ : Measure Ω) (b : Ω → ℂ) (hb : Measurable b)
    (C : ℝ) (hC : 0 ≤ C) (hbC : ∀ t, ‖b t‖ ≤ C) :
    ComplexLTwo ρ →L[ℂ] ComplexLTwo ρ := by
  let z (u : ComplexLTwo ρ) : Ω → ℂ := fun t => b t * u t
  have hz (u : ComplexLTwo ρ) : MemLp (z u) 2 ρ := by
    apply (Lp.memLp u).of_le_mul (c := C) (hb.aestronglyMeasurable.mul (Lp.aestronglyMeasurable u))
    exact Eventually.of_forall fun t => by
      change ‖b t * u t‖ ≤ C * ‖u t‖
      rw [norm_mul]
      exact mul_le_mul_of_nonneg_right (hbC t) (norm_nonneg _)
  let A (u : ComplexLTwo ρ) := (hz u).toLp (z u)
  have hA (u : ComplexLTwo ρ) : (fun t => A u t) =ᵐ[ρ] z u := (hz u).coeFn_toLp
  let L : ComplexLTwo ρ →ₗ[ℂ] ComplexLTwo ρ :=
    { toFun := A
      map_add' := fun u v => by
        apply Lp.ext
        filter_upwards [hA (u + v), hA u, hA v, Lp.coeFn_add u v, Lp.coeFn_add (A u) (A v)] with t h₁ h₂ h₃ h₄ h₅
        change A (u + v) t = (A u + A v) t
        rw [h₁, h₅]
        change b t * (u + v) t = A u t + A v t
        rw [h₄, h₂, h₃]
        change b t * (u t + v t) = b t * u t + b t * v t
        exact mul_add _ _ _
      map_smul' := fun c u => by
        apply Lp.ext
        filter_upwards [hA (c • u), hA u, Lp.coeFn_smul c u, Lp.coeFn_smul c (A u)] with t h₁ h₂ h₃ h₄
        change A (c • u) t = (c • A u) t
        rw [h₁, h₄]
        change b t * (c • u) t = c * A u t
        rw [h₃, h₂]
        change b t * (c * u t) = c * (b t * u t)
        ring }
  refine L.mkContinuous C (fun u => ?_)
  have h : ‖A u‖ ≤ ‖(C : ℝ) • u‖ := by
    apply Lp.norm_le_norm_of_ae_le
    filter_upwards [hA u, Lp.coeFn_smul C u] with t ht hs
    rw [ht, hs]
    change ‖b t * u t‖ ≤ ‖C • u t‖
    rw [norm_mul, norm_smul, Real.norm_of_nonneg hC]
    exact mul_le_mul_of_nonneg_right (hbC t) (norm_nonneg _)
  change ‖A u‖ ≤ C * ‖u‖
  simpa only [norm_smul, Real.norm_of_nonneg hC] using h

theorem complexLTwoMultiplier_apply_ae (ρ : Measure Ω) (b : Ω → ℂ) (hb : Measurable b)
    (C : ℝ) (hC : 0 ≤ C) (hbC : ∀ t, ‖b t‖ ≤ C) (u : ComplexLTwo ρ) :
    (fun t => complexLTwoMultiplier ρ b hb C hC hbC u t) =ᵐ[ρ] fun t => b t * u t :=
  by
    have hm : MemLp (fun t => b t * u t) 2 ρ := by
      apply (Lp.memLp u).of_le_mul (c := C) (hb.aestronglyMeasurable.mul (Lp.aestronglyMeasurable u))
      exact Eventually.of_forall fun t => by
        change ‖b t * u t‖ ≤ C * ‖u t‖
        rw [norm_mul]
        exact mul_le_mul_of_nonneg_right (hbC t) (norm_nonneg _)
    change (fun t => hm.toLp (fun t => b t * u t) t) =ᵐ[ρ] fun t => b t * u t
    exact hm.coeFn_toLp

/-- Characteristic-function multiplication on the actual complex L². -/
def complexLTwoCut (ρ : Measure Ω) (E : MeasSet Ω) : ComplexLTwo ρ →L[ℂ] ComplexLTwo ρ :=
  complexLTwoMultiplier ρ (E.1.indicator (fun _ => 1))
    (measurable_const.indicator E.2) 1 zero_le_one
    (fun t => by by_cases h : t ∈ E.1 <;> simp [h])

theorem complexLTwoCut_apply_ae (ρ : Measure Ω) (E : MeasSet Ω) (u : ComplexLTwo ρ) :
    (fun t => complexLTwoCut ρ E u t) =ᵐ[ρ] E.1.indicator u := by
  apply (complexLTwoMultiplier_apply_ae _ _ _ _ _ _ _).trans
  filter_upwards with t
  by_cases h : t ∈ E.1 <;> simp [h]

private theorem complexLTwoCut_comp (ρ : Measure Ω) (E B : MeasSet Ω) (u : ComplexLTwo ρ) :
    complexLTwoCut ρ E (complexLTwoCut ρ B u) = complexLTwoCut ρ (E.inter B) u := by
  apply Lp.ext
  filter_upwards [complexLTwoCut_apply_ae ρ E (complexLTwoCut ρ B u),
    complexLTwoCut_apply_ae ρ B u, complexLTwoCut_apply_ae ρ (E.inter B) u] with t ht hb hb'
  rw [ht, hb']
  by_cases h₁ : t ∈ E.1 <;> by_cases h₂ : t ∈ B.1 <;> simp [MeasSet.inter, h₁, h₂, hb]

private theorem complexLTwoCut_contract (ρ : Measure Ω) (E : MeasSet Ω) (u : ComplexLTwo ρ) :
    ‖complexLTwoCut ρ E u‖ ≤ ‖u‖ := by
  apply Lp.norm_le_norm_of_ae_le
  filter_upwards [complexLTwoCut_apply_ae ρ E u] with t ht
  rw [ht]
  by_cases he : t ∈ E.1 <;> simp [he]

private theorem complexLTwoCut_empty (ρ : Measure Ω) (u : ComplexLTwo ρ) :
    complexLTwoCut ρ MeasSet.empty u = 0 := by
  apply Lp.ext
  exact (complexLTwoCut_apply_ae ρ MeasSet.empty u).trans
    (by
      rw [show (MeasSet.empty : MeasSet Ω).1 = ∅ from rfl, indicator_empty]
      exact (Lp.coeFn_zero ℂ 2 ρ).symm)

private theorem complexLTwoCut_union (ρ : Measure Ω) (E B : MeasSet Ω) (h : Disjoint E.1 B.1)
    (u : ComplexLTwo ρ) :
    complexLTwoCut ρ (E.union B) u = complexLTwoCut ρ E u + complexLTwoCut ρ B u := by
  apply Lp.ext
  filter_upwards [complexLTwoCut_apply_ae ρ (E.union B) u,
    complexLTwoCut_apply_ae ρ E u, complexLTwoCut_apply_ae ρ B u,
    Lp.coeFn_add (complexLTwoCut ρ E u) (complexLTwoCut ρ B u)] with t hU hE hB hsum
  rw [hU, hsum, Pi.add_apply, hE, hB]
  by_cases h₁ : t ∈ E.1 <;> by_cases h₂ : t ∈ B.1
  · exact (Set.disjoint_left.mp h h₁ h₂).elim
  · simp [MeasSet.union, h₁, h₂]
  · simp [MeasSet.union, h₁, h₂]
  · simp [MeasSet.union, h₁, h₂]

private theorem complexLTwoCut_tendsto_zero (ρ : Measure Ω)
    (D : ℕ → MeasSet Ω) (hD : Antitone (fun n => (D n).1)) (hcap : (⋂ n, (D n).1) = ∅)
    (u : ComplexLTwo ρ) : Tendsto (fun n => ‖complexLTwoCut ρ (D n) u‖) atTop (𝓝 0) := by
  have hI (v : ComplexLTwo ρ) : Integrable (fun t => ‖v t‖ ^ 2) ρ := by
    have h := (Lp.memLp v).norm_rpow (by norm_num) (by norm_num)
    simpa [memLp_one_iff_integrable] using h
  have hnorm (v : ComplexLTwo ρ) : ‖v‖ ^ 2 = ∫ t, ‖v t‖ ^ 2 ∂ρ := by
    rw [Lp.norm_def, ← ENNReal.toReal_pow, eLpNorm_eq_lintegral_rpow_eNorm_toReal
      (by norm_num) (by norm_num) (Lp.aestronglyMeasurable v), ← ENNReal.rpow_natCast,
      ← ENNReal.rpow_mul]
    simp only [ENNReal.toReal_ofNat, Nat.cast_ofNat, show (1 / 2 : ℝ) * 2 = 1 by norm_num, ENNReal.rpow_one]
    rw [integral_eq_lintegral_of_nonneg_ae (Eventually.of_forall fun t => sq_nonneg ‖v t‖)
      (hI v).aestronglyMeasurable]
    congr 1
    apply lintegral_congr
    intro t
    rw [← ofReal_norm, ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) (by norm_num)]
    simp
  let V (n : ℕ) := complexLTwoCut ρ (D n) u
  have ha : ∀ n, (fun t => V n t) =ᵐ[ρ] (D n).1.indicator u :=
    fun n => complexLTwoCut_apply_ae ρ (D n) u
  have hv : ∀ᵐ t ∂ρ, Tendsto (fun n => ‖V n t‖ ^ 2) atTop (𝓝 0) := by
    filter_upwards [ae_all_iff.mpr ha] with t ht
    have hn : ∃ n, t ∉ (D n).1 := by
      by_contra! hn
      have h := Set.mem_iInter.mpr hn
      rw [hcap] at h
      exact h
    obtain ⟨N, hN⟩ := hn
    apply tendsto_const_nhds.congr'
    filter_upwards [eventually_ge_atTop N] with n hn'
    rw [ht n, indicator_of_notMem (fun hmem => hN (hD hn' hmem)), norm_zero, zero_pow (by decide : (2 : ℕ) ≠ 0)]
  have h := tendsto_integral_of_dominated_convergence (μ := ρ)
    (fun t => ‖u t‖ ^ 2) (fun n => (hI (V n)).aestronglyMeasurable)
    (hI u) (fun n => by
      filter_upwards [ha n] with t ht
      rw [Real.norm_of_nonneg (sq_nonneg _), ht]
      by_cases hD : t ∈ (D n).1 <;> simp [hD]) (f := fun _ => (0 : ℝ)) hv
  rw [integral_zero] at h
  have hn (n : ℕ) : ‖V n‖ = Real.sqrt (∫ t, ‖V n t‖ ^ 2 ∂ρ) := by
    rw [← hnorm, Real.sqrt_sq (norm_nonneg _)]
  change Tendsto (fun n => ‖V n‖) atTop (𝓝 0)
  simp_rw [hn]
  simpa only [Real.sqrt_zero] using h.sqrt

/-- Strongly countably additive multiplication measure on complex L²,
with its realification supplying the original PVM interface. -/
def complexLTwoPVM (ρ : Measure Ω) : PVM Ω (ComplexLTwo ρ) where
  val E := (complexLTwoCut ρ E).restrictScalars ℝ
  empty_eq := ContinuousLinearMap.ext fun x => complexLTwoCut_empty ρ x
  normalized := by
    apply ContinuousLinearMap.ext
    intro x
    apply Lp.ext
    change (fun t => complexLTwoCut ρ MeasSet.whole x t) =ᵐ[ρ] (fun t => x t)
    simpa only [MeasSet.whole, indicator_univ] using complexLTwoCut_apply_ae ρ MeasSet.whole x
  mul_eq E B := ContinuousLinearMap.ext fun x => complexLTwoCut_comp ρ E B x
  countably_additive A hA x := by
    let U := MeasSet.iUnion A
    let V (s : Finset ℕ) := MeasSet.finiteUnion A s
    let R (s : Finset ℕ) := U.diff (V s)
    let D (n : ℕ) := R (Finset.range n)
    have hV (s : Finset ℕ) : (V s).1 ⊆ U.1 := by
      intro t ht
      obtain ⟨n, _, hn⟩ := mem_iUnion₂.mp ht
      exact mem_iUnion.mpr ⟨n, hn⟩
    have hR {s t : Finset ℕ} (hst : s ⊆ t) : (R t).1 ⊆ (R s).1 := by
      intro u hu
      refine ⟨hu.1, fun hv => hu.2 ?_⟩
      obtain ⟨n, hs, hn⟩ := mem_iUnion₂.mp hv
      exact mem_iUnion₂.mpr ⟨n, hst hs, hn⟩
    have hda : Antitone (fun n => (D n).1) := fun _ _ h => hR (Finset.range_mono h)
    have hdz : (⋂ n, (D n).1) = ∅ := by
      apply Set.eq_empty_iff_forall_notMem.mpr
      intro t ht
      obtain ⟨n, hn⟩ := mem_iUnion.mp ((Set.mem_iInter.mp ht 0).1)
      exact (Set.mem_iInter.mp ht (n + 1)).2
        (mem_iUnion₂.mpr ⟨n, Finset.mem_range.mpr (Nat.lt_succ_self n), hn⟩)
    have hlim := complexLTwoCut_tendsto_zero ρ D hda hdz x
    change Tendsto (fun s : Finset ℕ => ∑ n ∈ s, complexLTwoCut ρ (A n) x) atTop
      (𝓝 (complexLTwoCut ρ U x))
    rw [Metric.tendsto_nhds]
    intro ε hε
    obtain ⟨N, hN⟩ := Metric.tendsto_atTop.mp hlim ε hε
    have hn : ‖complexLTwoCut ρ (D N) x‖ < ε := by
      simpa only [Real.dist_eq, sub_zero, abs_of_nonneg (norm_nonneg _)] using hN N le_rfl
    filter_upwards [eventually_ge_atTop (Finset.range N)] with s hs
    have hfin := MeasSet.finite_add_of_pair (fun E => complexLTwoCut ρ E x) (complexLTwoCut_empty ρ x)
      (fun E B h => complexLTwoCut_union ρ E B h x) A hA s
    rw [← hfin, dist_eq_norm, norm_sub_rev]
    have huv : U = (V s).union (R s) := Subtype.ext (Set.union_sdiff_cancel (hV s)).symm
    have he : complexLTwoCut ρ U x - complexLTwoCut ρ (V s) x = complexLTwoCut ρ (R s) x := by
      conv_lhs => rw [huv]
      rw [complexLTwoCut_union _ _ _ disjoint_sdiff_right, add_sub_cancel_left]
    rw [he]
    have hin : (R s).inter (D N) = R s := Subtype.ext (Set.inter_eq_left.mpr (hR hs))
    have hs' := complexLTwoCut_contract ρ (R s) (complexLTwoCut ρ (D N) x)
    rw [complexLTwoCut_comp, hin] at hs'
    exact hs'.trans_lt hn

def ComplexCyclicVector {X : Type*} [NormedAddCommGroup X] [NormedSpace ℂ X]
    (P : MeasSet Ω → X →L[ℂ] X) (v : X) : Prop :=
  Dense (Submodule.span ℂ (Set.range fun E : MeasSet Ω => P E v) : Set X)

def complexLTwoOne (ρ : Measure Ω) [IsFiniteMeasure ρ] : ComplexLTwo ρ :=
  indicatorConstLp 2 MeasurableSet.univ (measure_ne_top ρ univ) 1

theorem complexLTwoOne_ae (ρ : Measure Ω) [IsFiniteMeasure ρ] :
    (fun t => complexLTwoOne ρ t) =ᵐ[ρ] fun _ => 1 := by
  have h : (fun t => complexLTwoOne ρ t) =ᵐ[ρ] univ.indicator (fun _ => (1 : ℂ)) :=
    indicatorConstLp_coeFn
  simpa only [indicator_univ] using h

/-- Complex cyclicity, with scalar span over ℂ and generator 1. -/
theorem complexLTwoCut_cyclic (ρ : Measure Ω) [IsFiniteMeasure ρ] :
    ComplexCyclicVector (complexLTwoCut ρ) (complexLTwoOne ρ) := by
  let u := complexLTwoOne ρ
  let Q := complexLTwoCut ρ
  let W := Submodule.span ℂ (Set.range fun E : MeasSet Ω => Q E u)
  have hconst (c : ℂ) (E : MeasSet Ω) :
      indicatorConstLp 2 E.2 (measure_ne_top ρ E.1) c = c • Q E u := by
    apply Lp.ext
    filter_upwards [indicatorConstLp_coeFn (p := (2 : ℝ≥0∞)) (hs := E.2)
        (hμs := measure_ne_top ρ E.1) (c := c),
      Lp.coeFn_smul c (Q E u), complexLTwoCut_apply_ae ρ E u, complexLTwoOne_ae ρ] with x h1 h2 h3 h4
    rw [h1, h2]
    change E.1.indicator (fun _ => c) x = c • Q E u x
    rw [h3]
    by_cases hx : x ∈ E.1
    · have hu : u x = 1 := h4
      simp [hx, hu]
    · simp [hx]
  have hsimple (f : Lp.simpleFunc ℂ 2 ρ) : (f : ComplexLTwo ρ) ∈ W := by
    apply Lp.simpleFunc.induction (by norm_num) (by norm_num) (P := fun f => (f : ComplexLTwo ρ) ∈ W) _ _ f
    · intro c E hE hEfin
      let B : MeasSet Ω := ⟨E, hE⟩
      change indicatorConstLp 2 B.2 (measure_ne_top ρ B.1) c ∈ W
      rw [hconst c B]
      exact W.smul_mem c (Submodule.subset_span ⟨B, rfl⟩)
    · intro f g _ _ _ hf hg
      exact W.add_mem hf hg
  change Dense (W : Set (ComplexLTwo ρ))
  exact (Lp.simpleFunc.dense (by norm_num)).mono (fun f hf => hsimple ⟨f, hf⟩)

#print axioms complexLTwoPVM
#print axioms complexLTwoCut_cyclic

end ComplexLTwoMultiplication



noncomputable section HardyToeplitz

open MeasureTheory
open scoped BigOperators ENNReal

/-- The concrete complex unit circle with its Borel sigma-algebra. -/
abbrev SpectralCircle := {z : ℂ // ‖z‖ = 1}

def spectralCircleRotate (a z : SpectralCircle) : SpectralCircle :=
  ⟨a.1 * z.1, by rw [norm_mul, a.2, z.2, one_mul]⟩

def CircleNormalizedHaar (m : Measure SpectralCircle) : Prop :=
  IsProbabilityMeasure m ∧ ∀ a : SpectralCircle, MeasurePreserving (spectralCircleRotate a) m m

abbrev ComplexSeqTwo := lp (fun _ : ℕ => ℂ) (2 : ℝ≥0∞)

def complexSeqUnit (n : ℕ) : ComplexSeqTwo := lp.single 2 n 1

theorem norm_complexSeqUnit (n : ℕ) : ‖complexSeqUnit n‖ = 1 := by
  rw [complexSeqUnit, lp.norm_single (by norm_num), norm_one]

def seqTwoPair (x y : ComplexSeqTwo) : ℂ := ∑' n, x n * star (y n)

theorem seqTwoPair_unit (x : ComplexSeqTwo) (n : ℕ) : seqTwoPair x (complexSeqUnit n) = x n := by
  unfold seqTwoPair
  rw [tsum_eq_single n]
  · simp [complexSeqUnit, lp.single_apply]
  · intro i hi
    simp [complexSeqUnit, lp.single_apply, Pi.single_eq_of_ne hi]

/-- Weak nullity of the actual complex coordinate basis, even for real
dual functionals. The bound on finite sums of squares is proved directly. -/
theorem complexSeqUnit_real_weaklyNull (g : Dual ComplexSeqTwo) :
    Tendsto (fun n => g (complexSeqUnit n)) atTop (𝓝 0) := by
  let f (n : ℕ) := g (complexSeqUnit n)
  have hsum : Summable (fun n => f n ^ 2) := by
    apply summable_of_sum_le (fun _ => sq_nonneg _) (c := ‖g‖ ^ 2)
    intro I
    let y : ComplexSeqTwo := ∑ n ∈ I, lp.single 2 n (↑(f n) : ℂ)
    have hv : g y = ∑ n ∈ I, f n ^ 2 := by
      unfold y
      rw [map_sum]
      apply Finset.sum_congr rfl
      intro n _
      have he : (lp.single 2 n (↑(f n) : ℂ) : ComplexSeqTwo) = f n • complexSeqUnit n := by
        apply Subtype.ext
        funext i
        change (lp.single (E := fun _ : ℕ => ℂ) 2 n (↑(f n)) : ComplexSeqTwo) i =
          ((f n • complexSeqUnit n) : ComplexSeqTwo) i
        rw [lp.coeFn_smul]
        by_cases h : i = n <;> simp [complexSeqUnit, lp.single_apply, h, Pi.single_eq_of_ne]
      rw [he, map_smul, smul_eq_mul, pow_two]
    have hsq : ‖y‖ ^ 2 = ∑ n ∈ I, f n ^ 2 := by
      have hy := lp.norm_sum_single (p := (2 : ℝ≥0∞)) (by norm_num)
        (fun n : ℕ => (↑(f n) : ℂ)) I
      have hr : (2 : ℝ≥0∞).toReal = 2 := by norm_num
      rw [hr] at hy
      have heq (r : ℝ) : ‖(r : ℂ)‖ ^ (2 : ℝ) = r ^ (2 : ℕ) := by
        rw [Complex.norm_real, show (2 : ℝ) = ((2 : ℕ) : ℝ) by norm_num, Real.rpow_natCast,
          Real.norm_eq_abs, sq_abs]
      simp only [heq] at hy
      rw [show (2 : ℝ) = ((2 : ℕ) : ℝ) by norm_num, Real.rpow_natCast] at hy
      exact hy
    have h : ‖y‖ ≤ ‖g‖ := by
      by_contra! hn
      have hg := g.le_opNorm y
      rw [hv, ← hsq, Real.norm_of_nonneg (sq_nonneg _)] at hg
      nlinarith [mul_pos ((norm_nonneg g).trans_lt hn) (sub_pos.mpr hn)]
    rw [← hsq]
    exact pow_le_pow_left₀ (norm_nonneg _) h 2
  have h := hsum.tendsto_atTop_zero.sqrt
  have h' : Tendsto (fun n => ‖f n‖) atTop (𝓝 0) := by
    simpa only [Real.sqrt_sq_eq_abs, Real.sqrt_zero, Real.norm_eq_abs] using h
  exact tendsto_zero_iff_norm_tendsto_zero.mpr h'

def powerMode (ρ : Measure SpectralCircle) [IsFiniteMeasure ρ] (n : ℕ) : ComplexLTwo ρ :=
  (show MemLp (fun z : SpectralCircle => z.1 ^ n) 2 ρ from by
    apply (memLp_const (μ := ρ) (p := 2) (1 : ℂ)).of_le
    · exact (continuous_subtype_val.pow n).measurable.aestronglyMeasurable
    · exact Eventually.of_forall fun z => by simp [norm_pow, z.2]).toLp _

theorem powerMode_ae (ρ : Measure SpectralCircle) [IsFiniteMeasure ρ] (n : ℕ) :
    (fun z => powerMode ρ n z) =ᵐ[ρ] fun z => z.1 ^ n := by
  unfold powerMode
  exact MemLp.coeFn_toLp _

def hardySpace (ρ : Measure SpectralCircle) [IsFiniteMeasure ρ] : Submodule ℂ (ComplexLTwo ρ) :=
  (Submodule.span ℂ (Set.range (powerMode ρ))).topologicalClosure

/-- The Fourier isometry, its canonical Hilbert adjoint, and the image
of the nonnegative Fourier modes in L² of normalized circle Haar measure. -/
structure HardyFourierCoordinates (m : Measure SpectralCircle) [IsProbabilityMeasure m] where
  V : ComplexSeqTwo →ₗᵢ[ℂ] ComplexLTwo m
  adj : ComplexLTwo m →L[ℂ] ComplexSeqTwo
  adj_left : ∀ x, adj (V x) = x
  adj_pair : ∀ u x, seqTwoPair (adj u) x = ∫ t, u t * star (V x t) ∂m
  modes : ∀ n, V (complexSeqUnit n) = powerMode m n
  range_eq : V.toLinearMap.range = hardySpace m

/-- Fourier coordinates and Riesz projection for the canonical phase
observable. The Fourier construction is the one used in Pellonpää (2003).
The positivity and the noncompactness assertions are proved separately. -/
axiom citeHardyFourierCoordinates :
  ∃ m : Measure SpectralCircle, CircleNormalizedHaar m ∧
    ∃ h : IsProbabilityMeasure m, letI := h; Nonempty (HardyFourierCoordinates m)

private theorem complexLTwo_pair_integrable {Ω : Type*} [MeasurableSpace Ω]
    {ρ : Measure Ω} (u v : ComplexLTwo ρ) :
    Integrable (fun t => u t * star (v t)) ρ := by
  have hi (x : ComplexLTwo ρ) : Integrable (fun t => ‖x t‖ ^ 2) ρ := by
    have h := (Lp.memLp x).norm_rpow (by norm_num) (by norm_num)
    simpa [memLp_one_iff_integrable] using h
  refine (((hi u).add (hi v)).const_mul (1 / 2 : ℝ)).mono'
    ((Lp.aestronglyMeasurable u).mul ((Lp.aestronglyMeasurable v).star)) ?_
  filter_upwards with t
  change ‖u t * star (v t)‖ ≤ (1 / 2 : ℝ) * (‖u t‖ ^ 2 + ‖v t‖ ^ 2)
  rw [norm_mul, norm_star]
  nlinarith [sq_nonneg (‖u t‖ - ‖v t‖)]

variable {m : Measure SpectralCircle} [IsProbabilityMeasure m] (H : HardyFourierCoordinates m)

/-- The canonical phase POVM, with complex operator values. -/
def HardyFourierCoordinates.phase (E : MeasSet SpectralCircle) : ComplexSeqTwo →L[ℂ] ComplexSeqTwo :=
  H.adj.comp ((complexLTwoCut m E).comp H.V.toContinuousLinearMap)

def HardyFourierCoordinates.PPlus : ComplexLTwo m →L[ℂ] ComplexLTwo m :=
  H.V.toContinuousLinearMap.comp H.adj

def HardyFourierCoordinates.toeplitz (b : SpectralCircle → ℂ) (hb : Measurable b)
    (C : ℝ) (hC : 0 ≤ C) (hbound : ∀ t, ‖b t‖ ≤ C) : ComplexSeqTwo →L[ℂ] ComplexSeqTwo :=
  H.adj.comp ((complexLTwoMultiplier m b hb C hC hbound).comp H.V.toContinuousLinearMap)

theorem HardyFourierCoordinates.toeplitz_on_Hardy (b : SpectralCircle → ℂ) (hb : Measurable b)
    (C : ℝ) (hC : 0 ≤ C) (hbound : ∀ t, ‖b t‖ ≤ C) (x : ComplexSeqTwo) :
    H.V (H.toeplitz b hb C hC hbound x) =
      H.PPlus (complexLTwoMultiplier m b hb C hC hbound (H.V x)) := rfl

theorem HardyFourierCoordinates.projection_range :
    H.PPlus.toLinearMap.range = hardySpace m := by
  rw [← H.range_eq]
  apply le_antisymm
  · rintro _ ⟨x, rfl⟩
    exact ⟨H.adj x, rfl⟩
  · rintro _ ⟨x, rfl⟩
    exact ⟨H.V x, by change H.V (H.adj (H.V x)) = H.V x; rw [H.adj_left]⟩

theorem HardyFourierCoordinates.phase_normalized :
    H.phase MeasSet.whole = ContinuousLinearMap.id ℂ ComplexSeqTwo := by
  apply ContinuousLinearMap.ext
  intro x
  have h := DFunLike.congr_fun (complexLTwoPVM m).normalized (H.V x)
  change complexLTwoCut m MeasSet.whole (H.V x) = H.V x at h
  change H.adj (complexLTwoCut m MeasSet.whole (H.V x)) = x
  rw [h, H.adj_left]

theorem HardyFourierCoordinates.phase_countably_additive
    (A : ℕ → MeasSet SpectralCircle) (hA : MeasSet.DisjointSeq A) (x : ComplexSeqTwo) :
    HasSum (fun n => H.phase (A n) x) (H.phase (MeasSet.iUnion A) x) :=
  (H.adj.restrictScalars ℝ).hasSum ((complexLTwoPVM m).countably_additive A hA (H.V x))

theorem HardyFourierCoordinates.phase_pair (E : MeasSet SpectralCircle) (x : ComplexSeqTwo) :
    seqTwoPair (H.phase E x) x =
      ∫ t in E.1, H.V x t * star (H.V x t) ∂m := by
  change seqTwoPair (H.adj (complexLTwoCut m E (H.V x))) x = _
  rw [H.adj_pair, ← integral_indicator E.2]
  apply integral_congr_ae
  filter_upwards [complexLTwoCut_apply_ae m E (H.V x)] with t ht
  rw [ht]
  by_cases h : t ∈ E.1 <;> simp [h]

theorem HardyFourierCoordinates.phase_positive (E : MeasSet SpectralCircle) (x : ComplexSeqTwo) :
    0 ≤ (seqTwoPair (H.phase E x) x).re ∧ (seqTwoPair (H.phase E x) x).im = 0 := by
  rw [H.phase_pair E x]
  have hi := (complexLTwo_pair_integrable (H.V x) (H.V x)).restrict (s := E.1)
  constructor
  · change 0 ≤ Complex.reCLM (∫ t in E.1, H.V x t * star (H.V x t) ∂m)
    rw [← Complex.reCLM.integral_comp_comm hi]
    apply integral_nonneg
    intro t
    change 0 ≤ (H.V x t * starRingEnd ℂ (H.V x t)).re
    rw [Complex.mul_conj]
    exact Complex.normSq_nonneg _
  · change Complex.imCLM (∫ t in E.1, H.V x t * star (H.V x t) ∂m) = 0
    rw [← Complex.imCLM.integral_comp_comm hi]
    have he (t : SpectralCircle) : Complex.imCLM (H.V x t * star (H.V x t)) = 0 := by
      change (H.V x t * starRingEnd ℂ (H.V x t)).im = 0
      rw [Complex.mul_conj]
      simp
    simp only [he, integral_zero]

theorem HardyFourierCoordinates.phase_diagonal (E : MeasSet SpectralCircle) (n : ℕ) :
    seqTwoPair (H.phase E (complexSeqUnit n)) (complexSeqUnit n) = ↑(m.real E.1) := by
  rw [H.phase_pair, H.modes]
  have hmode := ae_restrict_of_ae (powerMode_ae m n) (s := E.1)
  have he : (fun t => powerMode m n t * star (powerMode m n t)) =ᵐ[m.restrict E.1] fun _ => (1 : ℂ) := by
    filter_upwards [hmode] with t ht
    rw [ht]
    change t.1 ^ n * starRingEnd ℂ (t.1 ^ n) = 1
    rw [Complex.mul_conj, ← Complex.sq_norm, norm_pow, t.2]
    simp
  rw [integral_congr_ae he, integral_const]
  simp [Measure.real]

theorem HardyFourierCoordinates.phase_not_compact (E : MeasSet SpectralCircle)
    (hE : 0 < m E.1) : ¬ IsCompactOperator (H.phase E) := by
  have hpos : 0 < m.real E.1 := ENNReal.toReal_pos hE.ne' (measure_ne_top m E.1)
  apply not_isCompactOperator_of_weaklyNull_norm_lower ((H.phase E).restrictScalars ℝ)
    complexSeqUnit (fun n => (norm_complexSeqUnit n).le) complexSeqUnit_real_weaklyNull
    (m.real E.1) hpos
  intro n
  have hd := H.phase_diagonal E n
  rw [seqTwoPair_unit] at hd
  have hn := lp.norm_apply_le_norm (by norm_num : (2 : ℝ≥0∞) ≠ 0)
    (H.phase E (complexSeqUnit n)) n
  rw [hd, Complex.norm_real, Real.norm_of_nonneg hpos.le] at hn
  exact hn

/-- Core assertions in the Hardy–Toeplitz example, including exclusion
of a complex Schauder representation on the same circle. -/
theorem HardyFourierCoordinates.phase_no_frame (hs : TopologicalSpace.SeparableSpace ComplexSeqTwo) :
    ¬ ∃ η : Measure SpectralCircle, SigmaFinite η ∧ Nonempty (ComplexSchauderRepresentation η H.phase) := by
  rintro ⟨η, hη, ⟨F⟩⟩
  let := hη
  let := hs
  obtain ⟨D, hd, hc, hK⟩ := F.exists_locally_compact_partition
  have hnull n : m (D n).1 = 0 := by
    by_contra h
    exact H.phase_not_compact (D n) (pos_iff_ne_zero.mpr h) (hK n (D n) Subset.rfl)
  have hU : m (⋃ n, (D n).1) = 0 := measure_iUnion_null_iff.mpr hnull
  have hcov : (⋃ n, (D n).1) = univ := congrArg Subtype.val hc
  rw [hcov, measure_univ] at hU
  exact one_ne_zero hU

#print axioms complexSeqUnit_real_weaklyNull
#print axioms HardyFourierCoordinates.phase_normalized
#print axioms HardyFourierCoordinates.phase_countably_additive
#print axioms HardyFourierCoordinates.phase_positive
#print axioms HardyFourierCoordinates.phase_diagonal
#print axioms HardyFourierCoordinates.phase_no_frame
#print axioms HardyFourierCoordinates.toeplitz_on_Hardy

end HardyToeplitz

noncomputable section SpectralAtomicObstruction

open MeasureTheory
open scoped ENNReal

variable {Ω : Type*} [MeasurableSpace Ω]

/-- A compact cut of L² cannot contain infinitely many disjoint
measurable subsets of positive measure. -/
theorem complexLTwoCut_not_compact_of_disjoint (ρ : Measure Ω) [IsFiniteMeasure ρ]
    (E : MeasSet Ω) (A : ℕ → MeasSet Ω) (hA : MeasSet.DisjointSeq A)
    (hAE : ∀ n, (A n).1 ⊆ E.1) (hpos : ∀ n, 0 < ρ (A n).1) :
    ¬ IsCompactOperator (complexLTwoCut ρ E) := by
  classical
  let y (n : ℕ) := indicatorConstLp 2 (A n).2 (measure_ne_top ρ (A n).1) (1 : ℂ)
  have hy (n : ℕ) : (fun t => y n t) =ᵐ[ρ] (A n).1.indicator (fun _ => 1) :=
    indicatorConstLp_coeFn
  have hyne (n : ℕ) : y n ≠ 0 := by
    intro he
    have h := hy n
    rw [he] at h
    have hf : (A n).1.indicator (fun _ => (1 : ℂ)) =ᵐ[ρ] (fun _ => 0) :=
      h.symm.trans (Lp.coeFn_zero ℂ 2 ρ)
    have hh : ∀ᵐ t ∂ρ, t ∉ (A n).1 := by
      filter_upwards [hf] with t ht hm
      rw [indicator_of_mem hm] at ht
      exact one_ne_zero ht
    rw [ae_iff] at hh
    have hnull : ρ (A n).1 = 0 := by
      rw [show (A n).1 = {t | ¬ t ∉ (A n).1} from Set.ext fun _ => not_not.symm]
      exact hh
    exact (hpos n).ne' hnull
  let u (n : ℕ) := ‖y n‖⁻¹ • y n
  have hun (n : ℕ) : ‖u n‖ = 1 := by
    dsimp only [u]
    rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr (norm_nonneg _)),
      inv_mul_cancel₀ (norm_ne_zero_iff.mpr (hyne n))]
  have hsupport (B : MeasSet Ω) (n : ℕ) (hB : (A n).1 ⊆ B.1) :
      complexLTwoCut ρ B (u n) = u n := by
    change ((complexLTwoCut ρ B).restrictScalars ℝ) (‖y n‖⁻¹ • y n) = ‖y n‖⁻¹ • y n
    rw [map_smul]
    congr 1
    apply Lp.ext
    filter_upwards [complexLTwoCut_apply_ae ρ B (y n), hy n] with t ht hY
    change complexLTwoCut ρ B (y n) t = y n t
    rw [ht]
    by_cases hmem : t ∈ (A n).1
    · rw [indicator_of_mem (hB hmem)]
    · rw [hY, indicator_of_notMem hmem]
      by_cases hB' : t ∈ B.1 <;> simp [hB', hY, hmem]
  have hzero (i j : ℕ) (hij : i ≠ j) : complexLTwoCut ρ (A i) (u j) = 0 := by
    change ((complexLTwoCut ρ (A i)).restrictScalars ℝ) (‖y j‖⁻¹ • y j) = 0
    rw [map_smul]
    suffices h : complexLTwoCut ρ (A i) (y j) = 0 by rw [show ((complexLTwoCut ρ (A i)).restrictScalars ℝ) (y j) = 0 from h, smul_zero]
    apply Lp.ext
    filter_upwards [complexLTwoCut_apply_ae ρ (A i) (y j), hy j, Lp.coeFn_zero ℂ 2 ρ] with t ht hY hZ
    rw [ht, hZ]
    change (A i).1.indicator (y j) t = 0
    by_cases hmem : t ∈ (A i).1
    · rw [indicator_of_mem hmem, hY, indicator_of_notMem (fun h => Set.disjoint_left.mp (hA hij) hmem h)]
    · exact indicator_of_notMem hmem _
  have hdist (i j : ℕ) (hij : i ≠ j) : 1 ≤ dist (u i) (u j) := by
    rw [dist_eq_norm]
    have hb := complexLTwoCut_contract ρ (A i) (u i - u j)
    rw [map_sub, hsupport (A i) i Subset.rfl, hzero i j hij, sub_zero, hun i] at hb
    exact hb
  intro hc
  have hclosed := hc.isCompact_closure_image_closedBall (f := (complexLTwoCut ρ E).toLinearMap) 1
  have hu (n : ℕ) : u n ∈ closure (complexLTwoCut ρ E '' Metric.closedBall 0 1) :=
    subset_closure ⟨u n, mem_closedBall_zero_iff.mpr (hun n).le, hsupport E n (hAE n)⟩
  obtain ⟨z, _, φ, hφ, hz⟩ := hclosed.isSeqCompact hu
  obtain ⟨N, hN⟩ := Metric.cauchySeq_iff.mp hz.cauchySeq 1 zero_lt_one
  exact (not_lt_of_ge (hdist (φ N) (φ (N + 1)) (hφ.injective.ne (by omega))))
    (hN N le_rfl (N + 1) (by omega))

omit [MeasurableSpace Ω] in
private theorem split_nonatomic_cut [TopologicalSpace Ω] [T1Space Ω] [SecondCountableTopology Ω]
    [MeasurableSpace Ω] [OpensMeasurableSpace Ω]
    (ρ : Measure Ω) [IsFiniteMeasure ρ] (E : MeasSet Ω) (hE : 0 < ρ E.1)
    (hs : ∀ t ∈ E.1, ρ {t} = 0) :
    ∃ B : MeasSet Ω, B.1 ⊆ E.1 ∧ 0 < ρ B.1 ∧ ρ B.1 < ρ E.1 := by
  classical
  by_contra! hn
  let C := TopologicalSpace.countableBasis Ω
  let : Countable C := (TopologicalSpace.countable_countableBasis Ω).to_subtype
  let N (i : C) : Set Ω := if ρ (E.1 ∩ (i : Set Ω)) = 0 then E.1 ∩ i.1 else E.1 \ i.1
  have hm (i : C) : MeasurableSet i.1 := (TopologicalSpace.isOpen_of_mem_countableBasis i.2).measurableSet
  have hnull (i : C) : ρ (N i) = 0 := by
    by_cases hi : ρ (E.1 ∩ i.1) = 0
    · simp [N, hi]
    · have he : ρ E.1 ≤ ρ (E.1 ∩ i.1) :=
        hn ⟨E.1 ∩ i.1, E.2.inter (hm i)⟩ inter_subset_left (pos_iff_ne_zero.mpr hi)
      have hEq : E.1 \ i.1 = E.1 \ (E.1 ∩ i.1) := by
        ext t
        simp only [Set.mem_sdiff, mem_inter_iff]
        tauto
      dsimp only [N]
      rw [ite_eq_right hi, hEq, measure_sdiff inter_subset_left
        (E.2.inter (hm i)).nullMeasurableSet (measure_ne_top ρ _)]
      exact tsub_eq_zero_of_le he
  let D := E.1 \ ⋃ i, N i
  have hD : ρ D = ρ E.1 := measure_sdiff_null (measure_iUnion_null_iff.mpr hnull)
  have hne : D.Nonempty := by
    by_contra! h
    rw [h, measure_empty] at hD
    exact hE.ne' hD.symm
  obtain ⟨t, ht⟩ := hne
  have hsingle : D ⊆ {t} := by
    intro u hu
    by_contra h
    have htu : t ∈ ({u} : Set Ω)ᶜ := fun hh => h (by simpa only [mem_singleton_iff] using hh.symm)
    obtain ⟨B, hB, htB, hBu⟩ :=
      (TopologicalSpace.isBasis_countableBasis Ω).exists_subset_of_mem_open htu isOpen_compl_singleton
    let i : C := ⟨B, hB⟩
    have htN := fun hh => ht.2 (mem_iUnion.mpr ⟨i, hh⟩)
    have huN := fun hh => hu.2 (mem_iUnion.mpr ⟨i, hh⟩)
    by_cases hBnull : ρ (E.1 ∩ i.1) = 0
    · exact htN (by simp only [N, ite_eq_left hBnull]; exact ⟨ht.1, htB⟩)
    · exact huN (by
        simp only [N, ite_eq_right hBnull]
        exact ⟨hu.1, fun hh => hBu hh (mem_singleton u)⟩)
  have hz := measure_mono_null hsingle (hs t ht.1)
  exact hE.ne' (hD.symm.trans hz)

private theorem disjoint_positive_of_nonatomic_cut
    [TopologicalSpace Ω] [T1Space Ω] [SecondCountableTopology Ω] [OpensMeasurableSpace Ω]
    (ρ : Measure Ω) [IsFiniteMeasure ρ] (E : MeasSet Ω) (hE : 0 < ρ E.1)
    (hs : ∀ t ∈ E.1, ρ {t} = 0) :
    ∃ A : ℕ → MeasSet Ω, MeasSet.DisjointSeq A ∧
      (∀ n, (A n).1 ⊆ E.1) ∧ (∀ n, 0 < ρ (A n).1) := by
  classical
  let BType := { B : MeasSet Ω // B.1 ⊆ E.1 ∧ 0 < ρ B.1 }
  have split (B : BType) := split_nonatomic_cut ρ B.1 B.2.2
    (fun t ht => hs t (B.2.1 ht))
  let C (B : BType) : MeasSet Ω := Classical.choose (split B)
  have hC (B : BType) := Classical.choose_spec (split B)
  let next (B : BType) : BType :=
    ⟨B.1.diff (C B), Set.sdiff_subset.trans B.2.1, by
      by_contra! h
      have hz : ρ (B.1.diff (C B)).1 = 0 := le_antisymm h bot_le
      have hc : (C B).1 ∪ (B.1.diff (C B)).1 = B.1 :=
        Set.union_sdiff_cancel (hC B).1
      have he := measure_union_le (μ := ρ) (C B).1 (B.1.diff (C B)).1
      rw [hc, hz, add_zero] at he
      exact (not_lt_of_ge he) (hC B).2.2⟩
  let D (n : ℕ) := Nat.rec (motive := fun _ => BType) ⟨E, Subset.rfl, hE⟩ (fun _ B => next B) n
  have hd : Antitone (fun n => (D n).1.1) :=
    antitone_nat_of_succ_le fun _ => Set.sdiff_subset
  let A (n : ℕ) := C (D n)
  have hdis (i j : ℕ) (hij : i < j) : Disjoint (A i).1 (A j).1 := by
    apply Set.disjoint_left.mpr
    intro t hi hj
    have ht := hd (Nat.succ_le_of_lt hij) ((hC (D j)).1 hj)
    exact ht.2 hi
  exact ⟨A, fun i j hij => (lt_or_gt_of_ne hij).elim (hdis i j) (fun h => (hdis j i h).symm),
    fun n => (hC (D n)).1.trans (D n).2.1, fun n => (hC (D n)).2.1⟩

theorem complexLTwoCut_not_compact_nonatomic
    [TopologicalSpace Ω] [T1Space Ω] [SecondCountableTopology Ω] [OpensMeasurableSpace Ω]
    (ρ : Measure Ω) [IsFiniteMeasure ρ] (E : MeasSet Ω) (hE : 0 < ρ E.1)
    (hs : ∀ t ∈ E.1, ρ {t} = 0) : ¬ IsCompactOperator (complexLTwoCut ρ E) := by
  obtain ⟨A, hA, hAE, hpos⟩ := disjoint_positive_of_nonatomic_cut ρ E hE hs
  exact complexLTwoCut_not_compact_of_disjoint ρ E A hA hAE hpos

#print axioms complexLTwoCut_not_compact_nonatomic

end SpectralAtomicObstruction

noncomputable section AtomicSpectralFrame

open MeasureTheory
open scoped ENNReal

variable {Ω : Type*} [MeasurableSpace Ω] [MeasurableSingletonClass Ω]

def spectralAtoms (ρ : Measure Ω) : Set Ω := {t | 0 < ρ {t}}

theorem spectralAtoms_countable (ρ : Measure Ω) [IsFiniteMeasure ρ] :
    (spectralAtoms ρ).Countable := by
  apply Measure.countable_meas_pos_of_disjoint_iUnion
    (As := fun t : Ω => ({t} : Set Ω)) (fun t => measurableSet_singleton t)
  intro i j hij
  exact Set.disjoint_singleton.mpr hij

def spectralPurelyAtomic (ρ : Measure Ω) : Prop := ρ (spectralAtoms ρ)ᶜ = 0

omit [MeasurableSingletonClass Ω] in
private theorem ae_holds_at_atom {ρ : Measure Ω} {a : Ω} {p : Ω → Prop}
    (ha : a ∈ spectralAtoms ρ) (h : ∀ᵐ t ∂ρ, p t) : p a := by
  by_contra hn
  rw [ae_iff] at h
  exact ha.ne' (measure_mono_null (by simp [hn]) h)

private def spectralSingleton (a : Ω) : MeasSet Ω := ⟨{a}, measurableSet_singleton _⟩

def complexLTwoIndicator (ρ : Measure Ω) [IsFiniteMeasure ρ] (a : Ω) : ComplexLTwo ρ :=
  indicatorConstLp 2 (measurableSet_singleton a) (measure_ne_top ρ {a}) 1

private theorem complexLTwoIndicator_norm (ρ : Measure Ω) [IsFiniteMeasure ρ] (a : Ω) :
    ‖complexLTwoIndicator ρ a‖ = Real.sqrt (ρ.real {a}) := by
  unfold complexLTwoIndicator
  rw [norm_indicatorConstLp (by norm_num) (by norm_num), norm_one, one_mul]
  simp [Real.sqrt_eq_rpow]

private theorem complexLTwoCut_singleton (ρ : Measure Ω) [IsFiniteMeasure ρ]
    (a : Ω) (u : ComplexLTwo ρ) :
    complexLTwoCut ρ (spectralSingleton a) u = u a • complexLTwoIndicator ρ a := by
  apply Lp.ext
  filter_upwards [complexLTwoCut_apply_ae ρ (spectralSingleton a) u,
    Lp.coeFn_smul (u a) (complexLTwoIndicator ρ a),
    show (fun t => complexLTwoIndicator ρ a t) =ᵐ[ρ] ({a} : Set Ω).indicator (fun _ => (1 : ℂ)) from
      indicatorConstLp_coeFn] with t ht hs hi
  rw [ht, hs, Pi.smul_apply, hi]
  by_cases h : t = a <;> simp [spectralSingleton, h]

def complexLTwoAtomEval (ρ : Measure Ω) [IsFiniteMeasure ρ]
    (a : Ω) (ha : a ∈ spectralAtoms ρ) : ComplexLTwo ρ →L[ℂ] ℂ := by
  let C := ‖complexLTwoIndicator ρ a‖
  have hC : 0 < C := by
    dsimp only [C]
    rw [complexLTwoIndicator_norm]
    exact Real.sqrt_pos.mpr (ENNReal.toReal_pos ha.ne' (measure_ne_top ρ _))
  let L : ComplexLTwo ρ →ₗ[ℂ] ℂ :=
    ⟨⟨fun u => u a, fun u v => by
      have h := ae_holds_at_atom ha (Lp.coeFn_add u v)
      exact h⟩, fun c u => by
        have h := ae_holds_at_atom ha (Lp.coeFn_smul c u)
        exact h⟩
  refine L.mkContinuous C⁻¹ (fun u => ?_)
  change ‖u a‖ ≤ C⁻¹ * ‖u‖
  rw [← div_eq_inv_mul, le_div_iff₀ hC]
  have h := complexLTwoCut_contract ρ (spectralSingleton a) u
  rwa [complexLTwoCut_singleton, norm_smul] at h

private theorem complexLTwo_countable_cut_sum (ρ : Measure Ω) (A : Set Ω)
    (hA : A.Countable) (u : ComplexLTwo ρ) :
    HasSum (fun a : A => complexLTwoCut ρ (spectralSingleton a.1) u)
      (complexLTwoCut ρ ⟨A, hA.measurableSet⟩ u) := by
  classical
  let : Encodable A := hA.toEncodable
  let enc : A → ℕ := Encodable.encode
  have hi : Function.Injective enc := Encodable.encode_injective
  let D (n : ℕ) : MeasSet Ω :=
    if h : ∃ a : A, enc a = n then spectralSingleton (Classical.choose h).1 else MeasSet.empty
  have he (a : A) : D (enc a) = spectralSingleton a.1 := by
    have h : ∃ b : A, enc b = enc a := ⟨a, rfl⟩
    have hc := hi (Classical.choose_spec h)
    simp only [D, dite_eq_left h, hc]
  have hd : MeasSet.DisjointSeq D := by
    intro i j hij
    by_cases h₁ : ∃ a : A, enc a = i
    · by_cases h₂ : ∃ a : A, enc a = j
      · simp only [D, dite_eq_left h₁, dite_eq_left h₂, spectralSingleton]
        exact Set.disjoint_singleton.mpr (fun h =>
          hij ((Classical.choose_spec h₁).symm.trans ((congrArg enc (Subtype.ext h)).trans
            (Classical.choose_spec h₂))))
      · rw [show D j = MeasSet.empty by simp only [D, dite_eq_right h₂]]
        exact disjoint_empty _
    · rw [show D i = MeasSet.empty by simp only [D, dite_eq_right h₁]]
      exact empty_disjoint _
  have hc : MeasSet.iUnion D = ⟨A, hA.measurableSet⟩ := by
    apply Subtype.ext
    ext t
    change (t ∈ ⋃ i, (D i).1) ↔ t ∈ A
    constructor
    · intro ht
      obtain ⟨i, hi⟩ := mem_iUnion.mp ht
      by_cases h : ∃ a : A, enc a = i
      · simp only [D, dite_eq_left h, spectralSingleton, Set.mem_singleton_iff] at hi
        rw [hi]
        exact (Classical.choose h).2
      · rw [show D i = MeasSet.empty by simp only [D, dite_eq_right h]] at hi
        exact (Set.notMem_empty t hi).elim
    · intro ht
      let a : A := ⟨t, ht⟩
      exact mem_iUnion.mpr ⟨enc a, by rw [he]; exact mem_singleton _⟩
  have hP := (complexLTwoPVM ρ).countably_additive D hd u
  change HasSum (fun n => complexLTwoCut ρ (D n) u) (complexLTwoCut ρ (MeasSet.iUnion D) u) at hP
  rw [hc] at hP
  have hz (i : ℕ) (h : i ∉ Set.range enc) : complexLTwoCut ρ (D i) u = 0 := by
    have hx : ¬ ∃ a : A, enc a = i := h
    simp only [D, dite_eq_right hx]
    exact complexLTwoCut_empty ρ u
  have h := (hi.hasSum_iff (f := fun i => complexLTwoCut ρ (D i) u) hz).mpr hP
  simpa only [Function.comp_def, he] using h

omit [MeasurableSingletonClass Ω] in
theorem complexLTwoCut_eq_of_supported (ρ : Measure Ω) (S E : MeasSet Ω)
    (hS : ρ S.1ᶜ = 0) (u : ComplexLTwo ρ) :
    complexLTwoCut ρ (E.inter S) u = complexLTwoCut ρ E u := by
  apply Lp.ext
  have hs : ∀ᵐ t ∂ρ, t ∈ S.1 := (ae_iff).mpr hS
  filter_upwards [hs, complexLTwoCut_apply_ae ρ (E.inter S) u, complexLTwoCut_apply_ae ρ E u]
    with t hst h₁ h₂
  rw [h₁, h₂]
  by_cases he : t ∈ E.1 <;> simp [MeasSet.inter, he, hst]

set_option maxHeartbeats 800000 in
/-- A purely atomic multiplier measure has a complex continuous frame
on the original measurable space, with normalized singleton indicators. -/
theorem complexLTwo_exists_atom_frame (ρ : Measure Ω) [IsFiniteMeasure ρ]
    (hρ : spectralPurelyAtomic ρ) :
    ∃ η : Measure Ω, SigmaFinite η ∧ Nonempty (ComplexSchauderRepresentation η (complexLTwoCut ρ)) := by
  classical
  let A := spectralAtoms ρ
  have hAc : A.Countable := spectralAtoms_countable ρ
  let : Countable A := hAc.to_subtype
  let e : A → Ω := Subtype.val
  have hE : MeasurableEmbedding e := MeasurableEmbedding.subtype_coe hAc.measurableSet
  let η : Measure Ω := Measure.map e Measure.count
  have hη : SigmaFinite η := hE.sigmaFinite_map
  let S : MeasSet Ω := ⟨A, hAc.measurableSet⟩
  let v (t : Ω) : ComplexLTwo ρ :=
    if h : t ∈ A then (↑‖complexLTwoIndicator ρ t‖ : ℂ)⁻¹ • complexLTwoIndicator ρ t else 0
  let f (t : Ω) : ComplexLTwo ρ →L[ℂ] ℂ :=
    if h : t ∈ A then (↑‖complexLTwoIndicator ρ t‖ : ℂ) • complexLTwoAtomEval ρ t h else 0
  have hrank (a : A) (x : ComplexLTwo ρ) :
      f a.1 x • v a.1 = complexLTwoCut ρ (spectralSingleton a.1) x := by
    have hn : ‖complexLTwoIndicator ρ a.1‖ ≠ 0 := by
      rw [complexLTwoIndicator_norm]
      exact (Real.sqrt_pos.mpr (ENNReal.toReal_pos a.2.ne' (measure_ne_top ρ _))).ne'
    simp only [f, dite_eq_left a.2, v, dite_eq_ite, ite_eq_left a.2, smul_apply]
    change ((↑‖complexLTwoIndicator ρ a.1‖ : ℂ) * x a.1) •
      ((↑‖complexLTwoIndicator ρ a.1‖ : ℂ)⁻¹ • complexLTwoIndicator ρ a.1) = _
    rw [smul_smul, mul_right_comm, mul_inv_cancel₀ (Complex.ofReal_ne_zero.mpr hn),
      one_mul, complexLTwoCut_singleton]
  have hv (g : ComplexLTwo ρ →L[ℂ] ℂ) : Measurable (fun t => g (v t)) := by
    apply (measurable_const (a := (0 : ℂ))).measurable_of_countable_ne
    apply hAc.mono
    intro t ht
    by_contra h
    exact ht (by simp [v, h])
  have hf (x : ComplexLTwo ρ) : Measurable (fun t => f t x) := by
    apply (measurable_const (a := (0 : ℂ))).measurable_of_countable_ne
    apply hAc.mono
    intro t ht
    by_contra h
    exact ht (by simp [f, h])
  have hprod (a : A) (x : ComplexLTwo ρ) (g : ComplexLTwo ρ →L[ℂ] ℂ) :
      f a.1 x * g (v a.1) = g (complexLTwoCut ρ (spectralSingleton a.1) x) := by
    rw [← hrank a x, map_smul, smul_eq_mul]
  have hsum (x : ComplexLTwo ρ) (g : ComplexLTwo ρ →L[ℂ] ℂ) :
      Summable (fun a : A => f a.1 x * g (v a.1)) := by
    have h := ((complexLTwo_countable_cut_sum ρ A hAc x).map (g.restrictScalars ℝ) g.continuous).summable
    change Summable (fun a : A => g (complexLTwoCut ρ (spectralSingleton a.1) x)) at h
    simpa only [hprod] using h
  have hint (x : ComplexLTwo ρ) (g : ComplexLTwo ρ →L[ℂ] ℂ) :
      Integrable (fun t => f t x * g (v t)) η := by
    apply (integrable_map_measure (hf x |>.mul (hv g) |>.aestronglyMeasurable)
      hE.measurable.aemeasurable).mpr
    exact integrable_count_iff.mpr (summable_norm_iff.mpr (hsum x g))
  refine ⟨η, hη, ⟨v, f, hv, hf, hint, ?_⟩⟩
  intro E x g
  let P := fun t => f t x * g (v t)
  have hP : Measurable P := (hf x).mul (hv g)
  rw [← integral_indicator E.2]
  change g (complexLTwoCut ρ E x) = ∫ t, E.1.indicator P t ∂η
  rw [integral_map hE.measurable.aemeasurable (hP.indicator E.2).aestronglyMeasurable]
  have hPE : Integrable (fun a : A => E.1.indicator P (e a)) Measure.count :=
    (integrable_map_measure (hP.indicator E.2).aestronglyMeasurable hE.measurable.aemeasurable).mp
      ((hint x g).indicator E.2)
  rw [integral_countable hPE]
  simp only [Measure.real, Measure.count_singleton, ENNReal.toReal_one, one_smul]
  let B := {a : A | e a ∈ E.1}
  let BV : Set Ω := E.1 ∩ A
  have hBV : BV.Countable := hAc.mono inter_subset_right
  let iso : B ≃ BV :=
    { toFun := fun a => ⟨a.1.1, a.2, a.1.2⟩
      invFun := fun a => ⟨⟨a.1, a.2.2⟩, a.2.1⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
  have hs := ((complexLTwo_countable_cut_sum ρ BV hBV x).map
    (g.restrictScalars ℝ) g.continuous)
  have hsub : HasSum (fun a : B => P (e a.1))
      (g (complexLTwoCut ρ (E.inter S) x)) := by
    have h : HasSum (fun a : B => g (complexLTwoCut ρ (spectralSingleton a.1.1) x))
        (g (complexLTwoCut ρ (E.inter S) x)) := iso.hasSum_iff.mpr hs
    have hfun (a : B) : P (e a.1) = g (complexLTwoCut ρ (spectralSingleton a.1.1) x) := hprod a.1 x g
    simp_rw [hfun]
    exact h
  have htotal := (hasSum_subtype_iff_indicator (f := fun a : A => P (e a)) (s := B)).mp hsub
  have heq (a : A) : B.indicator (fun t => P (e t)) a = E.1.indicator P (e a) := by
    by_cases h : e a ∈ E.1
    · rw [indicator_of_mem (show a ∈ B from h), indicator_of_mem h]
    · rw [indicator_of_notMem (show a ∉ B from h), indicator_of_notMem h]
  have hh : B.indicator (fun t => P (e t)) = fun a => E.1.indicator P (e a) := funext heq
  rw [hh] at htotal
  rw [complexLTwoCut_eq_of_supported ρ S E hρ x] at htotal
  exact htotal.tsum_eq.symm

#print axioms complexLTwo_exists_atom_frame

end AtomicSpectralFrame


noncomputable section KoopmanSpectral

open MeasureTheory
open scoped ENNReal

/-- The Koopman unitary on actual complex L² of the given probability
space, acting by composition with the given measurable equivalence. -/
def koopmanUnitary {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω)
    (τ : Ω ≃ᵐ Ω) (hτ : MeasurePreserving τ μ μ) :
    ComplexLTwo μ ≃ₗᵢ[ℂ] ComplexLTwo μ := by
  let V := Lp.compMeasurePreservingₗᵢ (p := (2 : ℝ≥0∞)) (E := ℂ) ℂ τ hτ
  apply LinearIsometryEquiv.ofSurjective V
  intro x
  let y := Lp.compMeasurePreserving τ.symm (hτ.symm τ) x
  refine ⟨y, ?_⟩
  change Lp.compMeasurePreserving τ hτ (Lp.compMeasurePreserving τ.symm (hτ.symm τ) x) = x
  rw [← Lp.compMeasurePreserving_comp_apply]
  have he : (⇑τ.symm ∘ ⇑τ) = id := funext τ.symm_apply_apply
  simp [he]

theorem koopmanUnitary_apply_ae {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω)
    (τ : Ω ≃ᵐ Ω) (hτ : MeasurePreserving τ μ μ) (u : ComplexLTwo μ) :
    (fun t => koopmanUnitary μ τ hτ u t) =ᵐ[μ] fun t => u (τ t) :=
  Lp.coeFn_compMeasurePreserving u hτ

def unitaryIntegerOrbit {X : Type*} [NormedAddCommGroup X] [NormedSpace ℂ X]
    (U : X ≃ₗᵢ[ℂ] X) (g : X) : ℤ → X
  | .ofNat n => ((U : X → X)^[n]) g
  | .negSucc n => ((U.symm : X → X)^[n + 1]) g

def cyclicUnitarySubspace {X : Type*} [NormedAddCommGroup X] [NormedSpace ℂ X]
    (U : X ≃ₗᵢ[ℂ] X) (g : X) : Submodule ℂ X :=
  (Submodule.span ℂ (Set.range (unitaryIntegerOrbit U g))).topologicalClosure

def circleCoordinate (z : SpectralCircle) : ℂ := z.1

def circleMul (ρ : Measure SpectralCircle) : ComplexLTwo ρ →L[ℂ] ComplexLTwo ρ :=
  complexLTwoMultiplier ρ circleCoordinate continuous_subtype_val.measurable 1 zero_le_one
    (fun t => t.2.le)

def complexLTwoPair {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} (u v : ComplexLTwo μ) : ℂ :=
  ∫ t, u t * star (v t) ∂μ

/-- The cyclic spectral theorem for a unitary, including the scalar
spectral measure, the actual closed cyclic span and the moment identity. -/
structure CyclicUnitarySpectralData {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    (U : ComplexLTwo μ ≃ₗᵢ[ℂ] ComplexLTwo μ) (g : ComplexLTwo μ) where
  P : MeasSet SpectralCircle → ComplexLTwo μ →L[ℂ] ComplexLTwo μ
  normalized : P MeasSet.whole = ContinuousLinearMap.id ℂ _
  multiplicative : ∀ E F, (P E).comp (P F) = P (E.inter F)
  countably_additive : ∀ E : ℕ → MeasSet SpectralCircle, MeasSet.DisjointSeq E →
    ∀ u, HasSum (fun n => P (E n) u) (P (MeasSet.iUnion E) u)
  ρ : Measure SpectralCircle
  probability : IsProbabilityMeasure ρ
  scalar : ∀ E, (ρ.real E.1 : ℂ) = complexLTwoPair (P E g) g
  W : ComplexLTwo ρ ≃ₗᵢ[ℂ] cyclicUnitarySubspace U g
  one : letI := probability; (W (complexLTwoOne ρ) : ComplexLTwo μ) = g
  intertwines_U : ∀ u, (W (circleMul ρ u) : ComplexLTwo μ) = U (W u : ComplexLTwo μ)
  intertwines_P : ∀ E u, (W (complexLTwoCut ρ E u) : ComplexLTwo μ) = P E (W u : ComplexLTwo μ)
  moments : ∀ k : ℤ, (∫ t, (t.1 : ℂ) ^ k ∂ρ) = complexLTwoPair (unitaryIntegerOrbit U g k) g

/-- Standard cyclic spectral theorem for a complex unitary. Quotient
coordinates and the spectral moment law are those of the usual
multiplication model on the unit circle. -/
axiom citeCyclicUnitarySpectralTheorem {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    (U : ComplexLTwo μ ≃ₗᵢ[ℂ] ComplexLTwo μ) (g : ComplexLTwo μ) (hg : ‖g‖ = 1) :
    Nonempty (CyclicUnitarySpectralData U g)

private def complexTransportCut {Ω X Y : Type*} [MeasurableSpace Ω]
    [NormedAddCommGroup X] [NormedSpace ℂ X] [NormedAddCommGroup Y] [NormedSpace ℂ Y]
    (e : X ≃L[ℂ] Y) (μ : MeasSet Ω → X →L[ℂ] X) (E : MeasSet Ω) : Y →L[ℂ] Y :=
  e.toContinuousLinearMap.comp ((μ E).comp e.symm.toContinuousLinearMap)

private theorem complexRepresentation_transport {Ω X Y : Type*} [MeasurableSpace Ω]
    [NormedAddCommGroup X] [NormedSpace ℂ X] [NormedSpace ℝ X] [IsScalarTower ℝ ℂ X]
    [NormedAddCommGroup Y] [NormedSpace ℂ Y] [NormedSpace ℝ Y] [IsScalarTower ℝ ℂ Y]
    {η : Measure Ω} {μ : MeasSet Ω → X →L[ℂ] X} (e : X ≃L[ℂ] Y)
    (F : ComplexSchauderRepresentation η μ) :
    Nonempty (ComplexSchauderRepresentation η (complexTransportCut e μ)) := by
  let v := fun t => e (F.vector t)
  let f := fun t => (F.functional t).comp e.symm.toContinuousLinearMap
  refine ⟨⟨v, f, fun g => F.weaklyMeasurable (g.comp e.toContinuousLinearMap),
    fun x => F.weakStarMeasurable (e.symm x), fun x g => ?_, fun E x g => ?_⟩⟩
  · exact F.scalar_integrable (e.symm x) (g.comp e.toContinuousLinearMap)
  · exact F.cut_apply E (e.symm x) (g.comp e.toContinuousLinearMap)

private theorem complexLTwo_spectral_frame_atomic (ρ : Measure SpectralCircle)
    [IsFiniteMeasure ρ] [TopologicalSpace.SeparableSpace (ComplexLTwo ρ)] :
    (∃ η : Measure SpectralCircle, SigmaFinite η ∧
      Nonempty (ComplexSchauderRepresentation η (complexLTwoCut ρ))) ↔ spectralPurelyAtomic ρ := by
  constructor
  · rintro ⟨η, hη, ⟨F⟩⟩
    let := hη
    obtain ⟨D, _, hD, hK⟩ := F.exists_locally_compact_partition
    let N := (spectralAtoms ρ)ᶜ
    have hN : MeasurableSet N := (spectralAtoms_countable ρ).measurableSet.compl
    let B (n : ℕ) : MeasSet SpectralCircle := ⟨(D n).1 ∩ N, (D n).2.inter hN⟩
    have hz (n : ℕ) : ρ (B n).1 = 0 := by
      by_contra h
      apply complexLTwoCut_not_compact_nonatomic ρ (B n) (pos_iff_ne_zero.mpr h) _ (hK n (B n) inter_subset_left)
      intro t ht
      exact le_antisymm (le_of_not_gt (fun hp : 0 < ρ {t} => ht.2 hp)) bot_le
    have hUn : (⋃ n, (B n).1) = N := by
      change (⋃ n, (D n).1 ∩ N) = N
      rw [← iUnion_inter, show (⋃ n, (D n).1) = univ from congrArg Subtype.val hD, univ_inter]
    have hnull := measure_iUnion_null_iff.mpr hz
    rw [hUn] at hnull
    exact hnull
  · exact complexLTwo_exists_atom_frame ρ

namespace CyclicUnitarySpectralData

variable {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
  {U : ComplexLTwo μ ≃ₗᵢ[ℂ] ComplexLTwo μ} {g : ComplexLTwo μ}
  (B : CyclicUnitarySpectralData U g)

def cut (E : MeasSet SpectralCircle) : cyclicUnitarySubspace U g →L[ℂ] cyclicUnitarySubspace U g :=
  complexTransportCut B.W.toContinuousLinearEquiv (complexLTwoCut B.ρ) E

theorem cut_restrict (E : MeasSet SpectralCircle) (x : cyclicUnitarySubspace U g) :
    (B.cut E x : ComplexLTwo μ) = B.P E (x : ComplexLTwo μ) := by
  change (B.W (complexLTwoCut B.ρ E (B.W.symm x)) : ComplexLTwo μ) = B.P E (x : ComplexLTwo μ)
  have h := B.intertwines_P E (B.W.symm x)
  simpa only [LinearIsometryEquiv.apply_symm_apply] using h

theorem cut_cyclic :
    letI := B.probability; ComplexCyclicVector B.cut (B.W (complexLTwoOne B.ρ)) := by
  let := B.probability
  let e := B.W.toContinuousLinearEquiv
  have hu := complexLTwoCut_cyclic B.ρ
  unfold ComplexCyclicVector at hu ⊢
  let A := Set.range fun E : MeasSet SpectralCircle => complexLTwoCut B.ρ E (complexLTwoOne B.ρ)
  have hA : Set.range (fun E => B.cut E (B.W (complexLTwoOne B.ρ))) = e '' A := by
    ext y
    constructor
    · rintro ⟨E, rfl⟩
      refine ⟨_, ⟨E, rfl⟩, ?_⟩
      change e (complexLTwoCut B.ρ E (complexLTwoOne B.ρ)) =
        e (complexLTwoCut B.ρ E (e.symm (e (complexLTwoOne B.ρ))))
      rw [e.symm_apply_apply]
    · rintro ⟨x, ⟨E, rfl⟩, rfl⟩
      refine ⟨E, ?_⟩
      change e (complexLTwoCut B.ρ E (e.symm (e (complexLTwoOne B.ρ)))) =
        e (complexLTwoCut B.ρ E (complexLTwoOne B.ρ))
      rw [e.symm_apply_apply]
  rw [hA]
  change Dense (Submodule.span ℂ (e.toLinearMap '' A) : Set (cyclicUnitarySubspace U g))
  rw [Submodule.span_image]
  change Dense (e '' (Submodule.span ℂ A : Set (ComplexLTwo B.ρ)))
  exact e.surjective.denseRange.dense_image e.continuous hu

theorem lTwo_separable : TopologicalSpace.SeparableSpace (ComplexLTwo B.ρ) := by
  have hspan := (Set.countable_range (unitaryIntegerOrbit U g)).isSeparable.span (R := ℂ)
  let : TopologicalSpace.SeparableSpace (cyclicUnitarySubspace U g) :=
    hspan.closure.separableSpace
  exact TopologicalSpace.SeparableSpace.of_denseRange
    (B.W.symm ∘ TopologicalSpace.denseSeq (cyclicUnitarySubspace U g))
    (B.W.symm.surjective.denseRange.comp (TopologicalSpace.denseRange_denseSeq _) B.W.symm.continuous)

theorem cut_frame_iff_atomic :
    (∃ η : Measure SpectralCircle, SigmaFinite η ∧ Nonempty (ComplexSchauderRepresentation η B.cut))
      ↔ spectralPurelyAtomic B.ρ := by
  let := B.probability
  let := B.lTwo_separable
  let e := B.W.toContinuousLinearEquiv
  rw [← complexLTwo_spectral_frame_atomic B.ρ]
  constructor
  · rintro ⟨η, hη, ⟨F⟩⟩
    refine ⟨η, hη, ?_⟩
    have h := complexRepresentation_transport e.symm F
    have he : complexTransportCut e.symm B.cut = complexLTwoCut B.ρ := by
      funext E
      apply ContinuousLinearMap.ext
      intro x
      change e.symm (e (complexLTwoCut B.ρ E (e.symm (e x)))) = complexLTwoCut B.ρ E x
      rw [e.symm_apply_apply, e.symm_apply_apply]
    rwa [he] at h
  · rintro ⟨η, hη, ⟨F⟩⟩
    exact ⟨η, hη, complexRepresentation_transport e F⟩

end CyclicUnitarySpectralData

#print axioms koopmanUnitary_apply_ae
#print axioms CyclicUnitarySpectralData.cut_restrict
#print axioms CyclicUnitarySpectralData.cut_cyclic
#print axioms CyclicUnitarySpectralData.cut_frame_iff_atomic

