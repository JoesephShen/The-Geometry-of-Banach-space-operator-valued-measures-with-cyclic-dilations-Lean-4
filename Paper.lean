open MeasureTheory

variable {Ω X Y : Type*} [MeasurableSpace Ω] [NormedAddCommGroup X] [NormedSpace ℝ X]
  [NormedAddCommGroup Y] [NormedSpace ℝ Y] [CompleteSpace Y]

/-- Constant sections and the Bochner integral in the represented primal
function space. The two bounds are the inclusions of the Köthe norm. -/
theorem PVM.exists_bochner_constant_and_integral (P : PVM Ω X)
    (ρ : Measure Ω) [IsFiniteMeasure ρ] (R : X → Ω → Y)
    (hadd : ∀ x y, R (x + y) =ᵐ[ρ] fun t => R x t + R y t)
    (hsmul : ∀ (a : ℝ) x, R (a • x) =ᵐ[ρ] fun t => a • R x t)
    (hsep : ∀ x y, R x =ᵐ[ρ] R y → x = y)
    (hcut : ∀ E x, R (P.val E x) =ᵐ[ρ] E.1.indicator (R x))
    (M N : ℝ)
    (hconst : ∀ y : Y, ∃ x : X, R x =ᵐ[ρ] (fun _ => y) ∧ ‖x‖ ≤ M * ‖y‖)
    (hintegrable : ∀ x, Integrable (R x) ρ ∧ (∫ t, ‖R x t‖ ∂ρ) ≤ N * ‖x‖) :
    ∃ (C : Y →L[ℝ] X) (V : X →L[ℝ] Y),
      (∀ y, R (C y) =ᵐ[ρ] (fun _ => y)) ∧
      (∀ x, V x = ∫ t, R x t ∂ρ) ∧
      ∀ E : MeasSet Ω, (V.comp (P.val E)).comp C = (ρ E.1).toReal • ContinuousLinearMap.id ℝ Y := by
  choose C hC hCnorm using hconst
  let Cₗ : Y →ₗ[ℝ] X :=
    { toFun := C
      map_add' := fun y z => hsep _ _ ((hC (y + z)).trans (by
        filter_upwards [hadd (C y) (C z), hC y, hC z] with t ha hy hz
        exact (ha.trans (congrArg₂ (· + ·) hy hz)).symm))
      map_smul' := fun a y => hsep _ _ ((hC (a • y)).trans (by
        filter_upwards [hsmul a (C y), hC y] with t hh hy
        exact (hh.trans (congrArg (a • ·) hy)).symm)) }
  let Vₗ : X →ₗ[ℝ] Y :=
    { toFun := fun x => ∫ t, R x t ∂ρ
      map_add' := fun x y => by
        rw [← integral_add (hintegrable x).1 (hintegrable y).1]
        exact integral_congr_ae (hadd x y)
      map_smul' := fun a x => by
        change (∫ t, R (a • x) t ∂ρ) = a • ∫ t, R x t ∂ρ
        rw [← integral_smul]
        exact integral_congr_ae (hsmul a x) }
  let C' := Cₗ.mkContinuous M hCnorm
  let V := Vₗ.mkContinuous N (fun x => (norm_integral_le_integral_norm (R x)).trans (hintegrable x).2)
  refine ⟨C', V, hC, fun _ => rfl, fun E => ?_⟩
  ext y
  change (∫ t, R (P.val E (C y)) t ∂ρ) = (ρ E.1).toReal • y
  have he : R (P.val E (C y)) =ᵐ[ρ] E.1.indicator (fun _ => y) := (hcut E (C y)).trans (by
    filter_upwards [hC y] with t ht
    by_cases h : t ∈ E.1 <;> simp [h, ht])
  rw [integral_congr_ae he, integral_indicator E.2, setIntegral_const]
  rfl

#print axioms PVM.exists_bochner_constant_and_integral

end KotheConstantSections

noncomputable section ConcreteKotheLocalization

open MeasureTheory

variable {Ω E X Y : Type*} [MeasurableSpace Ω] {ρ : Measure Ω}
  [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup X] [NormedSpace ℝ X]
  [NormedAddCommGroup Y] [NormedSpace ℝ Y]
  {S : KotheScalarSpace ρ E} (Q : KotheBochnerQuotient S Y X)

namespace KotheBochnerQuotient

private theorem scalarIndicator_exists (A : MeasSet Ω) :
    ∃ e : E, (S.repr e : Ω → ℝ) =ᵐ[ρ] A.1.indicator (fun _ => 1) := by
  let a : Ω →ₘ[ρ] ℝ := AEEqFun.mk (A.1.indicator (fun _ => 1))
    (stronglyMeasurable_const.indicator A.2).aestronglyMeasurable
  have ha : (a : Ω → ℝ) =ᵐ[ρ] A.1.indicator (fun _ => 1) := AEEqFun.coeFn_mk _ _
  have hone : (S.repr S.one : Ω → ℝ) =ᵐ[ρ] fun _ => 1 := by
    rw [S.repr_one]
    exact AEEqFun.coeFn_one
  have hle : ∀ᵐ t ∂ρ, |a t| ≤ |S.repr S.one t| := by
    filter_upwards [ha, hone] with t ht hu
    rw [ht, hu]
    by_cases h : t ∈ A.1 <;> simp [h]
  obtain ⟨e, he, _⟩ := S.solid S.one a hle
  exact ⟨e, by rw [he]; exact ha⟩

private theorem scalarIndicator_norm_tendsto (A : ℕ → MeasSet Ω)
    (hA : Antitone (fun n => (A n).1)) (hcap : (⋂ n, (A n).1) = ∅)
    (e : ℕ → E) (he : ∀ n, (S.repr (e n) : Ω → ℝ) =ᵐ[ρ] (A n).1.indicator (fun _ => 1)) :
    Tendsto (fun n => ‖e n‖) atTop (𝓝 0) := by
  apply S.order_continuous e
  · intro n
    filter_upwards [he n] with t ht
    rw [ht]
    by_cases hn : t ∈ (A n).1 <;> simp [hn]
  · intro i j hij
    filter_upwards [he i, he j] with t hi hj
    rw [hi, hj]
    by_cases ht : t ∈ (A j).1
    · simp [ht, hA hij ht]
    · by_cases hti : t ∈ (A i).1 <;> simp [ht, hti]
  · filter_upwards [ae_all_iff.mpr he] with t ht
    have hex : ∃ n, t ∉ (A n).1 := by
      by_contra! h
      have hh := Set.mem_iInter.mpr h
      rw [hcap] at hh
      exact hh
    obtain ⟨N, hn⟩ := hex
    apply tendsto_const_nhds.congr'
    filter_upwards [eventually_ge_atTop N] with n hN
    exact ((ht n).trans (indicator_of_notMem (fun hn' => hn (hA hN hn')) _)).symm

private theorem norm_cut_constant (A : MeasSet Ω) (e : E)
    (he : (S.repr e : Ω → ℝ) =ᵐ[ρ] A.1.indicator (fun _ => 1))
    (x : X) (y : Y) (hx : (Q.repr x : Ω → Y) =ᵐ[ρ] fun _ => y) :
    ‖Q.cut A x‖ = ‖e‖ * ‖y‖ := by
  have hs : (S.repr (‖y‖ • e) : Ω → ℝ) =ᵐ[ρ] fun t => ‖y‖ * S.repr e t := by
    rw [map_smul]
    exact AEEqFun.coeFn_smul _ _
  have hclass : AEEqFun.comp norm continuous_norm (Q.repr (Q.cut A x)) = S.repr (‖y‖ • e) := by
    apply AEEqFun.ext
    filter_upwards [AEEqFun.coeFn_comp norm continuous_norm (Q.repr (Q.cut A x)),
      Q.repr_cut A x, hx, hs, he] with t h₁ h₂ h₃ h₄ h₅
    rw [h₁, h₄, Function.comp_apply, h₂, h₅]
    by_cases ht : t ∈ A.1 <;> simp [ht, h₃]
  rw [Q.norm_eq _ _ hclass, norm_smul, Real.norm_of_nonneg (norm_nonneg y), mul_comm]

/-- For the concrete quotient, both the compression identity of the
constant-section and integration maps and the small-tail condition hold. -/
theorem exists_constant_integration [CompleteSpace Y] [IsFiniteMeasure ρ] :
    ∃ C : Y →L[ℝ] X, ∃ V : X →L[ℝ] Y,
      (∀ E : MeasSet Ω, (V.comp (Q.multiplication.val E)).comp C =
        (ρ E.1).toReal • ContinuousLinearMap.id ℝ Y) ∧
      ∀ A : ℕ → MeasSet Ω, Antitone (fun n => (A n).1) →
        (⋂ n, (A n).1) = ∅ →
        Tendsto (fun n => ‖(Q.multiplication.val (A n)).comp C‖) atTop (𝓝 0) := by
  obtain ⟨C, V, hC, _, hCV⟩ := Q.multiplication.exists_bochner_constant_and_integral
    ρ (fun x => Q.repr x) Q.repr_add_ae Q.repr_smul_ae
    (fun x y h => Q.injective (AEEqFun.ext h)) Q.repr_cut
    ‖S.one‖ S.l1Bound (fun y => by
      obtain ⟨x, hx, hn⟩ := Q.contains_bounded (fun _ => y) stronglyMeasurable_const
        ‖y‖ (norm_nonneg _) (fun _ => le_rfl)
      exact ⟨x, hx, hn.trans_eq (mul_comm _ _)⟩) Q.integrable_repr
  refine ⟨C, V, hCV, fun A hA hcap => ?_⟩
  choose e he using fun n => scalarIndicator_exists (S := S) (A n)
  have hnorm (n : ℕ) : ‖(Q.multiplication.val (A n)).comp C‖ ≤ ‖e n‖ := by
    apply ContinuousLinearMap.opNorm_le_bound _ (norm_nonneg _)
    intro y
    exact (Q.norm_cut_constant (A n) (e n) (he n) (C y) y (hC y)).le
  exact squeeze_zero (fun _ => norm_nonneg _) hnorm (scalarIndicator_norm_tendsto A hA hcap e he)

/-- Manuscript, rem:bochner-localization-dilation, on a measure with
positive total mass. -/
theorem localizes_iff_reflexive [CompleteSpace E] [CompleteSpace X] [CompleteSpace Y]
    [IsFiniteMeasure ρ] (hρ : ρ Set.univ ≠ 0) :
    Q.multiplication.Localizes ↔ IsReflexive Y := by
  obtain ⟨C, V, hCV, htail⟩ := Q.exists_constant_integration
  exact ⟨Q.multiplication.reflexive_of_localizes_with_constant_sections ρ hρ C V hCV htail,
    Q.localizes⟩

/-- The exact image of the concrete associate-bidual classes under
compression, with the normal and Baire-one parts identified. -/
theorem compressed_normalPart {W : Type*} [NormedAddCommGroup W] [NormedSpace ℝ W]
    [CompleteSpace W] [CompleteSpace X] [CompleteSpace Y] [CompleteSpace E]
    [IsFiniteMeasure ρ] {μ : OVM Ω W} (L : Dilation μ X)
    (hL : L.P = Q.multiplication) (hY : IsReflexive Y) :
    ∃ D : KotheBochnerDualModel Q.multiplication ρ (KotheScalarSpace.associateUnit S) Y,
      (∀ f : Dual X, Q.Represents f (D.rep f)) ∧
      {ξ : Bidual W | μ.Normal ξ} = {ξ : Bidual W | BaireOne ξ} ∧
      secondAdjoint L.S '' {η : Bidual X | ∃ h ∈ associateBidual S Y,
        ∀ f : Dual X, η f = ∫ t, D.rep f t (h t) ∂ρ} = {ξ : Bidual W | BaireOne ξ} := by
  obtain ⟨D, hD, hn, _⟩ := Q.normalPart hY
  have hloc : L.P.Localizes := hL.symm ▸ Q.localizes hY
  refine ⟨D, hD, Set.ext (fun ξ => L.normal_iff_baireOne hloc ξ), ?_⟩
  have he : {η : Bidual X | ∃ h ∈ associateBidual S Y,
      ∀ f : Dual X, η f = ∫ t, D.rep f t (h t) ∂ρ} = {η | L.P.toOVM.Normal η} := by
    ext η
    rw [hL]
    exact (hn η).symm
  rw [he]
  exact L.secondAdjoint_image_normal_eq_baireOne hloc

#print axioms KotheBochnerQuotient.exists_constant_integration
#print axioms KotheBochnerQuotient.localizes_iff_reflexive
#print axioms KotheBochnerQuotient.compressed_normalPart

end KotheBochnerQuotient

end ConcreteKotheLocalization

noncomputable section MultiplierRatio

open MeasureTheory

variable {Ω : Type*} [MeasurableSpace Ω]

/-- The pointwise quotient of two dominated measurable functions has a
bounded representative of norm at most one. A global truncation changes
it only on the exceptional null set. -/
theorem exists_boundedMultiplier_of_ae_domination (ρ : Measure Ω)
    (h z : Ω → ℝ) (hh : Measurable h) (hz : Measurable z)
    (hd : ∀ᵐ t ∂ρ, |h t| ≤ |z t|) :
    ∃ a : boundedMeasurableAlgebra Ω, ‖a.1‖ ≤ 1 ∧
      h =ᵐ[ρ] fun t => a.1 t * z t := by
  let : TopologicalSpace Ω := ⊥
  let : DiscreteTopology Ω := ⟨rfl⟩
  let r (t : Ω) := h t / z t
  let b (t : Ω) := max (-1) (min 1 (r t))
  have hb (t : Ω) : |b t| ≤ 1 := abs_le.mpr
    ⟨le_max_left _ _, max_le (by norm_num) (min_le_left _ _)⟩
  let a : DiscreteBoundedRealFunctions Ω := BoundedContinuousFunction.mkOfBound
    ⟨b, continuous_of_discreteTopology⟩ 2 (fun s t => by
      rw [Real.dist_eq]
      change |b s - b t| ≤ 2
      exact (abs_sub _ _).trans (by linarith [hb s, hb t]))
  refine ⟨⟨a, measurable_const.max (measurable_const.min (hh.div hz))⟩, ?_, ?_⟩
  · exact (BoundedContinuousFunction.norm_le (by norm_num)).mpr (fun t => hb t)
  · filter_upwards [hd] with t ht
    change h t = b t * z t
    by_cases hzero : z t = 0
    · have hh0 : h t = 0 := by
        rw [hzero, abs_zero] at ht
        exact abs_eq_zero.mp (le_antisymm ht (abs_nonneg _))
      rw [hzero, hh0, mul_zero]
    · have hratio : |r t| ≤ 1 := by
        change |h t / z t| ≤ 1
        rw [abs_div, div_le_iff₀ (abs_pos.mpr hzero), one_mul]
        exact ht
      have he : b t = r t := by
        dsimp [b]
        rw [min_eq_right (abs_le.mp hratio).2, max_eq_right (abs_le.mp hratio).1]
      rw [he]
      exact (div_mul_cancel₀ _ hzero).symm

#print axioms exists_boundedMultiplier_of_ae_domination

end MultiplierRatio

noncomputable section CyclicMultiplierCoordinates

open MeasureTheory

variable {Ω X : Type*} [MeasurableSpace Ω] [NormedAddCommGroup X] [NormedSpace ℝ X]
  [CompleteSpace X]

private theorem ae_eq_from_cut_integrals (ρ : Measure Ω) [IsFiniteMeasure ρ]
    {h k : Ω → ℝ} (hh : Integrable h ρ) (hk : Integrable k ρ)
    (he : ∀ A : MeasSet Ω, (∫ t in A.1, h t ∂ρ) = ∫ t in A.1, k t ∂ρ) :
    h =ᵐ[ρ] k := by
  have hp : (fun t => h t - k t) =ᵐ[ρ] 0 :=
    ae_eq_zero_of_forall_setIntegral_eq_of_sigmaFinite
      (fun _ _ _ => (hh.sub hk).integrableOn) (fun A hA _ => by
        rw [integral_sub hh.integrableOn hk.integrableOn, he ⟨A, hA⟩, sub_self])
  exact hp.mono fun t ht => sub_eq_zero.mp ht

/-- A faithful cyclic scalar coefficient gives measurable coordinates in
a.e. classes. The full measurable multiplier algebra acts by pointwise
multiplication in these coordinates. -/
theorem PVM.exists_cyclic_coefficient_coordinates (P : PVM Ω X) {u : X} (hu : P.CyclicVector u)
    (ρ : Measure Ω) [IsFiniteMeasure ρ] (φ : Dual X)
    (hφ : ∀ E : MeasSet Ω, (ρ E.1).toReal = φ (P.val E u))
    (hρ : ∀ E : MeasSet Ω, ρ E.1 = 0 → P.val E = 0) :
    ∃ q : X →ₗ[ℝ] (Ω →ₘ[ρ] ℝ), Function.Injective q ∧
      (∀ x : X, Integrable (q x : Ω → ℝ) ρ ∧
        ∀ E : MeasSet Ω, φ (P.val E x) = ∫ t in E.1, q x t ∂ρ) ∧
      ∀ (a : boundedMeasurableAlgebra Ω) (x : X),
        (q (P.boundedMeasurableRepresentation a x) : Ω → ℝ) =ᵐ[ρ] fun t => a.1 t * q x t := by
  classical
  choose h hm hi hc using fun x : X =>
    P.exists_normalCoefficient_density ρ hρ (J x) (P.toOVM.normal_J x) φ
  have hcoeff (x : X) (E : MeasSet Ω) : φ (P.val E x) = ∫ t in E.1, h x t ∂ρ := hc x E
  let q (x : X) : Ω →ₘ[ρ] ℝ := AEEqFun.mk (h x) (hi x).aestronglyMeasurable
  have hq (x : X) : (q x : Ω → ℝ) =ᵐ[ρ] h x := AEEqFun.coeFn_mk _ _
  let qₗ : X →ₗ[ℝ] (Ω →ₘ[ρ] ℝ) :=
    { toFun := q
      map_add' := fun x y => by
        have he : h (x + y) =ᵐ[ρ] fun t => h x t + h y t :=
          ae_eq_from_cut_integrals ρ (hi _) ((hi x).add (hi y)) fun E => by
            rw [← hcoeff, integral_add (hi x).integrableOn (hi y).integrableOn,
              ← hcoeff, ← hcoeff, map_add, map_add]
        apply AEEqFun.ext
        filter_upwards [hq (x + y), hq x, hq y, AEEqFun.coeFn_add (q x) (q y), he]
          with t hxy hx hy hsum he'
        change q (x + y) t = (q x + q y) t
        rw [hxy, hsum, he']
        change h x t + h y t = q x t + q y t
        rw [hx, hy]
      map_smul' := fun a x => by
        have he : h (a • x) =ᵐ[ρ] fun t => a * h x t :=
          ae_eq_from_cut_integrals ρ (hi _) ((hi x).const_mul a) fun E => by
            rw [← hcoeff, integral_const_mul, ← hcoeff, map_smul, map_smul]
            rfl
        apply AEEqFun.ext
        filter_upwards [hq (a • x), hq x, AEEqFun.coeFn_smul a (q x), he] with t ha hx hs he'
        change q (a • x) t = (a • q x) t
        rw [ha, hs, he']
        change a * h x t = a * q x t
        rw [hx] }
  refine ⟨qₗ, ?_, ?_, ?_⟩
  · intro x y hxy
    have he : h x =ᵐ[ρ] h y := (hq x).symm.trans ((show q x = q y from hxy) ▸ hq y)
    apply eq_of_dual_eval
    intro f
    obtain ⟨g, hgm, _, hgc⟩ :=
      P.exists_normalCoefficient_density ρ hρ (J u) (P.toOVM.normal_J u) f
    have hg (E : MeasSet Ω) : f (P.val E u) = ∫ t in E.1, g t ∂ρ := hgc E
    have hx := (P.cyclic_normal_density hu ρ φ hφ (J x) (P.toOVM.normal_J x) f
      (h x) g (hm x) (hi x) (hc x) hgm hg).2 MeasSet.whole
    have hy := (P.cyclic_normal_density hu ρ φ hφ (J y) (P.toOVM.normal_J y) f
      (h y) g (hm y) (hi y) (hc y) hgm hg).2 MeasSet.whole
    change f (P.val MeasSet.whole x) = _ at hx
    change f (P.val MeasSet.whole y) = _ at hy
    rw [P.normalized] at hx hy
    exact hx.trans ((integral_congr_ae ((ae_restrict_of_ae he).mono
      fun t ht => congrArg (g t * ·) ht)).trans hy.symm)
  · intro x
    exact ⟨(hi x).congr (hq x).symm, fun E => (hcoeff x E).trans
      (integral_congr_ae (ae_restrict_of_ae (hq x).symm))⟩
  · intro a x
    let : TopologicalSpace Ω := ⊥
    let y := P.boundedMeasurableRepresentation a x
    have hai : Integrable (fun t => a.1 t * h x t) ρ :=
      (hi x).bdd_mul (c := ‖a.1‖) a.2.aestronglyMeasurable
        (Eventually.of_forall fun t => BoundedContinuousFunction.norm_coe_le_norm a.1 t)
    have he : h y =ᵐ[ρ] fun t => a.1 t * h x t :=
      ae_eq_from_cut_integrals ρ (hi y) hai fun E => by
        rw [← hcoeff]
        exact P.boundedMeasurableMultiplier_cut a x φ ρ (h x) (hi x) (hcoeff x) E
    exact (hq y).trans (he.trans ((hq x).symm.mono fun t ht => congrArg (a.1 t * ·) ht))

#print axioms PVM.exists_cyclic_coefficient_coordinates

/-- In the faithful scalar coordinates of a cyclic PVM, the orbit of
the multiplier unit ball is exactly coordinatewise absolute domination. -/
theorem PVM.exists_cyclic_multiplierOrbit_eq_domination (P : PVM Ω X)
    {u : X} (hu : P.CyclicVector u) (K : Set X) :
    ∃ (ρ : Measure Ω) (q : X →ₗ[ℝ] (Ω →ₘ[ρ] ℝ)),
      Function.Injective q ∧
      {y : X | ∃ (a : boundedMeasurableAlgebra Ω) (z : X),
        ‖a.1‖ ≤ 1 ∧ z ∈ K ∧ P.boundedMeasurableRepresentation a z = y} =
      {y : X | ∃ z ∈ K, ∀ᵐ t ∂ρ, |q y t| ≤ |q z t|} := by
  obtain ⟨ρ, hfin, φ, hφ, hρ⟩ := P.exists_faithful_positive_coefficient hu
  let : IsFiniteMeasure ρ := hfin
  obtain ⟨q, hinj, _, hq⟩ := P.exists_cyclic_coefficient_coordinates hu ρ φ hφ
    (fun E => (hρ E).mp)
  refine ⟨ρ, q, hinj, ?_⟩
  ext y
  constructor
  · rintro ⟨a, z, ha, hz, rfl⟩
    refine ⟨z, hz, ?_⟩
    let : TopologicalSpace Ω := ⊥
    filter_upwards [hq a z] with t ht
    rw [ht, abs_mul]
    exact mul_le_of_le_one_left (abs_nonneg _) ((BoundedContinuousFunction.norm_coe_le_norm a.1 t).trans ha)
  · rintro ⟨z, hz, hd⟩
    obtain ⟨a, ha, h⟩ := exists_boundedMultiplier_of_ae_domination ρ (q y) (q z)
      (q y).stronglyMeasurable.measurable (q z).stronglyMeasurable.measurable hd
    exact ⟨a, z, ha, hz, hinj (AEEqFun.ext ((hq a z).trans h.symm))⟩

#print axioms PVM.exists_cyclic_multiplierOrbit_eq_domination

end CyclicMultiplierCoordinates

noncomputable section MultiplierHullTransport

open MeasureTheory

variable {X Z : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]
  [NormedAddCommGroup Z] [NormedSpace ℝ Z]

/-- An intertwining operator on measurable cuts intertwines the whole
bounded measurable multiplier algebra. -/
theorem PVM.intertwines_boundedMeasurableRepresentation {Ω : Type*} [MeasurableSpace Ω]
    [CompleteSpace X] [CompleteSpace Z] (P : PVM Ω X) (R : PVM Ω Z)
    (L : X →L[ℝ] Z) (hL : ∀ E : MeasSet Ω, L.comp (P.val E) = (R.val E).comp L)
    (a : boundedMeasurableAlgebra Ω) :
    L.comp (P.boundedMeasurableRepresentation a) =
      (R.boundedMeasurableRepresentation a).comp L := by
  ext x
  apply eq_of_dual_eval
  intro f
  let m := R.toOVM.orbitCharge (L x) f
  have hca : m.CountablyAdditive := fun E hE => R.toOVM.normal_J (L x) E hE f
  let ρ := m.variationMeasure
  have hnull (E : MeasSet Ω) (hE : ρ E.1 = 0) : m.val E = 0 := by
    dsimp [ρ] at hE
    rw [m.variationMeasure_apply hca E, ENNReal.ofReal_eq_zero] at hE
    have hp := m.positivePart_positive E
    have hq := m.neg.positivePart_positive E
    rw [m.val_eq_positive_sub_negative E]
    linarith
  obtain ⟨h, _, hi, hd⟩ := m.exists_rnDensity hca ρ hnull
  have hs (E : MeasSet Ω) : (adjoint L f) (P.val E x) = ∫ t in E.1, h t ∂ρ := by
    change f (L (P.val E x)) = _
    rw [show L (P.val E x) = R.val E (L x) from DFunLike.congr_fun (hL E) x]
    exact hd E
  exact (P.toOVM.boundedMeasurableMultiplier_coeff a (J x) (adjoint L f) ρ h hi hs).trans
    (R.toOVM.boundedMeasurableMultiplier_coeff a (J (L x)) f ρ h hi hd).symm

#print axioms PVM.intertwines_boundedMeasurableRepresentation

/-- Bounded linear images preserve weak precompactness, including the
explicit boundedness in its definition here. -/
theorem WeaklyPrecompactSet.image_continuousLinearMap {K : Set X}
    (hK : WeaklyPrecompactSet K) (L : X →L[ℝ] Z) :
    WeaklyPrecompactSet (L '' K) := by
  constructor
  · obtain ⟨C, hC⟩ := hK.1
    refine ⟨‖L‖ * C, ?_⟩
    rintro _ ⟨x, hx, rfl⟩
    exact (L.le_opNorm x).trans (mul_le_mul_of_nonneg_left (hC x hx) (norm_nonneg L))
  · intro z hz
    choose x hx he using hz
    obtain ⟨φ, hφ, hC⟩ := hK.2 x hx
    refine ⟨φ, hφ, fun f => ?_⟩
    have h₁ := hC (adjoint L f)
    have h₂ : (fun n => adjoint L f (x (φ n))) = fun n => f (z (φ n)) :=
      funext fun n => congrArg f (he (φ n))
    rwa [h₂] at h₁

theorem WeaklyPrecompactSet.continuousLinearEquiv_image_iff (K : Set X) (L : X ≃L[ℝ] Z) :
    WeaklyPrecompactSet (L '' K) ↔ WeaklyPrecompactSet K := by
  constructor
  · intro h
    have h' := h.image_continuousLinearMap L.symm.toContinuousLinearMap
    have he : L.symm '' (L '' K) = K := by
      ext x
      constructor
      · rintro ⟨y, ⟨w, hw, rfl⟩, rfl⟩
        simpa only [ContinuousLinearEquiv.symm_apply_apply] using hw
      · intro hx
        exact ⟨L x, ⟨x, hx, rfl⟩, L.symm_apply_apply x⟩
    change WeaklyPrecompactSet (L.symm '' (L '' K)) at h'
    rwa [he] at h'
  · intro h
    exact h.image_continuousLinearMap L.toContinuousLinearMap

#print axioms WeaklyPrecompactSet.image_continuousLinearMap
#print axioms WeaklyPrecompactSet.continuousLinearEquiv_image_iff

end MultiplierHullTransport

noncomputable section GeometryCore

open MeasureTheory
open scoped Pointwise
universe uΩ uZ

variable {Ω : Type uΩ} [MeasurableSpace Ω]
  {Z : Type uZ} [NormedAddCommGroup Z] [NormedSpace ℝ Z] [CompleteSpace Z]

/-- The orbit of a set under the multiplier unit ball, and its closed convex hull. -/
def PVM.multiplierOrbit (P : PVM Ω Z) (K : Set Z) : Set Z :=
  {y | ∃ (a : boundedMeasurableAlgebra Ω) (x : Z),
    ‖a.1‖ ≤ 1 ∧ x ∈ K ∧ P.boundedMeasurableRepresentation a x = y}

def PVM.multiplierHull (P : PVM Ω Z) (K : Set Z) : Set Z :=
  closure (convexHull ℝ (P.multiplierOrbit K))

private theorem norm_measurableIndicator_le_one (E : MeasSet Ω) : ‖(measurableIndicator E).1‖ ≤ 1 := by
  let : TopologicalSpace Ω := ⊥
  apply (BoundedContinuousFunction.norm_le (by norm_num)).mpr
  intro t
  rw [measurableIndicator_apply]
  by_cases ht : t ∈ E.1 <;> simp [ht]

theorem PVM.subset_multiplierOrbit (P : PVM Ω Z) (K : Set Z) : K ⊆ P.multiplierOrbit K := by
  intro x hx
  refine ⟨measurableIndicator MeasSet.whole, x, norm_measurableIndicator_le_one _, hx, ?_⟩
  rw [P.boundedMeasurableRepresentation_indicator, P.normalized]
  rfl

theorem PVM.subset_multiplierHull (P : PVM Ω Z) (K : Set Z) : K ⊆ P.multiplierHull K :=
  (P.subset_multiplierOrbit K).trans ((subset_convexHull ℝ _).trans subset_closure)

omit [CompleteSpace Z] in
private theorem mapsTo_closedConvexHull (L : Z →L[ℝ] Z) {A : Set Z} (h : MapsTo L A A) :
    MapsTo L (closure (convexHull ℝ A)) (closure (convexHull ℝ A)) := by
  intro x hx
  have he : L '' convexHull ℝ A = convexHull ℝ (L '' A) := L.toLinearMap.image_convexHull _
  have hm : L '' A ⊆ A := fun _ ⟨y, hy, hEq⟩ => hEq ▸ h hy
  have hc := image_closure_subset_closure_image L.continuous (mem_image_of_mem L hx)
  rw [he] at hc
  exact closure_mono (convexHull_mono hm) hc

local instance (priority := 2000) (S : Type*) [MeasurableSpace S] :
    Semiring (boundedMeasurableAlgebra S) := (boundedMeasurableAlgebra S).toRing.toSemiring

theorem PVM.maps_multiplierHull (P : PVM Ω Z) (K : Set Z)
    (b : boundedMeasurableAlgebra Ω) (hb : ‖b.1‖ ≤ 1) :
    MapsTo (P.boundedMeasurableRepresentation b) (P.multiplierHull K) (P.multiplierHull K) := by
  apply mapsTo_closedConvexHull
  rintro _ ⟨a, x, ha, hx, rfl⟩
  refine ⟨b * a, x, ?_, hx, ?_⟩
  · change ‖b.1 * a.1‖ ≤ 1
    exact (norm_mul_le _ _).trans
      ((mul_le_of_le_one_left (norm_nonneg _) hb).trans ha)
  · rw [map_mul]
    rfl

theorem PVM.cut_maps_multiplierHull (P : PVM Ω Z) (K : Set Z) (A : MeasSet Ω) :
    MapsTo (P.val A) (P.multiplierHull K) (P.multiplierHull K) := by
  rw [← P.boundedMeasurableRepresentation_indicator A]
  exact P.maps_multiplierHull K _ (norm_measurableIndicator_le_one A)

theorem PVM.multiplierHull_balanced (P : PVM Ω Z) (K : Set Z) : Balanced ℝ (P.multiplierHull K) := by
  intro c hc
  rintro _ ⟨y, hy, rfl⟩
  let : TopologicalSpace Ω := ⊥
  let b : boundedMeasurableAlgebra Ω := algebraMap ℝ _ c
  have hb : ‖b.1‖ ≤ 1 := by
    apply (BoundedContinuousFunction.norm_le (by norm_num)).mpr
    intro t
    exact hc
  have he : P.boundedMeasurableRepresentation b y = c • y := by
    change P.boundedMeasurableRepresentation (algebraMap ℝ _ c) y = _
    rw [AlgHom.commutes]
    rfl
  change c • y ∈ P.multiplierHull K
  rw [← he]
  exact P.maps_multiplierHull K b hb hy

theorem PVM.multiplierOrbit_bounded (P : PVM Ω Z) (K : Set Z)
    (C : ℝ) (hC0 : 0 ≤ C) (hC : ∀ x ∈ K, ‖x‖ ≤ C) :
    P.multiplierOrbit K ⊆ Metric.closedBall 0 (2 * P.toOVM.uniformNorm * C) := by
  rintro _ ⟨a, x, ha, hx, rfl⟩
  rw [mem_closedBall_zero_iff]
  have hM := P.toOVM.uniformNorm_nonneg
  change ‖P.toOVM.boundedMeasurableMultiplier a x‖ ≤ _
  calc
    _ ≤ ‖P.toOVM.boundedMeasurableMultiplier a‖ * ‖x‖ := (P.toOVM.boundedMeasurableMultiplier a).le_opNorm x
    _ ≤ (2 * P.toOVM.uniformNorm * ‖a.1‖) * C :=
      mul_le_mul (P.toOVM.norm_boundedMeasurableMultiplier_le a) (hC x hx)
        (norm_nonneg _) (by positivity)
    _ ≤ (2 * P.toOVM.uniformNorm * 1) * C :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left ha (by positivity)) hC0
    _ = _ := by rw [mul_one]

theorem PVM.multiplierHull_bounded (P : PVM Ω Z) (K : Set Z)
    (C : ℝ) (hC0 : 0 ≤ C) (hC : ∀ x ∈ K, ‖x‖ ≤ C) :
    P.multiplierHull K ⊆ Metric.closedBall 0 (2 * P.toOVM.uniformNorm * C) :=
  closure_minimal (convexHull_min (P.multiplierOrbit_bounded K C hC0 hC) (convex_closedBall _ _))
    Metric.isClosed_closedBall

/-- The usual scalar-coordinate realization of vector-measure L¹ with a
finite control measure given by a positive scalar coefficient. -/
structure VectorL1Coordinates (m : MeasSet Ω → Z) (ρ : Measure Ω) (g : Dual Z) where
  model : VectorMeasureL1Model m
  scalar : letI := model.normedGroup; letI := model.normedScalar;
    KotheScalarSpace ρ model.carrier
  coefficient : letI := model.normedGroup; letI := model.normedScalar;
    ∀ y : model.carrier, ∀ E : MeasSet Ω,
    g (model.data.integration (model.data.multiplication.val E y)) =
      ∫ t in E.1, scalar.repr y t ∂ρ

/-- Standard vector-measure integration, with the scalar representatives in
the control measure's a.e. classes, cf. Diestel–Uhl and Okada–Ricker–Sánchez Pérez.
The L¹ bound follows from integrating with respect to the positive control
coefficient: its variation is the control measure itself. -/
axiom citeVectorMeasureL1ControlCoordinates (m : MeasSet Ω → Z) (ρ : Measure Ω)
    [IsFiniteMeasure ρ] (g : Dual Z)
    (h₀ : m MeasSet.empty = 0)
    (hσ : ∀ A : ℕ → MeasSet Ω, MeasSet.DisjointSeq A →
      HasSum (fun n => m (A n)) (m (MeasSet.iUnion A)))
    (hρ : ∀ E : MeasSet Ω, (ρ E.1).toReal = g (m E))
    (hnull : ∀ E : MeasSet Ω, ρ E.1 = 0 ↔
      ∀ F : MeasSet Ω, F.1 ⊆ E.1 → m F = 0) :
    Nonempty (VectorL1Coordinates m ρ g)

/-- The closed convex solid hull theorem on an order-continuous Köthe
space, as recalled by Avilés et al., proof of Theorem 4.5. -/
axiom citeOrderContinuousWeakPrecompactSolidHull {ρ : Measure Ω}
    (S : KotheScalarSpace ρ Z) (K : Set Z) (hK : WeaklyPrecompactSet K) :
    WeaklyPrecompactSet (closure (convexHull ℝ
      {y : Z | ∃ x ∈ K, ∀ᵐ t ∂ρ, |S.repr y t| ≤ |S.repr x t|}))

/-- Transported scalar coordinates of the cyclic vector-measure model. -/
theorem PVM.multiplierHull_weaklyPrecompact (P : PVM Ω Z) (hcyc : P.Cyclic)
    (K : Set Z) (hK : WeaklyPrecompactSet K) :
    WeaklyPrecompactSet (P.multiplierHull K) := by
  classical
  obtain ⟨u, hu⟩ := hcyc
  obtain ⟨ρ, hfin, g, hg, hρ⟩ := P.exists_faithful_positive_coefficient hu
  let : IsFiniteMeasure ρ := hfin
  let D := P.identityDilation
  let m := D.cyclicVectorMeasure u
  have hm (E : MeasSet Ω) : m E = P.val E u := rfl
  have hnull (E : MeasSet Ω) : ρ E.1 = 0 ↔
      ∀ F : MeasSet Ω, F.1 ⊆ E.1 → m F = 0 := by
    constructor
    · intro hn F hF
      rw [hm, (hρ F).mp (measure_mono_null hF hn), zero_apply]
    · intro hn
      apply (hρ E).mpr
      apply P.zero_of_cyclic_orbit hu
      intro F
      have hs := hn (E.inter F) inter_subset_left
      exact hs
  obtain ⟨M⟩ := citeVectorMeasureL1ControlCoordinates m ρ g
    (D.cyclicVectorMeasure_empty u) (D.cyclicVectorMeasure_hasSum u)
    (fun E => (hg E).trans (congrArg g (hm E).symm)) hnull
  let : NormedAddCommGroup M.model.carrier := M.model.normedGroup
  let : NormedSpace ℝ M.model.carrier := M.model.normedScalar
  let : CompleteSpace M.model.carrier := M.model.isComplete
  obtain ⟨e, _, hI, hP, _⟩ := P.identity_vectorMeasureL1_equivalence u hu M.model.data
  let q := M.scalar.repr.comp e.toLinearEquiv.toLinearMap
  have hqinj : Function.Injective q := M.scalar.injective.comp e.injective
  have hcoeff (x : Z) (E : MeasSet Ω) : g (P.val E x) = ∫ t in E.1, q x t ∂ρ := by
    rw [← e.symm_apply_apply (P.val E x)]
    change g (e.symm (e (P.val E x))) = _
    have he : e (P.val E x) = M.model.data.multiplication.val E (e x) := DFunLike.congr_fun (hP E) x
    rw [he]
    exact (congrArg (fun L : M.model.carrier →L[ℝ] Z =>
      g (L (M.model.data.multiplication.val E (e x)))) hI).trans (M.coefficient (e x) E)
  have hqi (x : Z) : Integrable (q x : Ω → ℝ) ρ := (M.scalar.l1 (e x)).1
  have hmul (a : boundedMeasurableAlgebra Ω) (x : Z) :
      (q (P.boundedMeasurableRepresentation a x) : Ω → ℝ) =ᵐ[ρ] fun t => a.1 t * q x t := by
    let : TopologicalSpace Ω := ⊥
    apply ae_eq_from_cut_integrals ρ (hqi _)
      ((hqi _).bdd_mul (c := ‖a.1‖) a.2.aestronglyMeasurable
        (Eventually.of_forall fun t => BoundedContinuousFunction.norm_coe_le_norm a.1 t))
    intro E
    rw [← hcoeff]
    exact P.boundedMeasurableMultiplier_cut a x g ρ (q x) (hqi x) (hcoeff x) E
  have heq : e '' P.multiplierOrbit K =
      {y : M.model.carrier | ∃ x ∈ e '' K, ∀ᵐ t ∂ρ, |M.scalar.repr y t| ≤ |M.scalar.repr x t|} := by
    ext y
    constructor
    · rintro ⟨_, ⟨a, x, ha, hx, rfl⟩, rfl⟩
      refine ⟨e x, ⟨x, hx, rfl⟩, ?_⟩
      let : TopologicalSpace Ω := ⊥
      filter_upwards [hmul a x] with t ht
      change |q (P.boundedMeasurableRepresentation a x) t| ≤ |q x t|
      rw [ht, abs_mul]
      exact mul_le_of_le_one_left (abs_nonneg _) ((BoundedContinuousFunction.norm_coe_le_norm a.1 t).trans ha)
    · rintro ⟨_, ⟨x, hx, rfl⟩, hd⟩
      let z := e.symm y
      have hdom : ∀ᵐ t ∂ρ, |q z t| ≤ |q x t| := by
        change ∀ᵐ t ∂ρ, |M.scalar.repr (e (e.symm y)) t| ≤ _
        rwa [e.apply_symm_apply]
      obtain ⟨a, ha, hb⟩ := exists_boundedMultiplier_of_ae_domination ρ (q z) (q x)
        (q z).stronglyMeasurable.measurable (q x).stronglyMeasurable.measurable hdom
      have hz := hqinj (AEEqFun.ext ((hmul a x).trans hb.symm))
      exact ⟨z, ⟨a, x, ha, hx, hz⟩, e.apply_symm_apply y⟩
  apply (WeaklyPrecompactSet.continuousLinearEquiv_image_iff (P.multiplierHull K) e).mp
  unfold PVM.multiplierHull
  have hcl : e '' closure (convexHull ℝ (P.multiplierOrbit K)) =
      closure (e '' convexHull ℝ (P.multiplierOrbit K)) := e.toHomeomorph.image_closure _
  have hcv : e '' convexHull ℝ (P.multiplierOrbit K) =
      convexHull ℝ (e '' P.multiplierOrbit K) := e.toLinearEquiv.toLinearMap.image_convexHull _
  rw [hcl, hcv, heq]
  exact citeOrderContinuousWeakPrecompactSolidHull M.scalar (e '' K)
    (hK.image_continuousLinearMap e.toContinuousLinearMap)

theorem PVM.multiplierHull_weaklyCompact (P : PVM Ω Z) (hcyc : P.Cyclic)
    (K : Set Z) (hK : WeaklyPrecompactSet K) (hb : P.BoundedlyComplete) :
    IsCompact (toWeakSpace ℝ Z '' P.multiplierHull K) :=
  (P.multiplierHull_weaklyPrecompact hcyc K hK).weaklyCompact_of_closed_convex
    isClosed_closure (convex_convexHull ℝ _).closure
    (P.weaklySeqComplete_of_boundedlyComplete (P.localizes_of_cyclic hcyc) hb)

#print axioms PVM.multiplierHull_weaklyPrecompact
#print axioms PVM.multiplierHull_weaklyCompact

end GeometryCore

noncomputable section DFJPInterpolation

open scoped Pointwise
universe u₁ u₂
variable {Z : Type u₁} [NormedAddCommGroup Z] [NormedSpace ℝ Z]

/-- The DFJP gauge at level n + 1, indexing the original sequence from 0. -/
def dfjpGauge (W : Set Z) (n : ℕ) (z : Z) : ℝ :=
  gauge (((2 : ℝ) ^ (n + 1)) • W + ((2 : ℝ) ^ (n + 1))⁻¹ • Metric.closedBall (0 : Z) 1) z

structure DFJPInterpolation (W : Set Z) where
  carrier : Type u₁
  normedGroup : NormedAddCommGroup carrier
  normedScalar : letI := normedGroup; NormedSpace ℝ carrier
  complete : letI := normedGroup; CompleteSpace carrier
  inclusion : letI := normedGroup; letI := normedScalar; carrier →L[ℝ] Z
  injective : letI := normedGroup; letI := normedScalar; Function.Injective inclusion
  range_iff : letI := normedGroup; letI := normedScalar; ∀ z : Z,
    z ∈ Set.range inclusion ↔ Summable fun n => (dfjpGauge W n z) ^ 2
  norm_formula : letI := normedGroup; letI := normedScalar; ∀ x : carrier,
    ‖x‖ = Real.sqrt (∑' n, (dfjpGauge W n (inclusion x)) ^ 2)
  gauge_bound : ∀ n z, dfjpGauge W n z ≤ (2 : ℝ) ^ (n + 1) * ‖z‖
  gauge_contraction : ∀ (A : Z →L[ℝ] Z), ‖A‖ ≤ 1 → MapsTo A W W →
    ∀ n z, dfjpGauge W n (A z) ≤ dfjpGauge W n z
  unit_contains : letI := normedGroup; letI := normedScalar;
    ∀ z ∈ W, ∃ x : carrier, inclusion x = z ∧ ‖x‖ ≤ 1
  reflexive : letI := normedGroup; letI := normedScalar;
    IsCompact (toWeakSpace ℝ Z '' W) → IsReflexive carrier
  no_lOne : letI := normedGroup; letI := normedScalar;
    WeaklyPrecompactSet W → ¬ ContainsCopy LOne carrier

/-- DFJP, Lemma 1, and the weak-precompact form recalled by Avilés et al.,
Section 4. The coordinates are the Minkowski gauges of the original sets.
The bounds and contraction property are those of the individual gauges. -/
axiom citeDFJPInterpolation [CompleteSpace Z] (W : Set Z)
    (hW₀ : 0 ∈ W) (hc : Convex ℝ W) (hb : Balanced ℝ W) (hcl : IsClosed W)
    (hbounded : ∃ C : ℝ, ∀ z ∈ W, ‖z‖ ≤ C) :
    Nonempty (DFJPInterpolation W)

namespace DFJPInterpolation

variable {W : Set Z} (M : DFJPInterpolation W)

-- Specialized from Mathlib's Tannery argument (David Loeffler, 2024, Apache-2.0).
private theorem tendsto_nonnegative_tsum_zero {ι : Type*} {l : Filter ι}
    {f : ι → ℕ → ℝ} {b : ℕ → ℝ} (hb : Summable b)
    (hp : ∀ n, Tendsto (fun i => f i n) l (𝓝 0))
    (hd : ∀ᶠ i in l, ∀ n, 0 ≤ f i n ∧ f i n ≤ b n) :
    Tendsto (fun i => ∑' n, f i n) l (𝓝 0) := by
  rw [Metric.tendsto_nhds]
  intro ε hε
  obtain ⟨T, hT⟩ : ∃ T : Finset ℕ, dist (∑ n ∈ T, b n) (∑' n, b n) < ε / 2 :=
    Eventually.exists (Metric.tendsto_nhds.mp hb.hasSum _ (by positivity))
  have hs : (∑' n : (Tᶜ : Set ℕ), b n) < ε / 2 := by
    have he := hb.sum_add_tsum_compl (s := T)
    rw [Real.dist_eq, abs_lt] at hT
    linarith
  have hfin : Tendsto (fun i => ∑ n ∈ T, f i n) l (𝓝 0) := by
    simpa only [Finset.sum_const_zero] using (tendsto_finsetSum T fun n _ => hp n)
  filter_upwards [Metric.tendsto_nhds.mp hfin (ε / 2) (by positivity), hd] with i hfi hi
  have hsum : Summable (f i) := Summable.of_nonneg_of_le (fun n => (hi n).1) (fun n => (hi n).2) hb
  have hcomp : (∑' n : (Tᶜ : Set ℕ), f i n) ≤ ∑' n : (Tᶜ : Set ℕ), b n :=
    (hsum.subtype (fun n : ℕ => n ∉ T)).tsum_le_tsum
      (fun n : (Tᶜ : Set ℕ) => (hi n).2) (hb.subtype (fun n : ℕ => n ∉ T))
  rw [Real.dist_eq, sub_zero, abs_of_nonneg (tsum_nonneg fun n => (hi n).1)]
  rw [← hsum.sum_add_tsum_compl (s := T)]
  rw [Real.dist_eq, sub_zero, abs_of_nonneg (Finset.sum_nonneg fun n _ => (hi n).1)] at hfi
  linarith

private theorem contractive_in_range (A : Z →L[ℝ] Z) (hA : ‖A‖ ≤ 1) (hAW : MapsTo A W W) :
    letI := M.normedGroup; letI := M.normedScalar; ∀ x : M.carrier,
      A (M.inclusion x) ∈ Set.range M.inclusion := by
  let : NormedAddCommGroup M.carrier := M.normedGroup
  let : NormedSpace ℝ M.carrier := M.normedScalar
  intro x
  apply (M.range_iff _).mpr
  exact Summable.of_nonneg_of_le (fun _ => sq_nonneg _)
    (fun n => (sq_le_sq₀ (gauge_nonneg _) (gauge_nonneg _)).mpr (M.gauge_contraction A hA hAW n _))
    ((M.range_iff _).mp ⟨x, rfl⟩)

/-- The DFJP lift of a contraction preserving the interpolation set. -/
def lift (A : Z →L[ℝ] Z) (hA : ‖A‖ ≤ 1) (hAW : MapsTo A W W) :
    letI := M.normedGroup; letI := M.normedScalar; M.carrier →L[ℝ] M.carrier := by
  let : NormedAddCommGroup M.carrier := M.normedGroup
  let : NormedSpace ℝ M.carrier := M.normedScalar
  have hs (x : M.carrier) : Summable (fun n => (dfjpGauge W n (M.inclusion x)) ^ 2) :=
    (M.range_iff _).mp ⟨x, rfl⟩
  have hle (x : M.carrier) (n : ℕ) :
      (dfjpGauge W n (A (M.inclusion x))) ^ 2 ≤ (dfjpGauge W n (M.inclusion x)) ^ 2 :=
    (sq_le_sq₀ (gauge_nonneg _) (gauge_nonneg _)).mpr (M.gauge_contraction A hA hAW n _)
  let L (x : M.carrier) := Classical.choose (M.contractive_in_range A hA hAW x)
  have hL (x : M.carrier) : M.inclusion (L x) = A (M.inclusion x) :=
    Classical.choose_spec (M.contractive_in_range A hA hAW x)
  let f : M.carrier →ₗ[ℝ] M.carrier :=
    { toFun := L
      map_add' := fun x y => M.injective (by rw [hL, map_add, map_add, map_add, hL, hL])
      map_smul' := fun a x => M.injective (by
        change M.inclusion (L (a • x)) = M.inclusion (a • L x)
        rw [hL, map_smul, map_smul, map_smul, hL]) }
  refine f.mkContinuous 1 (fun x => ?_)
  change ‖L x‖ ≤ 1 * ‖x‖
  rw [one_mul, M.norm_formula (L x), M.norm_formula x, hL]
  have hsum := Summable.of_nonneg_of_le (fun _ => sq_nonneg _) (hle x) (hs x)
  exact Real.sqrt_le_sqrt (hsum.tsum_le_tsum (hle x) (hs x))

theorem inclusion_lift (A : Z →L[ℝ] Z) (hA : ‖A‖ ≤ 1) (hAW : MapsTo A W W) :
    letI := M.normedGroup; letI := M.normedScalar;
    M.inclusion.comp (M.lift A hA hAW) = A.comp M.inclusion := by
  let : NormedAddCommGroup M.carrier := M.normedGroup
  let : NormedSpace ℝ M.carrier := M.normedScalar
  ext x
  change M.inclusion (Classical.choose (M.contractive_in_range A hA hAW x)) = A (M.inclusion x)
  exact Classical.choose_spec (M.contractive_in_range A hA hAW x)

/-- Dominated convergence in the squares of the individual DFJP gauges. -/
theorem tendsto_zero_of_dominated_gauges {ι : Type*} (l : Filter ι) :
    letI := M.normedGroup; letI := M.normedScalar;
    ∀ (f : ι → M.carrier) (x : M.carrier),
      Tendsto (fun i => ‖M.inclusion (f i)‖) l (𝓝 0) →
      (∀ᶠ i in l, ∀ n, dfjpGauge W n (M.inclusion (f i)) ≤ dfjpGauge W n (M.inclusion x)) →
        Tendsto (fun i => ‖f i‖) l (𝓝 0) := by
  let : NormedAddCommGroup M.carrier := M.normedGroup
  let : NormedSpace ℝ M.carrier := M.normedScalar
  intro f x hf hd
  have hs := (M.range_iff (M.inclusion x)).mp ⟨x, rfl⟩
  have ht (n : ℕ) :
      Tendsto (fun i => (dfjpGauge W n (M.inclusion (f i))) ^ 2) l (𝓝 (0 : ℝ)) := by
    have hc : Tendsto (fun _ : ι => (2 : ℝ) ^ (n + 1)) l (𝓝 ((2 : ℝ) ^ (n + 1))) :=
      tendsto_const_nhds
    have hb := squeeze_zero (fun i => gauge_nonneg (M.inclusion (f i))) (fun i => M.gauge_bound n _)
      (by simpa only [mul_zero] using hc.mul hf)
    simpa only [dfjpGauge, zero_pow (by decide : (2 : ℕ) ≠ 0)] using hb.pow 2
  have hu : Tendsto (fun i => ∑' n, (dfjpGauge W n (M.inclusion (f i))) ^ 2) l (𝓝 0) := by
    exact tendsto_nonnegative_tsum_zero hs ht (hd.mono fun i hi n =>
      ⟨sq_nonneg _, (sq_le_sq₀ (gauge_nonneg _) (gauge_nonneg _)).mpr (hi n)⟩)
  have h := (Real.continuous_sqrt.tendsto 0).comp hu
  change Tendsto (fun i => √(∑' n, (dfjpGauge W n (M.inclusion (f i))) ^ 2)) l (𝓝 (√0)) at h
  simpa only [M.norm_formula, Real.sqrt_zero] using h

variable {Ω : Type*} [MeasurableSpace Ω]

/-- The lifted indicator operators are strongly countably additive.
The ambient PVM supplies the norm limit and the gauge contraction supplies
summable domination for each finite remainder. -/
def liftPVM (P : PVM Ω Z) (hP : ∀ E, ‖P.val E‖ ≤ 1)
    (hW : ∀ E, MapsTo (P.val E) W W) :
    letI := M.normedGroup; letI := M.normedScalar; PVM Ω M.carrier := by
  let : NormedAddCommGroup M.carrier := M.normedGroup
  let : NormedSpace ℝ M.carrier := M.normedScalar
  let Q (E : MeasSet Ω) := M.lift (P.val E) (hP E) (hW E)
  have hQ (E : MeasSet Ω) (x : M.carrier) :
      M.inclusion (Q E x) = P.val E (M.inclusion x) :=
    DFunLike.congr_fun (M.inclusion_lift (P.val E) (hP E) (hW E)) x
  refine { val := Q
           empty_eq := ?_
           normalized := ?_
           mul_eq := ?_
           countably_additive := ?_ }
  · ext x
    apply M.injective
    simp [hQ, P.empty_eq]
  · intro A hA x
    let U := MeasSet.iUnion A
    let V (s : Finset ℕ) := MeasSet.finiteUnion A s
    let R (s : Finset ℕ) := U.diff (V s)
    let err (s : Finset ℕ) := Q U x - ∑ n ∈ s, Q (A n) x
    have hV (s : Finset ℕ) : (V s).1 ⊆ U.1 := by
      intro t ht
      obtain ⟨n, _, hn⟩ := mem_iUnion₂.mp ht
      exact mem_iUnion.mpr ⟨n, hn⟩
    have hre (s : Finset ℕ) : M.inclusion (err s) = P.val (R s) (M.inclusion x) := by
      dsimp [err]
      rw [map_sub, hQ, map_sum]
      simp only [hQ]
      rw [← P.toOVM.apply_finite_union A hA s]
      have huv : U = (V s).union (R s) := Subtype.ext (Set.union_sdiff_cancel (hV s)).symm
      change P.val U (M.inclusion x) - P.val (V s) (M.inclusion x) = _
      conv_lhs => rw [huv]
      rw [P.toOVM.apply_union _ _ disjoint_sdiff_right, add_sub_cancel_left]
    have hnorm : Tendsto (fun s => ‖M.inclusion (err s)‖) atTop (𝓝 0) := by
      have hs : Tendsto (fun s : Finset ℕ => ∑ n ∈ s, P.val (A n) (M.inclusion x))
          atTop (𝓝 (P.val U (M.inclusion x))) := P.countably_additive A hA (M.inclusion x)
      have hc : Tendsto (fun _ : Finset ℕ => P.val U (M.inclusion x)) atTop
          (𝓝 (P.val U (M.inclusion x))) := tendsto_const_nhds
      have h := (hc.sub hs).norm
      simpa only [sub_self, norm_zero, err, map_sub, hQ, map_sum] using h
    have hlim := M.tendsto_zero_of_dominated_gauges atTop err x hnorm
      (Eventually.of_forall fun s n => by
        rw [hre]
        exact M.gauge_contraction (P.val (R s)) (hP (R s)) (hW (R s)) n _)
    change Tendsto (fun s : Finset ℕ => ∑ n ∈ s, Q (A n) x) atTop (𝓝 (Q U x))
    rw [Metric.tendsto_nhds]
    intro ε hε
    filter_upwards [Metric.tendsto_nhds.mp hlim ε hε] with s hs
    rw [Real.dist_eq, sub_zero, abs_of_nonneg (norm_nonneg _)] at hs
    rw [dist_eq_norm, norm_sub_rev]
    exact hs
  · change Q MeasSet.whole = ContinuousLinearMap.id ℝ M.carrier
    ext x
    apply M.injective
    rw [hQ, show P.val MeasSet.whole = ContinuousLinearMap.id ℝ Z from P.normalized]
    rfl
  · intro A B
    ext x
    apply M.injective
    change M.inclusion (Q A (Q B x)) = M.inclusion (Q (A.inter B) x)
    rw [hQ, hQ, hQ]
    exact DFunLike.congr_fun (P.mul_eq A B) _

theorem inclusion_liftPVM (P : PVM Ω Z) (hP : ∀ E, ‖P.val E‖ ≤ 1)
    (hW : ∀ E, MapsTo (P.val E) W W) (E : MeasSet Ω) :
    letI := M.normedGroup; letI := M.normedScalar;
    M.inclusion.comp ((M.liftPVM P hP hW).val E) = (P.val E).comp M.inclusion := by
  let : NormedAddCommGroup M.carrier := M.normedGroup
  let : NormedSpace ℝ M.carrier := M.normedScalar
  change M.inclusion.comp (M.lift (P.val E) (hP E) (hW E)) = (P.val E).comp M.inclusion
  exact M.inclusion_lift _ (hP E) (hW E)

#print axioms DFJPInterpolation.liftPVM

end DFJPInterpolation

end DFJPInterpolation

noncomputable section OrbitCriterion

open scoped Pointwise
universe uΩ uX uZ
variable {Ω : Type uΩ} [MeasurableSpace Ω]
  {X : Type uX} [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X]
  {Z : Type uZ} [NormedAddCommGroup Z] [NormedSpace ℝ Z] [CompleteSpace Z]

def RelativelyWeaklyCompact (K : Set Z) : Prop :=
  IsCompact (closure (toWeakSpace ℝ Z '' K))

/-- Eberlein–Šmulian, in the relative form. -/
axiom citeRelativeEberleinSmulian (K : Set Z) :
    RelativelyWeaklyCompact K ↔ ∀ u : ℕ → Z, (∀ n, u n ∈ K) →
      ∃ (φ : ℕ → ℕ) (_ : StrictMono φ) (z : Z),
        ∀ f : Dual Z, Tendsto (fun n => f (u (φ n))) atTop (𝓝 (f z))

/-- Closed subspaces of reflexive Banach spaces are reflexive. -/
axiom citeReflexiveClosedSubspace (hZ : IsReflexive Z) (V : Submodule ℝ Z)
    (hV : IsClosed (V : Set Z)) : IsReflexive V

/-- Krein–Šmulian's closed convex hull theorem. -/
axiom citeKreinClosedConvexHull {K : Set Z} (hK : RelativelyWeaklyCompact K) :
    IsCompact (toWeakSpace ℝ Z '' closure (convexHull ℝ K))

/-- Closed convex hull stability of weak precompactness, as used in
Avilés et al., Section 4. -/
axiom citeWeaklyPrecompactClosedConvexHull {K : Set Z} (hK : WeaklyPrecompactSet K) :
    WeaklyPrecompactSet (closure (convexHull ℝ K))

omit [CompleteSpace X] [CompleteSpace Z] in
private theorem relativelyWeaklyCompact_image {K : Set X} (hK : RelativelyWeaklyCompact K)
    (A : X →L[ℝ] Z) : RelativelyWeaklyCompact (A '' K) := by
  apply (citeRelativeEberleinSmulian _).mpr
  intro u hu
  choose x hx he using hu
  obtain ⟨φ, hφ, z, hz⟩ := (citeRelativeEberleinSmulian _).mp hK x hx
  refine ⟨φ, hφ, A z, fun f => ?_⟩
  exact (hz (adjoint A f)).congr' (Eventually.of_forall fun n => congrArg f (he (φ n)))

private theorem relativelyWeaklyCompact_of_reflexive (hZ : IsReflexive Z) {K : Set Z}
    (hB : ∃ C : ℝ, ∀ z ∈ K, ‖z‖ ≤ C) : RelativelyWeaklyCompact K := by
  apply (citeRelativeEberleinSmulian _).mpr
  intro u hu
  obtain ⟨C, hC⟩ := hB
  exact (citeEberleinSmulian Z).2.mp hZ u ⟨C, fun n => hC (u n) (hu n)⟩

private theorem weaklyPrecompact_of_no_lOne (hZ : ¬ ContainsCopy LOne Z) {K : Set Z}
    (hB : ∃ C : ℝ, ∀ z ∈ K, ‖z‖ ≤ C) : WeaklyPrecompactSet K := by
  refine ⟨hB, fun u hu => ?_⟩
  obtain ⟨C, hC⟩ := hB
  exact citeRosenthal1974 Z hZ u ⟨C, fun n => hC (u n) (hu n)⟩

def OVM.alphaMultiplierOrbit (μ : OVM Ω X) : Set μ.alphaSubmodule :=
  μ.alphaPVM.multiplierOrbit (μ.alphaAnalysis '' Metric.closedBall (0 : X) 1)

omit [CompleteSpace X] in
private theorem analysisOrbit_bounded (P : PVM Ω Z) (T : X →L[ℝ] Z) :
    ∃ C : ℝ, ∀ z ∈ P.multiplierOrbit (T '' Metric.closedBall (0 : X) 1), ‖z‖ ≤ C := by
  refine ⟨2 * P.toOVM.uniformNorm * ‖T‖, fun z hz => mem_closedBall_zero_iff.mp ?_⟩
  apply P.multiplierOrbit_bounded _ ‖T‖ (norm_nonneg _) _ hz
  rintro _ ⟨x, hx, rfl⟩
  exact (T.le_opNorm x).trans (by
    simpa only [mul_one] using
      mul_le_mul_of_nonneg_left (mem_closedBall_zero_iff.mp hx) (norm_nonneg T))

private theorem Dilation.alphaOrbit_eq_comparison {μ : OVM Ω X} (D : Dilation μ Z) :
    letI : IsClosed (D.generatedSubmodule : Set Z) := Submodule.isClosed_topologicalClosure _
    μ.alphaMultiplierOrbit = D.alphaComparison ''
      ((D.P.restrict D.generatedSubmodule D.generated_invariant).multiplierOrbit
        (D.generatedAnalysis '' Metric.closedBall (0 : X) 1)) := by
  let : IsClosed (D.generatedSubmodule : Set Z) := Submodule.isClosed_topologicalClosure _
  let R := D.P.restrict D.generatedSubmodule D.generated_invariant
  have hI (a : boundedMeasurableAlgebra Ω) (x : X) :
      D.alphaComparison (R.boundedMeasurableRepresentation a (D.generatedAnalysis x)) =
        μ.alphaPVM.boundedMeasurableRepresentation a (μ.alphaAnalysis x) := by
    have h := DFunLike.congr_fun
      (R.intertwines_boundedMeasurableRepresentation μ.alphaPVM D.alphaComparison
        D.alphaComparison_intertwines a) (D.generatedAnalysis x)
    have he := DFunLike.congr_fun D.alphaComparison_analysis x
    exact h.trans (congrArg (μ.alphaPVM.boundedMeasurableRepresentation a) he)
  ext z
  constructor
  · rintro ⟨a, _, ha, ⟨x, hx, rfl⟩, h⟩
    exact ⟨_, ⟨a, _, ha, ⟨x, hx, rfl⟩, rfl⟩, (hI a x).trans h⟩
  · rintro ⟨_, ⟨a, _, ha, ⟨x, hx, rfl⟩, rfl⟩, h⟩
    exact ⟨a, _, ha, ⟨x, hx, rfl⟩, (hI a x).symm.trans h⟩

/-- Necessity in the multiplier-orbit criterion for a reflexive
dilation of arbitrary universe. -/
theorem Dilation.alphaOrbit_relativelyWeaklyCompact {μ : OVM Ω X} (D : Dilation μ Z)
    (hZ : IsReflexive Z) : RelativelyWeaklyCompact μ.alphaMultiplierOrbit := by
  let : IsClosed (D.generatedSubmodule : Set Z) := Submodule.isClosed_topologicalClosure _
  rw [D.alphaOrbit_eq_comparison]
  let R := D.P.restrict D.generatedSubmodule D.generated_invariant
  exact relativelyWeaklyCompact_image
    (relativelyWeaklyCompact_of_reflexive (citeReflexiveClosedSubspace hZ _ inferInstance)
      (analysisOrbit_bounded R D.generatedAnalysis)) D.alphaComparison

theorem Dilation.alphaOrbit_weaklyPrecompact {μ : OVM Ω X} (D : Dilation μ Z)
    (hZ : ¬ ContainsCopy LOne Z) : WeaklyPrecompactSet μ.alphaMultiplierOrbit := by
  let : IsClosed (D.generatedSubmodule : Set Z) := Submodule.isClosed_topologicalClosure _
  rw [D.alphaOrbit_eq_comparison]
  have hv : ¬ ContainsCopy LOne D.generatedSubmodule := by
    rintro ⟨A, c, hc, ha⟩
    exact hZ ⟨D.generatedSubmodule.subtypeL.comp A, c, hc, ha⟩
  have h := weaklyPrecompact_of_no_lOne hv
    (analysisOrbit_bounded (D.P.restrict D.generatedSubmodule D.generated_invariant) D.generatedAnalysis)
  exact h.image_continuousLinearMap D.alphaComparison

/-- A dilation with its Banach space, in the universe of the minimal
dilation. Necessity is stated separately without a universe restriction. -/
structure DilationSpace (μ : OVM Ω X) where
  carrier : Type (max uΩ uX)
  normedGroup : NormedAddCommGroup carrier
  normedScalar : letI := normedGroup; NormedSpace ℝ carrier
  complete : letI := normedGroup; CompleteSpace carrier
  dilation : letI := normedGroup; letI := normedScalar; Dilation μ carrier

private theorem OVM.exists_alphaDFJP_with_cuts (μ : OVM Ω X) (hμ : μ.Normalized) :
    ∃ M : DFJPInterpolation
      (μ.alphaPVM.multiplierHull (μ.alphaAnalysis '' Metric.closedBall (0 : X) 1)),
      letI := M.normedGroup; letI := M.normedScalar;
      ∃ D : Dilation μ M.carrier, M.inclusion.comp D.T = μ.alphaAnalysis ∧
        ∀ E : MeasSet Ω, M.inclusion.comp (D.P.val E) = (μ.alphaPVM.val E).comp M.inclusion := by
  let K := μ.alphaAnalysis '' Metric.closedBall (0 : X) 1
  let P := μ.alphaPVM
  let W := P.multiplierHull K
  have h₀ : (0 : μ.alphaSubmodule) ∈ K := by
    exact ⟨0, mem_closedBall_zero_iff.mpr (by simp), map_zero μ.alphaAnalysis⟩
  have hB : ∃ C : ℝ, ∀ z ∈ W, ‖z‖ ≤ C := by
    refine ⟨2 * P.toOVM.uniformNorm * ‖μ.alphaAnalysis‖, fun z hz => mem_closedBall_zero_iff.mp ?_⟩
    apply P.multiplierHull_bounded _ _ (norm_nonneg μ.alphaAnalysis) _ hz
    rintro _ ⟨x, hx, rfl⟩
    exact (μ.alphaAnalysis.le_opNorm x).trans (by
      simpa only [mul_one] using
        mul_le_mul_of_nonneg_left (mem_closedBall_zero_iff.mp hx) (norm_nonneg μ.alphaAnalysis))
  obtain ⟨M⟩ := citeDFJPInterpolation W (P.subset_multiplierHull K h₀)
    (convex_convexHull ℝ _).closure (P.multiplierHull_balanced K) isClosed_closure hB
  let : NormedAddCommGroup M.carrier := M.normedGroup
  let : NormedSpace ℝ M.carrier := M.normedScalar
  have he (E : MeasSet Ω) : ‖P.val E‖ ≤ 1 :=
    ContinuousLinearMap.opNorm_le_bound _ (by norm_num) (fun x => by
      change ‖μ.alphaRestriction E x‖ ≤ 1 * ‖x‖
      rw [one_mul]
      exact μ.norm_alphaRestriction_apply E x)
  let Q := M.liftPVM P he (P.cut_maps_multiplierHull K)
  obtain ⟨D, hQ, _, hT, _⟩ := (μ.alphaDilation hμ).exists_lifted_analysis Q M.inclusion M.injective
    (M.inclusion_liftPVM P he (P.cut_maps_multiplierHull K)) (fun x hx =>
      M.unit_contains _ (P.subset_multiplierHull K ⟨_, mem_closedBall_zero_iff.mpr hx, rfl⟩))
  refine ⟨M, D, hT, fun E => ?_⟩
  rw [hQ]
  exact M.inclusion_liftPVM P he (P.cut_maps_multiplierHull K) E

/-- Manuscript, prop:multiplier-orbit-criterion, both directions. -/
theorem OVM.multiplierOrbit_criterion (μ : OVM Ω X) (hμ : μ.Normalized) :
    (RelativelyWeaklyCompact μ.alphaMultiplierOrbit ↔
      ∃ M : DilationSpace μ, letI := M.normedGroup; letI := M.normedScalar; IsReflexive M.carrier) ∧
    (WeaklyPrecompactSet μ.alphaMultiplierOrbit ↔
      ∃ M : DilationSpace μ, letI := M.normedGroup; letI := M.normedScalar; ¬ ContainsCopy LOne M.carrier) := by
  obtain ⟨M, D, _, _⟩ := μ.exists_alphaDFJP_with_cuts hμ
  let B : DilationSpace μ := ⟨M.carrier, M.normedGroup, M.normedScalar, M.complete, D⟩
  constructor
  · refine ⟨fun h => ⟨B, M.reflexive (citeKreinClosedConvexHull h)⟩, ?_⟩
    rintro ⟨F, hF⟩
    let : NormedAddCommGroup F.carrier := F.normedGroup
    let : NormedSpace ℝ F.carrier := F.normedScalar
    let : CompleteSpace F.carrier := F.complete
    exact F.dilation.alphaOrbit_relativelyWeaklyCompact hF
  · refine ⟨fun h => ⟨B, M.no_lOne (citeWeaklyPrecompactClosedConvexHull h)⟩, ?_⟩
    rintro ⟨F, hF⟩
    let : NormedAddCommGroup F.carrier := F.normedGroup
    let : NormedSpace ℝ F.carrier := F.normedScalar
    let : CompleteSpace F.carrier := F.complete
    exact F.dilation.alphaOrbit_weaklyPrecompact hF

#print axioms OVM.multiplierOrbit_criterion

end OrbitCriterion

noncomputable section CyclicDilationGeometry

open MeasureTheory
open scoped Pointwise
universe uΩ uX uZ
variable {Ω : Type uΩ} [MeasurableSpace Ω]
  {X : Type uX} [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X]
  {Z : Type uZ} [NormedAddCommGroup Z] [NormedSpace ℝ Z] [CompleteSpace Z]

structure CyclicKotheCoordinates (P : PVM Ω Z) (u : Z) where
  ρ : Measure Ω
  carrier : Type (max uΩ uZ)
  normedGroup : NormedAddCommGroup carrier
  normedScalar : letI := normedGroup; NormedSpace ℝ carrier
  complete : letI := normedGroup; CompleteSpace carrier
  S : letI := normedGroup; letI := normedScalar; KotheScalarSpace ρ carrier
  P₀ : letI := normedGroup; letI := normedScalar; PVM Ω carrier
  e : letI := normedGroup; letI := normedScalar; Z ≃L[ℝ] carrier
  intertwines : letI := normedGroup; letI := normedScalar;
    ∀ A : MeasSet Ω, e.toContinuousLinearMap.comp (P.val A) = (P₀.val A).comp e.toContinuousLinearMap
  cut_bound : letI := normedGroup; letI := normedScalar; ∀ A, ‖P₀.val A‖ ≤ 1
  cut_repr : letI := normedGroup; letI := normedScalar; ∀ A z,
    (S.repr (P₀.val A z) : Ω → ℝ) =ᵐ[ρ] A.1.indicator (S.repr z)
  one_repr : letI := normedGroup; letI := normedScalar; S.repr (e u) = 1
  multiplier_repr : letI := normedGroup; letI := normedScalar; letI := complete;
    ∀ (a : boundedMeasurableAlgebra Ω) (z : carrier),
      (S.repr (P₀.boundedMeasurableRepresentation a z) : Ω → ℝ) =ᵐ[ρ]
        fun t => a.1 t * S.repr z t

theorem PVM.exists_cyclicKotheCoordinates (P : PVM Ω Z) (u : Z) (hu : P.CyclicVector u) :
    Nonempty (CyclicKotheCoordinates P u) := by
  obtain ⟨ρ, hfin, g, hg, hρ⟩ := P.exists_faithful_positive_coefficient hu
  let : IsFiniteMeasure ρ := hfin
  let D := P.identityDilation
  let m := D.cyclicVectorMeasure u
  have hm (E : MeasSet Ω) : m E = P.val E u := rfl
  have hnull (E : MeasSet Ω) : ρ E.1 = 0 ↔
      ∀ F : MeasSet Ω, F.1 ⊆ E.1 → m F = 0 := by
    constructor
    · intro hn F hF
      rw [hm, (hρ F).mp (measure_mono_null hF hn), zero_apply]
    · intro hn
      exact (hρ E).mpr (P.zero_of_cyclic_orbit hu E fun F => hn (E.inter F) inter_subset_left)
  obtain ⟨M⟩ := citeVectorMeasureL1ControlCoordinates m ρ g
    (D.cyclicVectorMeasure_empty u) (D.cyclicVectorMeasure_hasSum u)
    (fun E => (hg E).trans (congrArg g (hm E).symm)) hnull
  let : NormedAddCommGroup M.model.carrier := M.model.normedGroup
  let : NormedSpace ℝ M.model.carrier := M.model.normedScalar
  let : CompleteSpace M.model.carrier := M.model.isComplete
  obtain ⟨e, _, hI, hP, _⟩ := P.identity_vectorMeasureL1_equivalence u hu M.model.data
  let Q := M.model.data.multiplication
  let q := M.scalar.repr
  have hcomp (x : Z) (E : MeasSet Ω) : g (P.val E x) = ∫ t in E.1, q (e x) t ∂ρ := by
    rw [← e.symm_apply_apply (P.val E x)]
    have he : e (P.val E x) = Q.val E (e x) := DFunLike.congr_fun (hP E) x
    rw [he]
    exact (congrArg (fun L : M.model.carrier →L[ℝ] Z => g (L (Q.val E (e x)))) hI).trans
      (M.coefficient (e x) E)
  have hmul (a : boundedMeasurableAlgebra Ω) (z : M.model.carrier) :
      (q (Q.boundedMeasurableRepresentation a z) : Ω → ℝ) =ᵐ[ρ] fun t => a.1 t * q z t := by
    let : TopologicalSpace Ω := ⊥
    obtain ⟨x, rfl⟩ := e.surjective z
    have he := DFunLike.congr_fun (P.intertwines_boundedMeasurableRepresentation Q
      e.toContinuousLinearMap hP a) x
    change e (P.boundedMeasurableRepresentation a x) = Q.boundedMeasurableRepresentation a (e x) at he
    rw [← he]
    apply ae_eq_from_cut_integrals ρ (M.scalar.l1 _).1
      ((M.scalar.l1 _).1.bdd_mul (c := ‖a.1‖) a.2.aestronglyMeasurable
        (Eventually.of_forall fun t => BoundedContinuousFunction.norm_coe_le_norm a.1 t))
    intro E
    rw [← hcomp]
    exact P.boundedMeasurableMultiplier_cut a x g ρ _ (M.scalar.l1 _).1 (hcomp x) E
  refine ⟨⟨ρ, M.model.carrier, M.model.normedGroup, M.model.normedScalar, M.model.isComplete,
    M.scalar, Q, e, hP, M.model.data.norm_multiplication_le_one, ?_, ?_, hmul⟩⟩
  · intro A z
    change (q (Q.val A z) : Ω → ℝ) =ᵐ[ρ] A.1.indicator (q z)
    have ha := hmul (measurableIndicator A) z
    rw [Q.boundedMeasurableRepresentation_indicator] at ha
    filter_upwards [ha] with t ht
    rw [ht, measurableIndicator_apply]
    by_cases h : t ∈ A.1 <;> simp [h]
  · apply AEEqFun.ext
    have ht : (q (e u) : Ω → ℝ) =ᵐ[ρ] fun _ => 1 := by
      apply ae_eq_from_cut_integrals ρ (M.scalar.l1 _).1 (integrable_const _)
      intro E
      rw [← hcomp, ← hg, setIntegral_const]
      simp [Measure.real]
    exact ht.trans AEEqFun.coeFn_one.symm

/-- In the lattice DFJP construction the same measurable coordinates
realize the interpolation space as an order-continuous Köthe space.
Avilés et al., proof of Theorem 4.3 and Remark 4.4. -/
axiom citeLatticeDFJPKothe {ρ : Measure Ω} (S : KotheScalarSpace ρ Z)
    {W : Set Z} (M : DFJPInterpolation W)
    (hsolid : ∀ y ∈ W, ∀ x : Z, (∀ᵐ t ∂ρ, |S.repr x t| ≤ |S.repr y t|) → x ∈ W)
    (hunit : ∃ w ∈ W, S.repr w = 1) :
    letI := M.normedGroup; letI := M.normedScalar;
    ∃ U : KotheScalarSpace ρ M.carrier,
      ∀ x, U.repr x = S.repr (M.inclusion x)

/-- Norm density of simple functions in an order-continuous Köthe space. -/
axiom citeKotheSimpleDensity {ρ : Measure Ω} (S : KotheScalarSpace ρ Z)
    (χ : MeasSet Ω → Z)
    (hχ : ∀ A, (S.repr (χ A) : Ω → ℝ) =ᵐ[ρ] A.1.indicator (fun _ => 1)) :
    Dense (Submodule.span ℝ (Set.range χ) : Set Z)

def KotheKB {ρ : Measure Ω} (S : KotheScalarSpace ρ Z) : Prop :=
  ∀ x : ℕ → Z, (∀ n, ∀ᵐ t ∂ρ, 0 ≤ S.repr (x n) t) →
    (∀ i j, i ≤ j → ∀ᵐ t ∂ρ, S.repr (x i) t ≤ S.repr (x j) t) →
    (∃ C : ℝ, ∀ n, ‖x n‖ ≤ C) → ∃ y, Tendsto x atTop (𝓝 y)

/-- The standard KB characterization for order-continuous Banach lattices. -/
axiom citeKotheKB {ρ : Measure Ω} (S : KotheScalarSpace ρ Z) :
    WeaklySeqComplete Z ↔ KotheKB S

structure KotheDilationSpace (μ : OVM Ω X) extends DilationSpace μ where
  ρ : Measure Ω
  scalar : letI := normedGroup; letI := normedScalar; KotheScalarSpace ρ carrier
  cut_repr : letI := normedGroup; letI := normedScalar; ∀ A z,
    (scalar.repr (dilation.P.val A z) : Ω → ℝ) =ᵐ[ρ] A.1.indicator (scalar.repr z)

omit [CompleteSpace Z] in
private theorem weaklySeqComplete_equiv {Y : Type*} [NormedAddCommGroup Y] [NormedSpace ℝ Y]
    (e : Z ≃L[ℝ] Y) (hZ : WeaklySeqComplete Z) : WeaklySeqComplete Y := by
  intro x hx
  obtain ⟨z, hz⟩ := hZ (fun n => e.symm (x n)) (fun f => hx (f.comp e.symm.toContinuousLinearMap))
  refine ⟨e z, fun f => ?_⟩
  have ht := hz (f.comp e.toContinuousLinearMap)
  change Tendsto (fun n => f (e (e.symm (x n)))) atTop (𝓝 (f (e z))) at ht
  simpa only [e.apply_symm_apply] using ht

private theorem OVM.exists_kotheCyclicBase (μ : OVM Ω X) (hμ : μ.Normalized)
    (hc : μ.alphaPVM.Cyclic) :
    ∃ B : KotheDilationSpace μ,
      letI := B.normedGroup; letI := B.normedScalar; letI := B.complete;
      ∃ u : B.carrier,
        B.dilation.P.CyclicVector u ∧ B.scalar.repr u = 1 ∧
        (∀ A, ‖B.dilation.P.val A‖ ≤ 1) ∧
        (∀ (a : boundedMeasurableAlgebra Ω) z,
          (B.scalar.repr (B.dilation.P.boundedMeasurableRepresentation a z) : Ω → ℝ) =ᵐ[B.ρ]
            fun t => a.1 t * B.scalar.repr z t) ∧
        (¬ ContainsCopy CZero X → WeaklySeqComplete B.carrier) := by
  obtain ⟨u, hu⟩ := hc
  obtain ⟨M⟩ := μ.alphaPVM.exists_cyclicKotheCoordinates u hu
  let : NormedAddCommGroup M.carrier := M.normedGroup
  let : NormedSpace ℝ M.carrier := M.normedScalar
  let : CompleteSpace M.carrier := M.complete
  let D := μ.alphaDilation hμ
  let e := M.e
  have hE (A : MeasSet Ω) (x : μ.alphaSubmodule) :
      M.P₀.val A (e x) = e (D.P.val A x) := (DFunLike.congr_fun (M.intertwines A) x).symm
  let D₀ : Dilation μ M.carrier :=
    { P := M.P₀
      S := D.S.comp e.symm.toContinuousLinearMap
      T := e.toContinuousLinearMap.comp D.T
      split := by
        ext x
        change D.S (e.symm (e (D.T x))) = x
        rw [e.symm_apply_apply]
        exact DFunLike.congr_fun D.split x
      compress := fun A => by
        ext x
        change D.S (e.symm (M.P₀.val A (e (D.T x)))) = μ.val A x
        rw [hE, e.symm_apply_apply]
        exact DFunLike.congr_fun (D.compress A) x }
  refine ⟨⟨⟨M.carrier, M.normedGroup, M.normedScalar, M.complete, D₀⟩, M.ρ, M.S, M.cut_repr⟩,
    e u, μ.alphaPVM.cyclicVector_of_dense_intertwining M.P₀ e.toContinuousLinearMap
      M.intertwines e.surjective.denseRange hu, M.one_repr, M.cut_bound, M.multiplier_repr, ?_⟩
  intro hx
  exact weaklySeqComplete_equiv e (μ.alphaPVM.weaklySeqComplete_of_boundedlyComplete
    (μ.alphaPVM.localizes_of_cyclic ⟨u, hu⟩) (μ.alpha_boundedlyComplete_of_not_contains_cZero hx))

private theorem OVM.exists_kotheCyclicDFJP (μ : OVM Ω X) (hμ : μ.Normalized)
    (hc : μ.alphaPVM.Cyclic) (hX : ¬ ContainsCopy LOne X) :
    ∃ B : KotheDilationSpace μ, letI := B.normedGroup; letI := B.normedScalar;
      B.dilation.P.Cyclic ∧ (¬ ContainsCopy LOne B.carrier) ∧
        (IsReflexive X → IsReflexive B.carrier) := by
  obtain ⟨B, u, hu, hu1, hQ, hmul, hWSC⟩ := μ.exists_kotheCyclicBase hμ hc
  let : NormedAddCommGroup B.carrier := B.normedGroup
  let : NormedSpace ℝ B.carrier := B.normedScalar
  let : CompleteSpace B.carrier := B.complete
  let P := B.dilation.P
  let K := B.dilation.T '' Metric.closedBall (0 : X) 1 ∪ {u}
  let W := P.multiplierHull K
  have huW : u ∈ W := P.subset_multiplierHull K (Or.inr rfl)
  have h₀ : 0 ∈ W := P.subset_multiplierHull K
    (Or.inl ⟨0, mem_closedBall_zero_iff.mpr (by simp), map_zero B.dilation.T⟩)
  have hK : WeaklyPrecompactSet K := weaklyPrecompact_image_unitBall_union_singleton B.dilation.T u hX
  have hW := P.multiplierHull_weaklyPrecompact ⟨u, hu⟩ K hK
  obtain ⟨M⟩ := citeDFJPInterpolation W h₀ (convex_convexHull ℝ _).closure
    (P.multiplierHull_balanced K) isClosed_closure hW.1
  let : NormedAddCommGroup M.carrier := M.normedGroup
  let : NormedSpace ℝ M.carrier := M.normedScalar
  have hsolid (y : B.carrier) (hy : y ∈ W) (x : B.carrier)
      (hd : ∀ᵐ t ∂B.ρ, |B.scalar.repr x t| ≤ |B.scalar.repr y t|) : x ∈ W := by
    obtain ⟨a, ha, he⟩ := exists_boundedMultiplier_of_ae_domination B.ρ
      (B.scalar.repr x) (B.scalar.repr y) (B.scalar.repr x).stronglyMeasurable.measurable
      (B.scalar.repr y).stronglyMeasurable.measurable hd
    have heq := B.scalar.injective (AEEqFun.ext ((hmul a y).trans he.symm))
    exact heq ▸ P.maps_multiplierHull K a ha hy
  obtain ⟨S, hS⟩ := citeLatticeDFJPKothe B.scalar M hsolid ⟨u, huW, hu1⟩
  let Q := M.liftPVM P hQ (P.cut_maps_multiplierHull K)
  have hJ := M.inclusion_liftPVM P hQ (P.cut_maps_multiplierHull K)
  have hcut (A : MeasSet Ω) (x : M.carrier) :
      (S.repr (Q.val A x) : Ω → ℝ) =ᵐ[B.ρ] A.1.indicator (S.repr x) := by
    rw [hS, hS, show M.inclusion (Q.val A x) = P.val A (M.inclusion x) from DFunLike.congr_fun (hJ A) x]
    exact B.cut_repr A (M.inclusion x)
  obtain ⟨v, hv, _⟩ := M.unit_contains u huW
  have hv1 : S.repr v = 1 := by rw [hS, hv, hu1]
  have hcv : Q.CyclicVector v := citeKotheSimpleDensity S (fun A => Q.val A v) (fun A => by
    have hc' := hcut A v
    rw [hv1] at hc'
    exact hc'.trans (by
      filter_upwards [show ((1 : Ω →ₘ[B.ρ] ℝ) : Ω → ℝ) =ᵐ[B.ρ] 1 from AEEqFun.coeFn_one] with t ht
      by_cases he : t ∈ A.1 <;> simp [he, ht]))
  obtain ⟨D, hD, _, _, _⟩ := B.dilation.exists_lifted_analysis Q M.inclusion M.injective hJ
    (fun x hx => M.unit_contains _ (P.subset_multiplierHull K (Or.inl ⟨_, mem_closedBall_zero_iff.mpr hx, rfl⟩)))
  have hcutD : ∀ A x, (S.repr (D.P.val A x) : Ω → ℝ) =ᵐ[B.ρ] A.1.indicator (S.repr x) :=
    hD ▸ hcut
  refine ⟨⟨⟨M.carrier, M.normedGroup, M.normedScalar, M.complete, D⟩, B.ρ, S, hcutD⟩,
    hD ▸ ⟨v, hcv⟩, M.no_lOne hW, fun hr => ?_⟩
  exact M.reflexive (P.multiplierHull_weaklyCompact ⟨u, hu⟩ K hK
    (P.boundedlyComplete_of_weaklySeqComplete (hWSC hr.excludes_lOne_and_cZero.2)))

/-- The three equivalences of the manuscript, thm:dilation-geometry. -/
theorem Dilation.cyclicGeometry {μ : OVM Ω X} (D : Dilation μ Z) (hc : D.P.Cyclic) :
    ((¬ ContainsCopy LOne X) ↔ ∃ B : KotheDilationSpace μ,
      letI := B.normedGroup; letI := B.normedScalar;
      B.dilation.P.Cyclic ∧ (¬ ContainsCopy LOne B.carrier) ∧ B.dilation.P.toOVM.Shrinking) ∧
    ((¬ ContainsCopy CZero X) ↔ ∃ B : KotheDilationSpace μ,
      letI := B.normedGroup; letI := B.normedScalar;
      B.dilation.P.Cyclic ∧ KotheKB B.scalar ∧ B.dilation.P.BoundedlyComplete) ∧
    (IsReflexive X ↔ ∃ B : KotheDilationSpace μ,
      letI := B.normedGroup; letI := B.normedScalar; B.dilation.P.Cyclic ∧ IsReflexive B.carrier) := by
  let hμ := D.normalized_ovm
  have ha : μ.alphaPVM.Cyclic := D.cyclic_alphaPVM hc
  refine ⟨⟨?_, ?_⟩, ⟨?_, ?_⟩, ⟨?_, ?_⟩⟩
  · intro hx
    obtain ⟨B, hcB, hn, _⟩ := μ.exists_kotheCyclicDFJP hμ ha hx
    let : NormedAddCommGroup B.carrier := B.normedGroup
    let : NormedSpace ℝ B.carrier := B.normedScalar
    let : CompleteSpace B.carrier := B.complete
    exact ⟨B, hcB, hn, B.dilation.P.toOVM.shrinking_of_not_contains_lOne hn⟩
  · rintro ⟨B, _, hn, _⟩ hX
    let : NormedAddCommGroup B.carrier := B.normedGroup
    let : NormedSpace ℝ B.carrier := B.normedScalar
    exact hn (B.dilation.containsCopy_of_underlying hX)
  · intro hx
    obtain ⟨B, u, hu, _, _, _, hW⟩ := μ.exists_kotheCyclicBase hμ ha
    let : NormedAddCommGroup B.carrier := B.normedGroup
    let : NormedSpace ℝ B.carrier := B.normedScalar
    let : CompleteSpace B.carrier := B.complete
    exact ⟨B, ⟨u, hu⟩, (citeKotheKB B.scalar).mp (hW hx),
      B.dilation.P.boundedlyComplete_of_weaklySeqComplete (hW hx)⟩
  · rintro ⟨B, hcB, _, hb⟩
    let : NormedAddCommGroup B.carrier := B.normedGroup
    let : NormedSpace ℝ B.carrier := B.normedScalar
    let : CompleteSpace B.carrier := B.complete
    exact B.dilation.not_contains_cZero_of_boundedlyComplete_cyclic hcB hb
  · intro hr
    obtain ⟨B, hcB, _, hR⟩ := μ.exists_kotheCyclicDFJP hμ ha hr.excludes_lOne_and_cZero.1
    exact ⟨B, hcB, hR hr⟩
  · rintro ⟨B, _, hR⟩
    let : NormedAddCommGroup B.carrier := B.normedGroup
    let : NormedSpace ℝ B.carrier := B.normedScalar
    exact B.dilation.reflexive_of_reflexive_space hR

#print axioms Dilation.cyclicGeometry

end CyclicDilationGeometry

noncomputable section ScalarMinimal

open MeasureTheory
open scoped ENNReal
variable {Ω : Type*} [MeasurableSpace Ω] {ρ : Measure Ω}

/-- The exact norm of the signed integral considered with the supremum
over measurable sets. The positive and negative sets attain the two bounds. -/
theorem sSup_abs_setIntegral_eq (f : Ω → ℝ) (hm : Measurable f) (hf : Integrable f ρ) :
    sSup (Set.range fun A : MeasSet Ω => |∫ t in A.1, f t ∂ρ|) =
      ((∫ t, |f t| ∂ρ) + |∫ t, f t ∂ρ|) / 2 := by
  let A : MeasSet Ω := ⟨{t | 0 ≤ f t}, measurableSet_le measurable_const hm⟩
  let B : MeasSet Ω := ⟨A.1ᶜ, A.2.compl⟩
  let p := ∫ t, A.1.indicator f t ∂ρ
  let n := ∫ t, B.1.indicator f t ∂ρ
  have hp : 0 ≤ p := integral_nonneg fun t => by
    by_cases ht : t ∈ A.1
    · rw [indicator_of_mem ht]
      exact ht
    · rw [indicator_of_notMem ht]
      exact le_rfl
  have hn : n ≤ 0 := integral_nonpos fun t => by
    by_cases ht : t ∈ B.1
    · rw [indicator_of_mem ht]
      exact (lt_of_not_ge ht).le
    · rw [indicator_of_notMem ht]
      exact le_rfl
  have habs : (∫ t, |f t| ∂ρ) = p - n := by
    rw [← integral_sub (hf.indicator A.2) (hf.indicator B.2)]
    apply integral_congr_ae
    exact Eventually.of_forall fun t => by
      by_cases ht : t ∈ A.1
      · simp [B, ht, abs_of_nonneg (show 0 ≤ f t from ht)]
      · simp [B, ht, abs_of_nonpos (le_of_not_ge (show ¬ 0 ≤ f t from ht))]
  have hint : (∫ t, f t ∂ρ) = p + n := by
    rw [← integral_add (hf.indicator A.2) (hf.indicator B.2)]
    apply integral_congr_ae
    exact Eventually.of_forall fun t => by
      by_cases ht : t ∈ A.1 <;> simp [B, ht]
  have hbound (E : MeasSet Ω) : |∫ t in E.1, f t ∂ρ| ≤ max p (-n) := by
    rw [← integral_indicator E.2]
    have hl : n ≤ ∫ t, E.1.indicator f t ∂ρ := by
      apply integral_mono (hf.indicator B.2) (hf.indicator E.2)
      intro t
      by_cases ht : t ∈ A.1
      · have hft : 0 ≤ f t := ht
        by_cases he : t ∈ E.1 <;> simp [B, ht, he, hft]
      · have hft : f t ≤ 0 := le_of_not_ge (show ¬ 0 ≤ f t from ht)
        by_cases he : t ∈ E.1 <;> simp [B, ht, he, hft]
    have hu : (∫ t, E.1.indicator f t ∂ρ) ≤ p := by
      apply integral_mono (hf.indicator E.2) (hf.indicator A.2)
      intro t
      by_cases ht : t ∈ A.1
      · have hft : 0 ≤ f t := ht
        by_cases he : t ∈ E.1 <;> simp [ht, he, hft]
      · have hft : f t ≤ 0 := le_of_not_ge (show ¬ 0 ≤ f t from ht)
        by_cases he : t ∈ E.1 <;> simp [ht, he, hft]
    exact abs_le.mpr ⟨by linarith [le_max_right p (-n)], hu.trans (le_max_left _ _)⟩
  have hB : BddAbove (Set.range fun E : MeasSet Ω => |∫ t in E.1, f t ∂ρ|) :=
    ⟨max p (-n), by rintro r ⟨E, hE⟩; exact hE ▸ hbound E⟩
  have hs : sSup (Set.range fun E : MeasSet Ω => |∫ t in E.1, f t ∂ρ|) = max p (-n) := by
    apply le_antisymm (csSup_le (Set.range_nonempty _) (by rintro r ⟨E, hE⟩; exact hE ▸ hbound E))
    apply max_le
    · have h := le_csSup hB (Set.mem_range_self A)
      rw [← integral_indicator A.2, abs_of_nonneg hp] at h
      exact h
    · have h := le_csSup hB (Set.mem_range_self B)
      rw [← integral_indicator B.2, abs_of_nonpos hn] at h
      exact h
  rw [hs, habs, hint]
  by_cases he : 0 ≤ p + n
  · rw [abs_of_nonneg he, max_eq_left (by linarith)]
    ring
  · rw [abs_of_nonpos (le_of_not_ge he), max_eq_right (by linarith)]
    ring

variable [IsProbabilityMeasure ρ]

/-- Hölder's bound for the integral against the constant one on a
probability space, stated on the actual Lp space. -/
axiom citeProbabilityLpIntegralBound (p : ℝ≥0∞) [Fact (1 ≤ p)] (a : Lp ℝ p ρ) :
    |∫ t, a t ∂ρ| ≤ ‖a‖

private theorem integrable_probabilityLp {p : ℝ≥0∞} [Fact (1 ≤ p)] (a : Lp ℝ p ρ) :
    Integrable a ρ := memLp_one_iff_integrable.mp ((Lp.memLp a).mono_exponent (Fact.out : 1 ≤ p))

private def probabilityScalarIntegral (p : ℝ≥0∞) [Fact (1 ≤ p)] : Lp ℝ p ρ →L[ℝ] ℝ := by
  let L : Lp ℝ p ρ →ₗ[ℝ] ℝ :=
    { toFun := fun a => ∫ t, a t ∂ρ
      map_add' := fun a b => by
        rw [← integral_add (integrable_probabilityLp a) (integrable_probabilityLp b)]
        exact integral_congr_ae (Lp.coeFn_add a b)
      map_smul' := fun c a => by
        change (∫ t, (c • a) t ∂ρ) = c * ∫ t, a t ∂ρ
        rw [← integral_const_mul]
        exact integral_congr_ae (Lp.coeFn_smul c a) }
  exact L.mkContinuous 1 (fun a => by
    change |∫ t, a t ∂ρ| ≤ 1 * ‖a‖
    rw [one_mul]
    exact citeProbabilityLpIntegralBound p a)

private def probabilityScalarOne (p : ℝ≥0∞) : Lp ℝ p ρ :=
  indicatorConstLp p MeasurableSet.univ (measure_ne_top ρ univ) 1

private theorem probabilityScalarOne_ae (p : ℝ≥0∞) :
    (fun t => (probabilityScalarOne (ρ := ρ) p) t) =ᵐ[ρ] (fun _ => (1 : ℝ)) := by
  have h : (fun t => (probabilityScalarOne (ρ := ρ) p) t) =ᵐ[ρ]
      univ.indicator (fun _ => (1 : ℝ)) := indicatorConstLp_coeFn
  simpa only [indicator_univ] using h

private def probabilityScalarConstant (p : ℝ≥0∞) [Fact (1 ≤ p)] : ℝ →L[ℝ] Lp ℝ p ρ :=
  (ContinuousLinearMap.id ℝ ℝ).smulRight (probabilityScalarOne p)

private theorem probabilityScalarIntegral_cut (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≠ ∞)
    (A : MeasSet Ω) (a : Lp ℝ p ρ) :
    probabilityScalarIntegral p ((FiniteSignedMeasure.probabilityLpPVM hp).val A a) =
      ∫ t in A.1, a t ∂ρ := by
  change (∫ t, (FiniteSignedMeasure.lpCut A a) t ∂ρ) = _
  rw [← integral_indicator A.2]
  exact integral_congr_ae (FiniteSignedMeasure.lpCut_ae A a)

private theorem probabilityScalarIntegral_cut_constant (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≠ ∞)
    (A : MeasSet Ω) (c : ℝ) :
    probabilityScalarIntegral (ρ := ρ) p ((FiniteSignedMeasure.probabilityLpPVM hp).val A
      (probabilityScalarConstant p c)) = (ρ A.1).toReal * c := by
  rw [probabilityScalarIntegral_cut]
  have he : (fun t => (probabilityScalarConstant (ρ := ρ) p c) t) =ᵐ[ρ] fun _ => c := by
    have hc := Lp.coeFn_smul c (probabilityScalarOne (ρ := ρ) p)
    filter_upwards [hc, probabilityScalarOne_ae (ρ := ρ) p] with t ht hs
    change (c • probabilityScalarOne p) t = c
    rw [ht]
    change c * probabilityScalarOne p t = c
    rw [hs, mul_one]
  rw [integral_congr_ae (ae_restrict_of_ae he), setIntegral_const]
  rfl

local instance : Fact (1 ≤ (2 : ℝ≥0∞)) := ⟨by norm_num⟩

/-- The scalar probability-measure OVM, realized by compression of L². -/
def scalarProbabilityOVM (ρ : Measure Ω) [IsProbabilityMeasure ρ] : OVM Ω ℝ :=
  (FiniteSignedMeasure.probabilityLpPVM (ρ := ρ) (p := 2) (by norm_num)).compressed
    (probabilityScalarIntegral 2) (probabilityScalarConstant 2)

theorem scalarProbabilityOVM_apply (A : MeasSet Ω) (c : ℝ) :
    (scalarProbabilityOVM ρ).val A c = (ρ A.1).toReal * c :=
  probabilityScalarIntegral_cut_constant 2 (by norm_num) A c

theorem scalarProbabilityOVM_normalized : (scalarProbabilityOVM ρ).Normalized := by
  apply ContinuousLinearMap.ext
  intro c
  rw [scalarProbabilityOVM_apply]
  simp [MeasSet.whole]

def scalarProbabilityLpDilation (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≠ ∞) :
    Dilation (scalarProbabilityOVM ρ) (Lp ℝ p ρ) where
  P := FiniteSignedMeasure.probabilityLpPVM hp
  S := probabilityScalarIntegral p
  T := probabilityScalarConstant p
  split := by
    apply ContinuousLinearMap.ext
    intro c
    have h := probabilityScalarIntegral_cut_constant (ρ := ρ) p hp MeasSet.whole c
    rw [show (FiniteSignedMeasure.probabilityLpPVM (ρ := ρ) hp).val MeasSet.whole =
      ContinuousLinearMap.id ℝ (Lp ℝ p ρ) from (FiniteSignedMeasure.probabilityLpPVM hp).normalized] at h
    simpa [MeasSet.whole] using h
  compress := fun A => by
    apply ContinuousLinearMap.ext
    intro c
    exact (probabilityScalarIntegral_cut_constant p hp A c).trans (scalarProbabilityOVM_apply A c).symm

#print axioms sSup_abs_setIntegral_eq
#print axioms scalarProbabilityLpDilation

private theorem probabilityScalarOne_cyclic (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≠ ∞) :
    (FiniteSignedMeasure.probabilityLpPVM (ρ := ρ) hp).CyclicVector (probabilityScalarOne p) := by
  let u := probabilityScalarOne (ρ := ρ) p
  let P := FiniteSignedMeasure.probabilityLpPVM (ρ := ρ) hp
  let W := Submodule.span ℝ (Set.range fun E : MeasSet Ω => P.val E u)
  have hconst (c : ℝ) (E : MeasSet Ω) :
      indicatorConstLp p E.2 (measure_ne_top ρ E.1) c = c • P.val E u := by
    change indicatorConstLp p E.2 (measure_ne_top ρ E.1) c = c • FiniteSignedMeasure.lpCut E u
    apply Lp.ext
    filter_upwards [indicatorConstLp_coeFn (p := p) (hs := E.2)
        (hμs := measure_ne_top ρ E.1) (c := c),
      Lp.coeFn_smul c (FiniteSignedMeasure.lpCut E u), FiniteSignedMeasure.lpCut_ae E u,
      probabilityScalarOne_ae (ρ := ρ) p] with t ht ha hb h1
    rw [ht, ha]
    change E.1.indicator (fun _ => c) t = c • FiniteSignedMeasure.lpCut E u t
    rw [hb]
    by_cases hx : t ∈ E.1 <;> simp [Set.indicator, hx, u, h1]
  have hsimple (f : Lp.simpleFunc ℝ p ρ) : (f : Lp ℝ p ρ) ∈ W := by
    have hp₀ : p ≠ 0 := ne_of_gt (zero_lt_one.trans_le (Fact.out : 1 ≤ p))
    apply Lp.simpleFunc.induction hp₀ hp (P := fun f => (f : Lp ℝ p ρ) ∈ W) _ _ f
    · intro c E hE hEfin
      let A : MeasSet Ω := ⟨E, hE⟩
      change indicatorConstLp p A.2 (measure_ne_top ρ A.1) c ∈ W
      rw [hconst c A]
      exact W.smul_mem c (Submodule.subset_span ⟨A, rfl⟩)
    · intro f g hf hg _ hfW hgW
      exact W.add_mem hfW hgW
  exact (Lp.simpleFunc.dense hp).mono (fun f hf => hsimple ⟨f, hf⟩)

private theorem norm_probabilityL1 (f : Lp ℝ (1 : ℝ≥0∞) ρ) : ‖f‖ = ∫ t, |f t| ∂ρ := by
  have hf := integrable_probabilityLp f
  rw [Lp.norm_def, eLpNorm_one_eq_lintegral_eNorm hf.aestronglyMeasurable,
    ← ofReal_integral_norm_eq_lintegral_eNorm hf, ENNReal.toReal_ofReal (integral_nonneg fun _ => norm_nonneg _)]
  rfl

/-- The actual minimal alpha space for the scalar measure is L¹ with
the exact signed-integral norm and both norm comparison constants. -/
theorem scalarProbability_alphaEquiv :
    ∃ e : Lp ℝ (1 : ℝ≥0∞) ρ ≃L[ℝ] (scalarProbabilityOVM ρ).alphaSubmodule,
      (∀ (a : Lp ℝ (1 : ℝ≥0∞) ρ) (E : MeasSet Ω), (e a).1 E = ∫ t in E.1, a t ∂ρ) ∧
      ∀ a : Lp ℝ (1 : ℝ≥0∞) ρ, ‖e a‖ = (‖a‖ + |∫ t, a t ∂ρ|) / 2 := by
  let μ := scalarProbabilityOVM ρ
  let D := scalarProbabilityLpDilation (ρ := ρ) 1 (by norm_num)
  let Y := D.generatedSubmodule
  let : IsClosed (Y : Set (Lp ℝ (1 : ℝ≥0∞) ρ)) := Submodule.isClosed_topologicalClosure _
  have hgen (a : Lp ℝ (1 : ℝ≥0∞) ρ) : a ∈ Y := by
    apply closure_minimal
      (s := (Submodule.span ℝ (Set.range fun E : MeasSet Ω =>
        D.P.val E (probabilityScalarOne (ρ := ρ) 1)) : Set (Lp ℝ (1 : ℝ≥0∞) ρ))) _ inferInstance
      ((probabilityScalarOne_cyclic (ρ := ρ) 1 (by norm_num : (1 : ℝ≥0∞) ≠ ∞)) a)
    change (Submodule.span ℝ _) ≤ Y
    apply Submodule.span_le.mpr
    rintro _ ⟨E, rfl⟩
    have h := D.generated_mem E (1 : ℝ)
    change (D.P.val E) ((1 : ℝ) • probabilityScalarOne 1) ∈ Y at h
    simpa [one_smul] using h
  let I : Lp ℝ (1 : ℝ≥0∞) ρ →L[ℝ] Y :=
    LinearMap.mkContinuous
      { toFun := fun a => ⟨a, hgen a⟩
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl } 1 (fun a => by change ‖a‖ ≤ 1 * ‖a‖; rw [one_mul])
  let q := D.alphaComparison.comp I
  have hev (a : Lp ℝ (1 : ℝ≥0∞) ρ) (E : MeasSet Ω) : (q a).1 E = ∫ t in E.1, a t ∂ρ :=
    probabilityScalarIntegral_cut 1 (by norm_num) E a
  have hnorm (a : Lp ℝ (1 : ℝ≥0∞) ρ) : ‖q a‖ = (‖a‖ + |∫ t, a t ∂ρ|) / 2 := by
    rw [μ.alpha_norm_eq_sSup_eval]
    have he (E : MeasSet Ω) : μ.alphaSynthesis (μ.alphaRestriction E (q a)) = ∫ t in E.1, a t ∂ρ := by
      change (q a).1 (E.inter MeasSet.whole) = _
      rw [show E.inter MeasSet.whole = E from Subtype.ext (inter_univ _)]
      exact hev a E
    simp_rw [he, Real.norm_eq_abs]
    rw [sSup_abs_setIntegral_eq _ (Lp.stronglyMeasurable a).measurable (integrable_probabilityLp a),
      ← norm_probabilityL1]
  have hlow (a : Lp ℝ (1 : ℝ≥0∞) ρ) : ‖a‖ ≤ 2 * ‖q a‖ := by
    rw [hnorm]
    linarith [abs_nonneg (∫ t, a t ∂ρ)]
  have ha : AntilipschitzWith 2 q := AntilipschitzWith.of_le_mul_dist fun a b => by
    rw [dist_eq_norm, dist_eq_norm, ← map_sub]
    exact hlow _
  have hd : DenseRange q := D.alphaComparison_denseRange.comp (show DenseRange I from
    (show Function.Surjective I from fun y => ⟨y.1, Subtype.ext rfl⟩).denseRange) D.alphaComparison.continuous
  have hclosed := ha.isClosed_range q.lipschitzWith.uniformContinuous
  have hs : Function.Surjective q := Set.range_eq_univ.mp (hclosed.closure_eq.symm.trans hd.closure_eq)
  let e := LinearEquiv.ofBijective q.toLinearMap ⟨ha.injective, hs⟩
  have hInv : Continuous e.symm := by
    refine (e.symm.toLinearMap.mkContinuous 2 ?_).continuous
    intro y
    have hh := hlow (e.symm y)
    change ‖e.symm y‖ ≤ 2 * ‖e (e.symm y)‖ at hh
    rwa [e.apply_symm_apply] at hh
  exact ⟨⟨e, q.continuous, hInv⟩, hev, hnorm⟩

theorem isReflexive_real : IsReflexive ℝ := by
  intro η
  let L := ContinuousLinearMap.id ℝ ℝ
  refine ⟨η L, ?_⟩
  ext f
  have he : f = f 1 • L := by
    apply ContinuousLinearMap.ext
    intro a
    change f a = f 1 * a
    rw [show a = a • (1 : ℝ) by simp, map_smul]
    change a * f 1 = f 1 * (a * 1)
    rw [mul_one, mul_comm]
  rw [J_apply, he, map_smul]
  rfl

theorem scalarProbabilityOVM_shrinking : (scalarProbabilityOVM ρ).Shrinking := by
  apply (OVM.shrinking_iff_all_normal _).mpr
  intro ξ
  obtain ⟨x, rfl⟩ := isReflexive_real ξ
  exact (scalarProbabilityOVM ρ).normal_J x

#print axioms scalarProbability_alphaEquiv
#print axioms scalarProbabilityOVM_shrinking

end ScalarMinimal


noncomputable section ScalarInterval

open MeasureTheory
open scoped ENNReal

def lebesgueUnitInterval : Measure ℝ := volume.restrict (Icc 0 1)

instance lebesgueUnitInterval_probability : IsProbabilityMeasure lebesgueUnitInterval where
  measure_univ := by
    rw [lebesgueUnitInterval, Measure.restrict_apply MeasurableSet.univ, univ_inter, Real.volume_Icc]
    norm_num

/-- Standard disjoint-indicator embedding of ℓ¹ in L¹ on an atomless
probability space. -/
axiom citeAtomlessProbabilityL1ContainsLone (ρ : Measure ℝ) [IsProbabilityMeasure ρ]
    (hρ : ∀ x : ℝ, ρ {x} = 0) :
    ContainsCopy LOne (Lp ℝ (1 : ℝ≥0∞) ρ)

private theorem lebesgueUnitInterval_singleton (x : ℝ) : lebesgueUnitInterval {x} = 0 := by
  rw [lebesgueUnitInterval, Measure.restrict_apply (measurableSet_singleton x)]
  exact measure_mono_null inter_subset_left (measure_singleton x)
private theorem ContainsCopy.transport {M N F : Type*}
    [NormedAddCommGroup M] [NormedSpace ℝ M]
    [NormedAddCommGroup N] [NormedSpace ℝ N]
    [NormedAddCommGroup F] [NormedSpace ℝ F]
    (h : ContainsCopy F M) (e : M ≃L[ℝ] N) : ContainsCopy F N := by
  obtain ⟨A, c, hc, hA⟩ := h
  let b := max 1 ‖e.symm.toContinuousLinearMap‖
  have hb : 0 < b := lt_of_lt_of_le zero_lt_one (le_max_left _ _)
  refine ⟨e.toContinuousLinearMap.comp A, c / b, div_pos hc hb, fun x => ?_⟩
  rw [div_mul_eq_mul_div, div_le_iff₀ hb]
  have he := e.symm.toContinuousLinearMap.le_opNorm (e (A x))
  change ‖e.symm (e (A x))‖ ≤ _ at he
  rw [e.symm_apply_apply] at he
  rw [mul_comm ‖(e.toContinuousLinearMap.comp A) x‖ b]
  exact (hA x).trans (he.trans (mul_le_mul_of_nonneg_right (le_max_right _ _) (norm_nonneg _)))

/-- The scalar Lebesgue measure on the interval has a reflexive cyclic
L² dilation while its minimal alpha space contains a copy of ℓ¹. -/
theorem scalarLebesgue_minimal_geometry :
    let μ := scalarProbabilityOVM lebesgueUnitInterval
    μ.Shrinking ∧ ContainsCopy LOne μ.alphaSubmodule ∧
    ¬ IsReflexive μ.alphaSubmodule ∧ ¬ μ.alphaPVM.toOVM.Shrinking ∧
    ∃ D : Dilation μ (Lp ℝ (2 : ℝ≥0∞) lebesgueUnitInterval),
      D.P.Cyclic ∧ IsReflexive (Lp ℝ (2 : ℝ≥0∞) lebesgueUnitInterval) := by
  dsimp only
  let μ := scalarProbabilityOVM lebesgueUnitInterval
  let D := scalarProbabilityLpDilation (ρ := lebesgueUnitInterval) 2 (by norm_num)
  have hcyc : D.P.Cyclic :=
    ⟨_, probabilityScalarOne_cyclic (ρ := lebesgueUnitInterval) 2 (by norm_num)⟩
  obtain ⟨e, _, _⟩ := scalarProbability_alphaEquiv (ρ := lebesgueUnitInterval)
  have hcopy : ContainsCopy LOne μ.alphaSubmodule :=
    (citeAtomlessProbabilityL1ContainsLone lebesgueUnitInterval lebesgueUnitInterval_singleton).transport e
  exact ⟨scalarProbabilityOVM_shrinking, hcopy,
    fun h => h.excludes_lOne_and_cZero.1 hcopy,
    fun h => μ.alphaPVM.not_contains_lOne_of_shrinking
      (μ.alphaPVM.localizes_of_cyclic (D.cyclic_alphaPVM hcyc)) h hcopy,
    D, hcyc, citeProbabilityLpReflexive 2 (by norm_num) (by norm_num)⟩

#print axioms scalarLebesgue_minimal_geometry



/-- A mean-zero two-valued function on the two halves of the interval
attains the lower constant in the scalar alpha norm. -/
theorem scalarLebesgue_alpha_sharp :
    let μ := scalarProbabilityOVM lebesgueUnitInterval
    ∃ (e : Lp ℝ (1 : ℝ≥0∞) lebesgueUnitInterval ≃L[ℝ] μ.alphaSubmodule)
      (a : Lp ℝ (1 : ℝ≥0∞) lebesgueUnitInterval),
      (∀ (f : Lp ℝ (1 : ℝ≥0∞) lebesgueUnitInterval) (A : MeasSet ℝ),
        (e f).1 A = ∫ t in A.1, f t ∂lebesgueUnitInterval) ∧
      a ≠ 0 ∧
      (∫ t, a t ∂lebesgueUnitInterval) = 0 ∧ ‖e a‖ = ‖a‖ / 2 := by
  dsimp only
  obtain ⟨e, he, hn⟩ := scalarProbability_alphaEquiv (ρ := lebesgueUnitInterval)
  let A : MeasSet ℝ := ⟨Icc 0 (1 / 2), measurableSet_Icc⟩
  let P := FiniteSignedMeasure.probabilityLpPVM
    (ρ := lebesgueUnitInterval) (p := 1) (by norm_num)
  let u := probabilityScalarOne (ρ := lebesgueUnitInterval) 1
  let J := probabilityScalarIntegral (ρ := lebesgueUnitInterval) 1
  let a := (2 : ℝ) • P.val A u - u
  have hρ : lebesgueUnitInterval A.1 = ENNReal.ofReal (1 / 2) := by
    have hsub : Icc (0 : ℝ) (1 / 2) ⊆ Icc 0 1 := Icc_subset_Icc le_rfl (by norm_num)
    change volume.restrict (Icc (0 : ℝ) 1) (Icc 0 (1 / 2)) = _
    rw [Measure.restrict_apply measurableSet_Icc, inter_eq_left.mpr hsub, Real.volume_Icc, sub_zero]
  have hc (E : MeasSet ℝ) : J (P.val E u) = (lebesgueUnitInterval E.1).toReal := by
    have hu : probabilityScalarConstant (ρ := lebesgueUnitInterval) 1 1 = u := by
      change (1 : ℝ) • u = u
      exact one_smul _ _
    simpa only [hu, mul_one] using
      probabilityScalarIntegral_cut_constant (ρ := lebesgueUnitInterval) 1 (by norm_num) E 1
  have hJA : J (P.val A u) = 1 / 2 := by
    rw [hc, hρ, ENNReal.toReal_ofReal (by norm_num)]
  have hJu : J u = 1 := by
    have h := hc MeasSet.whole
    rwa [P.normalized, ContinuousLinearMap.id_apply, MeasSet.whole, measure_univ, ENNReal.toReal_one] at h
  have hzero : J a = 0 := by
    simp only [a, map_sub, map_smul, smul_eq_mul, hJA, hJu]
    norm_num
  have hnon : a ≠ 0 := by
    intro ha
    have h := congrArg (fun x => J (P.val A x)) ha
    have hPP : P.val A (P.val A u) = P.val A u := by
      have hp := DFunLike.congr_fun (P.mul_eq A A) u
      have heq : A.inter A = A := Subtype.ext (inter_self _)
      rwa [heq] at hp
    simp only [a, map_sub, map_smul, smul_eq_mul, hPP, hJA, map_zero] at h
    norm_num at h
  exact ⟨e, a, he, hnon, hzero, by rw [hn, show (∫ t, a t ∂lebesgueUnitInterval) = 0 from hzero,
    abs_zero, add_zero]⟩

#print axioms scalarLebesgue_alpha_sharp

end ScalarInterval

noncomputable section LocalOrbitVariation

open scoped ENNReal

variable {Ω X : Type*} [MeasurableSpace Ω] [NormedAddCommGroup X] [NormedSpace ℝ X]

/-- Variation of the individual vector measure E ↦ μ(E)x. -/
def OVM.orbitVariation (μ : OVM Ω X) (x : X) (E : MeasSet Ω) : ℝ≥0∞ :=
  sSup {r | ∃ (D : ℕ → MeasSet Ω) (I : Finset ℕ),
    (↑I : Set ℕ).Pairwise (fun i j => Disjoint (D i).1 (D j).1) ∧
    MeasSet.finiteUnion D I = E ∧
    r = ENNReal.ofReal (∑ n ∈ I, ‖μ.val (D n) x‖)}

private theorem norm_sum_norming_duals (μ : OVM Ω X) (x : X)
    (D : ℕ → MeasSet Ω) (I : Finset ℕ) :
    ∃ f : ℕ → Dual X, (∀ n, ‖f n‖ ≤ 1) ∧
      (∑ n ∈ I, (f n).comp (μ.val (D n))) x = ∑ n ∈ I, ‖μ.val (D n) x‖ := by
  have hh (n : ℕ) : ∃ f : Dual X, ‖f‖ ≤ 1 ∧ f (μ.val (D n) x) = ‖μ.val (D n) x‖ := by
    by_cases hn : ‖μ.val (D n) x‖ = 0
    · exact ⟨0, by simp, by simp [hn]⟩
    · obtain ⟨f, hf, hv⟩ := exists_dual_vector ℝ (μ.val (D n) x) hn
      exact ⟨f, hf.le, hv⟩
  choose f hf hfx using hh
  exact ⟨f, hf, by simp only [sum_apply, ContinuousLinearMap.comp_apply, hfx]⟩

/-- Pointwise finiteness of the orbit variation yields a uniform
bound on all measurable finite partitions through Banach–Steinhaus. -/
theorem OVM.uniform_orbitVariation [CompleteSpace X] (μ : OVM Ω X) (E : MeasSet Ω)
    (hfin : ∀ x, μ.orbitVariation x E < ⊤) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x, μ.orbitVariation x E ≤ ENNReal.ofReal (C * ‖x‖) := by
  let Partitions := {p : (ℕ → MeasSet Ω) × Finset ℕ × (ℕ → Dual X) //
    (↑p.2.1 : Set ℕ).Pairwise (fun i j => Disjoint (p.1 i).1 (p.1 j).1) ∧
    MeasSet.finiteUnion p.1 p.2.1 = E ∧ ∀ n, ‖p.2.2 n‖ ≤ 1}
  let L (p : Partitions) : Dual X := ∑ n ∈ p.1.2.1, (p.1.2.2 n).comp (μ.val (p.1.1 n))
  have hbound (x : X) (p : Partitions) : ‖L p x‖ ≤ (μ.orbitVariation x E).toReal := by
    dsimp only [L]
    rw [sum_apply]
    calc
      _ ≤ ∑ n ∈ p.1.2.1, ‖p.1.2.2 n (μ.val (p.1.1 n) x)‖ := norm_sum_le _ _
      _ ≤ ∑ n ∈ p.1.2.1, ‖μ.val (p.1.1 n) x‖ := Finset.sum_le_sum fun n _ =>
        ((p.1.2.2 n).le_opNorm _).trans (by
          simpa only [one_mul] using mul_le_mul_of_nonneg_right (p.2.2.2 n) (norm_nonneg _))
      _ ≤ _ := by
        rw [← ENNReal.toReal_ofReal (Finset.sum_nonneg fun _ _ => norm_nonneg _)]
        exact ENNReal.toReal_mono (ne_of_lt (hfin x)) (le_sSup ⟨_, _, p.2.1, p.2.2.1, rfl⟩)
  obtain ⟨C, hC⟩ := banach_steinhaus (g := L) fun x =>
    ⟨(μ.orbitVariation x E).toReal, hbound x⟩
  refine ⟨max C 0, le_max_right _ _, fun x => ?_⟩
  apply sSup_le
  rintro _ ⟨D, I, hd, hE, rfl⟩
  obtain ⟨f, hf, heval⟩ := norm_sum_norming_duals μ x D I
  let p : Partitions := ⟨(D, I, f), hd, hE, hf⟩
  apply ENNReal.ofReal_le_ofReal
  rw [← heval]
  change L p x ≤ _
  exact (le_abs_self _).trans ((L p).le_opNorm x |>.trans
    (mul_le_mul_of_nonneg_right ((hC p).trans (le_max_left _ _)) (norm_nonneg _)))

#print axioms OVM.uniform_orbitVariation




/-- Operator-norm variation dominates every individual orbit variation. -/
theorem OVM.orbitVariation_le_operatorVariation (μ : OVM Ω X) (x : X) (E : MeasSet Ω) :
    μ.orbitVariation x E ≤ ENNReal.ofReal ‖x‖ * μ.operatorVariation E := by
  apply sSup_le
  rintro _ ⟨D, I, hd, hE, rfl⟩
  have hb := Finset.sum_le_sum fun n (_ : n ∈ I) => (μ.val (D n)).le_opNorm x
  have hr (J : Finset ℕ) : (∑ n ∈ J, ENNReal.ofReal ‖μ.val (D n)‖) =
      ENNReal.ofReal (∑ n ∈ J, ‖μ.val (D n)‖) := by
    classical
    induction J using Finset.induction_on with
    | empty => simp
    | insert n I hn ih =>
      rw [Finset.sum_insert hn, Finset.sum_insert hn, ih,
        ENNReal.ofReal_add (norm_nonneg _) (Finset.sum_nonneg fun i _ => norm_nonneg _)]
  apply (ENNReal.ofReal_le_ofReal hb).trans
  rw [← Finset.sum_mul, mul_comm, ENNReal.ofReal_mul (norm_nonneg _), ← hr I]
  have hle : (∑ n ∈ I, ENNReal.ofReal ‖μ.val (D n)‖) ≤ μ.operatorVariation E :=
    le_sSup ⟨D, I, hd, hE, rfl⟩
  gcongr

/-- The necessity of reflexivity of the underlying space, via the
complementation identity S T = I on the bidual. -/
theorem Dilation.reflexive_underlying_of_reflexive {Z : Type*}
    [NormedAddCommGroup Z] [NormedSpace ℝ Z] {μ : OVM Ω X}
    (D : Dilation μ Z) (hZ : IsReflexive Z) : IsReflexive X := by
  intro ξ
  obtain ⟨z, hz⟩ := hZ (secondAdjoint D.T ξ)
  refine ⟨D.S z, ?_⟩
  rw [← secondAdjoint_canonical, hz, secondAdjoint_comp, D.split]
  ext f
  rfl

#print axioms OVM.orbitVariation_le_operatorVariation
#print axioms Dilation.reflexive_underlying_of_reflexive

end LocalOrbitVariation
noncomputable section ReflexiveObstruction

open MeasureTheory
variable {X Z Ω : Type*} [MeasurableSpace Ω]
  [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X]
  [NormedAddCommGroup Z] [NormedSpace ℝ Z] [CompleteSpace Z]

omit [CompleteSpace Z] in
theorem IsReflexive.dual (h : IsReflexive Z) : IsReflexive (Dual Z) := by
  intro η
  let f := η.comp (canonicalBidualEmbedding : Z →L[ℝ] Bidual Z)
  refine ⟨f, ?_⟩
  apply ContinuousLinearMap.ext
  intro ξ
  obtain ⟨z, rfl⟩ := h ξ
  rfl

/-- The two iterated limits of a triangular matrix of pairings cannot occur
between bounded sequences in a reflexive Banach space and its dual. -/
theorem not_reflexive_of_triangular_pairings
    (u : ℕ → Z) (v : ℕ → Dual Z)
    (hu : ∃ C : ℝ, ∀ n, ‖u n‖ ≤ C) (hv : ∃ C : ℝ, ∀ j, ‖v j‖ ≤ C)
    (hpair : ∀ j n, v j (u n) = if j ≤ n then 1 else 0) :
    ¬ IsReflexive Z := by
  intro hr
  obtain ⟨φ, hφ, z, hz⟩ := (citeEberleinSmulian Z).2.mp hr u hu
  obtain ⟨ψ, hψ, f, hf⟩ := (citeEberleinSmulian (Dual Z)).2.mp hr.dual v hv
  have hfirst (j : ℕ) : v j z = 1 := by
    apply tendsto_nhds_unique (hz (v j))
    apply tendsto_const_nhds.congr'
    filter_upwards [eventually_ge_atTop j] with n hn
    exact ((hpair j (φ n)).trans (ite_eq_left (hn.trans (hφ.id_le n)))).symm
  have hsecond (n : ℕ) : f (u n) = 0 := by
    apply tendsto_nhds_unique (hf (J (u n)))
    apply tendsto_const_nhds.congr'
    filter_upwards [eventually_gt_atTop n] with j hj
    exact ((hpair (ψ j) n).trans (ite_eq_right (not_le_of_gt (hj.trans_le (hψ.id_le j))))).symm
  have h₁ : f z = 1 := tendsto_nhds_unique (hf (J z))
    (tendsto_const_nhds.congr fun j => (hfirst (ψ j)).symm)
  have h₀ : f z = 0 := tendsto_nhds_unique (hz f)
    (tendsto_const_nhds.congr fun n => (hsecond (φ n)).symm)
  exact one_ne_zero (h₁.symm.trans h₀)

private theorem Dilation.multiplier_compress {μ : OVM Ω X} (D : Dilation μ Z)
    (a : boundedMeasurableAlgebra Ω) (x : X) (f : Dual X) :
    f (μ.boundedMeasurableMultiplier a x) =
      f (D.S (D.P.boundedMeasurableRepresentation a (D.T x))) := by
  let g := adjoint D.S f
  let m := D.P.toOVM.orbitCharge (D.T x) g
  have hca : m.CountablyAdditive := fun E hE => D.P.toOVM.normal_J (D.T x) E hE g
  let ρ := m.variationMeasure
  have hnull (E : MeasSet Ω) (hE : ρ E.1 = 0) : m.val E = 0 := by
    dsimp [ρ] at hE
    rw [m.variationMeasure_apply hca E, ENNReal.ofReal_eq_zero] at hE
    have hp := m.positivePart_positive E
    have hn := m.neg.positivePart_positive E
    rw [m.val_eq_positive_sub_negative E]
    linarith
  obtain ⟨k, _, hi, hk⟩ := m.exists_rnDensity hca ρ hnull
  have hd (E : MeasSet Ω) : (J (D.T x)) (adjoint (D.P.val E) g) = ∫ t in E.1, k t ∂ρ := hk E
  have hc (E : MeasSet Ω) : (J x) (adjoint (μ.val E) f) = ∫ t in E.1, k t ∂ρ := by
    change f (μ.val E x) = _
    rw [← DFunLike.congr_fun (D.compress E) x]
    exact hk E
  exact (μ.boundedMeasurableMultiplier_coeff a (J x) f ρ k hi hc).trans
    (D.P.toOVM.boundedMeasurableMultiplier_coeff a (J (D.T x)) g ρ k hi hd).symm

local instance (priority := 2000) (O : Type*) [MeasurableSpace O] :
    Semiring (boundedMeasurableAlgebra O) := (boundedMeasurableAlgebra O).toRing.toSemiring

/-- The moment condition in ex:no-reflexive-dilation obstructs every
reflexive dilation. The uniform control on both sequence norms follows
from the multiplier bound. -/
theorem OVM.no_reflexive_dilation_of_triangular_moments (μ : OVM Ω X)
    (a : ℕ → boundedMeasurableAlgebra Ω) (x : ℕ → X) (f : ℕ → Dual X)
    (ha : ∀ n, ‖(a n).1‖ ≤ 1) (hx : ∀ n, ‖x n‖ ≤ 1) (hf : ∀ j, ‖f j‖ ≤ 1)
    (hm : ∀ j n, f j (μ.boundedMeasurableMultiplier (a j * a n) (x n)) =
      if j ≤ n then 1 else 0)
    (D : Dilation μ Z) : ¬ IsReflexive Z := by
  let P := D.P
  let B := 2 * P.toOVM.uniformNorm
  let u n := P.boundedMeasurableRepresentation (a n) (D.T (x n))
  let v j := adjoint (D.S.comp (P.boundedMeasurableRepresentation (a j))) (f j)
  have hB : 0 ≤ B := mul_nonneg (by norm_num) P.toOVM.uniformNorm_nonneg
  have hmBound (n : ℕ) : ‖P.boundedMeasurableRepresentation (a n)‖ ≤ B := by
    exact (P.toOVM.norm_boundedMeasurableMultiplier_le (a n)).trans
      (mul_le_of_le_one_right hB (ha n))
  have hu (n : ℕ) : ‖u n‖ ≤ B * ‖D.T‖ := by
    calc
      _ ≤ ‖P.boundedMeasurableRepresentation (a n)‖ * ‖D.T (x n)‖ :=
        (P.boundedMeasurableRepresentation (a n)).le_opNorm _
      _ ≤ B * ‖D.T‖ := mul_le_mul (hmBound n)
        ((D.T.le_opNorm _).trans (mul_le_of_le_one_right (norm_nonneg _) (hx n))) (norm_nonneg _) hB
  have hv (j : ℕ) : ‖v j‖ ≤ ‖D.S‖ * B := by
    calc
      _ ≤ ‖f j‖ * ‖D.S.comp (P.boundedMeasurableRepresentation (a j))‖ :=
        (f j).opNorm_comp_le _
      _ ≤ 1 * (‖D.S‖ * B) := mul_le_mul (hf j)
        ((D.S.opNorm_comp_le _).trans (mul_le_mul_of_nonneg_left (hmBound j) (norm_nonneg _)))
        (norm_nonneg _) (by norm_num)
      _ = _ := one_mul _
  apply not_reflexive_of_triangular_pairings u v ⟨_, hu⟩ ⟨_, hv⟩
  intro j n
  rw [← hm j n, D.multiplier_compress, map_mul]
  rfl

#print axioms OVM.no_reflexive_dilation_of_triangular_moments

end ReflexiveObstruction


noncomputable section AlphaOrbitScalarTails

open MeasureTheory

variable {Ω X : Type*} [MeasurableSpace Ω] [NormedAddCommGroup X] [NormedSpace ℝ X]
  [CompleteSpace X]

/-- Continuity from above at the empty set of the semivariation of a
norm-countably additive vector measure (Diestel–Uhl, Chapter I). -/
axiom citeVectorMeasureSemivariationTails {Y : Type*} [NormedAddCommGroup Y]
    [NormedSpace ℝ Y] [CompleteSpace Y] (m : MeasSet Ω → Y)
    (hadd : ∀ E : ℕ → MeasSet Ω, MeasSet.DisjointSeq E →
      HasSum (fun n => m (E n)) (m (MeasSet.iUnion E)))
    (D : ℕ → MeasSet Ω) (hD : Antitone fun n => (D n).1)
    (hEmpty : (⋂ n, (D n).1) = ∅) :
    ∀ ε : ℝ, 0 < ε → ∀ᶠ n in atTop, ∀ E : MeasSet Ω, E.1 ⊆ (D n).1 → ‖m E‖ ≤ ε

private def OVM.alphaAdjointMeasure (μ : OVM Ω X) (f : Dual μ.alphaSubmodule)
    (E : MeasSet Ω) : Dual X := adjoint (μ.alphaPVM.val E |>.comp μ.alphaAnalysis) f

private theorem OVM.alphaAdjointMeasure_hasSum (μ : OVM Ω X) (hX : IsReflexive X)
    (f : Dual μ.alphaSubmodule) (E : ℕ → MeasSet Ω) (hE : MeasSet.DisjointSeq E) :
    HasSum (fun n => μ.alphaAdjointMeasure f (E n)) (μ.alphaAdjointMeasure f (MeasSet.iUnion E)) := by
  let cut (b : ℕ → Bool) (n : ℕ) := if b n then E n else MeasSet.empty
  have hm (b : ℕ → Bool) (ξ : Bidual X) :
      HasSum (fun n => if b n then ξ (μ.alphaAdjointMeasure f (E n)) else 0)
        (ξ (μ.alphaAdjointMeasure f (MeasSet.iUnion (cut b)))) := by
    obtain ⟨x, rfl⟩ := hX ξ
    have hd : MeasSet.DisjointSeq (cut b) := by
      intro i j hij
      cases hi : b i <;> cases hj : b j <;> simp [cut, hi, hj, MeasSet.empty, hE hij]
    have hsum := f.hasSum (μ.alphaPVM.countably_additive (cut b) hd (μ.alphaAnalysis x))
    convert hsum using 1 <;> try rfl
    funext n
    cases hn : b n <;>
      simp [OVM.alphaAdjointMeasure, cut, hn, μ.alphaPVM.empty_eq, J_apply, adjoint]
  have h := hasSum_of_weak_subseries (fun n => μ.alphaAdjointMeasure f (E n)) (fun b =>
    μ.alphaAdjointMeasure f (MeasSet.iUnion (cut b))) hm
  simpa [cut] using h

/-- Scalar tails vanish uniformly over the full multiplier orbit of the
minimal dilation when the underlying Banach space is reflexive. -/
theorem OVM.alphaOrbit_uniform_scalar_tails (μ : OVM Ω X) (hX : IsReflexive X)
    (f : Dual μ.alphaSubmodule) (D : ℕ → MeasSet Ω)
    (hD : Antitone fun n => (D n).1) (hEmpty : (⋂ n, (D n).1) = ∅) :
    ∀ ε : ℝ, 0 < ε → ∀ᶠ n in atTop, ∀ z ∈ μ.alphaMultiplierOrbit,
      |f (μ.alphaPVM.val (D n) z)| ≤ ε := by
  intro ε hε
  filter_upwards [citeVectorMeasureSemivariationTails (μ.alphaAdjointMeasure f)
    (μ.alphaAdjointMeasure_hasSum hX f) D hD hEmpty (ε / 2) (by positivity)] with n hbound z hz
  obtain ⟨a, _, ha, ⟨x, hx, rfl⟩, rfl⟩ := hz
  have hx' : ‖x‖ ≤ 1 := mem_closedBall_zero_iff.mp hx
  let P := μ.alphaPVM
  let v := μ.alphaAnalysis x
  let m := P.toOVM.orbitCharge v f
  have hca : m.CountablyAdditive := fun E hE => P.toOVM.normal_J v E hE f
  let ρ := m.variationMeasure
  have hnull (E : MeasSet Ω) (hE : ρ E.1 = 0) : m.val E = 0 := by
    dsimp [ρ] at hE
    rw [m.variationMeasure_apply hca E, ENNReal.ofReal_eq_zero] at hE
    have hp := m.positivePart_positive E
    have hn := m.neg.positivePart_positive E
    rw [m.val_eq_positive_sub_negative E]
    linarith
  obtain ⟨k, hkm, hi, hk⟩ := m.exists_rnDensity hca ρ hnull
  have hd (E : MeasSet Ω) : f (P.val E v) = ∫ t in E.1, k t ∂ρ := hk E
  have hs (A : MeasSet Ω) : |∫ t in A.1, k t ∂(ρ.restrict (D n).1)| ≤ ε / 2 := by
    rw [Measure.restrict_restrict A.2]
    change |∫ t in (A.inter (D n)).1, k t ∂ρ| ≤ ε / 2
    rw [← hd (A.inter (D n))]
    change ‖μ.alphaAdjointMeasure f (A.inter (D n)) x‖ ≤ _
    exact ((μ.alphaAdjointMeasure f (A.inter (D n))).le_opNorm x).trans
      ((mul_le_mul_of_nonneg_left hx' (norm_nonneg _)).trans (by
        rw [mul_one]
        exact hbound _ inter_subset_right))
  have hiD : Integrable k (ρ.restrict (D n).1) := hi.restrict
  have hint := sSup_abs_setIntegral_eq k hkm hiD
  have hs' : sSup (Set.range fun A : MeasSet Ω =>
      |∫ t in A.1, k t ∂(ρ.restrict (D n).1)|) ≤ ε / 2 := by
    apply csSup_le (range_nonempty _)
    rintro _ ⟨A, rfl⟩
    exact hs A
  have hInt : (∫ t in (D n).1, |k t| ∂ρ) ≤ ε := by
    rw [hint] at hs'
    linarith [abs_nonneg (∫ t in (D n).1, k t ∂ρ)]
  change |f (P.val (D n) (P.toOVM.boundedMeasurableMultiplier a v))| ≤ ε
  rw [P.boundedMeasurableMultiplier_cut a v f ρ k hi hd]
  exact (norm_integral_le_integral_norm _).trans ((integral_mono_ae
    (integrable_boundedMeasurable_mul a hi).norm.restrict hiD.norm
    (Eventually.of_forall fun t => by
      change ‖a.1 t * k t‖ ≤ ‖k t‖
      rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_mul]
      exact (mul_le_mul_of_nonneg_right
        ((discreteBounded_norm_apply_le a.1 t).trans ha) (abs_nonneg _)).trans_eq (one_mul _))).trans hInt)

#print axioms OVM.alphaOrbit_uniform_scalar_tails

end AlphaOrbitScalarTails


noncomputable section PatchingLocalWeakCompactness

variable {Ω Z : Type*} [MeasurableSpace Ω]
  [NormedAddCommGroup Z] [NormedSpace ℝ Z]

/-- Countable diagonal selection in a countable product of sequentially
compact sets, specialized to the scalar functionals defining weak convergence. -/
axiom citeCountableWeakDiagonalSelection (K : ℕ → Set Z)
    (hK : ∀ n, RelativelyWeaklyCompact (K n))
    (u : ℕ → ℕ → Z) (hu : ∀ j n, u j n ∈ K j) :
    ∃ (φ : ℕ → ℕ) (_ : StrictMono φ) (w : ℕ → Z),
      ∀ j (f : Dual Z), Tendsto (fun n => f (u j (φ n))) atTop (𝓝 (f (w j)))

private def MeasSet.partitionHead (B : ℕ → MeasSet Ω) (N : ℕ) : MeasSet Ω :=
  MeasSet.finiteUnion B (Finset.range N)

private def MeasSet.partitionTail (B : ℕ → MeasSet Ω) (N : ℕ) : MeasSet Ω :=
  MeasSet.whole.diff (MeasSet.partitionHead B N)

private theorem MeasSet.partitionTail_antitone (B : ℕ → MeasSet Ω) :
    Antitone (fun n => (MeasSet.partitionTail B n).1) := by
  intro i j hij t ht
  refine ⟨ht.1, fun h => ht.2 ?_⟩
  obtain ⟨k, hk, hkt⟩ := mem_iUnion₂.mp h
  exact mem_iUnion₂.mpr ⟨k, Finset.mem_range.mpr ((Finset.mem_range.mp hk).trans_le hij), hkt⟩

private theorem MeasSet.partitionTail_iInter (B : ℕ → MeasSet Ω)
    (h : MeasSet.iUnion B = MeasSet.whole) :
    (⋂ n, (MeasSet.partitionTail B n).1) = ∅ := by
  apply Set.eq_empty_iff_forall_notMem.mpr
  intro t ht
  have ht' : t ∈ (MeasSet.iUnion B).1 := h ▸ mem_univ t
  obtain ⟨k, hk⟩ := mem_iUnion.mp ht'
  exact (mem_iInter.mp ht (k + 1)).2 (mem_iUnion₂.mpr
    ⟨k, Finset.mem_range.mpr (Nat.lt_succ_self k), hk⟩)

private theorem PVM.val_partitionTail (P : PVM Ω Z) (B : ℕ → MeasSet Ω) (N : ℕ) (z : Z) :
    P.val (MeasSet.partitionTail B N) z = z - P.val (MeasSet.partitionHead B N) z := by
  change P.val (MeasSet.whole.diff _) z = _
  rw [P.val_diff_apply]
  have h : MeasSet.whole.inter (MeasSet.partitionHead B N) = MeasSet.partitionHead B N :=
    Subtype.ext (univ_inter _)
  rw [h, P.normalized, ContinuousLinearMap.id_apply]

private theorem weakLimit_norm_le (u : ℕ → Z) (w : Z)
    (hw : ∀ f : Dual Z, Tendsto (fun n => f (u n)) atTop (𝓝 (f w)))
    (C : ℝ) (hC : 0 ≤ C) (hu : ∀ n, ‖u n‖ ≤ C) : ‖w‖ ≤ C := by
  by_cases h : ‖w‖ = 0
  · rwa [h]
  · obtain ⟨f, hf, he⟩ := exists_dual_vector ℝ w h
    change f w = ‖w‖ at he
    rw [← he]
    apply le_of_tendsto (hw f)
    exact Eventually.of_forall fun n => (le_abs_self _).trans
      (((f.le_opNorm _).trans_eq (by rw [hf, one_mul])).trans (hu n))

/-- Combine local weak compactness and uniform scalar tail bounds on
a countable partition, using bounded completeness of the projections. -/
theorem PVM.relativelyWeaklyCompact_of_partition_tails [CompleteSpace Z] (P : PVM Ω Z)
    (B : ℕ → MeasSet Ω) (hB : MeasSet.DisjointSeq B)
    (_hcover : MeasSet.iUnion B = MeasSet.whole) (hbc : P.BoundedlyComplete)
    (K : Set Z) (hBound : ∃ C : ℝ, 0 ≤ C ∧ ∀ z ∈ K, ‖z‖ ≤ C)
    (hLocal : ∀ j, RelativelyWeaklyCompact (P.val (B j) '' K))
    (hTail : ∀ (f : Dual Z) (ε : ℝ), 0 < ε → ∀ᶠ N in atTop,
      ∀ z ∈ K, |f (P.val (MeasSet.partitionTail B N) z)| ≤ ε) :
    RelativelyWeaklyCompact K := by
  apply (citeRelativeEberleinSmulian K).mpr
  intro u hu
  obtain ⟨C, hC, hBound⟩ := hBound
  obtain ⟨φ, hφ, w, hw⟩ := citeCountableWeakDiagonalSelection (fun j => P.val (B j) '' K)
    hLocal (fun j n => P.val (B j) (u n)) (fun j n => ⟨u n, hu n, rfl⟩)
  have hproj (j : ℕ) : P.val (B j) (w j) = w j := by
    apply eq_of_dual_eval
    intro f
    apply tendsto_nhds_unique (hw j (adjoint (P.val (B j)) f))
    apply (hw j f).congr
    intro n
    have he := DFunLike.congr_fun (P.projection_idempotent (B j)) (u (φ n))
    exact congrArg f he.symm
  have hsum (N : ℕ) (f : Dual Z) :
      Tendsto (fun k => f (P.val (MeasSet.partitionHead B N) (u (φ k)))) atTop
        (𝓝 (f (∑ j ∈ Finset.range N, w j))) := by
    simp only [MeasSet.partitionHead, P.toOVM.apply_finite_union B hB, map_sum]
    exact tendsto_finsetSum _ (fun j _ => hw j f)
  let M := P.toOVM.uniformNorm
  have hfinite (N : ℕ) : ‖∑ j ∈ Finset.range N, w j‖ ≤ M * C := by
    apply weakLimit_norm_le _ _ (hsum N) _ (mul_nonneg P.toOVM.uniformNorm_nonneg hC)
    intro n
    exact ((P.val (MeasSet.partitionHead B N)).le_opNorm _).trans
      (mul_le_mul (P.toOVM.opNorm_le_uniformNorm _) (hBound _ (hu _))
        (norm_nonneg _) P.toOVM.uniformNorm_nonneg)
  obtain ⟨z, hz⟩ := hbc B w hB hproj ⟨M * C, hfinite⟩
  refine ⟨φ, hφ, z, fun f => ?_⟩
  have hzsum : Tendsto (fun N => f (∑ j ∈ Finset.range N, w j)) atTop (𝓝 (f z)) :=
    (f.continuous.tendsto z).comp hz
  rw [Metric.tendsto_nhds] at hzsum ⊢
  intro ε hε
  have hne : 0 < ε / 3 := by positivity
  obtain ⟨N, hTN, hZN⟩ := (hTail f (ε / 3) hne).and (hzsum (ε / 3) hne) |>.exists
  filter_upwards [Metric.tendsto_nhds.mp (hsum N f) (ε / 3) hne] with k hk
  have hku := hTN (u (φ k)) (hu (φ k))
  rw [P.val_partitionTail, map_sub] at hku
  rw [Real.dist_eq] at hk hZN ⊢
  have he : f (u (φ k)) - f z =
      (f (u (φ k)) - f (P.val (MeasSet.partitionHead B N) (u (φ k)))) +
      (f (P.val (MeasSet.partitionHead B N) (u (φ k))) -
        f (∑ j ∈ Finset.range N, w j)) +
      (f (∑ j ∈ Finset.range N, w j) - f z) := by ring
  rw [he]
  apply (abs_add_le _ _).trans_lt
  linarith [abs_add_le (f (u (φ k)) - f (P.val (MeasSet.partitionHead B N) (u (φ k))))
    (f (P.val (MeasSet.partitionHead B N) (u (φ k))) - f (∑ j ∈ Finset.range N, w j))]

#print axioms PVM.relativelyWeaklyCompact_of_partition_tails

end PatchingLocalWeakCompactness


noncomputable section LocalVariationCompactness

open MeasureTheory
open scoped ENNReal

universe uΩ uX
variable {Ω : Type uΩ} {X : Type uX} [MeasurableSpace Ω]
  [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X]

local instance : TopologicalSpace (MeasSet Ω) := ⊥

/-- The Banach space of countably additive vector measures of bounded
variation, with its variation, evaluations and bounded scalar integration. -/
structure VectorVariationModel (Ω : Type uΩ) (X : Type uX) [MeasurableSpace Ω]
    [NormedAddCommGroup X] [NormedSpace ℝ X] where
  carrier : Type (max uΩ uX)
  group : NormedAddCommGroup carrier
  space : letI := group; NormedSpace ℝ carrier
  complete : letI := group; CompleteSpace carrier
  eval : letI := group; letI := space; carrier →L[ℝ] AlphaAmbient Ω X
  injective : Function.Injective eval
  empty_eval : ∀ v, eval v MeasSet.empty = 0
  ca_eval : ∀ v (A : ℕ → MeasSet Ω), MeasSet.DisjointSeq A →
    HasSum (fun n => eval v (A n)) (eval v (MeasSet.iUnion A))
  var : carrier → MeasSet Ω → ℝ≥0∞
  var_eval : ∀ v E, var v E = sSup {r | ∃ (A : ℕ → MeasSet Ω) (I : Finset ℕ),
    (↑I : Set ℕ).Pairwise (fun i j => Disjoint (A i).1 (A j).1) ∧
    MeasSet.finiteUnion A I = E ∧ r = ENNReal.ofReal (∑ n ∈ I, ‖eval v (A n)‖)}
  var_norm : letI := group; ∀ m, var m MeasSet.whole = ENNReal.ofReal ‖m‖
  represent : letI := group; ∀ (m : MeasSet Ω → X), m MeasSet.empty = 0 →
    (∀ A : ℕ → MeasSet Ω, MeasSet.DisjointSeq A →
      HasSum (fun n => m (A n)) (m (MeasSet.iUnion A))) →
    ∀ C : ℝ, 0 ≤ C →
    (∀ (A : ℕ → MeasSet Ω) (I : Finset ℕ),
      (↑I : Set ℕ).Pairwise (fun i j => Disjoint (A i).1 (A j).1) →
      MeasSet.finiteUnion A I = MeasSet.whole → ∑ n ∈ I, ‖m (A n)‖ ≤ C) →
    ∃ v : carrier, (∀ E, eval v E = m E) ∧ ‖v‖ ≤ C
  mul : boundedMeasurableAlgebra Ω → carrier → carrier
  var_mul : ∀ a m E, var (mul a m) E ≤ ENNReal.ofReal ‖a.1‖ * var m E
  eval_mul : letI := group; letI := space; ∀ (a : boundedMeasurableAlgebra Ω) (v : carrier) (f : Dual X)
    (ρ : Measure Ω) (k : Ω → ℝ), Integrable k ρ →
    (∀ E : MeasSet Ω, f (eval v E) = ∫ t in E.1, k t ∂ρ) →
    ∀ E : MeasSet Ω, f (eval (mul a v) E) = ∫ t in E.1, a.1 t * k t ∂ρ
  common_domination : ∀ (v : ℕ → carrier), ∃ ρ : Measure Ω,
    IsFiniteMeasure ρ ∧ ∀ n E, ρ E.1 = 0 → var (v n) E = 0

attribute [instance] VectorVariationModel.group VectorVariationModel.space VectorVariationModel.complete

/-- Standard finite variation space construction and integration for
vector measures, including the countable sum of normalized variations as
a common dominating measure (Diestel–Uhl, Chapters I–II). -/
axiom citeVectorVariationModel (Ω : Type uΩ) (X : Type uX) [MeasurableSpace Ω]
    [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X] :
    Nonempty (VectorVariationModel Ω X)

def VectorVariationModel.UniformlyAC (V : VectorVariationModel Ω X)
    (ρ : Measure Ω) (K : Set V.carrier) : Prop :=
  ∀ ε : ℝ, 0 < ε → ∃ δ : ℝ≥0∞, 0 < δ ∧ ∀ E : MeasSet Ω, ρ E.1 < δ →
    ∀ v ∈ K, V.var v E ≤ ENNReal.ofReal ε

/-- For reflexive range X, the Radon–Nikodym isometry and Diestel's
weak compactness criterion in Bochner L¹ identify weak compactness of a
bounded family of dominated vector measures with uniform continuity of
its variations with respect to the dominating finite measure. -/
axiom citeDiestelUniformIntegrability (V : VectorVariationModel Ω X)
    (hX : IsReflexive X) (ρ : Measure Ω) [IsFiniteMeasure ρ]
    (K : Set V.carrier) (hDom : ∀ v ∈ K, ∀ E : MeasSet Ω, ρ E.1 = 0 → V.var v E = 0)
    (hB : ∃ C : ℝ, ∀ v ∈ K, ‖v‖ ≤ C) :
    RelativelyWeaklyCompact K ↔ V.UniformlyAC ρ K

omit [CompleteSpace X] in
private theorem OVM.variationRepresentationOn (μ : OVM Ω X)
    (V : VectorVariationModel Ω X) (B : MeasSet Ω) (C : ℝ) (hC : 0 ≤ C)
    (hVar : ∀ x : X, μ.orbitVariation x B ≤ ENNReal.ofReal (C * ‖x‖)) :
    ∃ T : X →L[ℝ] V.carrier, ∀ x E, V.eval (T x) E = μ.val (E.inter B) x := by
  have hr (x : X) : ∃ v : V.carrier, (∀ E, V.eval v E = μ.val (E.inter B) x) ∧
      ‖v‖ ≤ C * ‖x‖ := by
    refine V.represent (fun E => μ.val (E.inter B) x) ?_ ?_ (C * ‖x‖) (mul_nonneg hC (norm_nonneg _)) ?_
    · rw [show MeasSet.empty.inter B = MeasSet.empty from Subtype.ext (empty_inter _),
        μ.empty_eq, zero_apply]
    · intro E hE
      have he : MeasSet.iUnion (fun n => (E n).inter B) = (MeasSet.iUnion E).inter B := by
        apply Subtype.ext
        exact (iUnion_inter _ _).symm
      rw [← he]
      exact μ.countably_additive _ (fun i j hij =>
        (hE hij).mono inter_subset_left inter_subset_left) x
    · intro A I hA hI
      let E (n : ℕ) := (A n).inter B
      have hE : MeasSet.finiteUnion E I = B := by
        apply Subtype.ext
        ext t
        constructor
        · intro ht
          obtain ⟨n, hn, htn⟩ := mem_iUnion₂.mp ht
          exact htn.2
        · intro ht
          have htu : t ∈ (MeasSet.finiteUnion A I).1 := by rw [hI]; exact mem_univ t
          obtain ⟨n, hn, htn⟩ := mem_iUnion₂.mp htu
          exact mem_iUnion₂.mpr ⟨n, hn, htn, ht⟩
      apply ENNReal.ofReal_le_ofReal_iff (mul_nonneg hC (norm_nonneg x)) |>.mp
      have hle : ENNReal.ofReal (∑ n ∈ I, ‖μ.val (E n) x‖) ≤ μ.orbitVariation x B :=
        le_sSup ⟨E, I, fun i hi j hj hij => (hA hi hj hij).mono
          inter_subset_left inter_subset_left, hE, rfl⟩
      exact hle.trans (hVar x)
  choose T hTE hT using hr
  refine ⟨LinearMap.mkContinuous
    { toFun := T
      map_add' := fun x y => V.injective (by
        apply BoundedContinuousFunction.ext
        intro E
        rw [map_add]
        change V.eval (T (x + y)) E = V.eval (T x) E + V.eval (T y) E
        rw [hTE, hTE, hTE, map_add])
      map_smul' := fun a x => V.injective (by
        apply BoundedContinuousFunction.ext
        intro E
        rw [map_smul]
        change V.eval (T (a • x)) E = a • (V.eval (T x) E)
        rw [hTE, hTE, map_smul]) } C hT, hTE⟩

private theorem OVM.variationMultipliers_compact (V : VectorVariationModel Ω X)
    (hX : IsReflexive X) (T : X →L[ℝ] V.carrier) :
    RelativelyWeaklyCompact {v | ∃ (a : boundedMeasurableAlgebra Ω) (x : X),
      ‖a.1‖ ≤ 1 ∧ ‖x‖ ≤ 1 ∧ v = V.mul a (T x)} := by
  apply (citeRelativeEberleinSmulian _).mpr
  intro v hv
  choose a x ha hx hV using hv
  obtain ⟨ρ, hρ, hDom⟩ := V.common_domination (fun n => T (x n))
  let _ := hρ
  have hs (n : ℕ) : ‖T (x n)‖ ≤ ‖T‖ := (T.le_opNorm _).trans (by
    simpa using mul_le_mul_of_nonneg_left (hx n) (norm_nonneg T))
  have h0 : RelativelyWeaklyCompact (Set.range fun n => T (x n)) := by
    rw [show (Set.range fun n => T (x n)) = T '' Set.range x from
      (Set.range_comp T x)]
    exact relativelyWeaklyCompact_image (relativelyWeaklyCompact_of_reflexive hX
      ⟨1, by rintro _ ⟨n, rfl⟩; exact hx n⟩) T
  have h0' := (citeDiestelUniformIntegrability V hX ρ _ (by
    rintro _ ⟨n, rfl⟩
    exact hDom n) ⟨‖T‖, by rintro _ ⟨n, rfl⟩; exact hs n⟩).mp h0
  have hle (n : ℕ) (E : MeasSet Ω) : V.var (v n) E ≤ V.var (T (x n)) E := by
    rw [hV n]
    exact (V.var_mul _ _ _).trans (by
      have hh : ENNReal.ofReal ‖(a n).1‖ ≤ 1 := by
        simpa only [ENNReal.ofReal_one] using ENNReal.ofReal_le_ofReal (ha n)
      simpa only [mul_one, one_mul, mul_comm] using mul_le_mul_right hh (V.var (T (x n)) E))
  have h1 := (citeDiestelUniformIntegrability V hX ρ (Set.range v)
    (by rintro _ ⟨n, rfl⟩ E hE; exact le_zero_iff.mp ((hle n E).trans_eq (hDom n E hE)))
    ⟨‖T‖, by
      rintro _ ⟨n, rfl⟩
      apply (ENNReal.ofReal_le_ofReal_iff (norm_nonneg T)).mp
      rw [← V.var_norm]
      exact (hle n MeasSet.whole).trans (by rw [V.var_norm]; exact ENNReal.ofReal_le_ofReal (hs n))⟩).mpr
    (by
      intro ε hε
      obtain ⟨δ, hδ, hh⟩ := h0' ε hε
      exact ⟨δ, hδ, by
        rintro E hE _ ⟨n, rfl⟩
        exact (hle n E).trans (hh E hE _ (Set.mem_range_self n))⟩)
  exact (citeRelativeEberleinSmulian _).mp h1 v (fun n => Set.mem_range_self n)

#print axioms OVM.variationMultipliers_compact




private theorem relativelyWeaklyCompact_submodule_of_image {Z : Type*}
    [NormedAddCommGroup Z] [NormedSpace ℝ Z] (Y : Submodule ℝ Z)
    (hY : IsClosed (Y : Set Z)) (K : Set Y)
    (hK : RelativelyWeaklyCompact (Y.subtypeL '' K)) : RelativelyWeaklyCompact K := by
  let _ : IsClosed (Y : Set Z) := hY
  apply (citeRelativeEberleinSmulian K).mpr
  intro u hu
  obtain ⟨φ, hφ, z, hz⟩ := (citeRelativeEberleinSmulian _).mp hK
    (fun n => (u n).1) (fun n => ⟨u n, hu n, rfl⟩)
  have hzY : z ∈ Y := by
    apply (Submodule.Quotient.mk_eq_zero Y).mp
    apply eq_of_dual_eval
    intro g
    rw [map_zero]
    apply tendsto_nhds_unique (hz (g.comp Y.mkQL))
    have hvanish (n : ℕ) : (g.comp Y.mkQL) (u (φ n)).1 = 0 := by
      change g (Y.mkQL (u (φ n)).1) = _
      rw [show Y.mkQL (u (φ n)).1 = 0 from
        (Submodule.Quotient.mk_eq_zero Y).mpr (u (φ n)).2, map_zero]
    simp only [hvanish]
    exact tendsto_const_nhds
  refine ⟨φ, hφ, ⟨z, hzY⟩, fun f => ?_⟩
  obtain ⟨g, hg, _⟩ := exists_extension_norm_eq Y f
  simpa only [hg (⟨z, hzY⟩ : Y), hg (u _)] using hz g

private theorem OVM.variationMultipliers_transport (μ : OVM Ω X)
    (V : VectorVariationModel Ω X) (B : MeasSet Ω)
    (T : X →L[ℝ] V.carrier)
    (hT : ∀ x E, V.eval (T x) E = μ.val (E.inter B) x)
    (a : boundedMeasurableAlgebra Ω) (x : X) :
    V.eval (V.mul a (T x)) =
      (μ.alphaPVM.val B (μ.alphaPVM.boundedMeasurableRepresentation a (μ.alphaAnalysis x))).1 := by
  let P := μ.alphaPVM
  let v := μ.alphaAnalysis x
  apply BoundedContinuousFunction.ext
  intro E
  apply eq_of_dual_eval
  intro g
  let f := adjoint (μ.alphaSynthesis.comp (P.val B)) g
  let m := P.toOVM.orbitCharge v f
  have hca : m.CountablyAdditive := fun A hA => P.toOVM.normal_J v A hA f
  let ρ := m.variationMeasure
  have hnull (A : MeasSet Ω) (hA : ρ A.1 = 0) : m.val A = 0 := by
    dsimp [ρ] at hA
    rw [m.variationMeasure_apply hca A, ENNReal.ofReal_eq_zero] at hA
    have hp := m.positivePart_positive A
    have hn := m.neg.positivePart_positive A
    rw [m.val_eq_positive_sub_negative A]
    linarith
  obtain ⟨k, _, hi, hk⟩ := m.exists_rnDensity hca ρ hnull
  have hd (A : MeasSet Ω) : f (P.val A v) = ∫ t in A.1, k t ∂ρ := hk A
  have heval (A : MeasSet Ω) (z : μ.alphaSubmodule) :
      f (P.val A z) = g (z.1 (B.inter A)) := by
    change g (z.1 (A.inter (B.inter MeasSet.whole))) = _
    rw [show A.inter (B.inter MeasSet.whole) = B.inter A from Subtype.ext (by
      change A.1 ∩ (B.1 ∩ univ) = B.1 ∩ A.1
      rw [inter_univ, inter_comm])]
  have hInput (A : MeasSet Ω) : g (V.eval (T x) A) = ∫ t in A.1, k t ∂ρ := by
    rw [← hd, heval, hT]
    change g (μ.val (A.inter B) x) = g (μ.val (MeasSet.whole.inter (B.inter A)) x)
    rw [show MeasSet.whole.inter (B.inter A) = A.inter B from Subtype.ext (by
      change univ ∩ (B.1 ∩ A.1) = A.1 ∩ B.1
      rw [univ_inter, inter_comm])]
  rw [V.eval_mul a (T x) g ρ k hi hInput E]
  have hcut := P.boundedMeasurableMultiplier_cut a v f ρ k hi hd E
  rw [heval] at hcut
  exact hcut.symm

theorem OVM.localVariation_cut_relativelyWeaklyCompact (μ : OVM Ω X)
    (hX : IsReflexive X) (B : MeasSet Ω) (hfin : ∀ x, μ.orbitVariation x B < ⊤) :
    RelativelyWeaklyCompact (μ.alphaPVM.val B '' μ.alphaMultiplierOrbit) := by
  obtain ⟨C, hC, hV⟩ := μ.uniform_orbitVariation B hfin
  let V := Classical.choice (citeVectorVariationModel Ω X)
  obtain ⟨T, hT⟩ := μ.variationRepresentationOn V B C hC hV
  apply relativelyWeaklyCompact_submodule_of_image _ μ.alphaSubmodule_isClosed
  have he : μ.alphaSubmodule.subtypeL '' (μ.alphaPVM.val B '' μ.alphaMultiplierOrbit) =
      V.eval '' {v | ∃ (a : boundedMeasurableAlgebra Ω) (x : X),
        ‖a.1‖ ≤ 1 ∧ ‖x‖ ≤ 1 ∧ v = V.mul a (T x)} := by
    ext y
    constructor
    · rintro ⟨_, ⟨_, ⟨a, _, ha, ⟨x, hx, rfl⟩, rfl⟩, rfl⟩, rfl⟩
      exact ⟨_, ⟨a, x, ha, mem_closedBall_zero_iff.mp hx, rfl⟩,
        μ.variationMultipliers_transport V B T hT a x⟩
    · rintro ⟨_, ⟨a, x, ha, hx, rfl⟩, rfl⟩
      exact ⟨_, ⟨_, ⟨a, _, ha, ⟨x, mem_closedBall_zero_iff.mpr hx, rfl⟩, rfl⟩, rfl⟩,
        (μ.variationMultipliers_transport V B T hT a x).symm⟩
  rw [he]
  exact relativelyWeaklyCompact_image (OVM.variationMultipliers_compact V hX T) V.eval

theorem OVM.alphaOrbit_relativelyWeaklyCompact_of_localVariation (μ : OVM Ω X)
    (B : ℕ → MeasSet Ω) (hB : MeasSet.DisjointSeq B)
    (hcover : MeasSet.iUnion B = MeasSet.whole)
    (hfin : ∀ j x, μ.orbitVariation x (B j) < ⊤) (hX : IsReflexive X) :
    RelativelyWeaklyCompact μ.alphaMultiplierOrbit := by
  apply μ.alphaPVM.relativelyWeaklyCompact_of_partition_tails B hB hcover
    (μ.alpha_boundedlyComplete_of_not_contains_cZero hX.excludes_lOne_and_cZero.2)
    μ.alphaMultiplierOrbit
  · obtain ⟨C, hC⟩ := analysisOrbit_bounded μ.alphaPVM μ.alphaAnalysis
    exact ⟨max C 0, le_max_right _ _, fun z hz => (hC z hz).trans (le_max_left _ _)⟩
  · exact fun j => μ.localVariation_cut_relativelyWeaklyCompact hX (B j) (hfin j)
  · exact fun f => μ.alphaOrbit_uniform_scalar_tails hX f _
      (MeasSet.partitionTail_antitone B) (MeasSet.partitionTail_iInter B hcover)

/-- Manuscript, thm:variation-reflexive-dilation. The partition hypothesis
concerns variation of each vector orbit on a common countable partition. -/
theorem OVM.variation_reflexive_dilation (μ : OVM Ω X) (hμ : μ.Normalized)
    (B : ℕ → MeasSet Ω) (hB : MeasSet.DisjointSeq B)
    (hcover : MeasSet.iUnion B = MeasSet.whole)
    (hfin : ∀ j x, μ.orbitVariation x (B j) < ⊤) :
    (∃ F : DilationSpace μ, letI := F.normedGroup; letI := F.normedScalar; IsReflexive F.carrier) ↔ IsReflexive X := by
  constructor
  · rintro ⟨F, hF⟩
    let _ := F.normedGroup
    let _ := F.normedScalar
    exact F.dilation.reflexive_underlying_of_reflexive hF
  · exact fun hX => (μ.multiplierOrbit_criterion hμ).1.mp
      (μ.alphaOrbit_relativelyWeaklyCompact_of_localVariation B hB hcover hfin hX)
/-- The operator-variation version follows by termwise domination of
each individual orbit variation on the prescribed partition. -/
theorem OVM.operatorVariation_reflexive_dilation (μ : OVM Ω X) (hμ : μ.Normalized)
    (B : ℕ → MeasSet Ω) (hB : MeasSet.DisjointSeq B)
    (hcover : MeasSet.iUnion B = MeasSet.whole)
    (hfin : ∀ j, μ.operatorVariation (B j) < ⊤) :
    (∃ F : DilationSpace μ, letI := F.normedGroup; letI := F.normedScalar; IsReflexive F.carrier) ↔
      IsReflexive X := by
  apply μ.variation_reflexive_dilation hμ B hB hcover
  exact fun j x => (μ.orbitVariation_le_operatorVariation x (B j)).trans_lt
    (ENNReal.mul_lt_top ENNReal.ofReal_lt_top (hfin j))

#print axioms OVM.operatorVariation_reflexive_dilation
#print axioms OVM.localVariation_cut_relativelyWeaklyCompact
#print axioms OVM.variation_reflexive_dilation

end LocalVariationCompactness

