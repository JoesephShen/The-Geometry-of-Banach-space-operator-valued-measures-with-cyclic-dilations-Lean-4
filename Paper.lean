noncomputable section SectionSevenOrliczEstimates

open MeasureTheory Set Filter
open scoped ENNReal Topology

private theorem exponentialYoung_nonneg (u : ℝ) : 0 ≤ exponentialYoung u := by
  have h := Real.exp_le_exp.mpr (sq_nonneg u)
  rw [Real.exp_zero] at h
  exact sub_nonneg.mpr h

@[simp] private theorem exponentialYoung_zero : exponentialYoung 0 = 0 := by
  simp [exponentialYoung]

private theorem exponentialYoung_mono {u v : ℝ} (hu : 0 ≤ u) (huv : u ≤ v) :
    exponentialYoung u ≤ exponentialYoung v :=
  sub_le_sub_right (Real.exp_le_exp.mpr (by
    simpa only [pow_two] using mul_self_le_mul_self hu huv)) 1

namespace ExponentialHeartModel

variable {G : Type} [NormedAddCommGroup G] [NormedSpace ℝ G]
variable (H : ExponentialHeartModel G)

theorem modular_integrable (x : G) {c : ℝ} (hc : 0 < c) :
    Integrable (fun t => exponentialYoung (|H.realization.repr x t| / c)) lebesgueUnitInterval :=
  ((H.range_iff (H.realization.repr x)).mp ⟨x,rfl⟩) c hc

theorem repr_sum_indicators (A : ℕ → MeasSet ℝ) (d : ℕ → ℝ) (I : Finset ℕ) :
    (⇑(H.realization.repr (∑ n ∈ I, d n • H.indicator (A n)))) =ᵐ[lebesgueUnitInterval]
      fun t => ∑ n ∈ I, (A n).1.indicator (fun _ => d n) t := by
  classical
  induction I using Finset.induction_on with
  | empty =>
    rw [Finset.sum_empty,map_zero]
    filter_upwards [AEEqFun.coeFn_zero (α := ℝ) (β := ℝ) (μ := lebesgueUnitInterval)] with t ht
    exact ht.trans (Finset.sum_empty.symm)
  | @insert n I hn ih =>
    simp only [Finset.sum_insert hn,map_add,map_smul]
    filter_upwards [AEEqFun.coeFn_add (d n • H.realization.repr (H.indicator (A n)))
      (H.realization.repr (∑ j ∈ I, d j • H.indicator (A j))),
      AEEqFun.coeFn_smul (d n) (H.realization.repr (H.indicator (A n))),
      H.indicator_ae (A n),ih] with t ht hs hA hI
    rw [ht]
    change (d n • H.realization.repr (H.indicator (A n))) t +
      H.realization.repr (∑ j ∈ I, d j • H.indicator (A j)) t = _
    rw [hs,hI]
    change d n * H.realization.repr (H.indicator (A n)) t + _ = _
    rw [hA]
    by_cases h : t ∈ (A n).1 <;> simp [h]

theorem norm_lower_on_set (x : G) (E : MeasSet ℝ) (b : ℝ) (hb : 0 < b)
    (hm : 0 < lebesgueUnitInterval.real E.1)
    (h : ∀ᵐ t ∂lebesgueUnitInterval, t ∈ E.1 → b ≤ |H.realization.repr x t|) :
    b / Real.sqrt (Real.log (1 + 1 / lebesgueUnitInterval.real E.1)) ≤ ‖x‖ := by
  let m := lebesgueUnitInterval.real E.1
  have hx : 0 < ‖x‖ := by
    apply norm_pos_iff.mpr
    intro hzero
    rw [hzero,map_zero] at h
    have hnot : ∀ᵐ t ∂lebesgueUnitInterval, t ∉ E.1 := by
      filter_upwards [h,AEEqFun.coeFn_zero (α := ℝ) (β := ℝ) (μ := lebesgueUnitInterval)] with t h₁ h₂ ht
      have hl := h₁ ht
      rw [h₂] at hl
      change b ≤ |(0 : ℝ)| at hl
      rw [abs_zero] at hl
      exact (not_lt_of_ge hl) hb
    have hnull : lebesgueUnitInterval E.1 = 0 := by
      rw [ae_iff] at hnot
      simpa only [not_not,ofPred_mem_eq] using hnot
    exact (ne_of_gt hm) (by rw [Measure.real,hnull,ENNReal.toReal_zero])
  have hg : Integrable (E.1.indicator (fun _ => exponentialYoung (b / ‖x‖))) lebesgueUnitInterval :=
    (integrable_const _).indicator E.2
  have hi : m * exponentialYoung (b / ‖x‖) ≤ expModular (H.realization.repr x) ‖x‖ := by
    calc
      _ = ∫ t, E.1.indicator (fun _ => exponentialYoung (b / ‖x‖)) t ∂lebesgueUnitInterval := by
        rw [integral_indicator E.2,setIntegral_const,smul_eq_mul]
      _ ≤ _ := by
        apply integral_mono_ae hg (H.modular_integrable x hx)
        filter_upwards [h] with t ht
        by_cases hE : t ∈ E.1
        · rw [indicator_of_mem hE]
          exact exponentialYoung_mono (div_nonneg hb.le hx.le) (div_le_div_of_nonneg_right (ht hE) hx.le)
        · rw [indicator_of_notMem hE]
          exact exponentialYoung_nonneg _
  have hle := hi.trans ((H.norm_iff x ‖x‖ hx).mp le_rfl)
  have hexp : Real.exp ((b / ‖x‖) ^ 2) ≤ 1 + 1 / m := by
    have hd := (le_div_iff₀ hm).mpr (by
      simpa only [mul_comm] using hle : (exponentialYoung (b / ‖x‖)) * m ≤ 1)
    unfold exponentialYoung at hd
    linarith
  have hsq := Real.log_le_log (Real.exp_pos _) hexp
  rw [Real.log_exp] at hsq
  have hlog : 0 < Real.log (1 + 1 / m) := Real.log_pos (by linarith [one_div_pos.mpr hm])
  have hroot : 0 < Real.sqrt (Real.log (1 + 1 / m)) := Real.sqrt_pos.2 hlog
  have hq := Real.sqrt_le_sqrt hsq
  rw [Real.sqrt_sq (div_nonneg hb.le hx.le)] at hq
  exact (div_le_iff₀ hroot).mpr (mul_comm ‖x‖ _ ▸ (div_le_iff₀ hx).mp hq)

theorem norm_smul_indicator (E : MeasSet ℝ) (b : ℝ) (hb : 0 < b)
    (hm : 0 < lebesgueUnitInterval.real E.1) :
    ‖b • H.indicator E‖ =
      b / Real.sqrt (Real.log (1 + 1 / lebesgueUnitInterval.real E.1)) := by
  let m := lebesgueUnitInterval.real E.1
  let k := Real.sqrt (Real.log (1 + 1 / m))
  have hk : 0 < k := Real.sqrt_pos.2 (Real.log_pos (by linarith [one_div_pos.mpr hm]))
  have hc : 0 < b / k := div_pos hb hk
  have hr : (⇑(H.realization.repr (b • H.indicator E))) =ᵐ[lebesgueUnitInterval]
      E.1.indicator (fun _ => b) := by
    rw [map_smul]
    filter_upwards [AEEqFun.coeFn_smul b (H.realization.repr (H.indicator E)),H.indicator_ae E] with t ht he
    rw [ht]
    change b * H.realization.repr (H.indicator E) t = _
    rw [he]
    by_cases h : t ∈ E.1 <;> simp [h]
  apply le_antisymm
  · refine (H.norm_iff _ (b/k) hc).mpr ?_
    have he : expModular (H.realization.repr (b • H.indicator E)) (b/k) =
        m * exponentialYoung k := by
      unfold expModular
      calc
        _ = ∫ t, E.1.indicator (fun _ => exponentialYoung k) t ∂lebesgueUnitInterval := by
          apply integral_congr_ae
          filter_upwards [hr] with t ht
          rw [ht]
          by_cases h : t ∈ E.1
          · rw [indicator_of_mem h,indicator_of_mem h,abs_of_pos hb,show b/(b/k)=k by field_simp]
          · rw [indicator_of_notMem h,indicator_of_notMem h,abs_zero,zero_div,exponentialYoung_zero]
        _ = _ := by rw [integral_indicator E.2,setIntegral_const,smul_eq_mul]
    rw [he]
    change m * (Real.exp (k ^ 2) - 1) ≤ 1
    rw [show k ^ 2 = Real.log (1+1/m) from Real.sq_sqrt (Real.log_nonneg (by linarith [one_div_pos.mpr hm])),
      Real.exp_log (by positivity : 0 < 1 + 1/m)]
    rw [add_sub_cancel_left, one_div, mul_inv_cancel₀ hm.ne']
  · exact H.norm_lower_on_set _ E b hb hm (hr.mono fun t ht h => by
      rw [ht,indicator_of_mem h,abs_of_pos hb])

end ExponentialHeartModel

#print axioms ExponentialHeartModel.norm_lower_on_set
#print axioms ExponentialHeartModel.norm_smul_indicator

end SectionSevenOrliczEstimates

end Paper


namespace Paper

noncomputable section SectionSevenOrliczBlocks

open MeasureTheory Set Filter
open scoped ENNReal Topology

def expBlockSize (n : ℕ) : ℝ := Real.exp (-((n : ℝ) + 1) ^ 2)

def expBlockEndpoint (n : ℕ) : ℝ := ∑ i ∈ Finset.range n, expBlockSize i

private theorem exp_three_quarters_ge_two : (2 : ℝ) ≤ Real.exp (3/4) := by
  have h := Real.sum_le_exp_of_nonneg (show (0 : ℝ) ≤ 3/4 by norm_num) 3
  norm_num [Finset.sum_range_succ] at h
  linarith

private theorem exponential_block_bound (n : ℕ) :
    Real.exp (-(3/4 : ℝ) * ((n : ℝ) + 1)^2) ≤ (1/2 : ℝ)^(n+1) := by
  have hi : (1 : ℝ) ≤ (n : ℝ) + 1 := le_add_of_nonneg_left (Nat.cast_nonneg n)
  have hsq : (n : ℝ) + 1 ≤ ((n : ℝ) + 1)^2 := by
    have h := mul_le_mul_of_nonneg_right hi (show 0 ≤ (n : ℝ)+1 by positivity)
    nlinarith
  calc
    _ ≤ Real.exp (-(3/4 : ℝ) * ((n : ℝ) + 1)) := Real.exp_le_exp.mpr (by linarith)
    _ = (Real.exp (-(3/4 : ℝ)))^(n+1) := by
      rw [← Real.exp_nat_mul]
      push_cast
      congr 1
      ring
    _ ≤ _ := by
      apply pow_le_pow_left₀ (Real.exp_pos _).le _ (n+1)
      rw [show -(3/4 : ℝ) = -((3:ℝ)/4) by ring, Real.exp_neg]
      rw [← one_div]
      exact one_div_le_one_div_of_le (by norm_num) exp_three_quarters_ge_two

private theorem half_power_sum (N : ℕ) :
    (∑ n ∈ Finset.range N, (1/2 : ℝ)^(n+1)) = 1 - (1/2 : ℝ)^N := by
  induction N with
  | zero => simp
  | succ N ih =>
    rw [Finset.sum_range_succ,ih,pow_succ]
    ring

private theorem expBlockEndpoint_succ (n : ℕ) :
    expBlockEndpoint (n+1) = expBlockEndpoint n + expBlockSize n := Finset.sum_range_succ _ _

private theorem expBlockEndpoint_mono : Monotone expBlockEndpoint := by
  apply monotone_nat_of_le_succ
  intro n
  rw [expBlockEndpoint_succ]
  exact le_add_of_nonneg_right (Real.exp_pos _).le

private theorem expBlockEndpoint_lt_one (n : ℕ) : expBlockEndpoint n < 1 := by
  refine lt_of_le_of_lt (b := ∑ i ∈ Finset.range n, (1/2 : ℝ)^(i+1))
    (Finset.sum_le_sum fun i _ => ?_) ?_
  · calc
      expBlockSize i ≤ Real.exp (-(3/4 : ℝ) * ((i : ℝ)+1)^2) :=
        Real.exp_le_exp.mpr (by nlinarith [sq_nonneg ((i:ℝ)+1)])
      _ ≤ _ := exponential_block_bound i
  · rw [half_power_sum]
    exact sub_lt_self _ (by positivity)

def exponentialBlock (n : ℕ) : MeasSet ℝ :=
  ⟨Ioc (expBlockEndpoint n) (expBlockEndpoint (n+1)), measurableSet_Ioc⟩

theorem exponentialBlock_disjoint : MeasSet.DisjointSeq exponentialBlock := by
  intro i j hij
  rw [Set.disjoint_left]
  intro t hi hj
  rcases lt_or_gt_of_ne hij with hij | hji
  · exact (not_lt_of_ge (hi.2.trans (expBlockEndpoint_mono hij))) hj.1
  · exact (not_lt_of_ge (hj.2.trans (expBlockEndpoint_mono hji))) hi.1

theorem exponentialBlock_measure (n : ℕ) :
    lebesgueUnitInterval.real (exponentialBlock n).1 = expBlockSize n := by
  let a := expBlockEndpoint n
  let b := expBlockEndpoint (n+1)
  have hsub : Ioc a b ⊆ Icc (0:ℝ) 1 := by
    intro t ht
    exact ⟨(Finset.sum_nonneg fun i hi => (Real.exp_pos _).le).trans ht.1.le,
      ht.2.trans (expBlockEndpoint_lt_one (n+1)).le⟩
  change (lebesgueUnitInterval (Ioc a b)).toReal = _
  rw [lebesgueUnitInterval, Measure.restrict_apply measurableSet_Ioc, inter_eq_left.mpr hsub, Real.volume_Ioc]
  have hd : b - a = expBlockSize n := by change expBlockEndpoint (n+1) - expBlockEndpoint n = _; rw [expBlockEndpoint_succ]; ring
  rw [hd]
  exact ENNReal.toReal_ofReal (Real.exp_pos _).le

namespace ExponentialHeartModel
variable {G : Type} [NormedAddCommGroup G] [NormedSpace ℝ G]
variable (H : ExponentialHeartModel G)

def blockVector (H : ExponentialHeartModel G) (n : ℕ) : G :=
  ((n : ℝ) + 1) • H.indicator (exponentialBlock n)

theorem block_norm (n : ℕ) :
    ‖H.blockVector n‖ = ((n : ℝ)+1) / Real.sqrt (Real.log (1 + Real.exp (((n : ℝ)+1)^2))) := by
  rw [blockVector, H.norm_smul_indicator _ _ (by positivity) (by
    rw [exponentialBlock_measure]; exact Real.exp_pos _),exponentialBlock_measure,expBlockSize,
    Real.exp_neg,one_div,inv_inv]

theorem block_modular_sum (N : ℕ) :
    expModular (H.realization.repr (∑ n ∈ Finset.range N, H.blockVector n)) 2 =
      ∑ n ∈ Finset.range N, expBlockSize n * (Real.exp (((n : ℝ)+1)^2/4)-1) := by
  classical
  let a (n : ℕ) := (exponentialBlock n).1
  let d (n : ℕ) := (n : ℝ)+1
  let q (n : ℕ) := (a n).indicator (fun _ => Real.exp ((d n)^2/4)-1)
  have hq (n : ℕ) : Integrable (q n) lebesgueUnitInterval :=
    (integrable_const _).indicator (exponentialBlock n).2
  have hr := H.repr_sum_indicators exponentialBlock d (Finset.range N)
  unfold expModular
  calc
    _ = ∫ t, ∑ n ∈ Finset.range N, q n t ∂lebesgueUnitInterval := by
      apply integral_congr_ae
      filter_upwards [hr] with t ht
      change exponentialYoung (|H.realization.repr (∑ n ∈ Finset.range N, d n • H.indicator (exponentialBlock n)) t| / 2) = _
      rw [ht]
      by_cases h : ∃ n ∈ Finset.range N, t ∈ a n
      · obtain ⟨n, hn, htn⟩ := h
        have hzero (i : ℕ) (hi : i ≠ n) : t ∉ a i :=
          fun H => (Set.disjoint_left.mp (exponentialBlock_disjoint hi)) H htn
        rw [Finset.sum_eq_single_of_mem n hn (fun i _ hi => indicator_of_notMem (hzero i hi) _),
          Finset.sum_eq_single_of_mem n hn (fun i _ hi => indicator_of_notMem (hzero i hi) _),
          indicator_of_mem htn]
        change exponentialYoung (|d n| / 2) = (a n).indicator _ t
        rw [indicator_of_mem htn, abs_of_pos (show 0 < d n by dsimp [d]; positivity),exponentialYoung]
        congr 2
        ring
      · rw [Finset.sum_eq_zero (fun n hn => indicator_of_notMem (fun ht => h ⟨n,hn,ht⟩) _),
          Finset.sum_eq_zero (fun n hn => indicator_of_notMem (fun ht => h ⟨n,hn,ht⟩) _),
          abs_zero,zero_div,exponentialYoung_zero]
    _ = _ := by
      rw [integral_finsetSum _ (fun n _ => hq n)]
      apply Finset.sum_congr rfl
      intro n _
      unfold q
      rw [integral_indicator (exponentialBlock n).2, setIntegral_const,smul_eq_mul,exponentialBlock_measure]

theorem block_modular_lt_one (N : ℕ) :
    expModular (H.realization.repr (∑ n ∈ Finset.range N, H.blockVector n)) 2 < 1 := by
  rw [H.block_modular_sum]
  refine lt_of_le_of_lt (b := ∑ i ∈ Finset.range N, (1/2 : ℝ)^(i+1))
    (Finset.sum_le_sum fun i _ => ?_) ?_
  · calc
      _ ≤ expBlockSize i * Real.exp (((i : ℝ)+1)^2/4) :=
        mul_le_mul_of_nonneg_left (sub_le_self _ zero_le_one) (Real.exp_pos _).le
      _ = Real.exp (-(3/4 : ℝ) * ((i : ℝ)+1)^2) := by rw [expBlockSize,← Real.exp_add]; congr 1; ring
      _ ≤ _ := exponential_block_bound i
  · rw [half_power_sum]
    exact sub_lt_self _ (by positivity)

theorem block_norm_lower (n : ℕ) : (1/2 : ℝ) ≤ ‖H.blockVector n‖ := by
  rw [H.block_norm]
  let t := (n:ℝ)+1
  have ht : 1 ≤ t := by dsimp [t]; exact le_add_of_nonneg_left (Nat.cast_nonneg n)
  have ht₂ : 1 ≤ t^2 := by nlinarith [mul_self_le_mul_self (show (0:ℝ)≤1 by norm_num) ht]
  have hp : 0 < Real.log (1 + Real.exp (t^2)) := Real.log_pos (by linarith [Real.exp_pos (t^2)])
  have hlog : Real.log (1 + Real.exp (t^2)) ≤ (2*t)^2 := by
    have hl : 1 + Real.exp (t^2) ≤ Real.exp (t^2) * Real.exp (t^2) := by
      have h := Real.add_one_le_exp (t^2)
      nlinarith [sq_nonneg (Real.exp (t^2)-2)]
    have hh := Real.log_le_log (show 0 < 1 + Real.exp (t ^ 2) by positivity) hl
    rw [← Real.exp_add,Real.log_exp] at hh
    nlinarith
  have hr := Real.sqrt_le_sqrt hlog
  rw [Real.sqrt_sq (show 0 ≤ 2*t by positivity)] at hr
  exact (le_div_iff₀ (Real.sqrt_pos.2 hp)).mpr (by linarith)

theorem not_boundedlyComplete (H : ExponentialHeartModel G) :
    ¬ H.P.BoundedlyComplete := by
  intro h
  have hfix (n : ℕ) : H.P.val (exponentialBlock n) (H.blockVector n) = H.blockVector n := by
    rw [blockVector, map_smul, H.indicator_eq_cut]
    congr 1
    have h := congrArg (fun L : G →L[ℝ] G => L H.one) (H.P.mul_eq (exponentialBlock n) (exponentialBlock n))
    have he : (exponentialBlock n).inter (exponentialBlock n) = exponentialBlock n :=
      Subtype.ext (Set.inter_self _)
    rwa [he] at h
  obtain ⟨z,hz⟩ := h exponentialBlock H.blockVector exponentialBlock_disjoint hfix
    ⟨2, fun N => (H.norm_iff _ 2 (by norm_num)).mpr (H.block_modular_lt_one N).le⟩
  have hs := (hz.comp (tendsto_add_atTop_nat 1)).sub hz
  have hv : Tendsto H.blockVector atTop (𝓝 0) := by
    rw [sub_self] at hs
    apply hs.congr'
    filter_upwards with n
    simp [Finset.sum_range_succ]
  have hn := hv.norm
  have he := ((tendsto_order.mp hn).2 (1/2) (by norm_num)).exists
  obtain ⟨n,hn⟩ := he
  exact (not_lt_of_ge (H.block_norm_lower n)) hn

end ExponentialHeartModel

#print axioms exponentialBlock_measure
#print axioms ExponentialHeartModel.block_norm
#print axioms ExponentialHeartModel.block_modular_lt_one
#print axioms ExponentialHeartModel.not_boundedlyComplete

end SectionSevenOrliczBlocks
