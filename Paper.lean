namespace Paper

noncomputable section SectionSevenNativeSequences

open Set Filter
open scoped ENNReal Topology

variable {Y : Type} [NormedAddCommGroup Y] [NormedSpace ℝ Y]

abbrev VectorCZero (Y : Type) [NormedAddCommGroup Y] := ZeroAtInftyContinuousMap ℕ Y
abbrev VectorLp (Y : Type) [NormedAddCommGroup Y] (p : ℝ≥0∞) := lp (fun _ : ℕ => Y) p

omit [NormedSpace ℝ Y] in
private theorem vectorCZero_norm_le (x : VectorCZero Y) {c : ℝ} (hc : 0 ≤ c)
    (h : ∀ n, ‖x n‖ ≤ c) : ‖x‖ ≤ c :=
  (BoundedContinuousFunction.norm_le (f := x.toBCF) hc).mpr h

def vectorCZeroEval (j : ℕ) : VectorCZero Y →L[ℝ] Y :=
  LinearMap.mkContinuous
    { toFun := fun x => x j, map_add' := fun _ _ => rfl, map_smul' := fun _ _ => rfl } 1
    (fun x => by
      change ‖x j‖ ≤ 1 * ‖x‖
      rw [one_mul]
      exact x.toBCF.norm_coe_le_norm j)

private theorem vectorCZeroEval_apply (j : ℕ) (x : VectorCZero Y) :
    vectorCZeroEval j x = x j := rfl

def vectorCZeroSingle (n : ℕ) (y : Y) : VectorCZero Y where
  toContinuousMap := ⟨fun j => if j = n then y else 0, continuous_of_discreteTopology⟩
  zero_at_infty' := by
    rw [cocompact_eq_atTop]
    apply tendsto_const_nhds.congr'
    filter_upwards [eventually_ge_atTop (n+1)] with j hj
    have h : j ≠ n := by omega
    exact (ite_eq_right h).symm

omit [NormedSpace ℝ Y] in
private theorem vectorCZeroSingle_apply (n j : ℕ) (y : Y) :
    vectorCZeroSingle n y j = if j = n then y else 0 := rfl

omit [NormedSpace ℝ Y] in
private theorem vectorCZeroSingle_norm (n : ℕ) (y : Y) :
    ‖vectorCZeroSingle n y‖ = ‖y‖ := by
  apply le_antisymm (vectorCZero_norm_le _ (norm_nonneg _) (fun j => by
    rw [vectorCZeroSingle_apply]
    split <;> simp [norm_nonneg]))
  have h : ‖vectorCZeroSingle n y n‖ ≤ ‖vectorCZeroSingle n y‖ :=
    (vectorCZeroSingle n y).toBCF.norm_coe_le_norm n
  rw [vectorCZeroSingle_apply, ite_eq_left rfl] at h
  exact h

def vectorCZeroInsert (n : ℕ) : Y →L[ℝ] VectorCZero Y :=
  LinearMap.mkContinuous
    { toFun := vectorCZeroSingle n
      map_add' := fun x y => by
        ext j
        change vectorCZeroSingle n (x + y) j = vectorCZeroSingle n x j + vectorCZeroSingle n y j
        simp only [vectorCZeroSingle_apply]
        split <;> simp
      map_smul' := fun c y => by
        ext j
        change vectorCZeroSingle n (c • y) j = c • vectorCZeroSingle n y j
        simp only [vectorCZeroSingle_apply]
        split <;> simp } 1 (fun y => by
      change ‖vectorCZeroSingle n y‖ ≤ 1 * ‖y‖
      rw [one_mul, vectorCZeroSingle_norm])

private theorem vectorCZeroInsert_apply (n : ℕ) (y : Y) :
    vectorCZeroInsert n y = vectorCZeroSingle n y := rfl

def vectorCZeroCut (A : Set ℕ) : VectorCZero Y →L[ℝ] VectorCZero Y := by
  classical
  let C (x : VectorCZero Y) : VectorCZero Y :=
    { toContinuousMap := ⟨fun n => if n ∈ A then x n else 0, continuous_of_discreteTopology⟩
      zero_at_infty' := by
        rw [cocompact_eq_atTop, Metric.tendsto_atTop]
        intro ε hε
        have hx := zero_at_infty x
        rw [cocompact_eq_atTop, Metric.tendsto_atTop] at hx
        obtain ⟨k,hk⟩ := hx ε hε
        refine ⟨k,fun n hn => ?_⟩
        by_cases h : n ∈ A
        · exact (ite_eq_left h).symm ▸ hk n hn
        · simpa [h] using hε }
  refine LinearMap.mkContinuous
    { toFun := C
      map_add' := fun x y => by
        ext n
        change (if n ∈ A then x n + y n else 0) =
          (if n ∈ A then x n else 0) + (if n ∈ A then y n else 0)
        split <;> simp_all
      map_smul' := fun c x => by
        ext n
        change (if n ∈ A then c • x n else 0) = c • (if n ∈ A then x n else 0)
        split <;> simp_all } 1 ?_
  intro x
  rw [one_mul]
  refine vectorCZero_norm_le _ (norm_nonneg _) fun n => ?_
  change ‖if n ∈ A then x n else 0‖ ≤ ‖x‖
  by_cases h : n ∈ A
  · rw [ite_eq_left h]
    exact x.toBCF.norm_coe_le_norm n
  · simp [h]

theorem vectorCZeroCut_apply (A : Set ℕ) (x : VectorCZero Y) (n : ℕ) :
    vectorCZeroCut A x n = (by classical exact if n ∈ A then x n else 0) := rfl

def vectorCZeroCoordinates : SequenceCoordinates (VectorCZero Y) Y where
  eval := vectorCZeroEval
  separates := fun x y h => ZeroAtInftyContinuousMap.ext fun n => h n
  single := vectorCZeroInsert
  single_eval := fun n j y => by
    rw [vectorCZeroEval_apply,vectorCZeroInsert_apply,vectorCZeroSingle_apply]
  single_norm := fun n y => by rw [vectorCZeroInsert_apply,vectorCZeroSingle_norm]
  cut := vectorCZeroCut
  cut_eval := fun A n x => by rw [vectorCZeroEval_apply,vectorCZeroEval_apply,vectorCZeroCut_apply]
  cut_norm := fun A x => by
    classical
    refine vectorCZero_norm_le _ (norm_nonneg _) fun n => ?_
    rw [vectorCZeroCut_apply]
    by_cases h : n ∈ A
    · rw [ite_eq_left h]
      exact x.toBCF.norm_coe_le_norm n
    · simp [h]
  tail_small := fun x ε hε => by
    have h := zero_at_infty x
    rw [cocompact_eq_atTop, Metric.tendsto_atTop] at h
    obtain ⟨k,hk⟩ := h (ε/2) (by positivity)
    refine ⟨k, lt_of_le_of_lt (b := ε/2) (vectorCZero_norm_le _ (by positivity) fun n => ?_) (by linarith)⟩
    rw [vectorCZeroCut_apply]
    by_cases h : n ∈ Ici k
    · rw [ite_eq_left h]
      simpa only [dist_zero_right] using (hk n h).le
    · simp only [ite_eq_right h,norm_zero]
      positivity

variable {p : ℝ≥0∞} [Fact (1 ≤ p)]

def vectorLpEval (j : ℕ) : VectorLp Y p →L[ℝ] Y :=
  let L : VectorLp Y p →ₗ[ℝ] Y :=
    { toFun := fun x => x j
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  L.mkContinuous 1
    (fun x => by
      change ‖x j‖ ≤ 1 * ‖x‖
      rw [one_mul]
      exact lp.norm_apply_le_norm ((zero_lt_one.trans_le (Fact.out : 1 ≤ p)).ne') x j)

private theorem vectorLpEval_apply (j : ℕ) (x : VectorLp Y p) :
    vectorLpEval j x = x j := rfl

def vectorLpCut (A : Set ℕ) : VectorLp Y p →L[ℝ] VectorLp Y p := by
  classical
  let C (x : VectorLp Y p) : VectorLp Y p :=
    ⟨fun n => if n ∈ A then x n else 0,
      (lp.memℓp x).mono' (fun n => by by_cases hn : n ∈ A <;> simp [hn])⟩
  refine LinearMap.mkContinuous
    { toFun := C
      map_add' := fun x y => by
        apply Subtype.ext
        funext n
        change (if n ∈ A then x n + y n else 0) =
          (if n ∈ A then x n else 0) + (if n ∈ A then y n else 0)
        by_cases h : n ∈ A <;> simp [h]
      map_smul' := fun c x => by
        apply Subtype.ext
        funext n
        change (if n ∈ A then c • x n else 0) = c • (if n ∈ A then x n else 0)
        by_cases h : n ∈ A <;> simp [h] } 1 ?_
  intro x
  rw [one_mul]
  apply lp.norm_mono ((zero_lt_one.trans_le (Fact.out : 1 ≤ p)).ne')
  intro n
  change ‖if n ∈ A then x n else 0‖ ≤ ‖x n‖
  by_cases h : n ∈ A <;> simp [h]

theorem vectorLpCut_apply (A : Set ℕ) (x : VectorLp Y p) (n : ℕ) :
    vectorLpCut A x n = (by classical exact if n ∈ A then x n else 0) := rfl

private theorem vectorLpCut_norm (A : Set ℕ) (x : VectorLp Y p) : ‖vectorLpCut A x‖ ≤ ‖x‖ := by
  apply lp.norm_mono ((zero_lt_one.trans_le (Fact.out : 1 ≤ p)).ne')
  intro n
  rw [vectorLpCut_apply]
  by_cases h : n ∈ A <;> simp [h]

def vectorLpCoordinates (hp : p ≠ ⊤) : SequenceCoordinates (VectorLp Y p) Y where
  eval := vectorLpEval
  separates := fun _ _ h => Subtype.ext (funext h)
  single := lp.singleContinuousLinearMap ℝ (fun _ : ℕ => Y) p
  single_eval := fun n j y => by
    rw [vectorLpEval_apply,lp.singleContinuousLinearMap_apply,lp.single_apply]
    by_cases h : j = n <;> simp [h]
  single_norm := fun n y => by
    rw [lp.singleContinuousLinearMap_apply,lp.norm_single (zero_lt_one.trans_le (Fact.out : 1 ≤ p))]
  cut := vectorLpCut
  cut_eval := fun A n x => by rw [vectorLpEval_apply,vectorLpEval_apply,vectorLpCut_apply]
  cut_norm := vectorLpCut_norm
  tail_small := fun x ε hε => by
    classical
    have h := (lp.hasSum_single hp x).tendsto_sum_nat
    rw [Metric.tendsto_atTop] at h
    obtain ⟨k,hk⟩ := h ε hε
    refine ⟨k, ?_⟩
    have he : vectorLpCut (Set.Ici k) x = x - ∑ n ∈ Finset.range k, lp.single p n (x n) := by
      apply Subtype.ext
      funext j
      change vectorLpCut (Set.Ici k) x j = (x - ∑ n ∈ Finset.range k, lp.single p n (x n)) j
      rw [vectorLpCut_apply,lp.coeFn_sub,lp.coeFn_sum]
      simp only [Pi.sub_apply,Finset.sum_apply]
      by_cases hj : j < k
      · rw [ite_eq_right (show j ∉ Ici k from Nat.not_le.mpr hj),Finset.sum_eq_single_of_mem j (Finset.mem_range.mpr hj)]
        · rw [lp.single_apply_self,sub_self]
        · intro n _ hn
          exact lp.single_apply_ne p n _ (Ne.symm hn)
      · rw [ite_eq_left (show j ∈ Ici k from Nat.le_of_not_gt hj),Finset.sum_eq_zero fun n hn =>
          lp.single_apply_ne p n _ (fun he => by subst n; exact hj (Finset.mem_range.mp hn)),sub_zero]
    rw [he]
    simpa only [dist_eq_norm,norm_sub_rev] using hk k le_rfl

