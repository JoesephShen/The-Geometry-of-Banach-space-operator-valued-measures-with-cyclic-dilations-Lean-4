noncomputable section SectionSevenSequenceSeparability

open Set Filter TopologicalSpace
open scoped Topology

variable {X Y : Type} [NormedAddCommGroup X] [NormedSpace ℝ X]
  [NormedAddCommGroup Y] [NormedSpace ℝ Y]

theorem SequenceCoordinates.separable (S : SequenceCoordinates X Y) [SeparableSpace Y] :
    SeparableSpace X := by
  classical
  obtain ⟨d,hd⟩ := exists_dense_seq Y
  let g (p : Σ n : ℕ, Fin n → ℕ) : X := ∑ i : Fin p.1, S.single i (d (p.2 i))
  refine ⟨Set.range g,Set.countable_range g,?_⟩
  change DenseRange g
  apply Metric.denseRange_iff.mpr
  intro x ε hε
  obtain ⟨N,hN⟩ := S.tail_small x (ε/2) (by positivity)
  let δ := (ε/2)/((N:ℝ)+1)
  have hδ : 0 < δ := by dsimp [δ]; positivity
  choose k hk using fun i : Fin N => Metric.denseRange_iff.mp hd (S.eval i x) δ hδ
  refine ⟨⟨N,k⟩,?_⟩
  let y := ∑ i : Fin N, S.single i (S.eval i x)
  have hcut : x-y = S.cut (Set.Ici N) x := by
    refine S.separates _ _ fun j => ?_
    rw [map_sub,S.cut_eval]
    simp only [y,map_sum,S.single_eval]
    by_cases hj : j < N
    · let i : Fin N := ⟨j,hj⟩
      have he : (∑ i : Fin N, if j = i then S.eval i x else 0) = S.eval j x := by
        rw [Finset.sum_eq_single i]
        · simp [i]
        · intro l _ hl
          exact ite_eq_right (fun h => hl (Fin.ext h.symm))
        · simp
      rw [he,sub_self,ite_eq_right (show j ∉ Ici N from Nat.not_le.mpr hj)]
    · have hz : (∑ i : Fin N, if j = (i:ℕ) then S.eval i x else 0) = 0 := by
        apply Finset.sum_eq_zero
        intro i _
        exact ite_eq_right (fun h : j = (i:ℕ) => hj (h.symm ▸ i.2))
      rw [hz,sub_zero,ite_eq_left (show j ∈ Ici N from Nat.le_of_not_gt hj)]
  have happrox : ‖y - g ⟨N,k⟩‖ ≤ ε/2 := by
    change ‖(∑ i : Fin N, S.single i (S.eval i x)) - ∑ i : Fin N, S.single i (d (k i))‖ ≤ _
    rw [← Finset.sum_sub_distrib]
    refine (norm_sum_le _ _).trans ?_
    have h : (∑ i : Fin N, ‖S.single i (S.eval i x) - S.single i (d (k i))‖) ≤
        ∑ _ : Fin N, δ := by
      apply Finset.sum_le_sum
      intro i _
      rw [← map_sub,S.single_norm]
      exact (by simpa only [dist_eq_norm] using (hk i).le)
    refine h.trans ?_
    simp only [Finset.sum_const,Finset.card_univ,Fintype.card_fin,nsmul_eq_mul]
    have hden : (0:ℝ) < (N:ℝ)+1 := by positivity
    dsimp [δ]
    rw [← mul_div_assoc]
    exact (div_le_iff₀ hden).mpr (by linarith [mul_nonneg (by positivity : 0 ≤ (N:ℝ)) hε.le])
  rw [dist_eq_norm]
  calc
    ‖x - g ⟨N,k⟩‖ = ‖(x-y)+(y-g ⟨N,k⟩)‖ := by congr 1; abel
    _ ≤ ‖x-y‖ + ‖y-g ⟨N,k⟩‖ := norm_add_le _ _
    _ < ε := by rw [hcut]; linarith

