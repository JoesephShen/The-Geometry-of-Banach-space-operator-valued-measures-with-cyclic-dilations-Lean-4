noncomputable section SectionSevenVectorGeometry

open MeasureTheory Set Filter
open scoped ENNReal Topology

private instance sectionSevenFactOne : Fact ((1 : ℝ≥0∞) ≤ 1) := ⟨le_rfl⟩
private instance sectionSevenFactTwo : Fact ((1 : ℝ≥0∞) ≤ 2) := ⟨by norm_num⟩

abbrev vectorOneCoordinates (Y : Type) [NormedAddCommGroup Y] [NormedSpace ℝ Y] :
    SequenceCoordinates (VectorLp Y 1) Y := vectorLpCoordinates ENNReal.one_ne_top

abbrev vectorTwoCoordinates (Y : Type) [NormedAddCommGroup Y] [NormedSpace ℝ Y] :
    SequenceCoordinates (VectorLp Y 2) Y := vectorLpCoordinates (by norm_num)

variable {X Y : Type} [NormedAddCommGroup X] [NormedSpace ℝ X]
    [NormedAddCommGroup Y] [NormedSpace ℝ Y]

theorem SequenceCoordinates.complemented (S : SequenceCoordinates X Y) : IsComplementedIn Y X := by
  refine ⟨S.single 0,S.eval 0,?_⟩
  ext y
  change S.eval 0 (S.single 0 y) = y
  rw [S.single_eval,ite_eq_left rfl]

/-- The first finite coordinate cuts send the whole bidual into the original space. -/
theorem SequenceCoordinates.finite_cut_secondAdjoint (S : SequenceCoordinates X Y) (hY : IsReflexive Y)
    (F : Finset ℕ) (ξ : Bidual X) :
    ∃ x : X, secondAdjoint (S.cut (↑F : Set ℕ)) ξ = J x := by
  classical
  have he : S.cut (↑F : Set ℕ) = ∑ n ∈ F, (S.single n).comp (S.eval n) := by
    ext x
    apply S.separates
    intro j
    rw [S.cut_eval,sum_apply,map_sum]
    simp only [ContinuousLinearMap.comp_apply,S.single_eval]
    by_cases hj : j ∈ F
    · have hj' : j ∈ (↑F : Set ℕ) := hj
      rw [ite_eq_left hj',Finset.sum_eq_single_of_mem j hj (fun n _ h => ite_eq_right (Ne.symm h)),ite_eq_left rfl]
    · have hj' : j ∉ (↑F : Set ℕ) := hj
      rw [ite_eq_right hj',Finset.sum_eq_zero fun n hn => ite_eq_right (fun (h : j = n) => hj (h.symm ▸ hn))]
  choose y hy using fun n : ℕ => hY (secondAdjoint (S.eval n) ξ)
  refine ⟨∑ n ∈ F, S.single n (y n),?_⟩
  ext f
  rw [secondAdjoint_apply,J_apply,he,map_sum]
  have hAdj : adjoint (∑ n ∈ F, (S.single n).comp (S.eval n)) f =
      ∑ n ∈ F, adjoint ((S.single n).comp (S.eval n)) f := by
    ext x
    simp [adjoint]
  -- The adjoint distributes over the finite operator sum.
  rw [hAdj,map_sum]
  apply Finset.sum_congr rfl
  intro n _
  have h := congrArg (fun η : Bidual Y => η (adjoint (S.single n) f)) (hy n)
  exact h.symm

omit [NormedAddCommGroup X] [NormedSpace ℝ X] in
theorem vectorCZero_not_boundedlyComplete [Nontrivial Y] :
    ¬ (vectorCZeroCoordinates (Y := Y)).pvm.BoundedlyComplete := by
  intro h
  let S := vectorCZeroCoordinates (Y := Y)
  obtain ⟨y,hy⟩ := exists_ne (0 : Y)
  let z (n : ℕ) := S.single n y
  have hz (n : ℕ) : S.pvm.val (MeasSet.natAtom n) (z n) = z n := by
    rw [S.singleton_factor,ContinuousLinearMap.comp_apply]
    change S.single n (S.eval n (S.single n y)) = _
    rw [S.single_eval,ite_eq_left rfl]
  have hbound (N : ℕ) : ‖∑ n ∈ Finset.range N, z n‖ ≤ ‖y‖ := by
    apply vectorCZero_norm_le _ (norm_nonneg _)
    intro j
    change ‖S.eval j (∑ n ∈ Finset.range N, z n)‖ ≤ ‖y‖
    rw [map_sum]
    simp only [z,S.single_eval]
    by_cases hj : j ∈ Finset.range N
    · rw [Finset.sum_eq_single_of_mem j hj (fun n _ hn => ite_eq_right (Ne.symm hn)),ite_eq_left rfl]
    · rw [Finset.sum_eq_zero fun n hn => ite_eq_right (fun (he : j = n) => hj (he.symm ▸ hn)),norm_zero]
      exact norm_nonneg _
  obtain ⟨x,hx⟩ := h MeasSet.natAtom z (fun _ _ hh => Set.disjoint_singleton.mpr hh) hz ⟨_,hbound⟩
  have hh := (hx.comp (tendsto_add_atTop_nat 1)).sub hx
  have ht : Tendsto z atTop (𝓝 0) := by
    rw [sub_self] at hh
    apply hh.congr'
    filter_upwards with N
    simp [Finset.sum_range_succ]
  have he : Tendsto (fun _ : ℕ => ‖y‖) atTop (𝓝 0) := by
    simpa only [z,S.single_norm,norm_zero] using ht.norm
  exact hy (norm_eq_zero.mp (tendsto_nhds_unique tendsto_const_nhds he))

/-- The standard coordinate identification c₀(Y)* = ℓ₁(Y*). -/
axiom citeLindenstraussTzafririVectorCZeroDual [CompleteSpace Y] :
    ∃ e : Dual (VectorCZero Y) ≃L[ℝ] VectorLp (Dual Y) 1,
      ∀ f n, e f n = f.comp (vectorCZeroInsert n)

omit [NormedAddCommGroup X] [NormedSpace ℝ X] in
theorem vectorCZero_shrinking [CompleteSpace Y] :
    (vectorCZeroCoordinates (Y := Y)).pvm.toOVM.Shrinking := by
  obtain ⟨e,he⟩ := citeLindenstraussTzafririVectorCZeroDual (Y := Y)
  let S := vectorCZeroCoordinates (Y := Y)
  let T := vectorOneCoordinates (Dual Y)
  have hh (A : MeasSet ℕ) (f : Dual (VectorCZero Y)) :
      e (adjoint (S.pvm.val A) f) = T.pvm.val A (e f) := by
    classical
    apply T.separates
    intro n
    change e (adjoint (S.pvm.val A) f) n = vectorLpCut A.1 (e f) n
    rw [he,vectorLpCut_apply,he]
    ext y
    change f (S.cut A.1 (S.single n y)) = ((if n ∈ A.1 then f.comp (S.single n) else 0) : Dual Y) y
    have he' : S.cut A.1 (S.single n y) = (if n ∈ A.1 then S.single n y else 0) := by
      apply S.separates
      intro j
      by_cases ht : j = n
      · subst j
        rw [S.cut_eval,S.single_eval,ite_eq_left rfl]
        by_cases hn : n ∈ A.1 <;> simp [hn,S.single_eval]
      · rw [S.cut_eval,S.single_eval,ite_eq_right ht]
        by_cases hn : n ∈ A.1 <;> simp [hn,S.single_eval,ht]
    rw [he']
    by_cases ht : n ∈ A.1 <;> simp [ht]
  intro A hA f
  have h := T.pvm.countably_additive A hA (e f)
  have h' := h.map e.symm.toContinuousLinearMap e.symm.continuous
  change HasSum (fun n => e.symm (T.pvm.val (A n) (e f)))
    (e.symm (T.pvm.val (MeasSet.iUnion A) (e f))) at h'
  simpa only [← hh,e.symm_apply_apply] using h'

#print axioms SequenceCoordinates.finite_cut_secondAdjoint
#print axioms vectorCZero_not_boundedlyComplete
#print axioms vectorCZero_shrinking

end SectionSevenVectorGeometry
