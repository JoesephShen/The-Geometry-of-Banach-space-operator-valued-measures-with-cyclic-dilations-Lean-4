theorem localAffineToGlobal_isometric_one (hd : 1 ≤ d) (ρ : BarronControl d)
    (hρ : Measure.map (reflection d) ρ.1 = ρ.1)
    (z : BarronLocalAffineQuotient hd ρ (p := 1) ENNReal.one_ne_top) :
    ‖localAffineToGlobal hd ρ ENNReal.one_ne_top z‖ = ‖z‖ := by
  let Q := barronStage hd ρ 1 ENNReal.one_ne_top
  let W := foldStage hd ρ (p := 1) ENNReal.one_ne_top
  obtain ⟨y, rfl⟩ := W.ker.mkQ_surjective z
  let γ := evenPart hd (Q.inclusion y)
  let g := W y
  let a := hyperplaneLiftCoefficient hd g
  let μ := densityMap a
  obtain ⟨he, hn⟩ := hyperplaneLift_density_even hd hρ g
  have hEq : μ = γ := by
    have hE' : pushforward (reflection d) γ = γ := reflectedEven_even _
    have hN' : cut (nonPole d) γ = γ := reflectedEven_supported _
    have hSub := evenMeasure_determined_by_fold hd (μ - γ) (by
      change (pushforward (reflection d)).toLinearMap (μ - γ) = _
      rw [map_sub]
      exact congrArg₂ (· - ·) he hE') (by
      change (cut (nonPole d)).toLinearMap (μ - γ) = _
      rw [map_sub]
      exact congrArg₂ (· - ·) hn hN') (fun E => by
      change (eval (foldPreimage hd E)).toLinearMap (μ - γ) = _
      rw [map_sub]
      apply sub_eq_zero.mpr
      change eval (foldPreimage hd E) (densityMap a) = eval (foldPreimage hd E) γ
      rw [eval_densityMap]
      exact (hyperplaneLiftCoefficient_integral hd g E).symm.trans (foldStage_is_pushed_even_density hd ρ
        ENNReal.one_ne_top y E))
    exact sub_eq_zero.mp hSub
  let v : BarronLocalAffineQuotient hd ρ ENNReal.one_ne_top := W.ker.mkQL y
  let F := quotientFoldStage hd ρ (p := 1) ENNReal.one_ne_top
  let e := localAffineToGlobal hd ρ (p := 1) ENNReal.one_ne_top
  have hg : ‖F v‖ = ‖v‖ := (quotientFoldStage_isometry_onto hd ρ ENNReal.one_ne_top).1 v
  have hF : F v = g := rfl
  have hγ : ‖γ‖ = ‖e v‖ := by
    change ‖quotientEvenPart hd (Submodule.Quotient.mk (Q.inclusion y))‖ =
      ‖(Submodule.Quotient.mk (Q.inclusion y) : BarronAffineQuotient hd)‖
    exact quotientEvenPart_norm hd (Submodule.Quotient.mk (Q.inclusion y))
  change ‖e v‖ = ‖v‖
  calc
    ‖e v‖ = ‖γ‖ := hγ.symm
    _ = ‖μ‖ := congrArg norm hEq.symm
    _ = ‖a‖ := densityMap_norm_one a
    _ = ‖g‖ := hyperplaneLiftCoefficient_norm hd g
    _ = ‖F v‖ := congrArg norm hF.symm
    _ = ‖v‖ := hg

