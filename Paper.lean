noncomputable section SectionSevenFrameObstructions

open MeasureTheory Set Filter
open scoped Topology

def IsComplementedIn (X Z : Type*) [NormedAddCommGroup X] [NormedSpace ℝ X]
    [NormedAddCommGroup Z] [NormedSpace ℝ Z] : Prop :=
  ∃ (i : X →L[ℝ] Z) (r : Z →L[ℝ] X), r.comp i = ContinuousLinearMap.id ℝ X

def HasUnconditionalBasis (Z : Type*) [NormedAddCommGroup Z] [NormedSpace ℝ Z] : Prop :=
  ∃ (u : ℕ → Z) (g : ℕ → Dual Z),
    (∀ i j, g i (u j) = if i = j then 1 else 0) ∧ IsUnconditionalSchauderFrame u g

/-- Han–Larson–Liu–Liu, Proposition 1.6. -/
axiom citeHanLarsonLiuLiuUnconditionalBasis {X : Type} [NormedAddCommGroup X]
    [NormedSpace ℝ X] [CompleteSpace X] {u : ℕ → X} {g : ℕ → Dual X} :
    IsUnconditionalSchauderFrame u g →
      ∃ (Z : Type) (_ : NormedAddCommGroup Z) (_ : NormedSpace ℝ Z) (_ : CompleteSpace Z),
        HasUnconditionalBasis Z ∧ IsComplementedIn X Z

theorem no_continuousFrame_of_no_unconditional {X Ω : Type*} [NormedAddCommGroup X]
    [NormedSpace ℝ X] [CompleteSpace X] [TopologicalSpace.SeparableSpace X]
    [MeasurableSpace Ω] (ρ : Measure Ω) [SigmaFinite ρ]
    (h : ¬ ∃ (u : ℕ → X) (g : ℕ → Dual X), IsUnconditionalSchauderFrame u g) :
    ¬ Nonempty (ContinuousSchauderFrame (X := X) ρ) := by
  intro ⟨F⟩
  exact h F.exists_unconditionalSchauderFrame

end SectionSevenFrameObstructions

