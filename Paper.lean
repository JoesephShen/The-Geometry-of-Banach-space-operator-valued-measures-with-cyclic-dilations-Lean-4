/-- An orbit span contained in a closed invariant subspace can be generated
inside that subspace. -/
theorem PVM.cyclicSubspace_le_of_mem (P : PVM Ω X) (x : X) (Y : Submodule ℝ X)
    (hY : IsClosed (Y : Set X)) (hi : P.Invariant Y) (hx : x ∈ Y) :
    P.cyclicSubspace x ≤ Y := by
  apply closure_minimal _ hY
  exact Submodule.span_le.mpr (by rintro _ ⟨E, rfl⟩; exact hi E x hx)

/-- Manuscript, prop:cyclic-inductive. The hypothesis implies countable
directedness of the family of cyclic subspaces. -/
theorem PVM.cyclicSubspaces_countablyDirected (P : PVM Ω X)
    (h : ∀ s : Set X, s.Countable → ∃ u, s ⊆ P.cyclicSubspace u)
    (x : ℕ → X) : ∃ v, ∀ n, P.cyclicSubspace (x n) ≤ P.cyclicSubspace v := by
  obtain ⟨v, hv⟩ := h (Set.range x) (Set.countable_range x)
  exact ⟨v, fun n => P.cyclicSubspace_le_of_mem (x n) _
    (Submodule.isClosed_topologicalClosure _) (P.cyclicSubspace_invariant v)
    (hv (Set.mem_range_self n))⟩

/-- Manuscript, prop:cyclic-inductive. The norm topology is final for
the cyclic inclusions under the countable absorption hypothesis. -/
theorem PVM.continuous_iff_on_cyclicSubspaces (P : PVM Ω X)
    (h : ∀ s : Set X, s.Countable → ∃ u, s ⊆ P.cyclicSubspace u)
    {W : Type*} [TopologicalSpace W] (f : X → W) :
    Continuous f ↔ ∀ u, Continuous (fun x : P.cyclicSubspace u => f x) := by
  constructor
  · intro hf u
    exact hf.comp continuous_subtype_val
  · intro hf
    apply continuous_iff_seqContinuous.mpr
    intro x a hx
    obtain ⟨u, hu⟩ := h (insert a (Set.range x)) ((Set.countable_range x).insert a)
    let y (n : ℕ) : P.cyclicSubspace u := ⟨x n, hu (Or.inr (Set.mem_range_self n))⟩
    let b : P.cyclicSubspace u := ⟨a, hu (Set.mem_insert _ _)⟩
    have hy : Tendsto y atTop (𝓝 b) := tendsto_subtype_rng.mpr hx
    exact ((hf u).tendsto b).comp hy

