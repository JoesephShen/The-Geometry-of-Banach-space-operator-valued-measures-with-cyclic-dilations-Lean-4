/-- The obstruction argument in Theorem 3.4 (1) through nonreflexive
weakly sequentially complete subspaces. -/
theorem PVM.reflexive_weaklySeqComplete_subspace_of_shrinking (P : PVM Ω X)
    (hloc : P.Localizes) (hshr : P.toOVM.Shrinking) (Y : Submodule ℝ X)
    (hY : IsClosed (Y : Set X)) (hwsc : WeaklySeqComplete Y) : IsReflexive Y := by
  intro η
  have hB : BaireOne (secondAdjoint Y.subtypeL η) :=
    (P.normal_iff_baireOne hloc _).mp (P.toOVM.normal_of_shrinking hshr _)
  have hη : η ∈ {η : Bidual Y | BaireOne η} := (baireOne_subspace_iff Y hY η).mp hB
  rw [weaklySeqComplete_iff_baireOne.mp hwsc] at hη
  exact hη

/-- The corresponding obstruction argument for the compression of a
localized dilation. -/
theorem Dilation.reflexive_weaklySeqComplete_subspace_of_shrinking [CompleteSpace X] [CompleteSpace Z]
    {μ : OVM Ω X} (D : Dilation μ Z) (hloc : D.P.Localizes) (hshr : μ.Shrinking)
    (Y : Submodule ℝ X) (hY : IsClosed (Y : Set X)) (hwsc : WeaklySeqComplete Y) : IsReflexive Y := by
  intro η
  have hB : BaireOne (secondAdjoint Y.subtypeL η) :=
    (D.normal_iff_baireOne hloc _).mp (μ.normal_of_shrinking hshr _)
  have hη : η ∈ {η : Bidual Y | BaireOne η} := (baireOne_subspace_iff Y hY η).mp hB
  rw [weaklySeqComplete_iff_baireOne.mp hwsc] at hη
  exact hη

