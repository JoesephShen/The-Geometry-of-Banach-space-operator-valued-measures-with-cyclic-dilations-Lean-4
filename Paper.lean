theorem PVM.finitelyGenerated_of_cyclic (P : PVM Ω X) (hP : P.Cyclic) :
    P.FinitelyGenerated := by
  obtain ⟨u, hu⟩ := hP
  exact ⟨1, fun _ => u, hu.mono (Submodule.span_mono (by
    rintro _ ⟨E, rfl⟩
    exact ⟨0, E, rfl⟩))⟩

/-- Manuscript, prop:normal-coverage, (2) is equivalent to (3). -/
theorem PVM.localizes_iff_finitelyGenerated_coverage [CompleteSpace X] (P : PVM Ω X) :
    P.Localizes ↔
      ∀ ξ : Bidual X, P.toOVM.Normal ξ ↔
        ∃ (Y : Submodule ℝ X) (_hY : IsClosed (Y : Set X)) (hi : P.Invariant Y),
          (P.restrict Y hi).FinitelyGenerated ∧
            ∃ η : Bidual Y, (P.restrict Y hi).toOVM.Normal η ∧
              secondAdjoint Y.subtypeL η = ξ := by
  constructor
  · intro h ξ
    constructor
    · intro hξ
      obtain ⟨u, η, hη, he⟩ := P.cyclic_coverage_of_localizes h ξ hξ
      exact ⟨P.cyclicSubspace u, Submodule.isClosed_topologicalClosure _,
        P.cyclicSubspace_invariant u, PVM.finitelyGenerated_of_cyclic _
          (P.cyclic_restrict_cyclicSubspace u), η, hη, he⟩
    · rintro ⟨Y, _, hi, _, η, hη, rfl⟩
      exact (P.normal_restrict_iff Y hi η).mp hη
  · intro h ξ hξ
    obtain ⟨Y, hY, hi, hgen, η, hη, rfl⟩ := (h ξ).mp hξ
    let _ : CompleteSpace Y := hY.completeSpace_coe
    let R := P.restrict Y hi
    obtain ⟨A, hA, hcover, hx⟩ := R.localizes_of_finitelyGenerated hgen η hη
    refine ⟨A, hA, hcover, fun n => ?_⟩
    obtain ⟨x, hxn⟩ := hx n
    refine ⟨(x : X), fun f => ?_⟩
    have he : secondAdjoint (R.val (A n)) η = J x := by ext g; exact hxn g
    have he' : secondAdjoint (P.val (A n)) (secondAdjoint Y.subtypeL η) = J (x : X) := by
      rw [← R.cut_intertwining P Y.subtypeL (P.restrict_intertwines Y hi),
        he, secondAdjoint_canonical]
      rfl
    exact congrArg (fun ζ : Bidual X => ζ f) he'

#print axioms PVM.localizes_iff_finitelyGenerated_coverage

/-- Manuscript, prop:ovm-normal. The scalar Yosida–Hewitt formula commutes
with compression by an arbitrary dilation. -/
theorem Dilation.normalProjection_compress [CompleteSpace X] [CompleteSpace Z]
    {μ : OVM Ω X} (D : Dilation μ Z) (ξ : Bidual X) :
    μ.normalProjection ξ =
      secondAdjoint D.S (D.P.toOVM.normalProjection (secondAdjoint D.T ξ)) := by
  ext f
  rw [secondAdjoint_apply, OVM.normalProjection_apply, OVM.normalProjection_apply]
  have he : μ.coefficientCharge ξ f =
      D.P.toOVM.coefficientCharge (secondAdjoint D.T ξ) (adjoint D.S f) :=
    ScalarCharge.ext_val fun E => D.coefficient E ξ f
  rw [he]

theorem Dilation.normalized_ovm {μ : OVM Ω X} (D : Dilation μ Z) : μ.Normalized := by
  unfold OVM.Normalized
  rw [← D.compress MeasSet.whole]
  have he : D.P.val MeasSet.whole = ContinuousLinearMap.id ℝ Z := D.P.normalized
  rw [he]
  exact D.split

theorem Dilation.secondAdjoint_split {μ : OVM Ω X} (D : Dilation μ Z) (ξ : Bidual X) :
    secondAdjoint D.S (secondAdjoint D.T ξ) = ξ := by
  rw [secondAdjoint_comp, D.split]
  ext f
  rfl

/-- If the dilation localizes normal vectors, then the compressed
measure has exactly the Baire-one part of the ambient bidual as its
normal part. -/
theorem Dilation.normal_iff_baireOne [CompleteSpace X] [CompleteSpace Z]
    {μ : OVM Ω X} (D : Dilation μ Z) (hD : D.P.Localizes) (ξ : Bidual X) :
    μ.Normal ξ ↔ BaireOne ξ := by
  constructor
  · intro hξ
    have he := μ.normalProjection_eq_of_normal D.normalized_ovm ξ hξ
    rw [D.normalProjection_compress] at he
    have hB := D.P.baireOne_of_localizes hD
      (D.P.normal_normalProjection (secondAdjoint D.T ξ))
    exact he ▸ BaireOne.second_adjoint hB D.S
  · intro hξ
    apply D.normal_of_analysis_normal
    exact D.P.toOVM.normal_of_baireOne _ (BaireOne.second_adjoint hξ D.T)

theorem Dilation.normalProjection_range [CompleteSpace X] [CompleteSpace Z]
    {μ : OVM Ω X} (D : Dilation μ Z) (hD : D.P.Localizes) :
    Set.range μ.normalProjection = {ξ : Bidual X | μ.Normal ξ} := by
  ext ξ
  constructor
  · rintro ⟨η, rfl⟩
    apply (D.normal_iff_baireOne hD _).mpr
    rw [D.normalProjection_compress]
    exact BaireOne.second_adjoint
      (D.P.baireOne_of_localizes hD (D.P.normal_normalProjection (secondAdjoint D.T η))) D.S
  · intro hξ
    exact ⟨ξ, μ.normalProjection_eq_of_normal D.normalized_ovm ξ hξ⟩

/-- Manuscript, rem:ovm-normal-transfer, the actual image under (S^{**}). -/
theorem Dilation.secondAdjoint_image_normal_eq_baireOne [CompleteSpace X] [CompleteSpace Z]
    {μ : OVM Ω X} (D : Dilation μ Z) (hD : D.P.Localizes) :
    secondAdjoint D.S '' {ζ : Bidual Z | D.P.toOVM.Normal ζ} = {ξ : Bidual X | BaireOne ξ} := by
  ext ξ
  constructor
  · rintro ⟨ζ, hz, rfl⟩
    exact (D.P.baireOne_of_localizes hD hz).second_adjoint D.S
  · intro hξ
    have ht : BaireOne (secondAdjoint D.T ξ) := hξ.second_adjoint D.T
    exact ⟨secondAdjoint D.T ξ, D.P.toOVM.normal_of_baireOne _ ht, D.secondAdjoint_split ξ⟩

/-- The compression is a bounded projection onto the stated normal part.
Boundedness is built into the continuous linear map `μ.normalProjection`. -/
theorem Dilation.normalProjection_idempotent [CompleteSpace X] [CompleteSpace Z]
    {μ : OVM Ω X} (D : Dilation μ Z) (hD : D.P.Localizes) (ξ : Bidual X) :
    μ.normalProjection (μ.normalProjection ξ) = μ.normalProjection ξ := by
  apply μ.normalProjection_eq_of_normal D.normalized_ovm
  have hm : μ.normalProjection ξ ∈ Set.range μ.normalProjection := ⟨ξ, rfl⟩
  rwa [D.normalProjection_range hD] at hm

