private theorem axis_injective (d : ℕ) : Function.Injective (@axis d) := by
  intro i j h
  have he := congrArg (fun z : BarronSphere d => z.weight i) h
  rw [weight_axis, weight_axis] at he
  by_contra hij
  simp [hij] at he

private theorem axisMinus_injective (d : ℕ) : Function.Injective (@axisMinus d) :=
  (reflection d).injective.comp (axis_injective d)

private theorem axis_ne_axisMinus (i j : Fin d) : axis i ≠ axisMinus j := by
  intro h
  have he := congrArg (fun z : BarronSphere d => z.weight j) h
  change (axis i).weight j = (reflection d (axis j)).weight j at he
  rw [weight_axis, weight_reflection, weight_axis] at he
  by_cases h : j = i <;> norm_num [h] at he

private theorem norm_atomicDensity_mul_le {ρ : Measure (BarronSphere d)}
    {m M v : ℝ} (hm : 0 < m) (hM : 0 ≤ M) (hv : ‖v‖ ≤ M / 2)
    (u : BarronSphere d) (hu : m ≤ (ρ {u}).toReal) :
    ‖v * atomicDensity ρ u u‖ ≤ M / (2 * m) := by
  have hpos : 0 < (ρ {u}).toReal := hm.trans_le hu
  rw [atomicDensity, indicator_of_mem (mem_singleton _), norm_mul, norm_inv, Real.norm_of_nonneg hpos.le]
  calc
    _ ≤ (M / 2) * (ρ {u}).toReal⁻¹ :=
      mul_le_mul_of_nonneg_right hv (inv_nonneg.mpr hpos.le)
    _ = (M / 2) / (ρ {u}).toReal := (div_eq_mul_inv ..).symm
    _ ≤ (M / 2) / m := div_le_div_of_nonneg_left (by positivity) hm hu
    _ = _ := by ring

private theorem norm_affineDensity_axes_le {ρ : Measure (BarronSphere d)}
    {m M : ℝ} (hm : 0 < m) (hM : 0 ≤ M)
    (hA : ∀ i : Fin d, m ≤ (ρ {axis i}).toReal ∧ m ≤ (ρ {axisMinus i}).toReal)
    (v : Fin d → ℝ) (hv : ∀ i, ‖v i‖ ≤ M / 2) (θ : BarronSphere d) :
    ‖∑ i : Fin d, v i * (atomicDensity ρ (axis i) θ - atomicDensity ρ (axisMinus i) θ)‖ ≤ M / (2 * m) := by
  classical
  have hAt (u : BarronSphere d) (h : θ ≠ u) : atomicDensity ρ u θ = 0 :=
    indicator_of_notMem (fun h' => h (Set.mem_singleton_iff.mp h')) _
  have hzero (i : Fin d) (h1 : θ ≠ axis i) (h2 : θ ≠ axisMinus i) :
      v i * (atomicDensity ρ (axis i) θ - atomicDensity ρ (axisMinus i) θ) = 0 := by
    rw [hAt _ h1, hAt _ h2, sub_zero, mul_zero]
  by_cases ha : ∃ i, θ = axis i
  · obtain ⟨i, rfl⟩ := ha
    rw [Finset.sum_eq_single i]
    · rw [hAt _ (axis_ne_axisMinus i i), sub_zero]
      exact norm_atomicDensity_mul_le hm hM (hv i) _ (hA i).1
    · intro j _ hji
      exact hzero j (fun h => hji ((axis_injective d) h).symm) (axis_ne_axisMinus i j)
    · simp
  · by_cases hb : ∃ i, θ = axisMinus i
    · obtain ⟨i, rfl⟩ := hb
      rw [Finset.sum_eq_single i]
      · rw [hAt _ (Ne.symm (axis_ne_axisMinus i i)), zero_sub, mul_neg, norm_neg]
        exact norm_atomicDensity_mul_le hm hM (hv i) _ (hA i).2
      · intro j _ hji
        exact hzero j (Ne.symm (axis_ne_axisMinus j i))
          (fun h => hji ((axisMinus_injective d) h).symm)
      · simp
    · simp_rw [hzero _ (fun h => ha ⟨_, h⟩) (fun h => hb ⟨_, h⟩), Finset.sum_const_zero, norm_zero]
      positivity

private theorem norm_affineDensity_pole_le {ρ : Measure (BarronSphere d)}
    {m M c : ℝ} (hm : 0 < m) (hM : 0 ≤ M) (hP : m ≤ (ρ {polePlus d}).toReal)
    (hc : ‖c‖ ≤ M / 2 + M * (ρ {polePlus d}).toReal) :
    ‖c * atomicDensity ρ (polePlus d) (polePlus d)‖ ≤ M / (2 * m) + M := by
  have hpos := hm.trans_le hP
  rw [atomicDensity, indicator_of_mem (mem_singleton _), norm_mul, norm_inv, Real.norm_of_nonneg hpos.le]
  calc
    _ ≤ (M / 2 + M * (ρ {polePlus d}).toReal) * (ρ {polePlus d}).toReal⁻¹ :=
      mul_le_mul_of_nonneg_right hc (inv_nonneg.mpr hpos.le)
    _ = (M / 2) / (ρ {polePlus d}).toReal + M := by field_simp
    _ ≤ (M / 2) / m + M := add_le_add_left (div_le_div_of_nonneg_left (by positivity) hm hP) _
    _ = _ := by ring

theorem canonicalDensity_bound {ρ : Measure (BarronSphere d)} [IsProbabilityMeasure ρ]
    {f : BarronSphere d → ℝ} (hf : Integrable f ρ) {k : ℝ≥0∞}
    (hkfin : k < ∞) (hk : Measure.map (reflection d) ρ ≤ k • ρ)
    {m M : ℝ} (hm : 0 < m) (hM : 0 ≤ M)
    (hA : ∀ i : Fin d, m ≤ (ρ {axis i}).toReal ∧ m ≤ (ρ {axisMinus i}).toReal)
    (hP : m ≤ (ρ {polePlus d}).toReal) (hB : ∀ᵐ θ ∂ρ, ‖f θ‖ ≤ M) :
    ∀ᵐ θ ∂ρ, ‖canonicalDensity ρ f (affineCoefficients d (ofDensity hf)) θ‖ ≤
      (((1 + k.toReal) / 2) + 1 / (2 * m)) * M := by
  let a := affineCoefficients d (ofDensity hf)
  have hA' := affineCoefficients_density_bound hf hM hB
  have hk' : 1 ≤ k.toReal := by
    have h := hk Set.univ
    change Measure.map (reflection d) ρ univ ≤ k * ρ univ at h
    rw [map_reflection_univ, measure_univ, mul_one] at h
    simpa only [ENNReal.toReal_one] using ENNReal.toReal_mono hkfin.ne h
  filter_upwards [hB, reflectedDensity_bound hkfin hk hM hB] with θ hθ hr
  change ‖canonicalDensity ρ f a θ‖ ≤ _
  simp only [canonicalDensity, Pi.add_apply, Pi.sub_apply, Pi.smul_apply, Finset.sum_apply, smul_eq_mul]
  by_cases hp : θ = polePlus d
  · subst θ
    have hn : polePlus d ∉ (nonPole d).1 := fun h => h.1 rfl
    rw [indicator_of_notMem hn, mul_zero, zero_add]
    have hz : ∀ i : Fin d, atomicDensity ρ (axis i) (polePlus d) = 0 ∧
        atomicDensity ρ (axisMinus i) (polePlus d) = 0 := fun i =>
      ⟨indicator_of_notMem (Ne.symm (axis_ne_polePlus i)) _,
        indicator_of_notMem (Ne.symm (axisMinus_ne_polePlus i)) _⟩
    simp_rw [(hz _).1, (hz _).2, sub_zero, mul_zero, Finset.sum_const_zero, zero_add]
    refine (norm_affineDensity_pole_le hm hM hP hA'.2).trans ?_
    have ht : M ≤ (1 + k.toReal) / 2 * M := by nlinarith
    rw [add_mul, one_div, ← div_eq_inv_mul]
    linarith
  · have hzero : atomicDensity ρ (polePlus d) θ = 0 := indicator_of_notMem hp _
    rw [hzero, mul_zero, add_zero]
    have hfirst : ‖(1 / 2 : ℝ) * (nonPole d).1.indicator (f + reflectedDensity ρ f) θ‖ ≤
        (1 + k.toReal) / 2 * M := by
      rw [norm_mul, show ‖(1 / 2 : ℝ)‖ = 1 / 2 by norm_num]
      by_cases ht : θ ∈ (nonPole d).1
      · rw [indicator_of_mem ht]
        change (1 / 2 : ℝ) * ‖f θ + reflectedDensity ρ f θ‖ ≤ _
        have hh := (norm_add_le (f θ) (reflectedDensity ρ f θ)).trans (add_le_add hθ hr)
        nlinarith
      · rw [indicator_of_notMem ht, norm_zero, mul_zero]
        positivity
    refine (norm_add_le ..).trans ((add_le_add hfirst
      (norm_affineDensity_axes_le hm hM hA a.1 hA'.1 θ)).trans ?_)
    exact le_of_eq (by ring)

#print axioms BarronSphere.canonicalDensity_bound


local instance : Fact (1 ≤ (⊤ : ℝ≥0∞)) := ⟨le_top⟩

private theorem probabilityLpFromTop_density {ρ : Measure (BarronSphere d)} [IsProbabilityMeasure ρ]
    (p : ℝ≥0∞) [Fact (1 ≤ p)] (a : Lp ℝ ⊤ ρ) :
    densityMap (probabilityLpFromTop p a) = densityMap a :=
  ofDensity_congr (integrable_Lp _) (integrable_Lp _) (probabilityLpFromTop_ae p a)

private theorem linfty_bound_ae {ρ : Measure (BarronSphere d)} (a : Lp ℝ ⊤ ρ) :
    ∀ᵐ θ ∂ρ, ‖a θ‖ ≤ ‖a‖ := by
  have hfin := (Lp.memLp a).eLpNorm_ne_top
  filter_upwards [ae_le_eLpNormEssSup (f := fun x => a x)] with x hx
  rw [Lp.norm_def]
  have h : ‖a x‖ₑ ≤ eLpNorm a ⊤ ρ := by
    rwa [eLpNorm_exponent_top (Lp.memLp a).aestronglyMeasurable]
  simpa only [← ofReal_norm, ENNReal.toReal_ofReal (norm_nonneg _)] using ENNReal.toReal_mono hfin h

private theorem toLinfty_norm_bound {ρ : Measure (BarronSphere d)}
    {f : BarronSphere d → ℝ} (hf : MemLp f ⊤ ρ)
    {C : ℝ} (hC : 0 ≤ C) (hbound : ∀ᵐ x ∂ρ, ‖f x‖ ≤ C) : ‖hf.toLp f‖ ≤ C := by
  rw [Lp.norm_toLp, eLpNorm_exponent_top hf.aestronglyMeasurable]
  exact (ENNReal.toReal_mono ENNReal.ofReal_ne_top (eLpNormEssSup_le_of_ae_bound hbound)).trans_eq
    (ENNReal.toReal_ofReal hC)

theorem exists_canonicalLinfty {ρ : Measure (BarronSphere d)} [IsProbabilityMeasure ρ]
    (hρ : CompatibleProbability d ρ) {k : ℝ≥0∞} (hkfin : k < ∞)
    (hk : Measure.map (reflection d) ρ ≤ k • ρ) {m : ℝ} (hm : 0 < m)
    (hA : ∀ i : Fin d, m ≤ (ρ {axis i}).toReal ∧ m ≤ (ρ {axisMinus i}).toReal)
    (hP : m ≤ (ρ {polePlus d}).toReal) :
    let D := ((1 + k.toReal) / 2) + 1 / (2 * m)
    ∃ R : Lp ℝ ⊤ ρ →L[ℝ] Lp ℝ ⊤ ρ,
      (∀ a, densityMap (R a) = canonicalProjection d (densityMap a)) ∧
      (∀ a, ‖R a‖ ≤ D * ‖a‖) := by
  let D := ((1 + k.toReal) / 2) + 1 / (2 * m)
  have hD : 0 ≤ D := by unfold D; positivity
  have hex (a : Lp ℝ ⊤ ρ) : ∃ b : Lp ℝ ⊤ ρ,
      densityMap b = canonicalProjection d (densityMap a) ∧ ‖b‖ ≤ D * ‖a‖ := by
    let f := (Lp.aestronglyMeasurable a).mk (fun θ => a θ)
    have hm' : Measurable f := (Lp.aestronglyMeasurable a).stronglyMeasurable_mk.measurable
    have hae : (fun θ => a θ) =ᵐ[ρ] f := (Lp.aestronglyMeasurable a).ae_eq_mk
    have hf : Integrable f ρ := (integrable_Lp a).congr hae
    have he : densityMap a = ofDensity hf := ofDensity_congr (integrable_Lp a) hf hae
    let c := canonicalDensity ρ f (affineCoefficients d (ofDensity hf))
    obtain ⟨hc, hR⟩ := canonicalDensity_representation hρ hm' hf
    have hn : ∀ᵐ θ ∂ρ, ‖f θ‖ ≤ ‖a‖ := by
      filter_upwards [hae, linfty_bound_ae a] with θ hh hθ
      simpa only [← hh] using hθ
    have hB : ∀ᵐ θ ∂ρ, ‖c θ‖ ≤ D * ‖a‖ := canonicalDensity_bound hf hkfin hk hm (norm_nonneg _) hA hP hn
    let hc' := memLp_top_of_bound hc.aestronglyMeasurable (D * ‖a‖) hB
    let b := hc'.toLp c
    refine ⟨b, ?_, toLinfty_norm_bound hc' (mul_nonneg hD (norm_nonneg _)) hB⟩
    rw [he, hR]
    exact ofDensity_congr (integrable_Lp b) hc (MemLp.coeFn_toLp hc')
  choose z he hn using hex
  let R : Lp ℝ ⊤ ρ →ₗ[ℝ] Lp ℝ ⊤ ρ :=
    { toFun := z
      map_add' := fun a b => by
        apply densityMap_injective (p := ⊤)
        simp only [map_add, he]
      map_smul' := fun r a => by
        apply densityMap_injective (p := ⊤)
        simp only [RingHom.id_apply, map_smul, he] }
  exact ⟨R.mkContinuous D hn, he, hn⟩

private theorem dense_probabilityLpFromTop {ρ : Measure (BarronSphere d)} [IsProbabilityMeasure ρ]
    (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≠ ⊤) :
    DenseRange (probabilityLpFromTop (σ := ρ) p) := by
  apply (Lp.simpleFunc.denseRange (E := ℝ) (μ := ρ) hp).mono
  rintro _ ⟨a, rfl⟩
  let f := Lp.simpleFunc.toSimpleFunc a
  have hf : f =ᵐ[ρ] (fun t => (a : Lp ℝ p ρ) t) := Lp.simpleFunc.toSimpleFunc_eq_toFun a
  obtain ⟨C, hC⟩ : ∃ C : ℝ, ∀ t, ‖f t‖ ≤ C := by
    have hfin : (Set.range (fun t => ‖f t‖)).Finite := by
      apply (f.finite_range.image norm).subset
      rintro _ ⟨t, rfl⟩
      exact ⟨f t, ⟨t, rfl⟩, rfl⟩
    obtain ⟨C, hc⟩ := hfin.bddAbove
    exact ⟨C, fun t => hc (Set.mem_range_self t)⟩
  let b : Lp ℝ ⊤ ρ := (memLp_top_of_bound f.measurable.aestronglyMeasurable C
    (Eventually.of_forall hC)).toLp f
  exact ⟨b, Lp.ext ((probabilityLpFromTop_ae p b).trans ((MemLp.coeFn_toLp _).trans hf))⟩

theorem exists_canonicalLp {ρ : Measure (BarronSphere d)} [IsProbabilityMeasure ρ]
    (hρ : CompatibleProbability d ρ) {k : ℝ≥0∞} (hkfin : k < ∞)
    (hk : Measure.map (reflection d) ρ ≤ k • ρ) {m : ℝ} (hm : 0 < m)
    (hA : ∀ i : Fin d, m ≤ (ρ {axis i}).toReal ∧ m ≤ (ρ {axisMinus i}).toReal)
    (hP : m ≤ (ρ {polePlus d}).toReal) (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≠ ⊤) :
    ∃ R : Lp ℝ p ρ →L[ℝ] Lp ℝ p ρ,
      (∀ a, densityMap (R a) = canonicalProjection d (densityMap a)) ∧
      ‖R‖ ≤ (1 + Real.sqrt (4 * (d : ℝ) + 1)) ^ (1 / p.toReal) *
        (((1 + k.toReal) / 2) + 1 / (2 * m)) ^ (1 - 1 / p.toReal) := by
  let D := ((1 + k.toReal) / 2) + 1 / (2 * m)
  let C := 1 + Real.sqrt (4 * (d : ℝ) + 1)
  obtain ⟨A, hAeq, hAtop⟩ := exists_canonicalLinfty hρ hkfin hk hm hA hP
  have hAone (a : Lp ℝ ⊤ ρ) :
      ‖probabilityLpFromTop 1 (A a)‖ ≤ C * ‖probabilityLpFromTop 1 a‖ := by
    rw [← densityMap_norm_one, ← densityMap_norm_one, probabilityLpFromTop_density,
      probabilityLpFromTop_density, hAeq]
    exact norm_canonicalProjection_le (densityMap a)
  obtain ⟨R, hn, hRt⟩ := citeRieszThorinProbabilityLp A C D (by unfold C; positivity)
    (by unfold D; positivity) hAone hAtop p hp
  let K : Set (Lp ℝ p ρ) := {a | densityMap (R a) = canonicalProjectionCLM d (densityMap a)}
  have hclosed : IsClosed K := isClosed_eq ((densityMap (p := p)).continuous.comp R.continuous)
    ((canonicalProjectionCLM d).continuous.comp (densityMap (p := p)).continuous)
  have hsubset : Set.range (probabilityLpFromTop (σ := ρ) p) ⊆ K := by
    rintro _ ⟨a, rfl⟩
    change densityMap (R (probabilityLpFromTop p a)) = canonicalProjection d (densityMap (probabilityLpFromTop p a))
    rw [hRt, probabilityLpFromTop_density, probabilityLpFromTop_density, hAeq]
  exact ⟨R, fun a => closure_minimal hsubset hclosed (dense_probabilityLpFromTop p hp a), hn⟩

#print axioms BarronSphere.exists_canonicalLinfty
#print axioms BarronSphere.exists_canonicalLp


/-- The actual probability family in the biased Barron example. -/
abbrev BarronControl (d : ℕ) := {ρ : Measure (BarronSphere d) // CompatibleProbability d ρ}

instance barronControl_probability (ρ : BarronControl d) : IsProbabilityMeasure ρ.1 :=
  ⟨ρ.2.1⟩

private theorem exists_atomicMassLowerBound (ρ : BarronControl d) :
    ∃ m : ℝ, 0 < m ∧
      (∀ i : Fin d, m ≤ (ρ.1 {axis i}).toReal ∧ m ≤ (ρ.1 {axisMinus i}).toReal) ∧
      m ≤ (ρ.1 {polePlus d}).toReal ∧ m ≤ (ρ.1 {poleMinus d}).toReal := by
  let B (i : Option (Fin d) × Bool) : BarronSphere d :=
    if i.2 then positiveAtom d i.1 else reflection d (positiveAtom d i.1)
  let f (i : Option (Fin d) × Bool) : ℝ := (ρ.1 {B i}).toReal
  have hp (i : Option (Fin d) × Bool) : 0 < f i := by
    apply ENNReal.toReal_pos _ (measure_ne_top ρ.1 _)
    have hPole : reflection d (polePlus d) = poleMinus d := by
      apply Subtype.ext
      exact Prod.ext (neg_zero : -(0 : Fin d → ℝ) = 0) rfl
    obtain ⟨i, j⟩ := i
    cases i with
    | none =>
      cases j
      · simpa [B, positiveAtom, hPole] using (ρ.2.2.2.2.2).ne'
      · simpa [B, positiveAtom] using (ρ.2.2.2.2.1).ne'
    | some i =>
      cases j
      · simpa [B, positiveAtom, axisMinus] using (ρ.2.2.2.1 i).2.ne'
      · simpa [B, positiveAtom] using (ρ.2.2.2.1 i).1.ne'
  let F := Finset.univ.image f
  have hF : F.Nonempty := ⟨f (none, true), Finset.mem_image_of_mem f (Finset.mem_univ _)⟩
  let m := F.min' hF
  have hm : 0 < m := by
    obtain ⟨i, _, hi⟩ := Finset.mem_image.mp (Finset.min'_mem F hF)
    change 0 < F.min' hF
    rw [← hi]
    exact hp i
  have hl (i : Option (Fin d) × Bool) : m ≤ f i :=
    Finset.min'_le F _ (Finset.mem_image_of_mem f (Finset.mem_univ i))
  have hPole : reflection d (polePlus d) = poleMinus d := by
    apply Subtype.ext
    exact Prod.ext (neg_zero : -(0 : Fin d → ℝ) = 0) rfl
  refine ⟨m, hm, fun i => ⟨?_, ?_⟩, ?_, ?_⟩
  · simpa [f, B, positiveAtom] using hl (some i, true)
  · simpa [f, B, positiveAtom, axisMinus] using hl (some i, false)
  · simpa [f, B, positiveAtom] using hl (none, true)
  · simpa [f, B, positiveAtom, hPole] using hl (none, false)

/-- The full norm estimate and density identity for every base probability. -/
theorem exists_localBarronProjection (ρ : BarronControl d)
    (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≠ ⊤) :
    ∃ R : Lp ℝ p ρ.1 →L[ℝ] Lp ℝ p ρ.1, ∀ a, densityMap (R a) = canonicalProjection d (densityMap a) := by
  obtain ⟨k, hkfin, hk⟩ := ρ.2.2.1
  obtain ⟨m, hm, hA, hP, _⟩ := exists_atomicMassLowerBound ρ
  obtain ⟨R, hR, _⟩ := exists_canonicalLp ρ.2 hkfin hk hm hA hP p hp
  exact ⟨R, hR⟩

/-- The quotient stage constructed from the concrete coefficient projection on Lp. -/
def barronStage (hd : 1 ≤ d) (ρ : BarronControl d)
    (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≠ ⊤) :
    MeasureDensityStage (restrictionPVM (BarronSphere d)) (synthesisQuotient d)
      (canonicalSection hd) (Lp ℝ p ρ.1) := by
  let P := probabilityLpPVM (ρ := ρ.1) hp
  let R := (exists_localBarronProjection ρ p hp).choose
  let H := probabilityLpPVM_cyclic (ρ := ρ.1) hp
  let one := H.choose
  have hone := H.choose_spec
  exact { density := densityMap
          density_injective := densityMap_injective
          multiplication := P
          one := one
          cyclic_one := hone
          density_cut := fun E a => densityMap_lpCut E a
          localProjection := R
          density_projection := fun a =>
            ((exists_localBarronProjection ρ p hp).choose_spec a).trans
              (canonicalSection_synthesisQuotient hd (densityMap a)).symm }

theorem barronStage_membership (hd : 1 ≤ d) (ρ : BarronControl d)
    (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≠ ⊤) (x : BarronBanach d) :
    (∃ z, (barronStage hd ρ p hp).inclusion z = x) ↔
      ∃ a : Lp ℝ p ρ.1, densityMap a = canonicalSection hd x := by
  let Q := barronStage hd ρ p hp
  constructor
  · rintro ⟨z, rfl⟩
    exact ⟨Q.analysis z, Q.density_analysis z⟩
  · rintro ⟨a, ha⟩
    refine ⟨Q.synthesis a, ?_⟩
    rw [Q.inclusion_synthesis]
    change synthesisQuotient d (densityMap a) = _
    rw [ha, synthesisQuotient_canonicalSection]

theorem barronStage_reflexive_cyclic (hd : 1 ≤ d) (ρ : BarronControl d)
    (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≠ ⊤) (h1 : 1 < p) :
    let Q := barronStage hd ρ p hp
    IsReflexive (Lp ℝ p ρ.1) ∧
      (Q.localDilation (synthesisQuotient_canonicalSection hd)).P.Cyclic :=
  ⟨citeProbabilityLpReflexive p h1 hp, (barronStage hd ρ p hp).localDilation_cyclic
    (synthesisQuotient_canonicalSection hd)⟩

theorem barronStage_connecting (hd : 1 ≤ d) (ρ ν : BarronControl d)
    (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≠ ⊤) (C : ℝ) (hC : 0 < C)
    (hρν : ρ.1 ≤ ENNReal.ofReal C • ν.1) :
    let Q := barronStage hd ρ p hp
    let Q' := barronStage hd ν p hp
    ∃ (j : Lp ℝ p ρ.1 →L[ℝ] Lp ℝ p ν.1) (hj : ∀ a, Q'.density (j a) = Q.density a),
      (∀ a, (fun θ => j a θ) =ᵐ[ν.1] fun θ => (ρ.1.rnDeriv ν.1 θ).toReal * a θ) ∧
      (∀ a, ‖j a‖ ≤ C ^ (1 - 1 / p.toReal) * ‖a‖) ∧
      (∀ a, Q.connectingMap Q' j hj (Q.synthesis a) = Q'.synthesis (j a)) ∧
      (∀ x, Q'.inclusion (Q.connectingMap Q' j hj x) = Q.inclusion x) ∧
      (∀ x, Q'.analysis (Q.connectingMap Q' j hj x) = j (Q.analysis x)) ∧
      ∀ E a, j (Q.multiplication.val E a) = Q'.multiplication.val E (j a) := by
  obtain ⟨j, hj, hre, hn⟩ := exists_density_change_map ρ.1 ν.1 p hp C hC hρν
  exact ⟨j, hj, hre, hn, (barronStage hd ρ p hp).connectingMap_diagrams (barronStage hd ν p hp) j hj⟩

#print axioms BarronSphere.barronStage_membership
#print axioms BarronSphere.barronStage_reflexive_cyclic
#print axioms BarronSphere.barronStage_connecting


private theorem exists_compatibleControl_near {η : Measure (BarronSphere d)}
    (hη : η univ = 1) (C : ℝ) (hC : 1 < C) :
    ∃ ν : BarronControl d, η ≤ ENNReal.ofReal C • ν.1 := by
  let c := C.toNNReal
  have hcp : 0 < c := Real.toNNReal_pos.mpr (zero_lt_one.trans hC)
  have hc : 1 < c := by exact_mod_cast (show 1 < (c : ℝ) by simpa [c, Real.coe_toNNReal _ (zero_le_one.trans hC.le)] using hC)
  let a := c⁻¹
  have hap : 0 < a := inv_pos.mpr hcp
  have ha1 : a < 1 := inv_lt_one_of_one_lt₀ hc
  let ε := 1 - a
  have hε : 0 < ε := tsub_pos_of_lt ha1
  have hε₁ : ε < 1 := by
    change 1 - a < 1
    exact tsub_lt_self zero_lt_one hap
  have he : (1 - ε : NNReal) = a := by
    change 1 - (1 - a) = a
    exact tsub_tsub_cancel_of_le ha1.le
  obtain ⟨hν, hz⟩ := compatibleProbabilities_cofinal η hη ε hε hε₁
  let ν := compatibleMixture η (uniformAtomicProbability d) (↑(1 - ε : NNReal)) ((ε : ℝ≥0∞) / 2)
  refine ⟨⟨ν, hν⟩, ?_⟩
  change η ≤ (ENNReal.ofReal C) • ν
  rw [show ENNReal.ofReal C = (↑(1 - ε : NNReal) : ℝ≥0∞)⁻¹ by
    rw [he, show a = c⁻¹ from rfl, ENNReal.coe_inv hcp.ne', inv_inv]
    rfl]
  exact hz

theorem norm_synthesisQuotient_le (μ : FiniteSignedMeasure (BarronSphere d)) :
    ‖synthesisQuotient d μ‖ ≤ ‖μ‖ :=
  Submodule.Quotient.norm_mk_le (synthesisLinear d).ker μ

private theorem approximate_synthesisQuotient (z : BarronBanach d) (ε : ℝ) (hε : 0 < ε) :
    ∃ μ : FiniteSignedMeasure (BarronSphere d), synthesisQuotient d μ = z ∧ ‖μ‖ < ‖z‖ + ε :=
  Submodule.Quotient.norm_mk_lt z hε

private theorem barronStage_quotientRefinement (hd : 1 ≤ d)
    (η : Measure (BarronSphere d)) [IsProbabilityMeasure η]
    (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≠ ⊤) (C : ℝ) (hC : 1 < C)
    (Q : MeasureDensityStage (restrictionPVM (BarronSphere d)) (synthesisQuotient d)
      (canonicalSection hd) (Lp ℝ p η)) (hQ : Q.density = densityMap) :
    ∃ (ν : BarronControl d) (j : Q.Quotient →L[ℝ] (barronStage hd ν p hp).Quotient),
      (∀ z, (barronStage hd ν p hp).inclusion (j z) = Q.inclusion z) ∧
      ∀ z, ‖j z‖ ≤ C ^ (1 - 1 / p.toReal) * ‖z‖ := by
  obtain ⟨ν, hν⟩ := exists_compatibleControl_near (measure_univ (μ := η)) C hC
  let B := barronStage hd ν p hp
  obtain ⟨L, hL', _, hN⟩ := exists_density_change_map η ν.1 p hp (C := C)
    (zero_lt_one.trans hC) hν
  have hL (a : Lp ℝ p η) : B.density (L a) = Q.density a := by
    rw [hQ]
    exact hL' a
  exact ⟨ν, Q.connectingMap B L hL, (Q.connectingMap_diagrams B L hL).2.1,
    Q.norm_connectingMap_le B L hL (C ^ (1 - 1 / p.toReal)) (Real.rpow_nonneg (zero_le_one.trans hC.le) _) hN⟩

theorem barronStage_finalTopology (hd : 1 ≤ d) (p : ℝ≥0∞) [Fact (1 ≤ p)]
    (hp : p ≠ ⊤) (q : Seminorm ℝ (BarronBanach d)) :
    Continuous q ↔ ∀ ν : BarronControl d, Continuous (fun z => q ((barronStage hd ν p hp).inclusion z)) := by
  constructor
  · intro h ν
    exact h.comp (barronStage hd ν p hp).inclusion.continuous
  · intro h
    let S := synthesisQuotient d
    let T := canonicalSection hd
    have hnon : Nonempty (BarronSphere d) := ⟨polePlus d⟩
    obtain ⟨V, hV, hR, _, _, hMain⟩ := measure_inductive_dilation S T
      (synthesisQuotient_canonicalSection hd) norm_synthesisQuotient_le approximate_synthesisQuotient
    have hTopology := (hMain p hp).2.2.2
    apply (hTopology q).mpr
    intro ρ
    let Q := resolventDensityStage S T hV hR p hp ρ
    obtain ⟨ν, j, hj, _⟩ := barronStage_quotientRefinement hd _ p hp 2 (by norm_num) Q rfl
    have hcomp := (h ν).comp j.continuous
    have hf : (fun z : Q.Quotient => q ((barronStage hd ν p hp).inclusion (j z))) =
        fun z : Q.Quotient => q (Q.inclusion z) := funext fun z => congrArg q (hj z)
    rw [Function.comp_def, hf] at hcomp
    exact hcomp

#print axioms BarronSphere.barronStage_finalTopology


private theorem norm_densityMap_probability_le {ρ : Measure (BarronSphere d)} [IsProbabilityMeasure ρ]
    {p : ℝ≥0∞} [Fact (1 ≤ p)] (a : Lp ℝ p ρ) : ‖densityMap a‖ ≤ ‖a‖ := by
  rw [show ‖densityMap a‖ = ‖ofDensity (integrable_Lp a)‖ from rfl, norm_ofDensity, Lp.norm_def]
  have hf := integrable_Lp a
  have he : (eLpNorm a 1 ρ).toReal = ∫ x, ‖a x‖ ∂ρ := by
    rw [eLpNorm_one_eq_lintegral_eNorm hf.aestronglyMeasurable,
      ← ofReal_integral_norm_eq_lintegral_eNorm hf,
      ENNReal.toReal_ofReal (integral_nonneg fun _ => norm_nonneg _)]
  rw [← he]
  exact ENNReal.toReal_mono (Lp.memLp a).eLpNorm_ne_top
    (eLpNorm_le_eLpNorm_of_exponent_le (Fact.out : 1 ≤ p))

theorem barronStage_inclusion_contractive (hd : 1 ≤ d) (ν : BarronControl d)
    {p : ℝ≥0∞} [Fact (1 ≤ p)] (hp : p ≠ ⊤) (z : (barronStage hd ν p hp).Quotient) :
    ‖(barronStage hd ν p hp).inclusion z‖ ≤ ‖z‖ := by
  let Q := barronStage hd ν p hp
  refine le_of_forall_pos_le_add fun ε hε => ?_
  obtain ⟨a, ha, hn⟩ := Submodule.Quotient.norm_mk_lt z hε
  change Q.synthesis a = z at ha
  rw [← ha, Q.inclusion_synthesis]
  exact ((norm_synthesisQuotient_le _).trans (norm_densityMap_probability_le a)).trans
    (by simpa only [ha] using hn.le)

set_option maxHeartbeats 1000000 in
theorem barronStage_normRecovery (hd : 1 ≤ d) (p : ℝ≥0∞) [Fact (1 ≤ p)]
    (hp : p ≠ ⊤) (x : BarronBanach d) :
    (∃ (ν : BarronControl d) (z : (barronStage hd ν p hp).Quotient), (barronStage hd ν p hp).inclusion z = x) ∧
    ‖x‖ = sInf {r | ∃ (ν : BarronControl d) (z : (barronStage hd ν p hp).Quotient),
      (barronStage hd ν p hp).inclusion z = x ∧ ‖z‖ = r} := by
  let S := synthesisQuotient d
  let T := canonicalSection hd
  have hnon : Nonempty (BarronSphere d) := ⟨polePlus d⟩
  obtain ⟨V, hV, hR, _, _, hMain⟩ := measure_inductive_dilation S T
    (synthesisQuotient_canonicalSection hd) norm_synthesisQuotient_le approximate_synthesisQuotient
  let Q (ρ : resolventProbabilities {y | Positive y} V) := resolventDensityStage S T hV hR p hp ρ
  let A : Set ℝ := {r | ∃ (ν : BarronControl d) (z : (barronStage hd ν p hp).Quotient),
      (barronStage hd ν p hp).inclusion z = x ∧ ‖z‖ = r}
  let B : Set ℝ := {r | ∃ (ρ : resolventProbabilities {y | Positive y} V) (z : (Q ρ).Quotient),
      (Q ρ).inclusion z = x ∧ ‖z‖ = r}
  obtain ⟨⟨ρ, z, hz⟩, hnorm⟩ := (hMain p hp).2.2.1 x
  obtain ⟨ν, j, hj, _⟩ := barronStage_quotientRefinement hd _ p hp 2 (by norm_num) (Q ρ) rfl
  have hz' : (barronStage hd ν p hp).inclusion (j z) = x := (hj z).trans hz
  refine ⟨⟨ν, j z, hz'⟩, ?_⟩
  have hA : A.Nonempty := ⟨‖j z‖, ν, j z, hz', rfl⟩
  have hlower : ‖x‖ ∈ lowerBounds A := by
    rintro _ ⟨ν', z', hz', rfl⟩
    rw [← hz']
    exact barronStage_inclusion_contractive hd ν' hp z'
  apply le_antisymm (le_csInf hA hlower)
  refine le_of_forall_pos_le_add fun ε hε => ?_
  have hB : B.Nonempty := ⟨‖z‖, ρ, z, hz, rfl⟩
  have hNormB : ‖x‖ = sInf B := hnorm
  obtain ⟨r, ⟨ρ', y, hy, rfl⟩, hnear⟩ := exists_lt_of_csInf_lt hB
    (hNormB.symm ▸ lt_add_of_pos_right ‖x‖ (half_pos hε))
  let δ := ε / (2 * (‖y‖ + 1))
  have hδ : 0 < δ := div_pos hε (by positivity)
  have hsmall : δ * ‖y‖ ≤ ε / 2 := by
    have hzero : 0 < ‖y‖ + 1 := by positivity
    dsimp [δ]
    rw [div_mul_eq_mul_div, div_le_iff₀ (by positivity : 0 < 2 * (‖y‖ + 1))]
    nlinarith
  obtain ⟨ν', j', hj', hν'⟩ := barronStage_quotientRefinement hd _ p hp (1 + δ)
    (by linarith) (Q ρ') rfl
  have hmem : ‖j' y‖ ∈ A := ⟨ν', j' y, (hj' y).trans hy, rfl⟩
  have hpower : (1 + δ) ^ (1 - 1 / p.toReal) ≤ 1 + δ := by
    calc
      _ ≤ (1 + δ) ^ (1 : ℝ) := Real.rpow_le_rpow_of_exponent_le
        (le_add_of_nonneg_right hδ.le) (sub_le_self _ (one_div_nonneg.mpr ENNReal.toReal_nonneg))
      _ = _ := Real.rpow_one _
  have hjBound := (hν' y).trans (mul_le_mul_of_nonneg_right hpower (norm_nonneg _))
  rw [← hNormB] at hnear
  rw [add_mul, one_mul] at hjBound
  exact (csInf_le ⟨‖x‖, hlower⟩ hmem).trans (by linarith)

#print axioms BarronSphere.barronStage_inclusion_contractive
#print axioms BarronSphere.barronStage_normRecovery


private theorem reflectedEven_cut_commute (E : MeasSet (BarronSphere d))
    (hE : reflection d ⁻¹' E.1 = E.1) (μ : FiniteSignedMeasure (BarronSphere d)) :
    reflectedEven d (cut E μ) = cut E (reflectedEven d μ) := by
  let L := (cut E).toLinearMap
  rw [reflectedEven_apply, reflectedEven_apply]
  change (1 / 2 : ℝ) • (cut (nonPole d) (cut E μ) +
    cut (nonPole d) (pushforward (reflection d) (cut E μ))) =
      L ((1 / 2 : ℝ) • (cut (nonPole d) μ + cut (nonPole d) (pushforward (reflection d) μ)))
  rw [map_smul, map_add]
  have hh := pushforward_cut (reflection d) E μ
  rw [show (⟨reflection d ⁻¹' E.1, (reflection d).measurable E.2⟩ :
    MeasSet (BarronSphere d)) = E from Subtype.ext hE] at hh
  rw [← hh, cut_cut_comm (nonPole d) E μ,
    cut_cut_comm (nonPole d) E (pushforward (reflection d) μ)]
  rfl

/-- The even component on the Barron Banach quotient. -/
def evenPart (hd : 1 ≤ d) : BarronBanach d →L[ℝ] FiniteSignedMeasure (BarronSphere d) :=
  ((reflectedEven d).mkContinuous 1 (by simpa only [one_mul] using reflectedEven_contractive)).comp
    (canonicalSection hd)

theorem evenPart_synthesisQuotient (hd : 1 ≤ d) (μ : FiniteSignedMeasure (BarronSphere d)) :
    evenPart hd (synthesisQuotient d μ) = reflectedEven d μ := by
  change reflectedEven d (canonicalSection hd (synthesisQuotient d μ)) = _
  rw [canonicalSection_synthesisQuotient, reflectedEven_canonicalProjection]

theorem evenPart_barronOperatorMeasure (hd : 1 ≤ d) (E : MeasSet (BarronSphere d))
    (hE : reflection d ⁻¹' E.1 = E.1) (x : BarronBanach d) :
    evenPart hd ((barronOperatorMeasure hd).val E x) = cut E (evenPart hd x) := by
  change evenPart hd (synthesisQuotient d (cut E (canonicalSection hd x))) =
    cut E (reflectedEven d (canonicalSection hd x))
  rw [evenPart_synthesisQuotient, reflectedEven_cut_commute E hE]

theorem evenPart_barronStage (hd : 1 ≤ d) (ρ : BarronControl d)
    (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≠ ⊤)
    (E : MeasSet (BarronSphere d)) (hE : reflection d ⁻¹' E.1 = E.1) (a : Lp ℝ p ρ.1) :
    let Q := barronStage hd ρ p hp
    evenPart hd (Q.inclusion (Q.synthesis (Q.multiplication.val E a))) =
      cut E (evenPart hd (Q.inclusion (Q.synthesis a))) := by
  dsimp only
  rw [MeasureDensityStage.inclusion_synthesis, MeasureDensityStage.inclusion_synthesis,
    evenPart_synthesisQuotient, evenPart_synthesisQuotient,
    (barronStage hd ρ p hp).density_cut]
  exact reflectedEven_cut_commute E hE _

private theorem evenPart_contractive (hd : 1 ≤ d) (x : BarronBanach d) :
    ‖evenPart hd x‖ ≤ ‖x‖ := by
  refine le_of_forall_pos_le_add fun ε hε => ?_
  obtain ⟨μ, hμ, hn⟩ := approximate_synthesisQuotient x ε hε
  rw [← hμ, evenPart_synthesisQuotient, hμ]
  exact (reflectedEven_contractive μ).trans hn.le

theorem evenPart_ker_eq_affine (hd : 1 ≤ d) :
    (evenPart hd).ker =
      ((synthesisQuotient d).toLinearMap.comp (affineAtoms d)).range := by
  ext x
  constructor
  · intro hx
    have hC : reflectedEven d (canonicalSection hd x) = 0 := hx
    let μ := canonicalSection hd x
    let a := affineCoefficients d μ
    have hP : canonicalProjection d μ = μ := by
      rw [← canonicalSection_synthesisQuotient hd μ, synthesisQuotient_canonicalSection]
    have hJ : affineAtoms d a = μ := by
      change reflectedEven d μ + affineAtoms d a = μ at hP
      rw [hC, zero_add] at hP
      exact hP
    exact ⟨a, (congrArg (synthesisQuotient d) hJ).trans (synthesisQuotient_canonicalSection hd x)⟩
  · rintro ⟨a, rfl⟩
    change evenPart hd (synthesisQuotient d (affineAtoms d a)) = 0
    rw [evenPart_synthesisQuotient, reflectedEven_affineAtoms]

instance evenPart_kernel_closed (hd : 1 ≤ d) :
    IsClosed ((evenPart hd).ker : Set (BarronBanach d)) := (evenPart hd).isClosed_ker

/-- The quotient by affine functions, equipped with its quotient norm. -/
abbrev BarronAffineQuotient (hd : 1 ≤ d) := BarronBanach d ⧸ (evenPart hd).ker

def quotientEvenPart (hd : 1 ≤ d) : BarronAffineQuotient hd →L[ℝ] FiniteSignedMeasure (BarronSphere d) :=
  (evenPart hd).ker.liftQL (evenPart hd) le_rfl

theorem quotientEvenPart_norm (hd : 1 ≤ d) (z : BarronAffineQuotient hd) :
    ‖quotientEvenPart hd z‖ = ‖z‖ := by
  apply le_antisymm
  · refine le_of_forall_pos_le_add fun ε hε => ?_
    obtain ⟨x, hx, hn⟩ := Submodule.Quotient.norm_mk_lt z hε
    rw [← hx]
    change ‖evenPart hd x‖ ≤ _
    exact (evenPart_contractive hd x).trans (by rw [hx]; exact hn.le)
  · obtain ⟨x, rfl⟩ := (evenPart hd).ker.mkQ_surjective z
    let γ := evenPart hd x
    have hγ : reflectedEven d γ = γ :=
      reflectedEven_idempotent (canonicalSection hd x)
    let y := synthesisQuotient d γ
    have h : (Submodule.Quotient.mk y : BarronAffineQuotient hd) =
        Submodule.Quotient.mk x := by
      apply (Submodule.Quotient.eq (evenPart hd).ker).mpr
      change evenPart hd (synthesisQuotient d γ - x) = 0
      rw [map_sub, evenPart_synthesisQuotient, hγ]
      exact sub_self _
    change ‖(Submodule.Quotient.mk x : BarronAffineQuotient hd)‖ ≤ ‖γ‖
    rw [← h]
    exact (Submodule.Quotient.norm_mk_le (evenPart hd).ker y).trans (norm_synthesisQuotient_le γ)

theorem quotientEvenPart_range (hd : 1 ≤ d) (γ : FiniteSignedMeasure (BarronSphere d)) :
    (∃ z, quotientEvenPart hd z = γ) ↔
      pushforward (reflection d) γ = γ ∧ cut (nonPole d) γ = γ := by
  constructor
  · rintro ⟨z, rfl⟩
    obtain ⟨x, rfl⟩ := (evenPart hd).ker.mkQ_surjective z
    change pushforward (reflection d) (reflectedEven d (canonicalSection hd x)) = _ ∧
      cut (nonPole d) (reflectedEven d (canonicalSection hd x)) = _
    exact ⟨reflectedEven_even _, reflectedEven_supported _⟩
  · intro h
    refine ⟨Submodule.Quotient.mk (synthesisQuotient d γ), ?_⟩
    change evenPart hd (synthesisQuotient d γ) = γ
    rw [evenPart_synthesisQuotient]
    exact reflectedEven_eq_of_even_supported γ h.1 h.2

