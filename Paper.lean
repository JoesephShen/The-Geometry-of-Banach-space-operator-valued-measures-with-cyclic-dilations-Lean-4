private theorem exists_symmetricControl_upper (η : BarronControl d) :
    ∃ ρ : BarronControl d, Measure.map (reflection d) ρ.1 = ρ.1 ∧
      η.1 ≤ (2 : ℝ≥0∞) • ρ.1 := by
  let τ := Measure.map (reflection d) η.1
  let σ := (1 / 2 : ℝ≥0∞) • (η.1 + τ)
  have hs : Measure.map (reflection d) σ = σ := by
    unfold σ
    rw [Measure.map_smul _ (reflection d).measurable.aemeasurable,
      Measure.map_add _ _ (reflection d).measurable]
    change (1 / 2 : ℝ≥0∞) • (τ + Measure.map (reflection d) τ) = _
    rw [map_reflection_map, add_comm τ η.1]
  have hpos (θ : BarronSphere d) (hθ : 0 < η.1 {θ}) : 0 < σ {θ} := by
    change 0 < (1 / 2 : ℝ≥0∞) * (η.1 {θ} + τ {θ})
    exact (ENNReal.mul_pos (a := (1 / 2 : ℝ≥0∞)) (by norm_num) hθ.ne').trans_le
      (mul_le_mul_right le_self_add _)
  have hσ : CompatibleProbability d σ := by
    refine ⟨?_, ⟨1, ENNReal.one_lt_top, ?_⟩, ?_, ?_⟩
    · change (1 / 2 : ℝ≥0∞) * (η.1 univ + Measure.map (reflection d) η.1 univ) = 1
      rw [map_reflection_univ, measure_univ, one_add_one_eq_two]
      exact ENNReal.div_mul_cancel (by norm_num) (by norm_num)
    · rw [hs, one_smul]
    · intro i
      exact ⟨hpos _ (η.2.2.2.1 i).1, hpos _ (η.2.2.2.1 i).2⟩
    · exact ⟨hpos _ (η.2.2.2.2.1), hpos _ (η.2.2.2.2.2)⟩
  refine ⟨⟨σ, hσ⟩, hs, ?_⟩
  change η.1 ≤ (2 : ℝ≥0∞) • ((1 / 2 : ℝ≥0∞) • (η.1 + τ))
  rw [smul_smul, show (2 : ℝ≥0∞) * (1 / 2) = 1 by
    rw [mul_comm]; exact ENNReal.div_mul_cancel (by norm_num) (by norm_num), one_smul]
  exact Measure.le_add_right le_rfl

private theorem exists_symmetricCommonStages (hd : 1 ≤ d) (x : ℕ → BarronBanach d)
    {p : ℝ≥0∞} [Fact (1 ≤ p)] (hp : p ≠ ⊤) :
    ∃ ρ : BarronControl d, Measure.map (reflection d) ρ.1 = ρ.1 ∧
      ∀ n, ∃ z : (barronStage hd ρ p hp).Quotient, (barronStage hd ρ p hp).inclusion z = x n := by
  have hex (n : ℕ) := (barronStage_normRecovery hd p hp (x n)).1
  choose η z hz using hex
  obtain ⟨ν, hν, hη⟩ := compatibleProbabilities_countablyDirected (fun n => (η n).1) (fun n => (η n).2)
  obtain ⟨ρ, hρ, hdom⟩ := exists_symmetricControl_upper ⟨ν, hν⟩
  refine ⟨ρ, hρ, fun n => ?_⟩
  obtain ⟨k, hk, hkn⟩ := hη n
  have hkn' := hkn.trans (measure_scale_mono hdom k)
  rw [smul_smul] at hkn'
  have hkt : k * (2 : ℝ≥0∞) ≠ ∞ := (ENNReal.mul_lt_top hk (by finiteness)).ne
  have hkp : 0 < (k * (2 : ℝ≥0∞)).toReal := by
    have h : 1 ≤ k := by
      have hh := hkn univ
      change (η n).1 univ ≤ k * ν univ at hh
      rwa [measure_univ, hν.1, mul_one] at hh
    exact ENNReal.toReal_pos (mul_ne_zero (ne_of_gt (zero_lt_one.trans_le h)) (by norm_num)) hkt
  obtain ⟨j, hj, _, _, _, hInc, _, _⟩ := barronStage_connecting hd (η n) ρ p hp
    (k * (2 : ℝ≥0∞)).toReal hkp (by rwa [ENNReal.ofReal_toReal hkt])
  exact ⟨(barronStage hd (η n) p hp).connectingMap (barronStage hd ρ p hp) j hj (z n),
    (hInc (z n)).trans (hz n)⟩

theorem evenMeasures_common_probability (hd : 1 ≤ d)
    (γ : ℕ → FiniteSignedMeasure (BarronSphere d))
    (he : ∀ n, pushforward (reflection d) (γ n) = γ n)
    (hn : ∀ n, cut (nonPole d) (γ n) = γ n) :
    ∃ ρ : BarronControl d, Measure.map (reflection d) ρ.1 = ρ.1 ∧
      ∀ n, ∃ a : Lp ℝ 1 ρ.1, densityMap a = γ n := by
  obtain ⟨ρ, hρ, hz⟩ := exists_symmetricCommonStages hd (fun n => synthesisQuotient d (γ n))
    (p := 1) ENNReal.one_ne_top
  refine ⟨ρ, hρ, fun n => ?_⟩
  obtain ⟨a, ha⟩ := (barronStage_membership hd ρ (1 : ℝ≥0∞) ENNReal.one_ne_top _).mp (hz n)
  exact ⟨a, (ha.trans (canonicalSection_synthesisQuotient hd (γ n))).trans
    (canonicalProjection_even _ (reflectedEven_eq_of_even_supported (γ n) (he n) (hn n)))⟩

