namespace Paper

noncomputable section SectionSevenBochner

open MeasureTheory Set Filter
open scoped ENNReal Topology

variable {Ω Y : Type*} [MeasurableSpace Ω] [NormedAddCommGroup Y] [NormedSpace ℝ Y]

abbrev VectorBochnerTwo (Y : Type*) [NormedAddCommGroup Y]
    {Ω : Type*} [MeasurableSpace Ω] (ρ : Measure Ω) := Lp Y (2 : ℝ≥0∞) ρ

def vectorBochnerCut (ρ : Measure Ω) (E : MeasSet Ω) :
    VectorBochnerTwo Y ρ →L[ℝ] VectorBochnerTwo Y ρ := by
  let f (u : VectorBochnerTwo Y ρ) : VectorBochnerTwo Y ρ :=
    (MemLp.indicator E.2.nullMeasurableSet (Lp.memLp u)).toLp (E.1.indicator u)
  have hf (u : VectorBochnerTwo Y ρ) :
      (fun t => f u t) =ᵐ[ρ] E.1.indicator u := (MemLp.indicator E.2.nullMeasurableSet (Lp.memLp u)).coeFn_toLp
  let L : VectorBochnerTwo Y ρ →ₗ[ℝ] VectorBochnerTwo Y ρ :=
    { toFun := f
      map_add' := fun u v => by
        apply Lp.ext
        filter_upwards [hf (u+v),hf u,hf v,Lp.coeFn_add u v,Lp.coeFn_add (f u) (f v)] with t h h₁ h₂ hs hsum
        rw [h,hsum,Pi.add_apply,h₁,h₂]
        by_cases ht : t ∈ E.1
        · rw [indicator_of_mem ht]
          simpa only [indicator_of_mem ht,Pi.add_apply,Pi.smul_apply] using hs
        · simp [ht]
      map_smul' := fun c u => by
        apply Lp.ext
        filter_upwards [hf (c • u),hf u,Lp.coeFn_smul c u,Lp.coeFn_smul c (f u)] with t h h₁ hs hsum
        change f (c • u) t = (c • f u) t
        rw [h,hsum,Pi.smul_apply,h₁]
        by_cases ht : t ∈ E.1
        · rw [indicator_of_mem ht]
          simpa only [indicator_of_mem ht,Pi.add_apply,Pi.smul_apply] using hs
        · simp [ht] }
  refine L.mkContinuous 1 (fun u => ?_)
  change ‖f u‖ ≤ 1 * ‖u‖
  rw [one_mul]
  apply Lp.norm_le_norm_of_ae_le
  filter_upwards [hf u] with t h
  rw [h]
  by_cases ht : t ∈ E.1 <;> simp [ht]

theorem vectorBochnerCut_apply_ae (ρ : Measure Ω) (E : MeasSet Ω) (u : VectorBochnerTwo Y ρ) :
    (fun t => vectorBochnerCut ρ E u t) =ᵐ[ρ] E.1.indicator u :=
  (MemLp.indicator E.2.nullMeasurableSet (Lp.memLp u)).coeFn_toLp

private theorem vectorBochnerCut_comp (ρ : Measure Ω) (E B : MeasSet Ω) (u : VectorBochnerTwo Y ρ) :
    vectorBochnerCut ρ E (vectorBochnerCut ρ B u) = vectorBochnerCut ρ (E.inter B) u := by
  apply Lp.ext
  filter_upwards [vectorBochnerCut_apply_ae ρ E (vectorBochnerCut ρ B u),
    vectorBochnerCut_apply_ae ρ B u, vectorBochnerCut_apply_ae ρ (E.inter B) u] with t ht hb hb'
  rw [ht, hb']
  by_cases h₁ : t ∈ E.1 <;> by_cases h₂ : t ∈ B.1 <;> simp [MeasSet.inter, h₁, h₂, hb]

private theorem vectorBochnerCut_contract (ρ : Measure Ω) (E : MeasSet Ω) (u : VectorBochnerTwo Y ρ) :
    ‖vectorBochnerCut ρ E u‖ ≤ ‖u‖ := by
  apply Lp.norm_le_norm_of_ae_le
  filter_upwards [vectorBochnerCut_apply_ae ρ E u] with t ht
  rw [ht]
  by_cases he : t ∈ E.1 <;> simp [he]

private theorem vectorBochnerCut_empty (ρ : Measure Ω) (u : VectorBochnerTwo Y ρ) :
    vectorBochnerCut ρ MeasSet.empty u = 0 := by
  apply Lp.ext
  exact (vectorBochnerCut_apply_ae ρ MeasSet.empty u).trans
    (by
      rw [show (MeasSet.empty : MeasSet Ω).1 = ∅ from rfl, indicator_empty]
      exact (Lp.coeFn_zero Y 2 ρ).symm)

private theorem vectorBochnerCut_union (ρ : Measure Ω) (E B : MeasSet Ω) (h : Disjoint E.1 B.1)
    (u : VectorBochnerTwo Y ρ) :
    vectorBochnerCut ρ (E.union B) u = vectorBochnerCut ρ E u + vectorBochnerCut ρ B u := by
  apply Lp.ext
  filter_upwards [vectorBochnerCut_apply_ae ρ (E.union B) u,
    vectorBochnerCut_apply_ae ρ E u, vectorBochnerCut_apply_ae ρ B u,
    Lp.coeFn_add (vectorBochnerCut ρ E u) (vectorBochnerCut ρ B u)] with t hU hE hB hsum
  rw [hU, hsum, Pi.add_apply, hE, hB]
  by_cases h₁ : t ∈ E.1 <;> by_cases h₂ : t ∈ B.1
  · exact (Set.disjoint_left.mp h h₁ h₂).elim
  · simp [MeasSet.union, h₁, h₂]
  · simp [MeasSet.union, h₁, h₂]
  · simp [MeasSet.union, h₁, h₂]

private theorem vectorBochnerCut_tendsto_zero (ρ : Measure Ω)
    (D : ℕ → MeasSet Ω) (hD : Antitone (fun n => (D n).1)) (hcap : (⋂ n, (D n).1) = ∅)
    (u : VectorBochnerTwo Y ρ) : Tendsto (fun n => ‖vectorBochnerCut ρ (D n) u‖) atTop (𝓝 0) := by
  have hI (v : VectorBochnerTwo Y ρ) : Integrable (fun t => ‖v t‖ ^ 2) ρ := by
    have h := (Lp.memLp v).norm_rpow (by norm_num) (by norm_num)
    simpa [memLp_one_iff_integrable] using h
  have hnorm (v : VectorBochnerTwo Y ρ) : ‖v‖ ^ 2 = ∫ t, ‖v t‖ ^ 2 ∂ρ := by
    rw [Lp.norm_def, ← ENNReal.toReal_pow, eLpNorm_eq_lintegral_rpow_eNorm_toReal
      (by norm_num) (by norm_num) (Lp.aestronglyMeasurable v), ← ENNReal.rpow_natCast,
      ← ENNReal.rpow_mul]
    simp only [ENNReal.toReal_ofNat, Nat.cast_ofNat, show (1 / 2 : ℝ) * 2 = 1 by norm_num, ENNReal.rpow_one]
    rw [integral_eq_lintegral_of_nonneg_ae (Eventually.of_forall fun t => sq_nonneg ‖v t‖)
      (hI v).aestronglyMeasurable]
    congr 1
    apply lintegral_congr
    intro t
    rw [← ofReal_norm, ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) (by norm_num)]
    simp
  let V (n : ℕ) := vectorBochnerCut ρ (D n) u
  have ha : ∀ n, (fun t => V n t) =ᵐ[ρ] (D n).1.indicator u :=
    fun n => vectorBochnerCut_apply_ae ρ (D n) u
  have hv : ∀ᵐ t ∂ρ, Tendsto (fun n => ‖V n t‖ ^ 2) atTop (𝓝 0) := by
    filter_upwards [ae_all_iff.mpr ha] with t ht
    have hn : ∃ n, t ∉ (D n).1 := by
      by_contra! hn
      have h := Set.mem_iInter.mpr hn
      rw [hcap] at h
      exact h
    obtain ⟨N, hN⟩ := hn
    apply tendsto_const_nhds.congr'
    filter_upwards [eventually_ge_atTop N] with n hn'
    rw [ht n, indicator_of_notMem (fun hmem => hN (hD hn' hmem)), norm_zero, zero_pow (by decide : (2 : ℕ) ≠ 0)]
  have h := tendsto_integral_of_dominated_convergence (μ := ρ)
    (fun t => ‖u t‖ ^ 2) (fun n => (hI (V n)).aestronglyMeasurable)
    (hI u) (fun n => by
      filter_upwards [ha n] with t ht
      rw [Real.norm_of_nonneg (sq_nonneg _), ht]
      by_cases hD : t ∈ (D n).1 <;> simp [hD]) (f := fun _ => (0 : ℝ)) hv
  rw [integral_zero] at h
  have hn (n : ℕ) : ‖V n‖ = Real.sqrt (∫ t, ‖V n t‖ ^ 2 ∂ρ) := by
    rw [← hnorm, Real.sqrt_sq (norm_nonneg _)]
  change Tendsto (fun n => ‖V n‖) atTop (𝓝 0)
  simp_rw [hn]
  simpa only [Real.sqrt_zero] using h.sqrt

/-- Strongly countably additive multiplication measure on vector-valued L². -/
def vectorBochnerPVM (ρ : Measure Ω) : PVM Ω (VectorBochnerTwo Y ρ) where
  val E := vectorBochnerCut ρ E
  empty_eq := ContinuousLinearMap.ext fun x => vectorBochnerCut_empty ρ x
  normalized := by
    apply ContinuousLinearMap.ext
    intro x
    apply Lp.ext
    change (fun t => vectorBochnerCut ρ MeasSet.whole x t) =ᵐ[ρ] (fun t => x t)
    simpa only [MeasSet.whole, indicator_univ] using vectorBochnerCut_apply_ae ρ MeasSet.whole x
  mul_eq E B := ContinuousLinearMap.ext fun x => vectorBochnerCut_comp ρ E B x
  countably_additive A hA x := by
    let U := MeasSet.iUnion A
    let V (s : Finset ℕ) := MeasSet.finiteUnion A s
    let R (s : Finset ℕ) := U.diff (V s)
    let D (n : ℕ) := R (Finset.range n)
    have hV (s : Finset ℕ) : (V s).1 ⊆ U.1 := by
      intro t ht
      obtain ⟨n, _, hn⟩ := mem_iUnion₂.mp ht
      exact mem_iUnion.mpr ⟨n, hn⟩
    have hR {s t : Finset ℕ} (hst : s ⊆ t) : (R t).1 ⊆ (R s).1 := by
      intro u hu
      refine ⟨hu.1, fun hv => hu.2 ?_⟩
      obtain ⟨n, hs, hn⟩ := mem_iUnion₂.mp hv
      exact mem_iUnion₂.mpr ⟨n, hst hs, hn⟩
    have hda : Antitone (fun n => (D n).1) := fun _ _ h => hR (Finset.range_mono h)
    have hdz : (⋂ n, (D n).1) = ∅ := by
      apply Set.eq_empty_iff_forall_notMem.mpr
      intro t ht
      obtain ⟨n, hn⟩ := mem_iUnion.mp ((Set.mem_iInter.mp ht 0).1)
      exact (Set.mem_iInter.mp ht (n + 1)).2
        (mem_iUnion₂.mpr ⟨n, Finset.mem_range.mpr (Nat.lt_succ_self n), hn⟩)
    have hlim := vectorBochnerCut_tendsto_zero ρ D hda hdz x
    change Tendsto (fun s : Finset ℕ => ∑ n ∈ s, vectorBochnerCut ρ (A n) x) atTop
      (𝓝 (vectorBochnerCut ρ U x))
    rw [Metric.tendsto_nhds]
    intro ε hε
    obtain ⟨N, hN⟩ := Metric.tendsto_atTop.mp hlim ε hε
    have hn : ‖vectorBochnerCut ρ (D N) x‖ < ε := by
      simpa only [Real.dist_eq, sub_zero, abs_of_nonneg (norm_nonneg _)] using hN N le_rfl
    filter_upwards [eventually_ge_atTop (Finset.range N)] with s hs
    have hfin := MeasSet.finite_add_of_pair (fun E => vectorBochnerCut ρ E x) (vectorBochnerCut_empty ρ x)
      (fun E B h => vectorBochnerCut_union ρ E B h x) A hA s
    rw [← hfin, dist_eq_norm, norm_sub_rev]
    have huv : U = (V s).union (R s) := Subtype.ext (Set.union_sdiff_cancel (hV s)).symm
    have he : vectorBochnerCut ρ U x - vectorBochnerCut ρ (V s) x = vectorBochnerCut ρ (R s) x := by
      conv_lhs => rw [huv]
      rw [vectorBochnerCut_union _ _ _ disjoint_sdiff_right, add_sub_cancel_left]
    rw [he]
    have hin : (R s).inter (D N) = R s := Subtype.ext (Set.inter_eq_left.mpr (hR hs))
    have hs' := vectorBochnerCut_contract ρ (R s) (vectorBochnerCut ρ (D N) x)
    rw [vectorBochnerCut_comp, hin] at hs'
    exact hs'.trans_lt hn



/-- The reflexivity of Bochner Lp for reflexive range and 1 < p < ∞,
specialized to p = 2. See the Bochner duality theorem used in prop:bochner-normal. -/
axiom citeBochnerLTwoReflexivity [CompleteSpace Y] (hY : IsReflexive Y)
    (ρ : Measure Ω) [SigmaFinite ρ] : IsReflexive (VectorBochnerTwo Y ρ)

theorem vectorBochnerTwo_geometry [CompleteSpace Y] (hY : IsReflexive Y)
    (ρ : Measure Ω) [SigmaFinite ρ] :
    (vectorBochnerPVM (Y := Y) ρ).Localizes ∧
      (vectorBochnerPVM (Y := Y) ρ).toOVM.Shrinking ∧
      (vectorBochnerPVM (Y := Y) ρ).BoundedlyComplete := by
  let P := vectorBochnerPVM (Y := Y) ρ
  have hr := citeBochnerLTwoReflexivity hY ρ
  have h : P.Localizes := by
    intro ξ _
    obtain ⟨x,rfl⟩ := hr ξ
    refine ⟨fun _ => MeasSet.whole, fun _ _ _ => subset_rfl, ?_, fun _ => ⟨x,?_⟩⟩
    · ext t
      simp [MeasSet.iUnion,MeasSet.whole]
    · intro f
      rw [show P.val MeasSet.whole = ContinuousLinearMap.id ℝ _ from P.normalized]
      rfl
  exact ⟨h,(P.shrinking_boundedlyComplete_iff_reflexive h).mpr hr⟩

#print axioms vectorBochnerPVM
