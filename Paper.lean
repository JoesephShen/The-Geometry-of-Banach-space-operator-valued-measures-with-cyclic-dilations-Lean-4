/-- The homogeneous canonical projection on finite signed measures. -/
def homogeneousProjectionCLM (d : ℕ) :
    FiniteSignedMeasure (BarronSphere d) →L[ℝ] FiniteSignedMeasure (BarronSphere d) :=
  let A := (1 / 2 : ℝ) • ((ContinuousLinearMap.pi fun i : Fin d =>
    signedIntegral (weightSymbol i)).prod (signedIntegral (biasSymbol d)))
  (1 / 2 : ℝ) • (ContinuousLinearMap.id ℝ _ + pushforward (reflection d)) +
    (homogeneousAtoms d).toContinuousLinearMap.comp A

theorem homogeneousProjectionCLM_apply (μ : FiniteSignedMeasure (BarronSphere d)) :
    homogeneousProjectionCLM d μ = homogeneousProjection d μ := rfl

instance homogeneousKernel_closed (d : ℕ) :
    IsClosed ((homogeneousProjectionCLM d).ker : Set (FiniteSignedMeasure (BarronSphere d))) :=
  (homogeneousProjectionCLM d).isClosed_ker

/-- The homogeneous synthesis space with the variation-quotient norm. -/
abbrev HomogeneousBarronBanach (d : ℕ) :=
  FiniteSignedMeasure (BarronSphere d) ⧸ (homogeneousProjectionCLM d).ker

def homogeneousQuotient (d : ℕ) :
    FiniteSignedMeasure (BarronSphere d) →L[ℝ] HomogeneousBarronBanach d :=
  (homogeneousProjectionCLM d).ker.mkQL

theorem homogeneousQuotient_eq_iff (μ ν : FiniteSignedMeasure (BarronSphere d)) :
    homogeneousQuotient d μ = homogeneousQuotient d ν ↔
      ∀ x t, homogeneousSynthesis μ x t = homogeneousSynthesis ν x t := by
  change (Submodule.Quotient.mk μ : HomogeneousBarronBanach d) = Submodule.Quotient.mk ν ↔ _
  rw [Submodule.Quotient.eq, LinearMap.mem_ker]
  change homogeneousProjectionCLM d (μ - ν) = 0 ↔ _
  rw [homogeneousProjectionCLM_apply, homogeneousProjection_kernel_all_dimensions]
  simp only [homogeneousSynthesis, map_sub, sub_eq_zero]

def homogeneousSection (d : ℕ) :
    HomogeneousBarronBanach d →L[ℝ] FiniteSignedMeasure (BarronSphere d) :=
  (homogeneousProjectionCLM d).ker.liftQL (homogeneousProjectionCLM d) le_rfl

theorem homogeneousQuotient_section (z : HomogeneousBarronBanach d) :
    homogeneousQuotient d (homogeneousSection d z) = z := by
  obtain ⟨μ, rfl⟩ := (homogeneousProjectionCLM d).ker.mkQ_surjective z
  change homogeneousQuotient d (homogeneousProjectionCLM d μ) = homogeneousQuotient d μ
  rw [homogeneousQuotient_eq_iff, homogeneousProjectionCLM_apply]
  exact homogeneousSynthesis_projection μ

def homogeneousOperatorMeasure (d : ℕ) : OVM (BarronSphere d) (HomogeneousBarronBanach d) :=
  (restrictionPVM (BarronSphere d)).compressed (homogeneousQuotient d) (homogeneousSection d)

theorem homogeneousOperatorMeasure_normalized (d : ℕ) : (homogeneousOperatorMeasure d).Normalized :=
  (restrictionPVM (BarronSphere d)).compressed_normalized _ _ homogeneousQuotient_section

/-- Equality on the input unit sphere determines the positively homogeneous synthesis. -/
theorem homogeneousSynthesis_eq_on_inputSphere (μ ν : FiniteSignedMeasure (BarronSphere d)) :
    (∀ θ : BarronSphere d, homogeneousSynthesis μ θ.weight θ.bias =
      homogeneousSynthesis ν θ.weight θ.bias) ↔
    ∀ x t, homogeneousSynthesis μ x t = homogeneousSynthesis ν x t := by
  refine ⟨fun h x t => ?_, fun h θ => h _ _⟩
  let q := Real.sqrt ((∑ i, (x i)^2) + t^2)
  have hsum : 0 ≤ (∑ i, (x i)^2) + t^2 :=
    add_nonneg (Finset.sum_nonneg fun _ _ => sq_nonneg _) (sq_nonneg _)
  have hq : 0 ≤ q := Real.sqrt_nonneg _
  have hsq : q^2 = (∑ i, (x i)^2) + t^2 := Real.sq_sqrt hsum
  by_cases h0 : q = 0
  · rw [h0, zero_pow (by decide : 2 ≠ 0)] at hsq
    have ht : t = 0 := by
      have hs := Finset.sum_nonneg (s := Finset.univ) fun i _ => sq_nonneg (x i)
      nlinarith
    have hx : x = 0 := by
      funext i
      have hi := Finset.single_le_sum (f := fun i => (x i)^2)
        (fun i _ => sq_nonneg (x i)) (Finset.mem_univ i)
      have hs0 : (∑ j, (x j)^2) = 0 := by simpa [ht] using hsq.symm
      rw [hs0] at hi
      have hz : x i * x i = 0 := by simpa [pow_two] using le_antisymm hi (sq_nonneg (x i))
      exact (mul_eq_zero.mp hz).elim id id
    subst x
    subst t
    have hzero (η : FiniteSignedMeasure (BarronSphere d)) : homogeneousSynthesis η 0 0 = 0 := by
      have hz := homogeneousSynthesis_nonnegative_scale η 0 0 0 le_rfl
      simpa using hz
    rw [hzero, hzero]
  · let θ : BarronSphere d := ⟨(q⁻¹ • x, q⁻¹ * t), by
      change (∑ i, ((q⁻¹ * x i)^2)) + (q⁻¹ * t)^2 = 1
      simp_rw [mul_pow, ← Finset.mul_sum, ← mul_add, ← hsq, ← mul_pow, inv_mul_cancel₀ h0, one_pow]⟩
    have hx : q • θ.weight = x := by
      change q • (q⁻¹ • x) = x
      rw [smul_smul, mul_inv_cancel₀ h0, one_smul]
    have ht : q * θ.bias = t := by
      change q * (q⁻¹ * t) = t
      rw [← mul_assoc, mul_inv_cancel₀ h0, one_mul]
    have hm := homogeneousSynthesis_nonnegative_scale μ θ.weight θ.bias q hq
    have hn := homogeneousSynthesis_nonnegative_scale ν θ.weight θ.bias q hq
    rw [hx, ht] at hm hn
    rw [hm, hn, h θ]

